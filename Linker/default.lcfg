# Default linker config file

.set false 0
.set true 1

# ELF machine type
.set MW65C02 6502
.set M_RISC_V 243
.set M_ARM 40

layout {
  machine: MW65C02
  type: "rom"
 
  text_segment {
    region {
      name: "text"
      section: ".text"
      section: ".rodata"
      start_addr: 0xc000
      size: 0x3f00
      alignment: 1
    }
    region {
      name: "boot"
      section: ".boot"
      start_addr: 0xff00
      size: 0x100
      alignment: 1
    }
  }
}

layout {
  machine: MW65C02
  type: "program"
 
  text_segment {
    region {
      name: "text"
      section: ".text"
      section: ".rodata"
      start_addr: 0x200
    }
  }
  data_segment {
    name: "data"
    region {
      section: ".data"
      section: ".preinit_array"
      section: ".init_array"
      section: ".fini_array"
    }
  }
}

layout {
  machine: M_RISC_V
  type: "program"

  text_segment {
    region {
      name: "text"
      section: ".text"
      section: ".rodata"
      section: ".davecc_except_table"
      start_addr: 0x400000000
      alignment: 0x1000
    }
  }
  data_segment {
    region {
      name: "data"
      section: ".data"
      section: ".preinit_array"
      section: ".init_array"
      section: ".fini_array"
      start_addr: 0x410000000
      alignment: 0x1000
    }
  }
}

layout {
  machine: M_ARM
  type: "program"

  text_segment {
    region {
      name: "text"
      section: ".text"
      section: ".rodata"
      section: ".davecc_except_table"
      start_addr: 0x40000000
      alignment: 0x1000
    }
  }
  data_segment {
    region {
      name: "data"
      section: ".data"
      section: ".preinit_array"
      section: ".init_array"
      section: ".fini_array"
      start_addr: 0x41000000
      alignment: 0x1000
    }
  }
}

