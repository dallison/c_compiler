davecc_module(
    name = "std_module_x86_64",
    src = "libc/modules/std.hpp",
    module_name = "std",
    header_unit = True,
    standard = "c++23",
    output_stem = "modules/x86_64/std",
    inputs = [":libc_headers"],
    copts = ["-isystem", "libc/include"],
)

davecc_module(
    name = "std_module_aarch64",
    src = "libc/modules/std.hpp",
    module_name = "std",
    header_unit = True,
    target = "aarch64",
    standard = "c++23",
    output_stem = "modules/aarch64/std",
    inputs = [":libc_headers"],
    copts = ["-isystem", "libc/include"],
)

davecc_module(
    name = "std_module_arm",
