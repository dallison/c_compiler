        ":xtensaasm",
        ":bpfdasm",
        ":pcodedasm",
        ":wasmdasm",
    ] + select({
        "@platforms//os:macos": [
            ":libc_aarch64_darwin",
        ],
        "//conditions:default": [],
    }) + select({
        "@platforms//os:linux": [
            ":aarch64_linux_start",
