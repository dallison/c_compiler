genrule(
    name = "aarch64_signed",
    srcs = [
        ":aarch64",
        "aarch64_interpreter/aarch64.entitlements",
    ],
    outs = ["aarch64_signed_bin"],
    cmd = """
cp $(location :aarch64) $@
codesign -s - --options runtime \
  --entitlements $(location aarch64_interpreter/aarch64.entitlements) \
  -f $@
chmod +x $@
""",
    executable = True,
)

genrule(
    name = "libc_65c02",
    srcs = LIBC_SRCS + FP_EXTENDED_SRCS + LIBC_CXX_SRCS + [":libc_headers"] + glob([
        "6502 support/*.h",
        "6502 support/*.s",
        "libc/include/**/*.h",
    ]) + [
        ":davecc",
        ":archivist",
    ],
    outs = ["libc/libc65c02.a"],
    cmd = """
set -euo pipefail

out="$@"
work="$(@D)/libc65c02.build"
rm -rf "$$work"
mkdir -p "$$work"

davecc="$$(pwd)/$(execpath :davecc)"
archivist="$$(pwd)/$(execpath :archivist)"
cflags=(-target 65c02 -c -Xkeep-asm -isystem libc/include -Ilibc)

