genrule(
    name = "hello_aarch64_milestone_test",
    srcs = [
        "hello_aarch64/milestone_test.sh",
        ":hello_aarch64_dynamic_exe",
        ":hello_aarch64_libfunc_so",
        ":hello_aarch64_exe",
    ],
    outs = ["hello_aarch64/milestone.ok"],
    cmd = """
