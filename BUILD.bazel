    name = "run",
    srcs = ["run/main.c"],
    copts = COMMON_COPTS,
    data = [
        ":6502",
        ":aarch64",
        ":arm",
        ":bpf",
        ":pcode",
        ":riscv",
        ":esp32",
        ":support_rom_65c02",
        ":x86_64",
    ],
    deps = [
        ":elf",
        ":utils",
    ],
)

cc_binary(
    name = "moduledump",
    srcs = ["moduledump/main.c"],
    copts = COMMON_COPTS,
    deps = [
        ":ar_lib",
        ":compiler",
        ":elf",
        ":linker",
        ":loader",
        ":serialize",
        ":utils",
