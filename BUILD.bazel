genrule(
    name = "support_rom_65c02",
    srcs = [
        "6502 support/Interpreter ROM/introm.map",
        "6502 support/Interpreter ROM/introm.s",
        "6502 support/vars.s",
        ":davecc",
    ],
    outs = ["6502_support/6502rom.exe"],
    cmd = """
set -euo pipefail

davecc="$$(pwd)/$(execpath :davecc)"
"$$davecc" \
  -target 65c02 \
  -I"6502 support" \
  -Wl,-T"6502 support/Interpreter ROM/introm.map" \
  -Wl,-tintrom \
  -static \
  -nostdinc \
  -nostdlib \
  "6502 support/Interpreter ROM/introm.s" \
  -o "$@"
""",
)

genrule(
    name = "hello_65c02_exe",
    srcs = glob(["libc/include/**/*.h"]) + [
        ":libc_65c02",
        ":davecc",
        "hello_6502/main.c",
    ],
    outs = ["hello_6502/hello.exe"],
    cmd = """
set -euo pipefail

davecc="$$(pwd)/$(execpath :davecc)"
libc="$$(pwd)/$(execpath :libc_65c02)"
"$$davecc" \
  -target 65c02 \
  -static \
  -isystem libc/include \
  hello_6502/main.c \
  "$$libc" \
  -o "$@"
""",
)

genrule(
    name = "hello_65c02_output",
    srcs = [
        ":hello_65c02_exe",
        ":support_rom_65c02",
    ],
    outs = ["hello_6502/hello.out"],
    cmd = """
set -euo pipefail

"$(location :6502)" \
  -rom "$(location :support_rom_65c02)" \
  "$(location :hello_65c02_exe)" > "$@"
""",
    tools = [":6502"],
)

