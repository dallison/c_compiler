genrule(
    name = "libc_wasm32",
    srcs = LIBC_SRCS + FP_EXTENDED_SRCS + [
        "libc/cxx_new_overloads.cc",
        ":libc_headers",
    ] + glob([
        "libc/include/**/*.h",
    ]) + [
        ":davecc",
        ":archivist",
    ],
    outs = ["libc/libcwasm32.a"],
    cmd = """
set -euo pipefail

out="$@"
work="$(@D)/libcwasm32.build"
rm -rf "$$work"
mkdir -p "$$work"

davecc="$$(pwd)/$(execpath :davecc)"
archivist="$$(pwd)/$(execpath :archivist)"
cflags=(-target wasm32 -O1 -c -isystem libc/include -Ilibc)

# There is no assembler runtime: wasm has no instructions to write one in,
# so what other targets put in .s files is either in C here or not yet
# supported at all.  The Linux sources speak to a kernel that is not there,
# and unwinding needs the frame walk wasm does not allow.
for src in libc/*.c; do
  case "$$(basename "$$src")" in
    libc_test.c|eh_frame.c|eh_frame_pointer.c|linux_fs.c|linux_tls.c)
      continue
      ;;
    linux_syscall.c|linux_syscall_result.c|posix_linux.c)
      continue
      ;;
  esac
  "$$davecc" "$${cflags[@]}" "$$src" -o "$$work/$$(basename "$${src%.c}").o"
done
"$$davecc" "$${cflags[@]}" -std=c++20 -fno-exceptions \
  libc/cxx_new_overloads.cc -o "$$work/cxx_new_overloads.o"

# Members are named from the working directory, because a name holding a
# slash does not survive the archive's long-name table.
out_file="$$out"
case "$$out_file" in
  /*) ;;
  *) out_file="$$(pwd)/$$out_file" ;;
esac
cd "$$work"
"$$archivist" r "$$out_file" *.o
""",
)

LIBC_TEST_DATA = LIBC_SRCS + LIBC_CXX_SRCS + FP_EXTENDED_SRCS + [
    ":libc_headers",
    "libc/guest_heap.c",
] + glob([
    "aarch64 support/*.s",
    "arm support/*.s",
    "libc/include/**/*.h",
    "libc/tests/**",
    "x86_64 support/*.s",
    "RISCV_support/*.s",
    "RISCV32_support/*.s",
])

