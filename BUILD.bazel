for src in "$${libc_srcs[@]}"; do
  obj="$$work/$$(basename "$${src%.c}").o"
  "$$davecc" "$${cflags[@]}" "$$src" -o "$$obj"
done
for src in libc/*.cc; do
  obj="$$work/cxx_$$(basename "$${src%.cc}").o"
  "$$davecc" "$${cflags[@]}" -std=c++20 "$$src" -o "$$obj"
done

out_file="$$out"
case "$$out_file" in
  /*) ;;
  *) out_file="$$(pwd)/$$out_file" ;;
esac
cd "$$work"
"$$archivist" r "$$out_file" *.o
""",
)

genrule(
    name = "libc_pcode",
    srcs = LIBC_SRCS + LIBC_CXX_SRCS + [":libc_headers"] + glob([
        "libc/include/**/*.h",
        "pcode support/*.s",
    ]) + [
        ":davecc",
        ":archivist",
    ],
    outs = ["libc/libcpcode.a"],
    cmd = """
set -euo pipefail

out="$@"
work="$(@D)/libcpcode.build"
rm -rf "$$work"
mkdir -p "$$work"

davecc="$$(pwd)/$(execpath :davecc)"
archivist="$$(pwd)/$(execpath :archivist)"
cflags=(-target pcode -O1 -c -isystem libc/include -Ilibc)

runtime_objs=()
for src in "pcode support"/*.s; do
  obj="$$work/rt_$$(basename "$${src%.s}").o"
  "$$davecc" "$${cflags[@]}" "$$src" -o "$$obj"
  runtime_objs+=("$$obj")
done

libc_objs=()
for src in libc/*.c; do
  case "$$(basename "$$src")" in
    libc_test.c|eh_frame.c)
      continue
      ;;
  esac
  obj="$$work/$$(basename "$${src%.c}").o"
  "$$davecc" "$${cflags[@]}" "$$src" -o "$$obj"
  libc_objs+=("$$obj")
done
cxx_objs=()
for src in libc/*.cc; do
  obj="$$work/cxx_$$(basename "$${src%.cc}").o"
  "$$davecc" "$${cflags[@]}" -std=c++20 "$$src" -o "$$obj"
  cxx_objs+=("$$obj")
done

"$$archivist" r "$$out" "$${runtime_objs[@]}" "$${libc_objs[@]}" "$${cxx_objs[@]}"
""",
)

