    srcs = ["tests/p_code_vm_test.c"],
    copts = COMMON_COPTS,
    includes = COMMON_INCLUDES,
    deps = [":compiler"],
)

# Cross-build genrules use exec configuration (optimized by default).  The
# compiler mis-parses some libc headers at -O2 on 65c02; use -O0 for tools.
cc_binary(
    name = "davecc_tool",
    srcs = ["davecc/main.c"],
    copts = COMMON_COPTS + ["-O0"],
    features = ["-opt"],
    deps = [
        ":ar_lib",
        ":compiler",
        ":elf",
        ":linker",
        ":loader",
        ":serialize",
        ":utils",
    ],
)

