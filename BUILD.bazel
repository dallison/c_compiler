bash "$(location hello_aarch64/milestone_test.sh)" \
  "$$(pwd)/$(execpath :aarch64)" \
  "$$(pwd)/$(execpath :aarch64_signed)" \
  "$$(pwd)/$(execpath :hello_aarch64_dynamic_exe)" \
  "$$(pwd)/$(execpath :hello_aarch64_exe)"
