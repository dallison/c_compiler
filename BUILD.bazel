davecc="$(location :davecc)"
archivist="$(location :archivist)"
cflags=(-target x86_64 -O1 -c -isystem libc/include -Ilibc)

runtime_srcs=(
  "x86_64 support/setjmp.s"
  "x86_64 support/longjmp.s"
  "x86_64 support/syscall.s"
  "x86_64 support/abs.s"
)

runtime_objs=()
for src in "$${runtime_srcs[@]}"; do
  obj="$$work/$$(basename "$${src%.s}").o"
  "$$davecc" "$${cflags[@]}" "$$src" -o "$$obj"
  runtime_objs+=("$$obj")
done

