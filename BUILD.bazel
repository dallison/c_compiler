genrule(
    name = "libc_65c02",
    srcs = LIBC_SRCS + glob([
        "6502 support/*.h",
        "6502 support/*.s",
        "libc/include/**/*.h",
    ]),
    outs = ["libc/libc65c02.a"],
    cmd = """
set -euo pipefail

out="$@"
work="$(@D)/libc65c02.build"
rm -rf "$$work"
mkdir -p "$$work"

davecc="$(location :davecc)"
archivist="$(location :archivist)"
cflags=(-target 65c02 -c -Xkeep-asm)

runtime_srcs=(
  "6502 support/start.s"
  "6502 support/enter.s"
  "6502 support/var_addr.s"
  "6502 support/var_value.s"
  "6502 support/push.s"
  "6502 support/incdec.s"
  "6502 support/jump_table.s"
  "6502 support/mul.s"
  "6502 support/longmul.s"
  "6502 support/longlongmul.s"
  "6502 support/div.s"
  "6502 support/longdiv.s"
  "6502 support/longlongdiv.s"
  "6502 support/spill.s"
  "6502 support/fcommon.s"
  "6502 support/fadd.s"
  "6502 support/fconv.s"
  "6502 support/fcmp.s"
  "6502 support/fneg.s"
  "6502 support/fmul.s"
  "6502 support/fdiv.s"
  "6502 support/syscall.s"
  "6502 support/fmodf.s"
  "6502 support/fldexp.s"
  "6502 support/intrinsic.s"
  "6502 support/setjmp.s"
)

runtime_objs=()
for src in "$${runtime_srcs[@]}"; do
  obj="$$work/$$(basename "$${src%.s}").o"
  "$$davecc" "$${cflags[@]}" -I"6502 support" "$$src" -o "$$obj"
  runtime_objs+=("$$obj")
done

libc_srcs=(
  "libc/abs.c"
  "libc/bsearch.c"
  "libc/calloc.c"
  "libc/cdiv.c"
  "libc/ctype.c"
  "libc/exit.c"
  "libc/fclose.c"
  "libc/fflush.c"
  "libc/fgetc.c"
  "libc/fgets.c"
  "libc/fopen.c"
  "libc/fpfuncs.c"
  "libc/fputc.c"
  "libc/fputs.c"
  "libc/fread.c"
  "libc/free.c"
  "libc/fseek.c"
  "libc/ftoa.c"
  "libc/fwrite.c"
  "libc/getenv.c"
  "libc/gets.c"
  "libc/ldexp.c"
  "libc/libc_test.c"
  "libc/malloc.c"
  "libc/memchr.c"
  "libc/memcmp.c"
  "libc/memcpy.c"
  "libc/memmove.c"
  "libc/memset.c"
  "libc/modf.c"
  "libc/perror.c"
  "libc/posix.c"
  "libc/printf.c"
  "libc/qsort.c"
  "libc/rand.c"
  "libc/realloc.c"
  "libc/scanf.c"
  "libc/sincos.c"
  "libc/stdio.c"
  "libc/strcat.c"
  "libc/strchr.c"
  "libc/strcmp.c"
  "libc/strcpy.c"
  "libc/strcspn.c"
  "libc/strerror.c"
  "libc/strings.c"
  "libc/strlen.c"
  "libc/strncat.c"
  "libc/strncmp.c"
  "libc/strncpy.c"
  "libc/strpbrk.c"
  "libc/strrchr.c"
  "libc/strspn.c"
  "libc/strstr.c"
  "libc/strtod.c"
  "libc/strtok.c"
  "libc/strtol.c"
  "libc/strtoll.c"
  "libc/strtoul.c"
  "libc/strtoull.c"
  "libc/ungetc.c"
)

libc_objs=()
for src in "$${libc_srcs[@]}"; do
  obj="$$work/$$(basename "$${src%.c}").o"
  "$$davecc" "$${cflags[@]}" "$$src" -o "$$obj"
  libc_objs+=("$$obj")
done

"$$archivist" r "$$out" "$${runtime_objs[@]}" "$${libc_objs[@]}"
""",
    tools = [
        ":archivist",
        ":davecc",
    ],
)

genrule(
    name = "support_rom_65c02",
    srcs = [
        "6502 support/Interpreter ROM/introm.map",
        "6502 support/Interpreter ROM/introm.s",
    ],
    outs = ["6502_support/6502rom.exe"],
    cmd = """
set -euo pipefail

"$(location :davecc)" \
  -target 65c02 \
  -Wl,-T"6502 support/Interpreter ROM/introm.map" \
  -Wl,-tintrom \
  -static \
  "6502 support/Interpreter ROM/introm.s" \
  -o "$@"
""",
    tools = [":davecc"],
)

genrule(
    name = "hello_65c02_exe",
    srcs = glob(["libc/include/**/*.h"]) + [
        ":libc_65c02",
        "hello_6502/main.c",
    ],
    outs = ["hello_6502/hello.exe"],
    cmd = """
set -euo pipefail

"$(location :davecc)" \
  -target 65c02 \
  -static \
  hello_6502/main.c \
  "$(location :libc_65c02)" \
  -o "$@"
""",
    tools = [":davecc"],
)

genrule(
    name = "hello_65c02_output",
    srcs = [
        ":hello_65c02_exe",
        ":support_rom_65c02",
    ],
    outs = ["hello_6502/hello.out"],
    cmd = """
set -euo pipefail

"$(location :6502)" \
  -rom "$(location :support_rom_65c02)" \
  "$(location :hello_65c02_exe)" > "$@"
""",
    tools = [":6502"],
)
