#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: install-davecc-tools [--prefix DIR] [--bindir DIR] [--includedir DIR]
                            [--libdir DIR] [--libexecdir DIR] [--destdir DIR]

Defaults:
  --prefix     /usr/local
  --bindir     PREFIX/bin
  --includedir PREFIX/include/davecc
  --libdir     PREFIX/lib/davecc
  --libexecdir PREFIX/libexec/davecc
EOF
  exit 2
}

PREFIX=/usr/local
BINDIR=
INCLUDEDIR=
LIBDIR=
LIBEXECDIR=
DESTDIR=

while [ "$#" -gt 0 ]; do
  case "$1" in
    --prefix) PREFIX=$2; shift 2 ;;
    --bindir) BINDIR=$2; shift 2 ;;
    --includedir) INCLUDEDIR=$2; shift 2 ;;
    --libdir) LIBDIR=$2; shift 2 ;;
    --libexecdir) LIBEXECDIR=$2; shift 2 ;;
    --destdir) DESTDIR=$2; shift 2 ;;
    -h|--help) usage ;;
    *) echo "unknown option: $1" >&2; usage ;;
  esac
done

BINDIR=${BINDIR:-"$PREFIX/bin"}
INCLUDEDIR=${INCLUDEDIR:-"$PREFIX/include/davecc"}
LIBDIR=${LIBDIR:-"$PREFIX/lib/davecc"}
LIBEXECDIR=${LIBEXECDIR:-"$PREFIX/libexec/davecc"}

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)
workspace_root=$(cd "$script_dir/.." >/dev/null 2>&1 && pwd)

candidate_paths() {
  local rel=$1
  if [ -n "${RUNFILES_DIR:-}" ]; then
    printf '%s\n' "$RUNFILES_DIR/_main/$rel"
    printf '%s\n' "$RUNFILES_DIR/davecc/$rel"
  fi
  printf '%s\n' "$workspace_root/$rel"
  printf '%s\n' "$workspace_root/bazel-bin/$rel"
  printf '%s\n' "$PWD/$rel"
  printf '%s\n' "$PWD/bazel-bin/$rel"
}

find_file() {
  local rel=$1
  local candidate
  while IFS= read -r candidate; do
    if [ -f "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done < <(candidate_paths "$rel")
  echo "missing required file: $rel" >&2
  return 1
}

find_executable() {
  local rel=$1
  local candidate
  while IFS= read -r candidate; do
    if [ -f "$candidate" ] && [ -x "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done < <(candidate_paths "$rel")
  echo "missing required executable: $rel" >&2
  return 1
}

find_dir() {
  local rel=$1
  local candidate
  while IFS= read -r candidate; do
    if [ -d "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done < <(candidate_paths "$rel")
  echo "missing required directory: $rel" >&2
  return 1
}

dest_path() {
  local path=$1
  case "$path" in
    /*) echo "$DESTDIR$path" ;;
    *) echo "$DESTDIR/$path" ;;
  esac
}

install_file() {
  local mode=$1 src=$2 dest=$3
  install -m "$mode" "$src" "$dest"
}

install_required_file() {
  local mode=$1 rel=$2 dest=$3
  local src
  src=$(find_file "$rel")
  install_file "$mode" "$src" "$dest"
}

install_required_executable() {
  local rel=$1 dest=$2
  local src
  src=$(find_executable "$rel")
  install_file 0755 "$src" "$dest"
}

actual_bindir=$(dest_path "$BINDIR")
actual_includedir=$(dest_path "$INCLUDEDIR")
actual_libdir=$(dest_path "$LIBDIR")
actual_libexecdir=$(dest_path "$LIBEXECDIR")

install -d "$actual_bindir" "$actual_includedir" "$actual_libdir" "$actual_libexecdir"

for script in \
  davecc-common.sh \
  davecc-65c02 davecc-aarch64 davecc-arm davecc-riscv davecc-riscv32 davecc-x86_64 \
  run-65c02 run-aarch64 run-arm run-riscv run-riscv32 run-esp32 run-x86_64; do
  install_required_file 0755 "bin/$script" "$actual_bindir/$script"
done

cat >"$actual_bindir/davecc-env.sh" <<EOF
# Generated by install-davecc-tools.
DAVECC_LIBEXEC_DIR=${LIBEXECDIR}
DAVECC_INCLUDE_DIR=${INCLUDEDIR}
DAVECC_LIB_DIR=${LIBDIR}
DAVECC_6502_ROM=${LIBDIR}/6502rom.exe
EOF
chmod 0644 "$actual_bindir/davecc-env.sh"

install_required_executable davecc "$actual_libexecdir/davecc"
install_required_executable archivist "$actual_libexecdir/archivist"
install_required_executable 6502 "$actual_libexecdir/6502"
install_required_executable 6502asm "$actual_libexecdir/6502asm"
install_required_executable aarch64asm "$actual_libexecdir/aarch64asm"
install_required_executable armasm "$actual_libexecdir/armasm"
install_required_executable rvasm "$actual_libexecdir/rvasm"
install_required_executable x86asm "$actual_libexecdir/x86asm"
install_required_executable aarch64 "$actual_libexecdir/aarch64"
install_required_executable arm "$actual_libexecdir/arm"
install_required_executable pcode "$actual_libexecdir/pcode"
install_required_executable riscv "$actual_libexecdir/riscv"
install_required_executable esp32 "$actual_libexecdir/esp32"
install_required_executable x86_64 "$actual_libexecdir/x86_64"
install_required_executable bpf "$actual_libexecdir/bpf"
install_required_executable run "$actual_bindir/run"

for tool in \
  6502asm 6502dasm \
  aarch64asm aarch64dasm \
  armasm armdasm \
  elfdump \
  rvasm riscvdasm \
  xtensadasm \
  x86asm x86_64dasm; do
  install_required_executable "$tool" "$actual_bindir/$tool"
done

for archive in libc65c02.a libcaarch64.a libcarm.a libcpcode.a libcriscv.a \
               libcriscv32.a libcxtensa.a libcx86_64.a; do
  install_required_file 0644 "libc/$archive" "$actual_libdir/$archive"
done
install_required_file 0644 "6502_support/6502rom.exe" "$actual_libdir/6502rom.exe"
install_required_file 0644 "libc/esp32_start.o" "$actual_libdir/esp32_start.o"

headers=$(find_dir "libc/include")
(cd "$headers" && tar cf - .) | (cd "$actual_includedir" && tar xf -)

cat <<EOF
Installed DaveCC command-line tools:
  scripts:      $BINDIR
  executables:  $LIBEXECDIR
  libc headers: $INCLUDEDIR
  libc archives:$LIBDIR
EOF
