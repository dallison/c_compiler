#! /bin/sh
# Tests skipped for davecc -target wasm32.

if ! test -f README.md; then
    echo "run from the c_testsuite directory." >&2
    exit 1
fi

# Thread-local storage.  Wasm has no equivalent without the threads proposal,
# so a __thread variable has nowhere to live.
echo "tests/single-exec/00238.c"

# setjmp/longjmp.  Unwinding to an earlier frame needs either the exception
# handling proposal or an Asyncify-style transform, and libc/include/setjmp.h
# has no wasm32 definition of jmp_buf at all.
echo "tests/single-exec/00247.c"

# Skipped for every target, not just this one.
echo "tests/single-exec/00216.c"
echo "tests/single-exec/00219.c"
echo "tests/single-exec/00220.c"
