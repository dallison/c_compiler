#! /bin/sh
# Tests skipped for davecc -target 65c02 (run from c_testsuite/ via Bazel).

if ! test -f README.md; then
    echo "run from the c_testsuite directory." >&2
    exit 1
fi

# Assumes double is double precision
echo "tests/single-exec/00174.c"

# This assumes sizeof int is 4
echo "tests/single-exec/00178.c"

# Assumes double is IEE754 double precision.
echo "tests/single-exec/00195.c"

# This one is too big to fit in 6502 memory.
echo "tests/single-exec/00204.c"

# Needs LP64 or LP32
echo "tests/single-exec/00212.c"

# GCC statement expressions and __builtin_expect are supported, but this test
# relies on size_t (32-bit unsigned long) values surviving a cast to a 16-bit
# 6502 pointer, which truncates.
echo "tests/single-exec/00214.c"

# Compound literals / designated ranges / flexible array members are supported,
# but this test assumes a 32-bit int layout that the 16-bit-int 6502 doesn't
# match.
echo "tests/single-exec/00216.c"

# _Generic is supported, but this test hits a pre-existing 6502 codegen bug in
# signed division of a variable by a power of two (e.g. (int)x / 2).
echo "tests/single-exec/00219.c"

# Wide string literals decode to Unicode code points (supported), but the 6502
# has a 16-bit int/wchar_t so the wchar_t[] array overflows and truncates.
echo "tests/single-exec/00220.c"
# Exercises double-precision math.h; on the 6502 double is a 32-bit float so
# the results don't meet the test's double-precision tolerance.
echo "tests/single-exec/00221.c"

# File I/O (fopen/fread/fgetc/fgets) not fully working in interpreter
