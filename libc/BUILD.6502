#!/bin/bash -x

# Build libc for 6502
support_src="../6502 support"
libc_src="."
CC=../davecc/davecc
CFLAGS="-target 65c02 -c -Xkeep-asm"
ar_opts=r
if [[ "$(uname)" == "darwin" ]]; then
  AR=archivist
else
  AR=ar
  ar_opts=rs
fi

function run() {
  cmd="$1"
  echo $cmd
  $cmd
}

# Build 6502 runtime
files=( start.s enter.s var_addr.s var_value.s push.s incdec.s \
        mul.s longmul.s longlongmul.s div.s longdiv.s longlongdiv.s spill.s \
        fcommon.s fadd.s fconv.s fcmp.s fneg.s fmul.s fdiv.s syscall.s \
        fmodf.s fldexp.s )
srcfiles=()
runtime_objfiles=()
rm -f "${runtime_objfiles[@]}"

for f in ${files[@]}; do
  runtime_objfiles+=( ${f%.s}.o )
  srcfiles+=( "$support_src/$f" )
done

for f in "${srcfiles[@]}"; do
    filename=$(basename "$f")
    objname=${filename%.s}.o
    ${CC} ${CFLAGS} "-I${support_src}" "$f" -o $objname || exit 1
done

# Build libc
files=( $(ls *.c) )

libc_objfiles=()
srcfiles=()
for f in ${files[@]}; do
  libc_objfiles+=( ${f%.c}.o )
  srcfiles+=( "$libc_src/$f" )
done
rm -f "${libc_objfiles[@]}"

for f in "${srcfiles[@]}"; do
    filename=$(basename "$f")
    objname=${filename%.c}.o
    ${CC} ${CFLAGS} "$f" -o $objname || exit 1
done

rm -f libc65c02.a
$AR ${ar_opts} libc65c02.a ${runtime_objfiles[@]} ${libc_objfiles[@]}
