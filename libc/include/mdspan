//
//  C++23 multidimensional view support for DaveCC.
//

#ifndef __davecc_mdspan__
#define __davecc_mdspan__

#include <array>
#include <cstddef>
#include <span>
#include <type_traits>
#include <utility>

#ifndef __cpp_lib_mdspan
#define __cpp_lib_mdspan 202207L
#endif

namespace std {

template <class IndexType, size_t... Extents>
class extents {
  static_assert(is_integral_v<IndexType>,
                "extents index type must be an integral type");
  static_assert(!is_same_v<remove_cv_t<IndexType>, bool>,
                "extents index type cannot be bool");

 public:
  using index_type = IndexType;
  using size_type = make_unsigned_t<index_type>;
  using rank_type = size_t;

  static constexpr rank_type rank() noexcept {
    return sizeof...(Extents);
  }

  static constexpr rank_type rank_dynamic() noexcept {
    return ((Extents == dynamic_extent ? 1 : 0) + ... + 0);
  }

  static constexpr size_t static_extent(rank_type rank_index) noexcept {
    size_t result = dynamic_extent;
    rank_type current = 0;
    ((current++ == rank_index ? result = Extents : result), ...);
    return result;
  }

 private:
  array<index_type, rank_dynamic()> __dynamic_extents{};

  static constexpr rank_type __dynamic_index(rank_type rank_index) noexcept {
    rank_type result = 0;
    for (rank_type r = 0; r < rank_index; r++) {
      if (static_extent(r) == dynamic_extent) {
        result++;
      }
    }
    return result;
  }

  template <class Values>
  constexpr void __assign_extents(const Values& values,
                                  rank_type value_count) noexcept {
    rank_type dynamic_index = 0;
    if (value_count == rank_dynamic()) {
      for (; dynamic_index < rank_dynamic(); dynamic_index++) {
        __dynamic_extents[dynamic_index] =
            static_cast<index_type>(values[dynamic_index]);
      }
      return;
    }
    for (rank_type r = 0; r < rank(); r++) {
      if (static_extent(r) == dynamic_extent) {
        __dynamic_extents[dynamic_index++] =
            static_cast<index_type>(values[r]);
      }
    }
  }

 public:
  constexpr extents() noexcept = default;

  template <class OtherIndexType, size_t... OtherExtents>
    requires(
        sizeof...(OtherExtents) == rank() &&
        ((Extents == dynamic_extent ||
          OtherExtents == dynamic_extent ||
          Extents == OtherExtents) && ...))
  constexpr explicit(
      (((Extents != dynamic_extent) &&
        (OtherExtents == dynamic_extent)) || ...))
      extents(const extents<OtherIndexType, OtherExtents...>& other) noexcept {
    rank_type dynamic_index = 0;
    for (rank_type r = 0; r < rank(); r++) {
      if (static_extent(r) == dynamic_extent) {
        __dynamic_extents[dynamic_index++] =
            static_cast<index_type>(other.extent(r));
      }
    }
  }

  template <class... OtherIndexTypes>
    requires(
        (sizeof...(OtherIndexTypes) == rank_dynamic() ||
         sizeof...(OtherIndexTypes) == rank()) &&
        (is_convertible_v<OtherIndexTypes, index_type> && ...) &&
        (is_nothrow_constructible_v<index_type, OtherIndexTypes> && ...))
  constexpr explicit extents(OtherIndexTypes... values) noexcept {
    index_type converted[sizeof...(OtherIndexTypes)]{
        static_cast<index_type>(std::move(values))...};
    __assign_extents(converted, sizeof...(OtherIndexTypes));
  }

  template <class OtherIndexType, size_t N>
    requires(
        (N == rank_dynamic() || N == rank()) &&
        is_convertible_v<const OtherIndexType&, index_type> &&
        is_nothrow_constructible_v<index_type, const OtherIndexType&>)
  constexpr explicit(N != rank_dynamic())
      extents(const array<OtherIndexType, N>& values) noexcept {
    __assign_extents(values, N);
  }

  template <class OtherIndexType, size_t N>
    requires(
        (N == rank_dynamic() || N == rank()) &&
        is_convertible_v<OtherIndexType, index_type> &&
        is_nothrow_constructible_v<index_type, OtherIndexType>)
  constexpr explicit(N != rank_dynamic())
      extents(span<OtherIndexType, N> values) noexcept {
    __assign_extents(values, N);
  }

  constexpr index_type extent(rank_type rank_index) const noexcept {
    size_t value = static_extent(rank_index);
    if (value != dynamic_extent) {
      return static_cast<index_type>(value);
    }
    return __dynamic_extents[__dynamic_index(rank_index)];
  }
};

template <class LeftIndexType, size_t... LeftExtents,
          class RightIndexType, size_t... RightExtents>
  requires(sizeof...(LeftExtents) == sizeof...(RightExtents))
constexpr bool operator==(
    const extents<LeftIndexType, LeftExtents...>& left,
    const extents<RightIndexType, RightExtents...>& right) noexcept {
  for (size_t r = 0; r < sizeof...(LeftExtents); r++) {
    if (left.extent(r) != right.extent(r)) {
      return false;
    }
  }
  return true;
}

template <class LeftIndexType, size_t... LeftExtents,
          class RightIndexType, size_t... RightExtents>
  requires(sizeof...(LeftExtents) == sizeof...(RightExtents))
constexpr bool operator!=(
    const extents<LeftIndexType, LeftExtents...>& left,
    const extents<RightIndexType, RightExtents...>& right) noexcept {
  return !(left == right);
}

template <size_t>
struct __mdspan_dynamic_extent_for_index {
  static constexpr size_t value = dynamic_extent;
};

template <class IndexType, class Sequence>
struct __make_dextents_type;

template <class IndexType, size_t... Indices>
struct __make_dextents_type<IndexType, index_sequence<Indices...>> {
  using type =
      extents<IndexType,
              __mdspan_dynamic_extent_for_index<Indices>::value...>;
};

template <class IndexType, size_t Rank>
struct __dextents_type {
  using sequence = make_index_sequence<Rank>;
  using type = typename __make_dextents_type<IndexType, sequence>::type;
};

template <class IndexType, size_t Rank>
using dextents = typename __dextents_type<IndexType, Rank>::type;

template <class>
struct __mdspan_dynamic_extent_for_type {
  static constexpr size_t value = dynamic_extent;
};

template <class... Integrals>
  requires((is_convertible_v<Integrals, size_t> && ...))
extents(Integrals...)
    -> extents<size_t,
               __mdspan_dynamic_extent_for_type<Integrals>::value...>;

template <class>
struct __mdspan_is_extents : false_type {};

template <class IndexType, size_t... ExtentValues>
struct __mdspan_is_extents<extents<IndexType, ExtentValues...>>
    : true_type {};

template <class>
struct __mdspan_has_static_zero_extent : false_type {};

template <class IndexType, size_t... ExtentValues>
struct __mdspan_has_static_zero_extent<
    extents<IndexType, ExtentValues...>>
    : bool_constant<((ExtentValues == 0) || ... || false)> {};

template <class Mapping>
struct __mdspan_mapping_rank {
  using extents_type = typename Mapping::extents_type;
  static constexpr size_t value = extents_type::rank();
};

struct layout_left {
  template <class Extents>
  class mapping;
};

struct layout_right {
  template <class Extents>
  class mapping;
};

struct layout_stride {
  template <class Extents>
  class mapping;
};

template <class Extents>
class layout_left::mapping {
  static_assert(__mdspan_is_extents<Extents>::value,
                "layout_left::mapping requires an extents specialization");

 public:
  using extents_type = Extents;
  using index_type = typename extents_type::index_type;
  using size_type = typename extents_type::size_type;
  using rank_type = typename extents_type::rank_type;
  using layout_type = layout_left;

 private:
  extents_type __extents{};

 public:
  constexpr mapping() noexcept : __extents() {}
  constexpr mapping(const mapping&) noexcept = default;
  constexpr mapping(const extents_type& value) noexcept : __extents(value) {}

  template <class OtherExtents>
    requires(is_constructible_v<extents_type, OtherExtents>)
  constexpr explicit(!is_convertible_v<OtherExtents, extents_type>)
      mapping(const mapping<OtherExtents>& other) noexcept
      : __extents(other.extents()) {}

  template <class OtherExtents>
    requires(extents_type::rank() <= 1 &&
             is_constructible_v<extents_type, OtherExtents>)
  constexpr explicit(!is_convertible_v<OtherExtents, extents_type>)
      mapping(const layout_right::mapping<OtherExtents>& other) noexcept
      : __extents(other.extents()) {}

  template <class OtherExtents>
    requires(is_constructible_v<extents_type, OtherExtents>)
  constexpr explicit(
      !(extents_type::rank() == 0 &&
        is_convertible_v<OtherExtents, extents_type>))
      mapping(const layout_stride::mapping<OtherExtents>& other) noexcept
      : __extents(other.extents()) {}

  constexpr mapping& operator=(const mapping&) noexcept = default;

  constexpr const extents_type& extents() const noexcept {
    return __extents;
  }

  constexpr index_type required_span_size() const noexcept {
    index_type result = 1;
    for (rank_type r = 0; r < extents_type::rank(); r++) {
      result *= __extents.extent(r);
    }
    return result;
  }

  template <class... Indices>
    requires(
        sizeof...(Indices) == extents_type::rank() &&
        (is_convertible_v<Indices, index_type> && ...) &&
        (is_nothrow_constructible_v<index_type, Indices> && ...))
  constexpr index_type operator()(Indices... indices) const noexcept {
    array<index_type, extents_type::rank()> values{
        static_cast<index_type>(std::move(indices))...};
    index_type result = 0;
    index_type current_stride = 1;
    for (rank_type r = 0; r < extents_type::rank(); r++) {
      result += values[r] * current_stride;
      current_stride *= __extents.extent(r);
    }
    return result;
  }

  static constexpr bool is_always_unique() noexcept { return true; }
  static constexpr bool is_always_exhaustive() noexcept { return true; }
  static constexpr bool is_always_strided() noexcept { return true; }
  static constexpr bool is_unique() noexcept { return true; }
  static constexpr bool is_exhaustive() noexcept { return true; }
  static constexpr bool is_strided() noexcept { return true; }

  constexpr index_type stride(rank_type rank_index) const noexcept
    requires(extents_type::rank() > 0)
  {
    index_type result = 1;
    for (rank_type r = 0; r < rank_index; r++) {
      result *= __extents.extent(r);
    }
    return result;
  }

  template <class OtherExtents>
    requires(extents_type::rank() == OtherExtents::rank())
  constexpr bool operator==(
      const mapping<OtherExtents>& right) const noexcept {
    return __extents == right.extents();
  }
};

template <class Extents>
class layout_right::mapping {
  static_assert(__mdspan_is_extents<Extents>::value,
                "layout_right::mapping requires an extents specialization");

 public:
  using extents_type = Extents;
  using index_type = typename extents_type::index_type;
  using size_type = typename extents_type::size_type;
  using rank_type = typename extents_type::rank_type;
  using layout_type = layout_right;

 private:
  extents_type __extents{};

 public:
  constexpr mapping() noexcept : __extents() {}
  constexpr mapping(const mapping&) noexcept = default;
  constexpr mapping(const extents_type& value) noexcept : __extents(value) {}

  template <class OtherExtents>
    requires(is_constructible_v<extents_type, OtherExtents>)
  constexpr explicit(!is_convertible_v<OtherExtents, extents_type>)
      mapping(const mapping<OtherExtents>& other) noexcept
      : __extents(other.extents()) {}

  template <class OtherExtents>
    requires(extents_type::rank() <= 1 &&
             is_constructible_v<extents_type, OtherExtents>)
  constexpr explicit(!is_convertible_v<OtherExtents, extents_type>)
      mapping(const layout_left::mapping<OtherExtents>& other) noexcept
      : __extents(other.extents()) {}

  template <class OtherExtents>
    requires(is_constructible_v<extents_type, OtherExtents>)
  constexpr explicit(
      !(extents_type::rank() == 0 &&
        is_convertible_v<OtherExtents, extents_type>))
      mapping(const layout_stride::mapping<OtherExtents>& other) noexcept
      : __extents(other.extents()) {}

  constexpr mapping& operator=(const mapping&) noexcept = default;

  constexpr const extents_type& extents() const noexcept {
    return __extents;
  }

  constexpr index_type required_span_size() const noexcept {
    index_type result = 1;
    for (rank_type r = 0; r < extents_type::rank(); r++) {
      result *= __extents.extent(r);
    }
    return result;
  }

  template <class... Indices>
    requires(
        sizeof...(Indices) == extents_type::rank() &&
        (is_convertible_v<Indices, index_type> && ...) &&
        (is_nothrow_constructible_v<index_type, Indices> && ...))
  constexpr index_type operator()(Indices... indices) const noexcept {
    array<index_type, extents_type::rank()> values{
        static_cast<index_type>(std::move(indices))...};
    index_type result = 0;
    index_type current_stride = 1;
    for (rank_type r = extents_type::rank(); r > 0; r--) {
      result += values[r - 1] * current_stride;
      current_stride *= __extents.extent(r - 1);
    }
    return result;
  }

  static constexpr bool is_always_unique() noexcept { return true; }
  static constexpr bool is_always_exhaustive() noexcept { return true; }
  static constexpr bool is_always_strided() noexcept { return true; }
  static constexpr bool is_unique() noexcept { return true; }
  static constexpr bool is_exhaustive() noexcept { return true; }
  static constexpr bool is_strided() noexcept { return true; }

  constexpr index_type stride(rank_type rank_index) const noexcept
    requires(extents_type::rank() > 0)
  {
    index_type result = 1;
    for (rank_type r = extents_type::rank(); r > rank_index + 1; r--) {
      result *= __extents.extent(r - 1);
    }
    return result;
  }

  template <class OtherExtents>
    requires(extents_type::rank() == OtherExtents::rank())
  constexpr bool operator==(
      const mapping<OtherExtents>& right) const noexcept {
    return __extents == right.extents();
  }
};

template <class Extents>
class layout_stride::mapping {
  static_assert(__mdspan_is_extents<Extents>::value,
                "layout_stride::mapping requires an extents specialization");

 public:
  using extents_type = Extents;
  using index_type = typename extents_type::index_type;
  using size_type = typename extents_type::size_type;
  using rank_type = typename extents_type::rank_type;
  using layout_type = layout_stride;

 private:
  static constexpr rank_type __rank = extents_type::rank();

  extents_type __extents{};
  array<index_type, __rank> __strides{};
  bool __uses_default_strides = true;

  template <class OtherIndexType>
  constexpr void __assign_strides(const OtherIndexType& values) noexcept {
    __uses_default_strides = false;
    for (rank_type r = 0; r < __rank; r++) {
      __strides[r] = static_cast<index_type>(values[r]);
    }
  }

  template <class OtherMapping, size_t... Indices>
  static constexpr index_type __offset(
      const OtherMapping& mapping,
      index_sequence<Indices...>) noexcept {
    return static_cast<index_type>(
        mapping(static_cast<index_type>(Indices * 0)...));
  }

 public:
  constexpr mapping() noexcept
      : __extents(), __strides(), __uses_default_strides(true) {}

  constexpr mapping(const mapping&) noexcept = default;

  template <class OtherIndexType>
    requires(
        is_convertible_v<const OtherIndexType&, index_type> &&
        is_nothrow_constructible_v<index_type, const OtherIndexType&>)
  constexpr mapping(const extents_type& extents,
                    span<OtherIndexType, __rank> strides) noexcept
      : __extents(extents) {
    __assign_strides(strides);
  }

  template <class OtherIndexType>
    requires(
        is_convertible_v<const OtherIndexType&, index_type> &&
        is_nothrow_constructible_v<index_type, const OtherIndexType&>)
  constexpr mapping(
      const extents_type& extents,
      const array<OtherIndexType, __rank>& strides) noexcept
      : __extents(extents) {
    __assign_strides(strides);
  }

  template <class StridedLayoutMapping>
    requires(
        is_constructible_v<
            extents_type,
            typename StridedLayoutMapping::extents_type> &&
        StridedLayoutMapping::is_always_unique() &&
        StridedLayoutMapping::is_always_strided())
  constexpr explicit(
      !(is_convertible_v<typename StridedLayoutMapping::extents_type,
                         extents_type> &&
        (is_same_v<
             StridedLayoutMapping,
             layout_left::mapping<
                 typename StridedLayoutMapping::extents_type>> ||
         is_same_v<
             StridedLayoutMapping,
             layout_right::mapping<
                 typename StridedLayoutMapping::extents_type>> ||
         is_same_v<
             StridedLayoutMapping,
             layout_stride::mapping<
                 typename StridedLayoutMapping::extents_type>>)))
      mapping(const StridedLayoutMapping& other) noexcept
      : __extents(other.extents()), __uses_default_strides(false) {
    for (rank_type r = 0; r < __rank; r++) {
      __strides[r] = static_cast<index_type>(other.stride(r));
    }
  }

  constexpr mapping& operator=(const mapping&) noexcept = default;

  constexpr const extents_type& extents() const noexcept {
    return __extents;
  }

  constexpr array<index_type, __rank> strides() const noexcept {
    array<index_type, __rank> result{};
    for (rank_type r = 0; r < __rank; r++) {
      result[r] = stride(r);
    }
    return result;
  }

  constexpr index_type required_span_size() const noexcept {
    if (__rank == 0) {
      return 1;
    }
    for (rank_type r = 0; r < __rank; r++) {
      if (__extents.extent(r) == 0) {
        return 0;
      }
    }
    index_type result = 1;
    for (rank_type r = 0; r < __rank; r++) {
      result += (__extents.extent(r) - 1) * stride(r);
    }
    return result;
  }

  template <class... Indices>
    requires(
        sizeof...(Indices) == extents_type::rank() &&
        (is_convertible_v<Indices, index_type> && ...) &&
        (is_nothrow_constructible_v<index_type, Indices> && ...))
  constexpr index_type operator()(Indices... indices) const noexcept {
    array<index_type, __rank> values{
        static_cast<index_type>(std::move(indices))...};
    index_type result = 0;
    for (rank_type r = 0; r < __rank; r++) {
      result += values[r] * stride(r);
    }
    return result;
  }

  static constexpr bool is_always_unique() noexcept { return true; }

  static constexpr bool is_always_exhaustive() noexcept {
    return __rank == 0 ||
           __mdspan_has_static_zero_extent<extents_type>::value;
  }

  static constexpr bool is_always_strided() noexcept { return true; }
  static constexpr bool is_unique() noexcept { return true; }

  constexpr bool is_exhaustive() const noexcept {
    index_type index_space_size = 1;
    for (rank_type r = 0; r < __rank; r++) {
      index_space_size *= __extents.extent(r);
    }
    return required_span_size() == index_space_size;
  }

  static constexpr bool is_strided() noexcept { return true; }

  constexpr index_type stride(rank_type rank_index) const noexcept {
    if (__uses_default_strides) {
      index_type result = 1;
      for (rank_type r = __rank; r > rank_index + 1; r--) {
        result *= __extents.extent(r - 1);
      }
      return result;
    }
    return __strides[rank_index];
  }

  template <class OtherMapping>
    requires(
        extents_type::rank() ==
            __mdspan_mapping_rank<OtherMapping>::value &&
        OtherMapping::is_always_strided())
  constexpr bool operator==(const OtherMapping& right) const noexcept {
    if (!(__extents == right.extents())) {
      return false;
    }
    if constexpr (
        !is_same_v<
            OtherMapping,
            layout_left::mapping<typename OtherMapping::extents_type>> &&
        !is_same_v<
            OtherMapping,
            layout_right::mapping<typename OtherMapping::extents_type>> &&
        !is_same_v<
            OtherMapping,
            layout_stride::mapping<typename OtherMapping::extents_type>>) {
      if (__offset(right, make_index_sequence<__rank>()) != 0) {
        return false;
      }
    }
    for (rank_type r = 0; r < __rank; r++) {
      if (stride(r) != right.stride(r)) {
        return false;
      }
    }
    return true;
  }
};

template <class ElementType>
struct default_accessor {
  using offset_policy = default_accessor;
  using element_type = ElementType;
  using reference = element_type&;
  using data_handle_type = element_type*;

  constexpr default_accessor() noexcept = default;

  template <class OtherElementType>
    requires(is_convertible_v<OtherElementType (*)[], element_type (*)[]>)
  constexpr default_accessor(
      default_accessor<OtherElementType>) noexcept {}

  constexpr reference access(data_handle_type pointer,
                             size_t index) const noexcept {
    return pointer[index];
  }

  constexpr data_handle_type offset(data_handle_type pointer,
                                    size_t index) const noexcept {
    return pointer + index;
  }
};

}  // namespace std

#endif /* __davecc_mdspan__ */
