  constexpr optional<T&> try_emplace_back(Args&&...) {
    return nullopt;
  }
  template <class... Args>
  constexpr reference unchecked_emplace_back(Args&&...) {
    return (*this)[0];
  }
  constexpr reference push_back(const T&) {
    __fail();
    return (*this)[0];
  }
  constexpr reference push_back(T&&) {
    __fail();
    return (*this)[0];
  }
  constexpr optional<T&> try_push_back(const T&) { return nullopt; }
  constexpr optional<T&> try_push_back(T&&) { return nullopt; }
  constexpr reference unchecked_push_back(const T&) { return (*this)[0]; }
  constexpr reference unchecked_push_back(T&&) { return (*this)[0]; }
  constexpr void pop_back() {}
  template <ranges::input_range R>
  constexpr void append_range(R&& range) {
    if (ranges::begin(range) != ranges::end(range)) __fail();
  }
  constexpr void clear() noexcept {}
  constexpr iterator erase(const_iterator pos) {
    return const_cast<iterator>(pos);
  }
  constexpr iterator erase(const_iterator, const_iterator last) {
    return const_cast<iterator>(last);
  }
  constexpr void swap(inplace_vector&) noexcept {}
};

template <class T, size_t N>
constexpr bool operator==(const inplace_vector<T, N>& left,
                          const inplace_vector<T, N>& right) {
  if (left.size() != right.size()) {
    return false;
  }
  for (size_t i = 0; i < left.size(); ++i) {
    if (!(left[i] == right[i])) {
      return false;
    }
  }
  return true;
}

template <class T, size_t N>
constexpr auto operator<=>(const inplace_vector<T, N>& left,
                           const inplace_vector<T, N>& right)
    -> decltype(__inplace_vector_detail::__synth_three_way(
        std::declval<const T&>(), std::declval<const T&>()))
    requires(requires(const T& a, const T& b) { a <=> b; } ||
             requires(const T& a, const T& b) {
               a < b;
               b < a;
             })
{
  using result_type = decltype(
      __inplace_vector_detail::__synth_three_way(left[0], right[0]));
  size_t common = left.size() < right.size() ? left.size() : right.size();
  for (size_t i = 0; i < common; ++i) {
    auto order =
        __inplace_vector_detail::__synth_three_way(left[i], right[i]);
    if (order != 0) {
      return order;
    }
  }
  if (left.size() < right.size()) {
    return result_type::less;
  }
  if (right.size() < left.size()) {
    return result_type::greater;
  }
  return result_type::equivalent;
}

template <class T, size_t N>
constexpr void swap(inplace_vector<T, N>& left,
                    inplace_vector<T, N>& right)
    noexcept(noexcept(left.swap(right))) {
  left.swap(right);
}

template <class T, size_t N, class U = T>
constexpr typename inplace_vector<T, N>::size_type erase(
    inplace_vector<T, N>& container, const U& value) {
  auto old_size = container.size();
  auto out = container.begin();
  for (auto it = container.begin(); it != container.end(); ++it) {
    if (!(*it == value)) {
      if (out != it) {
        *out = std::move(*it);
      }
      ++out;
    }
  }
  container.erase(out, container.end());
  return old_size - container.size();
}

template <class T, size_t N, class Predicate>
constexpr typename inplace_vector<T, N>::size_type erase_if(
    inplace_vector<T, N>& container, Predicate predicate) {
  auto old_size = container.size();
  auto out = container.begin();
  for (auto it = container.begin(); it != container.end(); ++it) {
    if (!predicate(*it)) {
      if (out != it) {
        *out = std::move(*it);
      }
      ++out;
    }
  }
  container.erase(out, container.end());
  return old_size - container.size();
}

