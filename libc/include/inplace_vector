template <class T, size_t N, bool = is_trivially_destructible_v<T>>
union __storage;

template <class T, size_t N>
union __storage<T, N, true> {
  char __dummy_;
  T __values_[N];

  constexpr __storage() noexcept : __dummy_() {}
  ~__storage() = default;
};

template <class T, size_t N>
union __storage<T, N, false> {
  char __dummy_;
  T __values_[N];

  constexpr __storage() noexcept : __dummy_() {}
  constexpr ~__storage() {}
};

constexpr void __throw_bad_alloc() {
  __DAVECC_THROW(bad_alloc());
}

constexpr void __throw_out_of_range() {
  __DAVECC_THROW(out_of_range("inplace_vector::at"));
}

template <class T>
  requires requires(const T& left, const T& right) { left <=> right; }
constexpr auto __synth_three_way(const T& left, const T& right) {
  return left <=> right;
}

template <class T>
  requires(!requires(const T& left, const T& right) { left <=> right; } &&
           requires(const T& left, const T& right) {
             left < right;
             right < left;
           })
constexpr weak_ordering __synth_three_way(const T& left, const T& right) {
  if (left < right) {
    return weak_ordering::less;
  }
  if (right < left) {
    return weak_ordering::greater;
  }
  return weak_ordering::equivalent;
}

