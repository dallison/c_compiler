  class reference {
    friend class vector;
    __word* __word_;
    __word __mask_;

    reference(__word* word, __word mask) noexcept : __word_(word), __mask_(mask) {}

   public:
    reference(const reference&) noexcept = default;
    ~reference() = default;

    operator bool() const noexcept { return (*__word_ & __mask_) != 0; }

    reference& operator=(bool value) noexcept {
      if (value) {
        *__word_ |= __mask_;
      } else {
        *__word_ &= ~__mask_;
      }
      return *this;
    }

    reference& operator=(const reference& other) noexcept {
      return *this = bool(other);
    }

    void flip() noexcept { *__word_ ^= __mask_; }

    friend void swap(reference left, reference right) noexcept {
      bool value = bool(left);
      left = bool(right);
      right = value;
    }

    friend bool operator==(reference left, reference right) noexcept {
      return bool(left) == bool(right);
    }
    friend bool operator==(reference left, bool right) noexcept {
      return bool(left) == right;
    }
    friend bool operator==(bool left, reference right) noexcept {
      return left == bool(right);
    }
    friend bool operator!=(reference left, reference right) noexcept {
      return bool(left) != bool(right);
    }
    friend bool operator<(reference left, reference right) noexcept {
      return bool(left) < bool(right);
    }
    friend bool operator<(reference left, bool right) noexcept {
      return bool(left) < right;
    }
    friend bool operator<(bool left, reference right) noexcept {
      return left < bool(right);
    }
