//
//  vector
//  c_compiler
//
//  C++20 std::vector support for DaveCC.
//
//  Storage is a single contiguous allocation obtained from the allocator.  The
//  range [__data_, __data_ + __size_) contains live T objects; the remainder up
//  to __cap_ is raw storage.  Element lifetime is managed with placement new and
//  explicit destruction so non-trivial element types work correctly.
//

#ifndef __davecc_vector__
#define __davecc_vector__

#if __cplusplus < 201103L

#include <algorithm>
#include <cstddef>
#include <iterator>
#include <memory>
#include <stdexcept>
#include <utility>

namespace std {

template <class T, class Allocator = allocator<T> >
class vector {
 public:
  typedef T value_type;
  typedef Allocator allocator_type;
  typedef size_t size_type;
  typedef ptrdiff_t difference_type;
  typedef T& reference;
  typedef const T& const_reference;
  typedef T* pointer;
  typedef const T* const_pointer;
  typedef T* iterator;
  typedef const T* const_iterator;
  typedef std::reverse_iterator<iterator> reverse_iterator;
  typedef std::reverse_iterator<const_iterator> const_reverse_iterator;

  explicit vector(const Allocator& allocator_value = Allocator())
      : data_(0), size_(0), capacity_(0), allocator_(allocator_value) {}

  explicit vector(size_type count, const T& value = T(),
                  const Allocator& allocator_value = Allocator())
      : data_(0), size_(0), capacity_(0), allocator_(allocator_value) {
    reserve(count);
    while (size_ < count) push_back(value);
  }

  template <class InputIt>
  vector(InputIt first, InputIt last,
         const Allocator& allocator_value = Allocator())
      : data_(0), size_(0), capacity_(0), allocator_(allocator_value) {
    for (; first != last; ++first) push_back(*first);
  }

  vector(const vector& other)
      : data_(0), size_(0), capacity_(0), allocator_(other.allocator_) {
    reserve(other.size_);
    for (size_type i = 0; i < other.size_; ++i) push_back(other.data_[i]);
  }

  ~vector() {
    clear();
    if (data_ != 0) allocator_.deallocate(data_, capacity_);
  }

  vector& operator=(const vector& other) {
    if (this != &other) {
      clear();
      reserve(other.size_);
      for (size_type i = 0; i < other.size_; ++i) push_back(other.data_[i]);
    }
    return *this;
  }

  iterator begin() { return data_; }
  const_iterator begin() const { return data_; }
  iterator end() { return data_ + size_; }
  const_iterator end() const { return data_ + size_; }
  reverse_iterator rbegin() { return reverse_iterator(end()); }
  const_reverse_iterator rbegin() const {
    return const_reverse_iterator(end());
  }
  reverse_iterator rend() { return reverse_iterator(begin()); }
  const_reverse_iterator rend() const {
    return const_reverse_iterator(begin());
  }

  size_type size() const { return size_; }
  size_type capacity() const { return capacity_; }
  bool empty() const { return size_ == 0; }
  size_type max_size() const { return allocator_.max_size(); }
  allocator_type get_allocator() const { return allocator_; }

  reference operator[](size_type index) { return data_[index]; }
  const_reference operator[](size_type index) const { return data_[index]; }
  reference at(size_type index) {
    if (index >= size_) throw out_of_range("vector::at");
    return data_[index];
  }
  const_reference at(size_type index) const {
    if (index >= size_) throw out_of_range("vector::at");
    return data_[index];
  }
  reference front() { return data_[0]; }
  const_reference front() const { return data_[0]; }
  reference back() { return data_[size_ - 1]; }
  const_reference back() const { return data_[size_ - 1]; }

  void reserve(size_type requested) {
    if (requested <= capacity_) return;
    pointer replacement = allocator_.allocate(requested);
    size_type constructed = 0;
    try {
      for (; constructed < size_; ++constructed) {
        allocator_.construct(replacement + constructed, data_[constructed]);
      }
    } catch (...) {
      while (constructed != 0) {
        --constructed;
        allocator_.destroy(replacement + constructed);
      }
      allocator_.deallocate(replacement, requested);
      throw;
    }
    for (size_type i = 0; i < size_; ++i) allocator_.destroy(data_ + i);
    if (data_ != 0) allocator_.deallocate(data_, capacity_);
    data_ = replacement;
    capacity_ = requested;
  }

  void resize(size_type count, T value = T()) {
    while (size_ > count) pop_back();
    if (count > capacity_) reserve(count);
    while (size_ < count) push_back(value);
  }

  void push_back(const T& value) {
    if (size_ == capacity_) reserve(capacity_ == 0 ? 1 : capacity_ * 2);
    allocator_.construct(data_ + size_, value);
    ++size_;
  }

  void pop_back() {
    --size_;
    allocator_.destroy(data_ + size_);
  }

  iterator insert(iterator position, const T& value) {
    size_type index = static_cast<size_type>(position - begin());
    if (size_ == capacity_) reserve(capacity_ == 0 ? 1 : capacity_ * 2);
    if (index == size_) {
      push_back(value);
      return begin() + index;
    }
    allocator_.construct(data_ + size_, data_[size_ - 1]);
    ++size_;
    for (size_type i = size_ - 1; i > index; --i) data_[i] = data_[i - 1];
    data_[index] = value;
    return begin() + index;
  }

  iterator erase(iterator position) {
    return erase(position, position + 1);
  }

  iterator erase(iterator first, iterator last) {
    size_type index = static_cast<size_type>(first - begin());
    size_type removed = static_cast<size_type>(last - first);
    for (size_type i = index; i + removed < size_; ++i) {
      data_[i] = data_[i + removed];
    }
    while (removed-- != 0) pop_back();
    return begin() + index;
  }

  void clear() {
    while (size_ != 0) pop_back();
  }

  void swap(vector& other) {
    std::swap(data_, other.data_);
    std::swap(size_, other.size_);
    std::swap(capacity_, other.capacity_);
    std::swap(allocator_, other.allocator_);
  }

 private:
  pointer data_;
  size_type size_;
  size_type capacity_;
  allocator_type allocator_;
};

template <class T, class Allocator>
bool operator==(const vector<T, Allocator>& left,
                const vector<T, Allocator>& right) {
  return left.size() == right.size() &&
         std::equal(left.begin(), left.end(), right.begin());
}

template <class T, class Allocator>
bool operator!=(const vector<T, Allocator>& left,
                const vector<T, Allocator>& right) {
  return !(left == right);
}

template <class T, class Allocator>
bool operator<(const vector<T, Allocator>& left,
               const vector<T, Allocator>& right) {
  return std::lexicographical_compare(left.begin(), left.end(),
                                      right.begin(), right.end());
}

template <class T, class Allocator>
void swap(vector<T, Allocator>& left, vector<T, Allocator>& right) {
  left.swap(right);
}

