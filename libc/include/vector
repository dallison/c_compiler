  using __storage_alloc = typename __alloc_traits::template rebind_alloc<__word>;
  using __storage_traits = allocator_traits<__storage_alloc>;

  static size_type __word_count(size_type bits) {
    return bits == 0 ? 0 : (bits + __bits - 1) / __bits;
  }

  static __word __mask_at(size_type index) {
    return __word(1) << (index % __bits);
  }

