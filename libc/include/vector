template <class T, class Allocator, class U>
__DAVECC_VECTOR_CONSTEXPR typename vector<T, Allocator>::size_type erase(
    vector<T, Allocator>& c, const U& value) {
  typename vector<T, Allocator>::iterator out = c.begin();
  typename vector<T, Allocator>::iterator it = c.begin();
  typename vector<T, Allocator>::iterator last = c.end();
  for (; it != last; ++it) {
    if (!(*it == value)) {
      if (out != it) {
        *out = static_cast<T&&>(*it);
      }
      ++out;
    }
  }
  typename vector<T, Allocator>::size_type removed =
      static_cast<typename vector<T, Allocator>::size_type>(last - out);
  c.erase(out, last);
  return removed;
}

