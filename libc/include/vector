template <class T, class Allocator = allocator<T>>
class vector {
 public:
  using value_type = T;
  using allocator_type = Allocator;
  using size_type = size_t;
  using difference_type = ptrdiff_t;
  using reference = T&;
  using const_reference = const T&;
  using pointer = T*;
  using const_pointer = const T*;
  using iterator = T*;
  using const_iterator = const T*;
  using reverse_iterator = std::reverse_iterator<iterator>;
  using const_reverse_iterator = std::reverse_iterator<const_iterator>;

 private:
  using __alloc_traits = allocator_traits<allocator_type>;

  pointer __data_;
  size_type __size_;
  size_type __cap_;
  allocator_type __alloc_;

  __DAVECC_VECTOR_CONSTEXPR static size_type __recommend(size_type current, size_type needed) {
    size_type next = current == 0 ? 1 : current * 2;
    if (next < needed) {
      next = needed;
    }
    return next;
  }

  __DAVECC_VECTOR_CONSTEXPR pointer __allocate(size_type count) {
    return __alloc_traits::allocate(__alloc_, count);
  }

  __DAVECC_VECTOR_CONSTEXPR void __deallocate(pointer ptr, size_type count) noexcept {
    __alloc_traits::deallocate(__alloc_, ptr, count);
  }

  template <class... Args>
  __DAVECC_VECTOR_CONSTEXPR void __construct_one(pointer p, Args&&... args) {
    __alloc_traits::construct(__alloc_, p, std::forward<Args>(args)...);
  }

  __DAVECC_VECTOR_CONSTEXPR void __construct_copy_one(pointer p, const T& value) {
    __alloc_traits::construct(__alloc_, p, value);
  }

  __DAVECC_VECTOR_CONSTEXPR void __construct_move_one(pointer p, T&& value) {
    __alloc_traits::construct(__alloc_, p, static_cast<T&&>(value));
  }

  __DAVECC_VECTOR_CONSTEXPR void __destroy_one(pointer p) noexcept {
    __alloc_traits::destroy(__alloc_, p);
  }

  __DAVECC_VECTOR_CONSTEXPR void __destroy_range(pointer first, pointer last) noexcept {
    while (last != first) {
      --last;
      __destroy_one(last);
    }
  }

  __DAVECC_VECTOR_CONSTEXPR size_type __index_of(const_iterator pos) const noexcept {
    return __data_ == nullptr ? 0 : static_cast<size_type>(pos - __data_);
  }

  __DAVECC_VECTOR_CONSTEXPR void __destroy_all() noexcept {
    if (__size_ != 0) {
      __destroy_range(__data_, __data_ + __size_);
    }
    __size_ = 0;
  }

  __DAVECC_VECTOR_CONSTEXPR void __deallocate_storage() noexcept {
    if (__data_ != nullptr) {
      __deallocate(__data_, __cap_);
    }
    __data_ = nullptr;
    __cap_ = 0;
  }

  __DAVECC_VECTOR_CONSTEXPR void __reset_empty() noexcept {
    __data_ = nullptr;
    __size_ = 0;
    __cap_ = 0;
  }

  __DAVECC_VECTOR_CONSTEXPR void __construct_fill(pointer dst, size_type count, const T& value) {
    size_type i = 0;
    __DAVECC_TRY {
      for (; i < count; i++) {
        __construct_copy_one(dst + i, value);
      }
    } __DAVECC_CATCH_ALL {
      __destroy_range(dst, dst + i);
      __DAVECC_RETHROW;
    }
  }

  __DAVECC_VECTOR_CONSTEXPR void __construct_default(pointer dst, size_type count) {
    size_type i = 0;
    __DAVECC_TRY {
      for (; i < count; i++) {
        __alloc_traits::construct(__alloc_, dst + i);
      }
    } __DAVECC_CATCH_ALL {
      __destroy_range(dst, dst + i);
      __DAVECC_RETHROW;
    }
  }

  template <class It>
  __DAVECC_VECTOR_CONSTEXPR void __construct_range(pointer dst, It first, It last) {
    size_type i = 0;
    __DAVECC_TRY {
      for (; first != last; ++first, ++i) {
        __construct_one(dst + i, *first);
      }
    } __DAVECC_CATCH_ALL {
      __destroy_range(dst, dst + i);
      __DAVECC_RETHROW;
    }
  }

  __DAVECC_VECTOR_CONSTEXPR void __construct_move(pointer dst, pointer first, pointer last) {
    size_type i = 0;
    __DAVECC_TRY {
      for (; first != last; ++first, ++i) {
        __construct_move_one(dst + i, std::move(*first));
      }
    } __DAVECC_CATCH_ALL {
      __destroy_range(dst, dst + i);
      __DAVECC_RETHROW;
    }
  }

  __DAVECC_VECTOR_CONSTEXPR void __construct_copy(pointer dst, const_pointer first, const_pointer last) {
    size_type i = 0;
    __DAVECC_TRY {
      for (; first != last; ++first, ++i) {
        __construct_copy_one(dst + i, *first);
      }
    } __DAVECC_CATCH_ALL {
      __destroy_range(dst, dst + i);
      __DAVECC_RETHROW;
    }
  }

  __DAVECC_VECTOR_CONSTEXPR void __reserve_exact(size_type new_cap) {
    if (new_cap <= __cap_) {
      return;
    }
    pointer fresh = __allocate(new_cap);
    __DAVECC_TRY {
      if (__size_ != 0) {
        __construct_move(fresh, __data_, __data_ + __size_);
      }
    } __DAVECC_CATCH_ALL {
      __deallocate(fresh, new_cap);
      __DAVECC_RETHROW;
    }
    if (__size_ != 0) {
      __destroy_range(__data_, __data_ + __size_);
    }
    __deallocate_storage();
    __data_ = fresh;
    __cap_ = new_cap;
  }

  __DAVECC_VECTOR_CONSTEXPR void __grow_for(size_type needed) {
    if (needed > __cap_) {
      __reserve_exact(__recommend(__cap_, needed));
    }
  }

  __DAVECC_VECTOR_CONSTEXPR void __take_storage_from(vector& other) noexcept {
    __data_ = other.__data_;
    __size_ = other.__size_;
    __cap_ = other.__cap_;
    other.__reset_empty();
  }

  __DAVECC_VECTOR_CONSTEXPR void __assign_move_from(vector& other) {
    size_type count = other.__size_;
    pointer fresh = nullptr;
    if (count != 0) {
      fresh = __allocate(count);
      __DAVECC_TRY {
        __construct_move(fresh, other.__data_, other.__data_ + count);
      } __DAVECC_CATCH_ALL {
        __deallocate(fresh, count);
        __DAVECC_RETHROW;
      }
    }
    __destroy_all();
    __deallocate_storage();
    __data_ = fresh;
    __size_ = count;
    __cap_ = count;
    other.__destroy_all();
  }

  __DAVECC_VECTOR_CONSTEXPR void __swap_storage(vector& other) noexcept {
    pointer data = __data_;
    size_type size = __size_;
    size_type cap = __cap_;
    __data_ = other.__data_;
    __size_ = other.__size_;
    __cap_ = other.__cap_;
    other.__data_ = data;
    other.__size_ = size;
    other.__cap_ = cap;
  }

  // [sequence.reqmts]: range construction requires only that T be
  // EmplaceConstructible from `*first` (`vector<string>` from string_views).
  template <class It>
  __DAVECC_VECTOR_CONSTEXPR void __append_range(It first, It last) {
    for (; first != last; ++first) {
      __grow_for(__size_ + 1);
      __construct_one(__data_ + __size_, *first);
      __size_++;
    }
  }

  __DAVECC_VECTOR_CONSTEXPR void __grow_temp_buffer(pointer* data, size_type size, size_type* cap) {
    size_type new_cap = __recommend(*cap, size + 1);
    pointer fresh = __allocate(new_cap);
    __DAVECC_TRY {
      if (size != 0) {
        __construct_move(fresh, *data, *data + size);
      }
    } __DAVECC_CATCH_ALL {
      __deallocate(fresh, new_cap);
      __DAVECC_RETHROW;
    }
    if (*data != nullptr) {
      __destroy_range(*data, *data + size);
      __deallocate(*data, *cap);
    }
    *data = fresh;
    *cap = new_cap;
  }

  template <class V>
  __DAVECC_VECTOR_CONSTEXPR void __append_temp_buffer(pointer* data, size_type* size, size_type* cap,
                            V&& value) {
    if (*size == *cap) {
      __grow_temp_buffer(data, *size, cap);
    }
    __construct_one(*data + *size, std::forward<V>(value));
    *size = *size + 1;
  }

  template <class It>
  __DAVECC_VECTOR_CONSTEXPR void __range_to_temp_buffer(It first, It last, pointer* data,
                              size_type* size, size_type* cap) {
    *data = nullptr;
    *size = 0;
    *cap = 0;
    __DAVECC_TRY {
      for (; first != last; ++first) {
        __append_temp_buffer(data, size, cap, *first);
      }
    } __DAVECC_CATCH_ALL {
      if (*data != nullptr) {
        __destroy_range(*data, *data + *size);
        __deallocate(*data, *cap);
      }
      *data = nullptr;
      *size = 0;
      *cap = 0;
      __DAVECC_RETHROW;
    }
  }

  __DAVECC_VECTOR_CONSTEXPR void __assign_fill(size_type count, const T& value) {
    if (count == 0) {
      __destroy_all();
      return;
    }
    pointer saved = __allocate(1);
    bool saved_constructed = false;
    __DAVECC_TRY {
      __construct_copy_one(saved, value);
      saved_constructed = true;
      __destroy_all();
      if (count > __cap_) {
        __deallocate_storage();
        __data_ = __allocate(count);
        __cap_ = count;
      }
      __construct_fill(__data_, count, *saved);
      __size_ = count;
      __destroy_one(saved);
      __deallocate(saved, 1);
    } __DAVECC_CATCH_ALL {
      if (saved_constructed) {
        __destroy_one(saved);
      }
      __deallocate(saved, 1);
      __DAVECC_RETHROW;
    }
  }

  template <class It>
  __DAVECC_VECTOR_CONSTEXPR void __assign_range(It first, It last) {
    pointer fresh = nullptr;
    size_type count = 0;
    size_type cap = 0;
    __range_to_temp_buffer(first, last, &fresh, &count, &cap);
    __destroy_all();
    __deallocate_storage();
    __data_ = fresh;
    __size_ = count;
    __cap_ = cap;
  }

  __DAVECC_VECTOR_CONSTEXPR iterator __insert_copies(iterator pos, const_pointer first,
                           const_pointer last, size_type count) {
    size_type index = __index_of(pos);
    if (count == 0) {
      return __data_ + index;
    }
    size_type new_size = __size_ + count;
    size_type new_cap = __recommend(__cap_, new_size);
    pointer fresh = __allocate(new_cap);
    pointer out = fresh;
    __DAVECC_TRY {
      for (size_type i = 0; i < index; i++, out++) {
        __construct_copy_one(out, __data_[i]);
      }
      for (; first != last; ++first, out++) {
        __construct_copy_one(out, *first);
      }
      for (size_type i = index; i < __size_; i++, out++) {
        __construct_copy_one(out, __data_[i]);
      }
    } __DAVECC_CATCH_ALL {
      __destroy_range(fresh, out);
      __deallocate(fresh, new_cap);
      __DAVECC_RETHROW;
    }
    __destroy_all();
    __deallocate_storage();
    __data_ = fresh;
    __size_ = new_size;
    __cap_ = new_cap;
    return __data_ + index;
  }

  template <class It>
  __DAVECC_VECTOR_CONSTEXPR iterator __insert_range(iterator pos, It first, It last) {
    size_type index = __index_of(pos);
    pointer copies = nullptr;
    size_type count = 0;
    size_type cap = 0;
    __range_to_temp_buffer(first, last, &copies, &count, &cap);
    if (count == 0) {
      return __data_ + index;
    }
    __DAVECC_TRY {
      iterator result =
          __insert_copies(__data_ + index, copies, copies + count, count);
      __destroy_range(copies, copies + count);
      __deallocate(copies, cap);
      return result;
    } __DAVECC_CATCH_ALL {
      __destroy_range(copies, copies + count);
      __deallocate(copies, cap);
      __DAVECC_RETHROW;
    }
  }

  __DAVECC_VECTOR_CONSTEXPR iterator __insert_fill(iterator pos, size_type count, const T& value) {
    size_type index = __index_of(pos);
    if (count == 0) {
      return __data_ + index;
    }
    size_type new_size = __size_ + count;
    size_type new_cap = __recommend(__cap_, new_size);
    pointer fresh = __allocate(new_cap);
    pointer out = fresh;
    __DAVECC_TRY {
      for (size_type i = 0; i < index; i++, out++) {
        __construct_copy_one(out, __data_[i]);
      }
      for (size_type i = 0; i < count; i++, out++) {
        __construct_copy_one(out, value);
      }
      for (size_type i = index; i < __size_; i++, out++) {
        __construct_copy_one(out, __data_[i]);
      }
    } __DAVECC_CATCH_ALL {
      __destroy_range(fresh, out);
      __deallocate(fresh, new_cap);
      __DAVECC_RETHROW;
    }
    __destroy_all();
    __deallocate_storage();
    __data_ = fresh;
    __size_ = new_size;
    __cap_ = new_cap;
    return __data_ + index;
  }

  __DAVECC_VECTOR_CONSTEXPR iterator __insert_move(iterator pos, T&& value) {
    size_type index = __index_of(pos);
    size_type new_size = __size_ + 1;
    size_type new_cap = __recommend(__cap_, new_size);
    pointer fresh = __allocate(new_cap);
    pointer out = fresh;
    __DAVECC_TRY {
      for (size_type i = 0; i < index; i++, out++) {
        __construct_copy_one(out, __data_[i]);
      }
      __construct_move_one(out, std::move(value));
      out++;
      for (size_type i = index; i < __size_; i++, out++) {
        __construct_copy_one(out, __data_[i]);
      }
    } __DAVECC_CATCH_ALL {
      __destroy_range(fresh, out);
      __deallocate(fresh, new_cap);
      __DAVECC_RETHROW;
    }
    __destroy_all();
    __deallocate_storage();
    __data_ = fresh;
    __size_ = new_size;
    __cap_ = new_cap;
    return __data_ + index;
  }

  template <class... Args>
  __DAVECC_VECTOR_CONSTEXPR iterator __insert_emplace(iterator pos, Args&&... args) {
    size_type index = __index_of(pos);
    size_type new_size = __size_ + 1;
    size_type new_cap = __recommend(__cap_, new_size);
    pointer fresh = __allocate(new_cap);
    pointer out = fresh;
    __DAVECC_TRY {
      for (size_type i = 0; i < index; i++, out++) {
        __construct_copy_one(out, __data_[i]);
      }
      __construct_one(out, std::forward<Args>(args)...);
      out++;
      for (size_type i = index; i < __size_; i++, out++) {
        __construct_copy_one(out, __data_[i]);
      }
    } __DAVECC_CATCH_ALL {
      __destroy_range(fresh, out);
      __deallocate(fresh, new_cap);
      __DAVECC_RETHROW;
    }
    __destroy_all();
    __deallocate_storage();
    __data_ = fresh;
    __size_ = new_size;
    __cap_ = new_cap;
    return __data_ + index;
  }

 public:
  __DAVECC_VECTOR_CONSTEXPR vector() noexcept : __alloc_(Allocator()) { __reset_empty(); }

  __DAVECC_VECTOR_CONSTEXPR explicit vector(const Allocator& alloc) noexcept : __alloc_(alloc) {
    __reset_empty();
  }

  __DAVECC_VECTOR_CONSTEXPR explicit vector(size_type count, const Allocator& alloc = Allocator())
      : __alloc_(alloc) {
    __reset_empty();
    if (count != 0) {
      __data_ = __allocate(count);
      __cap_ = count;
      __construct_default(__data_, count);
      __size_ = count;
    }
  }

  __DAVECC_VECTOR_CONSTEXPR vector(size_type count, const T& value,
         const Allocator& alloc = Allocator()) : __alloc_(alloc) {
    __reset_empty();
    if (count != 0) {
      __data_ = __allocate(count);
      __cap_ = count;
      __construct_fill(__data_, count, value);
      __size_ = count;
    }
  }

  template <class It>
  __DAVECC_VECTOR_CONSTEXPR vector(It first, It last,
         typename enable_if<!is_integral<It>::value, int>::type = 0)
      : __data_(nullptr), __size_(0), __cap_(0) {
    __append_range(first, last);
