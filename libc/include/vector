//
//  vector
//  c_compiler
//
//  C++20 std::vector support for DaveCC.
//
//  Storage is a single contiguous allocation obtained from the allocator.  The
//  range [__data_, __data_ + __size_) contains live T objects; the remainder up
//  to __cap_ is raw storage.  Element lifetime is managed with placement new and
//  explicit destruction so non-trivial element types work correctly.
//

#ifndef __davecc_vector__
#define __davecc_vector__

#include <compare>
#include <initializer_list>
#include <iterator>
#include <memory>
#include <new>
#include <stddef.h>
#include <stdexcept>
#include <type_traits>
#include <utility>

namespace std {

namespace __vector_detail {

void __throw_out_of_range();
void __throw_length_error();

}  // namespace __vector_detail

template <class T, class Allocator = allocator<T> >
class vector {
 public:
  using value_type = T;
  using allocator_type = Allocator;
  using size_type = size_t;
  using difference_type = ptrdiff_t;
  using reference = T&;
  using const_reference = const T&;
  using pointer = T*;
  using const_pointer = const T*;
  using iterator = T*;
  using const_iterator = const T*;
  using reverse_iterator = std::reverse_iterator<iterator>;
  using const_reverse_iterator = std::reverse_iterator<const_iterator>;

 private:
  using __alloc_traits = allocator_traits<allocator_type>;

  pointer __data_;
  size_type __size_;
  size_type __cap_;
  allocator_type __alloc_;

  static size_type __recommend(size_type current, size_type needed) {
    size_type next = current == 0 ? 1 : current * 2;
    if (next < needed) {
      next = needed;
    }
    return next;
  }

  pointer __allocate(size_type count) {
    return __alloc_traits::allocate(__alloc_, count);
  }

  void __deallocate(pointer ptr, size_type count) noexcept {
    __alloc_traits::deallocate(__alloc_, ptr, count);
  }

  template <class... Args>
  void __construct_one(pointer p, Args&&... args) {
    __alloc_traits::construct(__alloc_, p, std::forward<Args>(args)...);
  }

  void __construct_copy_one(pointer p, const T& value) {
    __alloc_traits::construct(__alloc_, p, value);
  }

  void __construct_move_one(pointer p, T&& value) {
    __alloc_traits::construct(__alloc_, p, static_cast<T&&>(value));
  }

  void __destroy_one(pointer p) noexcept {
    __alloc_traits::destroy(__alloc_, p);
  }

  void __destroy_range(pointer first, pointer last) noexcept {
    while (last != first) {
      --last;
      __destroy_one(last);
    }
  }

  size_type __index_of(const_iterator pos) const noexcept {
    return __data_ == nullptr ? 0 : static_cast<size_type>(pos - __data_);
  }

  void __destroy_all() noexcept {
    if (__size_ != 0) {
      __destroy_range(__data_, __data_ + __size_);
    }
    __size_ = 0;
  }

  void __deallocate_storage() noexcept {
    if (__data_ != nullptr) {
      __deallocate(__data_, __cap_);
    }
    __data_ = nullptr;
    __cap_ = 0;
  }

  void __reset_empty() noexcept {
    __data_ = nullptr;
    __size_ = 0;
    __cap_ = 0;
  }

  void __construct_fill(pointer dst, size_type count, const T& value) {
    size_type i = 0;
    try {
      for (; i < count; i++) {
        __construct_copy_one(dst + i, value);
      }
    } catch (...) {
      __destroy_range(dst, dst + i);
      throw;
    }
  }

  void __construct_default(pointer dst, size_type count) {
    size_type i = 0;
    try {
      for (; i < count; i++) {
        __alloc_traits::construct(__alloc_, dst + i);
      }
    } catch (...) {
      __destroy_range(dst, dst + i);
      throw;
    }
  }

  template <class It>
  void __construct_range(pointer dst, It first, It last) {
    size_type i = 0;
    try {
      for (; first != last; ++first, ++i) {
        __construct_copy_one(dst + i, *first);
      }
    } catch (...) {
      __destroy_range(dst, dst + i);
      throw;
    }
  }

  void __construct_move(pointer dst, pointer first, pointer last) {
    size_type i = 0;
    try {
      for (; first != last; ++first, ++i) {
        __construct_move_one(dst + i, std::move(*first));
      }
    } catch (...) {
      __destroy_range(dst, dst + i);
      throw;
    }
  }

  void __construct_copy(pointer dst, const_pointer first, const_pointer last) {
    size_type i = 0;
    try {
      for (; first != last; ++first, ++i) {
        __construct_copy_one(dst + i, *first);
      }
    } catch (...) {
      __destroy_range(dst, dst + i);
      throw;
    }
  }

  void __reserve_exact(size_type new_cap) {
    if (new_cap <= __cap_) {
      return;
    }
    pointer fresh = __allocate(new_cap);
    try {
      if (__size_ != 0) {
        __construct_move(fresh, __data_, __data_ + __size_);
      }
    } catch (...) {
      __deallocate(fresh, new_cap);
      throw;
    }
    if (__size_ != 0) {
      __destroy_range(__data_, __data_ + __size_);
    }
    __deallocate_storage();
    __data_ = fresh;
    __cap_ = new_cap;
  }

  void __grow_for(size_type needed) {
    if (needed > __cap_) {
      __reserve_exact(__recommend(__cap_, needed));
    }
  }

  void __take_storage_from(vector& other) noexcept {
    __data_ = other.__data_;
    __size_ = other.__size_;
    __cap_ = other.__cap_;
    other.__reset_empty();
  }

  void __assign_move_from(vector& other) {
    size_type count = other.__size_;
    pointer fresh = nullptr;
    if (count != 0) {
      fresh = __allocate(count);
      try {
        __construct_move(fresh, other.__data_, other.__data_ + count);
      } catch (...) {
        __deallocate(fresh, count);
        throw;
      }
    }
    __destroy_all();
    __deallocate_storage();
    __data_ = fresh;
    __size_ = count;
    __cap_ = count;
    other.__destroy_all();
  }

  void __swap_storage(vector& other) noexcept {
    pointer data = __data_;
    size_type size = __size_;
    size_type cap = __cap_;
    __data_ = other.__data_;
    __size_ = other.__size_;
    __cap_ = other.__cap_;
    other.__data_ = data;
    other.__size_ = size;
    other.__cap_ = cap;
  }

  template <class It>
  void __append_range(It first, It last) {
    for (; first != last; ++first) {
      __grow_for(__size_ + 1);
      __construct_copy_one(__data_ + __size_, *first);
      __size_++;
    }
  }

  void __grow_temp_buffer(pointer* data, size_type size, size_type* cap) {
    size_type new_cap = __recommend(*cap, size + 1);
    pointer fresh = __allocate(new_cap);
    try {
      if (size != 0) {
        __construct_move(fresh, *data, *data + size);
      }
    } catch (...) {
      __deallocate(fresh, new_cap);
      throw;
    }
    if (*data != nullptr) {
      __destroy_range(*data, *data + size);
      __deallocate(*data, *cap);
    }
    *data = fresh;
    *cap = new_cap;
  }

  void __append_temp_buffer(pointer* data, size_type* size, size_type* cap,
                            const T& value) {
    if (*size == *cap) {
      __grow_temp_buffer(data, *size, cap);
    }
    __construct_copy_one(*data + *size, value);
    *size = *size + 1;
  }

  template <class It>
  void __range_to_temp_buffer(It first, It last, pointer* data,
                              size_type* size, size_type* cap) {
    *data = nullptr;
    *size = 0;
    *cap = 0;
    try {
      for (; first != last; ++first) {
        __append_temp_buffer(data, size, cap, *first);
      }
    } catch (...) {
      if (*data != nullptr) {
        __destroy_range(*data, *data + *size);
        __deallocate(*data, *cap);
      }
      *data = nullptr;
      *size = 0;
      *cap = 0;
      throw;
    }
  }

  void __assign_fill(size_type count, const T& value) {
    if (count == 0) {
      __destroy_all();
      return;
    }
    pointer saved = __allocate(1);
    bool saved_constructed = false;
    try {
      __construct_copy_one(saved, value);
      saved_constructed = true;
      __destroy_all();
      if (count > __cap_) {
        __deallocate_storage();
        __data_ = __allocate(count);
        __cap_ = count;
      }
      __construct_fill(__data_, count, *saved);
      __size_ = count;
      __destroy_one(saved);
      __deallocate(saved, 1);
    } catch (...) {
      if (saved_constructed) {
        __destroy_one(saved);
      }
      __deallocate(saved, 1);
      throw;
    }
  }

  template <class It>
  void __assign_range(It first, It last) {
    pointer fresh = nullptr;
    size_type count = 0;
    size_type cap = 0;
    __range_to_temp_buffer(first, last, &fresh, &count, &cap);
    __destroy_all();
    __deallocate_storage();
    __data_ = fresh;
    __size_ = count;
    __cap_ = cap;
  }

  iterator __insert_copies(iterator pos, const_pointer first,
                           const_pointer last, size_type count) {
    size_type index = __index_of(pos);
    if (count == 0) {
      return __data_ + index;
    }
    size_type new_size = __size_ + count;
    size_type new_cap = __recommend(__cap_, new_size);
    pointer fresh = __allocate(new_cap);
    pointer out = fresh;
    try {
      for (size_type i = 0; i < index; i++, out++) {
        __construct_copy_one(out, __data_[i]);
      }
      for (; first != last; ++first, out++) {
        __construct_copy_one(out, *first);
      }
      for (size_type i = index; i < __size_; i++, out++) {
        __construct_copy_one(out, __data_[i]);
      }
    } catch (...) {
      __destroy_range(fresh, out);
      __deallocate(fresh, new_cap);
      throw;
    }
    __destroy_all();
    __deallocate_storage();
    __data_ = fresh;
    __size_ = new_size;
    __cap_ = new_cap;
    return __data_ + index;
  }

  template <class It>
  iterator __insert_range(iterator pos, It first, It last) {
    size_type index = __index_of(pos);
    pointer copies = nullptr;
    size_type count = 0;
    size_type cap = 0;
    __range_to_temp_buffer(first, last, &copies, &count, &cap);
    if (count == 0) {
      return __data_ + index;
    }
    try {
      iterator result =
          __insert_copies(__data_ + index, copies, copies + count, count);
      __destroy_range(copies, copies + count);
      __deallocate(copies, cap);
      return result;
    } catch (...) {
      __destroy_range(copies, copies + count);
      __deallocate(copies, cap);
      throw;
    }
  }

  iterator __insert_fill(iterator pos, size_type count, const T& value) {
    size_type index = __index_of(pos);
    if (count == 0) {
      return __data_ + index;
    }
    size_type new_size = __size_ + count;
    size_type new_cap = __recommend(__cap_, new_size);
    pointer fresh = __allocate(new_cap);
    pointer out = fresh;
    try {
      for (size_type i = 0; i < index; i++, out++) {
        __construct_copy_one(out, __data_[i]);
      }
      for (size_type i = 0; i < count; i++, out++) {
        __construct_copy_one(out, value);
      }
      for (size_type i = index; i < __size_; i++, out++) {
        __construct_copy_one(out, __data_[i]);
      }
    } catch (...) {
      __destroy_range(fresh, out);
      __deallocate(fresh, new_cap);
      throw;
    }
    __destroy_all();
    __deallocate_storage();
    __data_ = fresh;
    __size_ = new_size;
    __cap_ = new_cap;
    return __data_ + index;
  }

  iterator __insert_move(iterator pos, T&& value) {
    size_type index = __index_of(pos);
    size_type new_size = __size_ + 1;
    size_type new_cap = __recommend(__cap_, new_size);
    pointer fresh = __allocate(new_cap);
    pointer out = fresh;
    try {
      for (size_type i = 0; i < index; i++, out++) {
        __construct_copy_one(out, __data_[i]);
      }
      __construct_move_one(out, std::move(value));
      out++;
      for (size_type i = index; i < __size_; i++, out++) {
        __construct_copy_one(out, __data_[i]);
      }
    } catch (...) {
      __destroy_range(fresh, out);
      __deallocate(fresh, new_cap);
      throw;
    }
    __destroy_all();
    __deallocate_storage();
    __data_ = fresh;
    __size_ = new_size;
    __cap_ = new_cap;
    return __data_ + index;
  }

  template <class... Args>
  iterator __insert_emplace(iterator pos, Args&&... args) {
    size_type index = __index_of(pos);
    size_type new_size = __size_ + 1;
    size_type new_cap = __recommend(__cap_, new_size);
    pointer fresh = __allocate(new_cap);
    pointer out = fresh;
    try {
      for (size_type i = 0; i < index; i++, out++) {
        __construct_copy_one(out, __data_[i]);
      }
      __construct_one(out, std::forward<Args>(args)...);
      out++;
      for (size_type i = index; i < __size_; i++, out++) {
        __construct_copy_one(out, __data_[i]);
      }
    } catch (...) {
      __destroy_range(fresh, out);
      __deallocate(fresh, new_cap);
      throw;
    }
    __destroy_all();
    __deallocate_storage();
    __data_ = fresh;
    __size_ = new_size;
    __cap_ = new_cap;
    return __data_ + index;
  }

 public:
  vector() noexcept { __reset_empty(); }

  explicit vector(const Allocator& alloc) noexcept : __alloc_(alloc) {
    __reset_empty();
  }

  explicit vector(size_type count, const Allocator& alloc = Allocator())
      : __alloc_(alloc) {
    __reset_empty();
    if (count != 0) {
      __data_ = __allocate(count);
      __cap_ = count;
      __construct_default(__data_, count);
      __size_ = count;
    }
  }

  vector(size_type count, const T& value,
         const Allocator& alloc = Allocator()) : __alloc_(alloc) {
    __reset_empty();
    if (count != 0) {
      __data_ = __allocate(count);
      __cap_ = count;
      __construct_fill(__data_, count, value);
      __size_ = count;
    }
  }

  template <class It>
  vector(It first, It last,
         typename enable_if<!is_integral<It>::value, int>::type = 0)
      : __data_(nullptr), __size_(0), __cap_(0) {
    __append_range(first, last);
  }

  template <class It>
  vector(It first, It last, const Allocator& alloc,
         typename enable_if<!is_integral<It>::value, int>::type = 0)
      : __alloc_(alloc) {
    __reset_empty();
    __append_range(first, last);
  }

  vector(initializer_list<T> init, const Allocator& alloc = Allocator())
      : __alloc_(alloc) {
    __reset_empty();
    if (init.size() != 0) {
      __data_ = __allocate(init.size());
      __cap_ = init.size();
      __construct_range(__data_, init.begin(), init.end());
      __size_ = init.size();
    }
  }

  vector(const vector& other)
      : __alloc_(__alloc_traits::select_on_container_copy_construction(
            other.__alloc_)) {
    __reset_empty();
    if (other.__size_ != 0) {
      __data_ = __allocate(other.__size_);
      __cap_ = other.__size_;
      __construct_copy(__data_, other.__data_, other.__data_ + other.__size_);
      __size_ = other.__size_;
    }
  }

  vector(const vector& other, const Allocator& alloc) : __alloc_(alloc) {
    __reset_empty();
    if (other.__size_ != 0) {
      __data_ = __allocate(other.__size_);
      __cap_ = other.__size_;
      __construct_copy(__data_, other.__data_, other.__data_ + other.__size_);
      __size_ = other.__size_;
    }
  }

  vector(vector&& other) noexcept : __alloc_(other.__alloc_) {
    __take_storage_from(other);
  }

  vector(vector&& other, const Allocator& alloc) : __alloc_(alloc) {
    __reset_empty();
    if (__alloc_ == other.__alloc_) {
      __take_storage_from(other);
    } else {
      __reserve_exact(other.__size_);
      __construct_move(__data_, other.__data_, other.__data_ + other.__size_);
      __size_ = other.__size_;
      other.__destroy_all();
    }
  }

  ~vector() {
    __destroy_all();
    __deallocate_storage();
  }

  vector& operator=(const vector& other) {
    if (this != &other) {
      if (__alloc_traits::__propagate_on_container_copy_assignment()) {
        if (__alloc_ != other.__alloc_) {
          __destroy_all();
          __deallocate_storage();
        }
        __alloc_ = other.__alloc_;
      }
      __assign_range(other.begin(), other.end());
    }
    return *this;
  }

  vector& operator=(vector&& other) noexcept {
    if (this != &other) {
      if (__alloc_traits::__propagate_on_container_move_assignment()) {
        __destroy_all();
        __deallocate_storage();
        __alloc_ = other.__alloc_;
        __take_storage_from(other);
      } else if (__alloc_ == other.__alloc_) {
        __destroy_all();
        __deallocate_storage();
        __take_storage_from(other);
      } else {
        __assign_move_from(other);
      }
    }
    return *this;
  }

  vector& operator=(initializer_list<T> init) {
    __assign_range(init.begin(), init.end());
    return *this;
  }

  void assign(size_type count, const T& value) { __assign_fill(count, value); }

  template <class It>
  void assign(It first, It last,
              typename enable_if<!is_integral<It>::value, int>::type = 0) {
    __assign_range(first, last);
  }

  void assign(initializer_list<T> init) {
    __assign_range(init.begin(), init.end());
  }

  allocator_type get_allocator() const noexcept { return __alloc_; }

  reference at(size_type pos) {
    if (pos >= __size_) {
      __vector_detail::__throw_out_of_range();
    }
    return __data_[pos];
  }

  const_reference at(size_type pos) const {
    if (pos >= __size_) {
      __vector_detail::__throw_out_of_range();
    }
    return __data_[pos];
  }

  reference operator[](size_type pos) { return __data_[pos]; }
  const_reference operator[](size_type pos) const { return __data_[pos]; }
  reference front() { return __data_[0]; }
  const_reference front() const { return __data_[0]; }
  reference back() { return __data_[__size_ - 1]; }
  const_reference back() const { return __data_[__size_ - 1]; }
  pointer data() noexcept { return __data_; }
  const_pointer data() const noexcept { return __data_; }

  iterator begin() noexcept { return __data_; }
  const_iterator begin() const noexcept { return __data_; }
  const_iterator cbegin() const noexcept { return __data_; }
  iterator end() noexcept { return __data_ + __size_; }
  const_iterator end() const noexcept { return __data_ + __size_; }
  const_iterator cend() const noexcept { return __data_ + __size_; }
  reverse_iterator rbegin() noexcept {
    return reverse_iterator(__data_ + __size_);
  }
  const_reverse_iterator rbegin() const noexcept {
    return const_reverse_iterator(__data_ + __size_);
  }
  const_reverse_iterator crbegin() const noexcept {
    return const_reverse_iterator(__data_ + __size_);
  }
  reverse_iterator rend() noexcept {
    return reverse_iterator(__data_);
  }
  const_reverse_iterator rend() const noexcept {
    return const_reverse_iterator(__data_);
  }
  const_reverse_iterator crend() const noexcept {
    return const_reverse_iterator(__data_);
  }

  bool empty() const noexcept { return __size_ == 0; }
  size_type size() const noexcept { return __size_; }
  size_type max_size() const noexcept {
    return __alloc_traits::max_size(__alloc_);
  }
  size_type capacity() const noexcept { return __cap_; }

  void reserve(size_type new_cap) {
    if (new_cap > max_size()) {
      __vector_detail::__throw_length_error();
    }
    __reserve_exact(new_cap);
  }

  void shrink_to_fit() {
    if (__size_ == __cap_) {
      return;
    }
    if (__size_ == 0) {
      __destroy_all();
      __deallocate_storage();
      return;
    }
    size_type old_size = __size_;
    pointer fresh = __allocate(old_size);
    try {
      __construct_move(fresh, __data_, __data_ + old_size);
    } catch (...) {
      __deallocate(fresh, old_size);
      throw;
    }
    __destroy_all();
    __deallocate_storage();
    __data_ = fresh;
    __size_ = old_size;
    __cap_ = old_size;
  }

  void clear() noexcept {
    __destroy_all();
  }

  void resize(size_type count) {
    if (count < __size_) {
      __destroy_range(__data_ + count, __data_ + __size_);
      __size_ = count;
    } else if (count > __size_) {
      __grow_for(count);
      __construct_default(__data_ + __size_, count - __size_);
      __size_ = count;
    }
  }

  void resize(size_type count, const T& value) {
    if (count < __size_) {
      __destroy_range(__data_ + count, __data_ + __size_);
      __size_ = count;
    } else if (count > __size_) {
      __grow_for(count);
      __construct_fill(__data_ + __size_, count - __size_, value);
      __size_ = count;
    }
  }

  iterator insert(const_iterator pos, const T& value) {
    return __insert_fill(const_cast<iterator>(pos), 1, value);
  }

  iterator insert(const_iterator pos, T&& value) {
    return __insert_move(const_cast<iterator>(pos), std::move(value));
  }

  iterator insert(const_iterator pos, size_type count, const T& value) {
    size_type index = __index_of(pos);
    if (count == 0) {
      return __data_ + index;
    }
    return __insert_fill(__data_ + index, count, value);
  }

  template <class It>
  iterator insert(const_iterator pos, It first, It last,
                  typename enable_if<!is_integral<It>::value, int>::type = 0) {
    return __insert_range(const_cast<iterator>(pos), first, last);
  }

  iterator insert(const_iterator pos, initializer_list<T> init) {
    size_type index = __index_of(pos);
    return __insert_copies(__data_ + index, init.begin(), init.end(),
                           init.size());
  }

  template <class... Args>
  iterator emplace(const_iterator pos, Args&&... args) {
    return __insert_emplace(const_cast<iterator>(pos),
                            std::forward<Args>(args)...);
  }

  iterator erase(const_iterator pos) {
    size_type index = __index_of(pos);
    for (size_type i = index; i + 1 < __size_; i++) {
      __data_[i] = std::move(__data_[i + 1]);
    }
    __size_--;
    __destroy_one(__data_ + __size_);
    return __data_ + index;
  }

  iterator erase(const_iterator first, const_iterator last) {
    size_type index = __index_of(first);
    size_type count = static_cast<size_type>(last - first);
    if (count == 0) {
      return __data_ + index;
    }
    for (size_type i = index; i + count < __size_; i++) {
      __data_[i] = std::move(__data_[i + count]);
    }
    __destroy_range(__data_ + (__size_ - count), __data_ + __size_);
    __size_ -= count;
    return __data_ + index;
  }

  void push_back(const T& value) {
    __grow_for(__size_ + 1);
    __construct_copy_one(__data_ + __size_, value);
    __size_++;
  }

  void push_back(T&& value) {
    __grow_for(__size_ + 1);
    __construct_move_one(__data_ + __size_, std::move(value));
    __size_++;
  }

  template <class... Args>
  reference emplace_back(Args&&... args) {
    __grow_for(__size_ + 1);
    __construct_one(__data_ + __size_, std::forward<Args>(args)...);
    __size_++;
    return back();
  }

  void pop_back() {
    __size_--;
    __destroy_one(__data_ + __size_);
  }

  void swap(vector& other) noexcept {
    if (__alloc_traits::__propagate_on_container_swap()) {
      __swap_storage(other);
      allocator_type alloc = __alloc_;
      __alloc_ = other.__alloc_;
      other.__alloc_ = alloc;
    } else if (__alloc_ == other.__alloc_) {
      __swap_storage(other);
    } else {
      vector temp(std::move(*this), __alloc_);
      __assign_move_from(other);
      other.__assign_move_from(temp);
    }
  }
};

template <class T, class Allocator>
bool operator==(const vector<T, Allocator>& a,
                const vector<T, Allocator>& b) {
  if (a.size() != b.size()) {
    return false;
  }
  for (size_t i = 0; i < a.size(); i++) {
    if (!(a[i] == b[i])) {
      return false;
    }
  }
  return true;
}

template <class T, class Allocator>
bool operator!=(const vector<T, Allocator>& a,
                const vector<T, Allocator>& b) {
  return !(a == b);
}

template <class T, class Allocator>
bool operator<(const vector<T, Allocator>& a,
               const vector<T, Allocator>& b) {
  size_t n = a.size() < b.size() ? a.size() : b.size();
  for (size_t i = 0; i < n; i++) {
    if (a[i] < b[i]) {
      return true;
    }
    if (b[i] < a[i]) {
      return false;
    }
  }
  return a.size() < b.size();
}

template <class T, class Allocator>
bool operator>(const vector<T, Allocator>& a,
               const vector<T, Allocator>& b) {
  return b < a;
}

template <class T, class Allocator>
bool operator<=(const vector<T, Allocator>& a,
                const vector<T, Allocator>& b) {
  return !(b < a);
}

template <class T, class Allocator>
bool operator>=(const vector<T, Allocator>& a,
                const vector<T, Allocator>& b) {
  return !(a < b);
}

template <class T, class Allocator>
strong_ordering operator<=>(const vector<T, Allocator>& a,
                            const vector<T, Allocator>& b) {
  size_t n = a.size() < b.size() ? a.size() : b.size();
  for (size_t i = 0; i < n; i++) {
    if (a[i] < b[i]) {
      return strong_ordering::less;
    }
    if (b[i] < a[i]) {
      return strong_ordering::greater;
    }
  }
  if (a.size() < b.size()) {
    return strong_ordering::less;
  }
  if (a.size() > b.size()) {
    return strong_ordering::greater;
  }
  return strong_ordering::equal;
}

template <class T, class Allocator>
void swap(vector<T, Allocator>& a, vector<T, Allocator>& b) noexcept {
  a.swap(b);
}

