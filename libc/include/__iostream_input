#ifndef __davecc_iostream_input_h__
#define __davecc_iostream_input_h__

#include <streambuf>
#include <cstdio>

namespace std {

class __stdio_istreambuf : public basic_streambuf<char, char_traits<char>> {
 public:
  explicit __stdio_istreambuf(FILE* file);

 protected:
  int_type underflow() override;
  int_type uflow() override;
  int_type pbackfail(int_type c = traits_type::eof()) override;
  streamsize xsgetn(char* s, streamsize n) override;

 private:
  FILE* __file_;
};

}  // namespace std

#endif
