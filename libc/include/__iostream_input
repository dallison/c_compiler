#ifndef __davecc_iostream_input_h__
#define __davecc_iostream_input_h__

#include <streambuf>
extern "C" {
#include <unistd.h>
}

namespace std {

class __fd_istreambuf : public basic_streambuf<char, char_traits<char>> {
 public:
  explicit __fd_istreambuf(int fd);

 protected:
  int_type underflow() override;
  int_type pbackfail(int_type c = traits_type::eof()) override;

 private:
  static const int __buffer_size_ = 64;
  int __fd_;
  char __buffer_[__buffer_size_ + 1];
};

}  // namespace std

#endif
