namespace std {

struct nullopt_t {
  explicit constexpr nullopt_t(int) {}
};

inline constexpr nullopt_t nullopt(0);

class bad_optional_access : public exception {
 public:
  constexpr bad_optional_access() noexcept {}

  constexpr const char* what() const noexcept override {
    return "bad optional access";
  }
};

template <class T>
class optional {
  static_assert(is_object<T>::value, "optional<T> requires an object type");
  static_assert(!is_same<remove_cv_t<T>, nullopt_t>::value,
                "optional<T> cannot contain nullopt_t");
  static_assert(!is_same<remove_cv_t<T>, in_place_t>::value,
                "optional<T> cannot contain in_place_t");

  union __storage_type {
    char __dummy_;
    T __value_;
  };

  __storage_type __storage_;
  bool __engaged_;

  constexpr T* __ptr() noexcept {
    return &__storage_.__value_;
  }

  constexpr const T* __ptr() const noexcept {
    return &__storage_.__value_;
  }

  constexpr void __construct_copy(const T& value) {
    new (__ptr()) T(value);
    __engaged_ = true;
  }

  constexpr void __construct_move(T&& value) {
    new (__ptr()) T(std::move(value));
    __engaged_ = true;
  }

 public:
  using value_type = T;

  constexpr optional() noexcept : __engaged_(false) {}

  constexpr optional(nullopt_t) noexcept : __engaged_(false) {}

  constexpr optional(const T& value) : __engaged_(false) {
    __construct_copy(value);
  }

  constexpr optional(T&& value) : __engaged_(false) {
    __construct_move(std::move(value));
  }

  template <
      class U,
      typename enable_if<!is_same<remove_cvref_t<U>, optional>::value &&
                             is_constructible<T, U>::value,
                         int>::type = 0>
  constexpr optional(U&& value) : __engaged_(false) {
    new (__ptr()) T(std::forward<U>(value));
    __engaged_ = true;
  }

  template <class... Args>
  explicit optional(in_place_t, Args&&... args) : __engaged_(false) {
    new (__ptr()) T(std::forward<Args>(args)...);
    __engaged_ = true;
  }

  template <class U, class... Args>
  explicit optional(in_place_t, initializer_list<U> init, Args&&... args)
      : __engaged_(false) {
    emplace(init, std::forward<Args>(args)...);
  }

  optional(const optional& other) : __engaged_(false) {
    if (other.__engaged_) {
      __construct_copy(*other);
    }
  }

  optional(optional&& other) : __engaged_(false) {
    if (other.__engaged_) {
      __construct_move(std::move(*other));
    }
  }

  constexpr ~optional() { reset(); }

  optional& operator=(nullopt_t) noexcept {
    reset();
    return *this;
  }

  optional& operator=(const optional& other) {
    if (this == &other) {
      return *this;
    }
    if (__engaged_ && other.__engaged_) {
      **this = *other;
    } else if (__engaged_) {
      reset();
    } else if (other.__engaged_) {
      __construct_copy(*other);
    }
    return *this;
  }

  optional& operator=(optional&& other) {
    if (this == &other) {
      return *this;
    }
    if (__engaged_ && other.__engaged_) {
      **this = std::move(*other);
    } else if (__engaged_) {
      reset();
    } else if (other.__engaged_) {
      __construct_move(std::move(*other));
    }
    return *this;
  }

  optional& operator=(const T& value) {
    if (__engaged_) {
      **this = value;
    } else {
      __construct_copy(value);
    }
    return *this;
  }

  optional& operator=(T&& value) {
    if (__engaged_) {
      **this = std::move(value);
    } else {
      __construct_move(std::move(value));
    }
    return *this;
  }

  const T* operator->() const noexcept {
    return __ptr();
  }

  T* operator->() noexcept {
    return __ptr();
  }

  const T& operator*() const& noexcept {
    return *__ptr();
  }

  T& operator*() & noexcept {
    return *__ptr();
  }

  const T&& operator*() const&& noexcept {
    return std::move(*__ptr());
  }

  T&& operator*() && noexcept {
    return std::move(*__ptr());
  }

  constexpr explicit operator bool() const noexcept {
    return __engaged_;
  }

  constexpr bool has_value() const noexcept {
    return __engaged_;
  }

  constexpr T& value() & {
    if (!__engaged_) {
      __DAVECC_THROW(bad_optional_access());
    }
    return *__ptr();
  }

  constexpr const T& value() const& {
    if (!__engaged_) {
      __DAVECC_THROW(bad_optional_access());
    }
    return *__ptr();
  }

  constexpr T&& value() && {
    if (!__engaged_) {
      __DAVECC_THROW(bad_optional_access());
    }
    return std::move(*__ptr());
  }

  constexpr const T&& value() const&& {
    if (!__engaged_) {
      __DAVECC_THROW(bad_optional_access());
    }
    return std::move(*__ptr());
  }

  template <class U>
  T value_or(U&& default_value) const& {
    return __engaged_ ? **this : static_cast<T>(std::forward<U>(default_value));
  }

  template <class U>
  T value_or(U&& default_value) && {
    return __engaged_ ? std::move(**this)
                      : static_cast<T>(std::forward<U>(default_value));
  }

  constexpr void reset() noexcept {
    if (__engaged_) {
      __ptr()->~T();
      __engaged_ = false;
    }
  }

  template <class... Args>
  T& emplace(Args&&... args) {
    reset();
    new (__ptr()) T(std::forward<Args>(args)...);
    __engaged_ = true;
    return **this;
  }

  template <class U, class... Args>
  T& emplace(initializer_list<U> init, Args&&... args) {
    reset();
    new (__ptr()) T(init, std::forward<Args>(args)...);
    __engaged_ = true;
    return **this;
  }

  void swap(optional& other) {
    if (__engaged_ && other.__engaged_) {
      std::swap(**this, *other);
    } else if (__engaged_) {
      other.__construct_move(std::move(**this));
      reset();
    } else if (other.__engaged_) {
      __construct_move(std::move(*other));
      other.reset();
    }
  }

#if __cplusplus >= 202302L
  template <class F>
  constexpr remove_cvref_t<invoke_result_t<F, T&>> and_then(F&& function) & {
    using Result = remove_cvref_t<invoke_result_t<F, T&>>;
    if (__engaged_) {
      return std::invoke(std::forward<F>(function), **this);
    }
    return Result();
  }

  template <class F>
  constexpr remove_cvref_t<invoke_result_t<F, const T&>> and_then(
      F&& function) const& {
    using Result = remove_cvref_t<invoke_result_t<F, const T&>>;
    if (__engaged_) {
      return std::invoke(std::forward<F>(function), **this);
    }
    return Result();
  }

  template <class F>
  constexpr remove_cvref_t<invoke_result_t<F, T&&>> and_then(F&& function) && {
    using Result = remove_cvref_t<invoke_result_t<F, T&&>>;
    if (__engaged_) {
      return std::invoke(std::forward<F>(function), static_cast<T&&>(**this));
    }
    return Result();
  }

  template <class F>
  constexpr remove_cvref_t<invoke_result_t<F, const T&&>> and_then(
      F&& function) const&& {
    using Result = remove_cvref_t<invoke_result_t<F, const T&&>>;
    if (__engaged_) {
      return std::invoke(std::forward<F>(function),
                         static_cast<const T&&>(**this));
    }
    return Result();
  }

  template <class F>
  constexpr optional<remove_cv_t<invoke_result_t<F, T&>>> transform(
      F&& function) & {
    using U = remove_cv_t<invoke_result_t<F, T&>>;
    if (__engaged_) {
      return optional<U>(std::invoke(std::forward<F>(function), **this));
    }
    return optional<U>();
  }

  template <class F>
  constexpr optional<remove_cv_t<invoke_result_t<F, const T&>>> transform(
      F&& function) const& {
    using U = remove_cv_t<invoke_result_t<F, const T&>>;
    if (__engaged_) {
      return optional<U>(std::invoke(std::forward<F>(function), **this));
    }
    return optional<U>();
  }

  template <class F>
  constexpr optional<remove_cv_t<invoke_result_t<F, T&&>>> transform(
      F&& function) && {
    using U = remove_cv_t<invoke_result_t<F, T&&>>;
    if (__engaged_) {
      return optional<U>(
          std::invoke(std::forward<F>(function), static_cast<T&&>(**this)));
    }
    return optional<U>();
  }

  template <class F>
  constexpr optional<remove_cv_t<invoke_result_t<F, const T&&>>> transform(
      F&& function) const&& {
    using U = remove_cv_t<invoke_result_t<F, const T&&>>;
    if (__engaged_) {
      return optional<U>(std::invoke(std::forward<F>(function),
                                     static_cast<const T&&>(**this)));
    }
    return optional<U>();
  }

  template <class F>
  constexpr remove_cvref_t<invoke_result_t<F>> or_else(F&& function) const& {
    using Result = remove_cvref_t<invoke_result_t<F>>;
    if (__engaged_) {
      return *this;
    }
    return std::invoke(std::forward<F>(function));
  }

  template <class F>
  constexpr remove_cvref_t<invoke_result_t<F>> or_else(F&& function) && {
    using Result = remove_cvref_t<invoke_result_t<F>>;
    if (__engaged_) {
      return static_cast<optional&&>(*this);
    }
    return std::invoke(std::forward<F>(function));
  }
#endif
};

#if __cplusplus >= 202600L

template <class T>
class optional<T&> {
  T* __ptr_ = nullptr;

 public:
  using value_type = T;

  constexpr optional() noexcept = default;
  constexpr optional(nullopt_t) noexcept {}
  constexpr optional(T& value) noexcept : __ptr_(&value) {}
  constexpr explicit optional(in_place_t, T& value) noexcept
      : __ptr_(&value) {}

  template <class U,
            typename enable_if<!is_same<remove_cv_t<U>, T>::value &&
                                   is_convertible<U*, T*>::value,
                               int>::type = 0>
  constexpr optional(U& value) noexcept : __ptr_(&value) {}

  constexpr optional(const optional&) noexcept = default;
  constexpr optional(optional&&) noexcept = default;
  constexpr optional& operator=(const optional&) noexcept = default;
  constexpr optional& operator=(optional&&) noexcept = default;

  constexpr optional& operator=(nullopt_t) noexcept {
    __ptr_ = nullptr;
    return *this;
  }

  constexpr optional& operator=(T& value) noexcept {
    __ptr_ = &value;
    return *this;
  }

  constexpr T* operator->() const noexcept { return __ptr_; }
  constexpr T& operator*() const noexcept { return *__ptr_; }
  constexpr explicit operator bool() const noexcept { return __ptr_ != nullptr; }
  constexpr bool has_value() const noexcept { return __ptr_ != nullptr; }

  constexpr T& value() const {
    if (__ptr_ == nullptr) {
      __DAVECC_THROW(bad_optional_access());
    }
    return *__ptr_;
  }

  template <class U>
  constexpr remove_cv_t<T> value_or(U&& default_value) const {
    return __ptr_ == nullptr
               ? static_cast<remove_cv_t<T>>(std::forward<U>(default_value))
               : *__ptr_;
  }

  constexpr void reset() noexcept { __ptr_ = nullptr; }

  constexpr T& emplace(T& value) noexcept {
    __ptr_ = &value;
    return value;
  }

  constexpr void swap(optional& other) noexcept {
    T* value = __ptr_;
    __ptr_ = other.__ptr_;
    other.__ptr_ = value;
  }

  template <class F>
  constexpr remove_cvref_t<invoke_result_t<F, T&>> and_then(
      F&& function) const {
    using Result = remove_cvref_t<invoke_result_t<F, T&>>;
    if (__ptr_ != nullptr) {
      return std::invoke(std::forward<F>(function), *__ptr_);
    }
    return Result();
  }

  template <class F>
  constexpr optional<remove_cv_t<invoke_result_t<F, T&>>> transform(
      F&& function) const {
    using U = remove_cv_t<invoke_result_t<F, T&>>;
    if (__ptr_ != nullptr) {
      return optional<U>(std::invoke(std::forward<F>(function), *__ptr_));
    }
    return optional<U>();
  }

  template <class F>
  constexpr remove_cvref_t<invoke_result_t<F>> or_else(F&& function) const {
    using Result = remove_cvref_t<invoke_result_t<F>>;
    if (__ptr_ != nullptr) {
      return *this;
    }
    return std::invoke(std::forward<F>(function));
  }
};

#endif

template <class T>
void swap(optional<T>& left, optional<T>& right) {
  left.swap(right);
}

template <class T>
optional<remove_cvref_t<T>> make_optional(T&& value) {
  return optional<remove_cvref_t<T>>(std::forward<T>(value));
}

template <class T, class... Args>
optional<T> make_optional(Args&&... args) {
  return optional<T>(in_place, std::forward<Args>(args)...);
}

template <class T, class U, class... Args>
optional<T> make_optional(initializer_list<U> init, Args&&... args) {
  return optional<T>(in_place, init, std::forward<Args>(args)...);
}

template <class T>
bool operator==(const optional<T>& left, const optional<T>& right) {
  if (left.has_value() != right.has_value()) {
    return false;
  }
  return !left.has_value() || *left == *right;
}

template <class T>
bool operator!=(const optional<T>& left, const optional<T>& right) {
  return !(left == right);
}

template <class T>
bool operator<(const optional<T>& left, const optional<T>& right) {
  if (!right.has_value()) {
    return false;
  }
  if (!left.has_value()) {
    return true;
  }
  return *left < *right;
}

template <class T>
bool operator>(const optional<T>& left, const optional<T>& right) {
  return right < left;
}

template <class T>
bool operator<=(const optional<T>& left, const optional<T>& right) {
  return !(right < left);
}

template <class T>
bool operator>=(const optional<T>& left, const optional<T>& right) {
  return !(left < right);
}

template <class T>
strong_ordering operator<=>(const optional<T>& left, const optional<T>& right) {
  if (left.has_value() && right.has_value()) {
    return *left <=> *right;
  }
  if (left.has_value()) {
    return strong_ordering::greater;
  }
  if (right.has_value()) {
    return strong_ordering::less;
  }
  return strong_ordering::equal;
}

template <class T>
bool operator==(const optional<T>& value, nullopt_t) noexcept {
  return !value.has_value();
}

template <class T>
bool operator==(nullopt_t, const optional<T>& value) noexcept {
  return !value.has_value();
}

template <class T>
bool operator!=(const optional<T>& value, nullopt_t) noexcept {
  return value.has_value();
}

template <class T>
bool operator!=(nullopt_t, const optional<T>& value) noexcept {
  return value.has_value();
}

template <class T>
bool operator<(const optional<T>&, nullopt_t) noexcept {
  return false;
}

template <class T>
bool operator<(nullopt_t, const optional<T>& value) noexcept {
  return value.has_value();
}

template <class T>
bool operator>(const optional<T>& value, nullopt_t) noexcept {
  return value.has_value();
}

template <class T>
bool operator>(nullopt_t, const optional<T>&) noexcept {
  return false;
}

template <class T>
bool operator<=(const optional<T>& value, nullopt_t) noexcept {
  return !value.has_value();
}

template <class T>
bool operator<=(nullopt_t, const optional<T>&) noexcept {
  return true;
}

template <class T>
bool operator>=(const optional<T>&, nullopt_t) noexcept {
  return true;
}

template <class T>
bool operator>=(nullopt_t, const optional<T>& value) noexcept {
  return !value.has_value();
}

template <class T>
strong_ordering operator<=>(const optional<T>& value, nullopt_t) noexcept {
  return value.has_value() ? strong_ordering::greater : strong_ordering::equal;
}

template <class T>
strong_ordering operator<=>(nullopt_t, const optional<T>& value) noexcept {
  return value.has_value() ? strong_ordering::less : strong_ordering::equal;
}

template <class T>
bool operator==(const optional<T>& left, const T& right) {
  return left.has_value() && *left == right;
}

template <class T>
bool operator==(const T& left, const optional<T>& right) {
  return right == left;
}

template <class T>
bool operator!=(const optional<T>& left, const T& right) {
  return !(left == right);
}

template <class T>
bool operator!=(const T& left, const optional<T>& right) {
  return !(right == left);
}

template <class T>
bool operator<(const optional<T>& left, const T& right) {
  return !left.has_value() || *left < right;
}

template <class T>
bool operator<(const T& left, const optional<T>& right) {
  return right.has_value() && left < *right;
}

template <class T>
bool operator>(const optional<T>& left, const T& right) {
  return right < left;
}

template <class T>
bool operator>(const T& left, const optional<T>& right) {
  return right < left;
}

template <class T>
bool operator<=(const optional<T>& left, const T& right) {
  return !(right < left);
}

template <class T>
bool operator<=(const T& left, const optional<T>& right) {
  return !(right < left);
}

template <class T>
bool operator>=(const optional<T>& left, const T& right) {
  return !(left < right);
}

template <class T>
bool operator>=(const T& left, const optional<T>& right) {
  return !(left < right);
}

template <class T>
auto operator<=>(const optional<T>& left, const T& right) {
  return left.has_value() ? *left <=> right : strong_ordering::less;
}

template <class T>
auto operator<=>(const T& left, const optional<T>& right) {
  return right.has_value() ? left <=> *right : strong_ordering::greater;
}

