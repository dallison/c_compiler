          __inout_matrix X, class BinaryDivideOp>
constexpr void __triangular_matrix_right_solve_in_place(
    A a, Triangle triangle, DiagonalStorage diagonal, X x,
    BinaryDivideOp divide) {
  for (typename X::index_type row = 0; row < x.extent(0); ++row) {
    if constexpr (__is_upper_triangle<Triangle>()) {
      for (typename X::index_type j = 0; j < x.extent(1); ++j) {
        auto value = x[row, j];
        for (typename X::index_type k = 0; k < j; ++k)
          value -= x[row, k] * a[k, j];
        if (!__is_implicit_diagonal<DiagonalStorage>())
          value = divide(value, a[j, j]);
        x[row, j] = value;
      }
    } else {
      typename X::index_type j = x.extent(1);
      while (j != 0) {
        --j;
        auto value = x[row, j];
        for (typename X::index_type k = j + 1; k < x.extent(1); ++k)
          value -= x[row, k] * a[k, j];
        if (!__is_implicit_diagonal<DiagonalStorage>())
          value = divide(value, a[j, j]);
        x[row, j] = value;
      }
    }
  }
}

