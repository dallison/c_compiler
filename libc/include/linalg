template <__in_matrix A, class Triangle, class DiagonalStorage,
          __inout_matrix X, class BinaryDivideOp>
constexpr void __triangular_matrix_left_solve_in_place(
    A a, Triangle triangle, DiagonalStorage diagonal, X x,
    BinaryDivideOp divide) {
  for (typename X::index_type column = 0; column < x.extent(1); ++column) {
    if constexpr (__is_upper_triangle<Triangle>()) {
      typename X::index_type i = x.extent(0);
      while (i != 0) {
        --i;
        auto value = x[i, column];
        for (typename X::index_type k = i + 1; k < x.extent(0); ++k)
          value -= a[i, k] * x[k, column];
        if (!__is_implicit_diagonal<DiagonalStorage>())
          value = divide(value, a[i, i]);
        x[i, column] = value;
      }
    } else {
      for (typename X::index_type i = 0; i < x.extent(0); ++i) {
        auto value = x[i, column];
        for (typename X::index_type k = 0; k < i; ++k)
          value -= a[i, k] * x[k, column];
        if (!__is_implicit_diagonal<DiagonalStorage>())
          value = divide(value, a[i, i]);
        x[i, column] = value;
      }
    }
  }
}

