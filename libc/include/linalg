template <class Scalar, __in_vector X,
          __possibly_packed_inout_matrix A, class Triangle>
constexpr void symmetric_matrix_rank_1_update(Scalar alpha, X x, A a,
                                              Triangle) {
  for (typename A::index_type i = 0; i < a.extent(0); ++i)
    for (typename A::index_type j = 0; j < a.extent(1); ++j) {
      if constexpr (__is_upper_triangle<Triangle>()) {
        if (i <= j) a[i, j] = alpha * x[i] * x[j];
      } else {
        if (i >= j) a[i, j] = alpha * x[i] * x[j];
      }
    }
}

