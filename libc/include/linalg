template <class Triangle, class StorageOrder>
class layout_blas_packed {
 public:
  using triangle_type = Triangle;
  using storage_order_type = StorageOrder;

  template <class Extents>
  class mapping {
   public:
    using extents_type = Extents;
    using index_type = typename extents_type::index_type;
    using size_type = typename extents_type::size_type;
    using rank_type = typename extents_type::rank_type;
    using layout_type = layout_blas_packed;

   private:
    extents_type __extents{};

   public:
    constexpr mapping() noexcept = default;
    constexpr mapping(const mapping&) noexcept = default;
    constexpr explicit mapping(const extents_type& extents) noexcept
        : __extents(extents) {}

    template <class OtherExtents>
    constexpr explicit(!is_convertible<OtherExtents, extents_type>::value)
        mapping(const mapping<OtherExtents>& other) noexcept
        : __extents(other.extents()) {}

    constexpr mapping& operator=(const mapping&) noexcept = default;
    constexpr const extents_type& extents() const noexcept { return __extents; }

    constexpr index_type required_span_size() const noexcept {
      index_type n = static_cast<index_type>(__extents.extent(0));
      return n * (n + 1) / 2;
    }

    template <class Index0, class Index1>
    constexpr index_type operator()(Index0 row, Index1 column) const noexcept {
      index_type i = static_cast<index_type>(row);
      index_type j = static_cast<index_type>(column);
      if (i > j) {
        index_type temp = i;
        i = j;
        j = temp;
      }
      index_type n = __extents.extent(0);
      if constexpr (
          (is_same<StorageOrder, column_major_t>::value &&
           is_same<Triangle, upper_triangle_t>::value) ||
          (is_same<StorageOrder, row_major_t>::value &&
           is_same<Triangle, lower_triangle_t>::value)) {
        return i + j * (j + 1) / 2;
      } else {
        return j + n * i - i * (i + 1) / 2;
      }
    }

    static constexpr bool is_always_unique() {
      return (extents_type::static_extent(0) != dynamic_extent &&
              extents_type::static_extent(0) < 2) ||
             (extents_type::static_extent(1) != dynamic_extent &&
              extents_type::static_extent(1) < 2);
    }
    static constexpr bool is_always_exhaustive() { return true; }
    static constexpr bool is_always_strided() { return is_always_unique(); }
    constexpr bool is_unique() const noexcept {
      return __extents.extent(0) < 2;
    }
    constexpr bool is_exhaustive() const noexcept { return true; }
    constexpr bool is_strided() const noexcept { return is_unique(); }
    constexpr index_type stride(rank_type) const noexcept { return 1; }

    template <class OtherExtents>
    friend constexpr bool operator==(
        const mapping& left, const mapping<OtherExtents>& right) noexcept {
      return left.extents() == right.extents();
    }
  };
};

template <class T>
struct __is_mdspan : false_type {};

template <class E, class X, class L, class A>
struct __is_mdspan<mdspan<E, X, L, A>> : true_type {};

template <class T>
struct __mdspan_rank;

template <class E, class X, class L, class A>
struct __mdspan_rank<mdspan<E, X, L, A>>
    : integral_constant<size_t, X::rank()> {};

template <class T>
struct __object_rank
    : __mdspan_rank<typename remove_cvref<T>::type> {};

template <class T>
concept __in_vector =
    __is_mdspan<typename remove_cvref<T>::type>::value &&
    __object_rank<T>::value == 1;
template <class T>
concept __out_vector = __in_vector<T>;
template <class T>
concept __inout_vector = __in_vector<T>;
template <class T>
concept __in_matrix =
    __is_mdspan<typename remove_cvref<T>::type>::value &&
    __object_rank<T>::value == 2;
template <class T>
concept __out_matrix = __in_matrix<T>;
template <class T>
concept __inout_matrix = __in_matrix<T>;
template <class T>
concept __possibly_packed_inout_matrix = __in_matrix<T>;
template <class T>
concept __in_object = __in_vector<T> || __in_matrix<T>;
template <class T>
concept __out_object = __in_object<T>;
template <class T>
concept __inout_object = __in_object<T>;

template <class T>
struct __number_traits {
  using real_type = T;
  static constexpr T conjugate(const T& value) { return value; }
  static constexpr T absolute(const T& value) {
    return value < T() ? -value : value;
  }
};

template <class T>
struct __number_traits<complex<T>> {
  using real_type = T;
  static constexpr complex<T> conjugate(const complex<T>& value) {
    return complex<T>(value.real(), -value.imag());
  }
  static T absolute(const complex<T>& value) {
    using std::sqrt;
    return sqrt(value.real() * value.real() + value.imag() * value.imag());
  }
};

template <class T>
constexpr auto __conjugate(const T& value) {
  using value_type = typename remove_cvref<T>::type;
  return __number_traits<value_type>::conjugate(value);
}

template <class T>
constexpr auto __abs_value(const T& value) {
  using value_type = typename remove_cvref<T>::type;
  return __number_traits<value_type>::absolute(value);
}

template <class T>
constexpr auto __abs1_value(const T& value) {
  return __abs_value(value);
}

template <class T>
constexpr T __abs1_value(const complex<T>& value) {
  return __abs_value(value.real()) + __abs_value(value.imag());
}

template <class T>
constexpr T __real_if_needed(const T& value) {
  return value;
}

template <class T>
constexpr complex<T> __real_if_needed(const complex<T>& value) {
  return complex<T>(value.real());
}

template <class Triangle>
constexpr bool __is_upper_triangle() {
  return is_same<typename remove_cvref<Triangle>::type,
                 upper_triangle_t>::value;
}

template <class DiagonalStorage>
constexpr bool __is_implicit_diagonal() {
  return is_same<typename remove_cvref<DiagonalStorage>::type,
                 implicit_unit_diagonal_t>::value;
}

template <class A, class Triangle>
constexpr auto __symmetric_element(A a, Triangle, typename A::index_type i,
                                   typename A::index_type j) {
  if constexpr (__is_upper_triangle<Triangle>())
    return i <= j ? a[i, j] : a[j, i];
  else
    return i >= j ? a[i, j] : a[j, i];
}

template <class A, class Triangle>
constexpr auto __hermitian_element(A a, Triangle, typename A::index_type i,
                                   typename A::index_type j) {
  if (i == j) return __real_if_needed(a[i, i]);
  if constexpr (__is_upper_triangle<Triangle>())
    return i <= j ? a[i, j] : __conjugate(a[j, i]);
  else
    return i >= j ? a[i, j] : __conjugate(a[j, i]);
}

template <class A, class Triangle, class DiagonalStorage>
constexpr auto __triangular_element(A a, Triangle, DiagonalStorage,
                                    typename A::index_type i,
                                    typename A::index_type j) {
  using value_type = typename A::value_type;
  if (i == j && __is_implicit_diagonal<DiagonalStorage>())
    return value_type(1);
  if constexpr (__is_upper_triangle<Triangle>())
    return i <= j ? a[i, j] : value_type();
  else
    return i >= j ? a[i, j] : value_type();
}

template <class Real>
struct setup_givens_rotation_result {
  Real c;
  Real s;
  Real r;
};

template <class Real>
struct setup_givens_rotation_result<complex<Real>> {
  Real c;
  complex<Real> s;
  complex<Real> r;
};

template <class Real>
setup_givens_rotation_result<Real> setup_givens_rotation(Real a,
                                                         Real b) noexcept {
  if (b == Real()) return {Real(1), Real(), a};
  if (a == Real()) {
    Real b_abs = __abs_value(b);
    return {Real(), b / b_abs, b_abs};
  }
  using std::sqrt;
  Real r = sqrt(a * a + b * b);
  return {a / r, b / r, r};
}

template <class Real>
setup_givens_rotation_result<complex<Real>> setup_givens_rotation(
    complex<Real> a, complex<Real> b) noexcept {
  Real a_abs = __abs_value(a);
  Real b_abs = __abs_value(b);
  if (b_abs == Real()) return {Real(1), complex<Real>(), a};
  if (a_abs == Real())
    return {Real(), __conjugate(b) / b_abs, complex<Real>(b_abs)};
  using std::sqrt;
  Real norm = sqrt(a_abs * a_abs + b_abs * b_abs);
  complex<Real> alpha = a / a_abs;
  return {a_abs / norm, alpha * __conjugate(b) / norm, alpha * norm};
}

template <__inout_vector X, __inout_vector Y, class Real>
void apply_givens_rotation(X x, Y y, Real c, Real s) {
  for (typename X::index_type i = 0; i < x.extent(0); ++i) {
    auto old_x = x[i];
    auto old_y = y[i];
    x[i] = c * old_x + s * old_y;
    y[i] = c * old_y - s * old_x;
  }
}

template <__inout_vector X, __inout_vector Y, class Real>
void apply_givens_rotation(X x, Y y, Real c, complex<Real> s) {
  for (typename X::index_type i = 0; i < x.extent(0); ++i) {
    auto old_x = x[i];
    auto old_y = y[i];
    x[i] = c * old_x + s * old_y;
    y[i] = c * old_y - __conjugate(s) * old_x;
  }
}

template <class ExecutionPolicy, __inout_vector X, __inout_vector Y,
          class Real>
  requires(is_execution_policy<
           typename remove_cvref<ExecutionPolicy>::type>::value)
void apply_givens_rotation(ExecutionPolicy&&, X x, Y y, Real c, Real s) {
  apply_givens_rotation(x, y, c, s);
}

template <class ExecutionPolicy, __inout_vector X, __inout_vector Y,
          class Real>
  requires(is_execution_policy<
           typename remove_cvref<ExecutionPolicy>::type>::value)
void apply_givens_rotation(ExecutionPolicy&&, X x, Y y, Real c,
                           complex<Real> s) {
  apply_givens_rotation(x, y, c, s);
}

template <class ScalingFactor, class Accessor>
class scaled_accessor {
 public:
  using offset_policy =
      scaled_accessor<ScalingFactor, typename Accessor::offset_policy>;
  using element_type = remove_cv_t<decltype(
      declval<ScalingFactor>() * declval<typename Accessor::reference>())>;
  using reference = element_type;
  using data_handle_type = typename Accessor::data_handle_type;

 private:
  ScalingFactor __factor{};
  Accessor __accessor{};

 public:
  constexpr scaled_accessor() = default;
  constexpr scaled_accessor(const ScalingFactor& factor,
                            const Accessor& accessor)
      : __factor(factor), __accessor(accessor) {}

  constexpr reference access(data_handle_type handle, size_t index) const {
    return __factor * __accessor.access(handle, index);
  }

  constexpr typename offset_policy::data_handle_type offset(
      data_handle_type handle, size_t index) const {
    return __accessor.offset(handle, index);
  }

  constexpr const ScalingFactor& scaling_factor() const noexcept {
    return __factor;
  }
  constexpr const Accessor& nested_accessor() const noexcept {
    return __accessor;
  }
};

template <class ScalingFactor, class ElementType, class Extents,
          class Layout, class Accessor>
constexpr auto scaled(ScalingFactor factor,
                      mdspan<ElementType, Extents, Layout, Accessor> x) {
  using accessor_type = scaled_accessor<ScalingFactor, Accessor>;
  using element_type = typename accessor_type::element_type;
  return mdspan<element_type, Extents, Layout, accessor_type>(
      x.data_handle(), x.mapping(), accessor_type(factor, x.accessor()));
}

template <class Accessor>
class conjugated_accessor {
 public:
  using offset_policy =
      conjugated_accessor<typename Accessor::offset_policy>;
  using element_type = remove_cv_t<decltype(
      __conjugate(declval<typename Accessor::reference>()))>;
  using reference = element_type;
  using data_handle_type = typename Accessor::data_handle_type;

 private:
  Accessor __accessor{};

 public:
  constexpr conjugated_accessor() = default;
  constexpr explicit conjugated_accessor(const Accessor& accessor)
      : __accessor(accessor) {}

  constexpr reference access(data_handle_type handle, size_t index) const {
    return __conjugate(__accessor.access(handle, index));
  }

  constexpr typename offset_policy::data_handle_type offset(
      data_handle_type handle, size_t index) const {
    return __accessor.offset(handle, index);
  }

  constexpr const Accessor& nested_accessor() const noexcept {
    return __accessor;
  }
};

template <class ElementType, class Extents, class Layout, class Accessor>
constexpr auto conjugated(mdspan<ElementType, Extents, Layout, Accessor> x) {
  if constexpr (is_arithmetic<typename remove_cv<ElementType>::type>::value) {
    return x;
  } else {
    using accessor_type = conjugated_accessor<Accessor>;
    using element_type = typename accessor_type::element_type;
    return mdspan<element_type, Extents, Layout, accessor_type>(
        x.data_handle(), x.mapping(), accessor_type(x.accessor()));
  }
}

template <class Extents>
struct __transpose_extents;

template <class IndexType, size_t First, size_t Second>
struct __transpose_extents<extents<IndexType, First, Second>> {
  using type = extents<IndexType, Second, First>;
};

template <class Layout>
class layout_transpose;

template <class Layout>
class layout_transpose {
 public:
  using nested_layout_type = Layout;

  template <class Extents>
  class mapping {
    using nested_extents = typename __transpose_extents<Extents>::type;
    using nested_mapping_type =
        typename Layout::template mapping<nested_extents>;

   public:
    using extents_type = Extents;
    using index_type = typename extents_type::index_type;
    using size_type = typename extents_type::size_type;
    using rank_type = typename extents_type::rank_type;
    using layout_type = layout_transpose;

   private:
    nested_mapping_type __nested_mapping;
    extents_type __extents{};

    static constexpr extents_type __make_extents(
        const nested_mapping_type& nested) {
      return extents_type(nested.extents().extent(1),
                          nested.extents().extent(0));
    }

   public:
    constexpr explicit mapping(const nested_mapping_type& nested)
        : __nested_mapping(nested), __extents(__make_extents(nested)) {}

    constexpr const extents_type& extents() const noexcept {
      return __extents;
    }
    constexpr index_type required_span_size() const noexcept {
      return __nested_mapping.required_span_size();
    }
    template <class Index0, class Index1>
    constexpr index_type operator()(Index0 i, Index1 j) const noexcept {
      return __nested_mapping(j, i);
    }
    constexpr const nested_mapping_type& nested_mapping() const noexcept {
      return __nested_mapping;
    }
    static constexpr bool is_always_unique() {
      return nested_mapping_type::is_always_unique();
    }
    static constexpr bool is_always_exhaustive() {
      return nested_mapping_type::is_always_exhaustive();
    }
    static constexpr bool is_always_strided() {
      return nested_mapping_type::is_always_strided();
    }
    constexpr bool is_unique() const {
      return __nested_mapping.is_unique();
    }
    constexpr bool is_exhaustive() const {
      return __nested_mapping.is_exhaustive();
    }
    constexpr bool is_strided() const {
      return __nested_mapping.is_strided();
    }
    constexpr index_type stride(rank_type r) const {
      return __nested_mapping.stride(r == 0 ? 1 : 0);
    }

    template <class OtherExtents>
    friend constexpr bool operator==(
        const mapping& left, const mapping<OtherExtents>& right) {
      return left.nested_mapping() == right.nested_mapping();
    }
  };
};

template <class Layout>
struct __packed_layout_info {
  static constexpr bool value = false;
};

template <class Triangle, class StorageOrder>
struct __packed_layout_info<layout_blas_packed<Triangle, StorageOrder>> {
  static constexpr bool value = true;
  using transpose_layout = layout_blas_packed<
      conditional_t<is_same<Triangle, upper_triangle_t>::value,
                    lower_triangle_t, upper_triangle_t>,
      conditional_t<is_same<StorageOrder, column_major_t>::value,
                    row_major_t, column_major_t>>;
};

template <class Layout>
struct __transpose_layout_info {
  static constexpr bool value = false;
};

template <class NestedLayout>
struct __transpose_layout_info<layout_transpose<NestedLayout>> {
  static constexpr bool value = true;
  using nested_layout = NestedLayout;
};

template <class ElementType, class Extents, class Layout, class Accessor>
constexpr auto transposed(mdspan<ElementType, Extents, Layout, Accessor> x) {
  using extents_type = typename __transpose_extents<Extents>::type;
  extents_type result_extents(x.extent(1), x.extent(0));
  if constexpr (is_same<Layout, layout_left>::value) {
    using layout_type = layout_right;
    using mapping_type = typename layout_type::template mapping<extents_type>;
    return mdspan<ElementType, extents_type, layout_type, Accessor>(
        x.data_handle(), mapping_type(result_extents), x.accessor());
  } else if constexpr (is_same<Layout, layout_right>::value) {
    using layout_type = layout_left;
    using mapping_type = typename layout_type::template mapping<extents_type>;
    return mdspan<ElementType, extents_type, layout_type, Accessor>(
        x.data_handle(), mapping_type(result_extents), x.accessor());
  } else if constexpr (__packed_layout_info<Layout>::value) {
    using layout_type =
        typename __packed_layout_info<Layout>::transpose_layout;
    using mapping_type = typename layout_type::template mapping<extents_type>;
    return mdspan<ElementType, extents_type, layout_type, Accessor>(
        x.data_handle(), mapping_type(result_extents), x.accessor());
  } else if constexpr (is_same<Layout, layout_stride>::value) {
    using layout_type = layout_stride;
    using mapping_type = typename layout_type::template mapping<extents_type>;
    array<typename extents_type::index_type, 2> strides{
        x.mapping().stride(1), x.mapping().stride(0)};
    return mdspan<ElementType, extents_type, layout_type, Accessor>(
        x.data_handle(), mapping_type(result_extents, strides), x.accessor());
  } else if constexpr (__transpose_layout_info<Layout>::value) {
    using layout_type =
        typename __transpose_layout_info<Layout>::nested_layout;
    return mdspan<ElementType, extents_type, layout_type, Accessor>(
        x.data_handle(), x.mapping().nested_mapping(), x.accessor());
  } else {
    using layout_type = layout_transpose<Layout>;
    using mapping_type = typename layout_type::template mapping<extents_type>;
    return mdspan<ElementType, extents_type, layout_type, Accessor>(
        x.data_handle(), mapping_type(x.mapping()), x.accessor());
  }
}

template <class ElementType, class Extents, class Layout, class Accessor>
constexpr auto conjugate_transposed(
    mdspan<ElementType, Extents, Layout, Accessor> x) {
  return conjugated(transposed(x));
}

template <__inout_object X, __inout_object Y>
constexpr void swap_elements(X x, Y y) {
  if constexpr (__object_rank<X>::value == 1) {
    for (typename X::index_type i = 0; i < x.extent(0); ++i) {
      auto temporary = std::move(x[i]);
      x[i] = std::move(y[i]);
      y[i] = std::move(temporary);
    }
  } else {
    for (typename X::index_type i = 0; i < x.extent(0); ++i)
      for (typename X::index_type j = 0; j < x.extent(1); ++j) {
        auto temporary = std::move(x[i, j]);
        x[i, j] = std::move(y[i, j]);
        y[i, j] = std::move(temporary);
      }
  }
}

template <class ExecutionPolicy, __inout_object X, __inout_object Y>
  requires(is_execution_policy<
           typename remove_cvref<ExecutionPolicy>::type>::value)
void swap_elements(ExecutionPolicy&&, X x, Y y) {
  swap_elements(x, y);
}

template <class Scalar, __inout_object X>
constexpr void scale(Scalar alpha, X x) {
  if constexpr (__object_rank<X>::value == 1) {
    for (typename X::index_type i = 0; i < x.extent(0); ++i)
      x[i] *= alpha;
  } else {
    for (typename X::index_type i = 0; i < x.extent(0); ++i)
      for (typename X::index_type j = 0; j < x.extent(1); ++j)
        x[i, j] *= alpha;
  }
}

template <class ExecutionPolicy, class Scalar, __inout_object X>
  requires(is_execution_policy<
           typename remove_cvref<ExecutionPolicy>::type>::value)
void scale(ExecutionPolicy&&, Scalar alpha, X x) {
  scale(alpha, x);
}

template <__in_object X, __out_object Y>
constexpr void copy(X x, Y y) {
  if constexpr (__object_rank<X>::value == 1) {
    for (typename X::index_type i = 0; i < x.extent(0); ++i)
      y[i] = x[i];
  } else {
    for (typename X::index_type i = 0; i < x.extent(0); ++i)
      for (typename X::index_type j = 0; j < x.extent(1); ++j)
        y[i, j] = x[i, j];
  }
}

template <class ExecutionPolicy, __in_object X, __out_object Y>
  requires(is_execution_policy<
           typename remove_cvref<ExecutionPolicy>::type>::value)
void copy(ExecutionPolicy&&, X x, Y y) {
  copy(x, y);
}

template <__in_object X, __in_object Y, __out_object Z>
constexpr void add(X x, Y y, Z z) {
  if constexpr (__object_rank<X>::value == 1) {
    for (typename X::index_type i = 0; i < x.extent(0); ++i)
      z[i] = x[i] + y[i];
  } else {
    for (typename X::index_type i = 0; i < x.extent(0); ++i)
      for (typename X::index_type j = 0; j < x.extent(1); ++j)
        z[i, j] = x[i, j] + y[i, j];
  }
}

template <class ExecutionPolicy, __in_object X, __in_object Y,
          __out_object Z>
  requires(is_execution_policy<
           typename remove_cvref<ExecutionPolicy>::type>::value)
void add(ExecutionPolicy&&, X x, Y y, Z z) {
  add(x, y, z);
}

template <__in_vector X, __in_vector Y, class Scalar>
constexpr Scalar dot(X x, Y y, Scalar init) {
  for (typename X::index_type i = 0; i < x.extent(0); ++i)
    init += x[i] * y[i];
  return init;
}

template <__in_vector X, __in_vector Y>
constexpr auto dot(X x, Y y) {
  using result_type =
      decltype(declval<typename X::value_type>() *
               declval<typename Y::value_type>());
  return dot(x, y, result_type());
}

template <class ExecutionPolicy, __in_vector X, __in_vector Y, class Scalar>
  requires(is_execution_policy<
           typename remove_cvref<ExecutionPolicy>::type>::value)
Scalar dot(ExecutionPolicy&&, X x, Y y, Scalar init) {
  return dot(x, y, init);
}

template <class ExecutionPolicy, __in_vector X, __in_vector Y>
  requires(is_execution_policy<
           typename remove_cvref<ExecutionPolicy>::type>::value)
auto dot(ExecutionPolicy&&, X x, Y y) {
  return dot(x, y);
