template <class Scalar>
struct sum_of_squares_result {
  Scalar scaling_factor;
  Scalar scaled_sum_of_squares;
};

template <__in_vector X, class Scalar>
constexpr sum_of_squares_result<Scalar> vector_sum_of_squares(
    X x, sum_of_squares_result<Scalar> init) {
  for (typename X::index_type i = 0; i < x.extent(0); ++i) {
    Scalar value = static_cast<Scalar>(__abs_value(x[i]));
    if (value == Scalar()) continue;
    if (init.scaling_factor < value) {
      Scalar ratio = init.scaling_factor / value;
      init.scaled_sum_of_squares =
          Scalar(1) + init.scaled_sum_of_squares * ratio * ratio;
      init.scaling_factor = value;
    } else {
      Scalar ratio = value / init.scaling_factor;
      init.scaled_sum_of_squares += ratio * ratio;
    }
  }
  return init;
}

