template <bool Hermitian, __in_matrix A, class Triangle, __in_matrix B,
          __out_matrix C>
constexpr void __structured_matrix_left_product(A a, Triangle triangle, B b,
                                                C c) {
  for (typename C::index_type i = 0; i < c.extent(0); ++i)
    for (typename C::index_type j = 0; j < c.extent(1); ++j) {
      using result_type = typename C::value_type;
      result_type sum = result_type();
      for (typename A::index_type k = 0; k < a.extent(1); ++k) {
        if constexpr (Hermitian)
          sum += __hermitian_element(a, triangle, i, k) * b[k, j];
        else
          sum += __symmetric_element(a, triangle, i, k) * b[k, j];
      }
      c[i, j] = sum;
    }
}

