struct __default_divide {
  template <class Left, class Right>
  constexpr auto operator()(Left left, Right right) const {
    return left / right;
  }
};

template <__in_matrix A, class Triangle, class DiagonalStorage,
          __inout_vector X, class BinaryDivideOp>
constexpr void __triangular_vector_solve_in_place(
    A a, Triangle triangle, DiagonalStorage diagonal, X x,
    BinaryDivideOp divide) {
  if constexpr (__is_upper_triangle<Triangle>()) {
    typename A::index_type i = a.extent(0);
    while (i != 0) {
      --i;
      auto value = x[i];
      for (typename A::index_type j = i + 1; j < a.extent(1); ++j)
        value -= a[i, j] * x[j];
      if (!__is_implicit_diagonal<DiagonalStorage>())
        value = divide(value, a[i, i]);
      x[i] = value;
    }
  } else {
    for (typename A::index_type i = 0; i < a.extent(0); ++i) {
      auto value = x[i];
      for (typename A::index_type j = 0; j < i; ++j)
        value -= a[i, j] * x[j];
      if (!__is_implicit_diagonal<DiagonalStorage>())
        value = divide(value, a[i, i]);
      x[i] = value;
    }
  }
}

template <__in_matrix A, class Triangle, class DiagonalStorage,
          __in_vector B, __out_vector X, class BinaryDivideOp>
constexpr void triangular_matrix_vector_solve(A a, Triangle triangle,
                                              DiagonalStorage diagonal, B b,
                                              X x, BinaryDivideOp divide) {
  copy(b, x);
  __triangular_vector_solve_in_place(a, triangle, diagonal, x, divide);
}

