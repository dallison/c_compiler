template <__in_matrix A, class Triangle, class DiagonalStorage,
          __inout_matrix C>
constexpr void triangular_matrix_left_product(A a, Triangle triangle,
                                              DiagonalStorage diagonal, C c) {
  if constexpr (__is_upper_triangle<Triangle>()) {
    for (typename C::index_type column = 0; column < c.extent(1); ++column)
      for (typename C::index_type i = 0; i < c.extent(0); ++i) {
        auto sum =
            __triangular_element(a, triangle, diagonal, i, i) * c[i, column];
        for (typename C::index_type k = i + 1; k < c.extent(0); ++k)
          sum += a[i, k] * c[k, column];
        c[i, column] = sum;
      }
  } else {
    for (typename C::index_type column = 0; column < c.extent(1); ++column) {
      typename C::index_type i = c.extent(0);
      while (i != 0) {
        --i;
        auto sum =
            __triangular_element(a, triangle, diagonal, i, i) * c[i, column];
        for (typename C::index_type k = 0; k < i; ++k)
          sum += a[i, k] * c[k, column];
        c[i, column] = sum;
      }
    }
  }
}

template <__in_matrix A, class Triangle, class DiagonalStorage,
          __inout_matrix C>
constexpr void triangular_matrix_right_product(A a, Triangle triangle,
                                               DiagonalStorage diagonal, C c) {
  for (typename C::index_type row = 0; row < c.extent(0); ++row) {
    if constexpr (__is_upper_triangle<Triangle>()) {
      typename C::index_type j = c.extent(1);
      while (j != 0) {
        --j;
        auto sum =
            c[row, j] * __triangular_element(a, triangle, diagonal, j, j);
        for (typename C::index_type k = 0; k < j; ++k)
          sum += c[row, k] * a[k, j];
        c[row, j] = sum;
      }
    } else {
      for (typename C::index_type j = 0; j < c.extent(1); ++j) {
        auto sum =
            c[row, j] * __triangular_element(a, triangle, diagonal, j, j);
        for (typename C::index_type k = j + 1; k < c.extent(1); ++k)
          sum += c[row, k] * a[k, j];
        c[row, j] = sum;
      }
    }
  }
}

