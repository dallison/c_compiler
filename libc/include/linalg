constexpr void matrix_product(A a, B b, C c) {
  for (typename A::index_type i = 0; i < a.extent(0); ++i)
    for (typename B::index_type j = 0; j < b.extent(1); ++j) {
      using result_type = typename C::value_type;
      result_type sum = result_type();
      for (typename A::index_type k = 0; k < a.extent(1); ++k)
        sum += a[i, k] * b[k, j];
      c[i, j] = sum;
