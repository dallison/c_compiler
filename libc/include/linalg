                                                DiagonalStorage diagonal,
                                                Y y) {
  if constexpr (__is_upper_triangle<Triangle>()) {
    for (typename A::index_type i = 0; i < a.extent(0); ++i) {
      auto sum = __triangular_element(a, triangle, diagonal, i, i) * y[i];
      for (typename A::index_type j = i + 1; j < a.extent(1); ++j)
        sum += __triangular_element(a, triangle, diagonal, i, j) * y[j];
      y[i] = sum;
