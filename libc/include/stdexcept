//
//  stdexcept
//  c_compiler
//
//  C++20 <stdexcept> support for DaveCC: the standard logic_error / runtime_error
//  hierarchies.  Each object owns a heap-duplicated copy of its message so that
//  what() stays valid for the lifetime of the exception and of any copy made
//  while it is thrown; copies are therefore deep and self-contained.
//

#ifndef __davecc_stdexcept__
#define __davecc_stdexcept__

#include <exception>
#include <new>
#include <string>

namespace std {

namespace __detail {

// Message-owning base shared by logic_error and runtime_error.  Deriving both
// standard roots from a single holder keeps the (identical) storage and what()
// logic in one place while preserving the observable hierarchy: out_of_range is
// still catchable as logic_error and as exception.
class __what_holder : public exception {
  char* __msg_;

  static constexpr char* __dup(const char* s) noexcept {
    if (s == nullptr) {
      s = "";
    }
    size_t n = 0;
    while (s[n] != '\0') {
      ++n;
    }
    char* p = static_cast<char*>(::operator new(n + 1));
    for (size_t i = 0; i <= n; ++i) {
      p[i] = s[i];
    }
    return p;
  }

  static constexpr void __release(char* p) noexcept {
    ::operator delete(static_cast<void*>(p));
  }

 public:
  constexpr explicit __what_holder(const char* s) : __msg_(__dup(s)) {}
  constexpr __what_holder(const __what_holder& other) noexcept
      : exception(other), __msg_(__dup(other.__msg_)) {}
  constexpr __what_holder& operator=(const __what_holder& other) noexcept {
    if (this != &other) {
      char* fresh = __dup(other.__msg_);
      __release(__msg_);
      __msg_ = fresh;
    }
    return *this;
  }
  constexpr ~__what_holder() override { __release(__msg_); }
  constexpr const char* what() const noexcept override { return __msg_; }
};

}  // namespace __detail

class logic_error : public __detail::__what_holder {
 public:
  constexpr explicit logic_error(const string& what_arg)
      : __what_holder(what_arg.c_str()) {}
  constexpr explicit logic_error(const char* what_arg)
      : __what_holder(what_arg) {}
};

class runtime_error : public __detail::__what_holder {
 public:
  constexpr explicit runtime_error(const string& what_arg)
      : __what_holder(what_arg.c_str()) {}
  constexpr explicit runtime_error(const char* what_arg)
      : __what_holder(what_arg) {}
};

// Leaf exception types simply forward their message to the appropriate root.
#define __DAVECC_DECLARE_ERROR(NAME, BASE)          \
  class NAME : public BASE {                        \
   public:                                          \
    constexpr explicit NAME(const string& what_arg) \
        : BASE(what_arg) {}                         \
    constexpr explicit NAME(const char* what_arg) : BASE(what_arg) {} \
  }

__DAVECC_DECLARE_ERROR(domain_error, logic_error);
__DAVECC_DECLARE_ERROR(invalid_argument, logic_error);
__DAVECC_DECLARE_ERROR(length_error, logic_error);
__DAVECC_DECLARE_ERROR(out_of_range, logic_error);
__DAVECC_DECLARE_ERROR(range_error, runtime_error);
__DAVECC_DECLARE_ERROR(overflow_error, runtime_error);
__DAVECC_DECLARE_ERROR(underflow_error, runtime_error);

#undef __DAVECC_DECLARE_ERROR

}  // namespace std

#endif /* __davecc_stdexcept__ */
