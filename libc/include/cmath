using ::scalbln;

inline float frexp(float x, int* exp) { return ::frexpf(x, exp); }
inline double frexp(double x, int* exp) { return ::frexp(x, exp); }
inline long double frexp(long double x, int* exp) { return ::frexpl(x, exp); }

inline int fpclassify(float x) {
  return ::__davecc_fpclassify((double)x);
}
inline int fpclassify(double x) { return ::__davecc_fpclassify(x); }
inline int fpclassify(long double x) { return ::__davecc_fpclassifyl(x); }

template <class T>
inline typename enable_if<is_integral<T>::value, int>::type fpclassify(T x) {
  return x == T(0) ? FP_ZERO : FP_NORMAL;
}

inline bool signbit(float x) {
  return ::__davecc_signbit((double)x) != 0;
}
inline bool signbit(double x) { return ::__davecc_signbit(x) != 0; }
inline bool signbit(long double x) { return ::__davecc_signbitl(x) != 0; }

template <class T>
inline typename enable_if<is_integral<T>::value, bool>::type signbit(T x) {
  return x < T(0);
}

inline bool isfinite(float x) { return fpclassify(x) > FP_INFINITE; }
inline bool isfinite(double x) { return fpclassify(x) > FP_INFINITE; }
inline bool isfinite(long double x) { return fpclassify(x) > FP_INFINITE; }

template <class T>
inline typename enable_if<is_integral<T>::value, bool>::type isfinite(T) {
  return true;
}

inline bool isinf(float x) { return fpclassify(x) == FP_INFINITE; }
inline bool isinf(double x) { return fpclassify(x) == FP_INFINITE; }
inline bool isinf(long double x) { return fpclassify(x) == FP_INFINITE; }

template <class T>
inline typename enable_if<is_integral<T>::value, bool>::type isinf(T) {
  return false;
}

inline bool isnan(float x) { return fpclassify(x) == FP_NAN; }
inline bool isnan(double x) { return fpclassify(x) == FP_NAN; }
inline bool isnan(long double x) { return fpclassify(x) == FP_NAN; }

template <class T>
inline typename enable_if<is_integral<T>::value, bool>::type isnan(T) {
  return false;
}

inline bool isnormal(float x) { return fpclassify(x) == FP_NORMAL; }
inline bool isnormal(double x) { return fpclassify(x) == FP_NORMAL; }
inline bool isnormal(long double x) { return fpclassify(x) == FP_NORMAL; }

template <class T>
inline typename enable_if<is_integral<T>::value, bool>::type isnormal(T x) {
  return x != T(0);
}

}  // namespace std

#endif /* cmath_h */
