//
//  cmath
//  c_compiler
//
//  C++ wrapper for <math.h>: brings the C math names into namespace std
//  for DaveCC.  Classification macros from <math.h> are undefined so
//  `std::fpclassify(x)` is a function call, not `std::` plus a macro body.
//

#ifndef cmath_h
#define cmath_h

#include <math.h>
#include <type_traits>

#undef fpclassify
#undef signbit
#undef isfinite
#undef isinf
#undef isnan
#undef isnormal

namespace std {

using ::float_t;
using ::double_t;

using ::sin;
using ::cos;
using ::tan;
using ::asin;
using ::acos;
using ::atan;
using ::atan2;
using ::sqrt;
using ::fabs;
using ::floor;
using ::ceil;
using ::exp;
using ::log;
using ::pow;
using ::modf;
using ::ldexp;
using ::sinh;
using ::cosh;
using ::tanh;
using ::asinh;
using ::acosh;
using ::atanh;
using ::exp2;
using ::expm1;
using ::log10;
using ::log1p;
using ::log2;
using ::logb;
using ::ilogb;
using ::cbrt;
using ::hypot;
using ::erf;
using ::erfc;
using ::tgamma;
using ::lgamma;
using ::fmod;
using ::remainder;
using ::remquo;
using ::copysign;
using ::nan;
using ::nextafter;
using ::nexttoward;
using ::fdim;
using ::fmax;
using ::fmin;
using ::fma;
using ::trunc;
