 public:
  access_context() = delete;
  consteval info designating_class() const { return __designating_class; }
  consteval info scope() const { return __scope; }

  [[davecc::meta_intrinsic]] static consteval access_context current() noexcept;
  [[davecc::meta_intrinsic]] static consteval access_context
  unprivileged() noexcept;
