struct data_member_options {
  struct name_type {
    consteval name_type() = default;
    template <size_t N>
    consteval name_type(const char (&value)[N]) : narrow(value) {}
    template <size_t N>
    consteval name_type(const char8_t (&value)[N])
        : utf8(value), is_utf8(true) {}
    consteval name_type(const char* value) : narrow(value) {}
    consteval name_type(const char8_t* value) : utf8(value), is_utf8(true) {}
    consteval name_type(u8string value)
        : utf8(std::move(value)), is_utf8(true) {}
    consteval name_type(string value) : narrow(std::move(value)) {}

   private:
    string narrow;
    u8string utf8;
    bool is_utf8 = false;

  };

  name_type name;
  optional<size_t> alignment;
  optional<size_t> bit_width;
  bool no_unique_address = false;
  vector<info, void> annotations;
};

