class exception : public std::exception {
 private:
  const char* what_ = "";
  const char8_t* u8what_ = u8"";
  size_t u8what_size_ = 0;
  info from_;
  source_location where_;

 public:
  consteval exception(u8string_view what, info from,
                      source_location where = source_location::current()) noexcept
      : u8what_(what.data()), u8what_size_(what.size()), from_(from),
        where_(where) {}

  consteval exception(string_view what, info from,
                      source_location where = source_location::current()) noexcept
      : what_(what.data()), from_(from), where_(where) {}

  constexpr exception(const exception& other) noexcept
      : what_(other.what_), u8what_(other.u8what_),
        u8what_size_(other.u8what_size_), from_(other.from_), where_(other.where_) {}
  constexpr exception(exception&& other) noexcept
      : what_(other.what_), u8what_(other.u8what_),
        u8what_size_(other.u8what_size_), from_(other.from_), where_(other.where_) {}
  constexpr exception& operator=(const exception& other) noexcept {
    what_ = other.what_;
    u8what_ = other.u8what_;
    u8what_size_ = other.u8what_size_;
    from_ = other.from_;
    where_ = other.where_;
    return *this;
  }
  constexpr exception& operator=(exception&& other) noexcept {
    what_ = other.what_;
    u8what_ = other.u8what_;
    u8what_size_ = other.u8what_size_;
    from_ = other.from_;
    where_ = other.where_;
    return *this;
  }

  constexpr const char* what() const noexcept override {
    return what_;
  }

  consteval u8string_view u8what() const noexcept {
    return {u8what_, u8what_size_};
  }
  consteval info from() const noexcept { return from_; }
  consteval source_location where() const noexcept { return where_; }
};

