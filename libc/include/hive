      return *this;
    }

    constexpr __iterator& operator-=(difference_type count) {
      return *this += -count;
    }

    constexpr __iterator operator+(difference_type count) const {
      __iterator result = *this;
      result += count;
      return result;
    }

    friend constexpr __iterator operator+(difference_type count,
                                           __iterator iterator) {
      return iterator + count;
    }

    constexpr __iterator operator-(difference_type count) const {
      __iterator result = *this;
      result -= count;
      return result;
    }

    template <bool Other>
    constexpr bool operator==(const __iterator<Other>& other) const noexcept {
      return __block_ == other.__block_ && __index_ == other.__index_;
    }

    template <bool Other>
    constexpr strong_ordering operator<=>(
        const __iterator<Other>& other) const noexcept {
      if (__block_ == other.__block_) {
        if (__index_ < other.__index_) {
          return strong_ordering::less;
        }
        if (__index_ > other.__index_) {
          return strong_ordering::greater;
        }
        return strong_ordering::equal;
      }
      if (__block_->__order < other.__block_->__order) {
        return strong_ordering::less;
      }
      return strong_ordering::greater;
