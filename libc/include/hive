  constexpr void __release_all() noexcept {
    __block_base* block = __storage_.__end_.__next;
    while (block != &__storage_.__end_) {
      __block_base* next = block->__next;
      __block* allocated = __as_block(block);
      __destroy_elements(allocated);
      __deallocate_block(allocated);
      block = next;
    }
    block = __storage_.__reserved_;
    while (block != nullptr) {
      __block_base* next = block->__reserved_next;
      __deallocate_block(__as_block(block));
      block = next;
    }
    __storage_.__init_sentinel();
  }

  size_type __next_block_capacity() const noexcept {
    size_type result = __limits_.min;
    if (__storage_.__end_.__prev != &__storage_.__end_) {
      size_type previous = __storage_.__end_.__prev->__capacity;
      result = previous >= __limits_.max / 2 ? __limits_.max : previous * 2;
      if (result < __limits_.min) {
        result = __limits_.min;
      }
    }
    if (result > __limits_.max) {
      result = __limits_.max;
    }
    return result;
  }

  template <class... Args>
  iterator __emplace(Args&&... args) {
    if (__storage_.__size_ == max_size()) {
      __hive_detail::__throw_length_error();
    }

    if (__storage_.__holes_ != nullptr) {
      __block* block = __as_block(__storage_.__holes_);
      size_type index = block->__base.__free_run;
      __alloc_traits::construct(__alloc_, &block->__elements[index],
                                std::forward<Args>(args)...);
      __storage_.__consume_run_start(__as_base(block), index);
      ++block->__base.__live;
      ++__storage_.__size_;
      if (block->__base.__live == 1 || index < block->__base.__first) {
        block->__base.__first = index;
      }
      if (block->__base.__live == 1 || index > block->__base.__last) {
        block->__base.__last = index;
      }
      return iterator(__as_base(block), index);
    }

    __block_base* last_base = __storage_.__end_.__prev;
    if (last_base != &__storage_.__end_ &&
        last_base->__used < last_base->__capacity) {
      __block* last = __as_block(last_base);
      size_type index = last->__base.__used;
      __alloc_traits::construct(__alloc_, &last->__elements[index],
                                std::forward<Args>(args)...);
      last->__base.__skip[index] = 0;
      last->__base.__run_prev[index] = __npos;
      last->__base.__run_next[index] = __npos;
      ++last->__base.__used;
      ++last->__base.__live;
      last->__base.__last = index;
      ++__storage_.__size_;
      return iterator(__as_base(last), index);
    }

    __block* block = __as_block(__storage_.__take_reserved());
    bool fresh = false;
    if (block == nullptr) {
      block = __allocate_block(__next_block_capacity());
      fresh = true;
    }
    __DAVECC_TRY {
      __alloc_traits::construct(__alloc_, &block->__elements[0],
                                std::forward<Args>(args)...);
    }
    __DAVECC_CATCH_ALL {
      if (fresh) {
        __deallocate_block(block);
      } else {
        block->__base.__reserved_next = __storage_.__reserved_;
        __storage_.__reserved_ = __as_base(block);
      }
      __DAVECC_RETHROW;
    }
    block->__base.__skip[0] = 0;
    block->__base.__run_prev[0] = __npos;
    block->__base.__run_next[0] = __npos;
    block->__base.__used = 1;
    block->__base.__live = 1;
    block->__base.__first = 0;
    block->__base.__last = 0;
    block->__base.__free_run = __npos;
    __storage_.__link_active_back(__as_base(block));
    if (fresh) {
      __storage_.__capacity_ += block->__base.__capacity;
    }
    ++__storage_.__size_;
    __storage_.__renumber();
    return iterator(__as_base(block), 0);
  }

  void __steal(hive& other) noexcept {
    __limits_ = other.__limits_;
    __storage_.__steal_storage(other.__storage_);
  }

  void __swap_contents(hive& other) noexcept {
    __storage_.__swap_storage(other.__storage_);
    std::swap(__limits_, other.__limits_);
  }

  void __copy_from(const hive& other) {
    for (const_reference value : other) {
      emplace(value);
    }
  }

  template <class InputIterator>
  void __insert_iterators(InputIterator first, InputIterator last) {
    for (; first != last; ++first) {
      emplace(*first);
    }
  }

