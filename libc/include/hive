    __meta_alloc_traits::deallocate(
        __meta_alloc_, block->__base.__skip, block->__base.__capacity);
    __alloc_traits::deallocate(
        __alloc_, block->__elements, block->__base.__capacity);
    __block_alloc_traits::destroy(__block_alloc_, block);
    __block_alloc_traits::deallocate(__block_alloc_, block, 1);
