  void __destroy_elements(__block* block) noexcept {
    if (block->__base.__live == 0) {
      return;
    }
    size_type index = block->__base.__first;
    for (size_type remaining = block->__base.__live; remaining != 0;
         --remaining) {
      __alloc_traits::destroy(__alloc_, &block->__elements[index]);
      if (remaining != 1) {
