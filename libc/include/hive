  static constexpr size_type __npos = static_cast<size_type>(-1);

  using __storage_base = __hive_detail::__storage;
  using __block_base = __hive_detail::__block_base;

  struct __block {
    __block_base __base;
    pointer __elements;

    constexpr __block() noexcept
        : __base(), __elements(nullptr) {}
  };

  static constexpr __block* __as_block(__block_base* block) noexcept {
    return reinterpret_cast<__block*>(block);
  }

  static constexpr __block_base* __as_base(__block* block) noexcept {
    return block == nullptr ? nullptr : &block->__base;
  }

  using __alloc_traits = allocator_traits<allocator_type>;
  using __block_allocator =
      typename __alloc_traits::template rebind_alloc<__block>;
  using __block_alloc_traits = allocator_traits<__block_allocator>;
  using __meta_allocator =
      typename __alloc_traits::template rebind_alloc<size_type>;
  using __meta_alloc_traits = allocator_traits<__meta_allocator>;

