   public:
    using iterator_category = bidirectional_iterator_tag;
    using iterator_concept = bidirectional_iterator_tag;
    using value_type = T;
    using difference_type = ptrdiff_t;
    using pointer = conditional_t<Const, const T*, T*>;
    using reference = conditional_t<Const, const T&, T&>;

    __block_base* __block_;
    size_type __index_;

    constexpr __iterator() noexcept : __block_(nullptr), __index_(0) {}
    constexpr __iterator(__block_base* block, size_type index) noexcept
        : __block_(block), __index_(index) {}

    template <bool Other>
      requires(Const && !Other)
    constexpr __iterator(const __iterator<Other>& other) noexcept
        : __block_(other.__block_), __index_(other.__index_) {}

    constexpr reference operator*() const {
      return static_cast<T*>(__block_->__elements)[__index_];
    }

    constexpr pointer operator->() const {
      return &static_cast<T*>(__block_->__elements)[__index_];
    }

    constexpr __iterator& operator++() {
      size_type next = __index_ + 1;
      if (next < __block_->__used) {
        size_type skip = __block_->__skip[next];
        if (skip != 0) {
          next += skip;
        }
        if (next < __block_->__used) {
          __index_ = next;
          return *this;
        }
      }
      __block_ = __block_->__next;
      __index_ = __block_->__sentinel ? 0 : __block_->__first;
      return *this;
    }

    constexpr __iterator operator++(int) {
      __iterator result = *this;
      ++*this;
      return result;
    }

    constexpr __iterator& operator--() {
      if (__block_->__sentinel) {
        __block_ = __block_->__prev;
        __index_ = __block_->__last;
        return *this;
      }
      if (__index_ != __block_->__first) {
        size_type previous = __index_ - 1;
        size_type skip = __block_->__skip[previous];
        if (skip != 0) {
          previous -= skip;
        }
        __index_ = previous;
        return *this;
      }
      __block_ = __block_->__prev;
      __index_ = __block_->__last;
      return *this;
    }

    constexpr __iterator operator--(int) {
      __iterator result = *this;
      --*this;
      return result;
    }

    constexpr __iterator& operator+=(difference_type count) {
      if (count >= 0) {
        while (count-- != 0) {
          ++*this;
        }
      } else {
        while (count++ != 0) {
          --*this;
        }
