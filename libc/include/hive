  constexpr explicit hive(const Allocator& alloc) noexcept
      : __storage_(),
        __alloc_(alloc),
        __block_alloc_(alloc),
        __meta_alloc_(alloc),
        __limits_(block_capacity_default_limits()) {}

  constexpr explicit hive(hive_limits block_limits)
      : __storage_(),
        __alloc_(),
        __block_alloc_(__alloc_),
        __meta_alloc_(__alloc_),
        __limits_(block_limits) {}

  constexpr hive(hive_limits block_limits, const Allocator& alloc)
