          __as_block(staged->__base.__reserved_next);
      staged->__base.__reserved_next = __storage_.__reserved_;
      __storage_.__reserved_ = __as_base(staged);
      staged = next_block;
    }
    __storage_.__capacity_ += staged_capacity;
  }

  void shrink_to_fit() {
    if (__storage_.__capacity_ == __storage_.__size_) {
      return;
    }
    hive compact(__limits_, __alloc_);
    compact.reserve(__storage_.__size_);
    if (compact.capacity() > __storage_.__capacity_) {
      return;
    }
    for (reference value : *this) {
      compact.emplace(std::move(value));
    }
    __swap_contents(compact);
  }

  void trim_capacity() noexcept {
    while (__storage_.__reserved_ != nullptr) {
      __block* block = __as_block(__storage_.__reserved_);
      __storage_.__reserved_ = block->__base.__reserved_next;
      __storage_.__capacity_ -= block->__base.__capacity;
      __deallocate_block(block);
    }
  }

  void trim_capacity(size_type count) noexcept {
    while (__storage_.__reserved_ != nullptr &&
           __storage_.__capacity_ -
                   __storage_.__reserved_->__capacity >=
               count) {
      __block* block = __as_block(__storage_.__reserved_);
      __storage_.__reserved_ = block->__base.__reserved_next;
      __storage_.__capacity_ -= block->__base.__capacity;
      __deallocate_block(block);
    }
  }

  constexpr hive_limits block_capacity_limits() const noexcept {
    return __limits_;
  }

  static constexpr hive_limits block_capacity_default_limits() noexcept {
    return hive_limits(8, __default_max());
  }

  static constexpr hive_limits block_capacity_hard_limits() noexcept {
    return hive_limits(1, __hard_max());
  }

  static constexpr bool is_within_hard_limits(hive_limits limits) noexcept {
    return limits.min >= 1 && limits.min <= limits.max &&
           limits.max <= __hard_max();
  }

  void reshape(hive_limits limits) {
    if (!is_within_hard_limits(limits)) {
      __hive_detail::__throw_length_error();
    }
    bool active_fits = true;
    for (__block_base* block = __storage_.__end_.__next;
         block != &__storage_.__end_;
         block = block->__next) {
      if (block->__capacity < limits.min || block->__capacity > limits.max) {
        active_fits = false;
        break;
      }
    }

    if (!active_fits) {
      hive replacement(limits, __alloc_);
      replacement.reserve(__storage_.__size_);
      for (reference value : *this) {
        replacement.emplace(std::move(value));
      }
      __swap_contents(replacement);
      return;
    }

    __block_base** link = &__storage_.__reserved_;
    while (*link != nullptr) {
      __block* block = __as_block(*link);
      if (block->__base.__capacity < limits.min ||
          block->__base.__capacity > limits.max) {
        *link = block->__base.__reserved_next;
        __storage_.__capacity_ -= block->__base.__capacity;
        __deallocate_block(block);
      } else {
        link = &block->__base.__reserved_next;
      }
    }
    __limits_ = limits;
  }

  template <class... Args>
  iterator emplace(Args&&... args) {
    return __emplace(std::forward<Args>(args)...);
  }

  template <class... Args>
  iterator emplace_hint(const_iterator, Args&&... args) {
    return __emplace(std::forward<Args>(args)...);
  }

  iterator insert(const T& value) { return emplace(value); }
  iterator insert(T&& value) { return emplace(std::move(value)); }
  iterator insert(const_iterator, const T& value) { return emplace(value); }
  iterator insert(const_iterator, T&& value) {
    return emplace(std::move(value));
  }

  void insert(initializer_list<T> values) {
    insert(values.begin(), values.end());
  }

  template <ranges::input_range R>
    requires is_convertible_v<ranges::range_reference_t<R>, T>
  void insert_range(R&& range) {
    __insert_iterators(ranges::begin(range), ranges::end(range));
  }

  template <class InputIterator,
            class = typename iterator_traits<InputIterator>::iterator_category>
  void insert(InputIterator first, InputIterator last) {
    __insert_iterators(first, last);
  }

  void insert(size_type count, const T& value) {
    while (count-- != 0) {
      emplace(value);
    }
  }

  iterator erase(const_iterator position) {
    __block* block = __as_block(position.__block_);
    size_type index = position.__index_;
    iterator result(__as_base(block), index);
    ++result;
    __alloc_traits::destroy(__alloc_, &block->__elements[index]);
    --block->__base.__live;
    --__storage_.__size_;

    if (block->__base.__live == 0) {
      __storage_.__unlink_active(__as_base(block));
      if (block->__base.__free_run != __npos) {
        __storage_.__remove_hole_block(__as_base(block));
      }
      __storage_.__reset_as_reserved(__as_base(block));
      __storage_.__renumber();
      return result;
    }

    __storage_.__mark_erased(__as_base(block), index);
    if (index == block->__base.__first) {
      size_type first = index + 1;
      if (block->__base.__skip[first] != 0) {
        first += block->__base.__skip[first];
      }
      block->__base.__first = first;
    }
    if (index == block->__base.__last) {
      size_type last = index - 1;
      if (block->__base.__skip[last] != 0) {
        last -= block->__base.__skip[last];
      }
      block->__base.__last = last;
    }
    return result;
  }

  iterator erase(const_iterator first, const_iterator last) {
    iterator current(first.__block_, first.__index_);
    iterator finish(last.__block_, last.__index_);
    while (current != finish) {
      current = erase(current);
    }
    return current;
  }

  void swap(hive& other) noexcept(
      __alloc_traits::propagate_on_container_swap::value ||
      __alloc_traits::is_always_equal::value) {
    if (this == &other) {
      return;
    }
    if constexpr (__alloc_traits::propagate_on_container_swap::value) {
      std::swap(__alloc_, other.__alloc_);
      std::swap(__block_alloc_, other.__block_alloc_);
      std::swap(__meta_alloc_, other.__meta_alloc_);
    }
    __swap_contents(other);
  }

  void clear() noexcept {
    __block_base* block = __storage_.__end_.__next;
    while (block != &__storage_.__end_) {
      __block_base* next = block->__next;
      __destroy_elements(__as_block(block));
      __storage_.__reset_as_reserved(block);
      block = next;
    }
    __storage_.__end_.__next = &__storage_.__end_;
    __storage_.__end_.__prev = &__storage_.__end_;
    __storage_.__end_.__order = 0;
    __storage_.__holes_ = nullptr;
    __storage_.__size_ = 0;
  }

  void splice(hive& other) {
    __storage_.__splice_storage(other.__storage_, __limits_.min,
                                __limits_.max);
  }

  void splice(hive&& other) { splice(other); }

  template <class BinaryPredicate = equal_to<T>>
  size_type unique(BinaryPredicate predicate = BinaryPredicate()) {
    if (__storage_.__size_ < 2) {
      return 0;
    }
    size_type removed = 0;
    iterator previous = begin();
    iterator current(previous.__block_, previous.__index_);
    ++current;
    while (current != end()) {
      if (predicate(*current, *previous)) {
        current =
            erase(const_iterator(current.__block_, current.__index_));
        ++removed;
      } else {
        previous = current;
        ++current;
      }
    }
    return removed;
  }

  template <class Compare = less<T>>
  void sort(Compare compare = Compare()) {
    if (__storage_.__size_ < 2) {
      return;
    }
    vector<T*> order;
    order.reserve(__storage_.__size_);
    for (reference value : *this) {
      order.emplace_back(&value);
    }
    std::sort(order.begin(), order.end(),
              [&compare](T* left, T* right) {
                return compare(*left, *right);
              });
    hive sorted(__limits_, __alloc_);
    sorted.reserve(__storage_.__size_);
    for (T* value : order) {
      sorted.emplace(std::move(*value));
    }
    __swap_contents(sorted);
  }

  iterator get_iterator(const_pointer value) noexcept {
    less<const_pointer> before;
    for (__block_base* base = __storage_.__end_.__next;
         base != &__storage_.__end_;
         base = base->__next) {
      __block* block = __as_block(base);
      const_pointer first = block->__elements;
      const_pointer last =
          block->__elements + block->__base.__used;
      if (!before(value, first) && before(value, last)) {
        return iterator(base, static_cast<size_type>(value - first));
      }
    }
    return end();
  }

  const_iterator get_iterator(const_pointer value) const noexcept {
    less<const_pointer> before;
    for (__block_base* base = __storage_.__end_.__next;
         base != &__storage_.__end_;
         base = base->__next) {
      __block* block = __as_block(base);
      const_pointer first = block->__elements;
      const_pointer last =
          block->__elements + block->__base.__used;
      if (!before(value, first) && before(value, last)) {
        return const_iterator(base, static_cast<size_type>(value - first));
      }
    }
    return end();
  }
};

template <class InputIterator,
          class Allocator =
              allocator<typename iterator_traits<InputIterator>::value_type>>
hive(InputIterator, InputIterator, Allocator = Allocator())
    -> hive<typename iterator_traits<InputIterator>::value_type, Allocator>;

template <class InputIterator,
          class Allocator =
              allocator<typename iterator_traits<InputIterator>::value_type>>
hive(InputIterator, InputIterator, hive_limits, Allocator = Allocator())
    -> hive<typename iterator_traits<InputIterator>::value_type, Allocator>;

template <ranges::input_range R,
          class Allocator = allocator<ranges::range_value_t<R>>>
hive(from_range_t, R&&, Allocator = Allocator())
    -> hive<ranges::range_value_t<R>, Allocator>;

template <ranges::input_range R,
          class Allocator = allocator<ranges::range_value_t<R>>>
hive(from_range_t, R&&, hive_limits, Allocator = Allocator())
    -> hive<ranges::range_value_t<R>, Allocator>;

template <class T, class Allocator>
void swap(hive<T, Allocator>& left,
          hive<T, Allocator>& right) noexcept(noexcept(left.swap(right))) {
  left.swap(right);
}

template <class T, class Allocator, class U>
typename hive<T, Allocator>::size_type erase(hive<T, Allocator>& container,
                                              const U& value) {
  return erase_if(container,
                  [&](const auto& element) { return element == value; });
}

template <class T, class Allocator, class Predicate>
typename hive<T, Allocator>::size_type erase_if(hive<T, Allocator>& container,
                                                 Predicate predicate) {
  typename hive<T, Allocator>::size_type original = container.size();
  for (auto iterator = container.begin(); iterator != container.end();) {
    if (predicate(*iterator)) {
      typename hive<T, Allocator>::const_iterator position(
          iterator.__block_, iterator.__index_);
      iterator = container.erase(position);
    } else {
      ++iterator;
    }
  }
  return original - container.size();
}

