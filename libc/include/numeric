#if __cplusplus >= 201703L

namespace __numeric_detail {

template <class T>
constexpr typename make_unsigned<T>::type __unsigned_magnitude(T value) {
  typedef typename make_unsigned<T>::type U;
  U converted = static_cast<U>(value);
  return value < 0 ? U(0) - converted : converted;
}

template <class T>
struct __plus {
  constexpr T operator()(const T& left, const T& right) const {
    return left + right;
  }
};

template <class T>
struct __multiplies {
  constexpr T operator()(const T& left, const T& right) const {
    return left * right;
  }
};

}  // namespace __numeric_detail

template <class M, class N>
constexpr common_type_t<M, N> gcd(M m, N n) {
  static_assert(is_integral<M>::value && is_integral<N>::value,
                "gcd requires integral operands");
  typedef common_type_t<M, N> C;
  typedef make_unsigned_t<C> U;
  U left = __numeric_detail::__unsigned_magnitude(static_cast<C>(m));
  U right = __numeric_detail::__unsigned_magnitude(static_cast<C>(n));
  while (right != 0) {
    U remainder = left % right;
    left = right;
    right = remainder;
  }
  return static_cast<C>(left);
}

template <class M, class N>
constexpr common_type_t<M, N> lcm(M m, N n) {
  static_assert(is_integral<M>::value && is_integral<N>::value,
                "lcm requires integral operands");
  typedef common_type_t<M, N> C;
  if (m == 0 || n == 0) {
    return C(0);
  }
  typedef make_unsigned_t<C> U;
  U left = __numeric_detail::__unsigned_magnitude(static_cast<C>(m));
  U right = __numeric_detail::__unsigned_magnitude(static_cast<C>(n));
  return static_cast<C>((left / static_cast<U>(gcd(m, n))) * right);
}

template <class InputIt, class T, class BinaryOperation>
T reduce(InputIt first, InputIt last, T init, BinaryOperation operation) {
  for (; first != last; ++first) {
    init = operation(init, *first);
  }
  return init;
}

template <class InputIt, class T>
T reduce(InputIt first, InputIt last, T init) {
  return std::reduce(first, last, init, __numeric_detail::__plus<T>());
}

template <class InputIt>
typename iterator_traits<InputIt>::value_type reduce(InputIt first,
                                                      InputIt last) {
  typedef typename iterator_traits<InputIt>::value_type T;
  return std::reduce(first, last, T());
}

template <class InputIt1, class InputIt2, class T, class BinaryOperation1,
          class BinaryOperation2>
T transform_reduce(InputIt1 first1, InputIt1 last1, InputIt2 first2, T init,
                   BinaryOperation1 reduce_operation,
                   BinaryOperation2 transform_operation) {
  for (; first1 != last1; ++first1, ++first2) {
    init = reduce_operation(
        init, transform_operation(*first1, *first2));
  }
  return init;
}

template <class InputIt1, class InputIt2, class T>
T transform_reduce(InputIt1 first1, InputIt1 last1, InputIt2 first2, T init) {
  return std::transform_reduce(
      first1, last1, first2, init, __numeric_detail::__plus<T>(),
      __numeric_detail::__multiplies<T>());
}

template <class InputIt, class T, class BinaryOperation,
          class UnaryOperation>
T transform_reduce(InputIt first, InputIt last, T init,
                   BinaryOperation reduce_operation,
                   UnaryOperation transform_operation) {
  for (; first != last; ++first) {
    init = reduce_operation(init, transform_operation(*first));
  }
  return init;
}

template <class InputIt, class OutputIt, class T, class BinaryOperation>
OutputIt exclusive_scan(InputIt first, InputIt last, OutputIt output, T init,
                        BinaryOperation operation) {
  for (; first != last; ++first, ++output) {
    T value = init;
    init = operation(init, *first);
    *output = value;
  }
  return output;
}

template <class InputIt, class OutputIt, class T>
OutputIt exclusive_scan(InputIt first, InputIt last, OutputIt output, T init) {
  return std::exclusive_scan(first, last, output, init,
                             __numeric_detail::__plus<T>());
}

template <class InputIt, class OutputIt, class BinaryOperation, class T>
OutputIt inclusive_scan(InputIt first, InputIt last, OutputIt output,
                        BinaryOperation operation, T init) {
  for (; first != last; ++first, ++output) {
    init = operation(init, *first);
    *output = init;
  }
  return output;
}

template <class InputIt, class OutputIt, class BinaryOperation>
OutputIt inclusive_scan(InputIt first, InputIt last, OutputIt output,
                        BinaryOperation operation) {
  if (first == last) {
    return output;
  }
  typename iterator_traits<InputIt>::value_type init = *first;
  *output = init;
  return std::inclusive_scan(++first, last, ++output, operation, init);
}

template <class InputIt, class OutputIt>
OutputIt inclusive_scan(InputIt first, InputIt last, OutputIt output) {
  typedef typename iterator_traits<InputIt>::value_type T;
  return std::inclusive_scan(first, last, output,
                             __numeric_detail::__plus<T>());
}

template <class InputIt, class OutputIt, class T, class BinaryOperation,
          class UnaryOperation>
OutputIt transform_exclusive_scan(InputIt first, InputIt last, OutputIt output,
                                  T init, BinaryOperation operation,
                                  UnaryOperation transform) {
  for (; first != last; ++first, ++output) {
    T value = init;
    init = operation(init, transform(*first));
    *output = value;
  }
  return output;
}

template <class InputIt, class OutputIt, class BinaryOperation,
          class UnaryOperation, class T>
OutputIt transform_inclusive_scan(InputIt first, InputIt last, OutputIt output,
                                  BinaryOperation operation,
                                  UnaryOperation transform, T init) {
  for (; first != last; ++first, ++output) {
    init = operation(init, transform(*first));
    *output = init;
  }
  return output;
}

template <class InputIt, class OutputIt, class BinaryOperation,
          class UnaryOperation>
OutputIt transform_inclusive_scan(InputIt first, InputIt last, OutputIt output,
                                  BinaryOperation operation,
                                  UnaryOperation transform) {
  if (first == last) {
    return output;
  }
  typedef typename iterator_traits<InputIt>::value_type Input;
  auto init = transform(static_cast<Input>(*first));
  *output = init;
  return std::transform_inclusive_scan(++first, last, ++output, operation,
                                       transform, init);
}

