#if __cplusplus >= 202002L

template <class T>
constexpr enable_if_t<is_integral<T>::value, T> midpoint(T a, T b) noexcept {
  typedef make_unsigned_t<T> U;
  if (a > b) {
    return static_cast<T>(a - static_cast<T>((U(a) - U(b)) / 2));
  }
  return static_cast<T>(a + static_cast<T>((U(b) - U(a)) / 2));
}

template <class T>
constexpr enable_if_t<is_floating_point<T>::value, T>
midpoint(T a, T b) noexcept {
  const T abs_a = a < T(0) ? -a : a;
  const T abs_b = b < T(0) ? -b : b;
  const T high = numeric_limits<T>::max() / T(2);
  const T low = numeric_limits<T>::min() * T(2);
  if (abs_a <= high && abs_b <= high) {
    return (a + b) / T(2);
  }
  if (abs_a < low) {
    return a + b / T(2);
  }
  if (abs_b < low) {
    return a / T(2) + b;
  }
  return a / T(2) + b / T(2);
}

template <class T>
constexpr T* midpoint(T* a, T* b) noexcept {
  return a + (b - a) / 2;
}

#endif

#if __cplusplus >= 202600L

template <class T, class U>
constexpr T saturate_cast(U value) noexcept {
  static_assert(is_integral<T>::value && is_integral<U>::value,
                "saturate_cast requires integral types");
  if constexpr (is_signed<U>::value) {
    long long signed_value = static_cast<long long>(value);
    if constexpr (is_signed<T>::value) {
      if (signed_value < static_cast<long long>(numeric_limits<T>::min()))
        return numeric_limits<T>::min();
      if (signed_value > static_cast<long long>(numeric_limits<T>::max()))
        return numeric_limits<T>::max();
    } else {
      if (signed_value < 0) return T(0);
      if (static_cast<unsigned long long>(signed_value) >
          static_cast<unsigned long long>(numeric_limits<T>::max()))
        return numeric_limits<T>::max();
    }
  } else {
    unsigned long long unsigned_value =
        static_cast<unsigned long long>(value);
    if (unsigned_value >
        static_cast<unsigned long long>(numeric_limits<T>::max()))
      return numeric_limits<T>::max();
  }
  return static_cast<T>(value);
}

#endif

