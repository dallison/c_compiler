namespace __variant_detail {

template <class T>
size_t __variant_hash_value(const T& value) {
  hash<T> hasher;
  return hasher(value);
}

}  // namespace __variant_detail

template <class... Types>
struct hash<variant<Types...>> {
  size_t operator()(const variant<Types...>& value) const {
    if (value.valueless_by_exception()) {
      return variant_npos;
    }
    size_t active = value.index();
    size_t payload = visit(
        [](const auto& item) {
          return __variant_detail::__variant_hash_value(item);
        },
        value);
    return payload ^ (active + static_cast<size_t>(0x9e3779b9UL) +
                      (payload << 6) + (payload >> 2));
  }
};

template <class... Types>
constexpr bool operator==(const variant<Types...>& left,
                          const variant<Types...>& right) {
  if (left.index() != right.index()) {
    return false;
  }
  if (left.valueless_by_exception()) {
    return true;
  }
  return left.__equals_same_index(right);
}

template <class... Types>
constexpr bool operator!=(const variant<Types...>& left,
                          const variant<Types...>& right) {
  return !(left == right);
}

template <class... Types>
constexpr bool operator<(const variant<Types...>& left,
                         const variant<Types...>& right) {
  if (right.valueless_by_exception()) {
    return false;
  }
  if (left.valueless_by_exception()) {
    return true;
  }
  if (left.index() != right.index()) {
    return left.index() < right.index();
  }
  return left.__less_same_index(right);
}

template <class... Types>
constexpr bool operator>(const variant<Types...>& left,
                         const variant<Types...>& right) {
  return right < left;
}

template <class... Types>
constexpr bool operator<=(const variant<Types...>& left,
                          const variant<Types...>& right) {
  return !(right < left);
}

template <class... Types>
constexpr bool operator>=(const variant<Types...>& left,
                          const variant<Types...>& right) {
  return !(left < right);
}

template <class... Types>
constexpr auto operator<=>(const variant<Types...>& left,
                           const variant<Types...>& right) {
  if (left.valueless_by_exception() && right.valueless_by_exception()) {
    return strong_ordering::equal;
  }
  if (left.valueless_by_exception()) {
    return strong_ordering::less;
  }
  if (right.valueless_by_exception()) {
    return strong_ordering::greater;
  }
  if (left.index() < right.index()) {
    return strong_ordering::less;
  }
  if (left.index() > right.index()) {
    return strong_ordering::greater;
  }
  return left.__compare_same_index(right);
}

