typename __type_at<Target - I, T, Rest...>::type* __ptr(
    __storage<I, T, Rest...>& storage) {
  if constexpr (Target == I) {
    return &storage.__value_;
  } else {
    return __ptr<Target>(storage.__rest_);
  }
}

