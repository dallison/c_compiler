struct monostate {
};

constexpr bool operator==(monostate, monostate) noexcept {
  return true;
}

constexpr bool operator!=(monostate, monostate) noexcept {
  return false;
}

constexpr bool operator<(monostate, monostate) noexcept {
  return false;
}

constexpr bool operator>(monostate, monostate) noexcept {
  return false;
}

constexpr bool operator<=(monostate, monostate) noexcept {
  return true;
}

constexpr bool operator>=(monostate, monostate) noexcept {
  return true;
}

constexpr strong_ordering operator<=>(monostate, monostate) noexcept {
  return strong_ordering::equal;
}

class bad_variant_access : public exception {
 public:
  bad_variant_access() noexcept {}

  const char* what() const noexcept override {
    return "bad variant access";
  }
};

constexpr size_t variant_npos = static_cast<size_t>(-1);

template <class T>
struct variant_size;

template <class... Types>
struct variant_size<variant<Types...> >
    : integral_constant<size_t, sizeof...(Types)> {
};

template <class T>
struct variant_size<const T> : variant_size<T> {
};

template <class T>
struct variant_size<volatile T> : variant_size<T> {
};

template <class T>
struct variant_size<const volatile T> : variant_size<T> {
};

template <class T>
constexpr size_t variant_size_v = variant_size<T>::value;

template <size_t I, class T>
struct variant_alternative;

namespace __variant_detail {

template <size_t I, class... Types>
struct __type_at;

template <class T, class... Rest>
struct __type_at<0, T, Rest...> {
  using type = T;
};

template <size_t I, class T, class... Rest>
struct __type_at<I, T, Rest...> {
  using type = typename __type_at<I - 1, Rest...>::type;
};

template <class T, class... Types>
struct __index_of;

template <class T, class... Rest>
struct __index_of<T, T, Rest...> : integral_constant<size_t, 0> {
};

template <class T, class First, class... Rest>
struct __index_of<T, First, Rest...>
    : integral_constant<size_t, 1 + __index_of<T, Rest...>::value> {
};

template <class T>
struct __index_of<T> {
};

template <size_t I, class... Types>
union __storage;

template <size_t I, class T>
union __storage<I, T> {
  char __dummy_;
  T __value_;

  __storage() : __dummy_(0) {}
  ~__storage() {}

  template <size_t Target>
  typename __type_at<Target - I, T>::type* __ptr() {
    return &__value_;
  }

  template <size_t Target>
  const typename __type_at<Target - I, T>::type* __ptr() const {
    return &__value_;
  }

  template <size_t Target, class... Args>
  void __construct(Args&&... args) {
    new (this->template __ptr<Target>())
        typename __type_at<Target - I, T>::type(std::forward<Args>(args)...);
  }

  template <size_t Target, class U, class... Args>
  void __construct_list(initializer_list<U> init, Args&&... args) {
    new (this->template __ptr<Target>())
        typename __type_at<Target - I, T>::type(
            init, std::forward<Args>(args)...);
  }

  void __destroy(size_t index) {
    if (index == I) {
      __value_.~T();
    }
  }

  void __copy_construct(const __storage& other, size_t index) {
    if (index == I) {
      new (&__value_) T(other.__value_);
    }
  }

  void __move_construct(__storage& other, size_t index) {
    if (index == I) {
      new (&__value_) T(std::move(other.__value_));
    }
  }

  void __copy_assign(const __storage& other, size_t index) {
    if (index == I) {
      __value_ = other.__value_;
    }
  }

  void __move_assign(__storage& other, size_t index) {
    if (index == I) {
      __value_ = std::move(other.__value_);
    }
  }

  void __swap_same(__storage& other, size_t index) {
    if (index == I) {
      std::swap(__value_, other.__value_);
    }
  }

  bool __equals(const __storage& other, size_t index) const {
    return index == I && __value_ == other.__value_;
  }

  bool __less(const __storage& other, size_t index) const {
    return index == I && __value_ < other.__value_;
  }

  auto __compare(const __storage& other, size_t index) const {
    if (index == I) {
      return __value_ <=> other.__value_;
    }
    return strong_ordering::equal;
  }

  template <class Visitor>
  auto __visit(Visitor&& vis, size_t index) {
    return vis(__value_);
  }

  template <class Visitor>
  auto __visit(Visitor&& vis, size_t index) const {
    return vis(__value_);
  }

};

template <size_t I, class T, class... Rest>
union __storage<I, T, Rest...> {
  char __dummy_;
  T __value_;
  __storage<I + 1, Rest...> __rest_;

  __storage() : __dummy_(0) {}
  ~__storage() {}

  template <size_t Target>
  typename __type_at<Target - I, T, Rest...>::type* __ptr() {
    if constexpr (Target == I) {
      return &__value_;
    } else {
      return __rest_.template __ptr<Target>();
    }
  }

  template <size_t Target>
  const typename __type_at<Target - I, T, Rest...>::type* __ptr() const {
    if constexpr (Target == I) {
      return &__value_;
    } else {
      return __rest_.template __ptr<Target>();
    }
  }

  template <size_t Target, class... Args>
  void __construct(Args&&... args) {
    new (this->template __ptr<Target>())
        typename __type_at<Target - I, T, Rest...>::type(
            std::forward<Args>(args)...);
  }

  template <size_t Target, class U, class... Args>
  void __construct_list(initializer_list<U> init, Args&&... args) {
    new (this->template __ptr<Target>())
        typename __type_at<Target - I, T, Rest...>::type(
            init, std::forward<Args>(args)...);
  }

  void __destroy(size_t index) {
    if (index == I) {
      __value_.~T();
    } else {
      __rest_.__destroy(index);
    }
  }

  void __copy_construct(const __storage& other, size_t index) {
    if (index == I) {
      new (&__value_) T(other.__value_);
    } else {
      __rest_.__copy_construct(other.__rest_, index);
    }
  }

  void __move_construct(__storage& other, size_t index) {
    if (index == I) {
      new (&__value_) T(std::move(other.__value_));
    } else {
      __rest_.__move_construct(other.__rest_, index);
    }
  }

  void __copy_assign(const __storage& other, size_t index) {
    if (index == I) {
      __value_ = other.__value_;
    } else {
      __rest_.__copy_assign(other.__rest_, index);
    }
  }

  void __move_assign(__storage& other, size_t index) {
    if (index == I) {
      __value_ = std::move(other.__value_);
    } else {
      __rest_.__move_assign(other.__rest_, index);
    }
  }

  void __swap_same(__storage& other, size_t index) {
    if (index == I) {
      std::swap(__value_, other.__value_);
    } else {
      __rest_.__swap_same(other.__rest_, index);
    }
  }

  bool __equals(const __storage& other, size_t index) const {
    if (index == I) {
      return __value_ == other.__value_;
    }
    return __rest_.__equals(other.__rest_, index);
  }

  bool __less(const __storage& other, size_t index) const {
    if (index == I) {
      return __value_ < other.__value_;
    }
    return __rest_.__less(other.__rest_, index);
  }

  auto __compare(const __storage& other, size_t index) const {
    if (index == I) {
      return __value_ <=> other.__value_;
    }
    return __rest_.__compare(other.__rest_, index);
  }

  template <class Visitor>
  auto __visit(Visitor&& vis, size_t index) {
    if (index == I) {
      return vis(__value_);
    }
    return __rest_.__visit(vis, index);
  }

  template <class Visitor>
  auto __visit(Visitor&& vis, size_t index) const {
    if (index == I) {
      return vis(__value_);
    }
    return __rest_.__visit(vis, index);
  }

};

