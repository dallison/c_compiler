template <size_t I, class... Types>
struct variant_alternative<I, variant<Types...>> {
  using type = typename __variant_detail::__type_at<I, Types...>::type;
};

template <size_t I, class... Types>
struct variant_alternative<I, const variant<Types...>> {
  using type = typename __variant_detail::__type_at<I, const Types...>::type;
};

template <size_t I, class... Types>
struct variant_alternative<I, volatile variant<Types...>> {
  using type = typename __variant_detail::__type_at<I, volatile Types...>::type;
};

template <size_t I, class... Types>
struct variant_alternative<I, const volatile variant<Types...>> {
  using type =
      typename __variant_detail::__type_at<I, const volatile Types...>::type;
};

template <size_t I, class T>
using variant_alternative_t = typename variant_alternative<I, T>::type;

template <class... Types>
class variant {
  static_assert(sizeof...(Types) > 0,
                "variant must contain at least one alternative");

  __variant_detail::__storage<0, Types...> __storage_;
  size_t __index_;

  template <size_t I, class... Args>
  constexpr void __construct(Args&&... args) {
    __storage_.template __construct<I>(std::forward<Args>(args)...);
    __index_ = I;
  }

  template <size_t I, class U, class... Args>
  constexpr void __construct_list(initializer_list<U> init, Args&&... args) {
    __storage_.template __construct_list<I>(
        init, std::forward<Args>(args)...);
    __index_ = I;
  }

 public:
  constexpr variant() : __index_(variant_npos) {
    this->template __construct<0>();
  }

  constexpr variant(const variant& other) : __index_(variant_npos) {
    if (!other.valueless_by_exception()) {
      __storage_.__copy_construct(other.__storage_, other.__index_);
      __index_ = other.__index_;
    }
  }

  constexpr variant(variant&& other) : __index_(variant_npos) {
    if (!other.valueless_by_exception()) {
      __storage_.__move_construct(other.__storage_, other.__index_);
      __index_ = other.__index_;
    }
  }

  template <class T,
            enable_if_t<__variant_detail::__converting_candidate<
                            T, Types...>::value,
                        int> = 0>
  constexpr variant(T&& value) : __index_(variant_npos) {
    this->template __construct<
        __variant_detail::__index_of<decay_t<T>, Types...>::value>(
        std::forward<T>(value));
  }

  template <size_t I, class... Args>
  constexpr explicit variant(in_place_index_t<I>, Args&&... args)
      : __index_(variant_npos) {
    this->template __construct<I>(std::forward<Args>(args)...);
    __index_ = I;
  }

  template <size_t I, class U, class... Args>
  constexpr explicit variant(in_place_index_t<I>, initializer_list<U> init,
                             Args&&... args)
      : __index_(variant_npos) {
    this->template __construct_list<I>(init, std::forward<Args>(args)...);
    __index_ = I;
  }

  template <class T, class... Args>
  constexpr explicit variant(in_place_type_t<T>, Args&&... args)
      : __index_(variant_npos) {
    static_assert(__variant_detail::__exactly_once<T, Types...>::value,
                  "variant type alternative must appear exactly once");
    this->template __construct<__variant_detail::__index_of<T, Types...>::value>(
        std::forward<Args>(args)...);
    __index_ = __variant_detail::__index_of<T, Types...>::value;
  }

  template <class T, class U, class... Args>
  constexpr explicit variant(in_place_type_t<T>, initializer_list<U> init,
                             Args&&... args)
      : __index_(variant_npos) {
    static_assert(__variant_detail::__exactly_once<T, Types...>::value,
                  "variant type alternative must appear exactly once");
    this->template __construct_list<
        __variant_detail::__index_of<T, Types...>::value>(
        init, std::forward<Args>(args)...);
    __index_ = __variant_detail::__index_of<T, Types...>::value;
  }

  constexpr ~variant() {
    if (!valueless_by_exception()) {
      __storage_.__destroy(__index_);
    }
  }

  constexpr variant& operator=(const variant& other) {
    if (this == &other) {
      return *this;
    }
    if (other.valueless_by_exception()) {
      if (!valueless_by_exception()) {
        __storage_.__destroy(__index_);
        __index_ = variant_npos;
      }
      return *this;
    }
    if (__index_ == other.__index_) {
      __storage_.__copy_assign(other.__storage_, __index_);
    } else {
      if (!valueless_by_exception()) {
        __storage_.__destroy(__index_);
        __index_ = variant_npos;
      }
      __storage_.__copy_construct(other.__storage_, other.__index_);
      __index_ = other.__index_;
    }
    return *this;
  }

  constexpr variant& operator=(variant&& other) {
    if (this == &other) {
      return *this;
    }
    if (other.valueless_by_exception()) {
      if (!valueless_by_exception()) {
        __storage_.__destroy(__index_);
        __index_ = variant_npos;
      }
      return *this;
    }
    if (__index_ == other.__index_) {
      __storage_.__move_assign(other.__storage_, __index_);
    } else {
      if (!valueless_by_exception()) {
        __storage_.__destroy(__index_);
        __index_ = variant_npos;
      }
      __storage_.__move_construct(other.__storage_, other.__index_);
      __index_ = other.__index_;
    }
    return *this;
  }

  template <class T,
            enable_if_t<__variant_detail::__converting_candidate<
                            T, Types...>::value,
                        int> = 0>
  constexpr variant& operator=(T&& value) {
    if (__index_ ==
        __variant_detail::__index_of<decay_t<T>, Types...>::value) {
      *__storage_.template __ptr<
          __variant_detail::__index_of<decay_t<T>, Types...>::value>() =
          std::forward<T>(value);
    } else {
      this->template emplace<
          __variant_detail::__index_of<decay_t<T>, Types...>::value>(
          std::forward<T>(value));
    }
    return *this;
  }

  constexpr size_t index() const noexcept {
    return __index_;
  }

  constexpr bool valueless_by_exception() const noexcept {
    return __index_ == variant_npos;
  }

  template <size_t I, class... Args>
  constexpr variant_alternative_t<I, variant>& emplace(Args&&... args) {
    if (!valueless_by_exception()) {
      __storage_.__destroy(__index_);
      __index_ = variant_npos;
    }
    this->template __construct<I>(std::forward<Args>(args)...);
    return *__storage_.template __ptr<I>();
  }

  template <size_t I, class U, class... Args>
  constexpr variant_alternative_t<I, variant>& emplace(
      initializer_list<U> init, Args&&... args) {
    if (!valueless_by_exception()) {
      __storage_.__destroy(__index_);
      __index_ = variant_npos;
    }
    this->template __construct_list<I>(init, std::forward<Args>(args)...);
    return *__storage_.template __ptr<I>();
  }

  template <class T, class... Args>
  constexpr T& emplace(Args&&... args) {
    static_assert(__variant_detail::__exactly_once<T, Types...>::value,
                  "variant type alternative must appear exactly once");
    return this->template emplace<
        __variant_detail::__index_of<T, Types...>::value>(
        std::forward<Args>(args)...);
  }

  template <class T, class U, class... Args>
  constexpr T& emplace(initializer_list<U> init, Args&&... args) {
    static_assert(__variant_detail::__exactly_once<T, Types...>::value,
                  "variant type alternative must appear exactly once");
    return this->template emplace<
        __variant_detail::__index_of<T, Types...>::value>(
        init, std::forward<Args>(args)...);
  }

  void swap(variant& other) {
    if (this == &other) {
      return;
    }
    if (valueless_by_exception() && other.valueless_by_exception()) {
      return;
    }
    if (__index_ == other.__index_) {
      __storage_.__swap_same(other.__storage_, __index_);
      return;
    }
    variant tmp(std::move(other));
    other = std::move(*this);
    *this = std::move(tmp);
  }

  template <size_t I>
  constexpr variant_alternative_t<I, variant>* __get_if_index() noexcept {
    if (__index_ != I) {
      return nullptr;
    }
    return __storage_.template __ptr<I>();
  }

  template <size_t I>
  constexpr const variant_alternative_t<I, variant>* __get_if_index()
      const noexcept {
    if (__index_ != I) {
      return nullptr;
    }
    return __storage_.template __ptr<I>();
  }

  constexpr bool __equals_same_index(const variant& other) const {
    return __storage_.__equals(other.__storage_, __index_);
  }

  constexpr bool __less_same_index(const variant& other) const {
    return __storage_.__less(other.__storage_, __index_);
  }

  constexpr auto __compare_same_index(const variant& other) const {
    return __storage_.__compare(other.__storage_, __index_);
  }

  template <class Visitor>
  auto __visit_impl(Visitor&& vis) {
    return __storage_.__visit(vis, __index_);
  }

  template <class Visitor>
  auto __visit_impl(Visitor&& vis) const {
    return __storage_.__visit(vis, __index_);
  }

  template <class Visitor>
  auto __visit_impl_move(Visitor&& vis) {
    return __storage_.__visit_move(vis, __index_);
  }

  template <class Visitor>
  auto __visit_impl_const_move(Visitor&& vis) const {
    return __storage_.__visit_const_move(vis, __index_);
  }

};

