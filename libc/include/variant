namespace __variant_detail {

template <size_t I, class... Types>
struct __type_at;

template <class T, class... Rest>
struct __type_at<0, T, Rest...> {
  using type = T;
};

template <size_t I, class T, class... Rest>
struct __type_at<I, T, Rest...> {
  using type = typename __type_at<I - 1, Rest...>::type;
};

template <class T, class... Types>
struct __index_of;

template <class T, class... Rest>
struct __index_of<T, T, Rest...> : integral_constant<size_t, 0> {
};

template <class T, class First, class... Rest>
struct __index_of<T, First, Rest...>
    : integral_constant<size_t, 1 + __index_of<T, Rest...>::value> {
};

template <class T>
struct __index_of<T> {
};

template <class T, class... Types>
struct __count_of;

template <class T>
struct __count_of<T> : integral_constant<size_t, 0> {
};

template <class T, class First, class... Rest>
struct __count_of<T, First, Rest...>
    : integral_constant<size_t,
                        (is_same<T, First>::value ? 1 : 0) +
                            __count_of<T, Rest...>::value> {
};

template <class T, class... Types>
struct __exactly_once
    : bool_constant<__count_of<T, Types...>::value == 1> {
};

template <class T>
struct __is_variant : false_type {
};

template <class... Types>
struct __is_variant<variant<Types...>> : true_type {
};

template <class T>
struct __is_in_place_type : false_type {
};

template <class T>
struct __is_in_place_type<in_place_type_t<T>> : true_type {
};

template <class T>
struct __is_in_place_index : false_type {
};

template <size_t I>
struct __is_in_place_index<in_place_index_t<I>> : true_type {
};

template <class T, class... Types>
struct __converting_candidate
    : bool_constant<
          __exactly_once<decay_t<T>, Types...>::value &&
          !__is_variant<remove_cvref_t<T>>::value &&
          !__is_in_place_type<remove_cvref_t<T>>::value &&
          !__is_in_place_index<remove_cvref_t<T>>::value> {
};

template <size_t I, class... Types>
union __storage;

template <size_t I, class T>
union __storage<I, T> {
  char __dummy_;
  T __value_;

  constexpr __storage() : __dummy_(0) {}
  constexpr ~__storage() {}

  template <size_t Target>
  constexpr typename __type_at<Target - I, T>::type* __ptr() {
    return &__value_;
  }

  template <size_t Target>
  constexpr const typename __type_at<Target - I, T>::type* __ptr() const {
    return &__value_;
  }

  template <size_t Target, class... Args>
  constexpr void __construct(Args&&... args) {
    new (this->template __ptr<Target>())
        typename __type_at<Target - I, T>::type(std::forward<Args>(args)...);
  }

  template <size_t Target, class U, class... Args>
  constexpr void __construct_list(initializer_list<U> init, Args&&... args) {
    new (this->template __ptr<Target>())
        typename __type_at<Target - I, T>::type(
            init, std::forward<Args>(args)...);
  }

  constexpr void __destroy(size_t index) {
    if (index == I) {
      __value_.~T();
    }
  }

  constexpr void __copy_construct(const __storage& other, size_t index) {
    if (index == I) {
      new (&__value_) T(other.__value_);
    }
  }

  constexpr void __move_construct(__storage& other, size_t index) {
    if (index == I) {
      new (&__value_) T(std::move(other.__value_));
    }
  }

  constexpr void __copy_assign(const __storage& other, size_t index) {
    if (index == I) {
      __value_ = other.__value_;
    }
  }

  constexpr void __move_assign(__storage& other, size_t index) {
    if (index == I) {
      __value_ = std::move(other.__value_);
    }
  }

  void __swap_same(__storage& other, size_t index) {
    if (index == I) {
      std::swap(__value_, other.__value_);
    }
  }

  constexpr bool __equals(const __storage& other, size_t index) const {
    return index == I && __value_ == other.__value_;
  }

  constexpr bool __less(const __storage& other, size_t index) const {
    return index == I && __value_ < other.__value_;
  }

  constexpr auto __compare(const __storage& other, size_t index) const {
    if (index == I) {
      return __value_ <=> other.__value_;
    }
    return strong_ordering::equal;
  }

  template <class Visitor>
  auto __visit(Visitor&& vis, size_t index) {
    return vis(__value_);
  }

  template <class Visitor>
  auto __visit(Visitor&& vis, size_t index) const {
    return vis(__value_);
  }

  template <class Visitor>
  auto __visit_move(Visitor&& vis, size_t index) {
    return vis(std::move(__value_));
  }

  template <class Visitor>
  auto __visit_const_move(Visitor&& vis, size_t index) const {
    return vis(std::move(__value_));
  }

};

template <size_t I, class T, class... Rest>
union __storage<I, T, Rest...> {
  char __dummy_;
  T __value_;
  __storage<I + 1, Rest...> __rest_;

  constexpr __storage() : __dummy_(0) {}
  constexpr ~__storage() {}

  template <size_t Target>
  constexpr typename __type_at<Target - I, T, Rest...>::type* __ptr() {
    if constexpr (Target == I) {
      return &__value_;
    } else {
      return __rest_.template __ptr<Target>();
    }
  }

  template <size_t Target>
  constexpr const typename __type_at<Target - I, T, Rest...>::type* __ptr()
      const {
    if constexpr (Target == I) {
      return &__value_;
    } else {
      return __rest_.template __ptr<Target>();
    }
  }

  template <size_t Target, class... Args>
  constexpr void __construct(Args&&... args) {
    new (this->template __ptr<Target>())
        typename __type_at<Target - I, T, Rest...>::type(
            std::forward<Args>(args)...);
  }

  template <size_t Target, class U, class... Args>
  constexpr void __construct_list(initializer_list<U> init, Args&&... args) {
    new (this->template __ptr<Target>())
        typename __type_at<Target - I, T, Rest...>::type(
            init, std::forward<Args>(args)...);
  }

  constexpr void __destroy(size_t index) {
    if (index == I) {
      __value_.~T();
    } else {
      __rest_.__destroy(index);
    }
  }

  constexpr void __copy_construct(const __storage& other, size_t index) {
    if (index == I) {
      new (&__value_) T(other.__value_);
    } else {
      __rest_.__copy_construct(other.__rest_, index);
    }
  }

  constexpr void __move_construct(__storage& other, size_t index) {
    if (index == I) {
      new (&__value_) T(std::move(other.__value_));
    } else {
      __rest_.__move_construct(other.__rest_, index);
    }
  }

  constexpr void __copy_assign(const __storage& other, size_t index) {
    if (index == I) {
      __value_ = other.__value_;
    } else {
      __rest_.__copy_assign(other.__rest_, index);
    }
  }

  constexpr void __move_assign(__storage& other, size_t index) {
    if (index == I) {
      __value_ = std::move(other.__value_);
    } else {
      __rest_.__move_assign(other.__rest_, index);
    }
  }

  void __swap_same(__storage& other, size_t index) {
    if (index == I) {
      std::swap(__value_, other.__value_);
    } else {
      __rest_.__swap_same(other.__rest_, index);
    }
  }

  constexpr bool __equals(const __storage& other, size_t index) const {
    if (index == I) {
      return __value_ == other.__value_;
    }
    return __rest_.__equals(other.__rest_, index);
  }

  constexpr bool __less(const __storage& other, size_t index) const {
    if (index == I) {
      return __value_ < other.__value_;
    }
    return __rest_.__less(other.__rest_, index);
  }

  constexpr auto __compare(const __storage& other, size_t index) const {
    if (index == I) {
      return __value_ <=> other.__value_;
    }
    return __rest_.__compare(other.__rest_, index);
  }

  template <class Visitor>
  auto __visit(Visitor&& vis, size_t index) {
    if (index == I) {
      return vis(__value_);
    }
    return __rest_.__visit(vis, index);
  }

  template <class Visitor>
  auto __visit(Visitor&& vis, size_t index) const {
    if (index == I) {
      return vis(__value_);
    }
    return __rest_.__visit(vis, index);
  }

  template <class Visitor>
  auto __visit_move(Visitor&& vis, size_t index) {
    if (index == I) {
      return vis(std::move(__value_));
    }
    return __rest_.__visit_move(vis, index);
  }

  template <class Visitor>
  auto __visit_const_move(Visitor&& vis, size_t index) const {
    if (index == I) {
      return vis(std::move(__value_));
    }
    return __rest_.__visit_const_move(vis, index);
  }

};

template <size_t Target, size_t I, class T>
typename __type_at<Target - I, T>::type* __ptr(__storage<I, T>& storage) {
  return &storage.__value_;
}

template <size_t Target, size_t I, class T>
const typename __type_at<Target - I, T>::type* __ptr(
    const __storage<I, T>& storage) {
  return &storage.__value_;
}

template <size_t Target, size_t I, class T, class... Rest>
typename __type_at<Target - I, T, Rest...>::type* __ptr(
    __storage<I, T, Rest...>& storage) {
  if constexpr (Target == I) {
    return &storage.__value_;
  } else {
    return __ptr<Target>(storage.__rest_);
  }
}

template <size_t Target, size_t I, class T, class... Rest>
const typename __type_at<Target - I, T, Rest...>::type* __ptr(
    const __storage<I, T, Rest...>& storage) {
  if constexpr (Target == I) {
    return &storage.__value_;
  } else {
    return __ptr<Target>(storage.__rest_);
