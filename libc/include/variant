template <size_t I, class... Types>
struct variant_alternative<I, variant<Types...> > {
  using type = typename __variant_detail::__type_at<I, Types...>::type;
};

template <size_t I, class T>
struct variant_alternative<I, const T> {
  using type = const typename variant_alternative<I, T>::type;
};

template <size_t I, class T>
struct variant_alternative<I, volatile T> {
  using type = volatile typename variant_alternative<I, T>::type;
};

template <size_t I, class T>
struct variant_alternative<I, const volatile T> {
  using type = const volatile typename variant_alternative<I, T>::type;
};

template <size_t I, class T>
using variant_alternative_t = typename variant_alternative<I, T>::type;

template <class... Types>
class variant {
  static_assert(sizeof...(Types) > 0,
                "variant must contain at least one alternative");

  __variant_detail::__storage<0, Types...> __storage_;
  size_t __index_;

  template <size_t I, class... Args>
  void __construct(Args&&... args) {
    __storage_.template __construct<I>(std::forward<Args>(args)...);
    __index_ = I;
  }

  template <size_t I, class U, class... Args>
  void __construct_list(initializer_list<U> init, Args&&... args) {
    __storage_.template __construct_list<I>(
        init, std::forward<Args>(args)...);
    __index_ = I;
  }

 public:
  variant() : __index_(variant_npos) {
    this->template __construct<0>();
  }

  variant(const variant& other) : __index_(variant_npos) {
    if (!other.valueless_by_exception()) {
      __storage_.__copy_construct(other.__storage_, other.__index_);
      __index_ = other.__index_;
    }
  }

  variant(variant&& other) : __index_(variant_npos) {
    if (!other.valueless_by_exception()) {
      __storage_.__move_construct(other.__storage_, other.__index_);
      __index_ = other.__index_;
    }
  }

  template <class T>
  variant(T&& value) : __index_(variant_npos) {
    this->template __construct<
        __variant_detail::__index_of<decay_t<T>, Types...>::value>(
        std::forward<T>(value));
  }

  template <size_t I, class... Args>
  explicit variant(in_place_index_t<I>, Args&&... args)
      : __index_(variant_npos) {
    this->template __construct<I>(std::forward<Args>(args)...);
  }

  template <size_t I, class U, class... Args>
  explicit variant(in_place_index_t<I>, initializer_list<U> init,
                   Args&&... args)
      : __index_(variant_npos) {
    this->template __construct_list<I>(init, std::forward<Args>(args)...);
  }

  template <class T, class... Args>
  explicit variant(in_place_type_t<T>, Args&&... args)
      : __index_(variant_npos) {
    this->template __construct<__variant_detail::__index_of<T, Types...>::value>(
        std::forward<Args>(args)...);
  }

  template <class T, class U, class... Args>
  explicit variant(in_place_type_t<T>, initializer_list<U> init,
                   Args&&... args)
      : __index_(variant_npos) {
    this->template __construct_list<
        __variant_detail::__index_of<T, Types...>::value>(
        init, std::forward<Args>(args)...);
  }

  ~variant() {
    if (!valueless_by_exception()) {
      __storage_.__destroy(__index_);
    }
  }

  variant& operator=(const variant& other) {
    if (this == &other) {
      return *this;
    }
    if (other.valueless_by_exception()) {
      if (!valueless_by_exception()) {
        __storage_.__destroy(__index_);
        __index_ = variant_npos;
      }
      return *this;
    }
    if (__index_ == other.__index_) {
      __storage_.__copy_assign(other.__storage_, __index_);
    } else {
      if (!valueless_by_exception()) {
        __storage_.__destroy(__index_);
      }
      __storage_.__copy_construct(other.__storage_, other.__index_);
      __index_ = other.__index_;
    }
    return *this;
  }

  variant& operator=(variant&& other) {
    if (this == &other) {
      return *this;
    }
    if (other.valueless_by_exception()) {
      if (!valueless_by_exception()) {
        __storage_.__destroy(__index_);
        __index_ = variant_npos;
      }
      return *this;
    }
    if (__index_ == other.__index_) {
      __storage_.__move_assign(other.__storage_, __index_);
    } else {
      if (!valueless_by_exception()) {
        __storage_.__destroy(__index_);
      }
      __storage_.__move_construct(other.__storage_, other.__index_);
      __index_ = other.__index_;
    }
    return *this;
  }

  template <class T>
  variant& operator=(T&& value) {
    if (__index_ ==
        __variant_detail::__index_of<decay_t<T>, Types...>::value) {
      *__storage_.template __ptr<
          __variant_detail::__index_of<decay_t<T>, Types...>::value>() =
          std::forward<T>(value);
    } else {
      this->template emplace<
          __variant_detail::__index_of<decay_t<T>, Types...>::value>(
          std::forward<T>(value));
    }
    return *this;
  }

  size_t index() const noexcept {
    return __index_;
  }

  bool valueless_by_exception() const noexcept {
    return __index_ == variant_npos;
  }

  template <size_t I, class... Args>
  variant_alternative_t<I, variant>& emplace(Args&&... args) {
    if (!valueless_by_exception()) {
      __storage_.__destroy(__index_);
      __index_ = variant_npos;
    }
    this->template __construct<I>(std::forward<Args>(args)...);
    return *__storage_.template __ptr<I>();
  }

  template <size_t I, class U, class... Args>
  variant_alternative_t<I, variant>& emplace(initializer_list<U> init,
                                            Args&&... args) {
    if (!valueless_by_exception()) {
      __storage_.__destroy(__index_);
      __index_ = variant_npos;
    }
    this->template __construct_list<I>(init, std::forward<Args>(args)...);
    return *__storage_.template __ptr<I>();
  }

  template <class T, class... Args>
  T& emplace(Args&&... args) {
    return this->template emplace<
        __variant_detail::__index_of<T, Types...>::value>(
        std::forward<Args>(args)...);
  }

  template <class T, class U, class... Args>
  T& emplace(initializer_list<U> init, Args&&... args) {
    return this->template emplace<
        __variant_detail::__index_of<T, Types...>::value>(
        init, std::forward<Args>(args)...);
  }

  void swap(variant& other) {
    if (this == &other) {
      return;
    }
    if (valueless_by_exception() && other.valueless_by_exception()) {
      return;
    }
    if (__index_ == other.__index_) {
      __storage_.__swap_same(other.__storage_, __index_);
      return;
    }
    variant tmp(std::move(other));
    other = std::move(*this);
    *this = std::move(tmp);
  }

  template <size_t I>
  variant_alternative_t<I, variant>* __get_if_index() noexcept {
    if (__index_ != I) {
      return nullptr;
    }
    return __storage_.template __ptr<I>();
  }

  template <size_t I>
  const variant_alternative_t<I, variant>* __get_if_index() const noexcept {
    if (__index_ != I) {
      return nullptr;
    }
    return __storage_.template __ptr<I>();
  }

  bool __equals_same_index(const variant& other) const {
    return __storage_.__equals(other.__storage_, __index_);
  }

  bool __less_same_index(const variant& other) const {
    return __storage_.__less(other.__storage_, __index_);
  }

  auto __compare_same_index(const variant& other) const {
    return __storage_.__compare(other.__storage_, __index_);
  }

  template <class Visitor>
  auto __visit_impl(Visitor&& vis) {
    return __storage_.__visit(vis, __index_);
  }

  template <class Visitor>
  auto __visit_impl(Visitor&& vis) const {
    return __storage_.__visit(vis, __index_);
  }
};

template <class T, class... Types>
bool holds_alternative(const variant<Types...>& value) noexcept {
  return value.index() == __variant_detail::__index_of<T, Types...>::value;
}

template <size_t I, class... Types>
variant_alternative_t<I, variant<Types...> >& get(variant<Types...>& value) {
  if (value.index() != I) {
    throw bad_variant_access();
  }
  return *value.template __get_if_index<I>();
}

template <size_t I, class... Types>
const variant_alternative_t<I, variant<Types...> >& get(
    const variant<Types...>& value) {
  if (value.index() != I) {
    throw bad_variant_access();
  }
  return *value.template __get_if_index<I>();
}

template <size_t I, class... Types>
variant_alternative_t<I, variant<Types...> >&& get(variant<Types...>&& value) {
  if (value.index() != I) {
    throw bad_variant_access();
  }
  return std::move(*value.template __get_if_index<I>());
}

template <size_t I, class... Types>
const variant_alternative_t<I, variant<Types...> >&& get(
    const variant<Types...>&& value) {
  if (value.index() != I) {
    throw bad_variant_access();
  }
  return std::move(*value.template __get_if_index<I>());
}

template <class T, class... Types>
T& get(variant<Types...>& value) {
  return get<__variant_detail::__index_of<T, Types...>::value>(value);
}

template <class T, class... Types>
const T& get(const variant<Types...>& value) {
  return get<__variant_detail::__index_of<T, Types...>::value>(value);
}

template <class T, class... Types>
T&& get(variant<Types...>&& value) {
  return get<__variant_detail::__index_of<T, Types...>::value>(
      std::move(value));
}

template <class T, class... Types>
const T&& get(const variant<Types...>&& value) {
  return get<__variant_detail::__index_of<T, Types...>::value>(
      std::move(value));
}

template <size_t I, class... Types>
variant_alternative_t<I, variant<Types...> >* get_if(
    variant<Types...>* value) noexcept {
  if (value == nullptr) {
    return nullptr;
  }
  return value->template __get_if_index<I>();
}

template <size_t I, class... Types>
const variant_alternative_t<I, variant<Types...> >* get_if(
    const variant<Types...>* value) noexcept {
  if (value == nullptr) {
