//
//  typeinfo
//  c_compiler
//
//  Minimal C++ RTTI support header for DaveCC.
//
//  LP64 targets use the Itanium polymorphic std::type_info layout (virtual
//  destructor + __type_name).  Legacy targets keep the older flat layout.
//

#ifndef typeinfo_h
#define typeinfo_h

#include <exception>

#if __cplusplus >= 201103L
#define __DAVECC_TYPEINFO_CONSTEXPR constexpr
#define __DAVECC_TYPEINFO_NOEXCEPT noexcept
#define __DAVECC_TYPEINFO_OVERRIDE override
#else
#define __DAVECC_TYPEINFO_CONSTEXPR
#define __DAVECC_TYPEINFO_NOEXCEPT
#define __DAVECC_TYPEINFO_OVERRIDE
#endif

namespace std {

#if defined(__DAVECC_LEGACY_RTTI__)

class type_info {
 private:
  const char* __name;
  const void* __bases;
  long __base_count;

  type_info(const type_info&);
  type_info& operator=(const type_info&);

 public:
  const char* name() const { return __name; }

  bool operator==(const type_info& other) const { return this == &other; }
  bool operator!=(const type_info& other) const { return this != &other; }

  bool before(const type_info& other) const { return this < &other; }
#if __cplusplus >= 201103L
  unsigned long hash_code() const {
    return reinterpret_cast<unsigned long>(this);
  }
#endif
};

#else

class type_info {
 public:
  virtual ~type_info() {}
  const char* name() const { return __type_name; }

  bool operator==(const type_info& other) const { return this == &other; }
  bool operator!=(const type_info& other) const { return this != &other; }

  bool before(const type_info& other) const { return this < &other; }
#if __cplusplus >= 201103L
  unsigned long hash_code() const {
    return reinterpret_cast<unsigned long>(this);
  }
#endif

 private:
  type_info(const type_info&);
  type_info& operator=(const type_info&);
  const char* __type_name;
};

#endif

class bad_cast : public exception {
 public:
  __DAVECC_TYPEINFO_CONSTEXPR bad_cast() __DAVECC_TYPEINFO_NOEXCEPT {}
  __DAVECC_TYPEINFO_CONSTEXPR const char* what() const
      __DAVECC_TYPEINFO_NOEXCEPT __DAVECC_TYPEINFO_OVERRIDE {
    return "std::bad_cast";
  }
};

class bad_typeid : public exception {
 public:
  __DAVECC_TYPEINFO_CONSTEXPR bad_typeid() __DAVECC_TYPEINFO_NOEXCEPT {}
  __DAVECC_TYPEINFO_CONSTEXPR const char* what() const
      __DAVECC_TYPEINFO_NOEXCEPT __DAVECC_TYPEINFO_OVERRIDE {
    return "std::bad_typeid";
  }
};

}  // namespace std

#undef __DAVECC_TYPEINFO_CONSTEXPR
#undef __DAVECC_TYPEINFO_NOEXCEPT
#undef __DAVECC_TYPEINFO_OVERRIDE

#endif /* typeinfo_h */
