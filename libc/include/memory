#if defined(__6502__) || defined(__W65C02__)

struct __count {
  unsigned int __value;

  explicit __count(unsigned int value) noexcept : __value(value) {
  }

  void __add() noexcept {
    ++__value;
  }

  bool __release() noexcept {
    return --__value == 0;
  }

  unsigned int __load() const noexcept {
    return __value;
  }

  bool __try_add() noexcept {
    if (__value == 0) {
      return false;
    }
    ++__value;
    return true;
  }
};

#else

struct __count {
  atomic<unsigned int> __value;

  explicit __count(unsigned int value) noexcept : __value(value) {
  }

  void __add() noexcept {
    __value.fetch_add(1, memory_order_relaxed);
  }

  bool __release() noexcept {
    return __value.fetch_sub(1, memory_order_acq_rel) == 1;
  }

  unsigned int __load() const noexcept {
    return __value.load(memory_order_acquire);
  }

  bool __try_add() noexcept {
    unsigned int value = __value.load(memory_order_acquire);
    while (value != 0) {
      if (__value.compare_exchange_weak(value, value + 1,
                                        memory_order_acquire,
                                        memory_order_relaxed)) {
        return true;
      }
    }
    return false;
  }
};

#endif

template <class T>
struct __type_token {
  static const char __value;
};

template <class T>
const char __type_token<T>::__value = 0;

struct __control_block {
  __count __shared_owners;
  __count __weak_owners;

  __control_block() noexcept : __shared_owners(1), __weak_owners(1) {
  }

  virtual ~__control_block() {
  }

  virtual void __destroy_object() noexcept = 0;

  virtual void* __get_deleter(const void*) noexcept {
    return 0;
  }

  void __add_shared() noexcept {
    __shared_owners.__add();
  }

  bool __try_add_shared() noexcept {
    return __shared_owners.__try_add();
  }

  void __release_shared() noexcept {
    if (__shared_owners.__release()) {
      __destroy_object();
      __release_weak();
    }
  }

  void __add_weak() noexcept {
    __weak_owners.__add();
  }

  void __release_weak() noexcept {
    if (__weak_owners.__release()) {
      delete this;
    }
  }

  long __use_count() const noexcept {
    return static_cast<long>(__shared_owners.__load());
  }
};

template <class Pointer, class Deleter>
struct __pointer_control_block : __control_block {
  Pointer __pointer;
  Deleter __deleter;

  __pointer_control_block(Pointer pointer, Deleter deleter)
      : __pointer(pointer), __deleter(std::move(deleter)) {
  }

  void __destroy_object() noexcept override {
    __deleter(__pointer);
  }

  void* __get_deleter(const void* token) noexcept override {
    if (token == &__type_token<Deleter>::__value) {
      return &__deleter;
    }
    return 0;
  }
};

template <class T>
struct __inplace_control_block : __control_block {
  alignas(T) unsigned char __storage[sizeof(T)];

  template <class... Args>
  explicit __inplace_control_block(Args&&... args) {
    new (static_cast<void*>(__storage)) T(std::forward<Args>(args)...);
  }

  T* __get() noexcept {
    return reinterpret_cast<T*>(__storage);
  }

  void __destroy_object() noexcept override {
    __get()->~T();
  }
};

