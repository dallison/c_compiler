#if defined(__6502__) || defined(__W65C02__)

struct __count {
  unsigned int __value;

  explicit __count(unsigned int value) noexcept : __value(value) {
  }

  void __add() noexcept {
    ++__value;
  }

  bool __release() noexcept {
    return --__value == 0;
  }

  unsigned int __load() const noexcept {
    return __value;
  }

  bool __try_add() noexcept {
    if (__value == 0) {
      return false;
    }
    ++__value;
    return true;
  }
};

#else

struct __count {
  atomic<unsigned int> __value;

  explicit __count(unsigned int value) noexcept : __value(value) {
  }

  void __add() noexcept {
    __value.fetch_add(1, memory_order_relaxed);
  }

  bool __release() noexcept {
    return __value.fetch_sub(1, memory_order_acq_rel) == 1;
  }

  unsigned int __load() const noexcept {
    return __value.load(memory_order_acquire);
  }

  bool __try_add() noexcept {
    unsigned int value = __value.load(memory_order_acquire);
    while (value != 0) {
      if (__value.compare_exchange_weak(value, value + 1,
                                        memory_order_acquire,
                                        memory_order_relaxed)) {
        return true;
      }
    }
    return false;
  }
};

#endif

template <class T>
struct __type_token {
  static const char __value;
};

template <class T>
const char __type_token<T>::__value = 0;

struct __control_block {
  __count __shared_owners;
  __count __weak_owners;

  __control_block() noexcept : __shared_owners(1), __weak_owners(1) {
  }

  virtual ~__control_block() {
  }

  virtual void __destroy_object() noexcept = 0;

  virtual void __destroy_self() noexcept {
    delete this;
  }

  virtual void* __get_deleter(const void*) noexcept {
    return 0;
  }

  void __add_shared() noexcept {
    __shared_owners.__add();
  }

  bool __try_add_shared() noexcept {
    return __shared_owners.__try_add();
  }

  void __release_shared() noexcept {
    if (__shared_owners.__release()) {
      __destroy_object();
      __release_weak();
    }
  }

  void __add_weak() noexcept {
    __weak_owners.__add();
  }

  void __release_weak() noexcept {
    if (__weak_owners.__release()) {
      __destroy_self();
    }
  }

  long __use_count() const noexcept {
    return static_cast<long>(__shared_owners.__load());
  }
};

template <class Pointer, class Deleter>
struct __pointer_control_block : __control_block {
  Pointer __pointer;
  Deleter __deleter;

  __pointer_control_block(Pointer pointer, Deleter deleter)
      : __pointer(pointer), __deleter(std::move(deleter)) {
  }

  void __destroy_object() noexcept override {
    __deleter(__pointer);
  }

  void* __get_deleter(const void* token) noexcept override {
    if (token == &__type_token<Deleter>::__value) {
      return &__deleter;
    }
    return 0;
  }
};

struct __for_overwrite_t {};

template <class T>
struct __inplace_control_block : __control_block {
  alignas(T) unsigned char __storage[sizeof(T)];

  template <class... Args>
  explicit __inplace_control_block(Args&&... args) {
    new (static_cast<void*>(__storage)) T(std::forward<Args>(args)...);
  }

  explicit __inplace_control_block(__for_overwrite_t) {
    new (static_cast<void*>(__storage)) T;
  }

  T* __get() noexcept {
    return reinterpret_cast<T*>(__storage);
  }

  void __destroy_object() noexcept override {
    __get()->~T();
  }
};

// allocate_shared: the block and the object come from (copies of) the
// caller's allocator, and so does their release.
template <class T, class Alloc>
struct __allocator_control_block : __control_block {
  using __value_alloc =
      typename allocator_traits<Alloc>::template rebind_alloc<T>;
  using __block_alloc = typename allocator_traits<
      Alloc>::template rebind_alloc<__allocator_control_block>;

  __value_alloc __alloc;
  alignas(T) unsigned char __storage[sizeof(T)];

  template <class... Args>
  explicit __allocator_control_block(const Alloc& alloc, Args&&... args)
      : __alloc(alloc) {
    allocator_traits<__value_alloc>::construct(__alloc, __get(),
                                               std::forward<Args>(args)...);
  }

  explicit __allocator_control_block(const Alloc& alloc, __for_overwrite_t)
      : __alloc(alloc) {
    ::new (static_cast<void*>(__get())) T;
  }

  T* __get() noexcept {
    return reinterpret_cast<T*>(__storage);
  }

  void __destroy_object() noexcept override {
    allocator_traits<__value_alloc>::destroy(__alloc, __get());
  }

  void __destroy_self() noexcept override {
    __block_alloc block_alloc(__alloc);
    this->~__allocator_control_block();
    allocator_traits<__block_alloc>::deallocate(block_alloc, this, 1);
  }
};

enum class __array_init { __value, __overwrite, __copy };

// One allocation holds the control block and then the array elements.
template <class U>
struct __array_block : __control_block {
  size_t __count;

  __array_block(size_t count, __array_init how, const U* source)
      : __count(count) {
    U* data = __data();
    size_t built = 0;
    __DAVECC_TRY {
      for (; built < count; ++built) {
        if (how == __array_init::__copy) {
          ::new (static_cast<void*>(data + built)) U(*source);
        } else if (how == __array_init::__overwrite) {
          ::new (static_cast<void*>(data + built)) U;
        } else {
          ::new (static_cast<void*>(data + built)) U();
        }
      }
    }
    __DAVECC_CATCH_ALL {
      while (built > 0) {
        --built;
        data[built].~U();
      }
      __DAVECC_RETHROW;
    }
  }

  U* __data() noexcept {
    unsigned char* base = reinterpret_cast<unsigned char*>(this);
    size_t lead =
        (sizeof(__array_block) + alignof(U) - 1) & ~(alignof(U) - 1);
    return reinterpret_cast<U*>(base + lead);
  }

  void __destroy_object() noexcept override {
    U* data = __data();
    for (size_t index = __count; index > 0; --index) {
      data[index - 1].~U();
    }
  }
};

// allocate_shared for an array: the control block and the elements come from
// the caller's allocator. The allocation unit is aligned for both the block
// and the element type.
template <class U, class Alloc>
struct __alloc_array_block : __control_block {
  struct __unit {
    alignas(U) alignas(size_t) alignas(__control_block) unsigned char __byte;
  };
  using __value_alloc =
      typename allocator_traits<Alloc>::template rebind_alloc<U>;
  using __unit_alloc =
      typename allocator_traits<Alloc>::template rebind_alloc<__unit>;

  __value_alloc __alloc;
  size_t __count;
  size_t __units;

  __alloc_array_block(size_t count, __array_init how, const U* source,
                      const Alloc& alloc, size_t units)
      : __alloc(alloc), __count(count), __units(units) {
    U* data = __data();
    size_t built = 0;
    __DAVECC_TRY {
      for (; built < count; ++built) {
        if (how == __array_init::__copy) {
          allocator_traits<__value_alloc>::construct(__alloc, data + built,
                                                     *source);
        } else if (how == __array_init::__overwrite) {
          ::new (static_cast<void*>(data + built)) U;
        } else {
          allocator_traits<__value_alloc>::construct(__alloc, data + built);
        }
      }
    }
    __DAVECC_CATCH_ALL {
      while (built > 0) {
        --built;
        allocator_traits<__value_alloc>::destroy(__alloc, data + built);
      }
      __DAVECC_RETHROW;
    }
  }

  U* __data() noexcept {
    unsigned char* base = reinterpret_cast<unsigned char*>(this);
    size_t lead =
        (sizeof(__alloc_array_block) + alignof(U) - 1) & ~(alignof(U) - 1);
    return reinterpret_cast<U*>(base + lead);
  }

  void __destroy_object() noexcept override {
    U* data = __data();
    for (size_t index = __count; index > 0; --index) {
      allocator_traits<__value_alloc>::destroy(__alloc, data + index - 1);
    }
  }

  void __destroy_self() noexcept override {
    __unit_alloc units(__alloc);
    size_t count = __units;
    __unit* raw = reinterpret_cast<__unit*>(this);
    this->~__alloc_array_block();
    allocator_traits<__unit_alloc>::deallocate(units, raw, count);
  }
};

template <class U>
struct __built_array {
  __control_block* __control;
  U* __data;
};

template <class U>
__built_array<U> __make_array(size_t count, __array_init how, const U* source) {
  size_t lead =
      (sizeof(__array_block<U>) + alignof(U) - 1) & ~(alignof(U) - 1);
  size_t element_bytes = sizeof(U);
  if (element_bytes != 0 &&
      count > (static_cast<size_t>(-1) - lead) / element_bytes) {
    __DAVECC_THROW(bad_array_new_length());
  }
  size_t bytes = lead + count * element_bytes;
  void* raw = ::operator new(bytes == 0 ? 1 : bytes);
  __DAVECC_TRY {
    __array_block<U>* block =
        ::new (raw) __array_block<U>(count, how, source);
    __built_array<U> built;
    built.__control = block;
    built.__data = block->__data();
    return built;
  }
  __DAVECC_CATCH_ALL {
    ::operator delete(raw);
    __DAVECC_RETHROW;
  }
}

template <class U, class Alloc>
__built_array<U> __make_alloc_array(const Alloc& alloc, size_t count,
                                   __array_init how, const U* source) {
  using __block = __alloc_array_block<U, Alloc>;
  using __unit = typename __block::__unit;
  using __unit_alloc = typename __block::__unit_alloc;
  size_t lead =
      (sizeof(__block) + alignof(U) - 1) & ~(alignof(U) - 1);
  size_t element_bytes = sizeof(U);
  if (element_bytes != 0 &&
      count > (static_cast<size_t>(-1) - lead) / element_bytes) {
    __DAVECC_THROW(bad_array_new_length());
  }
  size_t bytes = lead + count * element_bytes;
  size_t unit_size = sizeof(__unit);
  size_t units = unit_size == 0 ? 1 : (bytes + unit_size - 1) / unit_size;
  if (units == 0) {
    units = 1;
  }
  __unit_alloc units_alloc(alloc);
  __unit* raw = allocator_traits<__unit_alloc>::allocate(units_alloc, units);
  __DAVECC_TRY {
    __block* block = ::new (static_cast<void*>(raw))
        __block(count, how, source, alloc, units);
    __built_array<U> built;
    built.__control = block;
    built.__data = block->__data();
    return built;
  }
  __DAVECC_CATCH_ALL {
    allocator_traits<__unit_alloc>::deallocate(units_alloc, raw, units);
    __DAVECC_RETHROW;
  }
}

// shared_ptr(pointer, deleter, allocator): the control block is allocated
// from the allocator. __alloc is initialized before the deleter is moved, so
// a throwing allocator copy still has a deleter to run on the pointer.
template <class Pointer, class Deleter, class Alloc>
struct __alloc_pointer_block : __control_block {
  using __self_alloc = typename allocator_traits<Alloc>::template rebind_alloc<
      __alloc_pointer_block>;

  Alloc __alloc;
  Pointer __pointer;
  Deleter __deleter;

  __alloc_pointer_block(Pointer pointer, Deleter&& incoming, const Alloc& alloc)
      : __alloc(alloc),
        __pointer(pointer),
        __deleter(static_cast<Deleter&&>(incoming)) {
  }

  void __destroy_object() noexcept override {
    __deleter(__pointer);
  }

  void* __get_deleter(const void* token) noexcept override {
    if (token == &__type_token<Deleter>::__value) {
      return &__deleter;
    }
    return 0;
  }

  void __destroy_self() noexcept override {
    __self_alloc block_alloc(__alloc);
    this->~__alloc_pointer_block();
    allocator_traits<__self_alloc>::deallocate(block_alloc, this, 1);
  }
};

