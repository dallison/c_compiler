inline void* align(size_t alignment, size_t size, void*& ptr,
                   size_t& space) noexcept {
  uintptr_t address = reinterpret_cast<uintptr_t>(ptr);
  uintptr_t aligned = (address + alignment - 1) & ~(alignment - 1);
  size_t padding = static_cast<size_t>(aligned - address);
  if (alignment == 0 || (alignment & (alignment - 1)) != 0 ||
      padding > space || size > space - padding) {
    return 0;
  }
  space -= padding;
  ptr = reinterpret_cast<void*>(aligned);
  return ptr;
}

#if __cplusplus >= 202002L
template <size_t Alignment, class T>
[[nodiscard]] constexpr T* assume_aligned(T* ptr) noexcept {
  static_assert(Alignment != 0 && (Alignment & (Alignment - 1)) == 0,
                "assume_aligned alignment must be a power of two");
  return ptr;
}

