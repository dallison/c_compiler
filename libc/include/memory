// out_ptr releases nothing: the callee writes a new pointer and the destructor
// reset() deletes whatever the smart pointer already owned. inout_ptr releases
// a unique_ptr first, and its destructor always resets, including to null.
template <class Smart, class Pointer, bool In, class... Args>
class __out_ptr_holder {
 public:
  explicit __out_ptr_holder(Smart& smart, Args... args)
      : __smart(smart), __args(static_cast<Args&&>(args)...) {
    if constexpr (In) {
      if constexpr (is_pointer<Smart>::value) {
        __p = static_cast<Pointer>(smart);
      } else if constexpr (__has_smart_release<Smart>::value) {
        __p = static_cast<Pointer>(smart.release());
      } else {
        __p = static_cast<Pointer>(smart.get());
      }
    }
  }

  __out_ptr_holder(const __out_ptr_holder&) = delete;
  __out_ptr_holder& operator=(const __out_ptr_holder&) = delete;

  __out_ptr_holder(__out_ptr_holder&& other) noexcept
      : __smart(other.__smart),
        __args(static_cast<tuple<Args...>&&>(other.__args)),
        __p(other.__p),
        __engaged(other.__engaged) {
    other.__engaged = false;
  }

  ~__out_ptr_holder() {
    if (!__engaged) {
      return;
    }
    if constexpr (!In) {
      if (!__out_ptr_present(__p)) {
        return;
      }
    }
    if constexpr (is_pointer<Smart>::value) {
      __smart = static_cast<Smart>(__p);
    } else if constexpr (sizeof...(Args) == 0) {
      __smart.reset(static_cast<Pointer>(__p));
    } else {
      apply(
          [this](auto&&... unpacked) {
            __smart.reset(static_cast<Pointer>(__p),
                          static_cast<decltype(unpacked)&&>(unpacked)...);
          },
          __args);
    }
  }

  operator Pointer*() const noexcept { return &__p; }

  template <class P = Pointer,
            class = typename enable_if<!is_same<P, void*>::value>::type>
  operator void**() const noexcept {
    return reinterpret_cast<void**>(&__p);
  }

 private:
  Smart& __smart;
  tuple<Args...> __args;
  mutable Pointer __p{};
  bool __engaged = true;
};

template <class Smart, class Pointer, class... Args>
using out_ptr_t = __out_ptr_holder<Smart, Pointer, false, Args...>;

template <class Smart, class Pointer, class... Args>
using inout_ptr_t = __out_ptr_holder<Smart, Pointer, true, Args...>;

template <class Pointer = void, class Smart, class... Args>
auto out_ptr(Smart& smart, Args&&... args) {
  using Stored = typename __out_ptr_pointer<Smart, Pointer>::type;
  return out_ptr_t<Smart, Stored, remove_cvref_t<Args>...>(
      smart, static_cast<Args&&>(args)...);
}

template <class Pointer = void, class Smart, class... Args>
auto inout_ptr(Smart& smart, Args&&... args) {
  using Stored = typename __out_ptr_pointer<Smart, Pointer>::type;
  return inout_ptr_t<Smart, Stored, remove_cvref_t<Args>...>(
      smart, static_cast<Args&&>(args)...);
}
