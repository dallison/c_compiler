    Deleter, Element,
    __void_t<typename remove_reference<Deleter>::type::pointer>> {
  using type = typename remove_reference<Deleter>::type::pointer;
};

// A reference deleter converts only from the same type. A value deleter
// converts from anything convertible to it.
template <class Deleter, class E>
struct __unique_deleter_convert
    : bool_constant<(is_reference<Deleter>::value &&
                      is_same<Deleter, E>::value) ||
                     (!is_reference<Deleter>::value &&
                      is_convertible<E, Deleter>::value)> {};

template <class Deleter>
struct __unique_default_deleter
    : bool_constant<is_default_constructible<Deleter>::value &&
                    !is_pointer<Deleter>::value> {};

template <class T, class Deleter = default_delete<T>>
struct unique_ptr {
  using pointer = typename __unique_pointer<Deleter, T>::type;
  using element_type = T;
  using deleter_type = Deleter;

 private:
  pointer __ptr;
  Deleter __deleter;

  using __deleter_object = remove_reference_t<Deleter>;

 public:
  template <class D2 = Deleter,
            enable_if_t<__unique_default_deleter<D2>::value, int> = 0>
  constexpr unique_ptr() noexcept : __ptr() {
  }

  template <class D2 = Deleter,
            enable_if_t<__unique_default_deleter<D2>::value, int> = 0>
  constexpr unique_ptr(decltype(nullptr)) noexcept : __ptr() {
  }

  template <class D2 = Deleter,
            enable_if_t<__unique_default_deleter<D2>::value, int> = 0>
  explicit unique_ptr(pointer ptr) noexcept : __ptr(ptr) {
  }

  // [unique.ptr.single.ctor]: lvalue deleters bind, rvalue deleters move.
  // An rvalue bound to a reference deleter is ill-formed.
  unique_ptr(pointer ptr,
             conditional_t<is_reference<Deleter>::value, Deleter,
                           const Deleter&>
                 deleter) noexcept
      : __ptr(ptr), __deleter(deleter) {
  }

  unique_ptr(pointer ptr, __deleter_object&& deleter) noexcept
      : __ptr(ptr),
        __deleter(static_cast<__deleter_object&&>(deleter)) {
    static_assert(!is_reference<Deleter>::value,
                  "rvalue deleter cannot bind to a reference deleter");
  }

  unique_ptr(const unique_ptr& other) = delete;

  unique_ptr(unique_ptr&& other) noexcept
      : __ptr(other.release()),
        __deleter(static_cast<Deleter&&>(other.__deleter)) {
  }

  template <class U, class E,
            enable_if_t<!is_array<U>::value &&
                            is_convertible<typename unique_ptr<U, E>::pointer,
                                           pointer>::value &&
                            __unique_deleter_convert<Deleter, E>::value,
                        int> = 0>
  unique_ptr(unique_ptr<U, E>&& other) noexcept
      : __ptr(other.release()),
        __deleter(static_cast<E&&>(other.get_deleter())) {
  }

  ~unique_ptr(void) {
    if (__ptr) {
      __deleter(__ptr);
    }
  }

  unique_ptr& operator=(const unique_ptr& other) = delete;

  unique_ptr& operator=(unique_ptr&& other) noexcept {
    reset(other.release());
    __deleter = static_cast<Deleter&&>(other.__deleter);
    return *this;
  }

  template <class U, class E,
            enable_if_t<!is_array<U>::value &&
                            is_convertible<typename unique_ptr<U, E>::pointer,
                                           pointer>::value &&
                            is_assignable<Deleter&, E&&>::value,
                        int> = 0>
  unique_ptr& operator=(unique_ptr<U, E>&& other) noexcept {
    reset(other.release());
    __deleter = static_cast<E&&>(other.get_deleter());
    return *this;
  }

  unique_ptr& operator=(decltype(nullptr)) noexcept {
    reset();
    return *this;
  }

  T& operator*(void) const {
    return *__ptr;
  }

  pointer operator->(void) const noexcept {
    return __ptr;
  }

  pointer get(void) const noexcept {
    return __ptr;
  }

  explicit operator bool() const noexcept {
    return static_cast<bool>(__ptr);
  }

  Deleter& get_deleter(void) noexcept {
    return __deleter;
  }

  const Deleter& get_deleter(void) const noexcept {
    return __deleter;
  }

  pointer release(void) noexcept {
    pointer ptr = __ptr;
    __ptr = pointer();
    return ptr;
  }

  void reset(pointer ptr = pointer()) noexcept {
    pointer old = __ptr;
    __ptr = ptr;
    if (old) {
      __deleter(old);
    }
  }

  void swap(unique_ptr& other) noexcept {
    pointer ptr = __ptr;
    __ptr = other.__ptr;
    other.__ptr = ptr;
    Deleter deleter = static_cast<Deleter&&>(__deleter);
    __deleter = static_cast<Deleter&&>(other.__deleter);
    other.__deleter = static_cast<Deleter&&>(deleter);
  }
};

