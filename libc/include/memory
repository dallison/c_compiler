#if !defined(__6502__) && !defined(__W65C02__)
// shared_ptr and weak_ptr are not trivially copyable, so the word-sized
// atomic operations cannot own one. A spin lock plus a version counter gives
// the C++20 atomic specializations and the older shared_ptr atomic functions
// the same ownership comparison the standard requires.
template <class Ptr>
struct __atomic_shared_owner {
  using value_type = Ptr;
  static constexpr bool is_always_lock_free = false;

  constexpr __atomic_shared_owner() noexcept = default;

  __atomic_shared_owner(Ptr desired) noexcept
      : __value(static_cast<Ptr&&>(desired)) {}

  __atomic_shared_owner(const __atomic_shared_owner&) = delete;
  __atomic_shared_owner& operator=(const __atomic_shared_owner&) = delete;

  bool is_lock_free() const noexcept { return false; }

  void store(Ptr desired, memory_order = memory_order_seq_cst) noexcept {
    __acquire();
    __value = static_cast<Ptr&&>(desired);
    __release();
    __publish();
  }

  Ptr load(memory_order = memory_order_seq_cst) const noexcept {
    __acquire();
    Ptr result = __value;
    __release();
    return result;
  }

  Ptr exchange(Ptr desired, memory_order = memory_order_seq_cst) noexcept {
    __acquire();
    Ptr previous = static_cast<Ptr&&>(__value);
    __value = static_cast<Ptr&&>(desired);
    __release();
    __publish();
    return previous;
  }

  bool compare_exchange_strong(Ptr& expected, Ptr desired, memory_order,
                               memory_order) noexcept {
    __acquire();
    if (__same(__value, expected)) {
      __value = static_cast<Ptr&&>(desired);
      __release();
      __publish();
      return true;
    }
    expected = __value;
    __release();
    return false;
  }

  bool compare_exchange_strong(
      Ptr& expected, Ptr desired,
      memory_order order = memory_order_seq_cst) noexcept {
    return compare_exchange_strong(expected, static_cast<Ptr&&>(desired), order,
                                   order);
  }

  bool compare_exchange_weak(Ptr& expected, Ptr desired, memory_order success,
                             memory_order failure) noexcept {
    return compare_exchange_strong(expected, static_cast<Ptr&&>(desired),
                                   success, failure);
  }

  bool compare_exchange_weak(
      Ptr& expected, Ptr desired,
      memory_order order = memory_order_seq_cst) noexcept {
    return compare_exchange_strong(expected, static_cast<Ptr&&>(desired), order,
                                   order);
  }

  void wait(Ptr old, memory_order order = memory_order_seq_cst) const noexcept {
    unsigned seen = __version.load(order);
    __acquire();
    bool same = __same(__value, old);
    __release();
    if (!same) {
      return;
    }
    __version.wait(seen, order);
  }

  void notify_one() noexcept { __publish(); }

  void notify_all() noexcept { __publish(); }

  operator Ptr() const noexcept { return load(); }

  Ptr operator=(Ptr desired) noexcept {
    store(desired);
    return desired;
  }

 private:
  static bool __same(const Ptr& left, const Ptr& right) noexcept {
    return !left.owner_before(right) && !right.owner_before(left);
  }

  void __acquire() const noexcept {
    while (__lock.test_and_set(memory_order_acquire)) {
    }
  }

  void __release() const noexcept { __lock.clear(memory_order_release); }

  void __publish() const noexcept {
    __version.fetch_add(1, memory_order_release);
    __version.notify_all();
  }

  mutable atomic_flag __lock{};
  Ptr __value{};
  mutable atomic<unsigned> __version{0};
};

