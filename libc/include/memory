template <class T, class Deleter>
bool operator==(const unique_ptr<T, Deleter>& ptr, decltype(nullptr)) noexcept {
  return ptr.get() == 0;
}

template <class T, class Deleter>
bool operator==(decltype(nullptr), const unique_ptr<T, Deleter>& ptr) noexcept {
  return ptr.get() == 0;
}

template <class T, class Deleter>
bool operator!=(const unique_ptr<T, Deleter>& ptr, decltype(nullptr)) noexcept {
  return ptr.get() != 0;
}

template <class T, class Deleter>
bool operator!=(decltype(nullptr), const unique_ptr<T, Deleter>& ptr) noexcept {
  return ptr.get() != 0;
}

template <class T, class... Args>
static inline unique_ptr<T> make_unique(Args&&... args) {
  unique_ptr<T> result;
  result.reset(new T(std::forward<Args>(args)...));
  return result;
}

template <class T, class Deleter>
static inline void swap(unique_ptr<T, Deleter>& left,
                        unique_ptr<T, Deleter>& right) noexcept {
  left.swap(right);
}

