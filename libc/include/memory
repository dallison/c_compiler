template <class T, class Alloc, class... Args>
shared_ptr<T> allocate_shared(const Alloc& alloc, Args&&... args) {
  if constexpr (!is_array<T>::value) {
  using __block = __shared_ptr_detail::__allocator_control_block<T, Alloc>;
  using __block_alloc = typename __block::__block_alloc;
  __block_alloc block_alloc(alloc);
  __block* control = allocator_traits<__block_alloc>::allocate(block_alloc, 1);
  __DAVECC_TRY {
    ::new (static_cast<void*>(control)) __block(alloc, std::forward<Args>(args)...);
  }
  __DAVECC_CATCH_ALL {
    allocator_traits<__block_alloc>::deallocate(block_alloc, control, 1);
    __DAVECC_RETHROW;
  }
  shared_ptr<T> result(control->__get(), control,
                       __shared_ptr_detail::__adopt_shared_t());
  result.__enable_weak_this(control->__get(), control->__get());
  return result;
  } else if constexpr (extent<T>::value == 0) {
    static_assert(sizeof...(Args) == 1 || sizeof...(Args) == 2,
                  "allocate_shared<T[]> takes a count and an optional value");
    auto built = __shared_ptr_detail::__shared_alloc_array<T>(
        alloc, std::forward<Args>(args)...);
    return shared_ptr<T>(built.__data, built.__control,
                         __shared_ptr_detail::__adopt_shared_t());
  } else {
    static_assert(sizeof...(Args) <= 1,
                  "allocate_shared<T[N]> takes an optional initial value");
    auto built = __shared_ptr_detail::__shared_alloc_array_bounded<T>(
        alloc, std::forward<Args>(args)...);
    return shared_ptr<T>(built.__data, built.__control,
                         __shared_ptr_detail::__adopt_shared_t());
  }
}

