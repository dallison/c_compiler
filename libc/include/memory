struct __alloc_construct_dispatch;

template <>
struct __alloc_construct_dispatch<false> {
  template <class Alloc, class T, class... Args>
  static constexpr void call(Alloc&, T* ptr, Args&&... args) {
    __alloc_placement_construct<T, Args...>::call(
        ptr, static_cast<Args&&>(args)...);
  }
};

template <>
struct __alloc_construct_dispatch<true> {
  template <class Alloc, class T, class... Args>
  static constexpr void call(Alloc& alloc, T* ptr, Args&&... args) {
    alloc.construct(ptr, static_cast<Args&&>(args)...);
  }
};

