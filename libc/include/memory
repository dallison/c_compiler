template <class T>
class shared_ptr {
 public:
  using element_type = remove_extent_t<T>;
  using weak_type = weak_ptr<T>;

 private:
  element_type* __pointer;
  __shared_ptr_detail::__control_block* __control;

  template <class U>
  friend class shared_ptr;
  template <class U>
  friend class weak_ptr;
  template <class U>
  friend class enable_shared_from_this;
  template <class U, class... Args>
  friend shared_ptr<U> make_shared(Args&&... args);
  template <class U, class Alloc, class... Args>
  friend shared_ptr<U> allocate_shared(const Alloc& alloc, Args&&... args);
  template <class U, class Alloc>
  friend shared_ptr<U> allocate_shared_for_overwrite(const Alloc& alloc);
  template <class U, class Alloc>
  friend shared_ptr<U> allocate_shared_for_overwrite(const Alloc& alloc,
                                                     size_t count);
  template <class U>
  friend shared_ptr<U> make_shared_for_overwrite();
  template <class U>
  friend shared_ptr<U> make_shared_for_overwrite(size_t);

  shared_ptr(element_type* pointer,
             __shared_ptr_detail::__control_block* control,
             __shared_ptr_detail::__adopt_shared_t) noexcept
      : __pointer(pointer), __control(control) {
  }

  template <class U, class Deleter>
  void __construct(U* pointer, Deleter deleter) {
    using __block =
        __shared_ptr_detail::__pointer_control_block<U*, Deleter>;
    __DAVECC_TRY {
      __control = new __block(pointer, std::move(deleter));
    }
    __DAVECC_CATCH_ALL {
      deleter(pointer);
      __DAVECC_RETHROW;
    }
    __pointer = pointer;
    __enable_weak_this(pointer, pointer);
  }

  template <class U, class Deleter, class Alloc>
  void __construct_allocated(U* pointer, Deleter&& deleter, const Alloc& alloc) {
    using __block =
        __shared_ptr_detail::__alloc_pointer_block<U*, Deleter, Alloc>;
    using __block_alloc = typename __block::__self_alloc;
    __block_alloc block_alloc(alloc);
    __block* raw = allocator_traits<__block_alloc>::allocate(block_alloc, 1);
    __DAVECC_TRY {
      ::new (static_cast<void*>(raw))
          __block(pointer, static_cast<Deleter&&>(deleter), alloc);
    }
    __DAVECC_CATCH_ALL {
      allocator_traits<__block_alloc>::deallocate(block_alloc, raw, 1);
      deleter(pointer);
      __DAVECC_RETHROW;
    }
    __control = raw;
    __pointer = pointer;
    __enable_weak_this(pointer, pointer);
  }

  template <class U, class Original,
            enable_if_t<is_convertible<Original*, const U*>::value, int> = 0>
  void __enable_weak_this(const enable_shared_from_this<U>* base,
                          Original* pointer) noexcept {
    if (base != 0 && base->__weak_this.expired()) {
      base->__weak_this =
          shared_ptr<U>(*this,
                        const_cast<U*>(static_cast<const U*>(pointer)));
    }
  }

  void __enable_weak_this(...) noexcept {
  }

 public:
  constexpr shared_ptr() noexcept : __pointer(0), __control(0) {
  }

  constexpr shared_ptr(decltype(nullptr)) noexcept
      : __pointer(0), __control(0) {
  }

  template <class U,
            enable_if_t<is_convertible<U*, element_type*>::value, int> = 0>
  explicit shared_ptr(U* pointer) : __pointer(0), __control(0) {
    using __deleter = typename __shared_default_deleter<T, U>::type;
    __construct(pointer, __deleter());
  }

  template <class U, class Deleter,
            enable_if_t<is_convertible<U*, element_type*>::value, int> = 0>
  shared_ptr(U* pointer, Deleter deleter) : __pointer(0), __control(0) {
    __construct(pointer, std::move(deleter));
  }

  template <class Deleter>
  shared_ptr(decltype(nullptr), Deleter deleter)
      : __pointer(0), __control(0) {
    __construct(static_cast<element_type*>(0), std::move(deleter));
  }

  template <class U, class Deleter, class Alloc,
            enable_if_t<is_convertible<U*, element_type*>::value &&
                            !is_same<Alloc, __shared_ptr_detail::__adopt_shared_t>::value,
                        int> = 0>
  shared_ptr(U* pointer, Deleter deleter, Alloc alloc)
      : __pointer(0), __control(0) {
    __construct_allocated(pointer, static_cast<Deleter&&>(deleter), alloc);
  }

  template <class Deleter, class Alloc,
            enable_if_t<!is_same<Alloc, __shared_ptr_detail::__adopt_shared_t>::value,
                        int> = 0>
  shared_ptr(decltype(nullptr), Deleter deleter, Alloc alloc)
      : __pointer(0), __control(0) {
    __construct_allocated(static_cast<element_type*>(0),
                          static_cast<Deleter&&>(deleter), alloc);
  }

  shared_ptr(const shared_ptr& other) noexcept
      : __pointer(other.__pointer), __control(other.__control) {
    if (__control != 0) {
      __control->__add_shared();
    }
  }

  template <class U,
            enable_if_t<is_convertible<typename shared_ptr<U>::element_type*,
                                       element_type*>::value,
                        int> = 0>
  shared_ptr(const shared_ptr<U>& other) noexcept
      : __pointer(other.__pointer), __control(other.__control) {
    if (__control != 0) {
      __control->__add_shared();
    }
  }

  shared_ptr(shared_ptr&& other) noexcept
      : __pointer(other.__pointer), __control(other.__control) {
    other.__pointer = 0;
    other.__control = 0;
  }

  template <class U,
            enable_if_t<is_convertible<typename shared_ptr<U>::element_type*,
                                       element_type*>::value,
                        int> = 0>
  shared_ptr(shared_ptr<U>&& other) noexcept
      : __pointer(other.__pointer), __control(other.__control) {
    other.__pointer = 0;
    other.__control = 0;
  }

  template <class U>
  shared_ptr(const shared_ptr<U>& other, element_type* pointer) noexcept
      : __pointer(pointer), __control(other.__control) {
    if (__control != 0) {
      __control->__add_shared();
    }
  }

  template <class U>
  shared_ptr(shared_ptr<U>&& other, element_type* pointer) noexcept
      : __pointer(pointer), __control(other.__control) {
    other.__pointer = 0;
    other.__control = 0;
  }

  template <class U,
            enable_if_t<is_convertible<typename weak_ptr<U>::element_type*,
                                       element_type*>::value,
                        int> = 0>
  explicit shared_ptr(const weak_ptr<U>& other)
      : __pointer(0), __control(0) {
    if (other.__control == 0 || !other.__control->__try_add_shared()) {
      __DAVECC_THROW(bad_weak_ptr());
    }
    __pointer = other.__pointer;
    __control = other.__control;
  }

  template <class U, class Deleter,
            enable_if_t<is_convertible<U*, element_type*>::value, int> = 0>
  shared_ptr(unique_ptr<U, Deleter>&& other)
      : __pointer(0), __control(0) {
    if (other.get() != 0) {
      using __block =
          __shared_ptr_detail::__pointer_control_block<U*, Deleter>;
      __control =
          new __block(other.get(), std::move(other.get_deleter()));
      __pointer = other.release();
      __enable_weak_this(__pointer, __pointer);
    }
  }

  ~shared_ptr() {
    if (__control != 0) {
      __control->__release_shared();
    }
  }

  shared_ptr& operator=(const shared_ptr& other) noexcept {
    shared_ptr(other).swap(*this);
    return *this;
