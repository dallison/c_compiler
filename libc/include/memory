// allocator_traits::construct / destroy call Alloc::construct / Alloc::destroy
// when that expression is valid, and otherwise placement-new / the destructor.
// The argument types are one type-list so the SFINAE parameter stays last.
// Placement new lives on a helper whose only type parameter is the object
// type: a new-expression in a class with another type parameter is rewritten
// as that other type.  The member call is a separate specialization so it is
// not instantiated when Alloc has no such member.
template <class... Ts>
struct __alloc_type_list {};

template <class Alloc, class T, class List, class = void>
struct __alloc_has_construct : false_type {};

template <class Alloc, class T, class... Args>
struct __alloc_has_construct<
    Alloc, T, __alloc_type_list<Args...>,
    __void_t<decltype(declval<Alloc&>().construct(declval<T*>(),
                                                  declval<Args>()...))>>
    : true_type {};

template <class T, class... Args>
struct __alloc_placement_construct {
  static constexpr void call(T* ptr, Args&&... args) {
    std::__construct_at(ptr, static_cast<Args&&>(args)...);
  }
};

