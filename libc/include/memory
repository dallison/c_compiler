template <class T>
struct __is_std_pair : false_type {};

template <class A, class B>
struct __is_std_pair<pair<A, B>> : true_type {};

template <class T, class Alloc, class... Args>
constexpr auto uses_allocator_construction_args(const Alloc& alloc,
                                                Args&&... args) noexcept {
  if constexpr (__is_std_pair<T>::value) {
    return __uses_allocator_pair_args<T>(alloc, static_cast<Args&&>(args)...);
  } else if constexpr (!uses_allocator<T, Alloc>::value) {
    return forward_as_tuple(static_cast<Args&&>(args)...);
  } else if constexpr (is_constructible<T, allocator_arg_t, const Alloc&,
                                        Args...>::value) {
    return tuple<allocator_arg_t, const Alloc&, Args&&...>(
        allocator_arg, alloc, static_cast<Args&&>(args)...);
  } else {
    static_assert(is_constructible<T, Args..., const Alloc&>::value,
                  "no uses-allocator constructor");
    return forward_as_tuple(static_cast<Args&&>(args)..., alloc);
  }
}

template <class Pair, class Alloc, class Tuple1, class Tuple2>
constexpr auto __uses_allocator_pair_args(const Alloc& alloc,
                                          piecewise_construct_t,
                                          Tuple1&& first, Tuple2&& second) noexcept {
  using T1 = typename Pair::first_type;
  using T2 = typename Pair::second_type;
  return tuple<piecewise_construct_t,
               decltype(apply(
                   [&alloc](auto&&... piece) {
                     return uses_allocator_construction_args<T1>(
                         alloc, static_cast<decltype(piece)&&>(piece)...);
                   },
                   static_cast<Tuple1&&>(first))),
               decltype(apply(
                   [&alloc](auto&&... piece) {
                     return uses_allocator_construction_args<T2>(
                         alloc, static_cast<decltype(piece)&&>(piece)...);
                   },
                   static_cast<Tuple2&&>(second)))>(
      piecewise_construct,
      apply(
          [&alloc](auto&&... piece) {
            return uses_allocator_construction_args<T1>(
                alloc, static_cast<decltype(piece)&&>(piece)...);
          },
          static_cast<Tuple1&&>(first)),
      apply(
          [&alloc](auto&&... piece) {
            return uses_allocator_construction_args<T2>(
                alloc, static_cast<decltype(piece)&&>(piece)...);
          },
          static_cast<Tuple2&&>(second)));
}

template <class Pair, class Alloc>
constexpr auto __uses_allocator_pair_args(const Alloc& alloc) noexcept {
  return __uses_allocator_pair_args<Pair>(alloc, piecewise_construct,
                                          tuple<>(), tuple<>());
}

