  unique_ptr(T* ptr, Deleter& deleter) noexcept
      : __ptr(ptr), __deleter(deleter) {
  }

  unique_ptr(const unique_ptr& other) = delete;

  unique_ptr(unique_ptr&& other) noexcept : __ptr(other.release()) {
    __deleter = std::move(other.__deleter);
