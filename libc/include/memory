      : __pointer(other.__pointer), __control(other.__control) {
    if (__control != 0) {
      __control->__add_weak();
    }
  }

  weak_ptr(weak_ptr&& other) noexcept
      : __pointer(other.__pointer), __control(other.__control) {
    other.__pointer = 0;
    other.__control = 0;
  }

  template <class U,
            enable_if_t<is_convertible<typename weak_ptr<U>::element_type*,
                                       element_type*>::value,
                        int> = 0>
  weak_ptr(weak_ptr<U>&& other) noexcept
      : __pointer(other.__pointer), __control(other.__control) {
    other.__pointer = 0;
    other.__control = 0;
  }

  ~weak_ptr() {
    if (__control != 0) {
      __control->__release_weak();
    }
  }

  weak_ptr& operator=(const weak_ptr& other) noexcept {
    weak_ptr(other).swap(*this);
    return *this;
