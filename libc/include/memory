struct __ptr_traits_no_reference {};

template <class Ptr, class = void>
struct __ptr_traits_impl {};

template <class Ptr>
struct __ptr_traits_impl<
    Ptr, __void_t<typename __ptr_traits_element_type<Ptr>::type>> {
  using pointer = Ptr;
  using element_type = typename __ptr_traits_element_type<Ptr>::type;
  using difference_type = typename __ptr_traits_difference_type<Ptr>::type;
  template <class U>
  using rebind = typename __ptr_traits_rebind<Ptr, U>::type;
  // Declaring `pointer_to(void&)` for `element_type = void` would be
  // ill-formed; that specialization has no usable pointer_to.
  static pointer pointer_to(
      typename conditional<is_void<element_type>::value,
                           __ptr_traits_no_reference, element_type>::type& r) {
    return Ptr::pointer_to(r);
  }
};

// LWG 3545: no members when element_type cannot be formed.
template <class Ptr>
struct pointer_traits : __ptr_traits_impl<Ptr> {};

template <class T>
struct pointer_traits<T*> {
  using pointer = T*;
  using element_type = T;
  using difference_type = ptrdiff_t;
  template <class U>
  using rebind = U*;
  static constexpr pointer pointer_to(T& r) noexcept {
    return addressof(r);
  }
};

// [pointer.conversion] std::to_address.  Fancy pointers may provide
// pointer_traits<Ptr>::to_address; otherwise the pointer is reached through
// operator->().
template <class Ptr, class = void>
struct __ptr_has_to_address : false_type {};

template <class Ptr>
struct __ptr_has_to_address<
    Ptr, __void_t<decltype(pointer_traits<Ptr>::to_address(
             declval<const Ptr&>()))>> : true_type {};

template <class T>
constexpr T* to_address(T* p) noexcept {
  static_assert(!is_function<T>::value, "to_address of a function pointer");
  return p;
}

template <class Ptr>
constexpr auto __to_address_fancy(const Ptr& p) noexcept {
  if constexpr (__ptr_has_to_address<Ptr>::value) {
    return pointer_traits<Ptr>::to_address(p);
  } else {
    return to_address(p.operator->());
  }
}

template <class Ptr, enable_if_t<!is_pointer<Ptr>::value, int> = 0>
constexpr auto to_address(const Ptr& p) noexcept {
  return __to_address_fancy(p);
}

