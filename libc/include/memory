template <class T>
class auto_ptr {
 public:
  typedef T element_type;
  explicit auto_ptr(T* value = 0) : value_(value) {}
  auto_ptr(auto_ptr& other) : value_(other.release()) {}
  template <class U> auto_ptr(auto_ptr<U>& other) : value_(other.release()) {}
  ~auto_ptr() { delete value_; }
  auto_ptr& operator=(auto_ptr& other) {
    reset(other.release());
    return *this;
  }
  T& operator*() const { return *value_; }
  T* operator->() const { return value_; }
  T* get() const { return value_; }
  T* release() {
    T* result = value_;
    value_ = 0;
    return result;
  }
  void reset(T* value = 0) {
    if (value_ != value) {
      delete value_;
      value_ = value;
    }
  }

 private:
  T* value_;
};

