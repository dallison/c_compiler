template <input_iterator I, sentinel_for<I> S1, forward_iterator O,
          sentinel_for<O> S2>
  requires constructible_from<iter_value_t<O>, iter_reference_t<I>>
uninitialized_copy_result<I, O> uninitialized_copy(I first, S1 last, O result,
                                                   S2 result_last) {
  O current = result;
  __DAVECC_TRY {
    for (; first != last && current != result_last; ++first, ++current) {
      ::new (static_cast<void*>(addressof(*current)))
          iter_value_t<O>(*first);
    }
    return {static_cast<I&&>(first), static_cast<O&&>(current)};
  }
  __DAVECC_CATCH_ALL {
    std::destroy(result, current);
    __DAVECC_RETHROW;
  }
}

