template <class T, class... Args>
shared_ptr<T> make_shared(Args&&... args) {
  if constexpr (!is_array<T>::value) {
    using __block = __shared_ptr_detail::__inplace_control_block<T>;
    __block* control = new __block(std::forward<Args>(args)...);
    shared_ptr<T> result(control->__get(), control,
                         __shared_ptr_detail::__adopt_shared_t());
    result.__enable_weak_this(control->__get(), control->__get());
    return result;
  } else if constexpr (extent<T>::value == 0) {
    auto built = __shared_ptr_detail::__shared_array_args<T>(
        std::forward<Args>(args)...);
    return shared_ptr<T>(built.__data, built.__control,
                         __shared_ptr_detail::__adopt_shared_t());
  } else {
    auto built = __shared_ptr_detail::__shared_array_bounded<T>(
        std::forward<Args>(args)...);
    return shared_ptr<T>(built.__data, built.__control,
                         __shared_ptr_detail::__adopt_shared_t());
  }
}

template <class T>
shared_ptr<T> make_shared_for_overwrite() {
  if constexpr (!is_array<T>::value) {
    using __block = __shared_ptr_detail::__inplace_control_block<T>;
    __block* control = new __block(__shared_ptr_detail::__for_overwrite_t());
    shared_ptr<T> result(control->__get(), control,
                         __shared_ptr_detail::__adopt_shared_t());
    result.__enable_weak_this(control->__get(), control->__get());
    return result;
  } else {
    static_assert(extent<T>::value != 0,
                  "make_shared_for_overwrite<T[]> requires a count");
    auto built =
        __shared_ptr_detail::__shared_array_overwrite_bounded<T>();
    return shared_ptr<T>(built.__data, built.__control,
                         __shared_ptr_detail::__adopt_shared_t());
  }
}

