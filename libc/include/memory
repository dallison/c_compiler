// A constructor that throws destroys objects already constructed in [first, current).
template <class ForwardIt>
constexpr void __destroy_constructed(ForwardIt first, ForwardIt current) {
  typedef typename iterator_traits<ForwardIt>::value_type value_type;
  for (; first != current; ++first) {
    addressof(*first)->~value_type();
  }
}

template <class InputIt, class ForwardIt>
ForwardIt uninitialized_copy(InputIt first, InputIt last, ForwardIt output) {
  typedef typename iterator_traits<ForwardIt>::value_type value_type;
  ForwardIt current = output;
  __DAVECC_TRY {
    for (; first != last; ++first, ++current) {
      ::new (static_cast<void*>(addressof(*current))) value_type(*first);
    }
    return current;
  }
  __DAVECC_CATCH_ALL {
    __destroy_constructed(output, current);
    __DAVECC_RETHROW;
  }
}

