};

template <class Alloc>
struct allocator_traits {
  using allocator_type = Alloc;
  using value_type = typename Alloc::value_type;
  using pointer = typename __alloc_traits_pointer<Alloc>::type;
  using const_pointer =
      typename __alloc_traits_const_pointer<Alloc, pointer>::type;
  using void_pointer = typename __alloc_traits_void_pointer<Alloc, pointer>::type;
  using const_void_pointer =
      typename __alloc_traits_const_void_pointer<Alloc, pointer>::type;
  using difference_type =
      typename __alloc_traits_difference_type<Alloc, pointer>::type;
  using size_type =
      typename __alloc_traits_size_type<Alloc, difference_type>::type;
  using propagate_on_container_copy_assignment =
      typename __alloc_traits_copy_propagate<Alloc>::type;
  using propagate_on_container_move_assignment =
      typename __alloc_traits_move_propagate<Alloc>::type;
  using propagate_on_container_swap =
      typename __alloc_traits_swap_propagate<Alloc>::type;
  using is_always_equal = typename __alloc_traits_always_equal<Alloc>::type;

  template <class T>
  using rebind_alloc = typename __alloc_traits_rebind<Alloc, T>::type;

  template <class T>
  using rebind_traits = allocator_traits<rebind_alloc<T>>;

  static constexpr bool __propagate_on_container_copy_assignment() {
    return __alloc_traits_bool(
        static_cast<propagate_on_container_copy_assignment*>(nullptr));
  }

  static constexpr bool __propagate_on_container_move_assignment() {
    return __alloc_traits_bool(
        static_cast<propagate_on_container_move_assignment*>(nullptr));
  }

  static constexpr bool __propagate_on_container_swap() {
    return __alloc_traits_bool(
        static_cast<propagate_on_container_swap*>(nullptr));
  }

  static constexpr bool __is_always_equal() {
    return __alloc_traits_bool(static_cast<is_always_equal*>(nullptr));
  }

  static constexpr pointer allocate(Alloc& alloc, size_type n) {
    return alloc.allocate(n);
  }

  static constexpr pointer allocate(Alloc& alloc, size_type n,
                                    const_void_pointer hint) {
    return __alloc_allocate_hint<Alloc, pointer, size_type,
                                 const_void_pointer>::call(alloc, n, hint);
  }

#if __cplusplus >= 202302L
  static constexpr allocation_result<pointer, size_type> allocate_at_least(
      Alloc& alloc, size_type n) {
    if constexpr (__alloc_has_allocate_at_least<Alloc, size_type>::value) {
      return alloc.allocate_at_least(n);
    } else {
      return {allocate(alloc, n), n};
    }
  }
#endif

  static constexpr void deallocate(Alloc& alloc, pointer ptr, size_type n) {
    alloc.deallocate(ptr, n);
  }

  static constexpr void construct(Alloc& alloc, pointer ptr) {
    __alloc_construct_dispatch<
        __alloc_has_construct<Alloc, value_type, __alloc_type_list<>>::value>::
        call(alloc, ptr);
  }

  static constexpr void construct(Alloc& alloc, pointer ptr,
                                  const value_type& value) {
    __alloc_construct_dispatch<
        __alloc_has_construct<Alloc, value_type,
                              __alloc_type_list<const value_type&>>::value>::
        call(alloc, ptr, value);
  }

  static constexpr void construct(Alloc& alloc, pointer ptr,
                                  value_type&& value) {
    __alloc_construct_dispatch<
        __alloc_has_construct<
            Alloc, value_type, __alloc_type_list<value_type&&>>::value>::
        call(alloc, ptr, static_cast<value_type&&>(value));
  }

  template <class T, class... Args>
  static constexpr void construct(Alloc& alloc, T* ptr, Args&&... args) {
    __alloc_construct_dispatch<
        __alloc_has_construct<Alloc, T, __alloc_type_list<Args...>>::value>::
        call(alloc, ptr, static_cast<Args&&>(args)...);
  }

  template <class T>
  static constexpr void destroy(Alloc& alloc, T* ptr) {
    __alloc_destroy_dispatch<__alloc_has_destroy<Alloc, T>::value>::call(
        alloc, ptr);
  }

  static constexpr size_type max_size(const Alloc& alloc) noexcept {
    return __alloc_max_size<Alloc, size_type>::call(alloc);
  }

  static constexpr Alloc select_on_container_copy_construction(
      const Alloc& alloc) {
    return __alloc_select_on_copy<Alloc>::call(alloc);
  }
};

