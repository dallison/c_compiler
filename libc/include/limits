//
//  C++ numeric limits for DaveCC target data models.
//

#ifndef std_limits_h
#define std_limits_h

#include <bit>
#include <cstdint>
#include <float.h>
#include <limits.h>

namespace std {

enum float_round_style {
  round_indeterminate = -1,
  round_toward_zero = 0,
  round_to_nearest = 1,
  round_toward_infinity = 2,
  round_toward_neg_infinity = 3
};

enum float_denorm_style {
  denorm_indeterminate = -1,
  denorm_absent = 0,
  denorm_present = 1
};

template <class T>
struct __numeric_limits_base {
  static constexpr bool is_specialized = false;

  static constexpr T min() noexcept { return T(); }
  static constexpr T max() noexcept { return T(); }
  static constexpr T lowest() noexcept { return T(); }
  static constexpr T epsilon() noexcept { return T(); }
  static constexpr T round_error() noexcept { return T(); }
  static constexpr T infinity() noexcept { return T(); }
  static constexpr T quiet_NaN() noexcept { return T(); }
  static constexpr T signaling_NaN() noexcept { return T(); }
  static constexpr T denorm_min() noexcept { return T(); }

  static constexpr int digits = 0;
  static constexpr int digits10 = 0;
  static constexpr int max_digits10 = 0;
  static constexpr int radix = 0;
  static constexpr int min_exponent = 0;
  static constexpr int min_exponent10 = 0;
  static constexpr int max_exponent = 0;
  static constexpr int max_exponent10 = 0;

  static constexpr bool is_signed = false;
  static constexpr bool is_integer = false;
  static constexpr bool is_exact = false;
  static constexpr bool has_infinity = false;
  static constexpr bool has_quiet_NaN = false;
  static constexpr bool has_signaling_NaN = false;
  static constexpr float_denorm_style has_denorm = denorm_absent;
  static constexpr bool has_denorm_loss = false;
  static constexpr bool is_iec559 = false;
  static constexpr bool is_bounded = false;
  static constexpr bool is_modulo = false;
  static constexpr bool traps = false;
  static constexpr bool tinyness_before = false;
  static constexpr float_round_style round_style = round_toward_zero;
};

template <class T>
class numeric_limits : public __numeric_limits_base<T> {};

template <class T, T Min, T Max, int Digits, int Digits10, bool Signed,
          bool Modulo>
struct __numeric_limits_integer : __numeric_limits_base<T> {
  static constexpr bool is_specialized = true;
  static constexpr T min() noexcept { return Min; }
  static constexpr T max() noexcept { return Max; }
  static constexpr T lowest() noexcept { return Min; }
  static constexpr int digits = Digits;
  static constexpr int digits10 = Digits10;
  static constexpr int radix = 2;
  static constexpr bool is_signed = Signed;
  static constexpr bool is_integer = true;
  static constexpr bool is_exact = true;
  static constexpr bool is_bounded = true;
  static constexpr bool is_modulo = Modulo;
};

template <>
class numeric_limits<bool> : public __numeric_limits_integer<
                                 bool, false, true, 1, 0, false, false> {};

#if CHAR_MIN < 0
template <>
class numeric_limits<char>
    : public __numeric_limits_integer<char, CHAR_MIN, CHAR_MAX, 7, 2, true,
                                      false> {};
#else
template <>
class numeric_limits<char>
    : public __numeric_limits_integer<char, CHAR_MIN, CHAR_MAX, 8, 2, false,
                                      true> {};
#endif

template <>
class numeric_limits<signed char>
    : public __numeric_limits_integer<signed char, SCHAR_MIN, SCHAR_MAX, 7, 2,
                                      true, false> {};

template <>
class numeric_limits<unsigned char>
    : public __numeric_limits_integer<unsigned char, 0, UCHAR_MAX, 8, 2, false,
                                      true> {};

#if __cplusplus >= 202002L
template <>
class numeric_limits<char8_t>
    : public __numeric_limits_integer<char8_t, 0, UCHAR_MAX, 8, 2, false,
                                      true> {};
#endif

template <>
class numeric_limits<char16_t>
    : public __numeric_limits_integer<char16_t, 0, 65535, 16, 4, false, true> {
};

template <>
class numeric_limits<char32_t>
    : public __numeric_limits_integer<char32_t, 0, 4294967295U, 32, 9, false,
                                      true> {};

#if !defined(__DAVECC__)
template <>
class numeric_limits<wchar_t>
    : public __numeric_limits_integer<
          wchar_t, static_cast<wchar_t>(WCHAR_MIN),
          static_cast<wchar_t>(WCHAR_MAX), sizeof(wchar_t) * CHAR_BIT - 1,
          sizeof(wchar_t) == 2 ? 4 : 9, true, false> {};
#endif

template <>
class numeric_limits<short>
    : public __numeric_limits_integer<short, SHRT_MIN, SHRT_MAX, 15, 4, true,
                                      false> {};

template <>
class numeric_limits<unsigned short>
    : public __numeric_limits_integer<unsigned short, 0, USHRT_MAX, 16, 4,
                                      false, true> {};

#if defined(__6502__)
template <>
class numeric_limits<int>
    : public __numeric_limits_integer<int, INT_MIN, INT_MAX, 15, 4, true,
                                      false> {};
template <>
class numeric_limits<unsigned int>
    : public __numeric_limits_integer<unsigned int, 0U, UINT_MAX, 16, 4, false,
                                      true> {};
#else
template <>
class numeric_limits<int>
    : public __numeric_limits_integer<int, INT_MIN, INT_MAX, 31, 9, true,
                                      false> {};
template <>
class numeric_limits<unsigned int>
    : public __numeric_limits_integer<unsigned int, 0U, UINT_MAX, 32, 9, false,
                                      true> {};
#endif

#if __WORDSIZE == 64 && !defined(__6502__)
template <>
class numeric_limits<long>
    : public __numeric_limits_integer<long, LONG_MIN, LONG_MAX, 63, 18, true,
                                      false> {};
template <>
class numeric_limits<unsigned long>
    : public __numeric_limits_integer<unsigned long, 0UL, ULONG_MAX, 64, 19,
                                      false, true> {};
#else
template <>
class numeric_limits<long>
    : public __numeric_limits_integer<long, LONG_MIN, LONG_MAX, 31, 9, true,
                                      false> {};
template <>
class numeric_limits<unsigned long>
    : public __numeric_limits_integer<unsigned long, 0UL, ULONG_MAX, 32, 9,
                                      false, true> {};
#endif

template <>
class numeric_limits<long long>
    : public __numeric_limits_integer<long long, LLONG_MIN, LLONG_MAX, 63, 18,
                                      true, false> {};

template <>
class numeric_limits<unsigned long long>
    : public __numeric_limits_integer<unsigned long long, 0ULL, ULLONG_MAX, 64,
                                      19, false, true> {};

namespace __limits_detail {

constexpr float __float_from_bits(uint32_t bits) {
  return bit_cast<float>(bits);
}

constexpr double __double_from_bits(uint64_t bits) {
#if DBL_MANT_DIG == FLT_MANT_DIG
  return static_cast<double>(bit_cast<float>(static_cast<uint32_t>(bits)));
#else
  return bit_cast<double>(bits);
#endif
}

template <class T>
struct __numeric_limits_float : __numeric_limits_base<T> {
  static constexpr bool is_specialized = true;
  static constexpr int radix = FLT_RADIX;
  static constexpr bool is_signed = true;
  static constexpr bool is_integer = false;
  static constexpr bool is_exact = false;
  static constexpr bool has_infinity = true;
  static constexpr bool has_quiet_NaN = true;
  static constexpr bool has_signaling_NaN = true;
  static constexpr float_denorm_style has_denorm = denorm_present;
  static constexpr bool is_iec559 = true;
  static constexpr bool is_bounded = true;
  static constexpr float_round_style round_style = round_to_nearest;
};

}  // namespace __limits_detail

template <>
class numeric_limits<float>
    : public __limits_detail::__numeric_limits_float<float> {
 public:
  static constexpr float min() noexcept { return FLT_MIN; }
  static constexpr float max() noexcept { return FLT_MAX; }
  static constexpr float lowest() noexcept { return -FLT_MAX; }
  static constexpr float epsilon() noexcept { return FLT_EPSILON; }
  static constexpr float round_error() noexcept { return 0.5F; }
  static constexpr float infinity() noexcept {
    return __limits_detail::__float_from_bits(0x7f800000U);
  }
  static constexpr float quiet_NaN() noexcept {
    return __limits_detail::__float_from_bits(0x7fc00000U);
  }
  static constexpr float signaling_NaN() noexcept {
    return __limits_detail::__float_from_bits(0x7f800001U);
  }
  static constexpr float denorm_min() noexcept { return FLT_TRUE_MIN; }
  static constexpr int digits = FLT_MANT_DIG;
  static constexpr int digits10 = FLT_DIG;
  static constexpr int max_digits10 = 2 + (FLT_MANT_DIG * 30103) / 100000;
  static constexpr int min_exponent = FLT_MIN_EXP;
  static constexpr int min_exponent10 = FLT_MIN_10_EXP;
  static constexpr int max_exponent = FLT_MAX_EXP;
  static constexpr int max_exponent10 = FLT_MAX_10_EXP;
};

template <>
class numeric_limits<double>
    : public __limits_detail::__numeric_limits_float<double> {
 public:
  static constexpr double min() noexcept { return DBL_MIN; }
  static constexpr double max() noexcept { return DBL_MAX; }
  static constexpr double lowest() noexcept { return -DBL_MAX; }
  static constexpr double epsilon() noexcept { return DBL_EPSILON; }
  static constexpr double round_error() noexcept { return 0.5; }
  static constexpr double infinity() noexcept {
#if DBL_MANT_DIG == FLT_MANT_DIG
    return __limits_detail::__double_from_bits(0x7f800000U);
#else
    return __limits_detail::__double_from_bits(0x7ff0000000000000ULL);
#endif
  }
  static constexpr double quiet_NaN() noexcept {
#if DBL_MANT_DIG == FLT_MANT_DIG
    return __limits_detail::__double_from_bits(0x7fc00000U);
#else
    return __limits_detail::__double_from_bits(0x7ff8000000000000ULL);
#endif
  }
  static constexpr double signaling_NaN() noexcept {
#if DBL_MANT_DIG == FLT_MANT_DIG
    return __limits_detail::__double_from_bits(0x7f800001U);
#else
    return __limits_detail::__double_from_bits(0x7ff0000000000001ULL);
#endif
  }
  static constexpr double denorm_min() noexcept { return DBL_TRUE_MIN; }
  static constexpr int digits = DBL_MANT_DIG;
  static constexpr int digits10 = DBL_DIG;
  static constexpr int max_digits10 = 2 + (DBL_MANT_DIG * 30103) / 100000;
  static constexpr int min_exponent = DBL_MIN_EXP;
  static constexpr int min_exponent10 = DBL_MIN_10_EXP;
  static constexpr int max_exponent = DBL_MAX_EXP;
  static constexpr int max_exponent10 = DBL_MAX_10_EXP;
};

template <>
class numeric_limits<long double> : public numeric_limits<double> {
 public:
  static constexpr long double min() noexcept { return LDBL_MIN; }
  static constexpr long double max() noexcept { return LDBL_MAX; }
  static constexpr long double lowest() noexcept { return -LDBL_MAX; }
  static constexpr long double epsilon() noexcept { return LDBL_EPSILON; }
  static constexpr long double round_error() noexcept { return 0.5L; }
  static constexpr long double infinity() noexcept {
    return static_cast<long double>(numeric_limits<double>::infinity());
  }
  static constexpr long double quiet_NaN() noexcept {
    return static_cast<long double>(numeric_limits<double>::quiet_NaN());
  }
  static constexpr long double signaling_NaN() noexcept {
    return static_cast<long double>(numeric_limits<double>::signaling_NaN());
  }
  static constexpr long double denorm_min() noexcept { return LDBL_TRUE_MIN; }
  static constexpr int digits = LDBL_MANT_DIG;
  static constexpr int digits10 = LDBL_DIG;
  static constexpr int max_digits10 = 2 + (LDBL_MANT_DIG * 30103) / 100000;
  static constexpr int min_exponent = LDBL_MIN_EXP;
  static constexpr int min_exponent10 = LDBL_MIN_10_EXP;
  static constexpr int max_exponent = LDBL_MAX_EXP;
  static constexpr int max_exponent10 = LDBL_MAX_10_EXP;
};

}  // namespace std

#endif /* std_limits_h */
