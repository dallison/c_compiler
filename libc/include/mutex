namespace __mutex_detail {

inline void __check(int result) {
  if (result != thrd_success) {
    abort();
  }
}

template <class Rep, class Period>
long long __timeout_us(const chrono::duration<Rep, Period>& timeout) {
  if (timeout <= chrono::duration<Rep, Period>::zero()) {
    return 0;
  }
  long double value =
      static_cast<long double>(timeout.count()) *
      static_cast<long double>(Period::num) * 1000000.0L /
      static_cast<long double>(Period::den);
  if (value >= 9223372036854775807.0L) {
    return 0x7fffffffffffffffLL;
  }
  if (value < 1.0L) {
    return 1;
  }
  long long rounded = static_cast<long long>(value);
  return static_cast<long double>(rounded) < value ? rounded + 1 : rounded;
}

template <class Mutex, class Rep, class Period>
bool __try_lock_for(Mutex& mutex,
                    const chrono::duration<Rep, Period>& timeout) {
  return mutex.try_lock_for(timeout);
}

template <class Mutex, class Clock, class Duration>
bool __try_lock_until(
    Mutex& mutex, const chrono::time_point<Clock, Duration>& timeout) {
  return mutex.try_lock_until(timeout);
}

template <class... Mutexes>
struct __mutex_pack;

template <>
struct __mutex_pack<> {
  __mutex_pack() {}
  void unlock() {}
};

template <class Mutex, class... Mutexes>
struct __mutex_pack<Mutex, Mutexes...> {
  Mutex& first;
  __mutex_pack<Mutexes...> rest;

  __mutex_pack(Mutex& mutex, Mutexes&... mutexes)
      : first(mutex), rest(mutexes...) {}

  void unlock() {
    first.unlock();
    rest.unlock();
  }
};

}  // namespace __mutex_detail

class mutex {
 public:
  using native_handle_type = mtx_t*;

  mutex() { __mutex_detail::__check(mtx_init(&__mutex_, mtx_plain)); }
  ~mutex() { mtx_destroy(&__mutex_); }
  mutex(const mutex&) = delete;
  mutex& operator=(const mutex&) = delete;

  void lock() { __mutex_detail::__check(mtx_lock(&__mutex_)); }
  bool try_lock() { return mtx_trylock(&__mutex_) == thrd_success; }
  void unlock() { __mutex_detail::__check(mtx_unlock(&__mutex_)); }
  native_handle_type native_handle() { return &__mutex_; }

 private:
  mtx_t __mutex_;
};

