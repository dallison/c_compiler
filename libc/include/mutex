  void lock() { __mutex_detail::__check(mtx_lock(&__mutex_)); }
  bool try_lock() { return mtx_trylock(&__mutex_) == thrd_success; }

  template <class Rep, class Period>
  bool try_lock_for(const chrono::duration<Rep, Period>& timeout) {
    return __davecc_mtx_timedlock_for(
               &__mutex_, __mutex_detail::__timeout_us(timeout)) ==
           thrd_success;
  }

  template <class Clock, class Duration>
  bool try_lock_until(const chrono::time_point<Clock, Duration>& timeout) {
    auto now = Clock::now();
