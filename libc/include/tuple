#ifndef tuple_h
#define tuple_h

#include <stddef.h>
#include <type_traits>
#include <utility>

namespace std {

template <class... Types>
struct tuple;

struct __tuple_prepend_t {
};

inline constexpr __tuple_prepend_t __tuple_prepend{};

template <>
struct tuple<> {
};

template <class T0, class... Rest>
struct tuple<T0, Rest...> {
  T0 __0;
  tuple<Rest...> __rest;

  constexpr tuple() {}
  constexpr explicit tuple(T0 v0, Rest... rest)
      : __0(static_cast<T0&&>(v0)),
        __rest(static_cast<Rest&&>(rest)...) {}
  constexpr tuple(__tuple_prepend_t, T0 v0, tuple<Rest...> rest)
      : __0(static_cast<T0&&>(v0)),
        __rest(static_cast<tuple<Rest...>&&>(rest)) {}
};

template <class T>
struct tuple_size;

template <class T1, class T2>
struct tuple_size<pair<T1, T2>> : integral_constant<size_t, 2> {
};

template <class... Types>
struct tuple_size<tuple<Types...>>
    : integral_constant<size_t, sizeof...(Types)> {
};

template <class T>
struct tuple_size<const T> : tuple_size<T> {
};

template <class T>
struct tuple_size<volatile T> : tuple_size<T> {
};

template <class T>
struct tuple_size<const volatile T> : tuple_size<T> {
};

template <class T>
constexpr size_t tuple_size_v = tuple_size<T>::value;

template <size_t I, class T>
struct tuple_element;

template <class T1, class T2>
struct tuple_element<0, pair<T1, T2>> {
  using type = T1;
};

template <class T1, class T2>
struct tuple_element<1, pair<T1, T2>> {
  using type = T2;
};

template <class T0, class... Rest>
struct tuple_element<0, tuple<T0, Rest...>> {
  using type = T0;
};

template <size_t I, class T0, class... Rest>
struct tuple_element<I, tuple<T0, Rest...>>
    : tuple_element<I - 1, tuple<Rest...>> {
};

template <size_t I, class T>
struct tuple_element<I, const T> {
  using type = const typename tuple_element<I, T>::type;
};

template <size_t I, class T>
struct tuple_element<I, volatile T> {
  using type = volatile typename tuple_element<I, T>::type;
};

template <size_t I, class T>
struct tuple_element<I, const volatile T> {
  using type = const volatile typename tuple_element<I, T>::type;
};

template <size_t I, class T>
using tuple_element_t = typename tuple_element<I, T>::type;

template <size_t I, class Tuple>
struct __tuple_getter;

template <class T0, class... Rest>
struct __tuple_getter<0, tuple<T0, Rest...>> {
  static constexpr T0& get(tuple<T0, Rest...>& value) { return value.__0; }
  static constexpr const T0& get(const tuple<T0, Rest...>& value) {
    return value.__0;
  }
};

template <size_t I, class T0, class... Rest>
struct __tuple_getter<I, tuple<T0, Rest...>> {
  static constexpr typename tuple_element<I, tuple<T0, Rest...>>::type& get(
      tuple<T0, Rest...>& value) {
    return __tuple_getter<I - 1, tuple<Rest...>>::get(value.__rest);
  }
  static constexpr const typename tuple_element<I, tuple<T0, Rest...>>::type&
  get(const tuple<T0, Rest...>& value) {
    return __tuple_getter<I - 1, tuple<Rest...>>::get(value.__rest);
  }
};

template <size_t I, class... Types>
constexpr typename tuple_element<I, tuple<Types...>>::type& get(
    tuple<Types...>& value) {
  return __tuple_getter<I, tuple<Types...>>::get(value);
}

template <size_t I, class... Types>
constexpr const typename tuple_element<I, tuple<Types...>>::type& get(
    const tuple<Types...>& value) {
  return __tuple_getter<I, tuple<Types...>>::get(value);
}

template <size_t I, class... Types>
constexpr tuple_element_t<I, tuple<Types...>>&& get(tuple<Types...>&& value) {
  using Element = tuple_element_t<I, tuple<Types...>>;
  return static_cast<Element&&>(get<I>(value));
}

template <size_t I, class... Types>
constexpr const tuple_element_t<I, tuple<Types...>>&& get(
    const tuple<Types...>&& value) {
  using Element = tuple_element_t<I, tuple<Types...>>;
  return static_cast<const Element&&>(get<I>(value));
}

template <size_t I, class T1, class T2>
struct __pair_getter;

template <class T1, class T2>
struct __pair_getter<0, T1, T2> {
  static constexpr T1& get(pair<T1, T2>& value) { return value.first; }
  static constexpr const T1& get(const pair<T1, T2>& value) {
    return value.first;
  }
};

template <class T1, class T2>
struct __pair_getter<1, T1, T2> {
  static constexpr T2& get(pair<T1, T2>& value) { return value.second; }
  static constexpr const T2& get(const pair<T1, T2>& value) {
    return value.second;
  }
};

template <size_t I, class T1, class T2>
constexpr tuple_element_t<I, pair<T1, T2>>& get(pair<T1, T2>& value) {
  static_assert(I < 2, "pair index out of range");
  return __pair_getter<I, T1, T2>::get(value);
}

template <size_t I, class T1, class T2>
constexpr const tuple_element_t<I, pair<T1, T2>>& get(
    const pair<T1, T2>& value) {
  static_assert(I < 2, "pair index out of range");
  return __pair_getter<I, T1, T2>::get(value);
}

}  // namespace std

#endif /* tuple_h */
