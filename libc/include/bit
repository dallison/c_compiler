#ifndef bit_h
#define bit_h

#include <stddef.h>
#include <type_traits>

#define __cpp_lib_bit_cast 201806L
#define __cpp_lib_bitops 201907L
#define __cpp_lib_int_pow2 202002L
#define __cpp_lib_endian 201907L

extern "C" void* memcpy(void*, const void*, size_t);

namespace std {

enum class endian {
  little = 0,
  big = 1,
  native = little,
};

namespace __bit_detail {

template <class T>
struct __is_unsigned_integer : false_type {
};

template <>
struct __is_unsigned_integer<unsigned char> : true_type {
};

template <>
struct __is_unsigned_integer<unsigned short> : true_type {
};

template <>
struct __is_unsigned_integer<unsigned int> : true_type {
};

template <>
struct __is_unsigned_integer<unsigned long> : true_type {
};

template <>
struct __is_unsigned_integer<unsigned long long> : true_type {
};

template <class T>
inline constexpr bool __is_unsigned_integer_v =
    __is_unsigned_integer<T>::value;

template <class T>
inline constexpr int __digits = static_cast<int>(sizeof(T) * 8);

}  // namespace __bit_detail

template <class To, class From>
requires(sizeof(To) == sizeof(From) && is_trivially_copyable_v<To> &&
         is_trivially_copyable_v<From>)
constexpr To bit_cast(const From& from) noexcept {
  To result;
  ::memcpy(&result, &from, sizeof(To));
  return result;
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr T rotl(T x, int s) noexcept {
  constexpr int n = __bit_detail::__digits<T>;
  const int r = s % n;
  if (r == 0) {
    return x;
  }
  if (r > 0) {
    return static_cast<T>((x << r) | (x >> (n - r)));
  }
  return static_cast<T>((x >> -r) | (x << (n + r)));
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr T rotr(T x, int s) noexcept {
  return rotl(x, -s);
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr int countl_zero(T x) noexcept {
  int count = 0;
  for (int bit = __bit_detail::__digits<T> - 1; bit >= 0; --bit) {
    if ((x & (static_cast<T>(1) << bit)) != 0) {
      break;
    }
    ++count;
  }
  return count;
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr int countl_one(T x) noexcept {
  return countl_zero(static_cast<T>(~x));
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr int countr_zero(T x) noexcept {
  if (x == 0) {
    return __bit_detail::__digits<T>;
  }
  int count = 0;
  while ((x & static_cast<T>(1)) == 0) {
    x >>= 1;
    ++count;
  }
  return count;
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr int countr_one(T x) noexcept {
  return countr_zero(static_cast<T>(~x));
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr int popcount(T x) noexcept {
  int count = 0;
  while (x != 0) {
    x &= static_cast<T>(x - 1);
    ++count;
  }
  return count;
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr bool has_single_bit(T x) noexcept {
  return x != 0 && (x & static_cast<T>(x - 1)) == 0;
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr T bit_floor(T x) noexcept {
  if (x == 0) {
    return 0;
  }
  return static_cast<T>(
      static_cast<T>(1)
      << (__bit_detail::__digits<T> - 1 - countl_zero(x)));
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr T bit_ceil(T x) noexcept {
  if (x <= 1) {
    return 1;
  }
  return static_cast<T>(
      static_cast<T>(1)
      << (__bit_detail::__digits<T> - countl_zero(static_cast<T>(x - 1))));
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr int bit_width(T x) noexcept {
  return __bit_detail::__digits<T> - countl_zero(x);
}

}  // namespace std

#endif /* bit_h */
