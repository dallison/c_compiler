#if __cplusplus >= 202700L
template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr T bit_reverse(T x) noexcept {
  T result = 0;
  for (int i = 0; i < __bit_detail::__digits<T>; ++i) {
    result = static_cast<T>(
        static_cast<T>(result << 1) | static_cast<T>(x & T(1)));
    x = static_cast<T>(x >> 1);
  }
  return result;
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr T bit_repeat(T x, int length) noexcept(false) {
  if (length <= 0) {
    ::abort();
  }
  T result = 0;
  for (int i = 0; i < __bit_detail::__digits<T>; ++i) {
    T bit = static_cast<T>((x >> (i % length)) & T(1));
    result = static_cast<T>(result | static_cast<T>(bit << i));
  }
  return result;
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr T bit_compress(T x, T mask) noexcept {
  T result = 0;
  int destination = 0;
  for (int source = 0; source < __bit_detail::__digits<T>; ++source) {
    if (((mask >> source) & T(1)) != 0) {
      T bit = static_cast<T>((x >> source) & T(1));
      result = static_cast<T>(
          result | static_cast<T>(bit << destination));
      ++destination;
    }
  }
  return result;
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr T bit_expand(T x, T mask) noexcept {
  T result = 0;
  int source = 0;
  for (int destination = 0;
       destination < __bit_detail::__digits<T>; ++destination) {
    if (((mask >> destination) & T(1)) != 0) {
      T bit = static_cast<T>((x >> source) & T(1));
      result = static_cast<T>(
          result | static_cast<T>(bit << destination));
      ++source;
    }
  }
  return result;
}
#endif

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr bool has_single_bit(T x) noexcept {
  return x != 0 && (x & static_cast<T>(x - 1)) == 0;
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr T bit_floor(T x) noexcept {
  if (x == 0) {
    return 0;
  }
  return static_cast<T>(
      static_cast<T>(1)
      << (__bit_detail::__digits<T> - 1 - countl_zero(x)));
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr T bit_ceil(T x) noexcept {
  if (x <= 1) {
    return 1;
  }
  return static_cast<T>(
      static_cast<T>(1)
      << (__bit_detail::__digits<T> - countl_zero(static_cast<T>(x - 1))));
}

template <class T>
requires __bit_detail::__is_unsigned_integer_v<T>
constexpr int bit_width(T x) noexcept {
  return __bit_detail::__digits<T> - countl_zero(x);
}

