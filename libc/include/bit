namespace __bit_detail {

template <class T>
struct __is_unsigned_integer : false_type {
};

template <>
struct __is_unsigned_integer<unsigned char> : true_type {
};

template <>
struct __is_unsigned_integer<unsigned short> : true_type {
};

template <>
struct __is_unsigned_integer<unsigned int> : true_type {
};

template <>
struct __is_unsigned_integer<unsigned long> : true_type {
};

template <>
struct __is_unsigned_integer<unsigned long long> : true_type {
};

template <class T>
inline constexpr bool __is_unsigned_integer_v =
    __is_unsigned_integer<T>::value;

template <class T>
struct __is_shift_integer : false_type {
};

#define __DAVECC_SHIFT_INTEGER(type)            \
  template <>                                   \
  struct __is_shift_integer<type> : true_type { \
  }

__DAVECC_SHIFT_INTEGER(signed char);
__DAVECC_SHIFT_INTEGER(unsigned char);
__DAVECC_SHIFT_INTEGER(short);
__DAVECC_SHIFT_INTEGER(unsigned short);
__DAVECC_SHIFT_INTEGER(int);
__DAVECC_SHIFT_INTEGER(unsigned int);
__DAVECC_SHIFT_INTEGER(long);
__DAVECC_SHIFT_INTEGER(unsigned long);
__DAVECC_SHIFT_INTEGER(long long);
__DAVECC_SHIFT_INTEGER(unsigned long long);

#undef __DAVECC_SHIFT_INTEGER

template <class T>
inline constexpr bool __is_shift_integer_v =
    __is_shift_integer<T>::value;

template <class T>
inline constexpr int __digits = static_cast<int>(sizeof(T) * 8);

#if __cplusplus >= 202700L
template <class T, class S>
constexpr T __shift_left_nonnegative(T x, S s) noexcept {
  using U = make_unsigned_t<T>;
  using US = make_unsigned_t<S>;
  US amount = static_cast<US>(s);
  if (amount >= static_cast<unsigned int>(__digits<T>)) {
    return T(0);
  }
  return static_cast<T>(
      static_cast<U>(x) << static_cast<unsigned int>(amount));
}

template <class T, class S>
constexpr T __shift_right_nonnegative(T x, S s) noexcept {
  using US = make_unsigned_t<S>;
  US amount = static_cast<US>(s);
  if (amount >= static_cast<unsigned int>(__digits<T>)) {
    if constexpr (is_signed_v<T>) {
      return x < 0 ? T(-1) : T(0);
    }
    return T(0);
  }
  return static_cast<T>(x >> static_cast<unsigned int>(amount));
}
#endif

#define __DAVECC_BIT_COUNT_OVERLOAD(type, width)                            \
  constexpr int __countl_zero(type value) noexcept {                        \
    return __davecc_clz(value, width);                                       \
  }                                                                          \
  constexpr int __countr_zero(type value) noexcept {                         \
    return __davecc_ctz(value, width);                                       \
  }                                                                          \
  constexpr int __popcount(type value) noexcept {                            \
    return __davecc_popcount(value, width);                                  \
  }

__DAVECC_BIT_COUNT_OVERLOAD(unsigned char, 8)
__DAVECC_BIT_COUNT_OVERLOAD(unsigned short, 16)
__DAVECC_BIT_COUNT_OVERLOAD(unsigned int, sizeof(unsigned int) * 8)
__DAVECC_BIT_COUNT_OVERLOAD(unsigned long, sizeof(unsigned long) * 8)
__DAVECC_BIT_COUNT_OVERLOAD(unsigned long long, sizeof(unsigned long long) * 8)

#undef __DAVECC_BIT_COUNT_OVERLOAD

}  // namespace __bit_detail

template <class To, class From>
requires(sizeof(To) == sizeof(From) && is_trivially_copyable_v<To> &&
         is_trivially_copyable_v<From>)
constexpr To bit_cast(const From& from) noexcept {
  To result;
  ::memcpy(&result, &from, sizeof(To));
  return result;
}

#if __cplusplus >= 202700L
template <class T, class S>
requires(__bit_detail::__is_shift_integer_v<T> &&
         __bit_detail::__is_shift_integer_v<S>)
constexpr T shl(T x, S s) noexcept {
  if constexpr (is_signed_v<S>) {
    if (s < 0) {
      using US = make_unsigned_t<S>;
      US amount = US(0) - static_cast<US>(s);
      return __bit_detail::__shift_right_nonnegative(x, amount);
    }
  }
  return __bit_detail::__shift_left_nonnegative(x, s);
}

template <class T, class S>
requires(__bit_detail::__is_shift_integer_v<T> &&
         __bit_detail::__is_shift_integer_v<S>)
constexpr T shr(T x, S s) noexcept {
  if constexpr (is_signed_v<S>) {
    if (s < 0) {
      using US = make_unsigned_t<S>;
      US amount = US(0) - static_cast<US>(s);
      return __bit_detail::__shift_left_nonnegative(x, amount);
    }
  }
  return __bit_detail::__shift_right_nonnegative(x, s);
}
#endif

