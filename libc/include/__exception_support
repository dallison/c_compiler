#ifndef __davecc_exception_support__
#define __davecc_exception_support__

#ifdef __cpp_exceptions
#define __DAVECC_TRY try
#define __DAVECC_CATCH_ALL catch (...)
#define __DAVECC_RETHROW throw
#define __DAVECC_THROW(value) throw value
#else
extern "C" {
[[noreturn]] void abort(void);
}
#define __DAVECC_TRY if (true)
#define __DAVECC_CATCH_ALL if (false)
#define __DAVECC_RETHROW ((void)0)
#define __DAVECC_THROW(value) ::abort()
#endif

#endif
