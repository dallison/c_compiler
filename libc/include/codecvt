#ifndef __davecc_codecvt__
#define __davecc_codecvt__

#if __cplusplus >= 202600L
#error "<codecvt> was removed in C++26"
#endif

#include <cstddef>
#include <cstdint>
#include <cwchar>
#include <locale>

namespace std {

enum codecvt_mode {
  consume_header = 4,
  generate_header = 2,
  little_endian = 1,
};

namespace __codecvt_detail {

inline int __decode_utf8(const char* input, const char* end,
                         const char*& next, uint32_t& value) {
  next = input;
  if (input == end) return 0;
  unsigned char first = static_cast<unsigned char>(*input);
  unsigned count;
  uint32_t code;
  if (first < 0x80) {
    count = 1;
    code = first;
  } else if (first >= 0xc2 && first <= 0xdf) {
    count = 2;
    code = first & 0x1f;
  } else if (first >= 0xe0 && first <= 0xef) {
    count = 3;
    code = first & 0x0f;
  } else if (first >= 0xf0 && first <= 0xf4) {
    count = 4;
    code = first & 0x07;
  } else {
    return -1;
  }
  if (static_cast<size_t>(end - input) < count) return 0;
  for (unsigned i = 1; i < count; ++i) {
    unsigned char byte = static_cast<unsigned char>(input[i]);
    if ((byte & 0xc0) != 0x80) return -1;
    code = (code << 6) | (byte & 0x3f);
  }
  if ((count == 3 && code < 0x800) ||
      (count == 4 && code < 0x10000) ||
      (code >= 0xd800 && code <= 0xdfff) || code > 0x10ffff) {
    return -1;
  }
  value = code;
  next = input + count;
  return 1;
}

inline int __encode_utf8(uint32_t value, char* output, char* end,
                         char*& next) {
  next = output;
  unsigned count;
  if (value <= 0x7f) {
    count = 1;
  } else if (value <= 0x7ff) {
    count = 2;
  } else if (value <= 0xffff) {
    if (value >= 0xd800 && value <= 0xdfff) return -1;
    count = 3;
  } else if (value <= 0x10ffff) {
    count = 4;
  } else {
    return -1;
  }
  if (static_cast<size_t>(end - output) < count) return 0;
  if (count == 1) {
    output[0] = static_cast<char>(value);
  } else if (count == 2) {
    output[0] = static_cast<char>(0xc0 | (value >> 6));
    output[1] = static_cast<char>(0x80 | (value & 0x3f));
  } else if (count == 3) {
    output[0] = static_cast<char>(0xe0 | (value >> 12));
    output[1] = static_cast<char>(0x80 | ((value >> 6) & 0x3f));
    output[2] = static_cast<char>(0x80 | (value & 0x3f));
  } else {
    output[0] = static_cast<char>(0xf0 | (value >> 18));
    output[1] = static_cast<char>(0x80 | ((value >> 12) & 0x3f));
    output[2] = static_cast<char>(0x80 | ((value >> 6) & 0x3f));
    output[3] = static_cast<char>(0x80 | (value & 0x3f));
  }
  next = output + count;
  return 1;
}

inline uint16_t __read_u16(const char* input, bool little) {
  unsigned char first = static_cast<unsigned char>(input[0]);
  unsigned char second = static_cast<unsigned char>(input[1]);
  return little ? static_cast<uint16_t>(first | (second << 8))
                : static_cast<uint16_t>((first << 8) | second);
}

inline void __write_u16(uint16_t value, bool little, char* output) {
  if (little) {
    output[0] = static_cast<char>(value & 0xff);
    output[1] = static_cast<char>(value >> 8);
  } else {
    output[0] = static_cast<char>(value >> 8);
    output[1] = static_cast<char>(value & 0xff);
  }
}

inline bool __header_seen(const mbstate_t& state) { return state.__count != 0; }

inline void __set_header_seen(mbstate_t& state, bool little = false) {
  state.__count = 1;
  state.__has_pending = little ? 1 : 0;
}

inline bool __utf16_little(const mbstate_t& state, bool mode_little) {
  return __header_seen(state) ? state.__has_pending != 0 : mode_little;
}

inline codecvt_base::result __emit_utf8_bom(mbstate_t& state, char*& to,
                                            char* to_end) {
  if (__header_seen(state)) {
    return codecvt_base::ok;
  }
  if (to_end - to < 3) {
    return codecvt_base::partial;
  }
  *to++ = static_cast<char>(0xef);
  *to++ = static_cast<char>(0xbb);
  *to++ = static_cast<char>(0xbf);
  __set_header_seen(state);
  return codecvt_base::ok;
}

inline codecvt_base::result __consume_utf8_bom(mbstate_t& state,
                                               const char*& from,
                                               const char* from_end) {
  if (__header_seen(state) || from == from_end) {
    return codecvt_base::ok;
  }
  unsigned char first = static_cast<unsigned char>(*from);
  if (first != 0xef) {
    __set_header_seen(state);
    return codecvt_base::ok;
  }
  if (from_end - from < 3) {
    return codecvt_base::partial;
  }
  if (static_cast<unsigned char>(from[1]) == 0xbb &&
      static_cast<unsigned char>(from[2]) == 0xbf) {
    from += 3;
  }
  __set_header_seen(state);
  return codecvt_base::ok;
}

inline codecvt_base::result __emit_utf16_bom(mbstate_t& state, bool little,
                                             char*& to, char* to_end) {
  if (__header_seen(state)) {
    return codecvt_base::ok;
  }
  if (to_end - to < 2) {
    return codecvt_base::partial;
  }
  __write_u16(0xfeff, little, to);
  to += 2;
  __set_header_seen(state, little);
  return codecvt_base::ok;
}

inline codecvt_base::result __consume_utf16_bom(mbstate_t& state, bool little,
                                                const char*& from,
                                                const char* from_end) {
  if (__header_seen(state)) {
    return codecvt_base::ok;
  }
  if (from == from_end) {
    return codecvt_base::ok;
  }
  if (from_end - from < 2) {
    return codecvt_base::partial;
  }
  uint16_t marker = __read_u16(from, little);
  if (marker == 0xfeff) {
    from += 2;
    __set_header_seen(state, little);
  } else if (marker == 0xfffe) {
    from += 2;
    __set_header_seen(state, !little);
  } else {
    __set_header_seen(state, little);
  }
  return codecvt_base::ok;
}

}  // namespace __codecvt_detail

template <class Elem, unsigned long Maxcode = 0x10ffff,
          codecvt_mode Mode = static_cast<codecvt_mode>(0)>
class codecvt_utf8 : public codecvt<Elem, char, mbstate_t> {
 public:
  explicit codecvt_utf8(size_t refs = 0)
      : codecvt<Elem, char, mbstate_t>(refs) {}

 protected:
  typename codecvt_base::result do_out(
      mbstate_t& state, const Elem* from, const Elem* from_end,
      const Elem*& from_next, char* to, char* to_end,
      char*& to_next) const override {
    from_next = from;
    to_next = to;
    if ((Mode & generate_header) != 0) {
      codecvt_base::result bom =
          __codecvt_detail::__emit_utf8_bom(state, to_next, to_end);
      if (bom != codecvt_base::ok) return bom;
    }
    while (from_next != from_end) {
      uint32_t value = static_cast<uint32_t>(*from_next);
      if (value > Maxcode || (sizeof(Elem) == 2 && value > 0xffff)) {
        return codecvt_base::error;
      }
      char* encoded_next;
      int status = __codecvt_detail::__encode_utf8(
          value, to_next, to_end, encoded_next);
      if (status < 0) return codecvt_base::error;
      if (status == 0) return codecvt_base::partial;
      to_next = encoded_next;
      ++from_next;
    }
    return codecvt_base::ok;
  }

  typename codecvt_base::result do_in(
      mbstate_t& state, const char* from, const char* from_end,
      const char*& from_next, Elem* to, Elem* to_end,
      Elem*& to_next) const override {
    from_next = from;
    to_next = to;
    if ((Mode & consume_header) != 0) {
      codecvt_base::result bom =
          __codecvt_detail::__consume_utf8_bom(state, from_next, from_end);
      if (bom != codecvt_base::ok) return bom;
    }
    while (from_next != from_end) {
      if (to_next == to_end) return codecvt_base::partial;
      const char* decoded_next;
      uint32_t value;
      int status = __codecvt_detail::__decode_utf8(
          from_next, from_end, decoded_next, value);
      if (status == 0) return codecvt_base::partial;
      if (status < 0 || value > Maxcode ||
          (sizeof(Elem) == 2 && value > 0xffff)) {
        return codecvt_base::error;
      }
      *to_next++ = static_cast<Elem>(value);
      from_next = decoded_next;
    }
    return codecvt_base::ok;
  }

  typename codecvt_base::result do_unshift(
      mbstate_t&, char* to, char*, char*& to_next) const override {
    to_next = to;
    return codecvt_base::ok;
  }
  int do_encoding() const noexcept override { return 0; }
  bool do_always_noconv() const noexcept override { return false; }
  int do_length(mbstate_t& state, const char* from, const char* from_end,
                size_t max) const override {
    const char* current = from;
    size_t converted = 0;
    if ((Mode & consume_header) != 0 &&
        !__codecvt_detail::__header_seen(state) && from_end - current >= 3 &&
        static_cast<unsigned char>(current[0]) == 0xef &&
        static_cast<unsigned char>(current[1]) == 0xbb &&
        static_cast<unsigned char>(current[2]) == 0xbf) {
      current += 3;
    }
    while (current != from_end && converted < max) {
      const char* next;
      uint32_t value;
      if (__codecvt_detail::__decode_utf8(
              current, from_end, next, value) != 1 ||
          value > Maxcode || (sizeof(Elem) == 2 && value > 0xffff)) {
        break;
      }
      current = next;
      ++converted;
    }
    return static_cast<int>(current - from);
  }
  int do_max_length() const noexcept override {
    return (Mode & consume_header) != 0 ? 7 : 4;
  }
};

template <class Elem, unsigned long Maxcode = 0x10ffff,
          codecvt_mode Mode = static_cast<codecvt_mode>(0)>
class codecvt_utf8_utf16 : public codecvt<Elem, char, mbstate_t> {
 public:
  explicit codecvt_utf8_utf16(size_t refs = 0)
      : codecvt<Elem, char, mbstate_t>(refs) {}

 protected:
  typename codecvt_base::result do_out(
      mbstate_t& state, const Elem* from, const Elem* from_end,
      const Elem*& from_next, char* to, char* to_end,
      char*& to_next) const override {
    from_next = from;
    to_next = to;
    if ((Mode & generate_header) != 0) {
      codecvt_base::result bom =
          __codecvt_detail::__emit_utf8_bom(state, to_next, to_end);
      if (bom != codecvt_base::ok) return bom;
    }
    while (from_next != from_end) {
      uint32_t value = static_cast<uint16_t>(*from_next);
      size_t consumed = 1;
      if (value >= 0xd800 && value <= 0xdbff) {
        if (from_end - from_next < 2) return codecvt_base::partial;
        uint32_t low = static_cast<uint16_t>(from_next[1]);
        if (low < 0xdc00 || low > 0xdfff) return codecvt_base::error;
        value = 0x10000 + ((value - 0xd800) << 10) + (low - 0xdc00);
        consumed = 2;
      } else if (value >= 0xdc00 && value <= 0xdfff) {
        return codecvt_base::error;
      }
      if (value > Maxcode) return codecvt_base::error;
      char* encoded_next;
      int status = __codecvt_detail::__encode_utf8(
          value, to_next, to_end, encoded_next);
      if (status < 0) return codecvt_base::error;
      if (status == 0) return codecvt_base::partial;
      from_next += consumed;
      to_next = encoded_next;
    }
    return codecvt_base::ok;
  }

  typename codecvt_base::result do_in(
      mbstate_t& state, const char* from, const char* from_end,
      const char*& from_next, Elem* to, Elem* to_end,
      Elem*& to_next) const override {
    from_next = from;
    to_next = to;
    if ((Mode & consume_header) != 0) {
      codecvt_base::result bom =
          __codecvt_detail::__consume_utf8_bom(state, from_next, from_end);
      if (bom != codecvt_base::ok) return bom;
    }
    while (from_next != from_end) {
      const char* decoded_next;
      uint32_t value;
      int status = __codecvt_detail::__decode_utf8(
          from_next, from_end, decoded_next, value);
      if (status == 0) return codecvt_base::partial;
      if (status < 0 || value > Maxcode) return codecvt_base::error;
      size_t needed = value > 0xffff ? 2 : 1;
      if (static_cast<size_t>(to_end - to_next) < needed) {
        return codecvt_base::partial;
      }
      if (needed == 1) {
        *to_next++ = static_cast<Elem>(value);
      } else {
        value -= 0x10000;
        *to_next++ = static_cast<Elem>(0xd800 + (value >> 10));
        *to_next++ = static_cast<Elem>(0xdc00 + (value & 0x3ff));
      }
      from_next = decoded_next;
    }
    return codecvt_base::ok;
  }

  typename codecvt_base::result do_unshift(
      mbstate_t&, char* to, char*, char*& to_next) const override {
    to_next = to;
    return codecvt_base::ok;
  }
  int do_encoding() const noexcept override { return 0; }
  bool do_always_noconv() const noexcept override { return false; }
  int do_length(mbstate_t& state, const char* from, const char* from_end,
                size_t max) const override {
    const char* current = from;
    size_t units = 0;
    if ((Mode & consume_header) != 0 &&
        !__codecvt_detail::__header_seen(state) && from_end - current >= 3 &&
        static_cast<unsigned char>(current[0]) == 0xef &&
        static_cast<unsigned char>(current[1]) == 0xbb &&
        static_cast<unsigned char>(current[2]) == 0xbf) {
      current += 3;
    }
    while (current != from_end) {
      const char* next;
      uint32_t value;
      if (__codecvt_detail::__decode_utf8(
              current, from_end, next, value) != 1 ||
          value > Maxcode) {
        break;
      }
      size_t needed = value > 0xffff ? 2 : 1;
      if (units + needed > max) break;
      units += needed;
      current = next;
    }
    return static_cast<int>(current - from);
  }
  int do_max_length() const noexcept override {
    return (Mode & consume_header) != 0 ? 7 : 4;
  }
};

template <class Elem, unsigned long Maxcode = 0x10ffff,
          codecvt_mode Mode = static_cast<codecvt_mode>(0)>
class codecvt_utf16 : public codecvt<Elem, char, mbstate_t> {
 public:
  explicit codecvt_utf16(size_t refs = 0)
      : codecvt<Elem, char, mbstate_t>(refs) {}

 protected:
  typename codecvt_base::result do_out(
      mbstate_t& state, const Elem* from, const Elem* from_end,
      const Elem*& from_next, char* to, char* to_end,
      char*& to_next) const override {
    from_next = from;
    to_next = to;
    bool little = __codecvt_detail::__utf16_little(
        state, (Mode & little_endian) != 0);
    if ((Mode & generate_header) != 0) {
      codecvt_base::result bom = __codecvt_detail::__emit_utf16_bom(
          state, little, to_next, to_end);
      if (bom != codecvt_base::ok) return bom;
      little = __codecvt_detail::__utf16_little(state, little);
    }
    while (from_next != from_end) {
      uint32_t value = static_cast<uint32_t>(*from_next);
      if (value > Maxcode || (value >= 0xd800 && value <= 0xdfff)) {
        return codecvt_base::error;
      }
      size_t needed = value > 0xffff ? 4 : 2;
      if (static_cast<size_t>(to_end - to_next) < needed) {
        return codecvt_base::partial;
      }
      if (needed == 2) {
        __codecvt_detail::__write_u16(static_cast<uint16_t>(value),
                                      little, to_next);
      } else {
        value -= 0x10000;
        __codecvt_detail::__write_u16(
            static_cast<uint16_t>(0xd800 + (value >> 10)),
            little, to_next);
        __codecvt_detail::__write_u16(
            static_cast<uint16_t>(0xdc00 + (value & 0x3ff)),
            little, to_next + 2);
      }
      to_next += needed;
      ++from_next;
    }
    return codecvt_base::ok;
  }

  typename codecvt_base::result do_in(
      mbstate_t& state, const char* from, const char* from_end,
      const char*& from_next, Elem* to, Elem* to_end,
      Elem*& to_next) const override {
    from_next = from;
    to_next = to;
    bool little = __codecvt_detail::__utf16_little(
        state, (Mode & little_endian) != 0);
    if ((Mode & consume_header) != 0) {
      codecvt_base::result bom = __codecvt_detail::__consume_utf16_bom(
          state, little, from_next, from_end);
      if (bom != codecvt_base::ok) return bom;
      little = __codecvt_detail::__utf16_little(state, little);
    }
    while (from_next != from_end) {
      if (from_end - from_next < 2 || to_next == to_end) {
        return codecvt_base::partial;
      }
      uint32_t value = __codecvt_detail::__read_u16(from_next, little);
      size_t consumed = 2;
      if (value >= 0xd800 && value <= 0xdbff) {
        if (from_end - from_next < 4) return codecvt_base::partial;
        uint32_t low =
            __codecvt_detail::__read_u16(from_next + 2, little);
        if (low < 0xdc00 || low > 0xdfff) return codecvt_base::error;
        value = 0x10000 + ((value - 0xd800) << 10) + (low - 0xdc00);
        consumed = 4;
      } else if (value >= 0xdc00 && value <= 0xdfff) {
        return codecvt_base::error;
      }
      if (value > Maxcode) return codecvt_base::error;
      *to_next++ = static_cast<Elem>(value);
      from_next += consumed;
    }
    return codecvt_base::ok;
  }

  typename codecvt_base::result do_unshift(
      mbstate_t&, char* to, char*, char*& to_next) const override {
    to_next = to;
    return codecvt_base::ok;
  }
  int do_encoding() const noexcept override { return 0; }
  bool do_always_noconv() const noexcept override { return false; }
  int do_length(mbstate_t& state, const char* from, const char* from_end,
                size_t max) const override {
    const char* current = from;
    size_t converted = 0;
    bool little = __codecvt_detail::__utf16_little(
        state, (Mode & little_endian) != 0);
    if ((Mode & consume_header) != 0 &&
        !__codecvt_detail::__header_seen(state) && from_end - current >= 2) {
      uint16_t marker = __codecvt_detail::__read_u16(current, little);
      if (marker == 0xfeff) {
        current += 2;
      } else if (marker == 0xfffe) {
        little = !little;
        current += 2;
      }
    }
    while (current != from_end && converted < max) {
      if (from_end - current < 2) break;
      uint32_t value = __codecvt_detail::__read_u16(current, little);
      size_t consumed = 2;
      if (value >= 0xd800 && value <= 0xdbff) {
        if (from_end - current < 4) break;
        uint32_t low = __codecvt_detail::__read_u16(current + 2, little);
        if (low < 0xdc00 || low > 0xdfff) break;
        value = 0x10000 + ((value - 0xd800) << 10) + (low - 0xdc00);
        consumed = 4;
      } else if (value >= 0xdc00 && value <= 0xdfff) {
        break;
      }
      if (value > Maxcode) break;
      current += consumed;
      ++converted;
    }
    return static_cast<int>(current - from);
  }
  int do_max_length() const noexcept override {
    return (Mode & consume_header) != 0 ? 6 : 4;
  }
};

}  // namespace std

#endif /* __davecc_codecvt__ */
