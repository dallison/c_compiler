template <class CharT, class Traits>
basic_ostream<CharT, Traits>& operator<<(basic_ostream<CharT, Traits>& output,
                                        const path& value) {
  output << static_cast<CharT>('"');
  for (char item : value.native()) {
    if (item == '"' || item == '\\') output << static_cast<CharT>('\\');
    output << static_cast<CharT>(item);
  }
  output << static_cast<CharT>('"');
  return output;
}

template <class CharT, class Traits>
basic_istream<CharT, Traits>& operator>>(basic_istream<CharT, Traits>& input,
                                        path& value) {
  basic_string<CharT> text;
  input >> text;
  string converted;
  for (CharT item : text) converted.push_back(static_cast<char>(item));
  value = path(static_cast<string&&>(converted));
  return input;
}

template <class Source>
path u8path(const Source& source) {
  string converted;
  for (auto item : source) converted.push_back(static_cast<char>(item));
  return path(static_cast<string&&>(converted));
}
template <class InputIt>
path u8path(InputIt first, InputIt last) {
  string converted;
  while (first != last) {
    converted.push_back(static_cast<char>(*first));
    ++first;
  }
  return path(static_cast<string&&>(converted));
}

