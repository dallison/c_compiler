class path {
 public:
  using value_type = char;
  using string_type = string;
  static constexpr value_type preferred_separator = '/';

  enum format {
    native_format,
    generic_format,
    auto_format,
  };

  class iterator;

  path() noexcept = default;
  path(const path&) = default;
  path(path&&) noexcept = default;
  path(const string_type& source, format = auto_format) : __value(source) {}
  path(string_type&& source, format = auto_format)
      : __value(static_cast<string_type&&>(source)) {}
  path(const value_type* source, format = auto_format)
      : __value(source == nullptr ? "" : source) {}
  path(string_view source, format = auto_format)
      : __value(source.data(), source.size()) {}

  template <class InputIt>
  path(InputIt first, InputIt last, format = auto_format) {
    while (first != last) {
      __value.push_back(static_cast<value_type>(*first));
      ++first;
    }
  }

  ~path() = default;

  path& operator=(const path&) = default;
  path& operator=(path&&) noexcept = default;
  path& operator=(const string_type& source) {
    __value = source;
    return *this;
  }
  path& operator=(string_type&& source) {
    __value = static_cast<string_type&&>(source);
    return *this;
  }
  path& operator=(const value_type* source) {
    __value = source == nullptr ? "" : source;
    return *this;
  }

  path& assign(const string_type& source) { return *this = source; }
  path& assign(const value_type* source) { return *this = source; }
  template <class InputIt>
  path& assign(InputIt first, InputIt last) {
    __value.clear();
    while (first != last) {
      __value.push_back(static_cast<value_type>(*first));
      ++first;
    }
    return *this;
  }

  path& operator/=(const path& other) {
    if (other.is_absolute()) {
      __value = other.__value;
      return *this;
    }
    if (__value.empty()) {
      __value = other.__value;
      return *this;
    }
    if (__value.back() != preferred_separator) {
      __value.push_back(preferred_separator);
    }
    __value.append(other.__value);
    return *this;
  }

  path& append(const path& other) { return *this /= other; }
  path& append(const string_type& source) { return *this /= path(source); }
  path& append(const value_type* source) { return *this /= path(source); }

  path& operator+=(const path& other) {
    __value.append(other.__value);
    return *this;
  }
  path& operator+=(const string_type& source) {
    __value.append(source);
    return *this;
  }
  path& operator+=(string_view source) {
    __value.append(source.data(), source.size());
    return *this;
  }
  path& operator+=(const value_type* source) {
    __value.append(source);
    return *this;
  }
  path& operator+=(value_type value) {
    __value.push_back(value);
    return *this;
  }
  path& concat(const path& other) { return *this += other; }
  path& concat(const string_type& source) { return *this += source; }
  path& concat(const value_type* source) { return *this += source; }

  void clear() noexcept { __value.clear(); }
  path& make_preferred() noexcept { return *this; }
  path& remove_filename() {
    *this = parent_path();
    if (!__value.empty() && __value.back() != preferred_separator) {
      __value.push_back(preferred_separator);
    }
    return *this;
  }
  path& replace_filename(const path& replacement) {
    remove_filename();
    return *this /= replacement;
  }
  path& replace_extension(const path& replacement = path()) {
    path extension_value = extension();
    if (!extension_value.empty()) {
      __value.resize(__value.size() - extension_value.__value.size());
    }
    if (!replacement.empty()) {
      if (replacement.__value[0] != '.') {
        __value.push_back('.');
      }
      __value.append(replacement.__value);
    }
    return *this;
  }
  void swap(path& other) noexcept { __value.swap(other.__value); }

  const string_type& native() const noexcept { return __value; }
  const value_type* c_str() const noexcept { return __value.c_str(); }
  operator string_type() const { return __value; }
  string_type string() const { return __value; }
  std::wstring wstring() const {
    std::wstring result;
    for (char value : __value) result.push_back(static_cast<wchar_t>(value));
    return result;
  }
#if __cplusplus >= 202002L
  std::u8string u8string() const {
    std::u8string result;
    for (char value : __value) result.push_back(static_cast<char8_t>(value));
    return result;
  }
#else
  string_type u8string() const { return __value; }
#endif
  std::u16string u16string() const {
    std::u16string result;
    for (char value : __value) result.push_back(static_cast<char16_t>(value));
    return result;
  }
  std::u32string u32string() const {
    std::u32string result;
    for (char value : __value) result.push_back(static_cast<char32_t>(value));
    return result;
  }
  string_type generic_string() const { return __value; }
  std::wstring generic_wstring() const { return wstring(); }
#if __cplusplus >= 202002L
  std::u8string generic_u8string() const { return u8string(); }
#else
  string_type generic_u8string() const { return __value; }
#endif
  std::u16string generic_u16string() const { return u16string(); }
  std::u32string generic_u32string() const { return u32string(); }

  int compare(const path& other) const noexcept {
    return __value.compare(other.__value);
  }
  int compare(const string_type& other) const noexcept {
    return __value.compare(other);
  }
  int compare(const value_type* other) const noexcept {
    return __value.compare(other);
  }

  path root_name() const { return path(); }
  path root_directory() const {
    return is_absolute() ? path("/") : path();
  }
  path root_path() const { return root_directory(); }
  path relative_path() const {
    size_t start = __value.empty() || __value[0] != '/' ? 0 : 1;
    while (start < __value.size() && __value[start] == '/') ++start;
    return path(__value.substr(start));
  }
  path parent_path() const {
    if (__value.empty()) return path();
    size_t end = __value.size();
    while (end > 1 && __value[end - 1] == '/') --end;
    if (end == 1 && __value[0] == '/') return path("/");
    size_t slash = end;
    while (slash > 0 && __value[slash - 1] != '/') --slash;
    if (slash == 0) return path();
    while (slash > 1 && __value[slash - 1] == '/') --slash;
    return path(__value.substr(0, slash));
  }
  path filename() const {
    if (__value.empty()) return path();
    if (__value.back() == '/') return path();
    size_t start = __value.size();
    while (start > 0 && __value[start - 1] != '/') --start;
    return path(__value.substr(start));
  }
  path stem() const {
    path name = filename();
    size_t dot = name.__value.size();
    while (dot > 0 && name.__value[dot - 1] != '.') --dot;
    if (dot == 0 || dot == 1 || dot == name.__value.size()) return name;
    return path(name.__value.substr(0, dot - 1));
  }
  path extension() const {
    path name = filename();
    size_t dot = name.__value.size();
    while (dot > 0 && name.__value[dot - 1] != '.') --dot;
    if (dot == 0 || dot == 1 || dot == name.__value.size()) return path();
    return path(name.__value.substr(dot - 1));
  }

  bool empty() const noexcept { return __value.empty(); }
  bool has_root_path() const { return !root_path().empty(); }
  bool has_root_name() const { return false; }
  bool has_root_directory() const { return is_absolute(); }
  bool has_relative_path() const { return !relative_path().empty(); }
  bool has_parent_path() const { return !parent_path().empty(); }
  bool has_filename() const { return !filename().empty(); }
  bool has_stem() const { return !stem().empty(); }
  bool has_extension() const { return !extension().empty(); }
  bool is_absolute() const {
    return !__value.empty() && __value[0] == preferred_separator;
  }
  bool is_relative() const { return !is_absolute(); }

  path lexically_normal() const {
    path result;
    if (is_absolute()) result.__value.push_back(preferred_separator);
    vector<string_type> parts;
    size_t position = result.is_absolute() ? 1 : 0;
    while (position < __value.size()) {
      while (position < __value.size() && __value[position] == '/') ++position;
      size_t start = position;
      while (position < __value.size() && __value[position] != '/') ++position;
      if (start == position) break;
      string_type part(__value.data() + start, position - start);
      if (part == ".") {
      } else if (part == "..") {
        if (!parts.empty() && parts.back() != "..") {
          parts.pop_back();
        } else if (!result.is_absolute()) {
          parts.push_back(part);
        }
      } else {
        parts.push_back(part);
      }
    }
    for (size_t i = 0; i < parts.size(); ++i) {
      if (!result.__value.empty() && result.__value.back() != '/') {
        result.__value.push_back('/');
      }
      result.__value.append(parts[i]);
    }
    if (!__value.empty() && __value.back() == preferred_separator &&
        !result.__value.empty() &&
        result.__value.back() != '/') {
      result.__value.push_back('/');
    }
    if (result.empty()) return path(".");
    return result;
  }

  path lexically_relative(const path& base) const;
  path lexically_proximate(const path& base) const;

  iterator begin() const;
  iterator end() const;

 private:
  string_type __value;

  size_t __component_count() const {
    if (__value.empty()) return 0;
    size_t count = is_absolute() ? 1 : 0;
    size_t position = is_absolute() ? 1 : 0;
    while (position < __value.size()) {
      while (position < __value.size() && __value[position] == '/') ++position;
      size_t start = position;
      while (position < __value.size() && __value[position] != '/') ++position;
      if (start != position) ++count;
    }
    if (__value.size() > 1 && __value.back() == '/') ++count;
    return count;
  }
  path __component(size_t wanted) const {
    if (is_absolute()) {
      if (wanted == 0) return path("/");
      --wanted;
    }
    size_t position = is_absolute() ? 1 : 0;
    while (position < __value.size()) {
      while (position < __value.size() && __value[position] == '/') ++position;
      size_t start = position;
      while (position < __value.size() && __value[position] != '/') ++position;
      if (start == position) break;
      if (wanted == 0) {
        return path(__value.substr(start, position - start));
      }
      --wanted;
    }
    return path();
  }

  friend class iterator;
  friend size_t hash_value(const path&) noexcept;
};

class path::iterator {
 public:
  using iterator_category = bidirectional_iterator_tag;
  using value_type = path;
  using difference_type = ptrdiff_t;
  using pointer = const path*;
  using reference = const path&;

  iterator() : __owner(nullptr), __index(0) {}
  reference operator*() const {
    __current = __owner->__component(__index);
    return __current;
  }
  pointer operator->() const { return &**this; }
  iterator& operator++() {
    ++__index;
    return *this;
  }
  iterator operator++(int) {
    iterator result(*this);
    ++*this;
    return result;
  }
  iterator& operator--() {
    --__index;
    return *this;
  }
  iterator operator--(int) {
    iterator result(*this);
    --*this;
    return result;
  }
  friend bool operator==(const iterator& left, const iterator& right) {
    return left.__owner == right.__owner && left.__index == right.__index;
  }
  friend bool operator!=(const iterator& left, const iterator& right) {
    return !(left == right);
  }

 private:
  iterator(const path* owner, size_t index) : __owner(owner), __index(index) {}
  const path* __owner;
  size_t __index;
  mutable path __current;
  friend class path;
};

inline path::iterator path::begin() const { return iterator(this, 0); }
inline path::iterator path::end() const {
  return iterator(this, __component_count());
}

inline path path::lexically_relative(const path& base) const {
  path left = lexically_normal();
  path right = base.lexically_normal();
  if (left.is_absolute() != right.is_absolute()) return path();
  vector<path> left_parts;
  vector<path> right_parts;
  for (auto it = left.begin(); it != left.end(); ++it)
    left_parts.push_back(*it);
  for (auto it = right.begin(); it != right.end(); ++it)
    right_parts.push_back(*it);
  size_t common = 0;
  while (common < left_parts.size() && common < right_parts.size() &&
         left_parts[common].compare(right_parts[common]) == 0) {
    ++common;
  }
  path result;
  for (size_t i = common; i < right_parts.size(); ++i) {
    if (right_parts[i].compare(path(".")) != 0 &&
        right_parts[i].compare(path("/")) != 0) {
      result /= path("..");
    }
  }
  for (size_t i = common; i < left_parts.size(); ++i) {
    if (left_parts[i].compare(path("/")) != 0) result /= left_parts[i];
  }
  return result.empty() ? path(".") : result;
}

inline path path::lexically_proximate(const path& base) const {
  path result = lexically_relative(base);
  return result.empty() ? *this : result;
}

inline void swap(path& left, path& right) noexcept { left.swap(right); }
inline size_t hash_value(const path& value) noexcept {
  size_t result = 1469598103934665603ULL;
  for (char item : value.__value) {
    result ^= static_cast<unsigned char>(item);
    result *= 1099511628211ULL;
  }
  return result;
}
