template <class Function, class Object, bool IsMemberFunction,
          bool IsMemberObject, bool IsReferenceWrapper, bool IsPointer>
struct __invoke_dispatch;

template <class Function, class Object, bool IsReferenceWrapper,
          bool IsPointer>
struct __invoke_dispatch<Function, Object, false, false, IsReferenceWrapper,
                         IsPointer> {
  template <class Argument, class... Args>
  static constexpr __davecc_invoke_result_t(Function, Argument, Args...)
  call(Function& function, Argument&& object, Args&&... args) {
    return function(static_cast<Argument&&>(object),
                    static_cast<Args&&>(args)...);
  }
};

template <class Function, class Object>
struct __invoke_dispatch<Function, Object, true, false, true, false> {
  using Value = remove_reference_t<Object>;

  template <class... Args>
  static constexpr __davecc_invoke_result_t(Function, Object, Args...)
  call(Function& function, Value& object, Args&&... args) {
    return (object.get().*function)(static_cast<Args&&>(args)...);
  }
};

