namespace __functional_detail {

static inline size_t __hash_integral(unsigned long long value) {
  return static_cast<size_t>(value ^ (value >> 32));
}

}  // namespace __functional_detail

#define __DAVECC_HASH_INTEGRAL(T)                                      \
  template <>                                                          \
  struct hash<T> {                                                     \
    size_t operator()(T value) const noexcept {                        \
      return __functional_detail::__hash_integral(                     \
          static_cast<unsigned long long>(value));                     \
    }                                                                  \
  }

__DAVECC_HASH_INTEGRAL(bool);
__DAVECC_HASH_INTEGRAL(char);
__DAVECC_HASH_INTEGRAL(signed char);
__DAVECC_HASH_INTEGRAL(unsigned char);
__DAVECC_HASH_INTEGRAL(short);
__DAVECC_HASH_INTEGRAL(unsigned short);
__DAVECC_HASH_INTEGRAL(int);
__DAVECC_HASH_INTEGRAL(unsigned int);
__DAVECC_HASH_INTEGRAL(long);
