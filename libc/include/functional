using __invoke_detail::invoke;

#if __cplusplus >= 202302L

template <class R, class F, class... Args>
  requires is_invocable_r<R, F, Args...>::value
constexpr R invoke_r(F&& function, Args&&... args)
    noexcept(is_nothrow_invocable_r<R, F, Args...>::value) {
  if constexpr (is_void<R>::value) {
    std::invoke(static_cast<F&&>(function), static_cast<Args&&>(args)...);
    return;
  } else {
    return static_cast<R>(
        std::invoke(static_cast<F&&>(function),
                    static_cast<Args&&>(args)...));
  }
}

namespace __bind_back_detail {

template <class Sequence>
struct __binder_caller;

template <size_t... Indices>
struct __binder_caller<index_sequence<Indices...>> {
  template <class Function, class Tuple, class... Args>
  static constexpr invoke_result_t<
      Function&&, Args&&...,
      decltype(std::get<Indices>(declval<Tuple>()))...>
  __call(Function&& function, Tuple&& bound, Args&&... args)
      noexcept(is_nothrow_invocable<
               Function&&, Args&&...,
               decltype(std::get<Indices>(declval<Tuple>()))...>::value) {
    return std::invoke(
        static_cast<Function&&>(function),
        static_cast<Args&&>(args)...,
        std::get<Indices>(static_cast<Tuple&&>(bound))...);
  }
};

template <class... Args>
struct __all_constructible;

template <>
struct __all_constructible<> : true_type {};

template <class Arg, class... Rest>
struct __all_constructible<Arg, Rest...>
    : bool_constant<is_constructible<decay_t<Arg>, Arg>::value &&
                    __all_constructible<Rest...>::value> {};

template <class Function, class... Bound>
class __binder {
 private:
  using __indices = make_index_sequence<sizeof...(Bound)>;

 public:
  template <class F, class... Args>
  constexpr explicit __binder(F&& function, Args&&... args)
      : __function(static_cast<F&&>(function)),
        __bound(static_cast<Args&&>(args)...) {}

  template <class... Args>
  constexpr decltype(auto) operator()(Args&&... args) &
      noexcept(noexcept(__call(
          *this, static_cast<Args&&>(args)...))) {
    return __call(*this, static_cast<Args&&>(args)...);
  }

  template <class... Args>
  constexpr decltype(auto) operator()(Args&&... args) const&
      noexcept(noexcept(__call(
          *this, static_cast<Args&&>(args)...))) {
    return __call(*this, static_cast<Args&&>(args)...);
  }

  template <class... Args>
  constexpr decltype(auto) operator()(Args&&... args) &&
      noexcept(noexcept(__call(
          static_cast<__binder&&>(*this),
          static_cast<Args&&>(args)...))) {
    return __call(static_cast<__binder&&>(*this),
                  static_cast<Args&&>(args)...);
  }

  template <class... Args>
  constexpr decltype(auto) operator()(Args&&... args) const&&
      noexcept(noexcept(__call(
          static_cast<const __binder&&>(*this),
          static_cast<Args&&>(args)...))) {
    return __call(static_cast<const __binder&&>(*this),
                  static_cast<Args&&>(args)...);
  }

 private:
  template <class Self, class... Args>
  static constexpr decltype(auto) __call(Self&& self, Args&&... args)
      noexcept(noexcept(__binder_caller<__indices>::__call(
          static_cast<Self&&>(self).__function,
          static_cast<Self&&>(self).__bound,
          static_cast<Args&&>(args)...))) {
    return __binder_caller<__indices>::__call(
        static_cast<Self&&>(self).__function,
        static_cast<Self&&>(self).__bound,
        static_cast<Args&&>(args)...);
  }

  Function __function;
  tuple<Bound...> __bound;
};

}  // namespace __bind_back_detail

template <class F, class... Args>
  requires (is_constructible<decay_t<F>, F>::value &&
            __bind_back_detail::__all_constructible<Args...>::value)
constexpr auto bind_back(F&& function, Args&&... args) {
  return __bind_back_detail::__binder<decay_t<F>, decay_t<Args>...>(
      static_cast<F&&>(function), static_cast<Args&&>(args)...);
}

