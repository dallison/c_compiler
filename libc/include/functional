#ifndef __davecc_functional__
#define __davecc_functional__

#include <stddef.h>
#include <stdint.h>
#include <utility>

namespace std {

template <class T>
struct hash;

template <class T>
struct less {
  constexpr bool operator()(const T& left, const T& right) const {
    return left < right;
  }
};

template <>
struct less<void> {
  using is_transparent = void;

  template <class T, class U>
  constexpr bool operator()(T&& left, U&& right) const {
    return static_cast<T&&>(left) < static_cast<U&&>(right);
  }
};

template <class T>
struct greater {
  constexpr bool operator()(const T& left, const T& right) const {
    return right < left;
  }
};

template <>
struct greater<void> {
  using is_transparent = void;

  template <class T, class U>
  constexpr bool operator()(T&& left, U&& right) const {
    return static_cast<U&&>(right) < static_cast<T&&>(left);
  }
};

template <class T>
struct equal_to {
  constexpr bool operator()(const T& left, const T& right) const {
    return left == right;
  }
};

template <>
struct equal_to<void> {
  using is_transparent = void;

  template <class T, class U>
  constexpr bool operator()(T&& left, U&& right) const {
    return static_cast<T&&>(left) == static_cast<U&&>(right);
  }
};

namespace __functional_detail {

static inline size_t __hash_integral(unsigned long long value) {
  return static_cast<size_t>(value ^ (value >> 32));
}

}  // namespace __functional_detail

#define __DAVECC_HASH_INTEGRAL(T)                                      \
  template <>                                                          \
  struct hash<T> {                                                     \
    size_t operator()(T value) const noexcept {                        \
      return __functional_detail::__hash_integral(                     \
          static_cast<unsigned long long>(value));                     \
    }                                                                  \
  }

__DAVECC_HASH_INTEGRAL(bool);
__DAVECC_HASH_INTEGRAL(char);
__DAVECC_HASH_INTEGRAL(signed char);
__DAVECC_HASH_INTEGRAL(unsigned char);
__DAVECC_HASH_INTEGRAL(short);
__DAVECC_HASH_INTEGRAL(unsigned short);
__DAVECC_HASH_INTEGRAL(int);
__DAVECC_HASH_INTEGRAL(unsigned int);
__DAVECC_HASH_INTEGRAL(long);
__DAVECC_HASH_INTEGRAL(unsigned long);
__DAVECC_HASH_INTEGRAL(long long);
__DAVECC_HASH_INTEGRAL(unsigned long long);

#undef __DAVECC_HASH_INTEGRAL

template <class T>
struct hash<T*> {
  size_t operator()(T* value) const noexcept {
    return static_cast<size_t>(reinterpret_cast<uintptr_t>(value));
  }
};

}  // namespace std

#endif /* __davecc_functional__ */
