template <class T>
struct hash<T*> {
  size_t operator()(T* value) const noexcept {
    return static_cast<size_t>(reinterpret_cast<uintptr_t>(value));
  }
};

template <class T>
class reference_wrapper {
 public:
  typedef T type;

  reference_wrapper(T& value) noexcept : __value(&value) {
  }

  operator T&() const noexcept {
    return *__value;
  }

  T& get() const noexcept {
    return *__value;
  }

  template <class... Args>
  __davecc_invoke_result_t(T&, Args...) operator()(Args&&... args) const {
    return get()(static_cast<Args&&>(args)...);
  }

 private:
  T* __value;
};

template <class T>
reference_wrapper<T> ref(T& value) {
  return reference_wrapper<T>(value);
}

template <class T>
reference_wrapper<const T> cref(const T& value) {
  return reference_wrapper<const T>(value);
}

