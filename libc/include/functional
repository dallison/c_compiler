template <class R, class... Args>
class function<R(Args...)> {
 private:
  using __signature = R(Args...);
  using __self = function<__signature>;
  using __storage_type = __function_detail::__storage_type;
  using __operations = __function_detail::__operations;
  using __invoke_type = R (*)(__storage_type*, Args...);

  template <class F>
  void __initialize(F&& value) {
    using Target = decay_t<F>;
    using Manager = __function_detail::__manager<Target, __signature>;
    if constexpr (is_pointer<Target>::value ||
                  is_member_pointer<Target>::value) {
      if (static_cast<Target>(value) == nullptr) {
        return;
      }
    }

    if constexpr (Manager::is_local) {
      ::new (static_cast<void*>(__storage.data))
          Target(static_cast<F&&>(value));
    } else {
      Manager::heap_pointer(__storage) =
          new Target(static_cast<F&&>(value));
    }
    __ops = Manager::table();
    __invoke = reinterpret_cast<__invoke_type>(__ops->invoke);
  }

 public:
  using result_type = R;

  function() noexcept : __storage{}, __ops(nullptr), __invoke(nullptr) {}

  function(nullptr_t) noexcept : function() {}

  function(const function& other)
      : __storage{}, __ops(nullptr), __invoke(nullptr) {
    if (other.__ops != nullptr) {
      other.__ops->copy(&__storage, &other.__storage);
      __ops = other.__ops;
      __invoke = other.__invoke;
    }
  }

  function(function&& other) noexcept
      : __storage{}, __ops(nullptr), __invoke(nullptr) {
    if (other.__ops != nullptr) {
      other.__ops->move(&__storage, &other.__storage);
      __ops = other.__ops;
      __invoke = other.__invoke;
      other.__ops = nullptr;
      other.__invoke = nullptr;
    }
  }

  template <class F>
    requires (__function_detail::__valid_target<decay_t<F>, F&&, __self,
                                                 __signature>::value)
  function(F&& value) : __storage{}, __ops(nullptr), __invoke(nullptr) {
    __initialize(static_cast<F&&>(value));
  }

  ~function() {
    if (__ops != nullptr) {
      __ops->destroy(&__storage);
    }
  }

  function& operator=(nullptr_t) noexcept {
    __self temporary;
    temporary.swap(*this);
    return *this;
  }

  function& operator=(const function& other) {
    __self temporary = other;
    temporary.swap(*this);
    return *this;
  }

  function& operator=(function&& other) noexcept {
    __self temporary = static_cast<__self&&>(other);
    temporary.swap(*this);
    return *this;
  }

  template <class F>
    requires (__function_detail::__valid_target<decay_t<F>, F&&, __self,
                                                 __signature>::value)
  function& operator=(F&& value) {
    __self temporary = static_cast<F&&>(value);
    temporary.swap(*this);
    return *this;
  }

  template <class F>
  function& operator=(reference_wrapper<F> value) noexcept {
    __self temporary = value;
    temporary.swap(*this);
    return *this;
  }

  void swap(function& other) noexcept {
    if (this == &other) {
      return;
    }
    __self temporary = static_cast<__self&&>(other);
    if (__ops != nullptr) {
      __ops->move(&other.__storage, &__storage);
      other.__ops = __ops;
      other.__invoke = __invoke;
      __ops = nullptr;
      __invoke = nullptr;
    }
    if (temporary.__ops != nullptr) {
      temporary.__ops->move(&__storage, &temporary.__storage);
      __ops = temporary.__ops;
      __invoke = temporary.__invoke;
      temporary.__ops = nullptr;
      temporary.__invoke = nullptr;
    }
  }

  explicit operator bool() const noexcept {
    return __ops != nullptr;
  }

  R operator()(Args... args) const {
    if (__ops == nullptr) {
      __DAVECC_THROW(bad_function_call());
    }
    return __invoke(
        const_cast<__storage_type*>(&__storage),
        static_cast<Args&&>(args)...);
  }

  const type_info& target_type() const noexcept {
    if (__ops == nullptr) {
      return typeid(void);
    }
    return __ops->target_type();
  }

  template <class T>
  T* target() noexcept {
    if (__ops == nullptr || target_type() != typeid(T)) {
      return nullptr;
    }
    return static_cast<T*>(__ops->target(&__storage));
  }

  template <class T>
  const T* target() const noexcept {
    if (__ops == nullptr || target_type() != typeid(T)) {
      return nullptr;
    }
    return static_cast<const T*>(__ops->const_target(&__storage));
  }

 private:
  __storage_type __storage;
  const __operations* __ops;
  __invoke_type __invoke;
};

template <class R, class... Args>
function(R (*)(Args...)) -> function<R(Args...)>;

template <class F>
  requires is_class<F>::value
function(F) -> function<__function_detail::__function_guide_t<F>>;

template <class R, class... Args>
bool operator==(const function<R(Args...)>& value, nullptr_t) noexcept {
  return !value;
}

template <class R, class... Args>
bool operator==(nullptr_t, const function<R(Args...)>& value) noexcept {
  return !value;
}

template <class R, class... Args>
void swap(function<R(Args...)>& left,
          function<R(Args...)>& right) noexcept {
  left.swap(right);
}

#if __cplusplus >= 202302L

template <class Signature>
class move_only_function;

namespace __move_only_function_detail {

using __storage_type = __function_detail::__storage_type;

struct __operations {
  void* invoke;
  void (*move)(__storage_type*, __storage_type*);
  void (*destroy)(__storage_type*);
};

template <bool Noexcept, class R, class F, class... Args>
struct __invocable;

template <class R, class F, class... Args>
struct __invocable<false, R, F, Args...> : is_invocable_r<R, F, Args...> {};

template <class R, class F, class... Args>
struct __invocable<true, R, F, Args...>
    : is_nothrow_invocable_r<R, F, Args...> {};

template <int Mode, bool Noexcept, class R, class F, class... Args>
struct __callable;

template <bool Noexcept, class R, class F, class... Args>
struct __callable<0, Noexcept, R, F, Args...>
    : bool_constant<
          __invocable<Noexcept, R, F, Args...>::value &&
          __invocable<Noexcept, R, F&, Args...>::value> {};

template <bool Noexcept, class R, class F, class... Args>
struct __callable<1, Noexcept, R, F, Args...>
    : __invocable<Noexcept, R, F&, Args...> {};

template <bool Noexcept, class R, class F, class... Args>
struct __callable<2, Noexcept, R, F, Args...>
    : __invocable<Noexcept, R, F&&, Args...> {};

template <bool Noexcept, class R, class F, class... Args>
struct __callable<3, Noexcept, R, F, Args...>
    : bool_constant<
          __invocable<Noexcept, R, const F, Args...>::value &&
          __invocable<Noexcept, R, const F&, Args...>::value> {};

template <bool Noexcept, class R, class F, class... Args>
struct __callable<4, Noexcept, R, F, Args...>
    : __invocable<Noexcept, R, const F&, Args...> {};

template <bool Noexcept, class R, class F, class... Args>
struct __callable<5, Noexcept, R, F, Args...>
    : __invocable<Noexcept, R, const F&&, Args...> {};

template <bool IsSelf, int Mode, bool Noexcept, class R, class Target,
          class Source, class Self, class... Args>
struct __valid_target;

template <int Mode, bool Noexcept, class R, class Target, class Source,
          class Self, class... Args>
struct __valid_target<true, Mode, Noexcept, R, Target, Source, Self, Args...>
    : false_type {};

template <int Mode, bool Noexcept, class R, class Target, class Source,
          class Self, class... Args>
struct __valid_target<false, Mode, Noexcept, R, Target, Source, Self, Args...>
    : bool_constant<is_constructible<Target, Source>::value &&
                    __callable<Mode, Noexcept, R, Target, Args...>::value> {};

template <class F>
struct __is_local
    : bool_constant<sizeof(F) <= sizeof(__storage_type) &&
                    alignof(F) <= alignof(__storage_type) &&
                    is_nothrow_move_constructible<F>::value> {};

template <int Mode, bool Noexcept, class R, class F, class... Args>
struct __manager {
  static F*& heap_pointer(__storage_type& storage) {
    return *reinterpret_cast<F**>(storage.data);
  }

  static F* get(__storage_type& storage) {
    if constexpr (__is_local<F>::value) {
      return reinterpret_cast<F*>(storage.data);
    } else {
      return heap_pointer(storage);
    }
  }

  static R invoke_target(__storage_type* storage, Args... args)
      noexcept(Noexcept) {
    F* target = get(*storage);
    if constexpr (Mode == 2) {
      return std::invoke(static_cast<F&&>(*target),
                         static_cast<Args&&>(args)...);
    } else if constexpr (Mode == 3 || Mode == 4) {
      return std::invoke(static_cast<const F&>(*target),
                         static_cast<Args&&>(args)...);
    } else if constexpr (Mode == 5) {
      return std::invoke(static_cast<const F&&>(*target),
                         static_cast<Args&&>(args)...);
    } else {
      return std::invoke(*target, static_cast<Args&&>(args)...);
    }
  }

  static void move(__storage_type* destination, __storage_type* source) {
    if constexpr (__is_local<F>::value) {
      F* source_target = get(*source);
      ::new (static_cast<void*>(destination->data))
          F(static_cast<F&&>(*source_target));
      source_target->~F();
    } else {
      heap_pointer(*destination) = heap_pointer(*source);
      heap_pointer(*source) = nullptr;
    }
  }

  static void destroy(__storage_type* storage) {
    if constexpr (__is_local<F>::value) {
      get(*storage)->~F();
    } else {
      delete heap_pointer(*storage);
      heap_pointer(*storage) = nullptr;
    }
  }

  static const __operations* table() {
    static const __operations value = {
        reinterpret_cast<void*>(&invoke_target), &move, &destroy};
    return &value;
  }
};

template <class Signature, int Mode, bool Noexcept>
class __base;

template <class R, class... Args, int Mode, bool Noexcept>
class __base<R(Args...), Mode, Noexcept> {
 private:
  using __invoke_type = R (*)(__storage_type*, Args...) noexcept(Noexcept);

  template <class T, class... ConstructorArgs>
  void __initialize(ConstructorArgs&&... args) {
    using Manager = __manager<Mode, Noexcept, R, T, Args...>;
    if constexpr (__is_local<T>::value) {
      ::new (static_cast<void*>(__storage.data))
          T(static_cast<ConstructorArgs&&>(args)...);
    } else {
      Manager::heap_pointer(__storage) =
          new T(static_cast<ConstructorArgs&&>(args)...);
    }
    __ops = Manager::table();
    __invoke = reinterpret_cast<__invoke_type>(__ops->invoke);
  }

 protected:
  __base() noexcept : __storage{}, __ops(nullptr), __invoke(nullptr) {}

  template <class T, class... ConstructorArgs>
  explicit __base(in_place_type_t<T>, ConstructorArgs&&... args)
      : __storage{}, __ops(nullptr), __invoke(nullptr) {
    this->template __initialize<T>(
        static_cast<ConstructorArgs&&>(args)...);
  }

  template <class T, class U, class... ConstructorArgs>
  explicit __base(in_place_type_t<T>, initializer_list<U> values,
                  ConstructorArgs&&... args)
      : __storage{}, __ops(nullptr), __invoke(nullptr) {
    this->template __initialize<T>(
        values, static_cast<ConstructorArgs&&>(args)...);
  }

  __base(__base&& other) noexcept
      : __storage{}, __ops(nullptr), __invoke(nullptr) {
    if (other.__ops != nullptr) {
      other.__ops->move(&__storage, &other.__storage);
      __ops = other.__ops;
      __invoke = other.__invoke;
      other.__ops = nullptr;
      other.__invoke = nullptr;
    }
  }

  __base& operator=(__base&& other) noexcept {
    if (this == &other) {
      return *this;
    }
    __reset();
    if (other.__ops != nullptr) {
      other.__ops->move(&__storage, &other.__storage);
      __ops = other.__ops;
      __invoke = other.__invoke;
      other.__ops = nullptr;
      other.__invoke = nullptr;
    }
    return *this;
  }

  ~__base() {
    __reset();
  }

  void __reset() noexcept {
    if (__ops != nullptr) {
      __ops->destroy(&__storage);
      __ops = nullptr;
      __invoke = nullptr;
    }
  }

  void __swap(__base& other) noexcept {
    if (this == &other) {
      return;
    }
    __base temporary(static_cast<__base&&>(other));
    other = static_cast<__base&&>(*this);
    *this = static_cast<__base&&>(temporary);
  }

  bool __has_value() const noexcept {
    return __ops != nullptr;
  }

  R __call(Args... args) const noexcept(Noexcept) {
    return __invoke(const_cast<__storage_type*>(&__storage),
                    static_cast<Args&&>(args)...);
  }

 private:
  __base(const __base&) = delete;
  __base& operator=(const __base&) = delete;

  __storage_type __storage;
  const __operations* __ops;
  __invoke_type __invoke;
};

}  // namespace __move_only_function_detail

#define __DAVECC_MOVE_ONLY_FUNCTION(QUALIFIERS, MODE, NOEXCEPT_TOKEN,         \
                                    NOEXCEPT_VALUE)                           \
  template <class R, class... Args>                                          \
  class move_only_function<R(Args...) QUALIFIERS NOEXCEPT_TOKEN>             \
      : public __move_only_function_detail::__base<                          \
            R(Args...), MODE, NOEXCEPT_VALUE> {                              \
   private:                                                                  \
    using __base = __move_only_function_detail::__base<                      \
        R(Args...), MODE, NOEXCEPT_VALUE>;                                   \
    using __self = move_only_function<                                       \
        R(Args...) QUALIFIERS NOEXCEPT_TOKEN>;                               \
                                                                             \
   public:                                                                   \
    using result_type = R;                                                   \
                                                                             \
    move_only_function() noexcept : __base() {}                              \
    move_only_function(nullptr_t) noexcept : __base() {}                     \
    move_only_function(move_only_function&& other) noexcept                  \
        : __base(static_cast<__base&&>(other)) {}                            \
    move_only_function(const move_only_function&) = delete;                  \
                                                                             \
    template <class F>                                                       \
      requires (is_constructible<decay_t<F>, F&&>::value &&                  \
                __move_only_function_detail::__callable<                     \
                    MODE, NOEXCEPT_VALUE, R, decay_t<F>, Args...>::value)     \
    move_only_function(F&& value)                                            \
        : __base(in_place_type<decay_t<F>>, static_cast<F&&>(value)) {        \
      using Target = decay_t<F>;                                             \
      if constexpr (is_pointer<Target>::value ||                             \
                    is_member_pointer<Target>::value) {                      \
        if (static_cast<Target>(value) == nullptr) {                         \
          this->__reset();                                                   \
        }                                                                    \
      }                                                                      \
    }                                                                        \
                                                                             \
    template <class T, class... ConstructorArgs>                             \
      requires (is_constructible<T, ConstructorArgs&&...>::value &&          \
                __move_only_function_detail::__callable<                     \
                    MODE, NOEXCEPT_VALUE, R, T, Args...>::value)              \
    explicit move_only_function(in_place_type_t<T>,                          \
                                ConstructorArgs&&... args)                    \
        : __base(in_place_type<T>,                                           \
                 static_cast<ConstructorArgs&&>(args)...) {}                 \
                                                                             \
    template <class T, class U, class... ConstructorArgs>                    \
      requires (is_constructible<T, initializer_list<U>&,                    \
                                 ConstructorArgs&&...>::value &&             \
                __move_only_function_detail::__callable<                     \
                    MODE, NOEXCEPT_VALUE, R, T, Args...>::value)              \
    explicit move_only_function(in_place_type_t<T>,                          \
                                initializer_list<U> values,                   \
                                ConstructorArgs&&... args)                    \
        : __base(in_place_type<T>, values,                                   \
                 static_cast<ConstructorArgs&&>(args)...) {}                 \
                                                                             \
    ~move_only_function() = default;                                         \
                                                                             \
    move_only_function& operator=(move_only_function&& other) noexcept {     \
      __base::operator=(static_cast<__base&&>(other));                       \
      return *this;                                                          \
    }                                                                        \
    move_only_function& operator=(const move_only_function&) = delete;       \
                                                                             \
    move_only_function& operator=(nullptr_t) noexcept {                      \
      this->__reset();                                                       \
      return *this;                                                          \
    }                                                                        \
                                                                             \
    template <class F>                                                       \
      requires (is_constructible<decay_t<F>, F&&>::value &&                  \
                __move_only_function_detail::__callable<                     \
                    MODE, NOEXCEPT_VALUE, R, decay_t<F>, Args...>::value)     \
    move_only_function& operator=(F&& value) {                               \
      move_only_function temporary(static_cast<F&&>(value));                 \
      this->swap(temporary);                                                 \
      return *this;                                                          \
    }                                                                        \
                                                                             \
    explicit operator bool() const noexcept {                                \
      return this->__has_value();                                            \
    }                                                                        \
                                                                             \
    R operator()(Args... args) QUALIFIERS NOEXCEPT_TOKEN {                   \
      return this->__call(static_cast<Args&&>(args)...);                     \
    }                                                                        \
                                                                             \
    void swap(move_only_function& other) noexcept {                          \
      this->__swap(other);                                                   \
    }                                                                        \
                                                                             \
    friend void swap(move_only_function& left,                               \
                     move_only_function& right) noexcept {                   \
      left.swap(right);                                                      \
    }                                                                        \
                                                                             \
    friend bool operator==(const move_only_function& value,                  \
                           nullptr_t) noexcept {                              \
      return !value;                                                         \
    }                                                                        \
  };

