#ifndef __davecc_functional__
#define __davecc_functional__

#include <stddef.h>
#include <stdint.h>
#include <type_traits>
#include <utility>

namespace std {

template <class T>
struct hash;

template <class T>
struct less {
  constexpr bool operator()(const T& left, const T& right) const {
    return left < right;
  }
};

template <>
struct less<void> {
  using is_transparent = void;

  template <class T, class U>
  constexpr bool operator()(T&& left, U&& right) const {
    return static_cast<T&&>(left) < static_cast<U&&>(right);
  }
};

template <class T>
struct greater {
  constexpr bool operator()(const T& left, const T& right) const {
    return right < left;
  }
};

template <>
struct greater<void> {
  using is_transparent = void;

  template <class T, class U>
  constexpr bool operator()(T&& left, U&& right) const {
    return static_cast<U&&>(right) < static_cast<T&&>(left);
  }
};

template <class T>
struct equal_to {
  constexpr bool operator()(const T& left, const T& right) const {
    return left == right;
  }
};

template <>
struct equal_to<void> {
  using is_transparent = void;

  template <class T, class U>
  constexpr bool operator()(T&& left, U&& right) const {
    return static_cast<T&&>(left) == static_cast<U&&>(right);
  }
};

namespace __functional_detail {

static inline size_t __hash_integral(unsigned long long value) {
  return static_cast<size_t>(value ^ (value >> 32));
}

}  // namespace __functional_detail

#define __DAVECC_HASH_INTEGRAL(T)                                      \
  template <>                                                          \
  struct hash<T> {                                                     \
    size_t operator()(T value) const noexcept {                        \
      return __functional_detail::__hash_integral(                     \
          static_cast<unsigned long long>(value));                     \
    }                                                                  \
  }

__DAVECC_HASH_INTEGRAL(bool);
__DAVECC_HASH_INTEGRAL(char);
__DAVECC_HASH_INTEGRAL(signed char);
__DAVECC_HASH_INTEGRAL(unsigned char);
__DAVECC_HASH_INTEGRAL(short);
__DAVECC_HASH_INTEGRAL(unsigned short);
__DAVECC_HASH_INTEGRAL(int);
__DAVECC_HASH_INTEGRAL(unsigned int);
__DAVECC_HASH_INTEGRAL(long);
__DAVECC_HASH_INTEGRAL(unsigned long);
__DAVECC_HASH_INTEGRAL(long long);
__DAVECC_HASH_INTEGRAL(unsigned long long);

#undef __DAVECC_HASH_INTEGRAL

template <class T>
struct hash<T*> {
  size_t operator()(T* value) const noexcept {
    return static_cast<size_t>(reinterpret_cast<uintptr_t>(value));
  }
};

template <class T>
class reference_wrapper {
 public:
  typedef T type;

  reference_wrapper(T& value) : __value(&value) {
  }

  operator T&() const {
    return *__value;
  }

  T& get() const {
    return *__value;
  }

 private:
  T* __value;
};

template <class T>
reference_wrapper<T> ref(T& value) {
  return reference_wrapper<T>(value);
}

template <class T>
reference_wrapper<const T> cref(const T& value) {
  return reference_wrapper<const T>(value);
}

namespace __invoke_detail {

template <class F, class... Args>
struct __invoke_result_impl {
  using type = __davecc_invoke_result_t(F, Args...);
};

template <class T, class... Args>
struct __invoke_result_impl<reference_wrapper<T>, Args...> {
  using type = __davecc_invoke_result_t(T, Args...);
};

template <class F, class... Args>
struct __invoke_result : __invoke_result_impl<remove_reference_t<F>, Args...> {
};

template <class T>
struct __is_reference_wrapper : false_type {};

template <class T>
struct __is_reference_wrapper<reference_wrapper<T> > : true_type {};

template <class F>
struct __invoke_helper {
  template <class... Args>
  static typename __invoke_result<F, Args...>::type call(F& function,
                                                       Args&&... args) {
    return (function)(static_cast<Args&&>(args)...);
  }
};

template <class R, class A>
struct __invoke_helper<R(A)> {
  static R call(R (*function)(A), A&& arg) {
    return function(static_cast<A&&>(arg));
  }
};

template <class T, class... Args>
__davecc_invoke_result_t(T, Args...)
invoke(reference_wrapper<T>& function, Args&&... args) {
  return function.get()(static_cast<Args&&>(args)...);
}

template <class F, class... Args>
typename enable_if<!__is_reference_wrapper<remove_reference_t<F> >::value,
                   typename __invoke_result<F, Args...>::type>::type
invoke(F&& function, Args&&... args) {
  return __invoke_helper<remove_reference_t<F> >::call(
      function, static_cast<Args&&>(args)...);
}

template <class F, class... Args>
struct __is_invocable_impl
    : bool_constant<__davecc_is_invocable(F, Args...) != 0> {
};

template <class T, class... Args>
struct __is_invocable_impl<reference_wrapper<T>, Args...>
    : __is_invocable_impl<T, Args...> {
};

template <class F, class... Args>
struct __is_invocable : __is_invocable_impl<remove_reference_t<F>, Args...> {
};

template <class F, class... Args>
struct __is_nothrow_invocable_impl
    : bool_constant<__davecc_is_nothrow_invocable(F, Args...) != 0> {
};

template <class T, class... Args>
struct __is_nothrow_invocable_impl<reference_wrapper<T>, Args...>
    : __is_nothrow_invocable_impl<T, Args...> {
};

template <class F, class... Args>
struct __is_nothrow_invocable
    : __is_nothrow_invocable_impl<remove_reference_t<F>, Args...> {
};

}  // namespace __invoke_detail

template <class F, class... Args>
struct invoke_result : __invoke_detail::__invoke_result<F, Args...> {
};

template <class F, class... Args>
using invoke_result_t = typename invoke_result<F, Args...>::type;

template <class F, class... Args>
struct is_invocable : __invoke_detail::__is_invocable<F, Args...> {
};

template <class F, class... Args>
inline constexpr bool is_invocable_v = is_invocable<F, Args...>::value;

template <class R, class F, class... Args>
struct is_invocable_r
    : bool_constant<is_invocable<F, Args...>::value &&
                    is_convertible<invoke_result_t<F, Args...>, R>::value> {
};

template <class F, class... Args>
struct is_nothrow_invocable
    : __invoke_detail::__is_nothrow_invocable<F, Args...> {
};

template <class R, class F, class... Args>
struct is_nothrow_invocable_r
    : bool_constant<is_nothrow_invocable<F, Args...>::value &&
                    is_convertible<invoke_result_t<F, Args...>, R>::value> {
};

using __invoke_detail::invoke;

}  // namespace std

#endif /* __davecc_functional__ */
