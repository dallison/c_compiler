template <class F>
using __function_guide_t =
    typename __function_guide<decltype(&F::operator())>::type;

}  // namespace __function_detail

template <class R, class... Args>
class function<R(Args...)> {
 private:
  using __signature = R(Args...);
  using __self = function<__signature>;
  using __storage_type = __function_detail::__storage_type;
  using __operations = __function_detail::__operations;
  using __invoke_type = R (*)(__storage_type*, Args...);

  template <class F>
  void __initialize(F&& value) {
    using Target = decay_t<F>;
    using Manager = __function_detail::__manager<Target, __signature>;
    if constexpr (is_pointer<Target>::value ||
                  is_member_pointer<Target>::value) {
      if (static_cast<Target>(value) == nullptr) {
        return;
      }
    }

    if constexpr (Manager::is_local) {
      ::new (static_cast<void*>(__storage.data))
          Target(static_cast<F&&>(value));
    } else {
      Manager::heap_pointer(__storage) =
          new Target(static_cast<F&&>(value));
    }
    __ops = Manager::table();
    __invoke = reinterpret_cast<__invoke_type>(__ops->invoke);
  }

 public:
  using result_type = R;

  function() noexcept : __storage{}, __ops(nullptr), __invoke(nullptr) {}

  function(nullptr_t) noexcept : function() {}

  function(const function& other)
      : __storage{}, __ops(nullptr), __invoke(nullptr) {
    if (other.__ops != nullptr) {
      other.__ops->copy(&__storage, &other.__storage);
      __ops = other.__ops;
      __invoke = other.__invoke;
    }
  }

  function(function&& other) noexcept
      : __storage{}, __ops(nullptr), __invoke(nullptr) {
    if (other.__ops != nullptr) {
      other.__ops->move(&__storage, &other.__storage);
      __ops = other.__ops;
      __invoke = other.__invoke;
      other.__ops = nullptr;
      other.__invoke = nullptr;
    }
  }

  template <class F>
    requires (__function_detail::__valid_target<decay_t<F>, F&&, __self,
                                                 __signature>::value)
  function(F&& value) : __storage{}, __ops(nullptr), __invoke(nullptr) {
    __initialize(static_cast<F&&>(value));
  }

  ~function() {
    if (__ops != nullptr) {
      __ops->destroy(&__storage);
    }
  }

  function& operator=(nullptr_t) noexcept {
    __self temporary;
    temporary.swap(*this);
    return *this;
  }

  function& operator=(const function& other) {
    __self temporary = other;
    temporary.swap(*this);
    return *this;
  }

  function& operator=(function&& other) noexcept {
    __self temporary = static_cast<__self&&>(other);
    temporary.swap(*this);
    return *this;
  }

  template <class F>
    requires (__function_detail::__valid_target<decay_t<F>, F&&, __self,
                                                 __signature>::value)
  function& operator=(F&& value) {
    __self temporary = static_cast<F&&>(value);
    temporary.swap(*this);
    return *this;
  }

  template <class F>
  function& operator=(reference_wrapper<F> value) noexcept {
    __self temporary = value;
    temporary.swap(*this);
    return *this;
  }

  void swap(function& other) noexcept {
    if (this == &other) {
      return;
    }
    __self temporary = static_cast<__self&&>(other);
    if (__ops != nullptr) {
      __ops->move(&other.__storage, &__storage);
      other.__ops = __ops;
      other.__invoke = __invoke;
      __ops = nullptr;
      __invoke = nullptr;
    }
    if (temporary.__ops != nullptr) {
      temporary.__ops->move(&__storage, &temporary.__storage);
      __ops = temporary.__ops;
      __invoke = temporary.__invoke;
      temporary.__ops = nullptr;
      temporary.__invoke = nullptr;
    }
  }

  explicit operator bool() const noexcept {
    return __ops != nullptr;
  }

  R operator()(Args... args) const {
    if (__ops == nullptr) {
      throw bad_function_call();
    }
    return __invoke(
        const_cast<__storage_type*>(&__storage),
        static_cast<Args&&>(args)...);
  }

  const type_info& target_type() const noexcept {
    if (__ops == nullptr) {
      return typeid(void);
    }
    return __ops->target_type();
  }

  template <class T>
  T* target() noexcept {
    if (__ops == nullptr || target_type() != typeid(T)) {
      return nullptr;
    }
    return static_cast<T*>(__ops->target(&__storage));
  }

  template <class T>
  const T* target() const noexcept {
    if (__ops == nullptr || target_type() != typeid(T)) {
      return nullptr;
    }
    return static_cast<const T*>(__ops->const_target(&__storage));
  }

 private:
  __storage_type __storage;
  const __operations* __ops;
  __invoke_type __invoke;
};

template <class R, class... Args>
function(R (*)(Args...)) -> function<R(Args...)>;

template <class F>
  requires is_class<F>::value
function(F) -> function<__function_detail::__function_guide_t<F>>;

template <class R, class... Args>
bool operator==(const function<R(Args...)>& value, nullptr_t) noexcept {
  return !value;
}

template <class R, class... Args>
bool operator==(nullptr_t, const function<R(Args...)>& value) noexcept {
  return !value;
}

template <class R, class... Args>
void swap(function<R(Args...)>& left,
          function<R(Args...)>& right) noexcept {
  left.swap(right);
}

}  // namespace std

