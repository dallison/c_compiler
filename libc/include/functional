struct __function_guide;

#define __DAVECC_FUNCTION_GUIDE(qualifiers)                              \
  template <class R, class C, class... Args>                             \
  struct __function_guide<R (C::*)(Args...) qualifiers> {                \
    using type = R(Args...);                                             \
  };

__DAVECC_FUNCTION_GUIDE()
__DAVECC_FUNCTION_GUIDE(const)
__DAVECC_FUNCTION_GUIDE(volatile)
__DAVECC_FUNCTION_GUIDE(const volatile)
__DAVECC_FUNCTION_GUIDE(&)
__DAVECC_FUNCTION_GUIDE(const &)
__DAVECC_FUNCTION_GUIDE(volatile &)
__DAVECC_FUNCTION_GUIDE(const volatile &)
__DAVECC_FUNCTION_GUIDE(&&)
__DAVECC_FUNCTION_GUIDE(const &&)
__DAVECC_FUNCTION_GUIDE(volatile &&)
__DAVECC_FUNCTION_GUIDE(const volatile &&)
__DAVECC_FUNCTION_GUIDE(noexcept)
__DAVECC_FUNCTION_GUIDE(const noexcept)
__DAVECC_FUNCTION_GUIDE(volatile noexcept)
__DAVECC_FUNCTION_GUIDE(const volatile noexcept)
__DAVECC_FUNCTION_GUIDE(& noexcept)
__DAVECC_FUNCTION_GUIDE(const & noexcept)
__DAVECC_FUNCTION_GUIDE(volatile & noexcept)
__DAVECC_FUNCTION_GUIDE(const volatile & noexcept)
