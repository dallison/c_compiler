template <class F>
constexpr __davecc_invoke_result_t(F) invoke(F&& function) {
  return static_cast<F&&>(function)();
}

template <class F, class T, class... Args>
  requires (__is_member_pointer_argument<F>::value)
constexpr __davecc_invoke_result_t(F, reference_wrapper<T>, Args...)
invoke(F&& function, reference_wrapper<T>&& object, Args&&... args) {
  using Function = remove_reference_t<F>;
  using Object = reference_wrapper<T>;
  return __invoke_dispatch<
      Function, Object, is_member_function_pointer<Function>::value,
      is_member_object_pointer<Function>::value, true, false>::call(
      function, object, static_cast<Args&&>(args)...);
}

template <class F, class T, class... Args>
  requires (__is_member_pointer_argument<F>::value)
constexpr __davecc_invoke_result_t(F, reference_wrapper<T>, Args...)
invoke(F&& function, reference_wrapper<T>& object, Args&&... args) {
  using Function = remove_reference_t<F>;
  using Object = reference_wrapper<T>;
  return __invoke_dispatch<
      Function, Object, is_member_function_pointer<Function>::value,
      is_member_object_pointer<Function>::value, true, false>::call(
      function, object, static_cast<Args&&>(args)...);
}

template <class F, class T, class... Args>
  requires (__is_member_pointer_argument<F>::value &&
            __davecc_is_member_pointer_direct_object(F, T) != 0)
constexpr __davecc_invoke_result_t(F, T, Args...)
invoke(F&& function, T&& object, Args&&... args) {
  using Function = remove_reference_t<F>;
  using Object = remove_reference_t<T>;
  return __invoke_dispatch<
      Function, Object, is_member_function_pointer<Function>::value,
      is_member_object_pointer<Function>::value, false, false>::call(
      function, static_cast<T&&>(object), static_cast<Args&&>(args)...);
}

template <class F, class T, class... Args>
  requires (__is_member_pointer_argument<F>::value &&
            __davecc_is_member_pointer_direct_object(F, T) == 0)
constexpr __davecc_invoke_result_t(F, T, Args...)
invoke(F&& function, T&& object, Args&&... args) {
  using Function = remove_reference_t<F>;
  using Object = remove_reference_t<T>;
  return __invoke_dispatch<
      Function, Object, is_member_function_pointer<Function>::value,
      is_member_object_pointer<Function>::value, false, true>::call(
      function, static_cast<T&&>(object), static_cast<Args&&>(args)...);
}

template <class F, class T, class... Args>
  requires (!__is_member_pointer_argument<F>::value)
constexpr __davecc_invoke_result_t(F, T, Args...)
invoke(F&& function, T&& object, Args&&... args) {
  return static_cast<F&&>(function)(static_cast<T&&>(object),
                                    static_cast<Args&&>(args)...);
}

