template <class F>
struct __invoke_helper {
  template <class... Args>
  static typename __invoke_result<F, Args...>::type call(F& function,
                                                       Args&&... args) {
    return (function)(static_cast<Args&&>(args)...);
  }
};

template <class R, class A>
struct __invoke_helper<R(A)> {
  static R call(R (*function)(A), A&& arg) {
    return function(static_cast<A&&>(arg));
  }
};

template <class Function, class Object, bool IsMemberFunction,
          bool IsMemberObject, bool IsReferenceWrapper, bool IsPointer>
struct __invoke_dispatch;

template <class Function, class Object, bool IsReferenceWrapper,
          bool IsPointer>
struct __invoke_dispatch<Function, Object, false, false, IsReferenceWrapper,
                         IsPointer> {
  template <class Argument, class... Args>
  static __davecc_invoke_result_t(Function, Argument, Args...)
  call(Function& function, Argument&& object, Args&&... args) {
    return function(static_cast<Argument&&>(object),
                    static_cast<Args&&>(args)...);
  }
};

template <class Function, class Object>
struct __invoke_dispatch<Function, Object, true, false, true, false> {
  using Value = remove_reference_t<Object>;

  template <class... Args>
  static __davecc_invoke_result_t(Function, Object, Args...)
  call(Function& function, Value& object, Args&&... args) {
    return (object.get().*function)(static_cast<Args&&>(args)...);
  }
};

template <class Function, class Object>
struct __invoke_dispatch<Function, Object, true, false, false, true> {
  template <class... Args>
  static __davecc_invoke_result_t(Function, Object, Args...)
  call(Function& function, Object object, Args&&... args) {
    return ((*object).*function)(static_cast<Args&&>(args)...);
  }
};

template <class Function, class Object>
struct __invoke_dispatch<Function, Object, true, false, false, false> {
  template <class Argument, class... Args>
  static __davecc_invoke_result_t(Function, Argument, Args...)
  call(Function& function, Argument&& object, Args&&... args) {
    return (static_cast<Argument&&>(object).*function)(
        static_cast<Args&&>(args)...);
  }
};

template <class Function, class Object>
struct __invoke_dispatch<Function, Object, false, true, true, false> {
  using Value = remove_reference_t<Object>;

  static __davecc_invoke_result_t(Function, Object)
  call(Function& function, Value& object) {
    return object.get().*function;
  }
};

template <class Function, class Object>
struct __invoke_dispatch<Function, Object, false, true, false, true> {
  static __davecc_invoke_result_t(Function, Object)
  call(Function& function, Object object) {
    return (*object).*function;
  }
};

template <class Function, class Object>
struct __invoke_dispatch<Function, Object, false, true, false, false> {
  template <class Argument>
  static __davecc_invoke_result_t(Function, Argument)
  call(Function& function, Argument&& object) {
    return static_cast<Argument&&>(object).*function;
  }
};

template <class F>
__davecc_invoke_result_t(F) invoke(F&& function) {
  return function();
}

template <class F, class T, class... Args>
  requires (__is_member_pointer_argument<F>::value)
__davecc_invoke_result_t(F, reference_wrapper<T>, Args...)
invoke(F&& function, reference_wrapper<T>&& object, Args&&... args) {
  using Function = remove_reference_t<F>;
  using Object = reference_wrapper<T>;
  return __invoke_dispatch<
      Function, Object, is_member_function_pointer<Function>::value,
      is_member_object_pointer<Function>::value, true, false>::call(
      function, object, static_cast<Args&&>(args)...);
}

template <class F, class T, class... Args>
  requires (__is_member_pointer_argument<F>::value)
__davecc_invoke_result_t(F, reference_wrapper<T>, Args...)
invoke(F&& function, reference_wrapper<T>& object, Args&&... args) {
  using Function = remove_reference_t<F>;
  using Object = reference_wrapper<T>;
  return __invoke_dispatch<
      Function, Object, is_member_function_pointer<Function>::value,
      is_member_object_pointer<Function>::value, true, false>::call(
      function, object, static_cast<Args&&>(args)...);
}

template <class F, class T, class... Args>
  requires (__is_member_pointer_argument<F>::value &&
            __davecc_is_member_pointer_direct_object(F, T) != 0)
__davecc_invoke_result_t(F, T, Args...)
invoke(F&& function, T&& object, Args&&... args) {
  using Function = remove_reference_t<F>;
  using Object = remove_reference_t<T>;
  return __invoke_dispatch<
      Function, Object, is_member_function_pointer<Function>::value,
      is_member_object_pointer<Function>::value, false, false>::call(
      function, static_cast<T&&>(object), static_cast<Args&&>(args)...);
}

template <class F, class T, class... Args>
  requires (__is_member_pointer_argument<F>::value &&
            __davecc_is_member_pointer_direct_object(F, T) == 0)
__davecc_invoke_result_t(F, T, Args...)
invoke(F&& function, T&& object, Args&&... args) {
  using Function = remove_reference_t<F>;
  using Object = remove_reference_t<T>;
  return __invoke_dispatch<
      Function, Object, is_member_function_pointer<Function>::value,
      is_member_object_pointer<Function>::value, false, true>::call(
      function, static_cast<T&&>(object), static_cast<Args&&>(args)...);
}

template <class F, class T, class... Args>
  requires (!__is_member_pointer_argument<F>::value)
__davecc_invoke_result_t(F, T, Args...)
invoke(F&& function, T&& object, Args&&... args) {
  using Function = remove_reference_t<F>;
  using Object = remove_reference_t<T>;
  return __invoke_dispatch<Function, Object, false, false, false, false>::call(
      function, static_cast<T&&>(object), static_cast<Args&&>(args)...);
}

