template <class Signature>
class function;

namespace __function_detail {

struct __storage_type {
  alignas(void*) unsigned char data[2 * sizeof(void*)];
};

struct __operations {
    void* invoke;
    void (*copy)(__storage_type*, const __storage_type*);
    void (*move)(__storage_type*, __storage_type*);
    void (*destroy)(__storage_type*);
    const type_info& (*target_type)();
    void* (*target)(__storage_type*);
    const void* (*const_target)(const __storage_type*);
};

template <class F, class Signature>
struct __manager;

template <class F, class Source, class Self, class Signature>
struct __valid_target;

template <class F, class Source, class Self, class R, class... Args>
struct __valid_target<F, Source, Self, R(Args...)>
    : bool_constant<!is_same<F, Self>::value &&
                    is_constructible<F, Source>::value &&
                    is_copy_constructible<F>::value &&
                    is_invocable_r<R, F&, Args...>::value> {
};

template <class F, class R, class... Args>
struct __manager<F, R(Args...)> {
  static constexpr bool is_local =
      sizeof(F) <= sizeof(__storage_type) &&
      alignof(F) <= alignof(__storage_type) &&
      is_nothrow_move_constructible<F>::value;

  static F*& heap_pointer(__storage_type& storage) {
    return *reinterpret_cast<F**>(storage.data);
  }

  static F* const& heap_pointer(const __storage_type& storage) {
    return *reinterpret_cast<F* const*>(storage.data);
  }

  static F* get(__storage_type& storage) {
    if constexpr (is_local) {
      return reinterpret_cast<F*>(storage.data);
    } else {
      return heap_pointer(storage);
    }
  }

  static const F* get(const __storage_type& storage) {
    if constexpr (is_local) {
      return reinterpret_cast<const F*>(storage.data);
    } else {
      return heap_pointer(storage);
    }
  }

  static R invoke_target(__storage_type* storage, Args... args) {
    F* target = get(*storage);
    if constexpr (is_void<R>::value) {
      std::invoke(*target, static_cast<Args&&>(args)...);
      return;
    } else {
      return std::invoke(*target, static_cast<Args&&>(args)...);
    }
  }

  static void copy(__storage_type* destination,
                   const __storage_type* source) {
    if constexpr (is_local) {
      ::new (static_cast<void*>(destination->data)) F(*get(*source));
    } else {
      heap_pointer(*destination) = new F(*get(*source));
    }
  }

  static void move(__storage_type* destination, __storage_type* source) {
    if constexpr (is_local) {
      F* source_target = get(*source);
      ::new (static_cast<void*>(destination->data))
          F(static_cast<F&&>(*source_target));
      source_target->~F();
    } else {
      heap_pointer(*destination) = heap_pointer(*source);
      heap_pointer(*source) = nullptr;
    }
  }

  static void destroy(__storage_type* storage) {
    if constexpr (is_local) {
      get(*storage)->~F();
    } else {
      delete heap_pointer(*storage);
      heap_pointer(*storage) = nullptr;
    }
  }

  static const type_info& target_type() {
    return typeid(F);
  }

  static void* target(__storage_type* storage) {
    return get(*storage);
  }

  static const void* const_target(const __storage_type* storage) {
    return get(*storage);
  }

  static const __operations* table() {
    static const __operations value = {
        reinterpret_cast<void*>(&invoke_target),
        &copy, &move, &destroy, &target_type, &target, &const_target};
    return &value;
  }
};

