template <class Left, class Right>
struct when_completions;

template <class... L, class... R>
struct when_completions<completion_signatures<L...>, completion_signatures<R...>> {
  using left_tuple = typename value_tuple<typename first_value_sig<L...>::type>::type;
  using right_tuple = typename value_tuple<typename first_value_sig<R...>::type>::type;
  using cat = typename cat_tuple<left_tuple, right_tuple>::type;
  static constexpr bool error = any_error<L..., R...>::value;
  static constexpr bool stopped = any_stopped<L..., R...>::value;
  using type = sig_concat_t<
      typename tuple_as_sig<cat>::type,
      conditional_t<error, completion_signatures<set_error_t(exception_ptr)>,
                    completion_signatures<>>,
      conditional_t<stopped, completion_signatures<set_stopped_t()>, completion_signatures<>>>;
};

