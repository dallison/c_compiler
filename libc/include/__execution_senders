template <class Left, class Right>
struct __when_all2 {
  using sender_concept = sender_t;
  using sender_tag = when_all_t;
  Left left;
  Right right;

  template <class Env>
  using completions = typename __exec::when_completions<completion_signatures_of_t<Left, Env>,
                                                        completion_signatures_of_t<Right, Env>>::type;

  env<> get_env() const noexcept { return {}; }

  template <class Rcvr>
  struct __state {
    struct __shared {
      Rcvr rcvr;
      atomic<int> remaining;
      atomic<bool> failed;
      atomic<bool> saw_stopped;
      exception_ptr error;
      typename __exec::value_tuple<typename __exec::first_value_of<
          completion_signatures_of_t<Left, env_of_t<Rcvr>>>::type>::type left_values;
      typename __exec::value_tuple<typename __exec::first_value_of<
          completion_signatures_of_t<Right, env_of_t<Rcvr>>>::type>::type right_values;

      explicit __shared(Rcvr receiver)
          : rcvr(static_cast<Rcvr&&>(receiver)), remaining(2), failed(false), saw_stopped(false) {}

      void arrive() noexcept {
        if (remaining.fetch_sub(1, memory_order_acq_rel) == 1) {
          if (failed.load(memory_order_acquire)) {
            set_error_t{}(rcvr, error);
          } else if (saw_stopped.load(memory_order_acquire)) {
            set_stopped_t{}(rcvr);
          } else {
            __exec::deliver_two(
                rcvr, static_cast<decltype(left_values)&&>(left_values),
                static_cast<decltype(right_values)&&>(right_values),
                make_index_sequence<tuple_size<decltype(left_values)>::value>{},
                make_index_sequence<tuple_size<decltype(right_values)>::value>{});
          }
        }
      }
    };

    template <bool IsLeft>
    struct __side {
      using receiver_concept = receiver_t;
      __shared* shared;

      template <class... Args>
      void set_value(Args&&... args) noexcept {
        if constexpr (IsLeft) {
          shared->left_values = decay_t<decltype(shared->left_values)>(static_cast<Args&&>(args)...);
        } else {
          shared->right_values =
              decay_t<decltype(shared->right_values)>(static_cast<Args&&>(args)...);
        }
        shared->arrive();
      }

      template <class Error>
      void set_error(Error&& error) noexcept {
        if (!shared->failed.exchange(true, memory_order_acq_rel)) {
          shared->error = __exec::to_exception_ptr(static_cast<Error&&>(error));
        }
        shared->arrive();
      }

      void set_stopped() noexcept {
        shared->saw_stopped.store(true, memory_order_release);
        shared->arrive();
      }

      auto get_env() const noexcept { return get_env_t{}(shared->rcvr); }
    };

    using __left_op = decltype(connect_t{}(declval<Left>(), declval<__side<true>>()));
    using __right_op = decltype(connect_t{}(declval<Right>(), declval<__side<false>>()));

    __shared shared;
    __left_op left_op;
    __right_op right_op;

    __state(Left&& left_sender, Right&& right_sender, Rcvr&& receiver)
        : shared(static_cast<Rcvr&&>(receiver)),
          left_op(connect_t{}(static_cast<Left&&>(left_sender), __side<true>{&shared})),
          right_op(connect_t{}(static_cast<Right&&>(right_sender), __side<false>{&shared})) {}

    void start() noexcept {
      start_t{}(left_op);
      start_t{}(right_op);
    }
  };

  template <class Rcvr>
  __exec::op_box<__state<decay_t<Rcvr>>> connect(Rcvr rcvr) {
    return __exec::make_op<__state<decay_t<Rcvr>>>(
        static_cast<Left&&>(left), static_cast<Right&&>(right), static_cast<Rcvr&&>(rcvr));
  }
};

