struct __let_error_state {
  struct __up {
    using receiver_concept = receiver_t;
    __let_error_state* self;
    template <class... Args>
    void set_value(Args&&... args) noexcept {
      set_value_t{}(self->rcvr, static_cast<Args&&>(args)...);
    }
    template <class Error>
    void set_error(Error&& error) noexcept {
#ifdef __cpp_exceptions
      try {
#endif
        auto child = invoke(self->fn, static_cast<Error&&>(error));
        self->launch(static_cast<decltype(child)&&>(child));
#ifdef __cpp_exceptions
      } catch (...) {
        set_error_t{}(self->rcvr, current_exception());
      }
#endif
    }
    void set_stopped() noexcept { set_stopped_t{}(self->rcvr); }
    auto get_env() const noexcept { return get_env_t{}(self->rcvr); }
  };

  struct __down {
    using receiver_concept = receiver_t;
    __let_error_state* self;
    template <class... Args>
    void set_value(Args&&... args) noexcept {
      set_value_t{}(self->rcvr, static_cast<Args&&>(args)...);
    }
    template <class Error>
    void set_error(Error&& error) noexcept {
      set_error_t{}(self->rcvr, static_cast<Error&&>(error));
    }
    void set_stopped() noexcept { set_stopped_t{}(self->rcvr); }
    auto get_env() const noexcept { return get_env_t{}(self->rcvr); }
  };

  template <class Completions>
  struct __child_of;

  template <class... Sigs>
  struct __child_of<completion_signatures<Sigs...>> {
    template <class Sig, class = void>
    struct pick {};
    template <class E>
    struct pick<set_error_t(E)> {
      using type = invoke_result_t<Fn, E>;
    };
    template <class Sig, class... Rest>
    struct walk {
      using type = typename conditional_t<__exec::is_error_sig<Sig>::value, pick<Sig>,
                                          walk<Rest...>>::type;
    };
    template <class Sig>
    struct walk<Sig> {
      using type = typename pick<Sig>::type;
    };
    using type = typename walk<Sigs...>::type;
  };

  using __child_sender =
      typename __child_of<completion_signatures_of_t<Sndr, env_of_t<Down>>>::type;
  using __child_op = decltype(connect_t{}(declval<__child_sender>(), declval<__down>()));
  using __up_op = decltype(connect_t{}(declval<Sndr>(), declval<__up>()));

  Down rcvr;
