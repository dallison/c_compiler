    template <class... Args>
    void set_value(Args&&... args) noexcept {
      if constexpr (!is_void_v<Value>) {
        self->result.emplace(static_cast<Args&&>(args)...);
      }
      self->notify();
    }

    template <class Error>
    void set_error(Error&& error) noexcept {
      self->error = __exec::to_exception_ptr(static_cast<Error&&>(error));
      self->notify();
    }

    void set_stopped() noexcept {
      self->stopped = true;
      self->notify();
    }

    env<> get_env() const noexcept { return {}; }
  };

  using __op = decltype(connect_t{}(declval<Sndr>(), declval<__rcvr>()));

  Sndr sndr;
  Promise* promise;
  conditional_t<is_void_v<Value>, char, optional<Value>> result;
  exception_ptr error;
  bool stopped;
  bool completed;
  bool started;
  coroutine_handle<> continuation;
  __op* op;

  __sender_awaiter(Sndr&& source, Promise& owner)
      : sndr(static_cast<Sndr&&>(source)),
        promise(&owner),
        stopped(false),
        completed(false),
        started(false),
        op(nullptr) {}

  __sender_awaiter(const __sender_awaiter&) = delete;
  __sender_awaiter& operator=(const __sender_awaiter&) = delete;

  ~__sender_awaiter() {
    if (op == nullptr) {
      return;
    }
    if constexpr (__exec::can_own_op<Promise, __op>::value) {
      promise->__own_operation(op);
    } else {
      delete op;
    }
    op = nullptr;
  }

  bool await_ready() const noexcept { return false; }

  bool await_suspend(coroutine_handle<> handle) {
    continuation = handle;
    op = new __op(connect_t{}(static_cast<Sndr&&>(sndr), __rcvr{this}));
    start_t{}(*op);
    started = true;
    return !completed;
  }

  Value await_resume() {
    if (error) {
      rethrow_exception(error);
    }
    if (stopped) {
#ifdef __cpp_exceptions
      throw __exec::task_stopped{};
#else
      terminate();
#endif
    }
    if constexpr (!is_void_v<Value>) {
      return static_cast<Value&&>(*result);
    }
  }

  void notify() noexcept {
    completed = true;
    if (started && continuation) {
      continuation.resume();
    }
  }
};

struct as_awaitable_t {
  template <class Expr, class Promise>
  decltype(auto) operator()(Expr&& expr, Promise& promise) const {
    if constexpr (__exec::is_sender<remove_cvref_t<Expr>>::value) {
      using Sndr = remove_cvref_t<Expr>;
      using Value =
          typename __exec::await_type_of<completion_signatures_of_t<Sndr, env<>>>::type;
      return __sender_awaiter<Sndr, Value, Promise>(static_cast<Expr&&>(expr), promise);
    } else {
      return static_cast<Expr&&>(expr);
    }
  }
};

inline constexpr as_awaitable_t as_awaitable{};

template <class Promise>
struct with_awaitable_senders {
  struct __owned {
    void (*destroy)(void*) noexcept;
    void* pointer;
    __owned* next;
  };

  __owned* __owned_head;

  with_awaitable_senders() noexcept : __owned_head(nullptr) {}
  with_awaitable_senders(const with_awaitable_senders&) = delete;
  with_awaitable_senders& operator=(const with_awaitable_senders&) = delete;

  ~with_awaitable_senders() { __destroy_owned(); }

  template <class Op>
  void __own_operation(Op* op) {
    auto* node = new __owned;
    node->destroy = &__destroy_one<Op>;
    node->pointer = op;
    node->next = __owned_head;
    __owned_head = node;
  }

  template <class Value>
  decltype(auto) await_transform(Value&& value) {
    return as_awaitable(static_cast<Value&&>(value), static_cast<Promise&>(*this));
  }

  void __destroy_owned() noexcept {
    while (__owned_head != nullptr) {
      __owned* node = __owned_head;
      __owned_head = node->next;
      node->destroy(node->pointer);
      delete node;
    }
  }

  template <class Op>
  static void __destroy_one(void* pointer) noexcept {
    delete static_cast<Op*>(pointer);
  }
};

template <class T>
struct __task_return {
  optional<T> result;
  void return_value(T value) { result = static_cast<T&&>(value); }
};

template <>
struct __task_return<void> {
  void return_void() noexcept {}
};

template <class T = void>
class task {
 public:
  class promise_type : public with_awaitable_senders<promise_type>, public __task_return<T> {
   public:
    __exec::task_bridge* bridge;
    exception_ptr error;
    bool stopped;

    promise_type() : bridge(nullptr), stopped(false) {}

    task get_return_object() {
      return task{coroutine_handle<promise_type>::from_promise(*this)};
    }

    suspend_always initial_suspend() noexcept { return {}; }

    auto final_suspend() noexcept {
      struct __awaiter {
        bool await_ready() const noexcept { return false; }

        coroutine_handle<> await_suspend(coroutine_handle<promise_type> handle) noexcept {
          promise_type& promise = handle.promise();
          __exec::task_bridge* bridge = promise.bridge;
          if (bridge == nullptr) {
            return noop_coroutine();
          }
          if (promise.error) {
            bridge->on_error(bridge->object, promise.error);
          } else if (promise.stopped) {
            bridge->on_stopped(bridge->object);
          } else {
            bridge->on_value(bridge->object);
          }
          return noop_coroutine();
        }

        void await_resume() const noexcept {}
      };
      return __awaiter{};
    }

    void unhandled_exception() {
#ifdef __cpp_exceptions
      try {
        throw;
      } catch (const __exec::task_stopped&) {
        stopped = true;
      } catch (...) {
        error = current_exception();
      }
#else
      terminate();
#endif
    }
  };

  using sender_concept = sender_t;
  using sender_tag = task;

  template <class Env>
  using completions = conditional_t<
      is_void_v<T>,
      completion_signatures<set_value_t(), set_error_t(exception_ptr), set_stopped_t()>,
      completion_signatures<set_value_t(T), set_error_t(exception_ptr), set_stopped_t()>>;

  env<> get_env() const noexcept { return {}; }

  task() noexcept : __coro(nullptr) {}

  task(task&& other) noexcept : __coro(other.__coro) { other.__coro = nullptr; }

  task(const task&) = delete;
  task& operator=(const task&) = delete;

  task& operator=(task&& other) noexcept {
    if (this != &other) {
      if (__coro) {
        __coro.destroy();
      }
      __coro = other.__coro;
      other.__coro = nullptr;
    }
    return *this;
  }

  ~task() {
    if (__coro) {
      __coro.destroy();
    }
  }

  template <class Rcvr>
  struct __state {
    Rcvr rcvr;
    coroutine_handle<promise_type> coro;
    __exec::task_bridge bridge;

    __state(coroutine_handle<promise_type> handle, Rcvr receiver)
        : rcvr(static_cast<Rcvr&&>(receiver)), coro(handle) {
      bridge.object = this;
      bridge.on_value = &on_value;
      bridge.on_error = &on_error;
      bridge.on_stopped = &on_stopped;
    }

    static void on_value(void* object) {
      auto* self = static_cast<__state*>(object);
      if constexpr (is_void_v<T>) {
        set_value_t{}(self->rcvr);
      } else {
        set_value_t{}(self->rcvr, static_cast<T&&>(*self->coro.promise().result));
      }
    }

    static void on_error(void* object, exception_ptr error) {
      set_error_t{}(static_cast<__state*>(object)->rcvr, error);
    }

    static void on_stopped(void* object) { set_stopped_t{}(static_cast<__state*>(object)->rcvr); }

    void start() noexcept {
      coro.promise().bridge = &bridge;
      coro.resume();
    }
  };

  template <class Rcvr>
  __exec::op_box<__state<decay_t<Rcvr>>> connect(Rcvr rcvr) {
    auto handle = __coro;
    __coro = nullptr;
    return __exec::make_op<__state<decay_t<Rcvr>>>(handle, static_cast<Rcvr&&>(rcvr));
  }

 private:
  explicit task(coroutine_handle<promise_type> handle) : __coro(handle) {}

  coroutine_handle<promise_type> __coro;
};

