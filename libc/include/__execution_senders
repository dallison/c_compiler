// let_value / let_error / let_stopped, when_all, variant adaptors, schedulers,
// and coroutine task are defined next to keep each sender's operation state
// next to the algorithm that builds it.

template <class Child, class Sig>
struct __let_from_sig;

template <class Child, class... Args>
struct __let_from_sig<Child, set_value_t(Args...)> {
  using sender_type = invoke_result_t<Child, Args...>;
};

template <class Child, class Error>
struct __let_from_error {
  using sender_type = invoke_result_t<Child, Error>;
};

template <class Sndr, class Fn, class Down>
struct __let_value_state {
  struct __up {
    using receiver_concept = receiver_t;
    __let_value_state* self;

    template <class... Args>
    void set_value(Args&&... args) noexcept {
#ifdef __cpp_exceptions
      try {
#endif
        auto child = invoke(self->fn, static_cast<Args&&>(args)...);
        self->launch(static_cast<decltype(child)&&>(child));
#ifdef __cpp_exceptions
      } catch (...) {
        set_error_t{}(self->rcvr, current_exception());
      }
#endif
    }

    template <class Error>
    void set_error(Error&& error) noexcept {
      set_error_t{}(self->rcvr, static_cast<Error&&>(error));
    }

    void set_stopped() noexcept { set_stopped_t{}(self->rcvr); }

    auto get_env() const noexcept { return get_env_t{}(self->rcvr); }
  };

  struct __down {
    using receiver_concept = receiver_t;
    __let_value_state* self;

    template <class... Args>
    void set_value(Args&&... args) noexcept {
      set_value_t{}(self->rcvr, static_cast<Args&&>(args)...);
    }

    template <class Error>
    void set_error(Error&& error) noexcept {
      set_error_t{}(self->rcvr, static_cast<Error&&>(error));
    }

    void set_stopped() noexcept { set_stopped_t{}(self->rcvr); }

    auto get_env() const noexcept { return get_env_t{}(self->rcvr); }
  };

  using __value_sig =
      typename __exec::first_value_of<completion_signatures_of_t<Sndr, env_of_t<Down>>>::type;
  using __child_sender = typename __let_from_sig<Fn, __value_sig>::sender_type;
  using __child_op = decltype(connect_t{}(declval<__child_sender>(), declval<__down>()));
  using __up_op = decltype(connect_t{}(declval<Sndr>(), declval<__up>()));

  Down rcvr;
  Fn fn;
  __up_op upstream;
  alignas(__child_op) unsigned char storage[sizeof(__child_op)];
  bool alive;

  __let_value_state(Sndr&& source, Fn&& function, Down&& receiver)
      : rcvr(static_cast<Down&&>(receiver)),
        fn(static_cast<Fn&&>(function)),
        upstream(connect_t{}(static_cast<Sndr&&>(source), __up{this})),
        alive(false) {}

  __let_value_state(const __let_value_state&) = delete;
  __let_value_state& operator=(const __let_value_state&) = delete;

  ~__let_value_state() {
    if (alive) {
      reinterpret_cast<__child_op*>(storage)->~__child_op();
    }
  }

  template <class Child>
  void launch(Child&& child) {
    auto* op = new (storage) __child_op(
        connect_t{}(static_cast<Child&&>(child), __down{this}));
    alive = true;
    start_t{}(*op);
  }

  void start() noexcept { start_t{}(upstream); }
};

