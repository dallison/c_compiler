  using receiver_concept = receiver_t;
  __sync_result* result;
  optional<Tuple>* value;

  template <class... Args>
  void set_value(Args&&... args) noexcept {
    value->emplace(static_cast<Args&&>(args)...);
    result->done = true;
  }

  template <class Error>
  void set_error(Error&& error) noexcept {
    result->error = __exec::to_exception_ptr(static_cast<Error&&>(error));
    result->done = true;
  }

  void set_stopped() noexcept {
    result->stopped = true;
    result->done = true;
  }

  env<> get_env() const noexcept { return {}; }
};

template <class Sndr>
using __sync_tuple_t = typename __exec::value_tuple<typename __exec::first_value_of<
    completion_signatures_of_t<Sndr, env<>>>::type>::type;

// Returning optional<__sync_tuple_t<S>> from a function template crashes code
// generation: the alias never becomes a concrete class in the return type.
// A class template whose return type is spelled tuple<Ts...> does.
template <class... Ts>
struct __sync_runner {
  template <class Sndr>
  static optional<tuple<Ts...>> run(Sndr&& sndr) {
    using Tuple = tuple<Ts...>;
    __sync_result result{false, false, {}};
    optional<Tuple> value;
    __sync_value_receiver<Tuple> rcvr;
    rcvr.result = &result;
    rcvr.value = &value;
    {
      auto operation = connect(static_cast<Sndr&&>(sndr), rcvr);
      start(operation);
    }
    if (result.error) {
      rethrow_exception(result.error);
    }
    if (result.stopped || !result.done) {
      optional<Tuple> empty;
      value = static_cast<optional<Tuple>&&>(empty);
    }
    return value;
  }
};

