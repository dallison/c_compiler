  auto get_env() const noexcept { return get_env_t{}(sndr); }

  template <class Rcvr>
  struct __state {
    struct __rcvr {
      using receiver_concept = receiver_t;
      __state* self;
      explicit __rcvr(__state* state) : self(state) {}

      template <class... Args>
      void set_value(Args&&... args) noexcept {
        __then_complete(self->fn, self->rcvr, static_cast<Args&&>(args)...);
      }

      template <class Error>
      void set_error(Error&& error) noexcept {
        set_error_t{}(self->rcvr, static_cast<Error&&>(error));
