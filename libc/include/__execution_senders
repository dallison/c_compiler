class run_loop {
 public:
  class scheduler_type;

 private:
  struct __node {
    void (*fn)(__node*) noexcept;
    __node* next;
  };

  mutex mutex_;
  condition_variable cv_;
  __node* head_;
  __node* tail_;
  bool finished_;

  void enqueue(__node* node) {
    {
      lock_guard<mutex> guard(mutex_);
      node->next = nullptr;
      if (tail_ == nullptr) {
        head_ = node;
      } else {
        tail_->next = node;
      }
      tail_ = node;
    }
    cv_.notify_one();
  }

  friend class scheduler_type;

 public:
  run_loop() : head_(nullptr), tail_(nullptr), finished_(false) {}
  run_loop(const run_loop&) = delete;
  run_loop& operator=(const run_loop&) = delete;

  class scheduler_type {
   public:
    using scheduler_concept = scheduler_t;

    struct __sender {
      using sender_concept = sender_t;
      using sender_tag = schedule_t;
      run_loop* loop;

      template <class Env>
      using completions = completion_signatures<set_value_t(), set_stopped_t()>;

      auto get_env() const {
        return env{prop{get_completion_scheduler_t<set_value_t>{}, scheduler_type{loop}}};
      }

      template <class Rcvr>
      struct __state {
        struct __node_impl : __node {
          __state* self;
        };

        Rcvr rcvr;
        run_loop* loop;
        __node_impl node;
        atomic<bool> ready;

        __state(Rcvr receiver, run_loop* owner)
            : rcvr(static_cast<Rcvr&&>(receiver)), loop(owner), ready(false) {
          node.fn = &complete;
          node.self = this;
        }

        static void complete(__node* raw) noexcept {
          auto* self = static_cast<__node_impl*>(raw)->self;
          while (!self->ready.load(memory_order_acquire)) {
          }
          if (get_stop_token(get_env(self->rcvr)).stop_requested()) {
            set_stopped(self->rcvr);
          } else {
            set_value(self->rcvr);
          }
        }

        void start() noexcept {
          loop->enqueue(&node);
          ready.store(true, memory_order_release);
        }
      };

      template <class Rcvr>
      __exec::op_box<__state<decay_t<Rcvr>>> connect(Rcvr rcvr) const {
        return __exec::make_op<__state<decay_t<Rcvr>>>(static_cast<Rcvr&&>(rcvr), loop);
      }
    };

    run_loop* loop;

    __sender schedule() const { return {loop}; }

    constexpr forward_progress_guarantee query(get_forward_progress_guarantee_t) const noexcept {
      return forward_progress_guarantee::parallel;
    }

    friend bool operator==(const scheduler_type& left, const scheduler_type& right) noexcept {
      return left.loop == right.loop;
    }
  };

  scheduler_type get_scheduler() { return {this}; }

  void run() {
    unique_lock<mutex> lock(mutex_);
    while (!(finished_ && head_ == nullptr)) {
      if (head_ == nullptr) {
        cv_.wait(lock);
        continue;
      }
      __node* node = head_;
      head_ = node->next;
      if (head_ == nullptr) {
        tail_ = nullptr;
      }
      lock.unlock();
      node->fn(node);
      lock.lock();
    }
  }

  void finish() {
    {
      lock_guard<mutex> guard(mutex_);
      finished_ = true;
    }
    cv_.notify_one();
  }
};

