template <class E>
exception_ptr to_exception_ptr(E&& error) {
  if constexpr (is_same_v<decay_t<E>, exception_ptr>) {
    return static_cast<E&&>(error);
  } else {
#ifdef __cpp_exceptions
    return make_exception_ptr(static_cast<E&&>(error));
#else
    static_cast<void>(error);
    terminate();
#endif
  }
}

template <class Rcvr, class Tuple, size_t... I>
