template <class Fn, class Rcvr, class... Args>
void __then_complete(Fn& fn, Rcvr& rcvr, Args&&... args) {
  using Result = invoke_result_t<Fn&, Args...>;
  if constexpr (is_void_v<Result>) {
    fn(static_cast<Args&&>(args)...);
    set_value_t{}(rcvr);
  } else {
    set_value_t{}(rcvr, fn(static_cast<Args&&>(args)...));
  }
}

