template <class T>
concept queryable = destructible<T>;

template <class Rcvr>
concept receiver =
    requires { typename remove_cvref_t<Rcvr>::receiver_concept; } &&
    derived_from<typename remove_cvref_t<Rcvr>::receiver_concept, receiver_t> &&
    requires(const remove_cvref_t<Rcvr>& rcvr) {
      { get_env(rcvr) } -> queryable;
    } && move_constructible<remove_cvref_t<Rcvr>> &&
    constructible_from<remove_cvref_t<Rcvr>, Rcvr>;

template <class Rcvr, class Sig>
struct __completion_matches : false_type {};

template <class Rcvr, class... Args>
struct __completion_matches<Rcvr, set_value_t(Args...)>
    : bool_constant<is_invocable_v<set_value_t, Rcvr, Args...>> {};

template <class Rcvr, class Error>
struct __completion_matches<Rcvr, set_error_t(Error)>
    : bool_constant<is_invocable_v<set_error_t, Rcvr, Error>> {};

template <class Rcvr>
struct __completion_matches<Rcvr, set_stopped_t()>
    : bool_constant<is_invocable_v<set_stopped_t, Rcvr>> {};

template <class Rcvr, class Completions>
struct __receiver_of_impl : false_type {};

template <class Rcvr, class... Sigs>
struct __receiver_of_impl<Rcvr, completion_signatures<Sigs...>>
    : bool_constant<(__completion_matches<Rcvr, Sigs>::value && ...)> {};

template <class Rcvr, class Completions>
concept receiver_of = receiver<Rcvr> && __receiver_of_impl<Rcvr, Completions>::value;

template <class Sndr>
concept sender =
    requires { typename remove_cvref_t<Sndr>::sender_concept; } &&
    derived_from<typename remove_cvref_t<Sndr>::sender_concept, sender_t> &&
    requires(const remove_cvref_t<Sndr>& sndr) {
      { get_env(sndr) } -> queryable;
    } && move_constructible<remove_cvref_t<Sndr>> &&
    constructible_from<remove_cvref_t<Sndr>, Sndr>;

template <class Sndr, class Env = env<>>
concept sender_in =
    sender<Sndr> && queryable<Env> && requires { typename completion_signatures_of_t<Sndr, Env>; };

template <class Sndr>
concept dependent_sender =
    sender<Sndr> && !requires { typename completion_signatures_of_t<Sndr, env<>>; };

template <class Rcvr>
using env_of_t = decltype(get_env(declval<const remove_cvref_t<Rcvr>&>()));

template <class Sndr, class Rcvr>
using connect_result_t = decltype(connect(declval<Sndr>(), declval<Rcvr>()));

template <class Sndr, class Rcvr>
concept sender_to =
    sender_in<Sndr, env_of_t<Rcvr>> &&
    receiver_of<Rcvr, completion_signatures_of_t<Sndr, env_of_t<Rcvr>>> &&
    requires(Sndr&& sndr, Rcvr&& rcvr) {
      connect(static_cast<Sndr&&>(sndr), static_cast<Rcvr&&>(rcvr));
    };

template <class Op>
concept operation_state =
    requires { typename Op::operation_state_concept; } &&
