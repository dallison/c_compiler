struct set_value_t {
  template <class Rcvr, class... Args>
  void operator()(Rcvr&& rcvr, Args&&... args) const
      noexcept(noexcept(
          static_cast<Rcvr&&>(rcvr).set_value(static_cast<Args&&>(args)...))) {
    static_cast<Rcvr&&>(rcvr).set_value(static_cast<Args&&>(args)...);
  }
};

struct set_error_t {
  template <class Rcvr, class Error>
  void operator()(Rcvr&& rcvr, Error&& error) const
      noexcept(noexcept(
          static_cast<Rcvr&&>(rcvr).set_error(static_cast<Error&&>(error)))) {
    static_cast<Rcvr&&>(rcvr).set_error(static_cast<Error&&>(error));
  }
};

struct set_stopped_t {
  template <class Rcvr>
  void operator()(Rcvr&& rcvr) const
      noexcept(noexcept(static_cast<Rcvr&&>(rcvr).set_stopped())) {
    static_cast<Rcvr&&>(rcvr).set_stopped();
  }
};

struct start_t {
  template <class Op>
  void operator()(Op&& op) const {
    static_cast<Op&&>(op).start();
  }
};

struct connect_t {
  template <class Sndr, class Rcvr>
  auto operator()(Sndr&& sndr, Rcvr&& rcvr) const {
    return static_cast<Sndr&&>(sndr).connect(static_cast<Rcvr&&>(rcvr));
  }
};

inline constexpr set_value_t set_value{};
inline constexpr set_error_t set_error{};
inline constexpr set_stopped_t set_stopped{};
inline constexpr start_t start{};
inline constexpr connect_t connect{};

