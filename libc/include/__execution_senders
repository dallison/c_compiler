  set_value_t{}(rcvr, get<I>(static_cast<Tuple&&>(values))...);
}

template <class Rcvr, class Left, class Right, size_t... IL, size_t... IR>
void deliver_two(Rcvr& rcvr, Left&& left, Right&& right, index_sequence<IL...>,
                 index_sequence<IR...>) {
  set_value_t{}(rcvr, get<IL>(static_cast<Left&&>(left))...,
                get<IR>(static_cast<Right&&>(right))...);
}

