template <class State>
struct op_box {
  using operation_state_concept = operation_state_t;
  State* state;

  explicit op_box(State* value) noexcept : state(value) {}
  op_box(op_box&& other) noexcept : state(other.state) { other.state = nullptr; }
  op_box(const op_box&) = delete;
  op_box& operator=(const op_box&) = delete;
  op_box& operator=(op_box&&) = delete;
  ~op_box() { delete state; }
  void start() noexcept { state->start(); }
};

template <class State, class... Args>
op_box<State> make_op(Args&&... args) {
  return op_box<State>(new State(static_cast<Args&&>(args)...));
}

