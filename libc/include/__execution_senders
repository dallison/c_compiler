template <class... Envs>
struct env;

template <>
struct env<> {};

template <class Query, class Value>
struct prop {
  Value value;

  constexpr prop(Query, Value stored) : value(static_cast<Value&&>(stored)) {}

  constexpr const Value& query(Query) const noexcept { return value; }
};

template <class Query, class Value>
prop(Query, Value) -> prop<Query, Value>;

template <class First, class... Rest>
struct env<First, Rest...> {
  First first;
  env<Rest...> rest;

  constexpr env(First head, Rest... tail)
      : first(static_cast<First&&>(head)), rest(static_cast<Rest&&>(tail)...) {}

  template <class Query>
  constexpr auto __query(__exec::priority<1>, Query query) const
      -> decltype(first.query(query)) {
    return first.query(query);
  }

  template <class Query>
  constexpr auto __query(__exec::priority<0>, Query query) const
      -> decltype(rest.query(query)) {
    return rest.query(query);
  }

  template <class Query>
  constexpr auto query(Query query) const
      -> decltype(__query(__exec::priority<1>{}, query)) {
    return __query(__exec::priority<1>{}, query);
  }
};

template <class... Envs>
env(Envs...) -> env<Envs...>;

