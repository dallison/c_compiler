template <class... Ts>
struct __just_sender {
  using sender_concept = sender_t;
  using sender_tag = just_t;

  tuple<Ts...> values;

  explicit __just_sender(tuple<Ts...> stored)
      : values(static_cast<tuple<Ts...>&&>(stored)) {}

  template <class Env>
  using completions = completion_signatures<set_value_t(Ts...), set_stopped_t()>;

  env<> get_env() const noexcept { return {}; }

  template <class Rcvr>
  struct __op {
    using operation_state_concept = operation_state_t;
    tuple<Ts...> values;
    Rcvr rcvr;

    __op(tuple<Ts...> stored, Rcvr receiver)
        : values(static_cast<tuple<Ts...>&&>(stored)),
          rcvr(static_cast<Rcvr&&>(receiver)) {}

    __op(__op&&) = default;
    __op(const __op&) = default;

    void start() noexcept {
      if (get_stop_token(get_env(rcvr)).stop_requested()) {
        set_stopped_t{}(rcvr);
        return;
      }
      if constexpr (sizeof...(Ts) == 0) {
        set_value_t{}(rcvr);
      } else if constexpr (sizeof...(Ts) == 1) {
        set_value_t{}(rcvr, get<0>(static_cast<tuple<Ts...>&&>(values)));
      } else if constexpr (sizeof...(Ts) == 2) {
        set_value_t{}(rcvr, get<0>(values), get<1>(values));
      } else if constexpr (sizeof...(Ts) == 3) {
        set_value_t{}(rcvr, get<0>(values), get<1>(values), get<2>(values));
      }
    }
  };

  template <class Rcvr>
  __op<Rcvr> connect(Rcvr rcvr) {
    return __op<Rcvr>(static_cast<tuple<Ts...>&&>(values), static_cast<Rcvr&&>(rcvr));
  }
};

