#ifndef utility_h
#define utility_h

#include <compare>
#include <stddef.h>
#include <type_traits>

namespace std {

struct in_place_t {
  explicit in_place_t() = default;
};

inline constexpr in_place_t in_place{};

template <class T>
struct in_place_type_t {
  explicit in_place_type_t() = default;
};

template <class T>
inline constexpr in_place_type_t<T> in_place_type{};

template <size_t I>
struct in_place_index_t {
  explicit in_place_index_t() = default;
};

template <size_t I>
inline constexpr in_place_index_t<I> in_place_index{};

struct piecewise_construct_t {
  explicit piecewise_construct_t() = default;
};

inline constexpr piecewise_construct_t piecewise_construct{};

struct identity {
  using is_transparent = void;

  template <class T>
  constexpr T&& operator()(T&& value) const noexcept {
    return static_cast<T&&>(value);
  }
};

template <class T>
inline constexpr remove_reference_t<T>&& move(T&& value) noexcept {
  return static_cast<remove_reference_t<T>&&>(value);
}

template <class T>
inline constexpr T&& forward(remove_reference_t<T>& value) noexcept {
  return static_cast<T&&>(value);
}

template <class T>
inline constexpr T&& forward(remove_reference_t<T>&& value) noexcept {
  return static_cast<T&&>(value);
}

template <class T>
inline constexpr T&& move_if_noexcept(T& value) noexcept {
  return std::move(value);
}

template <class T, class U = T>
inline T exchange(T& object, U&& new_value) {
  T old_value = std::move(object);
  object = std::forward<U>(new_value);
  return old_value;
}

template <class T>
inline void swap(T& left, T& right) {
  T tmp = std::move(left);
  left = std::move(right);
  right = std::move(tmp);
}

template <class T, T... Ints>
struct integer_sequence {
  using value_type = T;

  static constexpr size_t size() noexcept {
    return sizeof...(Ints);
  }
};

template <size_t... Ints>
using index_sequence = integer_sequence<size_t, Ints...>;

template <size_t N, size_t... Ints>
struct __make_index_sequence
    : __make_index_sequence<N - 1, N - 1, Ints...> {};

template <size_t... Ints>
struct __make_index_sequence<0, Ints...> {
  using type = index_sequence<Ints...>;
};

template <size_t N>
using make_index_sequence = typename __make_index_sequence<N>::type;

template <class... Types>
using index_sequence_for = make_index_sequence<sizeof...(Types)>;

// P1789: structured binding and expansion-statement support for
// integer_sequence.
template <class T>
struct tuple_size;

template <size_t I, class T>
struct tuple_element;

template <class T, T... Values>
struct tuple_size<integer_sequence<T, Values...>>
    : integral_constant<size_t, sizeof...(Values)> {};

template <size_t I, class T, T... Values>
struct tuple_element<I, integer_sequence<T, Values...>> {
  using type = T;
};

template <size_t I, class T, T... Values>
struct tuple_element<I, const integer_sequence<T, Values...>> {
  using type = const T;
};

template <size_t I, class T, T... Values>
struct __integer_sequence_get;

template <class T, T Value, T... Rest>
struct __integer_sequence_get<0, T, Value, Rest...> {
  static constexpr T value = Value;
};

template <size_t I, class T, T Value, T... Rest>
struct __integer_sequence_get<I, T, Value, Rest...>
    : __integer_sequence_get<I - 1, T, Rest...> {};

template <size_t I, class T, T... Values>
constexpr T get(integer_sequence<T, Values...>) noexcept {
  return __integer_sequence_get<I, T, Values...>::value;
}

template <class T1, class T2>
struct pair {
  T1 first;
  T2 second;

  constexpr pair() {}

  constexpr pair(const T1& first_value, const T2& second_value)
      : first(first_value), second(second_value) {}

  // Converting constructors: build a pair from another pair whose elements are
  // convertible (e.g. pair<iterator, bool> from pair<const_iterator, bool>, or
  // pair<const K, V> from pair<K, V>).  These enable the many implicit pair
  // conversions the containers rely on.
  template <class U1, class U2>
  constexpr pair(const pair<U1, U2>& other)
      : first(other.first), second(other.second) {}

  template <class U1, class U2>
  constexpr pair(pair<U1, U2>&& other)
      : first(static_cast<U1&&>(other.first)),
        second(static_cast<U2&&>(other.second)) {}
};

template <class T1, class T2>
constexpr pair<decay_t<T1>, decay_t<T2>> make_pair(T1&& first,
                                                    T2&& second) {
  return pair<decay_t<T1>, decay_t<T2>>(static_cast<T1&&>(first),
                                         static_cast<T2&&>(second));
}

template <class T1, class T2, class U1, class U2>
constexpr bool operator==(const pair<T1, T2>& left,
                          const pair<U1, U2>& right) {
  return left.first == right.first && left.second == right.second;
}

template <class T1, class T2, class U1, class U2>
constexpr bool operator!=(const pair<T1, T2>& left,
                          const pair<U1, U2>& right) {
  return !(left == right);
}

template <class T1, class T2, class U1, class U2>
constexpr auto operator<=>(const pair<T1, T2>& left,
                           const pair<U1, U2>& right) {
  auto first_cmp = left.first <=> right.first;
  if (first_cmp != 0) {
    return first_cmp;
  }
  return left.second <=> right.second;
}

}  // namespace std

#endif /* utility_h */
