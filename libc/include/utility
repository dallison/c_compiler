#ifndef utility_h
#define utility_h

#include <stddef.h>
#include <type_traits>

namespace std {

struct in_place_t {
  explicit in_place_t() = default;
};

const in_place_t in_place{};

template <class T>
struct in_place_type_t {
  explicit in_place_type_t() = default;
};

template <class T>
const in_place_type_t<T> in_place_type{};

template <size_t I>
struct in_place_index_t {
  explicit in_place_index_t() = default;
};

template <size_t I>
const in_place_index_t<I> in_place_index{};

template <class T>
static inline constexpr remove_reference_t<T>&& move(T&& value) noexcept {
  return static_cast<remove_reference_t<T>&&>(value);
}

template <class T>
static inline constexpr T&& forward(remove_reference_t<T>& value) noexcept {
  return static_cast<T&&>(value);
}

template <class T>
static inline constexpr T&& forward(remove_reference_t<T>&& value) noexcept {
  return static_cast<T&&>(value);
}

template <class T>
static inline constexpr T&& move_if_noexcept(T& value) noexcept {
  return std::move(value);
}

template <class T, class U = T>
static inline T exchange(T& object, U&& new_value) {
  T old_value = std::move(object);
  object = std::forward<U>(new_value);
  return old_value;
}

template <class T>
static inline void swap(T& left, T& right) {
  T tmp = std::move(left);
  left = std::move(right);
  right = std::move(tmp);
}

template <class T, T... Ints>
struct integer_sequence {
  using value_type = T;

  static constexpr size_t size() noexcept {
    return sizeof...(Ints);
  }
};

template <size_t... Ints>
using index_sequence = integer_sequence<size_t, Ints...>;

template <class T1, class T2>
struct pair {
  T1 first;
  T2 second;

  constexpr pair() {}
  constexpr pair(const T1& first_value, const T2& second_value)
      : first(first_value), second(second_value) {}
};

}  // namespace std

#endif /* utility_h */
