class time_zone_link {
  char __name_[256];
  char __target_[256];

 public:
  time_zone_link() {
    __name_[0] = '\0';
    __target_[0] = '\0';
  }
  time_zone_link(const time_zone_link&) = default;
  time_zone_link& operator=(const time_zone_link&) = default;
  time_zone_link(time_zone_link&&) = default;
  time_zone_link& operator=(time_zone_link&&) = default;
  ~time_zone_link() = default;

  time_zone_link(const char* name, const char* target) {
    strncpy(__name_, name == nullptr ? "" : name, sizeof(__name_) - 1);
    __name_[sizeof(__name_) - 1] = '\0';
    strncpy(__target_, target == nullptr ? "" : target, sizeof(__target_) - 1);
    __target_[sizeof(__target_) - 1] = '\0';
  }

  string_view name() const noexcept { return string_view(__name_); }
  string_view target() const noexcept { return string_view(__target_); }

  friend bool operator==(const time_zone_link& left,
                         const time_zone_link& right) noexcept {
    return left.name() == right.name() && left.target() == right.target();
  }
};

class leap_second {
  sys_seconds __date_;
  seconds __value_;

 public:
  leap_second() = default;
  leap_second(sys_seconds date, seconds value) : __date_(date), __value_(value) {}

  sys_seconds date() const noexcept { return __date_; }
  seconds value() const noexcept { return __value_; }
  explicit operator sys_seconds() const noexcept { return __date_; }

  friend bool operator==(const leap_second& left,
                         const leap_second& right) noexcept {
    return left.__date_ == right.__date_ && left.__value_ == right.__value_;
  }
};

