  time_zone& operator=(const time_zone&) = default;
  time_zone(time_zone&&) = default;
  time_zone& operator=(time_zone&&) = default;
  ~time_zone() = default;

  explicit time_zone(const char* name) {
    if (name == nullptr) {
      __name_[0] = '\0';
      return;
    }
    strncpy(__name_, name, sizeof(__name_) - 1);
    __name_[sizeof(__name_) - 1] = '\0';
  }

  string_view name() const noexcept { return string_view(__name_); }

  sys_info get_info(sys_seconds tp) const;
  local_info get_info(local_seconds tp) const;
  local_seconds to_local(sys_seconds tp) const;
  sys_seconds to_sys(local_seconds tp, choose c = choose::earliest) const;

  template <class Duration>
  sys_info get_info(time_point<system_clock, Duration> tp) const {
    return get_info(sys_seconds(duration_cast<seconds>(tp.time_since_epoch())));
  }
  template <class Duration>
  local_info get_info(local_time<Duration> tp) const {
    return get_info(local_seconds(duration_cast<seconds>(tp.time_since_epoch())));
  }
  template <class Duration>
  local_time<Duration> to_local(time_point<system_clock, Duration> tp) const {
    return local_time<Duration>(duration_cast<Duration>(
        to_local(sys_seconds(duration_cast<seconds>(tp.time_since_epoch())))
            .time_since_epoch()));
  }
  template <class Duration>
  time_point<system_clock, Duration> to_sys(local_time<Duration> tp,
                                             choose c = choose::earliest) const {
    return time_point<system_clock, Duration>(
        to_sys(local_seconds(duration_cast<seconds>(tp.time_since_epoch())), c)
            .time_since_epoch());
  }

  friend bool operator==(const time_zone& left,
                         const time_zone& right) noexcept {
    return left.name() == right.name();
