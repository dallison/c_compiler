constexpr int __days_in_month(int year_value, unsigned month_value) {
  static constexpr unsigned char __days[] = {31, 28, 31, 30, 31, 30,
                                             31, 31, 30, 31, 30, 31};
  return month_value == 2 && year{year_value}.is_leap()
             ? 29
             : __days[month_value - 1];
}

constexpr days __days_from_civil(int year_value, unsigned month_value,
                                 unsigned day_value) {
  const int adjusted_year = year_value - (month_value <= 2);
  const int era = (adjusted_year >= 0 ? adjusted_year : adjusted_year - 399) / 400;
  const unsigned yoe = static_cast<unsigned>(adjusted_year - era * 400);
  const unsigned doy =
      (153 * (month_value + (month_value > 2 ? static_cast<unsigned>(-3)
                                              : static_cast<unsigned>(9))) +
       2) /
          5 +
      day_value - 1;
  // `unsigned` is 16 bits on the 65C02 target, while day-of-era reaches
  // 146096. Widen before the arithmetic instead of truncating through `int`.
  const days::rep doe =
      static_cast<days::rep>(yoe) * 365 + yoe / 4 - yoe / 100 + doy;
  return days(static_cast<days::rep>(era) * 146097 + doe - 719468);
}

constexpr year_month_day __civil_from_days(days day_count) {
  days::rep z = day_count.count() + 719468;
  const days::rep era =
      (z >= 0 ? z : z - 146096) / 146097;
  const days::rep doe = z - era * 146097;
  const days::rep yoe =
      (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
  const days::rep y = static_cast<days::rep>(yoe) + era * 400;
  const days::rep doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
  const days::rep mp = (5 * doy + 2) / 153;
  const unsigned d =
      static_cast<unsigned>(doy - (153 * mp + 2) / 5 + 1);
  const unsigned m = static_cast<unsigned>(mp < 10 ? mp + 3 : mp - 9);
  return year_month_day{chrono::year(static_cast<int>(y + (m <= 2))),
                        chrono::month(m),
                        chrono::day(d)};
}

constexpr weekday __weekday_from_days(days day_count) {
  return weekday{static_cast<unsigned>((day_count.count() + 4) % 7)};
}

constexpr int __months_from_year_month(int year_value, unsigned month_value) {
  return year_value * 12 + static_cast<int>(month_value - 1);
}

constexpr year_month __year_month_from_months(int month_count) {
  const int year_value = month_count / 12;
  const unsigned month_value = static_cast<unsigned>(month_count % 12 + 1);
  return year_month{chrono::year(year_value), chrono::month(month_value)};
}

inline sys_days __sys_days_from_indexed_weekday(int year_value, unsigned month_value,
                                                unsigned wd, unsigned index) {
  const days::rep first_count =
      __days_from_civil(year_value, month_value, 1u).count();
  const unsigned first_wd = static_cast<unsigned>((first_count + 4) % 7);
  int delta = static_cast<int>(wd) - static_cast<int>(first_wd);
  if (delta < 0) {
    delta += 7;
  }
  const days::rep candidate =
      first_count + delta + 7 * (static_cast<int>(index) - 1);
  return sys_days{days(candidate)};
}

inline year_month_day __year_month_day_from_indexed_weekday(int year_value,
                                                            unsigned month_value,
                                                            unsigned wd,
                                                            unsigned index) {
  return __civil_from_days(
      duration_cast<days>(__sys_days_from_indexed_weekday(year_value, month_value, wd, index)
                              .time_since_epoch()));
}

inline year_month_day __year_month_day_from_indexed_weekday(const year_month& ym,
                                                            weekday_indexed wi) {
  return __year_month_day_from_indexed_weekday(
      static_cast<int>(ym.year()), static_cast<unsigned>(ym.month()),
      wi.weekday_encoding(), wi.index());
}

inline sys_days __sys_days_from_last_weekday(int year_value, unsigned month_value,
                                             unsigned wd) {
  static constexpr unsigned char __days[] = {31, 28, 31, 30, 31, 30,
                                             31, 31, 30, 31, 30, 31};
  unsigned last_day = __days[month_value - 1];
  if (month_value == 2u && chrono::year{year_value}.is_leap()) {
    last_day = 29u;
  }
  const days::rep last_count =
      __days_from_civil(year_value, month_value, last_day).count();
  const unsigned last_wd = static_cast<unsigned>((last_count + 4) % 7);
  int delta = static_cast<int>(wd) - static_cast<int>(last_wd);
  if (delta > 0) {
    delta -= 7;
  }
  return sys_days{days(last_count + delta)};
}

inline year_month_day __year_month_day_from_last_weekday(int year_value,
                                                         unsigned month_value,
                                                         unsigned wd) {
  return __civil_from_days(
      duration_cast<days>(__sys_days_from_last_weekday(year_value, month_value, wd)
                              .time_since_epoch()));
}

