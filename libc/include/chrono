template <class DestClock, class SourceClock, class Duration>
constexpr time_point<DestClock,
                     typename common_type<typename DestClock::duration,
                                          Duration>::type>
clock_cast(const time_point<SourceClock, Duration>& source) {
  if constexpr (is_same_v<DestClock, SourceClock>) {
    return time_point<DestClock, Duration>(source.time_since_epoch());
  } else if constexpr (is_same_v<SourceClock, system_clock> &&
                        is_same_v<DestClock, utc_clock>) {
    return utc_clock::from_sys(source);
  } else if constexpr (is_same_v<SourceClock, utc_clock> &&
                        is_same_v<DestClock, system_clock>) {
    return utc_clock::to_sys(source);
  } else if constexpr (is_same_v<SourceClock, utc_clock> &&
                        is_same_v<DestClock, tai_clock>) {
    return tai_clock::from_utc(source);
  } else if constexpr (is_same_v<SourceClock, tai_clock> &&
                        is_same_v<DestClock, utc_clock>) {
    return tai_clock::to_utc(source);
  } else if constexpr (is_same_v<SourceClock, utc_clock> &&
                        is_same_v<DestClock, gps_clock>) {
    return gps_clock::from_utc(source);
  } else if constexpr (is_same_v<SourceClock, gps_clock> &&
                        is_same_v<DestClock, utc_clock>) {
    return gps_clock::to_utc(source);
  } else if constexpr (is_same_v<SourceClock, system_clock> &&
                        is_same_v<DestClock, file_clock>) {
    return file_clock::from_sys(source);
  } else if constexpr (is_same_v<SourceClock, file_clock> &&
                        is_same_v<DestClock, system_clock>) {
    return file_clock::to_sys(source);
  } else if constexpr (is_same_v<SourceClock, system_clock> &&
                        is_same_v<DestClock, tai_clock>) {
    return clock_cast<tai_clock>(clock_cast<utc_clock>(source));
  } else if constexpr (is_same_v<SourceClock, system_clock> &&
                        is_same_v<DestClock, gps_clock>) {
    return clock_cast<gps_clock>(clock_cast<utc_clock>(source));
  } else if constexpr (is_same_v<SourceClock, tai_clock> &&
                        is_same_v<DestClock, system_clock>) {
    return clock_cast<system_clock>(clock_cast<utc_clock>(source));
  } else if constexpr (is_same_v<SourceClock, gps_clock> &&
                        is_same_v<DestClock, system_clock>) {
    return clock_cast<system_clock>(clock_cast<utc_clock>(source));
  } else {
    return time_point<DestClock, typename common_type<typename DestClock::duration,
                                                      Duration>::type>(
        duration_cast<typename common_type<typename DestClock::duration,
                                           Duration>::type>(
            source.time_since_epoch()));
  }
}
