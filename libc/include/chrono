template <class Duration, class TimeZonePtr = const time_zone*>
class zoned_time {
 public:
  using duration = Duration;
  using time_zone_type = remove_pointer_t<TimeZonePtr>;

 private:
  TimeZonePtr __zone_;
  local_seconds __local_;

 public:
  zoned_time() : __zone_(current_zone()), __local_() {}
  zoned_time(const zoned_time&) = default;
  zoned_time(zoned_time&&) = default;
  zoned_time& operator=(const zoned_time&) = default;
  zoned_time& operator=(zoned_time&&) = default;

  zoned_time(TimeZonePtr zone) : __zone_(zone), __local_() {}
  zoned_time(const sys_seconds& tp, TimeZonePtr zone)
      : __zone_(zone), __local_(zone->to_local(tp)) {}
  zoned_time(const local_seconds& tp, TimeZonePtr zone)
      : __zone_(zone), __local_(tp) {}
  template <class Duration2>
  zoned_time(const time_point<system_clock, Duration2>& tp, TimeZonePtr zone)
      : __zone_(zone),
        __local_(zone->to_local(
            sys_seconds(duration_cast<seconds>(tp.time_since_epoch())))) {}
  template <class Duration2>
  zoned_time(const local_time<Duration2>& tp, TimeZonePtr zone)
      : __zone_(zone),
        __local_(local_seconds(duration_cast<seconds>(tp.time_since_epoch()))) {}

  template <class Duration2, class TimeZonePtr2>
  zoned_time(const zoned_time<Duration2, TimeZonePtr2>& other)
      : __zone_(other.get_time_zone()),
        __local_(other.get_local_time()) {}

  TimeZonePtr get_time_zone() const { return __zone_; }
  local_seconds get_local_time() const { return __local_; }
  sys_seconds get_sys_time() const { return __zone_->to_sys(__local_); }

  template <class Duration2>
  zoned_time& operator=(const time_point<system_clock, Duration2>& tp) {
    __local_ = __zone_->to_local(
        sys_seconds(duration_cast<seconds>(tp.time_since_epoch())));
    return *this;
  }

  template <class Duration2>
  zoned_time& operator=(const local_time<Duration2>& tp) {
    __local_ = local_seconds(duration_cast<seconds>(tp.time_since_epoch()));
    return *this;
  }

  explicit operator local_seconds() const { return __local_; }
  explicit operator sys_seconds() const { return get_sys_time(); }
  explicit operator local_time<Duration>() const { return __local_; }
};

