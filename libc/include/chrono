class year_month {
  chrono::year __y_;
  chrono::month __m_;

 public:
  year_month() = default;
  constexpr year_month(const chrono::year& y, const chrono::month& m) noexcept : __y_(y), __m_(m) {}
  constexpr chrono::year year() const noexcept { return __y_; }
  constexpr chrono::month month() const noexcept { return __m_; }
  constexpr year_month& operator+=(const months& value) noexcept {
    const int total = static_cast<int>(__y_) * 12 +
                      static_cast<int>(static_cast<unsigned>(__m_) - 1) +
                      static_cast<int>(value.count());
    int year_value = total / 12;
    int month_index = total % 12;
    if (month_index < 0) {
      month_index += 12;
      --year_value;
    }
    __y_ = chrono::year(year_value);
    __m_ = chrono::month(static_cast<unsigned>(month_index + 1));
    return *this;
  }
  constexpr year_month& operator-=(const months& value) noexcept { return *this += -value; }
  friend constexpr year_month operator+(year_month value, const months& amount) { return value += amount; }
  friend constexpr year_month operator+(const months& amount, year_month value) { return value + amount; }
  friend constexpr year_month operator-(year_month value, const months& amount) { return value -= amount; }
  friend constexpr months operator-(year_month left, year_month right) {
    return months((static_cast<int>(left.year()) * 12 +
                   static_cast<int>(static_cast<unsigned>(left.month()) - 1)) -
                  (static_cast<int>(right.year()) * 12 +
                   static_cast<int>(static_cast<unsigned>(right.month()) - 1)));
  }
  constexpr bool ok() const noexcept { return __m_.ok(); }
  friend constexpr bool operator==(year_month left, year_month right) = default;
  friend constexpr auto operator<=>(year_month left, year_month right) = default;
};

