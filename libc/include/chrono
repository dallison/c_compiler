template <class Duration>
class hh_mm_ss {
  static_assert(is_convertible_v<Duration, chrono::seconds>,
                "hh_mm_ss requires a duration convertible to seconds");

 public:
  using precision = typename common_type<Duration, chrono::seconds>::type;

 private:
  bool __negative_;
  chrono::hours __hours_;
  chrono::minutes __minutes_;
  chrono::seconds __seconds_;
  precision __fraction_;

 public:
  constexpr hh_mm_ss() noexcept
      : __negative_(false),
        __hours_(0),
        __minutes_(0),
        __seconds_(0),
        __fraction_(0) {}

  constexpr explicit hh_mm_ss(Duration value) noexcept
      : __negative_(value < Duration::zero()),
        __hours_(0),
        __minutes_(0),
        __seconds_(0),
        __fraction_(0) {
    if (__negative_) {
      value = -value;
    }
    __hours_ = duration_cast<chrono::hours>(value);
    value -= __hours_;
    __minutes_ = duration_cast<chrono::minutes>(value);
    value -= __minutes_;
    __seconds_ = duration_cast<chrono::seconds>(value);
    value -= __seconds_;
    __fraction_ = duration_cast<precision>(value);
  }

  constexpr bool is_negative() const noexcept { return __negative_; }
  constexpr chrono::hours hours() const noexcept { return __hours_; }
  constexpr chrono::minutes minutes() const noexcept { return __minutes_; }
  constexpr chrono::seconds seconds() const noexcept { return __seconds_; }
  constexpr precision subseconds() const noexcept { return __fraction_; }
  constexpr precision to_duration() const noexcept {
    precision result =
        __hours_ + __minutes_ + __seconds_ + __fraction_;
    return __negative_ ? -result : result;
  }
};

