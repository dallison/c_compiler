class day {
  unsigned char __d_;

 public:
  day() = default;
  constexpr explicit day(unsigned value) noexcept : __d_(static_cast<unsigned char>(value)) {}
  constexpr explicit operator unsigned() const noexcept { return __d_; }
  constexpr bool ok() const noexcept { return __d_ >= 1 && __d_ <= 31; }
  constexpr day operator++() noexcept { return day{static_cast<unsigned>(++__d_)}; }
  constexpr day operator++(int) noexcept {
    day old(*this);
    ++*this;
    return old;
  }
  constexpr day operator--() noexcept { return day{static_cast<unsigned>(--__d_)}; }
  constexpr day operator--(int) noexcept {
    day old(*this);
    --*this;
    return old;
  }
  constexpr day& operator+=(const days& value) noexcept {
    __d_ = static_cast<unsigned char>(static_cast<unsigned>(__d_) + static_cast<unsigned>(value.count()));
    return *this;
  }
  constexpr day& operator-=(const days& value) noexcept { return *this += -value; }
  friend constexpr day operator+(day value, const days& amount) { return value += amount; }
  friend constexpr day operator+(const days& amount, day value) { return value + amount; }
  friend constexpr day operator-(day value, const days& amount) { return value -= amount; }
  friend constexpr days operator-(day left, day right) {
    return days(static_cast<days::rep>(static_cast<int>(left.__d_) -
                                       static_cast<int>(right.__d_)));
  }
  friend constexpr bool operator==(day left, day right) {
    return static_cast<unsigned>(left) == static_cast<unsigned>(right);
  }
  friend constexpr strong_ordering operator<=>(day left, day right) {
    const unsigned left_value = static_cast<unsigned>(left);
    const unsigned right_value = static_cast<unsigned>(right);
    if (left_value < right_value) {
      return strong_ordering::less;
    }
    if (left_value > right_value) {
      return strong_ordering::greater;
    }
    return strong_ordering::equal;
  }
};

class month {
  unsigned char __m_;

 public:
  month() = default;
  constexpr explicit month(unsigned value) noexcept : __m_(static_cast<unsigned char>(value)) {}
  constexpr explicit operator unsigned() const noexcept { return __m_; }
  constexpr bool ok() const noexcept { return __m_ >= 1 && __m_ <= 12; }
  constexpr month& operator+=(const months& value) noexcept {
    const months::rep offset = value.count() % 12;
    int index = (static_cast<int>(__m_) - 1 +
                 static_cast<int>(offset)) %
                12;
    if (index < 0) {
      index += 12;
    }
    __m_ = static_cast<unsigned char>(index + 1);
    return *this;
  }
  constexpr month& operator-=(const months& value) noexcept {
    return *this += -value;
  }
  constexpr month operator++() noexcept { return month{__m_ == 12 ? 1u : static_cast<unsigned>(__m_ + 1)}; }
  constexpr month operator++(int) noexcept {
    month old(*this);
    ++*this;
    return old;
  }
  constexpr month operator--() noexcept { return month{__m_ == 1 ? 12u : static_cast<unsigned>(__m_ - 1)}; }
  constexpr month operator--(int) noexcept {
    month old(*this);
    --*this;
    return old;
  }
  friend constexpr month operator+(month value, const months& amount) {
    value += amount;
    return value;
  }
  friend constexpr month operator+(const months& amount, month value) {
    value += amount;
    return value;
  }
  friend constexpr month operator-(month value, const months& amount) {
    value -= amount;
    return value;
  }
  friend constexpr months operator-(month left, month right) {
    int difference = static_cast<int>(static_cast<unsigned>(left)) -
                     static_cast<int>(static_cast<unsigned>(right));
    if (difference < 0) {
      difference += 12;
    }
    return months(static_cast<months::rep>(difference));
  }
  friend constexpr bool operator==(month left, month right) {
    return static_cast<unsigned>(left) == static_cast<unsigned>(right);
  }
  friend constexpr strong_ordering operator<=>(month left, month right) {
    const unsigned left_value = static_cast<unsigned>(left);
    const unsigned right_value = static_cast<unsigned>(right);
    if (left_value < right_value) {
      return strong_ordering::less;
    }
    if (left_value > right_value) {
      return strong_ordering::greater;
    }
    return strong_ordering::equal;
  }
};

