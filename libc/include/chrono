class weekday {
  unsigned char __wd_;

 public:
  weekday() = default;
  constexpr explicit weekday(unsigned value) noexcept
      : __wd_(static_cast<unsigned char>(value)) {}
  constexpr explicit operator unsigned() const noexcept { return __wd_; }
  constexpr unsigned c_encoding() const noexcept { return __wd_; }
  constexpr unsigned iso_encoding() const noexcept { return __wd_ == 0u ? 7u : __wd_; }
  constexpr bool ok() const noexcept { return __wd_ <= 6; }
  weekday_indexed operator[](unsigned index) const noexcept;
  weekday_last operator[](last_spec) const noexcept;
  constexpr weekday operator++() noexcept {
    __wd_ = static_cast<unsigned char>((__wd_ + 1) % 7);
    return *this;
  }
  constexpr weekday operator++(int) noexcept {
    weekday old(*this);
    ++*this;
    return old;
  }
  constexpr weekday operator--() noexcept {
    return weekday{static_cast<unsigned>(__wd_ + 6)};
  }
  constexpr weekday operator--(int) noexcept {
    weekday old(*this);
    --*this;
    return old;
  }
  constexpr weekday& operator+=(const days& value) noexcept {
    int w = (static_cast<int>(__wd_) + static_cast<int>(value.count())) % 7;
    if (w < 0) {
      w += 7;
    }
    __wd_ = static_cast<unsigned char>(w);
