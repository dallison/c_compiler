template <class Duration>
leap_second_info get_leap_second_info(const utc_time<Duration>& value) {
  const seconds current =
      duration_cast<seconds>(value.time_since_epoch());
  seconds elapsed(0);
  const vector<leap_second>& leap_seconds = get_tzdb().leap_seconds;
  for (const leap_second& leap : leap_seconds) {
    const seconds boundary =
        duration_cast<seconds>(leap.date().time_since_epoch()) + elapsed;
    if (current < boundary) {
      break;
    }
    if (leap.value().count() > 0 &&
        current < boundary + leap.value()) {
      return {true, elapsed + leap.value()};
    }
    elapsed += leap.value();
  }
  return {false, elapsed};
}

