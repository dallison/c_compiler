class tzdb_list {
 public:
  class const_iterator {
    const vector<tzdb>* __entries_;
    size_t __index_;

   public:
    const_iterator() noexcept : __entries_(nullptr), __index_(0) {}
    const_iterator(const vector<tzdb>* entries, size_t index) noexcept
        : __entries_(entries), __index_(index) {}

    const tzdb& operator*() const { return (*__entries_)[__index_]; }
    const_iterator& operator++() noexcept {
      ++__index_;
      return *this;
    }
    const_iterator operator++(int) noexcept {
      const_iterator old(*this);
      ++*this;
      return old;
    }
    friend bool operator==(const const_iterator& left,
                           const const_iterator& right) noexcept {
      return left.__entries_ == right.__entries_ &&
             left.__index_ == right.__index_;
    }
    friend bool operator!=(const const_iterator& left,
                           const const_iterator& right) noexcept {
      return !(left == right);
    }
  };

  tzdb_list() = default;
  tzdb_list(const tzdb_list&) = delete;
  tzdb_list(tzdb_list&&) = default;
  tzdb_list& operator=(const tzdb_list&) = delete;
  tzdb_list& operator=(tzdb_list&&) = default;
  ~tzdb_list() = default;

  const tzdb& front() const { return __entries_.front(); }
  const_iterator begin() const noexcept {
    return const_iterator(&__entries_, 0);
  }
  const_iterator end() const noexcept {
    return const_iterator(&__entries_, __entries_.size());
  }

 private:
  friend const tzdb& get_tzdb();
  friend const tzdb& reload_tzdb();
  friend const tzdb_list& get_tzdb_list();

  vector<tzdb> __entries_;

 public:
  const vector<tzdb>& __entries() const { return __entries_; }
  vector<tzdb>& __entries_mut() { return __entries_; }
};

