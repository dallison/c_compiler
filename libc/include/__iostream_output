#ifndef __davecc_iostream_output_h__
#define __davecc_iostream_output_h__

#include <streambuf>
extern "C" {
#include <unistd.h>
}

namespace std {

class __fd_ostreambuf : public basic_streambuf<char, char_traits<char>> {
 public:
  explicit __fd_ostreambuf(int fd);
  ~__fd_ostreambuf() override;

 protected:
  int_type overflow(int_type c = traits_type::eof()) override;
  int sync() override;

 private:
  static const int __buffer_size_ = 64;
  int __fd_;
  char __buffer_[__buffer_size_];
};

}  // namespace std

#endif
