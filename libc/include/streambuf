class istreambuf_iterator {
 public:
  typedef input_iterator_tag iterator_category;
  typedef char char_type;
  typedef char_traits<char> traits_type;
  typedef ptrdiff_t difference_type;
  typedef const char& reference;
  typedef const char* pointer;

  istreambuf_iterator() noexcept : __streambuf_(nullptr), __cached_(false) {}
  explicit istreambuf_iterator(basic_streambuf<char, char_traits<char>>* s) noexcept
      : __streambuf_(s), __cached_(false) {}
  istreambuf_iterator(basic_streambuf<char, char_traits<char>>* s, int) noexcept
      : __streambuf_(s), __cached_(false) {}

  const char& operator*() const {
    if (!__cached_) {
      __value_ = __read();
      __cached_ = true;
    }
    return __value_;
  }
  istreambuf_iterator& operator++() {
    if (__streambuf_ != nullptr) {
      __streambuf_->sbumpc();
    }
    __cached_ = false;
    return *this;
  }
  istreambuf_iterator operator++(int) {
    istreambuf_iterator tmp = *this;
    ++*this;
    return tmp;
  }
  bool equal(const istreambuf_iterator& other) const {
    if (__streambuf_ == nullptr && other.__streambuf_ == nullptr) {
      return true;
    }
    if (__streambuf_ == nullptr || other.__streambuf_ == nullptr) {
      return false;
    }
    if (__cached_) {
      if (other.__cached_) {
        return traits_type::eq(__value_, other.__value_);
      }
      traits_type::int_type c =
          other.__streambuf_ != nullptr ? other.__streambuf_->sgetc()
                                        : traits_type::eof();
      if (traits_type::eq_int_type(c, traits_type::eof())) {
        return false;
      }
      return traits_type::eq(__value_, traits_type::to_char_type(c));
    }
    if (other.__cached_) {
      traits_type::int_type c =
          __streambuf_ != nullptr ? __streambuf_->sgetc() : traits_type::eof();
      if (traits_type::eq_int_type(c, traits_type::eof())) {
        return false;
      }
      return traits_type::eq(traits_type::to_char_type(c), other.__value_);
    }
    return traits_type::eq_int_type(__streambuf_->sgetc(),
                                    other.__streambuf_->sgetc());
  }

 private:
  mutable basic_streambuf<char, char_traits<char>>* __streambuf_;
  mutable bool __cached_;
  mutable char __value_;

  char __read() const {
    traits_type::int_type c =
        __streambuf_ != nullptr ? __streambuf_->sgetc() : traits_type::eof();
    if (traits_type::eq_int_type(c, traits_type::eof())) {
      __streambuf_ = nullptr;
      return char();
    }
    return traits_type::to_char_type(c);
  }
};

