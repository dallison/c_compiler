inline bool operator==(const istreambuf_iterator& lhs,
                       const istreambuf_iterator& rhs) {
  return lhs.equal(rhs);
}

inline bool operator!=(const istreambuf_iterator& lhs,
                       const istreambuf_iterator& rhs) {
  return !lhs.equal(rhs);
}

inline bool operator==(const wistreambuf_iterator& lhs,
                       const wistreambuf_iterator& rhs) {
  return lhs.equal(rhs);
}

inline bool operator!=(const wistreambuf_iterator& lhs,
                       const wistreambuf_iterator& rhs) {
  return !lhs.equal(rhs);
}

template <class CharT, class Traits>
locale basic_ios<CharT, Traits>::imbue(const locale& loc) {
  locale old = static_cast<const ios_base&>(*this).getloc();
  static_cast<ios_base&>(*this).imbue(loc);
  if (this->rdbuf() != nullptr) {
    this->rdbuf()->pubimbue(loc);
  }
  return old;
}

