#ifndef __davecc_print__
#define __davecc_print__

#include <cstdio>
#include <format>

#define __cpp_lib_print 202207L

extern "C" int write(int fd, const char* buffer, size_t size);

namespace std {

namespace __print_detail {

void __write_stdout(const string& value);
void __write_file(FILE* file, const string& value);

}  // namespace __print_detail

void vprint_nonunicode(string_view text, format_args args);
void vprint_nonunicode(FILE* file, string_view text, format_args args);

void print(
    const typename __format_detail::__non_deduced<format_string<>>::type& text);
void print(
    FILE* file,
    const typename __format_detail::__non_deduced<format_string<>>::type& text);

template <class... Args>
void print(
    const typename __format_detail::__non_deduced<
        format_string<Args...>>::type& text,
    Args&&... args) {
  __print_detail::__write_stdout(
      __format_detail::__format_invoke(
          text.data(), text.size(), static_cast<Args&&>(args)...));
}

template <class... Args>
void print(
    FILE* file,
    const typename __format_detail::__non_deduced<
        format_string<Args...>>::type& text,
    Args&&... args) {
  __print_detail::__write_file(
      file, __format_detail::__format_invoke(
                text.data(), text.size(), static_cast<Args&&>(args)...));
}

void println(
    const typename __format_detail::__non_deduced<format_string<>>::type& text);

template <class... Args>
void println(
    const typename __format_detail::__non_deduced<
        format_string<Args...>>::type& text,
    Args&&... args) {
  string output = __format_detail::__format_invoke(
      text.data(), text.size(), static_cast<Args&&>(args)...);
  output.push_back('\n');
  __print_detail::__write_stdout(output);
}

void println();

void println(
    FILE* file,
    const typename __format_detail::__non_deduced<format_string<>>::type& text);

template <class... Args>
void println(
    FILE* file,
    const typename __format_detail::__non_deduced<
        format_string<Args...>>::type& text,
    Args&&... args) {
  string output = __format_detail::__format_invoke(
      text.data(), text.size(), static_cast<Args&&>(args)...);
  output.push_back('\n');
  __print_detail::__write_file(file, output);
}

void println(FILE* file);

}  // namespace std

#endif
