struct atomic_flag {
  bool __value;

  constexpr atomic_flag() noexcept : __value(false) {}
  atomic_flag(const atomic_flag&) = delete;
  atomic_flag& operator=(const atomic_flag&) = delete;

  bool test_and_set(memory_order order = memory_order_seq_cst) noexcept {
    bool expected = false;
    while (!__atomic_compare_exchange_n(&__value, &expected, true, false,
                                        order, memory_order_relaxed)) {
      if (expected) return true;
      expected = false;
    }
    return false;
  }

  void clear(memory_order order = memory_order_seq_cst) noexcept {
    __atomic_store_n(&__value, false, order);
  }

  bool test_and_set(
      memory_order order = memory_order_seq_cst) volatile noexcept {
    return const_cast<atomic_flag*>(this)->test_and_set(order);
  }

  void clear(memory_order order = memory_order_seq_cst) volatile noexcept {
    __atomic_store_n(&__value, false, order);
  }

#if defined(__DAVECC_HAS_GUEST_THREADS__)
  bool test(memory_order order = memory_order_seq_cst) const noexcept {
    return __atomic_load_n(&__value, order);
  }

  bool test(
      memory_order order = memory_order_seq_cst) const volatile noexcept {
    return __atomic_load_n(&__value, order);
  }

  void wait(bool old,
            memory_order order = memory_order_seq_cst) const noexcept {
    while (test(order) == old) thrd_yield();
  }

  void notify_one() noexcept {}
  void notify_all() noexcept {}
  void notify_one() volatile noexcept {}
  void notify_all() volatile noexcept {}
#endif
};

