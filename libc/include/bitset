#if __cplusplus >= 201402L
#define __DAVECC_BITSET_CONSTEXPR constexpr
#else
#define __DAVECC_BITSET_CONSTEXPR
#endif

namespace std {

template <class T>
struct hash;

template <size_t N>
class bitset {
 private:
  typedef unsigned long long __word_type;
  enum { __word_bits = sizeof(__word_type) * CHAR_BIT };

  __word_type __words[N == 0 ? 1 : (N + __word_bits - 1) / __word_bits];

  static __DAVECC_BITSET_CONSTEXPR size_t __word_index(size_t pos) noexcept {
    return pos / __word_bits;
  }

  static __DAVECC_BITSET_CONSTEXPR __word_type __bit_mask(
      size_t pos) noexcept {
    return __word_type(1) << (pos % __word_bits);
  }

  __DAVECC_BITSET_CONSTEXPR void __trim() noexcept {
    if (N != 0 && N % __word_bits != 0) {
      __words[sizeof(__words) / sizeof(__words[0]) - 1] &=
          (__word_type(1) << (N % __word_bits)) - 1;
    }
  }

  __DAVECC_BITSET_CONSTEXPR bool __get(size_t pos) const noexcept {
    return (__words[__word_index(pos)] & __bit_mask(pos)) != 0;
  }

  __DAVECC_BITSET_CONSTEXPR void __put(size_t pos, bool value) noexcept {
    if (value) {
      __words[__word_index(pos)] |= __bit_mask(pos);
    } else {
      __words[__word_index(pos)] &= ~__bit_mask(pos);
    }
  }

  static __DAVECC_BITSET_CONSTEXPR size_t __popcount(
      __word_type value) noexcept {
    size_t count = 0;
    while (value != 0) {
      value &= value - 1;
      ++count;
    }
    return count;
  }

 public:
  class reference {
    friend class bitset;

   private:
    bitset* __owner;
    size_t __position;

    __DAVECC_BITSET_CONSTEXPR reference(bitset& owner,
                                        size_t position) noexcept
        : __owner(&owner), __position(position) {}

   public:
    __DAVECC_BITSET_CONSTEXPR reference(const reference&) noexcept = default;

    __DAVECC_BITSET_CONSTEXPR reference& operator=(bool value) noexcept {
      __owner->__put(__position, value);
      return *this;
    }

    __DAVECC_BITSET_CONSTEXPR reference& operator=(
        const reference& other) noexcept {
      return *this = static_cast<bool>(other);
    }

#if __cplusplus >= 202302L
    constexpr const reference& operator=(bool value) const noexcept {
      __owner->__put(__position, value);
      return *this;
    }
#endif

    __DAVECC_BITSET_CONSTEXPR operator bool() const noexcept {
      return __owner->__get(__position);
    }

    __DAVECC_BITSET_CONSTEXPR bool operator~() const noexcept {
      return !static_cast<bool>(*this);
    }

    __DAVECC_BITSET_CONSTEXPR reference& flip() noexcept {
      __owner->__put(__position, !__owner->__get(__position));
      return *this;
    }
  };

#if __cplusplus >= 201103L
  constexpr bitset() noexcept : __words{} {}

  constexpr bitset(unsigned long long value) noexcept : __words{value} {
    __trim();
  }
#else
  bitset() { reset(); }

  bitset(unsigned long long value) {
    reset();
    __words[0] = value;
    __trim();
  }
#endif

  template <class CharT, class Traits, class Allocator>
  explicit bitset(
      const basic_string<CharT, Traits, Allocator>& str,
      typename basic_string<CharT, Traits, Allocator>::size_type pos = 0,
      typename basic_string<CharT, Traits, Allocator>::size_type n =
          basic_string<CharT, Traits, Allocator>::npos,
      CharT zero = CharT('0'), CharT one = CharT('1')) {
    reset();
    typedef basic_string<CharT, Traits, Allocator> __string_type;
    if (pos > str.size()) {
      __DAVECC_THROW(out_of_range("bitset::bitset"));
    }
    typename __string_type::size_type available = str.size() - pos;
    typename __string_type::size_type length = n < available ? n : available;
    size_t used = length < N ? static_cast<size_t>(length) : N;
    for (size_t i = 0; i < used; ++i) {
      CharT ch = str[pos + used - 1 - i];
      if (Traits::eq(ch, one)) {
        __put(i, true);
      } else if (!Traits::eq(ch, zero)) {
        __DAVECC_THROW(invalid_argument("bitset::bitset"));
      }
    }
  }

  __DAVECC_BITSET_CONSTEXPR bitset& operator&=(const bitset& other) noexcept {
    for (size_t i = 0; i < sizeof(__words) / sizeof(__words[0]); ++i) {
      __words[i] &= other.__words[i];
    }
    return *this;
  }

  __DAVECC_BITSET_CONSTEXPR bitset& operator|=(const bitset& other) noexcept {
    for (size_t i = 0; i < sizeof(__words) / sizeof(__words[0]); ++i) {
      __words[i] |= other.__words[i];
    }
    return *this;
  }

  __DAVECC_BITSET_CONSTEXPR bitset& operator^=(const bitset& other) noexcept {
    for (size_t i = 0; i < sizeof(__words) / sizeof(__words[0]); ++i) {
      __words[i] ^= other.__words[i];
    }
    return *this;
  }

  __DAVECC_BITSET_CONSTEXPR bitset& operator<<=(size_t shift) noexcept {
    if (shift >= N) {
      return reset();
    }
    for (size_t i = N; i > shift; --i) {
      __put(i - 1, __get(i - 1 - shift));
    }
    for (size_t i = 0; i < shift; ++i) {
      __put(i, false);
    }
    return *this;
  }

  __DAVECC_BITSET_CONSTEXPR bitset& operator>>=(size_t shift) noexcept {
    if (shift >= N) {
      return reset();
    }
    for (size_t i = 0; i + shift < N; ++i) {
      __put(i, __get(i + shift));
    }
    for (size_t i = N - shift; i < N; ++i) {
      __put(i, false);
    }
    return *this;
  }

  __DAVECC_BITSET_CONSTEXPR bitset operator~() const noexcept {
    bitset result(*this);
    result.flip();
    return result;
  }

  __DAVECC_BITSET_CONSTEXPR bitset operator<<(size_t shift) const noexcept {
    bitset result(*this);
    result <<= shift;
    return result;
  }

  __DAVECC_BITSET_CONSTEXPR bitset operator>>(size_t shift) const noexcept {
    bitset result(*this);
    result >>= shift;
    return result;
  }

  __DAVECC_BITSET_CONSTEXPR bitset& set() noexcept {
    for (size_t i = 0; i < sizeof(__words) / sizeof(__words[0]); ++i) {
      __words[i] = ~__word_type(0);
    }
    __trim();
    return *this;
  }

  __DAVECC_BITSET_CONSTEXPR bitset& set(size_t pos, bool value = true) {
    if (pos >= N) {
      __DAVECC_THROW(out_of_range("bitset::set"));
    }
    __put(pos, value);
    return *this;
  }

  __DAVECC_BITSET_CONSTEXPR bitset& reset() noexcept {
    for (size_t i = 0; i < sizeof(__words) / sizeof(__words[0]); ++i) {
      __words[i] = 0;
    }
    return *this;
  }

  __DAVECC_BITSET_CONSTEXPR bitset& reset(size_t pos) {
    if (pos >= N) {
      __DAVECC_THROW(out_of_range("bitset::reset"));
    }
    __put(pos, false);
    return *this;
  }

  __DAVECC_BITSET_CONSTEXPR bitset& flip() noexcept {
    for (size_t i = 0; i < sizeof(__words) / sizeof(__words[0]); ++i) {
      __words[i] = ~__words[i];
    }
    __trim();
    return *this;
  }

  __DAVECC_BITSET_CONSTEXPR bitset& flip(size_t pos) {
    if (pos >= N) {
      __DAVECC_THROW(out_of_range("bitset::flip"));
    }
    __words[__word_index(pos)] ^= __bit_mask(pos);
    return *this;
  }

  __DAVECC_BITSET_CONSTEXPR bool operator[](size_t pos) const noexcept {
    return __get(pos);
  }

  __DAVECC_BITSET_CONSTEXPR reference operator[](size_t pos) noexcept {
    return reference(*this, pos);
  }

  __DAVECC_BITSET_CONSTEXPR unsigned long to_ulong() const {
    const size_t width = sizeof(unsigned long) * CHAR_BIT;
    for (size_t i = width; i < N; ++i) {
      if (__get(i)) {
        __DAVECC_THROW(overflow_error("bitset::to_ulong"));
      }
    }
    return static_cast<unsigned long>(__words[0]);
  }

  __DAVECC_BITSET_CONSTEXPR unsigned long long to_ullong() const {
    for (size_t i = __word_bits; i < N; ++i) {
      if (__get(i)) {
        __DAVECC_THROW(overflow_error("bitset::to_ullong"));
      }
    }
    return __words[0];
  }

  template <class CharT = char, class Traits = char_traits<CharT>,
            class Allocator = allocator<CharT>>
  basic_string<CharT, Traits, Allocator> to_string(
      CharT zero = CharT('0'), CharT one = CharT('1')) const {
    basic_string<CharT, Traits, Allocator> result(N, zero);
    for (size_t i = 0; i < N; ++i) {
      if (__get(i)) {
        result[N - 1 - i] = one;
      }
    }
    return result;
  }

  __DAVECC_BITSET_CONSTEXPR size_t count() const noexcept {
    size_t result = 0;
    for (size_t i = 0; i < sizeof(__words) / sizeof(__words[0]); ++i) {
      result += __popcount(__words[i]);
    }
    return result;
  }

  constexpr size_t size() const noexcept {
    return N;
  }

  __DAVECC_BITSET_CONSTEXPR bool operator==(const bitset& other) const
      noexcept {
    for (size_t i = 0; i < sizeof(__words) / sizeof(__words[0]); ++i) {
      if (__words[i] != other.__words[i]) {
        return false;
      }
    }
    return true;
  }

  __DAVECC_BITSET_CONSTEXPR bool operator!=(const bitset& other) const
      noexcept {
    return !(*this == other);
  }

  __DAVECC_BITSET_CONSTEXPR bool test(size_t pos) const {
    if (pos >= N) {
      __DAVECC_THROW(out_of_range("bitset::test"));
    }
    return __get(pos);
  }

  __DAVECC_BITSET_CONSTEXPR bool all() const noexcept {
    return count() == N;
  }

  __DAVECC_BITSET_CONSTEXPR bool any() const noexcept {
    for (size_t i = 0; i < sizeof(__words) / sizeof(__words[0]); ++i) {
      if (__words[i] != 0) {
        return true;
      }
    }
    return false;
  }

  __DAVECC_BITSET_CONSTEXPR bool none() const noexcept {
    return !any();
  }

  template <class CharT, class Traits>
  friend basic_ostream<CharT, Traits>& operator<<(
      basic_ostream<CharT, Traits>& os, const bitset& value) {
    return os << value.template to_string<CharT, Traits>();
  }

  template <class CharT, class Traits>
  friend basic_istream<CharT, Traits>& operator>>(
      basic_istream<CharT, Traits>& is, bitset& value) {
    bitset result;
    if (is.__sentry_ok()) {
      basic_streambuf<CharT, Traits>* buffer = is.rdbuf();
      streamsize width = is.width();
      size_t limit =
          width > 0 && static_cast<size_t>(width) < N
              ? static_cast<size_t>(width)
              : N;
      typename Traits::int_type current = buffer->sgetc();
      size_t count = 0;
      while (count < limit && !Traits::eq_int_type(current, Traits::eof())) {
        CharT ch = Traits::to_char_type(current);
        if (!Traits::eq(ch, CharT('0')) && !Traits::eq(ch, CharT('1'))) {
          break;
        }
        result <<= 1;
        if (Traits::eq(ch, CharT('1'))) {
          result.set(0);
        }
        ++count;
        current = buffer->snextc();
      }
      if (Traits::eq_int_type(current, Traits::eof())) {
        is.setstate(ios_base::eofbit);
      }
      if (count == 0) {
        is.setstate(ios_base::failbit);
      } else {
        value = result;
      }
      is.width(0);
    }
    return is;
  }
};

template <size_t N>
__DAVECC_BITSET_CONSTEXPR bitset<N> operator&(
    const bitset<N>& left, const bitset<N>& right) noexcept {
  bitset<N> result(left);
  result &= right;
  return result;
}

template <size_t N>
__DAVECC_BITSET_CONSTEXPR bitset<N> operator|(
    const bitset<N>& left, const bitset<N>& right) noexcept {
  bitset<N> result(left);
  result |= right;
  return result;
}

template <size_t N>
__DAVECC_BITSET_CONSTEXPR bitset<N> operator^(
    const bitset<N>& left, const bitset<N>& right) noexcept {
  bitset<N> result(left);
  result ^= right;
  return result;
}

template <size_t N>
struct hash<bitset<N>> {
  size_t operator()(const bitset<N>& value) const noexcept {
    size_t result = static_cast<size_t>(1469598103934665603ULL);
    for (size_t i = 0; i < N; ++i) {
      result ^= static_cast<size_t>(value[i]);
      result *= static_cast<size_t>(1099511628211ULL);
    }
    return result;
  }
};

