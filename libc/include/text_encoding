      using reference = const char*;

      constexpr iterator() noexcept : __current(nullptr) {}
      constexpr explicit iterator(const char* const* current) noexcept
          : __current(current) {}
      constexpr const char* operator*() const noexcept { return *__current; }
      constexpr const char* operator[](difference_type n) const noexcept {
        return __current[n];
      }
      constexpr iterator& operator++() noexcept { ++__current; return *this; }
      constexpr iterator operator++(int) noexcept {
        iterator old = *this; ++*this; return old;
      }
      constexpr iterator& operator--() noexcept { --__current; return *this; }
      constexpr iterator operator--(int) noexcept {
        iterator old = *this; --*this; return old;
      }
      constexpr iterator& operator+=(difference_type n) noexcept {
        __current += n; return *this;
      }
      constexpr iterator& operator-=(difference_type n) noexcept {
        __current -= n; return *this;
      }
      friend constexpr iterator operator+(iterator i, difference_type n) noexcept {
        i += n; return i;
      }
      friend constexpr iterator operator+(difference_type n, iterator i) noexcept {
        i += n; return i;
      }
      friend constexpr iterator operator-(iterator i, difference_type n) noexcept {
        i -= n; return i;
      }
      friend constexpr difference_type operator-(iterator a, iterator b) noexcept {
        return a.__current - b.__current;
      }
      friend constexpr bool operator==(iterator a, iterator b) noexcept {
        return a.__current == b.__current;
      }
      friend constexpr bool operator!=(iterator a, iterator b) noexcept {
        return !(a == b);
      }
      friend constexpr bool operator<(iterator a, iterator b) noexcept {
        return a.__current < b.__current;
      }
      friend constexpr bool operator>(iterator a, iterator b) noexcept {
        return b < a;
      }
      friend constexpr bool operator<=(iterator a, iterator b) noexcept {
        return !(b < a);
      }
      friend constexpr bool operator>=(iterator a, iterator b) noexcept {
        return !(a < b);
      }

     private:
      const char* const* __current;
    };

    constexpr aliases_view() noexcept
        : __first(__text_encoding_detail::__aliases), __size(0) {}
    constexpr iterator begin() const noexcept { return iterator(__first); }
    constexpr iterator end() const noexcept { return iterator(__first + __size); }
    constexpr size_t size() const noexcept { return __size; }

   private:
    constexpr aliases_view(const char* const* first, size_t size) noexcept
        : __first(first), __size(size) {}
    const char* const* __first;
    size_t __size;
    friend struct text_encoding;
  };

  constexpr text_encoding() noexcept : __mib(id::unknown), __name{} {}

  constexpr explicit text_encoding(string_view encoding) noexcept
      : __mib(id::other), __name{} {
    for (size_t i = 0; i < encoding.size() && i < max_name_length; ++i)
      __name[i] = encoding[i];
    const auto* entry = __find_name(encoding);
    if (entry != nullptr) __mib = static_cast<id>(entry->mib);
  }

  constexpr text_encoding(id value) noexcept : __mib(value), __name{} {
    const auto* entry = __find_id(value);
    if (entry != nullptr) __copy_name(entry->primary);
  }

  constexpr id mib() const noexcept { return __mib; }
  constexpr const char* name() const noexcept {
    if (__name[0] == '\0') return nullptr;
    return __name;
  }

  constexpr aliases_view aliases() const noexcept {
    const auto* entry = __find_id(__mib);
    if (entry == nullptr) return aliases_view();
    return aliases_view(__text_encoding_detail::__aliases + entry->alias_offset,
                        entry->alias_count);
  }

  friend constexpr bool operator==(const text_encoding& left,
                                   const text_encoding& right) noexcept {
    if (left.__mib == id::other && right.__mib == id::other)
      return text_encoding::__comp_name(string_view(left.__name),
                                        string_view(right.__name));
    return left.__mib == right.__mib;
  }
  friend constexpr bool operator!=(const text_encoding& left,
                                   const text_encoding& right) noexcept {
    return !(left == right);
  }
  friend constexpr bool operator==(const text_encoding& encoding, id value) noexcept {
    return encoding.__mib == value;
  }
  friend constexpr bool operator==(id value, const text_encoding& encoding) noexcept {
    return encoding == value;
  }
  friend constexpr bool operator!=(const text_encoding& encoding, id value) noexcept {
    return !(encoding == value);
  }
  friend constexpr bool operator!=(id value, const text_encoding& encoding) noexcept {
    return !(encoding == value);
  }

  static consteval text_encoding literal() noexcept {
    return text_encoding(id::UTF8);
  }
  static text_encoding environment() { return text_encoding(id::UTF8); }
  template <id value>
  static bool environment_is() { return environment() == value; }

 private:
  id __mib;
  char __name[max_name_length + 1];

  static constexpr bool __is_alpha(char c) noexcept {
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z');
  }
  static constexpr bool __is_digit(char c) noexcept {
    return c >= '0' && c <= '9';
  }
  static constexpr char __lower(char c) noexcept {
    return c >= 'A' && c <= 'Z' ? static_cast<char>(c - 'A' + 'a') : c;
  }
  static constexpr size_t __normalized(string_view input,
                                       char* output) noexcept {
    size_t count = 0;
    bool in_digit_sequence = false;
    for (char c : input) {
      if (!__is_alpha(c) && !__is_digit(c)) continue;
      if (c == '0' && !in_digit_sequence) continue;
      output[count++] = __lower(c);
      if (__is_digit(c)) in_digit_sequence = true;
      else in_digit_sequence = false;
    }
    return count;
  }
  static constexpr const __text_encoding_detail::__entry* __find_name(
      string_view encoding) noexcept {
    for (size_t i = 0; i < __text_encoding_detail::__entry_count; ++i) {
      const auto& entry = __text_encoding_detail::__entries[i];
      for (size_t j = 0; j < entry.alias_count; ++j) {
        if (__comp_name(
                encoding,
                string_view(__text_encoding_detail::__aliases[
                    entry.alias_offset + j]))) {
          return &entry;
        }
      }
    }
    return nullptr;
  }

  static constexpr const __text_encoding_detail::__entry* __find_id(
      id value) noexcept {
    const int_least32_t number = static_cast<int_least32_t>(value);
    for (size_t i = 0; i < __text_encoding_detail::__entry_count; ++i) {
      if (__text_encoding_detail::__entries[i].mib == number)
        return &__text_encoding_detail::__entries[i];
    }
    return nullptr;
  }

  constexpr void __copy_name(const char* source) noexcept {
    size_t i = 0;
    for (; source[i] != '\0'; ++i) __name[i] = source[i];
    __name[i] = '\0';
  }
};

constexpr bool text_encoding::__comp_name(string_view left,
                                          string_view right) noexcept {
  char a[max_name_length + 1] = {0};
  char b[max_name_length + 1] = {0};
  size_t an = __normalized(left, a);
  size_t bn = __normalized(right, b);
  if (an != bn) return false;
  for (size_t i = 0; i < an; ++i) {
    if (a[i] != b[i]) return false;
  }
  return true;
}

template <>
struct hash<text_encoding> {
  size_t operator()(const text_encoding& encoding) const noexcept {
    return static_cast<size_t>(encoding.mib());
  }
};

#ifdef __davecc_locale__
inline text_encoding locale::encoding() const {
  return text_encoding::environment();
}
#endif

