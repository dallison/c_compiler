// The __davecc_common_type_t builtin is only recognized as a type-specifier at
// the top level of a declaration, not nested directly inside another
// template-argument list, so name it through a helper alias before applying
// decay_t.
template <class T, class U>
using __davecc_common_type = __davecc_common_type_t(T, U);

template <class T, class U>
struct common_type<T, U> {
  using type = decay_t<__davecc_common_type<T, U> >;
};

template <class T, class U, class... V>
struct common_type<T, U, V...> {
  using type = typename common_type<typename common_type<T, U>::type,
                                    V...>::type;
};

template <class... T>
using common_type_t = typename common_type<T...>::type;

template <class T, class U>
struct copy_cv {
 private:
  using __base = remove_cv_t<T>;
 public:
  using type = typename conditional<
      is_const<T>::value || is_const<U>::value,
      typename conditional<is_volatile<T>::value || is_volatile<U>::value,
                           const volatile __base,
                           const __base>::type,
      typename conditional<is_volatile<T>::value || is_volatile<U>::value,
                           volatile __base, __base>::type>::type;
};

template <class T>
struct copy_cv<T, const T> {
  using type = const T;
};

template <class T>
struct copy_cv<T, volatile T> {
  using type = volatile T;
};

template <class T>
struct copy_cv<T, const volatile T> {
  using type = const volatile T;
};

template <class T, class U>
using copy_cv_t = typename copy_cv<T, U>::type;

template <class T, class U>
struct __cond_res {
  using type = typename conditional<is_convertible<T, U>::value, U,
                                  typename conditional<is_convertible<U, T>::value,
                                                       T, void>::type>::type;
};

