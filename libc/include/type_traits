#ifndef type_traits_h
#define type_traits_h

#include <stddef.h>

namespace std {

template <class T, T v>
struct integral_constant {
  enum {
    value = v
  };
  using value_type = T;
  using type = integral_constant<T, v>;
};

template <bool B>
using bool_constant = integral_constant<bool, B>;

using true_type = bool_constant<true>;
using false_type = bool_constant<false>;

template <class T, class U>
struct is_same : false_type {
};

template <class T>
struct is_same<T, T> : true_type {
};

template <class T>
struct remove_reference {
  using type = T;
};

template <class T>
struct remove_reference<T&> {
  using type = T;
};

template <class T>
struct remove_reference<T&&> {
  using type = T;
};

template <class T>
using remove_reference_t = typename remove_reference<T>::type;

template <class T>
struct add_lvalue_reference {
  using type = T&;
};

template <class T>
using add_lvalue_reference_t = typename add_lvalue_reference<T>::type;

template <class T>
struct add_rvalue_reference {
  using type = T&&;
};

template <class T>
using add_rvalue_reference_t = typename add_rvalue_reference<T>::type;

template <class T>
struct is_lvalue_reference : false_type {
};

template <class T>
struct is_lvalue_reference<T&> : true_type {
};

template <class T>
struct is_rvalue_reference : false_type {
};

template <class T>
struct is_rvalue_reference<T&&> : true_type {
};

template <bool B, class T = void>
struct enable_if {
};

template <class T>
struct enable_if<true, T> {
  using type = T;
};

template <bool B, class T, class F>
struct conditional {
  using type = T;
};

template <class T, class F>
struct conditional<false, T, F> {
  using type = F;
};

template <bool B, class T, class F>
using conditional_t = typename conditional<B, T, F>::type;

template <bool B, class T = void>
using enable_if_t = typename enable_if<B, T>::type;

template <class T>
struct remove_const {
  using type = T;
};

template <class T>
struct remove_const<const T> {
  using type = T;
};

template <class T>
using remove_const_t = typename remove_const<T>::type;

template <class T>
struct remove_volatile {
  using type = T;
};

template <class T>
struct remove_volatile<volatile T> {
  using type = T;
};

template <class T>
using remove_volatile_t = typename remove_volatile<T>::type;

template <class T>
struct remove_cv {
  using type = remove_const_t<remove_volatile_t<T> >;
};

template <class T>
using remove_cv_t = typename remove_cv<T>::type;

template <class T>
struct remove_cvref {
  using type = remove_cv_t<remove_reference_t<T> >;
};

template <class T>
using remove_cvref_t = typename remove_cvref<T>::type;

// is_array / remove_extent
template <class T>
struct is_array : false_type {
};

template <class T, size_t N>
struct is_array<T[N]> : true_type {
};

template <class T>
struct remove_extent {
  using type = T;
};

template <class T, size_t N>
struct remove_extent<T[N]> {
  using type = T;
};

template <class T>
using remove_extent_t = typename remove_extent<T>::type;

// is_function: a type is a function type unless it is produced with a cv- or
// ref-qualifier that only object/reference types accept.  The primary template
// handles the non-function case; the specializations enumerate the plain
// (and C-varargs) function types that arise after reference removal, which is
// all `decay` needs.
template <class T>
struct is_function : false_type {
};

template <class Ret, class... Args>
struct is_function<Ret(Args...)> : true_type {
};

// add_pointer: pointer to the referred-to type (references decay first).
template <class T>
struct add_pointer {
  using type = remove_reference_t<T>*;
};

template <class T>
using add_pointer_t = typename add_pointer<T>::type;

// decay: models the type conversions applied when passing an argument by
// value (array-to-pointer, function-to-pointer, and cv/ref removal).
template <class T>
struct decay {
 private:
  using U = remove_reference_t<T>;

 public:
  using type = conditional_t<
      is_array<U>::value, remove_extent_t<U>*,
      conditional_t<is_function<U>::value, add_pointer_t<U>, remove_cv_t<U> > >;
};

// Array (and array-reference) decay is handled by dedicated specializations:
// deducing the element type through `remove_reference` is unreliable for
// reference-to-array types, so match the array shape directly here.
template <class T, size_t N>
struct decay<T[N]> {
  using type = T*;
};

template <class T, size_t N>
struct decay<T (&)[N]> {
  using type = T*;
};

template <class T>
using decay_t = typename decay<T>::type;

template <class T>
struct is_void : false_type {
};

template <>
struct is_void<void> : true_type {
};

template <>
struct is_void<const void> : true_type {
};

template <>
struct is_void<volatile void> : true_type {
};

template <>
struct is_void<const volatile void> : true_type {
};

template <class T>
struct is_reference : false_type {
};

template <class T>
struct is_reference<T&> : true_type {
};

template <class T>
struct is_reference<T&&> : true_type {
};

template <class T>
struct is_object : true_type {
};

template <class T>
struct is_object<T&> : false_type {
};

template <class T>
struct is_object<T&&> : false_type {
};

template <>
struct is_object<void> : false_type {
};

template <>
struct is_object<const void> : false_type {
};

template <>
struct is_object<volatile void> : false_type {
};

template <>
struct is_object<const volatile void> : false_type {
};

template <class T>
struct is_destructible : true_type {
};

template <>
struct is_destructible<void> : false_type {
};

template <>
struct is_destructible<const void> : false_type {
};

template <>
struct is_destructible<volatile void> : false_type {
};

template <>
struct is_destructible<const volatile void> : false_type {
};

template <class T, class... Args>
struct is_constructible : true_type {
};

template <class From, class To>
struct is_convertible : true_type {
};

template <class T, class U>
struct is_assignable : true_type {
};

template <class T>
struct is_swappable : true_type {
};

// is_integral: true for the standard integer types (and bool / character
// types).  Each recognized type is given an explicit full specialization that
// derives directly from true_type; cv-qualified variants are enumerated too so
// `const int` etc. are recognized without relying on a dependent base class.
template <class T>
struct is_integral : false_type {
};

#define __DAVECC_INTEGRAL(T)                          \
  template <>                                         \
  struct is_integral<T> : true_type {};              \
  template <>                                         \
  struct is_integral<const T> : true_type {};        \
  template <>                                         \
  struct is_integral<volatile T> : true_type {};     \
  template <>                                         \
  struct is_integral<const volatile T> : true_type {}

__DAVECC_INTEGRAL(bool);
__DAVECC_INTEGRAL(char);
__DAVECC_INTEGRAL(signed char);
__DAVECC_INTEGRAL(unsigned char);
__DAVECC_INTEGRAL(short);
__DAVECC_INTEGRAL(unsigned short);
__DAVECC_INTEGRAL(int);
__DAVECC_INTEGRAL(unsigned int);
__DAVECC_INTEGRAL(long);
__DAVECC_INTEGRAL(unsigned long);
__DAVECC_INTEGRAL(long long);
__DAVECC_INTEGRAL(unsigned long long);

#undef __DAVECC_INTEGRAL

template <class T>
struct is_nothrow_move_constructible : true_type {
};

template <class T>
struct is_copy_constructible : true_type {
};

template <class T>
struct is_trivially_destructible : false_type {
};

#define __DAVECC_TRIVIALLY_DESTRUCTIBLE(T)                  \
  template <>                                               \
  struct is_trivially_destructible<T> : true_type {};       \
  template <>                                               \
  struct is_trivially_destructible<const T> : true_type {}; \
  template <>                                               \
  struct is_trivially_destructible<volatile T> : true_type {}; \
  template <>                                               \
  struct is_trivially_destructible<const volatile T> : true_type {}

__DAVECC_TRIVIALLY_DESTRUCTIBLE(bool);
__DAVECC_TRIVIALLY_DESTRUCTIBLE(char);
__DAVECC_TRIVIALLY_DESTRUCTIBLE(signed char);
__DAVECC_TRIVIALLY_DESTRUCTIBLE(unsigned char);
__DAVECC_TRIVIALLY_DESTRUCTIBLE(short);
__DAVECC_TRIVIALLY_DESTRUCTIBLE(unsigned short);
__DAVECC_TRIVIALLY_DESTRUCTIBLE(int);
__DAVECC_TRIVIALLY_DESTRUCTIBLE(unsigned int);
__DAVECC_TRIVIALLY_DESTRUCTIBLE(long);
__DAVECC_TRIVIALLY_DESTRUCTIBLE(unsigned long);
__DAVECC_TRIVIALLY_DESTRUCTIBLE(long long);
__DAVECC_TRIVIALLY_DESTRUCTIBLE(unsigned long long);

#undef __DAVECC_TRIVIALLY_DESTRUCTIBLE

template <class T>
struct is_trivially_destructible<T*> : true_type {
};

}  // namespace std

#endif /* type_traits_h */
