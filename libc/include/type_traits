};

template <class T, class U>
struct basic_common_reference {
  using type = typename common_reference<T, U>::type;
};

// COMMON-REF for two reference types: the standard defines this via the
// conditional (ternary) expression COND-RES(COPY-CV(X,Y)&, COPY-CV(Y,X)&),
// which is symmetric. A plain cv-merge is *not* symmetric when the referenced
// types differ (e.g. const int& vs const long&), so we must use the ternary so
// that arithmetic operands collapse to their common type (long) both ways.
template <class T, class U>
struct __common_ref_refs {
  using __rt = remove_reference_t<T>;
  using __ru = remove_reference_t<U>;
  using type = decltype(false ? declval<copy_cv_t<__rt, __ru>&>()
                              : declval<copy_cv_t<__ru, __rt>&>());
};

template <class T, class U>
struct common_reference<T, U> {
 private:
  using __t = remove_reference_t<T>;
  using __u = remove_reference_t<U>;

 public:
  using type = typename conditional<
      is_reference<T>::value && is_reference<U>::value,
      typename __common_ref_refs<T, U>::type,
      typename conditional<
          is_reference<T>::value,
          copy_cv_t<__t, remove_cv_t<__u> >&,
          typename conditional<
              is_reference<U>::value,
              copy_cv_t<__u, remove_cv_t<__t> >&,
              typename common_type<T, U>::type>::type>::type>::type;
};

template <class T, class U, class... Rest>
struct common_reference<T, U, Rest...> {
  using type =
      typename common_reference<typename common_reference<T, U>::type,
                                  Rest...>::type;
};

template <class... T>
using common_reference_t = typename common_reference<T...>::type;

