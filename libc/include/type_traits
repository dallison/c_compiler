template <class T>
struct decay {
 private:
  using U = remove_reference_t<T>;

 public:
  using type = conditional_t<
      is_array<U>::value, remove_extent_t<U>*,
      conditional_t<is_function<U>::value, add_pointer_t<U>, remove_cv_t<U> > >;
};

template <class T, size_t N>
struct decay<T[N]> {
  using type = T*;
};

template <class T, size_t N>
struct decay<T (&)[N]> {
  using type = T*;
};

