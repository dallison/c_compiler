  }

  template <class G>
  constexpr E error_or(G&& default_error) && {
    return __has_value_ ? static_cast<E>(static_cast<G&&>(default_error))
                        : static_cast<E&&>(error());
  }

  constexpr void emplace() noexcept {
    if (!__has_value_) {
      __error_ptr()->~E();
      __has_value_ = true;
    }
  }

  constexpr void swap(expected& other)
    requires (is_swappable<E>::value && is_move_constructible<E>::value) {
    if (__has_value_ && other.__has_value_) {
      return;
    }
    if (!__has_value_ && !other.__has_value_) {
      std::swap(error(), other.error());
      return;
    }
    if (__has_value_) {
      __construct_error(static_cast<E&&>(other.error()));
      other.__error_ptr()->~E();
      other.__has_value_ = true;
    } else {
      other.swap(*this);
    }
