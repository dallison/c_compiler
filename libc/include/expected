template <class E>
class expected<void, E> {
  static_assert(is_object<E>::value,
                "expected<void, E> requires an object error type");
  static_assert(!is_array<E>::value,
                "expected<void, E> cannot contain an array error");
  static_assert(!is_const<E>::value && !is_volatile<E>::value,
                "expected<void, E> requires an unqualified error type");

  __expected_detail::__void_storage<E> __storage_;
  bool __has_value_;

  constexpr E* __error_ptr() noexcept { return &__storage_.__error_; }
  constexpr const E* __error_ptr() const noexcept {
    return &__storage_.__error_;
  }

  template <class... Args>
  constexpr void __construct_error(Args&&... args) {
    new (__error_ptr()) E(static_cast<Args&&>(args)...);
    __has_value_ = false;
  }

  template <class U, class... Args>
  constexpr void __construct_error_list(initializer_list<U> init,
                                        Args&&... args) {
    new (__error_ptr()) E(init, static_cast<Args&&>(args)...);
    __has_value_ = false;
  }

 public:
  using value_type = void;
  using error_type = E;
  using unexpected_type = unexpected<E>;

  template <class U>
  using rebind = expected<U, error_type>;

  constexpr expected() noexcept : __storage_(), __has_value_(true) {}

  constexpr expected(const expected& other)
    requires is_copy_constructible<E>::value
      : __storage_(), __has_value_(true) {
    if (!other.__has_value_) {
      __construct_error(other.error());
    }
  }

  constexpr expected(expected&& other)
    requires is_move_constructible<E>::value
      : __storage_(), __has_value_(true) {
    if (!other.__has_value_) {
      __construct_error(static_cast<E&&>(other.error()));
    }
  }

  template <class G>
    requires is_constructible<E, const G&>::value
  constexpr explicit expected(const expected<void, G>& other)
      : __storage_(), __has_value_(true) {
    if (!other.has_value()) {
      __construct_error(other.error());
    }
  }

  template <class G>
    requires is_constructible<E, G>::value
  constexpr explicit expected(expected<void, G>&& other)
      : __storage_(), __has_value_(true) {
    if (!other.has_value()) {
      __construct_error(static_cast<G&&>(other.error()));
    }
  }

  template <class G>
    requires is_constructible<E, const G&>::value
  constexpr expected(const unexpected<G>& error)
      : __storage_(unexpect, error.error()), __has_value_(false) {}

  template <class G>
    requires is_constructible<E, G>::value
  constexpr expected(unexpected<G>&& error)
      : __storage_(unexpect, static_cast<G&&>(error.error())),
        __has_value_(false) {}

  constexpr explicit expected(in_place_t) noexcept
      : __storage_(), __has_value_(true) {}

  template <class... Args>
    requires is_constructible<E, Args...>::value
  constexpr explicit expected(unexpect_t, Args&&... args)
      : __storage_(), __has_value_(true) {
    __construct_error(static_cast<Args&&>(args)...);
  }

  template <class U, class... Args>
    requires is_constructible<E, initializer_list<U>&, Args...>::value
  constexpr explicit expected(unexpect_t, initializer_list<U> init,
                              Args&&... args)
      : __storage_(), __has_value_(true) {
    __construct_error_list(init, static_cast<Args&&>(args)...);
  }

  constexpr ~expected() {
    if (!__has_value_) {
      __error_ptr()->~E();
    }
  }

  constexpr expected& operator=(const expected& other)
    requires (is_copy_constructible<E>::value &&
              is_copy_assignable<E>::value) {
    if (this == &other) {
      return *this;
    }
    if (__has_value_ && !other.__has_value_) {
      __construct_error(other.error());
    } else if (!__has_value_ && other.__has_value_) {
      __error_ptr()->~E();
      __has_value_ = true;
    } else if (!__has_value_) {
      error() = other.error();
    }
    return *this;
  }

  constexpr expected& operator=(expected&& other)
    requires (is_move_constructible<E>::value &&
              is_move_assignable<E>::value) {
    if (this == &other) {
      return *this;
    }
    if (__has_value_ && !other.__has_value_) {
      __construct_error(static_cast<E&&>(other.error()));
    } else if (!__has_value_ && other.__has_value_) {
      __error_ptr()->~E();
      __has_value_ = true;
    } else if (!__has_value_) {
      error() = static_cast<E&&>(other.error());
    }
    return *this;
  }

  template <class G>
    requires (is_constructible<E, const G&>::value &&
              is_assignable<E&, const G&>::value)
  constexpr expected& operator=(const unexpected<G>& other) {
    if (__has_value_) {
      __construct_error(other.error());
    } else {
      error() = other.error();
    }
    return *this;
  }

  template <class G>
    requires (is_constructible<E, G>::value &&
              is_assignable<E&, G>::value)
  constexpr expected& operator=(unexpected<G>&& other) {
    if (__has_value_) {
      __construct_error(static_cast<G&&>(other.error()));
    } else {
      error() = static_cast<G&&>(other.error());
    }
    return *this;
  }

  constexpr explicit operator bool() const noexcept { return __has_value_; }
  constexpr bool has_value() const noexcept { return __has_value_; }
#if __cplusplus >= 202700L
  constexpr bool has_error() const noexcept { return !has_value(); }
#endif

  constexpr void operator*() const noexcept {}

  constexpr void value() const& {
    if (!__has_value_) {
      __DAVECC_THROW(bad_expected_access<E>(error()));
    }
  }

  constexpr void value() && {
    if (!__has_value_) {
      __DAVECC_THROW(bad_expected_access<E>(
          static_cast<E&&>(error())));
    }
  }

  constexpr const E& error() const& noexcept { return *__error_ptr(); }
  constexpr E& error() & noexcept { return *__error_ptr(); }
  constexpr const E&& error() const&& noexcept {
    return static_cast<const E&&>(*__error_ptr());
  }
  constexpr E&& error() && noexcept {
    return static_cast<E&&>(*__error_ptr());
  }

  template <class G>
  constexpr E error_or(G&& default_error) const& {
    return __has_value_ ? static_cast<E>(static_cast<G&&>(default_error))
