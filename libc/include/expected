template <class T, class E>
constexpr void swap(expected<T, E>& left, expected<T, E>& right) {
  left.swap(right);
}

template <class T1, class E1, class T2, class E2>
  requires (!is_void<T1>::value && !is_void<T2>::value)
constexpr bool operator==(const expected<T1, E1>& left,
                          const expected<T2, E2>& right) {
  if (left.has_value() != right.has_value()) {
    return false;
  }
  return left.has_value() ? *left == *right
                          : left.error() == right.error();
}

template <class E1, class E2>
constexpr bool operator==(const expected<void, E1>& left,
                          const expected<void, E2>& right) {
  if (left.has_value() != right.has_value()) {
    return false;
  }
  return left.has_value() || left.error() == right.error();
}

template <class T, class E, class U>
  requires (!__expected_detail::__is_expected<remove_cvref_t<U>>::value &&
            !__expected_detail::__is_unexpected<remove_cvref_t<U>>::value)
constexpr bool operator==(const expected<T, E>& left, const U& right) {
  return left.has_value() && *left == right;
}

template <class T, class E, class U>
  requires (!__expected_detail::__is_expected<remove_cvref_t<U>>::value &&
            !__expected_detail::__is_unexpected<remove_cvref_t<U>>::value)
constexpr bool operator==(const U& left, const expected<T, E>& right) {
  return right == left;
}

template <class T, class E, class G>
constexpr bool operator==(const expected<T, E>& left,
                          const unexpected<G>& right) {
  return !left.has_value() && left.error() == right.error();
}

template <class T, class E, class G>
constexpr bool operator==(const unexpected<G>& left,
                          const expected<T, E>& right) {
  return right == left;
}

