template <class CharT, class Traits>
class basic_spanbuf;
template <class CharT, class Traits>
class basic_ispanstream;
template <class CharT, class Traits>
class basic_ospanstream;
template <class CharT, class Traits>
class basic_spanstream;

using spanbuf = basic_spanbuf<char, char_traits<char>>;
using wspanbuf = basic_spanbuf<wchar_t, char_traits<wchar_t>>;
using ispanstream = basic_ispanstream<char, char_traits<char>>;
using wispanstream = basic_ispanstream<wchar_t, char_traits<wchar_t>>;
using ospanstream = basic_ospanstream<char, char_traits<char>>;
using wospanstream = basic_ospanstream<wchar_t, char_traits<wchar_t>>;
using spanstream = basic_spanstream<char, char_traits<char>>;
using wspanstream = basic_spanstream<wchar_t, char_traits<wchar_t>>;

template <class CharT, class Traits = char_traits<CharT>>
class basic_spanbuf : public basic_streambuf<CharT, Traits> {
 public:
  typedef CharT char_type;
  typedef Traits traits_type;
  typedef typename Traits::int_type int_type;
  typedef typename Traits::pos_type pos_type;
  typedef typename Traits::off_type off_type;

  explicit basic_spanbuf(std::span<CharT> buffer,
                         ios_base::openmode which =
                             ios_base::in | ios_base::out)
      : __buffer_(buffer), __mode_(which), __gpos_(0), __ppos_(0),
        __high_((which & ios_base::out) != 0 ? 0 : buffer.size()) {
    if ((which & (ios_base::ate | ios_base::app)) != 0) {
      __ppos_ = __high_;
    }
  }

  basic_spanbuf()
      : __buffer_(), __mode_(ios_base::in | ios_base::out), __gpos_(0),
        __ppos_(0), __high_(0) {}

  std::span<CharT> span() const noexcept {
    return std::span<CharT>(__buffer_.data(), __high_);
  }

 protected:
  int_type underflow() override {
    if ((__mode_ & ios_base::in) != 0 && __gpos_ < __high_) {
      return Traits::to_int_type(__buffer_[__gpos_]);
    }
    return Traits::eof();
  }

  int_type uflow() override {
    int_type value = underflow();
    if (!Traits::eq_int_type(value, Traits::eof())) {
      ++__gpos_;
    }
    return value;
  }

  int_type pbackfail(int_type value = Traits::eof()) override {
    if (__gpos_ == 0) {
      return Traits::eof();
    }
    --__gpos_;
    if (!Traits::eq_int_type(value, Traits::eof())) {
      __buffer_[__gpos_] = Traits::to_char_type(value);
    }
    return Traits::to_int_type(__buffer_[__gpos_]);
  }

  streamsize showmanyc() override {
    return __gpos_ < __high_
               ? static_cast<streamsize>(__high_ - __gpos_)
               : 0;
  }

  streamsize xsgetn(CharT* output, streamsize count) override {
    streamsize read = 0;
    while (read < count && __gpos_ < __high_) {
      output[read++] = __buffer_[__gpos_++];
    }
    return read;
  }

  int_type overflow(int_type value = Traits::eof()) override {
    if (Traits::eq_int_type(value, Traits::eof())) {
      return Traits::not_eof(value);
    }
    if ((__mode_ & ios_base::out) == 0 || __ppos_ >= __buffer_.size()) {
      return Traits::eof();
    }
    __buffer_[__ppos_++] = Traits::to_char_type(value);
    if (__ppos_ > __high_) {
      __high_ = __ppos_;
    }
    return value;
  }

  streamsize xsputn(const CharT* input, streamsize count) override {
    if ((__mode_ & ios_base::out) == 0) {
      return 0;
    }
    streamsize written = 0;
    while (written < count && __ppos_ < __buffer_.size()) {
      __buffer_[__ppos_++] = input[written++];
    }
    if (__ppos_ > __high_) {
      __high_ = __ppos_;
    }
    return written;
  }

  pos_type seekoff(off_type offset, ios_base::seekdir direction,
                   ios_base::openmode which =
                       ios_base::in | ios_base::out) override {
    bool seek_in = (which & ios_base::in) != 0;
    bool seek_out = (which & ios_base::out) != 0;
    if (!seek_in && !seek_out) {
      return pos_type(off_type(-1));
    }
    if ((seek_in && (__mode_ & ios_base::in) == 0) ||
        (seek_out && (__mode_ & ios_base::out) == 0)) {
      return pos_type(off_type(-1));
    }
    off_type base = 0;
    if (direction == ios_base::cur) {
      if (seek_in && seek_out && __gpos_ != __ppos_) {
        return pos_type(off_type(-1));
      }
      base = static_cast<off_type>(seek_in ? __gpos_ : __ppos_);
    } else if (direction == ios_base::end) {
      base = static_cast<off_type>(__high_);
    }
    off_type target = base + offset;
    if (target < 0 ||
        static_cast<size_t>(target) > __buffer_.size()) {
      return pos_type(off_type(-1));
    }
    if (seek_in) {
      __gpos_ = static_cast<size_t>(target);
    }
    if (seek_out) {
      __ppos_ = static_cast<size_t>(target);
    }
    return pos_type(target);
  }

  pos_type seekpos(pos_type position,
                   ios_base::openmode which =
                       ios_base::in | ios_base::out) override {
    return seekoff(static_cast<off_type>(position), ios_base::beg, which);
  }

 private:
  std::span<CharT> __buffer_;
  ios_base::openmode __mode_;
  size_t __gpos_;
  size_t __ppos_;
  size_t __high_;
};

template <class CharT, class Traits = char_traits<CharT>>
class basic_ispanstream : public basic_istream<CharT, Traits> {
 public:
  explicit basic_ispanstream(
      std::span<CharT> buffer,
      ios_base::openmode which = ios_base::in)
      : basic_istream<CharT, Traits>(), __buf_(buffer, which | ios_base::in) {
    this->init(&__buf_);
  }

  basic_spanbuf<CharT, Traits>* rdbuf() const {
    return const_cast<basic_spanbuf<CharT, Traits>*>(&__buf_);
  }
  std::span<CharT> span() const noexcept { return __buf_.span(); }

 private:
  basic_spanbuf<CharT, Traits> __buf_;
};

template <class CharT, class Traits = char_traits<CharT>>
class basic_ospanstream : public basic_ostream<CharT, Traits> {
 public:
  explicit basic_ospanstream(
      std::span<CharT> buffer,
      ios_base::openmode which = ios_base::out)
      : basic_ostream<CharT, Traits>(), __buf_(buffer, which | ios_base::out) {
    this->init(&__buf_);
  }

  basic_spanbuf<CharT, Traits>* rdbuf() const {
    return const_cast<basic_spanbuf<CharT, Traits>*>(&__buf_);
  }
  std::span<CharT> span() const noexcept { return __buf_.span(); }

 private:
  basic_spanbuf<CharT, Traits> __buf_;
};

template <class CharT, class Traits = char_traits<CharT>>
class basic_spanstream : public basic_iostream<CharT, Traits> {
 public:
  explicit basic_spanstream(
      std::span<CharT> buffer,
      ios_base::openmode which = ios_base::in | ios_base::out)
      : basic_iostream<CharT, Traits>(), __buf_(buffer, which) {
    this->init(&__buf_);
  }

  basic_spanbuf<CharT, Traits>* rdbuf() const {
    return const_cast<basic_spanbuf<CharT, Traits>*>(&__buf_);
  }
  std::span<CharT> span() const noexcept { return __buf_.span(); }

 private:
  basic_spanbuf<CharT, Traits> __buf_;
};

