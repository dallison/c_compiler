//
//  ratio
//  c_compiler
//
//  Minimal C++20 ratio support for DaveCC.
//

#ifndef ratio_h
#define ratio_h

#include <cstdint>
#include <type_traits>

namespace std {

namespace __ratio_detail {

constexpr intmax_t __abs_intmax(intmax_t value) {
  return value < 0 ? -value : value;
}

constexpr intmax_t __gcd_intmax(intmax_t a, intmax_t b) {
  return b == 0 ? __abs_intmax(a) : __gcd_intmax(b, a % b);
}

constexpr intmax_t __normalized_num(intmax_t num, intmax_t den) {
  return (den < 0 ? -num : num) / __gcd_intmax(num, den);
}

constexpr intmax_t __normalized_den(intmax_t num, intmax_t den) {
  return __abs_intmax(den) / __gcd_intmax(num, den);
}

template <class R1, class R2>
struct __ratio_cross_multiply {
  static constexpr intmax_t __gcd1 = __gcd_intmax(R1::num, R2::num);
  static constexpr intmax_t __gcd2 = __gcd_intmax(R1::den, R2::den);
  static constexpr intmax_t __left_num = R1::num / __gcd1;
  static constexpr intmax_t __right_num = R2::num / __gcd1;
  static constexpr intmax_t __left_den = R1::den / __gcd2;
  static constexpr intmax_t __right_den = R2::den / __gcd2;
};

}  // namespace __ratio_detail

template <intmax_t Num, intmax_t Den = 1>
struct ratio {
  static_assert(Den != 0, "ratio denominator cannot be zero");
  static constexpr intmax_t num =
      __ratio_detail::__normalized_num(Num, Den);
  static constexpr intmax_t den =
      __ratio_detail::__normalized_den(Num, Den);
  using type = ratio<num, den>;
};

template <class R1, class R2>
struct ratio_equal
    : bool_constant<R1::num == R2::num && R1::den == R2::den> {
};

template <class R1, class R2>
struct ratio_not_equal : bool_constant<!ratio_equal<R1, R2>::value> {
};

template <class R1, class R2>
struct ratio_less
    : bool_constant<(R1::num * R2::den) < (R2::num * R1::den)> {
};

template <class R1, class R2>
struct ratio_less_equal : bool_constant<!ratio_less<R2, R1>::value> {
};

template <class R1, class R2>
struct ratio_greater : ratio_less<R2, R1> {
};

template <class R1, class R2>
struct ratio_greater_equal : bool_constant<!ratio_less<R1, R2>::value> {
};

template <class R1, class R2>
using ratio_add =
    typename ratio<R1::num * R2::den + R2::num * R1::den,
                   R1::den * R2::den>::type;

template <class R1, class R2>
using ratio_subtract =
    typename ratio<R1::num * R2::den - R2::num * R1::den,
                   R1::den * R2::den>::type;

template <class R1, class R2>
using ratio_multiply =
    typename ratio<R1::num * R2::num, R1::den * R2::den>::type;

template <class R1, class R2>
using ratio_divide =
    typename ratio<R1::num * R2::den, R1::den * R2::num>::type;

using atto = ratio<1, 1000000000000000000LL>;
using femto = ratio<1, 1000000000000000LL>;
using pico = ratio<1, 1000000000000LL>;
using nano = ratio<1, 1000000000LL>;
using micro = ratio<1, 1000000LL>;
using milli = ratio<1, 1000>;
using centi = ratio<1, 100>;
using deci = ratio<1, 10>;
using deca = ratio<10, 1>;
using hecto = ratio<100, 1>;
using kilo = ratio<1000, 1>;
using mega = ratio<1000000, 1>;
using giga = ratio<1000000000, 1>;
using tera = ratio<1000000000000LL, 1>;
using peta = ratio<1000000000000000LL, 1>;
using exa = ratio<1000000000000000000LL, 1>;

}  // namespace std

#endif /* ratio_h */
