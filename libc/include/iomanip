struct __resetiosflags {
  ios_base::fmtflags mask;
};

struct __setiosflags {
  ios_base::fmtflags mask;
};

struct __setbase {
  int base;
};

struct __setprecision {
  int precision;
};

struct __setw {
  int width;
};

template <class CharT>
struct __setfill {
  CharT value;
};

inline __resetiosflags resetiosflags(ios_base::fmtflags mask) {
  return {mask};
}

inline __setiosflags setiosflags(ios_base::fmtflags mask) {
  return {mask};
}

inline __setbase setbase(int base) {
  return {base};
}

template <class CharT>
inline __setfill<CharT> setfill(CharT value) {
  return {value};
}

inline __setprecision setprecision(int precision) {
  return {precision};
}

inline __setw setw(int width) {
  return {width};
}

template <class CharT, class Traits>
basic_ostream<CharT, Traits>& operator<<(
    basic_ostream<CharT, Traits>& stream, __resetiosflags manip) {
  stream.unsetf(manip.mask);
  return stream;
}

template <class CharT, class Traits>
basic_istream<CharT, Traits>& operator>>(
    basic_istream<CharT, Traits>& stream, __resetiosflags manip) {
  stream.unsetf(manip.mask);
  return stream;
}

template <class CharT, class Traits>
basic_ostream<CharT, Traits>& operator<<(
    basic_ostream<CharT, Traits>& stream, __setiosflags manip) {
  stream.setf(manip.mask);
  return stream;
}

template <class CharT, class Traits>
basic_istream<CharT, Traits>& operator>>(
    basic_istream<CharT, Traits>& stream, __setiosflags manip) {
  stream.setf(manip.mask);
  return stream;
}

inline ios_base::fmtflags __base_flag(int base) {
  return base == 8 ? ios_base::oct
       : base == 10 ? ios_base::dec
       : base == 16 ? ios_base::hex
                    : static_cast<ios_base::fmtflags>(0);
}

template <class Stream>
void __apply_setbase(Stream& stream, int base) {
  ios_base::fmtflags flag = __base_flag(base);
  if (flag == static_cast<ios_base::fmtflags>(0)) {
    stream.unsetf(ios_base::basefield);
  } else {
    stream.setf(flag, ios_base::basefield);
  }
}

template <class CharT, class Traits>
basic_ostream<CharT, Traits>& operator<<(
    basic_ostream<CharT, Traits>& stream, __setbase manip) {
  __apply_setbase(stream, manip.base);
  return stream;
}

template <class CharT, class Traits>
basic_istream<CharT, Traits>& operator>>(
    basic_istream<CharT, Traits>& stream, __setbase manip) {
  __apply_setbase(stream, manip.base);
  return stream;
}

template <class CharT, class Traits>
basic_ostream<CharT, Traits>& operator<<(
    basic_ostream<CharT, Traits>& stream, __setfill<CharT> manip) {
  stream.fill(manip.value);
  return stream;
}

template <class CharT, class Traits>
basic_ostream<CharT, Traits>& operator<<(
    basic_ostream<CharT, Traits>& stream, __setprecision manip) {
  stream.precision(manip.precision);
  return stream;
}

template <class CharT, class Traits>
basic_istream<CharT, Traits>& operator>>(
