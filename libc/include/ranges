namespace std {

// A prvalue copy of an expression's decayed type, used in the range-access CPO
// constraints to check the *decayed* return type of member/ADL calls.
template <class T>
constexpr decay_t<T> __decay_copy(T&& t) noexcept {
  return static_cast<T&&>(t);
}

// to_address for a raw pointer or a contiguous class iterator.
template <class T>
constexpr T* __to_address(T* p) noexcept {
  return p;
}
template <class It>
  requires requires(const It& i) { i.operator->(); }
constexpr auto __to_address(const It& it) noexcept {
  return __to_address(it.operator->());
}

namespace ranges {

struct comparator_probe {};

struct equal_to {
  unsigned char __state = 0;
  template <class T, class U>
  constexpr bool operator()(T&& left, U&& right) const {
    return static_cast<T&&>(left) == static_cast<U&&>(right);
  }
};

struct not_equal_to {
  unsigned char __state = 0;
  template <class T, class U>
  constexpr bool operator()(T&& left, U&& right) const {
    return !(static_cast<T&&>(left) == static_cast<U&&>(right));
  }
};

struct less {
  unsigned char __state = 0;
  template <class T, class U>
  constexpr bool operator()(T&& left, U&& right) const {
    return static_cast<T&&>(left) < static_cast<U&&>(right);
  }
};

struct greater {
  unsigned char __state = 0;
  template <class T, class U>
  constexpr bool operator()(T&& left, U&& right) const {
    return static_cast<U&&>(right) < static_cast<T&&>(left);
  }
};

struct less_equal {
  unsigned char __state = 0;
  template <class T, class U>
  constexpr bool operator()(T&& left, U&& right) const {
    return !(static_cast<U&&>(right) < static_cast<T&&>(left));
  }
};

struct greater_equal {
  unsigned char __state = 0;
  template <class T, class U>
  constexpr bool operator()(T&& left, U&& right) const {
    return !(static_cast<T&&>(left) < static_cast<U&&>(right));
  }
};

// [range.access] helpers -----------------------------------------------------

namespace __access {

template <class T>
concept __class_or_enum =
    is_class_v<remove_cvref_t<T>> || is_union_v<remove_cvref_t<T>> ||
    is_enum_v<remove_cvref_t<T>>;

template <class T>
concept __pointer = is_pointer_v<T>;

}  // namespace __access

// [range.range] borrowed-range opt-in (specialized by view types).
template <class>
inline constexpr bool enable_borrowed_range = false;

// [range.access.begin] --------------------------------------------------------
namespace __begin {

template <class T>
void begin(T&) = delete;
template <class T>
void begin(const T&) = delete;

template <class T>
concept __member_begin = requires(T& t) {
  t.begin();
};

template <class T>
concept __adl_begin = __access::__class_or_enum<T> && requires(T& t) {
  begin(t);
};

template <class T, size_t N>
constexpr T* __call(T (&value)[N], int) {
  return value;
}

template <class T>
constexpr auto __call(T&& value, int) -> decltype(value.begin()) {
  return value.begin();
}

struct __fn {
  template <class T>
    requires __member_begin<T>
  constexpr auto operator()(T&& t) const {
    return t.begin();
  }
  template <class T, size_t N>
  constexpr T* operator()(T (&t)[N]) const {
    return t;
  }
  template <class T>
    requires(!__member_begin<T>) && __adl_begin<T>
  constexpr auto operator()(T&& t) const {
    return begin(t);
  }
};

}  // namespace __begin

inline namespace __cpo {
inline constexpr __begin::__fn begin{};
}  // namespace __cpo

