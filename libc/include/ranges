          ranges::advance(__window_end_, __n_, __end_);
      __exhausted_ = remaining != 0;
    }

    constexpr reference operator*() const {
      return reference(__current_, __window_end_, __n_);
    }

    constexpr iterator& operator++() {
      if (__window_end_ == __end_) {
        __exhausted_ = true;
      } else {
        ++__current_;
        ++__window_end_;
      }
      return *this;
    }

    constexpr iterator operator++(int) {
      iterator copy = *this;
      ++*this;
      return copy;
    }

