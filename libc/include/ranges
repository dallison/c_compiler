// [range.sized]
template <class T>
concept sized_range = range<T> && requires(T& t) { ranges::size(t); };

// [range.refinements] ---------------------------------------------------------
template <class T>
using range_difference_t = iter_difference_t<iterator_t<T>>;

template <class T>
using range_value_t = iter_value_t<iterator_t<T>>;

template <class T>
using range_reference_t = iter_reference_t<iterator_t<T>>;

template <class T>
using range_rvalue_reference_t = iter_rvalue_reference_t<iterator_t<T>>;

template <sized_range R>
using range_size_t = decltype(ranges::size(declval<R&>()));

template <class R>
constexpr auto __distance_fn::operator()(R&& range) const {
  return (*this)(ranges::begin(range), ranges::end(range));
}

template <class R, class T>
concept output_range =
    range<R> && output_iterator<iterator_t<R>, T>;

template <class T>
concept input_range = range<T> && input_iterator<iterator_t<T>>;

template <class T>
concept forward_range = input_range<T> && forward_iterator<iterator_t<T>>;

template <class T>
concept bidirectional_range =
    forward_range<T> && bidirectional_iterator<iterator_t<T>>;

template <class T>
concept random_access_range =
    bidirectional_range<T> && random_access_iterator<iterator_t<T>>;

template <class T>
concept contiguous_range =
    random_access_range<T> && contiguous_iterator<iterator_t<T>> &&
    requires(T& t) {
      { ranges::data(t) } -> same_as<add_pointer_t<range_reference_t<T>>>;
    };

template <class T>
concept common_range =
    range<T> && same_as<iterator_t<T>, sentinel_t<T>>;

// [range.view] ----------------------------------------------------------------
struct view_base {
  constexpr view_base() = default;
  constexpr view_base(const view_base&) = default;
  constexpr view_base(view_base&&) = default;
  constexpr view_base& operator=(const view_base&) noexcept { return *this; }
  constexpr view_base& operator=(view_base&&) noexcept { return *this; }
};

template <class T>
inline constexpr bool enable_view =
    derived_from<T, view_base> || false;

template <class T>
concept view =
    range<T> && movable<T> && enable_view<T>;

template <class T>
concept viewable_range =
    range<T> &&
    ((view<remove_cvref_t<T>> && constructible_from<remove_cvref_t<T>, T>) ||
     (!view<remove_cvref_t<T>> &&
      (is_lvalue_reference_v<T> ||
       (movable<remove_reference_t<T>>))));

// [range.dangling] ------------------------------------------------------------
struct dangling {
  constexpr dangling() noexcept = default;
  template <class... Args>
  constexpr dangling(Args&&...) noexcept {}
};

template <range R>
using borrowed_iterator_t =
    conditional_t<borrowed_range<R>, iterator_t<R>, dangling>;

// [range.move.wrap] __movable_box ---------------------------------------------
// A wrapper that gives a move-constructible object the copy/move assignment a
// view needs to store predicates and function objects (whose closure types are
// not assignable in C++20).  When the wrapped type already provides the needed
// assignment it is used directly; otherwise assignment is emulated by
// destroy-then-reconstruct.
template <class T>
concept __boxable = move_constructible<T> && is_object_v<T>;

template <__boxable T>
class __movable_box {
 private:
  T __value_;

 public:
  constexpr __movable_box()
    requires default_initializable<T>
      : __value_() {}

  constexpr __movable_box(const T& t)
    requires copy_constructible<T>
      : __value_(t) {}

  constexpr __movable_box(T&& t) : __value_(static_cast<T&&>(t)) {}

  template <class... Args>
    requires constructible_from<T, Args...>
  constexpr explicit __movable_box(in_place_t, Args&&... args)
      : __value_(static_cast<Args&&>(args)...) {}

  __movable_box(const __movable_box&)
    requires copy_constructible<T>
  = default;
  __movable_box(__movable_box&&) = default;

  constexpr __movable_box& operator=(const __movable_box& other)
    requires copy_constructible<T>
  {
    if (this != &other) {
      if constexpr (is_copy_assignable_v<T>) {
        __value_ = other.__value_;
      } else {
        __value_.~T();
        ::new (static_cast<void*>(&__value_)) T(other.__value_);
      }
    }
    return *this;
  }

  constexpr __movable_box& operator=(__movable_box&& other) {
    if (this != &other) {
      if constexpr (is_move_assignable_v<T>) {
        __value_ = static_cast<T&&>(other.__value_);
      } else {
        __value_.~T();
        ::new (static_cast<void*>(&__value_)) T(static_cast<T&&>(other.__value_));
      }
    }
    return *this;
  }

  constexpr bool has_value() const noexcept { return true; }
  constexpr T& operator*() noexcept { return __value_; }
  constexpr const T& operator*() const noexcept { return __value_; }
  constexpr T* operator->() noexcept { return &__value_; }
  constexpr const T* operator->() const noexcept { return &__value_; }
};

// [view.interface] ------------------------------------------------------------
template <class D>
  requires is_class_v<D> && same_as<D, remove_cv_t<D>>
class view_interface : public view_base {
 private:
  constexpr D& __derived() noexcept { return static_cast<D&>(*this); }
  constexpr const D& __derived() const noexcept {
    return static_cast<const D&>(*this);
  }

 public:
  constexpr bool empty()
    requires forward_range<D>
  {
    return ranges::begin(__derived()) == ranges::end(__derived());
  }
  constexpr bool empty() const
    requires forward_range<const D>
  {
    return ranges::begin(__derived()) == ranges::end(__derived());
  }

  constexpr explicit operator bool()
    requires requires(D& d) { ranges::empty(d); }
  {
    return !ranges::empty(__derived());
  }
  constexpr explicit operator bool() const
    requires requires(const D& d) { ranges::empty(d); }
  {
    return !ranges::empty(__derived());
  }

  constexpr auto data()
    requires contiguous_iterator<iterator_t<D>>
  {
    return std::__to_address(ranges::begin(__derived()));
  }
  constexpr auto data() const
    requires range<const D> && contiguous_iterator<iterator_t<const D>>
  {
    return std::__to_address(ranges::begin(__derived()));
  }

  constexpr auto size()
    requires forward_range<D> &&
             sized_sentinel_for<sentinel_t<D>, iterator_t<D>>
  {
    return static_cast<size_t>(ranges::end(__derived()) -
                               ranges::begin(__derived()));
  }
  constexpr auto size() const
    requires forward_range<const D> &&
             sized_sentinel_for<sentinel_t<const D>, iterator_t<const D>>
  {
    return static_cast<size_t>(ranges::end(__derived()) -
                               ranges::begin(__derived()));
  }

  constexpr decltype(auto) front()
    requires forward_range<D>
  {
    return *ranges::begin(__derived());
  }
  constexpr decltype(auto) front() const
    requires forward_range<const D>
  {
    return *ranges::begin(__derived());
  }

  constexpr decltype(auto) back()
    requires bidirectional_range<D> && common_range<D>
  {
    return *std::prev(ranges::end(__derived()));
  }
  constexpr decltype(auto) back() const
    requires bidirectional_range<const D> && common_range<const D>
  {
    return *std::prev(ranges::end(__derived()));
  }

  template <random_access_range R = D>
  constexpr decltype(auto) operator[](range_difference_t<R> n) {
    return ranges::begin(__derived())[n];
  }
  template <random_access_range R = const D>
  constexpr decltype(auto) operator[](range_difference_t<R> n) const {
    return ranges::begin(__derived())[n];
  }
};

// [range.subrange] ------------------------------------------------------------
enum class subrange_kind : bool { unsized, sized };

template <class I, class S>
struct __subrange_kind_default {
  static constexpr subrange_kind value =
      sized_sentinel_for<S, I> ? subrange_kind::sized
                               : subrange_kind::unsized;
};

// A pair of an iterator and a sentinel forming a view.  This implementation
// takes two template parameters (iterator + sentinel); when the sentinel is a
// sized sentinel for the iterator, the range models sized_range with an O(1)
// size() computed as `end - begin` (no stored size is needed for any of the
// ranges produced by this library, all of which have sized sentinels or common
// iterators).
template <input_or_output_iterator I, sentinel_for<I> S = I,
          subrange_kind K =
              sized_sentinel_for<S, I> ? subrange_kind::sized
                                       : subrange_kind::unsized>
class subrange : public view_interface<subrange<I, S, K>> {
 private:
  I __begin_ = I();
  S __end_ = S();
  iter_difference_t<I> __size_ = 0;

 public:
  using iterator = I;
  using sentinel = S;
  using const_iterator = I;

  subrange()
    requires default_initializable<I>
  = default;

  constexpr subrange(I i, S s)
    requires(K == subrange_kind::unsized || sized_sentinel_for<S, I>)
      : __begin_(static_cast<I&&>(i)), __end_(static_cast<S&&>(s)) {
    if constexpr (K == subrange_kind::sized) {
      __size_ = __end_ - __begin_;
    }
  }

  constexpr subrange(I i, S s, iter_difference_t<I> n)
    requires(K == subrange_kind::sized)
      : __begin_(static_cast<I&&>(i)),
        __end_(static_cast<S&&>(s)),
        __size_(n) {}

  template <borrowed_range R>
    requires convertible_to<iterator_t<R>, I> &&
             convertible_to<sentinel_t<R>, S> &&
             (K == subrange_kind::unsized || sized_range<R>)
  constexpr subrange(R&& r)
      : __begin_(ranges::begin(r)), __end_(ranges::end(r)) {
    if constexpr (K == subrange_kind::sized) {
      __size_ = static_cast<iter_difference_t<I>>(ranges::size(r));
    }
  }

  template <borrowed_range R>
    requires(K == subrange_kind::sized) &&
            convertible_to<iterator_t<R>, I> &&
            convertible_to<sentinel_t<R>, S>
  constexpr subrange(R&& r, iter_difference_t<I> n)
      : __begin_(ranges::begin(r)),
        __end_(ranges::end(r)),
        __size_(n) {}

  constexpr I begin() const
    requires copyable<I>
  {
    return __begin_;
  }
  constexpr S end() const { return __end_; }

  constexpr bool empty() const { return __begin_ == __end_; }

  constexpr size_t size() const
    requires(K == subrange_kind::sized)
  {
    return static_cast<size_t>(__size_);
  }

  constexpr subrange& advance(iter_difference_t<I> n) {
    if constexpr (K == subrange_kind::sized) {
      __size_ -= n;
    }
    ranges::advance(__begin_, n, __end_);
    return *this;
  }

  [[nodiscard]] constexpr subrange next(iter_difference_t<I> n = 1) const {
    subrange copy = *this;
    copy.advance(n);
    return copy;
  }

  [[nodiscard]] constexpr subrange prev(iter_difference_t<I> n = 1) const
    requires bidirectional_iterator<I>
  {
    subrange copy = *this;
    copy.advance(-n);
    return copy;
  }
};

template <input_or_output_iterator I, sentinel_for<I> S>
subrange(I, S) -> subrange<I, S>;

template <input_or_output_iterator I, sentinel_for<I> S>
subrange(I, S, iter_difference_t<I>)
    -> subrange<I, S, subrange_kind::sized>;

template <borrowed_range R>
subrange(R&&) -> subrange<iterator_t<R>, sentinel_t<R>>;

template <borrowed_range R>
subrange(R&&, range_difference_t<R>)
    -> subrange<iterator_t<R>, sentinel_t<R>, subrange_kind::sized>;

template <class I, class S, subrange_kind K>
inline constexpr bool enable_borrowed_range<subrange<I, S, K>> = true;

template <size_t N, class I, class S, subrange_kind K>
  requires(N < 2)
constexpr auto get(const subrange<I, S, K>& r) {
  if constexpr (N == 0) {
    return r.begin();
  } else {
    return r.end();
  }
}

template <range R>
using borrowed_subrange_t =
    conditional_t<borrowed_range<R>,
                  subrange<iterator_t<R>, sentinel_t<R>>, dangling>;

// [range.ref.view] ------------------------------------------------------------
template <range R>
  requires is_object_v<R>
class ref_view : public view_interface<ref_view<R>> {
 private:
  R* __r_ = nullptr;

  // Only bind to an lvalue that converts to R& (never a temporary): the LWG
  // "__fun" idiom -- `void __fun(R&); __fun(t);` -- is well-formed exactly when
  // the argument is (or converts to) an lvalue reference.
  static void __fun(R&);
  static void __fun(R&&) = delete;

 public:
  using iterator = iterator_t<R>;
  using sentinel = sentinel_t<R>;
  using const_iterator = iterator;

  constexpr ref_view(R& r) noexcept : __r_(&r) {}

  template <class T>
    requires(!same_as<remove_cvref_t<T>, ref_view>) &&
            convertible_to<T, R&> && requires { __fun(declval<T>()); }
  constexpr ref_view(T&& t)
      : __r_(&static_cast<R&>(static_cast<T&&>(t))) {}

  constexpr R& base() const { return *__r_; }

  constexpr iterator_t<R> begin() const { return ranges::begin(*__r_); }
  constexpr sentinel_t<R> end() const { return ranges::end(*__r_); }

  constexpr bool empty() const
    requires requires { ranges::empty(*__r_); }
  {
    return ranges::empty(*__r_);
  }

  constexpr auto size() const
    requires sized_range<R>
  {
    return ranges::size(*__r_);
  }

  constexpr auto data() const
    requires contiguous_range<R>
  {
    return ranges::data(*__r_);
  }
};

template <class R>
ref_view(R&) -> ref_view<R>;

template <class T>
inline constexpr bool enable_borrowed_range<ref_view<T>> = true;

