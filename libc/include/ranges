      __transform_iterator<__base_iterator, __base_sentinel, TransformFun>;
  using sentinel = iterator;
  using const_iterator = iterator;

  transform_view()
    requires default_initializable<V> && default_initializable<TransformFun>
  = default;
  constexpr transform_view(V base, TransformFun fun)
      : __base_(static_cast<V&&>(base)),
        __fun_(static_cast<TransformFun&&>(fun)) {}
  static constexpr transform_view __make(V base, TransformFun fun) {
    return transform_view(static_cast<V&&>(base),
                          static_cast<TransformFun&&>(fun));
  }

  constexpr V base() const&
    requires copy_constructible<V>
  {
    return __base_;
  }
  constexpr V base() && { return static_cast<V&&>(__base_); }

  constexpr iterator begin() {
    return iterator(ranges::begin(__base_), ranges::end(__base_), *__fun_);
  }
  constexpr iterator end() {
    return iterator(ranges::begin(__base_), ranges::end(__base_), *__fun_, true);
  }
  constexpr __transform_iterator<iterator_t<const V>, sentinel_t<const V>,
                                 TransformFun>
  begin() const
    requires range<const V> &&
             regular_invocable<const TransformFun&,
                               range_reference_t<const V>>
  {
