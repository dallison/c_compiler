// [range.join]
template <class OuterI, class OuterS, class InnerI, class InnerS>
class __join_iterator {
 public:
  using iterator_concept = input_iterator_tag;
  using iterator_category = input_iterator_tag;
  using value_type = iter_value_t<InnerI>;
  using difference_type = ptrdiff_t;
  using reference = iter_reference_t<InnerI>;
  using pointer = void;

  OuterI __outer_;
  OuterS __outer_end_;
  InnerI __inner_;
  InnerS __inner_end_;
  bool __at_end_ = false;

  __join_iterator() = default;
  constexpr __join_iterator(OuterI outer, OuterS outer_end, bool at_end)
      : __outer_(static_cast<OuterI&&>(outer)),
        __outer_end_(static_cast<OuterS&&>(outer_end)),
        __at_end_(at_end) {
    if (!__at_end_) {
      __satisfy();
    }
  }
  static constexpr __join_iterator __make(OuterI outer, OuterS outer_end,
                                          bool at_end = false) {
    return __join_iterator(static_cast<OuterI&&>(outer),
                           static_cast<OuterS&&>(outer_end), at_end);
  }
  constexpr void __satisfy() {
    while (__outer_ != __outer_end_) {
      auto&& inner_range = *__outer_;
      __inner_ = ranges::begin(inner_range);
      __inner_end_ = ranges::end(inner_range);
      if (__inner_ != __inner_end_) {
        return;
      }
      ++__outer_;
    }
    __at_end_ = true;
  }
  constexpr decltype(auto) operator*() const { return *__inner_; }
  constexpr __join_iterator& operator++() {
    ++__inner_;
    if (__inner_ == __inner_end_) {
      ++__outer_;
      __satisfy();
    }
    return *this;
  }
  constexpr void operator++(int) { ++*this; }
  friend constexpr bool operator==(const __join_iterator& a,
                                   const __join_iterator& b) {
    if (a.__at_end_ || b.__at_end_) {
      return a.__at_end_ == b.__at_end_;
    }
    return a.__outer_ == b.__outer_ && a.__inner_ == b.__inner_;
  }
  friend constexpr bool operator!=(const __join_iterator& a,
                                   const __join_iterator& b) {
    return !(a == b);
  }
};

template <view V, class OuterI = iterator_t<V>,
          class OuterS = sentinel_t<V>,
          class InnerRange = remove_reference_t<iter_reference_t<OuterI>>,
          class InnerI = iterator_t<InnerRange>,
          class InnerS = sentinel_t<InnerRange>>
  requires input_range<V> && input_range<InnerRange>
class join_view : public view_interface<
                      join_view<V, OuterI, OuterS, InnerRange, InnerI, InnerS>> {
 private:
  V __base_;

 public:
  using iterator = __join_iterator<OuterI, OuterS, InnerI, InnerS>;
  using sentinel = iterator;
  using const_iterator = iterator;

  join_view() requires default_initializable<V> = default;
  constexpr explicit join_view(V base)
      : __base_(static_cast<V&&>(base)) {}
  static constexpr join_view __make(V base) {
    return join_view(static_cast<V&&>(base));
  }
  constexpr iterator begin() {
    return iterator::__make(ranges::begin(__base_), ranges::end(__base_));
  }
  constexpr iterator end() {
    return iterator::__make(ranges::begin(__base_), ranges::end(__base_),
                            true);
  }
};

// [range.join.with]
template <view V, view Pattern, class OuterI = iterator_t<V>,
          class OuterS = sentinel_t<V>,
          class InnerRange = remove_reference_t<iter_reference_t<OuterI>>,
          class InnerI = iterator_t<InnerRange>,
          class InnerS = sentinel_t<InnerRange>,
          class PatternI = iterator_t<Pattern>,
          class PatternS = sentinel_t<Pattern>>
  requires input_range<V> && input_range<InnerRange> &&
           forward_range<Pattern> &&
           is_reference_v<iter_reference_t<OuterI>>
class join_with_view
    : public view_interface<
          join_with_view<V, Pattern, OuterI, OuterS, InnerRange,
                         InnerI, InnerS, PatternI, PatternS>> {
 private:
  V __base_;
  Pattern __pattern_;

 public:
  class iterator {
   public:
    using iterator_concept = input_iterator_tag;
    using iterator_category = input_iterator_tag;
    using value_type =
        common_type_t<iter_value_t<InnerI>, iter_value_t<PatternI>>;
    using difference_type = ptrdiff_t;
    using reference =
        common_reference_t<iter_reference_t<InnerI>,
                           iter_reference_t<PatternI>>;
    using pointer = void;

   private:
    join_with_view* __parent_ = nullptr;
    OuterI __outer_;
    OuterS __outer_end_;
    InnerI __inner_;
    InnerS __inner_end_;
    PatternI __pattern_;
    PatternS __pattern_end_;
    bool __in_pattern_ = false;
    bool __at_end_ = false;

    constexpr void __set_inner() {
      auto&& inner_range = *__outer_;
      __inner_ = ranges::begin(inner_range);
      __inner_end_ = ranges::end(inner_range);
      __in_pattern_ = false;
    }

    constexpr void __set_pattern() {
      __pattern_ = ranges::begin(__parent_->__pattern_);
      __pattern_end_ = ranges::end(__parent_->__pattern_);
      __in_pattern_ = true;
    }

    constexpr void __satisfy() {
      while (!__at_end_) {
        if (__in_pattern_) {
          if (__pattern_ != __pattern_end_) {
            return;
          }
          __set_inner();
          continue;
        }
        if (__inner_ != __inner_end_) {
          return;
        }
        ++__outer_;
        if (__outer_ == __outer_end_) {
          __at_end_ = true;
          return;
        }
        __set_pattern();
      }
    }

   public:
    iterator() = default;
    constexpr iterator(join_with_view* parent, OuterI outer,
                       OuterS outer_end, bool end_marker = false)
        : __parent_(parent),
          __outer_(static_cast<OuterI&&>(outer)),
          __outer_end_(static_cast<OuterS&&>(outer_end)),
          __at_end_(end_marker || __outer_ == __outer_end_) {
      if (!__at_end_) {
        __set_inner();
        __satisfy();
      }
    }

    constexpr reference operator*() const {
      if (__in_pattern_) {
        return *__pattern_;
      }
      return *__inner_;
    }

    constexpr iterator& operator++() {
      if (__in_pattern_) {
        ++__pattern_;
      } else {
        ++__inner_;
      }
      __satisfy();
      return *this;
    }

    constexpr void operator++(int) { ++*this; }

    friend constexpr bool operator==(const iterator& left,
                                     const iterator& right) {
      if (left.__at_end_ || right.__at_end_) {
        return left.__at_end_ == right.__at_end_;
      }
      if (left.__outer_ != right.__outer_ ||
          left.__in_pattern_ != right.__in_pattern_) {
        return false;
      }
      return left.__in_pattern_
                 ? left.__pattern_ == right.__pattern_
                 : left.__inner_ == right.__inner_;
    }

    friend constexpr bool operator!=(const iterator& left,
                                     const iterator& right) {
      return !(left == right);
    }
  };

  using sentinel = iterator;
  using const_iterator = iterator;

  join_with_view()
    requires default_initializable<V> &&
             default_initializable<Pattern>
  = default;

  constexpr join_with_view(V base, Pattern pattern)
      : __base_(static_cast<V&&>(base)),
        __pattern_(static_cast<Pattern&&>(pattern)) {}

  constexpr iterator begin() {
    return iterator(this, ranges::begin(__base_), ranges::end(__base_));
  }

  constexpr iterator end() {
    return iterator(this, ranges::begin(__base_), ranges::end(__base_), true);
  }
};

// [range.split] A forward split view for the standard single-element pattern.
template <class I, class S, class T>
class __split_iterator {
 public:
  using iterator_concept = input_iterator_tag;
  using iterator_category = input_iterator_tag;
  using value_type = subrange<I, I>;
  using difference_type = iter_difference_t<I>;
  using reference = value_type;
  using pointer = void;

  I __current_;
  S __end_;
  T __pattern_;
  bool __end_marker_ = false;

  __split_iterator() = default;
  constexpr __split_iterator(I current, S end, T pattern,
                             bool end_marker = false)
      : __current_(static_cast<I&&>(current)),
        __end_(static_cast<S&&>(end)),
        __pattern_(static_cast<T&&>(pattern)),
        __end_marker_(end_marker) {}
  static constexpr __split_iterator __make(I current, S end, T pattern,
                                           bool end_marker = false) {
    return __split_iterator(static_cast<I&&>(current),
                            static_cast<S&&>(end),
                            static_cast<T&&>(pattern), end_marker);
  }
  constexpr value_type operator*() const {
    I last = __current_;
    while (last != __end_ && !(*last == __pattern_)) {
      ++last;
    }
    return value_type(__current_, last);
  }
  constexpr __split_iterator& operator++() {
    while (__current_ != __end_ && !(*__current_ == __pattern_)) {
      ++__current_;
    }
    if (__current_ != __end_) {
      ++__current_;
    }
    return *this;
  }
  constexpr void operator++(int) { ++*this; }
  friend constexpr bool operator==(const __split_iterator& a,
                                   const __split_iterator& b) {
    if (b.__end_marker_) {
      return a.__current_ == a.__end_;
    }
    if (a.__end_marker_) {
      return b.__current_ == b.__end_;
    }
    return a.__current_ == b.__current_;
  }
  friend constexpr bool operator!=(const __split_iterator& a,
                                   const __split_iterator& b) {
    return !(a == b);
  }
};

template <view V, class Pattern, class I = iterator_t<V>,
          class S = sentinel_t<V>>
  requires forward_range<V>
class split_view
    : public view_interface<split_view<V, Pattern, I, S>> {
 private:
  V __base_;
  Pattern __pattern_;

 public:
  using iterator = __split_iterator<I, S, Pattern>;
  using sentinel = iterator;
  using const_iterator = iterator;

  split_view() requires default_initializable<V> &&
                        default_initializable<Pattern> = default;
  constexpr split_view(V base, Pattern pattern)
      : __base_(static_cast<V&&>(base)),
        __pattern_(static_cast<Pattern&&>(pattern)) {}
  static constexpr split_view __make(V base, Pattern pattern) {
    return split_view(static_cast<V&&>(base),
                      static_cast<Pattern&&>(pattern));
  }
  constexpr iterator begin() {
    return iterator::__make(ranges::begin(__base_), ranges::end(__base_),
                            __pattern_);
  }
  constexpr iterator end() {
    return iterator::__make(ranges::begin(__base_), ranges::end(__base_),
                            __pattern_, true);
  }
};

template <view V, class Pattern, class I = iterator_t<V>,
          class S = sentinel_t<V>>
using lazy_split_view = split_view<V, Pattern, I, S>;

template <class Val, class CharT = char,
          class Traits = char_traits<CharT>>
class basic_istream_view
    : public view_interface<basic_istream_view<Val, CharT, Traits>> {
 private:
  basic_istream<CharT, Traits>* __stream_ = nullptr;

 public:
  class iterator {
   public:
    using iterator_concept = input_iterator_tag;
    using iterator_category = input_iterator_tag;
    using value_type = Val;
    using difference_type = ptrdiff_t;
    using reference = Val&;
    using pointer = Val*;

    basic_istream<CharT, Traits>* __stream_ = nullptr;
    Val __value_ = Val();

    iterator() = default;
    constexpr explicit iterator(basic_istream<CharT, Traits>* stream)
        : __stream_(stream) {
      ++*this;
    }
    Val& operator*() { return __value_; }
    iterator& operator++() {
      if (__stream_ != nullptr && !(*__stream_ >> __value_)) {
        __stream_ = nullptr;
      }
      return *this;
    }
    void operator++(int) { ++*this; }
    friend bool operator==(const iterator& it, default_sentinel_t) {
      return it.__stream_ == nullptr;
    }
    friend bool operator!=(const iterator& it, default_sentinel_t s) {
      return !(it == s);
    }
  };

  using sentinel = default_sentinel_t;
  using const_iterator = iterator;

  basic_istream_view() = default;
  constexpr explicit basic_istream_view(basic_istream<CharT, Traits>& stream)
      : __stream_(&stream) {}
  iterator begin() { return iterator(__stream_); }
  default_sentinel_t end() const { return default_sentinel; }
};

namespace __detail {
template <class V>
