struct __zip_fn {
  template <class... Ranges>
    requires(sizeof...(Ranges) > 0) && (viewable_range<Ranges> && ...)
  constexpr auto operator()(Ranges&&... ranges) const {
    return zip_view<all_t<Ranges>...>(
        views::all(static_cast<Ranges&&>(ranges))...);
  }
};

struct __cartesian_product_fn {
  constexpr empty_view<tuple<>> operator()() const {
    return empty_view<tuple<>>();
  }

  template <class First, class... Ranges>
    requires viewable_range<First> &&
             (viewable_range<Ranges> && ...)
  constexpr auto operator()(First&& first, Ranges&&... ranges) const {
    return cartesian_product_view<all_t<First>, all_t<Ranges>...>(
        views::all(static_cast<First&&>(first)),
        views::all(static_cast<Ranges&&>(ranges))...);
  }
};

struct __zip_transform_fn {
  template <class F, class... Ranges>
    requires(sizeof...(Ranges) > 0) &&
            (viewable_range<Ranges> && ...) &&
            regular_invocable<decay_t<F>&,
                              range_reference_t<all_t<Ranges>>...>
  constexpr auto operator()(F&& fun, Ranges&&... ranges) const {
    using Fun = decay_t<F>;
    return zip_transform_view<Fun, all_t<Ranges>...>(
        static_cast<F&&>(fun),
        views::all(static_cast<Ranges&&>(ranges))...);
  }
};

