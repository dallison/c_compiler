namespace __rbegin {
template <class T>
void rbegin(T&) = delete;
template <class T>
void rbegin(const T&) = delete;

template <class T>
concept __member_rbegin = requires(T& t) { t.rbegin(); };

template <class T>
concept __adl_rbegin = __access::__class_or_enum<T> &&
                       requires(T& t) { rbegin(t); };

struct __fn {
  template <class T>
    requires __member_rbegin<T>
  constexpr auto operator()(T&& t) const {
    return t.rbegin();
  }

  template <class T>
    requires(!__member_rbegin<T>) && __adl_rbegin<T>
  constexpr auto operator()(T&& t) const {
    return rbegin(t);
  }

  template <class T>
    requires(!__member_rbegin<T>) && (!__adl_rbegin<T>) &&
            requires(T& t) {
              ranges::begin(t);
              ranges::end(t);
            }
  constexpr auto operator()(T&& t) const {
    return reverse_iterator<decltype(ranges::end(t))>(ranges::end(t));
  }
};
