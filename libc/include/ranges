 private:
  V __base_;
  range_difference_t<V> __count_ = 0;

  class __iterator {
   public:
    using I = iterator_t<V>;
    using S = sentinel_t<V>;
    using iterator_concept = input_iterator_tag;
    using iterator_category = input_iterator_tag;
    using value_type = iter_value_t<I>;
    using difference_type = iter_difference_t<I>;
    using reference = iter_reference_t<I>;
    using pointer = void;

    I __current_;
    S __end_;
    difference_type __remaining_ = 0;
    __iterator() = default;
    constexpr __iterator(I current, S end, difference_type count)
        : __current_(static_cast<I&&>(current)),
          __end_(static_cast<S&&>(end)),
          __remaining_(count) {}
    constexpr decltype(auto) operator*() const { return *__current_; }
    constexpr __iterator& operator++() {
      if (__remaining_ > 0 && __current_ != __end_) {
        ++__current_;
        --__remaining_;
      }
      return *this;
    }
    constexpr void operator++(int) { ++*this; }
    friend constexpr bool operator==(const __iterator& a,
                                     const __iterator& b) {
      return a.__current_ == b.__current_;
    }
    friend constexpr bool operator!=(const __iterator& a,
                                     const __iterator& b) {
      return !(a == b);
    }
    friend constexpr bool operator==(const __iterator& i,
                                     default_sentinel_t) {
      return i.__remaining_ <= 0 || i.__current_ == i.__end_;
    }
    friend constexpr bool operator!=(const __iterator& i,
                                     default_sentinel_t s) {
      return !(i == s);
    }
  };

 public:
  take_view() requires default_initializable<V> = default;
  constexpr take_view(V base, range_difference_t<V> count)
      : __base_(static_cast<V&&>(base)), __count_(count) {}
  constexpr auto begin() {
    return __iterator(ranges::begin(__base_), ranges::end(__base_), __count_);
  }
  constexpr default_sentinel_t end() const { return default_sentinel; }
  constexpr auto size()
    requires sized_range<V>
  {
    auto n = ranges::size(__base_);
    return n < static_cast<decltype(n)>(__count_) ? n
                                                  : static_cast<decltype(n)>(
                                                        __count_);
  }
};

template <class V>
constexpr take_view<V> __make_take_view(V base,
                                        range_difference_t<V> count) {
  return take_view<V>(static_cast<V&&>(base), count);
}

// [range.take.while]
template <view V, class Pred>
  requires input_range<V> && is_object_v<Pred>
class take_while_view : public view_interface<take_while_view<V, Pred>> {
 private:
  V __base_;
  __movable_box<Pred> __pred_;

  class __sentinel {
   public:
    sentinel_t<V> __end_;
    Pred* __pred_;
    __sentinel() = default;
    constexpr __sentinel(sentinel_t<V> end, Pred* pred)
        : __end_(static_cast<sentinel_t<V>&&>(end)), __pred_(pred) {}
    friend constexpr bool operator==(const iterator_t<V>& i,
                                     const __sentinel& s) {
      return i == s.__end_ || !(*s.__pred_)(*i);
    }
    friend constexpr bool operator!=(const iterator_t<V>& i,
                                     const __sentinel& s) {
      return !(i == s);
    }
  };

 public:
  take_while_view()
    requires default_initializable<V> && default_initializable<Pred>
  = default;
  constexpr take_while_view(V base, Pred pred)
      : __base_(static_cast<V&&>(base)), __pred_(static_cast<Pred&&>(pred)) {}
  constexpr auto begin() { return ranges::begin(__base_); }
  constexpr auto end() {
    return __sentinel(ranges::end(__base_), &*__pred_);
  }
};

// [range.drop]
template <view V>
  requires input_range<V>
class drop_view : public view_interface<drop_view<V>> {
 private:
  V __base_;
  range_difference_t<V> __count_ = 0;

 public:
  drop_view() requires default_initializable<V> = default;
  constexpr drop_view(V base, range_difference_t<V> count)
      : __base_(static_cast<V&&>(base)), __count_(count) {}
  constexpr auto begin() {
    return ranges::next(ranges::begin(__base_), __count_,
                        ranges::end(__base_));
  }
  constexpr auto end() { return ranges::end(__base_); }
  constexpr auto size()
    requires sized_range<V>
  {
    auto n = ranges::size(__base_);
