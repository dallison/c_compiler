  constexpr auto end() const
    requires range<const V> && copyable<iterator_t<const V>>
  {
    if constexpr (common_range<const V>) {
      return ranges::end(__base_);
    } else {
      using ConstIterator =
          common_iterator<iterator_t<const V>, sentinel_t<const V>>;
      return ConstIterator(ranges::end(__base_));
    }
  }

  constexpr auto size()
    requires sized_range<V>
  {
    return ranges::size(__base_);
  }

  constexpr auto size() const
    requires sized_range<const V>
  {
    return ranges::size(__base_);
  }
};

