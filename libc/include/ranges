               ? 0
               : n - static_cast<decltype(n)>(__count_);
  }
};

// [range.drop.while]
template <view V, class Pred>
  requires input_range<V> && is_object_v<Pred>
class drop_while_view : public view_interface<drop_while_view<V, Pred>> {
 private:
  V __base_;
  __movable_box<Pred> __pred_;

 public:
  drop_while_view()
    requires default_initializable<V> && default_initializable<Pred>
  = default;
  constexpr drop_while_view(V base, Pred pred)
      : __base_(static_cast<V&&>(base)), __pred_(static_cast<Pred&&>(pred)) {}
  constexpr auto begin() {
    auto first = ranges::begin(__base_);
    auto last = ranges::end(__base_);
    auto& pred = *__pred_;
    while (first != last && pred(*first)) {
      ++first;
    }
    return first;
  }
  constexpr auto end() { return ranges::end(__base_); }
};

