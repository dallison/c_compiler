// [range.iota.view] -----------------------------------------------------------
// Signed "difference" type for an iota over W.  For an integral W we use
// ptrdiff_t (wide enough for the value ranges this library produces); for an
// iterator-like W the associated iter_difference_t is used.
template <class W>
using __iota_diff_t =
    conditional_t<(!integral<W>), iter_difference_t<W>, ptrdiff_t>;

template <class W>
concept __iota_decrementable =
    requires(W w) {
      --w;
      w--;
    };

template <class W>
concept __iota_advanceable =
    __iota_decrementable<W> && totally_ordered<W> &&
    requires(W w, __iota_diff_t<W> n) {
      w += n;
      w -= n;
      W(w + n);
      W(n + w);
      W(w - n);
      { w - w } -> convertible_to<__iota_diff_t<W>>;
    };

template <weakly_incrementable W>
class __iota_iterator {
 public:
  using iterator_concept = conditional_t<
      __iota_advanceable<W>, random_access_iterator_tag,
      conditional_t<__iota_decrementable<W>, bidirectional_iterator_tag,
                    conditional_t<incrementable<W>, forward_iterator_tag,
                                  input_iterator_tag>>>;
  using iterator_category = input_iterator_tag;
  using value_type = W;
  using difference_type = __iota_diff_t<W>;
  using pointer = void;
  using reference = W;

  W __value_ = W();

  __iota_iterator() = default;
  constexpr explicit __iota_iterator(W value) : __value_(value) {}
  constexpr W operator*() const { return __value_; }
  constexpr __iota_iterator& operator++() {
    ++__value_;
    return *this;
  }
  constexpr __iota_iterator operator++(int) {
    __iota_iterator copy = *this;
    ++*this;
    return copy;
  }
  constexpr __iota_iterator& operator--()
    requires __iota_decrementable<W>
  {
    --__value_;
    return *this;
  }
  constexpr __iota_iterator operator--(int)
    requires __iota_decrementable<W>
  {
    __iota_iterator copy = *this;
    --*this;
    return copy;
  }
  constexpr __iota_iterator& operator+=(difference_type n)
    requires __iota_advanceable<W>
  {
    __value_ = static_cast<W>(__value_ + n);
    return *this;
  }
  constexpr __iota_iterator& operator-=(difference_type n)
    requires __iota_advanceable<W>
  {
    __value_ = static_cast<W>(__value_ - n);
    return *this;
  }
  constexpr W operator[](difference_type n) const
    requires __iota_advanceable<W>
  {
    return static_cast<W>(__value_ + n);
  }
  friend constexpr bool operator==(const __iota_iterator& a,
                                   const __iota_iterator& b) {
    return a.__value_ == b.__value_;
  }
  friend constexpr bool operator!=(const __iota_iterator& a,
                                   const __iota_iterator& b) {
    return !(a == b);
  }
  friend constexpr __iota_iterator operator+(__iota_iterator i,
                                             difference_type n)
    requires __iota_advanceable<W>
  {
    i += n;
    return i;
  }
  friend constexpr __iota_iterator operator-(__iota_iterator i,
                                             difference_type n)
    requires __iota_advanceable<W>
  {
    i -= n;
    return i;
  }
  friend constexpr difference_type operator-(const __iota_iterator& a,
                                             const __iota_iterator& b)
    requires __iota_advanceable<W>
  {
    return static_cast<difference_type>(a.__value_ - b.__value_);
  }
};

template <class W, class Bound>
class __iota_sentinel {
 public:
  Bound __bound_ = Bound();
  __iota_sentinel() = default;
  constexpr explicit __iota_sentinel(Bound bound) : __bound_(bound) {}
  friend constexpr bool operator==(const __iota_iterator<W>& i,
                                   const __iota_sentinel& s) {
    return i.__value_ == s.__bound_;
  }
  friend constexpr bool operator!=(const __iota_iterator<W>& i,
                                   const __iota_sentinel& s) {
    return !(i == s);
  }
  friend constexpr bool operator==(const __iota_sentinel& s,
                                   const __iota_iterator<W>& i) {
    return i == s;
  }
  friend constexpr bool operator!=(const __iota_sentinel& s,
                                   const __iota_iterator<W>& i) {
    return !(i == s);
  }
};

template <weakly_incrementable W, semiregular Bound = unreachable_sentinel_t>
  requires __weakly_equality_comparable_with<W, Bound> && semiregular<W>
class iota_view : public view_interface<iota_view<W, Bound>> {
 public:
  using iterator = __iota_iterator<W>;
  using const_iterator = iterator;
  using sentinel =
      conditional_t<same_as<Bound, unreachable_sentinel_t>,
                    unreachable_sentinel_t, __iota_sentinel<W, Bound>>;
  using const_sentinel = sentinel;

  struct __iterator {
    friend class iota_view;

    using iterator_concept = conditional_t<
        __iota_advanceable<W>, random_access_iterator_tag,
        conditional_t<__iota_decrementable<W>, bidirectional_iterator_tag,
                      conditional_t<incrementable<W>, forward_iterator_tag,
                                    input_iterator_tag>>>;
    using iterator_category = input_iterator_tag;
    using value_type = W;
    using difference_type = __iota_diff_t<W>;

    W __value_ = W();

    constexpr __iterator() requires default_initializable<W> = default;
    constexpr explicit __iterator(W value) : __value_(value) {}

    constexpr W operator*() const noexcept { return __value_; }

    constexpr __iterator& operator++() {
      ++__value_;
      return *this;
    }
    constexpr __iterator operator++(int) {
      __iterator tmp = *this;
      ++__value_;
      return tmp;
    }

    constexpr __iterator& operator--()
      requires __iota_decrementable<W>
    {
      --__value_;
      return *this;
    }
    constexpr __iterator operator--(int)
      requires __iota_decrementable<W>
    {
      __iterator tmp = *this;
      --__value_;
      return tmp;
    }

    constexpr __iterator& operator+=(difference_type n)
      requires __iota_advanceable<W>
    {
      __value_ = static_cast<W>(__value_ + n);
      return *this;
    }
    constexpr __iterator& operator-=(difference_type n)
      requires __iota_advanceable<W>
    {
      __value_ = static_cast<W>(__value_ - n);
      return *this;
    }
    constexpr W operator[](difference_type n) const
      requires __iota_advanceable<W>
    {
      return static_cast<W>(__value_ + n);
    }

    friend constexpr bool operator==(const __iterator& x, const __iterator& y)
      requires equality_comparable<W>
    {
      return x.__value_ == y.__value_;
    }
    friend constexpr bool operator<(const __iterator& x, const __iterator& y)
      requires totally_ordered<W>
    {
      return x.__value_ < y.__value_;
    }
    friend constexpr bool operator>(const __iterator& x, const __iterator& y)
      requires totally_ordered<W>
    {
      return y < x;
    }
    friend constexpr bool operator<=(const __iterator& x, const __iterator& y)
      requires totally_ordered<W>
    {
      return !(y < x);
    }
    friend constexpr bool operator>=(const __iterator& x, const __iterator& y)
      requires totally_ordered<W>
    {
      return !(x < y);
    }

    friend constexpr __iterator operator+(__iterator i, difference_type n)
      requires __iota_advanceable<W>
    {
      i += n;
      return i;
    }
    friend constexpr __iterator operator+(difference_type n, __iterator i)
      requires __iota_advanceable<W>
    {
      i += n;
      return i;
    }
    friend constexpr __iterator operator-(__iterator i, difference_type n)
      requires __iota_advanceable<W>
    {
      i -= n;
      return i;
    }
    friend constexpr difference_type operator-(const __iterator& x,
                                               const __iterator& y)
      requires __iota_advanceable<W>
    {
      return static_cast<difference_type>(x.__value_) -
             static_cast<difference_type>(y.__value_);
    }
  };

  struct __sentinel {
    friend class iota_view;
    Bound __bound_ = Bound();

    constexpr __sentinel() = default;
    constexpr explicit __sentinel(Bound bound) : __bound_(bound) {}

    friend constexpr bool operator==(const __iterator& x, const __sentinel& y) {
      return x.__value_ == y.__bound_;
    }
    friend constexpr bool operator==(const __sentinel& y, const __iterator& x) {
      return x.__value_ == y.__bound_;
    }
    friend constexpr bool operator!=(const __iterator& x, const __sentinel& y) {
      return !(x.__value_ == y.__bound_);
    }
    friend constexpr bool operator!=(const __sentinel& y, const __iterator& x) {
      return !(x.__value_ == y.__bound_);
    }
  };

 private:
  W __value_ = W();
  Bound __bound_ = Bound();

 public:
  iota_view()
    requires default_initializable<W>
  = default;

  constexpr explicit iota_view(W value) : __value_(value) {}
  constexpr iota_view(type_identity_t<W> value, type_identity_t<Bound> bound)
      : __value_(value), __bound_(bound) {}

  constexpr __iota_iterator<W> begin() const {
    return __iota_iterator<W>(__value_);
  }

  constexpr auto end() const {
    if constexpr (same_as<Bound, unreachable_sentinel_t>) {
      return unreachable_sentinel;
    } else {
      return __iota_sentinel<W, Bound>(__bound_);
    }
  }

  constexpr auto size() const
    requires(integral<W> && integral<Bound>) || sized_sentinel_for<Bound, W>
  {
    return static_cast<size_t>(__bound_ - __value_);
  }
};

template <class W, class Bound>
struct __iterator_type<iota_view<W, Bound>> {
  using type = __iota_iterator<W>;
};

