// [range.common]
template <view V>
  requires(!common_range<V>) && copyable<iterator_t<V>>
class common_view : public view_interface<common_view<V>> {
 private:
  V __base_;

 public:
  using iterator = common_iterator<iterator_t<V>, sentinel_t<V>>;
  using sentinel = iterator;
  using const_iterator = iterator;

  common_view() requires default_initializable<V> = default;
  constexpr explicit common_view(V base)
      : __base_(static_cast<V&&>(base)) {}

  constexpr V base() const&
    requires copy_constructible<V>
  {
    return __base_;
  }

  constexpr V base() && { return static_cast<V&&>(__base_); }

  constexpr iterator begin() {
    return iterator(ranges::begin(__base_));
  }
  constexpr iterator end() { return iterator(ranges::end(__base_)); }

  constexpr auto begin() const
    requires range<const V> && copyable<iterator_t<const V>>
  {
    if constexpr (common_range<const V>) {
      return ranges::begin(__base_);
    } else {
      using ConstIterator =
          common_iterator<iterator_t<const V>, sentinel_t<const V>>;
      return ConstIterator(ranges::begin(__base_));
