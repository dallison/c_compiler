  }
};

template <class I, class S>
constexpr subrange<I, I, subrange_kind::sized> __bounded_subrange(
    I first, S last, iter_difference_t<I> count) {
  I bound = first;
  iter_difference_t<I> remaining =
      ranges::advance(bound, count, last);
  return subrange<I, I, subrange_kind::sized>(
      first, bound, count - remaining);
}

