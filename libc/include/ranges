auto __apply_adaptor(__transform_closure<F>& closure, R&& r) {
  __transform_fn transform_fn;
  return transform_fn(static_cast<R&&>(r), closure.__fun);
}

template <class P>
struct __filter_closure : __adaptor_closure_base {
  P __pred;
  constexpr explicit __filter_closure(P pred)
      : __pred(static_cast<P&&>(pred)) {}
  template <viewable_range R>
  constexpr auto operator()(R&& r) const {
    return filter_view(views::all(static_cast<R&&>(r)), __pred);
  }
};
