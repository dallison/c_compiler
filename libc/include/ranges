          __current_(static_cast<inner_iterator&&>(current)) {}

    constexpr decltype(auto) operator*() const {
      auto values = *__current_;
      return __zip_tuple_invoker<__adjacent_reference_t<V, N>>::__call(
          *__parent_->__fun_, values);
    }

    constexpr iterator& operator++() {
      ++__current_;
      return *this;
    }

    constexpr iterator operator++(int) {
      iterator copy = *this;
      ++*this;
      return copy;
    }

    friend constexpr bool operator==(const iterator& left,
                                     const iterator& right) {
      return left.__current_ == right.__current_;
    }

    friend constexpr bool operator!=(const iterator& left,
                                     const iterator& right) {
      return !(left == right);
    }
  };

  using sentinel = iterator;
  using const_iterator = iterator;

  adjacent_transform_view()
    requires default_initializable<V> && default_initializable<F>
  = default;

  constexpr adjacent_transform_view(V base, F fun)
      : __inner_(static_cast<V&&>(base)),
        __fun_(static_cast<F&&>(fun)) {}

  constexpr iterator begin() {
    return iterator(this, __inner_.begin());
  }

  constexpr iterator end() {
    return iterator(this, __inner_.end());
  }

