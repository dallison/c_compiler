template <class V, class Pred>
  requires view<V> && forward_range<V> && is_object_v<Pred> &&
           indirect_binary_predicate<Pred, iterator_t<V>, iterator_t<V>>
class chunk_by_view : public view_interface<chunk_by_view<V, Pred>> {
 public:
  V __base_;
  __movable_box<Pred> __pred_;

 private:
  constexpr iterator_t<V> __find_next(iterator_t<V> current) {
    sentinel_t<V> last = ranges::end(__base_);
    if (current == last) {
      return current;
    }
    iterator_t<V> next = current;
    ++next;
    while (next != last && (*__pred_)(*current, *next)) {
      current = next;
      ++next;
    }
    return next;
  }

 public:
  class iterator {
   public:
    using base_iterator = iterator_t<V>;
    using base_sentinel = sentinel_t<V>;
    using iterator_concept = forward_iterator_tag;
    using iterator_category = forward_iterator_tag;
    using value_type = subrange<
        base_iterator, base_iterator,
        __subrange_kind_default<base_iterator, base_iterator>::value>;
    using difference_type = range_difference_t<V>;
    using reference = value_type;
    using pointer = void;

   private:
    chunk_by_view* __parent_ = nullptr;
    base_iterator __current_;
    base_iterator __next_;
    base_sentinel __end_;
    bool __end_marker_ = false;

   public:
    iterator() = default;
    constexpr iterator(chunk_by_view* parent, base_iterator current,
                       base_sentinel end, bool end_marker = false)
        : __parent_(parent),
          __current_(current),
          __next_(current),
          __end_(end),
          __end_marker_(end_marker) {
      if (!__end_marker_) {
        __next_ = __parent_->__find_next(__current_);
      }
    }

    constexpr reference operator*() const {
      return reference(__current_, __next_);
    }

    constexpr iterator& operator++() {
      __current_ = __next_;
      __next_ = __parent_->__find_next(__current_);
      return *this;
    }

    constexpr iterator operator++(int) {
      iterator copy = *this;
      ++*this;
      return copy;
    }

    friend constexpr bool operator==(const iterator& left,
                                     const iterator& right) {
      if (left.__end_marker_ && right.__end_marker_) {
        return true;
      }
      if (left.__end_marker_) {
        return right.__current_ == right.__end_;
      }
      if (right.__end_marker_) {
        return left.__current_ == left.__end_;
      }
      return left.__current_ == right.__current_;
    }

    friend constexpr bool operator!=(const iterator& left,
                                     const iterator& right) {
      return !(left == right);
    }
  };

  using sentinel = iterator;
  using const_iterator = iterator;

  chunk_by_view()
    requires default_initializable<V> && default_initializable<Pred>
  = default;

  constexpr chunk_by_view(V base, Pred pred)
      : __base_(static_cast<V&&>(base)),
        __pred_(static_cast<Pred&&>(pred)) {}

  constexpr iterator begin() {
    return iterator(this, ranges::begin(__base_), ranges::end(__base_));
  }

  constexpr iterator end() {
    return iterator(this, ranges::begin(__base_), ranges::end(__base_), true);
  }
};

