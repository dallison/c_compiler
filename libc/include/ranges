    return iterator(ranges::begin(__base_), ranges::end(__base_), __n_, true);
  }

  constexpr auto size()
    requires sized_range<V>
  {
    size_t count = static_cast<size_t>(ranges::size(__base_));
    size_t width = static_cast<size_t>(__n_);
    return count < width ? 0 : count - width + 1;
  }
