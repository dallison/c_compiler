// [range.filter]
template <input_range V, class Pred>
  requires view<V> && is_object_v<Pred> &&
           indirect_unary_predicate<Pred, iterator_t<V>>
class filter_view : public view_interface<filter_view<V, Pred>> {
 public:
  V __base_;
  Pred __pred_;

 private:
  class __iterator {
   public:
    using I = iterator_t<V>;
    using iterator_concept =
        conditional_t<bidirectional_range<V>, bidirectional_iterator_tag,
                      conditional_t<forward_range<V>, forward_iterator_tag,
                                    input_iterator_tag>>;
    using iterator_category = iterator_concept;
    using value_type = iter_value_t<I>;
    using difference_type = iter_difference_t<I>;
    using reference = iter_reference_t<I>;
    using pointer = void;

    filter_view* __parent_ = nullptr;
    I __current_;

    __iterator() = default;
    constexpr __iterator(filter_view* parent, I current)
        : __parent_(parent), __current_(static_cast<I&&>(current)) {}
    constexpr decltype(auto) operator*() const { return *__current_; }
    constexpr __iterator& operator++() {
      sentinel_t<V> last = ranges::end(__parent_->__base_);
      do {
        ++__current_;
      } while (__current_ != last &&
               __parent_->__pred_(*__current_) == false);
      return *this;
    }
    constexpr __iterator operator++(int) {
      __iterator copy = *this;
      ++*this;
      return copy;
    }
    constexpr __iterator& operator--()
      requires bidirectional_range<V>
    {
      do {
        --__current_;
      } while (__parent_->__pred_(*__current_) == false);
      return *this;
    }
    friend constexpr bool operator==(const __iterator& a,
                                     const __iterator& b)
      requires common_range<V>
    {
      return a.__current_ == b.__current_;
    }
  };

  class __sentinel {
   public:
    sentinel_t<V> __end_;
    __sentinel() = default;
    constexpr explicit __sentinel(sentinel_t<V> end)
        : __end_(static_cast<sentinel_t<V>&&>(end)) {}
    friend constexpr bool operator==(const __iterator& i,
                                     const __sentinel& s) {
      return i.__current_ == s.__end_;
    }
    friend constexpr bool operator!=(const __iterator& i,
                                     const __sentinel& s) {
      return !(i == s);
    }
  };

 public:
  filter_view()
    requires default_initializable<V> && default_initializable<Pred>
  = default;
  constexpr filter_view(V base, Pred pred)
      : __base_(static_cast<V&&>(base)), __pred_(static_cast<Pred&&>(pred)) {}

  constexpr auto begin() {
    iterator_t<V> first = ranges::begin(__base_);
    sentinel_t<V> last = ranges::end(__base_);
    while (first != last && __pred_(*first) == false) {
      ++first;
    }
    return __iterator(this, first);
  }
  constexpr auto end() {
    return __sentinel(ranges::end(__base_));
  }
};

template <class R, class Pred>
filter_view(R&&, Pred) -> filter_view<all_t<R>, Pred>;

// [range.take]
template <view V>
  requires input_range<V>
class take_view : public view_interface<take_view<V>> {
 private:
  V __base_;
  range_difference_t<V> __count_ = 0;

  class __iterator {
   public:
    using I = iterator_t<V>;
    using S = sentinel_t<V>;
    using iterator_concept = input_iterator_tag;
    using iterator_category = input_iterator_tag;
    using value_type = iter_value_t<I>;
    using difference_type = iter_difference_t<I>;
    using reference = iter_reference_t<I>;
    using pointer = void;

    I __current_;
    S __end_;
    difference_type __remaining_ = 0;
    __iterator() = default;
    constexpr __iterator(I current, S end, difference_type count)
        : __current_(static_cast<I&&>(current)),
          __end_(static_cast<S&&>(end)),
          __remaining_(count) {}
    constexpr decltype(auto) operator*() const { return *__current_; }
    constexpr __iterator& operator++() {
      if (__remaining_ > 0 && __current_ != __end_) {
        ++__current_;
        --__remaining_;
      }
      return *this;
    }
    constexpr void operator++(int) { ++*this; }
    friend constexpr bool operator==(const __iterator& a,
                                     const __iterator& b) {
      return a.__current_ == b.__current_;
    }
    friend constexpr bool operator!=(const __iterator& a,
                                     const __iterator& b) {
      return !(a == b);
    }
    friend constexpr bool operator==(const __iterator& i,
                                     default_sentinel_t) {
      return i.__remaining_ <= 0 || i.__current_ == i.__end_;
    }
    friend constexpr bool operator!=(const __iterator& i,
                                     default_sentinel_t s) {
      return !(i == s);
    }
  };

 public:
  take_view() requires default_initializable<V> = default;
  constexpr take_view(V base, range_difference_t<V> count)
      : __base_(static_cast<V&&>(base)), __count_(count) {}
  constexpr auto begin() {
    return __iterator(ranges::begin(__base_), ranges::end(__base_), __count_);
  }
  constexpr default_sentinel_t end() const { return default_sentinel; }
  constexpr auto size()
    requires sized_range<V>
  {
    auto n = ranges::size(__base_);
    return n < static_cast<decltype(n)>(__count_) ? n
                                                  : static_cast<decltype(n)>(
                                                        __count_);
  }
};

template <class V>
constexpr take_view<V> __make_take_view(V base,
                                        range_difference_t<V> count) {
  return take_view<V>(static_cast<V&&>(base), count);
}

