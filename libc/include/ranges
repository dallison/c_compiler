// [range.adaptor.object] range adaptor closures + operator| -------------------
namespace __detail {

// Marker base: every range adaptor closure object derives from this so the
// pipe operators below can recognise it.
struct __adaptor_closure_base {};

template <class T>
concept __is_closure =
    derived_from<remove_cvref_t<T>, __adaptor_closure_base>;

// The composition C1 | C2: a closure that applies C1 then C2.
template <class C1, class C2>
struct __pipe_closure : __adaptor_closure_base {
  C1 __c1;
  C2 __c2;
  constexpr __pipe_closure(C1 c1, C2 c2)
      : __c1(static_cast<C1&&>(c1)), __c2(static_cast<C2&&>(c2)) {}
  template <class R>
  constexpr decltype(auto) operator()(R&& r) & {
    return __c2(__c1(static_cast<R&&>(r)));
  }
  template <class R>
  constexpr decltype(auto) operator()(R&& r) const& {
    return __c2(__c1(static_cast<R&&>(r)));
  }
  template <class R>
  constexpr decltype(auto) operator()(R&& r) && {
    return static_cast<C2&&>(__c2)(static_cast<C1&&>(__c1)(static_cast<R&&>(r)));
  }
};

template <class C1, class C2>
  requires __is_closure<C1> && __is_closure<C2>
constexpr auto operator|(C1&& first, C2&& second) {
  return __pipe_closure<decay_t<C1>, decay_t<C2>>(
      static_cast<C1&&>(first), static_cast<C2&&>(second));
}

// The pipe operators live in the same namespace as the adaptor-closure types
// (and their `__adaptor_closure_base`) so that argument-dependent lookup on a
// closure argument -- e.g. `v | views::all` where `views::all` has type
// `__detail::__all_fn` -- reaches them.  ADL only searches a type's own
// (and its bases') namespaces, never the enclosing `ranges` namespace.

}  // namespace __detail

// [range.all] -----------------------------------------------------------------
namespace __detail {

struct __all_fn : __adaptor_closure_base {
  template <class T, size_t N>
  constexpr auto operator()(T (&r)[N]) const {
    return ref_view<T[N]>(r);
  }

  template <class R>
    requires view<remove_cvref_t<R>>
  constexpr remove_cvref_t<R> operator()(R&& r) const {
    return remove_cvref_t<R>(static_cast<R&&>(r));
  }

  template <class R>
    requires range<R> && (!view<R>) && (!is_array_v<R>)
  constexpr ref_view<R> operator()(R& r) const {
    return ref_view<R>(r);
  }

  template <class R>
    requires range<R> && (!view<R>) && (!is_lvalue_reference_v<R>)
  constexpr owning_view<remove_cvref_t<R>> operator()(R&& r) const {
    return owning_view<remove_cvref_t<R>>(static_cast<R&&>(r));
  }
};

}  // namespace __detail

namespace views {
inline constexpr __detail::__all_fn all{};
}  // namespace views

template <viewable_range R>
using all_t = decltype(views::all(declval<R>()));

