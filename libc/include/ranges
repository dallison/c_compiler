  template <viewable_range R, class P>
  constexpr auto operator()(R&& r, P&& p) const {
    return filter_view(views::all(static_cast<R&&>(r)),
                       static_cast<P&&>(p));
  }
  template <class P>
  constexpr auto operator()(P&& p) const {
    return __filter_closure<decay_t<P>>{static_cast<P&&>(p)};
  }
};

struct __take_closure : __adaptor_closure_base {
  ptrdiff_t __count;
  constexpr explicit __take_closure(ptrdiff_t count) : __count(count) {}
  template <view R>
  constexpr auto operator()(R& r) const {
    return __make_take_view<R>(
        R(r), static_cast<range_difference_t<R>>(__count));
  }
  template <range R>
    requires(!view<R>)
  constexpr auto operator()(R& r) const {
    using V = ref_view<R>;
