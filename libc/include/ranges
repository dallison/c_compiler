struct __counted_fn {
  template <input_or_output_iterator I>
  constexpr auto operator()(I first, iter_difference_t<I> count) const {
    I last = first;
    for (iter_difference_t<I> i = 0; i < count; ++i) {
      ++last;
    }
    return subrange<I, I>(first, last);
  }
};

