template <class R, class F>
  requires(!is_lvalue_reference_v<R>) && (!__is_closure<R>)
constexpr transform_view<all_t<R>, F> operator|(
    R&& range, __transform_closure<F>&& closure) {
  using Base = all_t<R>;
  if constexpr (view<remove_cvref_t<R>>) {
    return transform_view<Base, F>(
        static_cast<R&&>(range), static_cast<F&&>(closure.__fun));
  } else {
    return transform_view<Base, F>(
        views::all(static_cast<R&&>(range)),
        static_cast<F&&>(closure.__fun));
  }
}

template <class R, class C>
  requires(!__is_closure<R>) && __is_closure<C>
constexpr auto operator|(R& range, C&& closure) {
  return static_cast<C&&>(closure)(range);
}

