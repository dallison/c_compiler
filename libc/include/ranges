// [range.transform]
template <class I, class S, class IteratorCallable>
class __transform_iterator {
 public:
  using iterator_concept = input_iterator_tag;
  using iterator_category = input_iterator_tag;
  using difference_type = iter_difference_t<I>;
  using reference = decltype(declval<IteratorCallable&>()(*declval<I&>()));
  using value_type = remove_cvref_t<reference>;
  using pointer = void;

  I __current_;
  S __end_;
  IteratorCallable __fun_;
  bool __end_marker_ = false;

  __transform_iterator() = default;
  constexpr __transform_iterator(I current, S end, IteratorCallable fun,
                                 bool end_marker = false)
      : __current_(static_cast<I&&>(current)),
        __end_(static_cast<S&&>(end)),
        __fun_(static_cast<IteratorCallable&&>(fun)),
        __end_marker_(end_marker) {}
  static constexpr __transform_iterator __make(
      I current, S end, IteratorCallable fun, bool end_marker = false) {
    return __transform_iterator(static_cast<I&&>(current),
                                static_cast<S&&>(end),
                                static_cast<IteratorCallable&&>(fun), end_marker);
  }
  constexpr decltype(auto) operator*() const {
    return __fun_(*__current_);
  }
  constexpr __transform_iterator& operator++() {
    ++__current_;
    return *this;
  }
  constexpr __transform_iterator operator++(int) {
    __transform_iterator copy = *this;
    ++*this;
    return copy;
  }
  constexpr __transform_iterator& operator--()
    requires bidirectional_iterator<I>
  {
    --__current_;
    return *this;
  }
  constexpr __transform_iterator& operator+=(difference_type n)
    requires random_access_iterator<I>
  {
    __current_ += n;
    return *this;
  }
  constexpr decltype(auto) operator[](difference_type n) const
    requires random_access_iterator<I>
  {
    return __fun_(__current_[n]);
  }
  friend constexpr bool operator==(const __transform_iterator& a,
                                   const __transform_iterator& b) {
    if (b.__end_marker_) {
      return a.__current_ == b.__end_;
    }
    if (a.__end_marker_) {
      return b.__current_ == a.__end_;
    }
    return a.__current_ == b.__current_;
  }
  friend constexpr bool operator!=(const __transform_iterator& a,
                                   const __transform_iterator& b) {
    return !(a == b);
  }
};

template <input_range V, class TransformFun,
          class BaseIterator = iterator_t<V>,
          class BaseSentinel = sentinel_t<V>>
  requires view<V> && move_constructible<TransformFun> &&
           is_object_v<TransformFun> &&
           regular_invocable<TransformFun&, range_reference_t<V>>
class transform_view
    : public view_interface<
