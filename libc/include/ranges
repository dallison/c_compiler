template <class C, input_range R, class... Args>
constexpr C __to_container(R&& range, Args&&... args) {
  C result = C(static_cast<Args&&>(args)...);
  auto first = ranges::begin(range);
  auto last = ranges::end(range);
  while (first != last) {
    if constexpr (requires(C& container, range_reference_t<R> value) {
                    container.emplace_back(value);
                  }) {
      result.emplace_back(*first);
    } else if constexpr (
        requires(C& container, range_reference_t<R> value) {
          container.push_back(value);
        }) {
      result.push_back(*first);
    } else if constexpr (
        input_range<remove_reference_t<range_reference_t<R>>>) {
      using Inner = typename C::value_type;
      result.emplace_back(
          __to_container<Inner>(*first));
    } else if constexpr (
        requires(C& container, range_reference_t<R> value) {
          container.insert(container.end(), value);
        }) {
      result.insert(result.end(), *first);
    } else {
      result.insert(*first);
    }
    ++first;
  }
  return result;
}

