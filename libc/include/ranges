template <class T>
void end(const T&) = delete;

template <class T, size_t N>
constexpr T* __array_end(T (&value)[N]) {
  return value + N;
}

template <class T>
concept __member_end = requires(T& t) {
  t.end();
};

template <class T>
concept __adl_end = __access::__class_or_enum<T> && requires(T& t) {
  end(t);
};

template <class T, size_t N>
constexpr T* __call(T (&value)[N], int) {
  return value + N;
}

template <class T>
