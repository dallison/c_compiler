template <class T>
class promise {
 public:
  promise() : __state_(make_shared<__future_detail::__state<T>>()) {}
  ~promise() {
    if (__state_) __state_->__break_promise();
  }
  promise(promise&&) noexcept = default;
  promise& operator=(promise&& other) noexcept {
    if (this != &other) {
      if (__state_) __state_->__break_promise();
      __state_ = std::move(other.__state_);
    }
    return *this;
  }
  promise(const promise&) = delete;
  promise& operator=(const promise&) = delete;
  void swap(promise& other) noexcept { __state_.swap(other.__state_); }
  future<T> get_future() {
    __check();
    __state_->__mark_retrieved();
    return future<T>(__state_);
  }
  void set_value(const T& value) {
    __check();
    __state_->__set_value(value);
  }
  void set_value(T&& value) {
    __check();
    __state_->__set_value(std::move(value));
  }
  void set_exception(exception_ptr error) {
    __check();
    __state_->__set_exception(error);
  }

 private:
  void __check() const {
    if (!__state_) __future_detail::__throw(future_errc::no_state);
  }
  shared_ptr<__future_detail::__state<T>> __state_;
};

