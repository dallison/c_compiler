template <class Signature>
class packaged_task;

template <class R, class... Args>
class packaged_task<R(Args...)> {
 public:
  packaged_task() noexcept {}
  template <class Function>
  explicit packaged_task(Function&& function)
      : __function_(std::forward<Function>(function)), __promise_() {}
  packaged_task(packaged_task&&) noexcept = default;
  packaged_task& operator=(packaged_task&&) noexcept = default;
  packaged_task(const packaged_task&) = delete;
  packaged_task& operator=(const packaged_task&) = delete;
  bool valid() const noexcept { return static_cast<bool>(__function_); }
  future<R> get_future() { return __promise_.get_future(); }
  void operator()(Args... args) {
    if (!valid()) __future_detail::__throw(future_errc::no_state);
    __future_detail::__packaged_invoke<R, Args...>::__call(
        __promise_, __function_, std::forward<Args>(args)...);
  }
  void reset() {
    if (!valid()) __future_detail::__throw(future_errc::no_state);
    __promise_ = promise<R>();
  }
  void swap(packaged_task& other) noexcept {
    __function_.swap(other.__function_);
    __promise_.swap(other.__promise_);
  }

 private:
  function<R(Args...)> __function_;
  promise<R> __promise_;
};

template <class R, class... Args>
void swap(packaged_task<R(Args...)>& left,
          packaged_task<R(Args...)>& right) noexcept {
  left.swap(right);
}

namespace __future_detail {

template <class Function, class... Args>
future<__async_result_t<Function, Args...>>
__async(launch policy, Function&& callable, Args&&... args) {
  typedef __future_detail::__async_traits<Function&&, Args&&...> traits;
  typedef typename traits::bound_type bound_type;
  typedef __davecc_invoke_result_t(Function, Args...) result_type;
  shared_ptr<__future_detail::__state<result_type>> state =
      make_shared<__future_detail::__state<result_type>>();
  bound_type bound(std::forward<Function>(callable),
                   std::forward<Args>(args)...);
  typedef __future_detail::__async_operation<result_type, bound_type>
      operation_type;
  operation_type operation(state, std::move(bound));
  if ((policy & launch::async) == launch::async) {
    thread worker(__future_detail::__async_thread_start(
        function<void()>(std::move(operation))));
    worker.detach();
  } else {
    state->__set_deferred(function<void()>(std::move(operation)));
  }
  return future<result_type>::__from_state(state);
}

}  // namespace __future_detail

template <class Function, class... Args>
future<__future_detail::__async_result_t<Function, Args...>>
async(launch policy, Function&& callable, Args&&... args) {
  return __future_detail::__async(
      policy, std::forward<Function>(callable),
      std::forward<Args>(args)...);
}

template <class Function, class... Args>
typename enable_if<
    !is_same<typename decay<Function>::type, launch>::value,
    future<__future_detail::__async_result_t<Function, Args...>>>::type
async(Function&& callable, Args&&... args) {
  return __future_detail::__async(
      __future_default_launch_policy(),
      std::forward<Function>(callable),
      std::forward<Args>(args)...);
}

}  // namespace std

#endif /* __davecc_future__ */
