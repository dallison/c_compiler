template <class RealType, size_t bits, class URBG>
RealType generate_canonical(URBG& gen) {
  static_assert(is_floating_point_v<RealType>);
  const size_t requested =
      bits < static_cast<size_t>(numeric_limits<RealType>::digits)
          ? bits
          : static_cast<size_t>(numeric_limits<RealType>::digits);
  const RealType range =
      static_cast<RealType>(URBG::max()) -
      static_cast<RealType>(URBG::min()) + RealType(1);
  RealType target = 1;
  for (size_t i = 0; i < requested; ++i) target *= RealType(2);
  size_t draws = 1;
  RealType combinations = range;
  while (combinations < target) {
    combinations *= range;
    ++draws;
  }
  RealType sum = 0;
  RealType factor = 1;
  for (size_t i = 0; i < draws; ++i) {
    sum += (static_cast<RealType>(gen()) -
            static_cast<RealType>(URBG::min())) *
           factor;
    factor *= range;
  }
  RealType result = sum / factor;
  return result < RealType(1)
             ? result
             : RealType(1) - numeric_limits<RealType>::epsilon();
}

template <class IntType = int>
class uniform_int_distribution {
 public:
  using result_type = IntType;
  class param_type {
   public:
    using distribution_type = uniform_int_distribution;
    explicit param_type(result_type a = 0,
                        result_type b = numeric_limits<result_type>::max())
        : a_(a), b_(b) {}
    result_type a() const { return a_; }
    result_type b() const { return b_; }
    friend bool operator==(const param_type& x, const param_type& y) {
      return x.a_ == y.a_ && x.b_ == y.b_;
    }
   private:
    result_type a_;
    result_type b_;
  };

  uniform_int_distribution() = default;
  explicit uniform_int_distribution(result_type a,
                                    result_type b =
                                        numeric_limits<result_type>::max())
      : params_(a, b) {}
  explicit uniform_int_distribution(const param_type& p) : params_(p) {}
  void reset() {}
  result_type a() const { return params_.a(); }
  result_type b() const { return params_.b(); }
  param_type param() const { return params_; }
  void param(const param_type& p) { params_ = p; }
  result_type min() const { return a(); }
  result_type max() const { return b(); }

  template <class URBG>
  result_type operator()(URBG& gen) {
    return (*this)(gen, params_);
  }
  template <class URBG>
  result_type operator()(URBG& gen, const param_type& p) {
    using unsigned_type = make_unsigned_t<result_type>;
    const unsigned_type low = static_cast<unsigned_type>(p.a());
    const unsigned_type width =
        static_cast<unsigned_type>(p.b()) - low;
    const unsigned long long span =
        static_cast<unsigned long long>(width) + 1ULL;
    if (span == 0) {
      return static_cast<result_type>(
          static_cast<unsigned_type>(__random_detail::__draw_unsigned(gen)));
    }
    return static_cast<result_type>(static_cast<unsigned_type>(
        low + static_cast<unsigned_type>(
                  __random_detail::__uniform_below(gen, span))));
  }

  friend bool operator==(const uniform_int_distribution& x,
                         const uniform_int_distribution& y) {
    return x.params_ == y.params_;
  }
  friend bool operator!=(const uniform_int_distribution& x,
                         const uniform_int_distribution& y) {
    return !(x == y);
  }
 private:
  param_type params_;

  template <class CharT, class Traits>
  friend basic_ostream<CharT, Traits>& operator<<(
      basic_ostream<CharT, Traits>& output,
      const uniform_int_distribution& distribution) {
    return output << distribution.a() << CharT(' ') << distribution.b();
  }
  template <class CharT, class Traits>
  friend basic_istream<CharT, Traits>& operator>>(
      basic_istream<CharT, Traits>& input,
      uniform_int_distribution& distribution) {
    result_type a = 0;
    result_type b = numeric_limits<result_type>::max();
    input >> a >> b;
    if (input) distribution.params_ = param_type(a, b);
    return input;
  }
};

