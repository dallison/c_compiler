template <class IntType = int>
class poisson_distribution {
 public:
  using result_type = IntType;
  class param_type {
   public:
    using distribution_type = poisson_distribution;
    explicit param_type(double mean = 1.0) : mean_(mean) {}
    double mean() const { return mean_; }
    friend bool operator==(const param_type& x, const param_type& y) {
      return x.mean_ == y.mean_;
    }
   private:
    double mean_;
  };
  poisson_distribution() = default;
  explicit poisson_distribution(double mean) : params_(mean) {}
  explicit poisson_distribution(const param_type& p) : params_(p) {}
  void reset() {}
  double mean() const { return params_.mean(); }
  param_type param() const { return params_; }
  void param(const param_type& p) { params_ = p; }
  result_type min() const { return 0; }
  result_type max() const { return numeric_limits<result_type>::max(); }
  template <class URBG>
  result_type operator()(URBG& gen) { return (*this)(gen, params_); }
  template <class URBG>
  result_type operator()(URBG& gen, const param_type& p) {
    if (p.mean() <= 0.0) return 0;
    if (p.mean() > 64.0) {
      normal_distribution<double> normal(p.mean(), sqrt(p.mean()));
      double value;
      do value = normal(gen); while (value < 0.0);
      return static_cast<result_type>(floor(value + 0.5));
    }
    const double limit = exp(-p.mean());
    double product = 1.0;
    result_type count = 0;
    do {
      ++count;
      product *=
          generate_canonical<double, numeric_limits<double>::digits>(gen);
    } while (product > limit);
    return count - 1;
  }
  friend bool operator==(const poisson_distribution& x,
                         const poisson_distribution& y) {
    return x.params_ == y.params_;
  }
 private:
  param_type params_;

  template <class CharT, class Traits>
  friend basic_ostream<CharT, Traits>& operator<<(
      basic_ostream<CharT, Traits>& output,
