template <class IntType = int>
class discrete_distribution {
 public:
  using result_type = IntType;
  class param_type {
   public:
    using distribution_type = discrete_distribution;
    param_type() : weights_(1, 1.0) {}
    template <class InputIt>
    param_type(InputIt first, InputIt last) {
      for (; first != last; ++first) weights_.push_back(*first);
      if (weights_.empty()) weights_.push_back(1.0);
    }
    param_type(initializer_list<double> values)
        : param_type(values.begin(), values.end()) {}
    template <class UnaryOperation>
    param_type(size_t count, double xmin, double xmax, UnaryOperation fw) {
      if (count == 0) {
        weights_.push_back(1.0);
      } else {
        const double delta = (xmax - xmin) / count;
        for (size_t i = 0; i < count; ++i)
          weights_.push_back(fw(xmin + (i + 0.5) * delta));
      }
    }
    vector<double> probabilities() const {
      vector<double> result(weights_);
      double sum = 0;
      for (double value : result) sum += value;
      if (sum == 0) {
        const double p = 1.0 / result.size();
        for (double& value : result) value = p;
      } else {
        for (double& value : result) value /= sum;
      }
      return result;
    }
    friend bool operator==(const param_type& x, const param_type& y) {
      return x.weights_ == y.weights_;
    }
   private:
    vector<double> weights_;
    friend class discrete_distribution;
  };
  discrete_distribution() = default;
  template <class InputIt>
  discrete_distribution(InputIt first, InputIt last) : params_(first, last) {}
  discrete_distribution(initializer_list<double> values) : params_(values) {}
  template <class UnaryOperation>
  discrete_distribution(size_t count, double xmin, double xmax,
                        UnaryOperation fw)
      : params_(count, xmin, xmax, fw) {}
  explicit discrete_distribution(const param_type& p) : params_(p) {}
  void reset() {}
  vector<double> probabilities() const { return params_.probabilities(); }
  param_type param() const { return params_; }
  void param(const param_type& p) { params_ = p; }
  result_type min() const { return 0; }
  result_type max() const {
    return static_cast<result_type>(params_.weights_.size() - 1);
  }
  template <class URBG>
  result_type operator()(URBG& gen) { return (*this)(gen, params_); }
  template <class URBG>
  result_type operator()(URBG& gen, const param_type& p) {
    vector<double> probabilities = p.probabilities();
    const double value =
        generate_canonical<double, numeric_limits<double>::digits>(gen);
    double cumulative = 0;
    for (size_t i = 0; i + 1 < probabilities.size(); ++i) {
      cumulative += probabilities[i];
      if (value < cumulative) return static_cast<result_type>(i);
    }
    return static_cast<result_type>(probabilities.size() - 1);
  }
  friend bool operator==(const discrete_distribution& x,
                         const discrete_distribution& y) {
    return x.params_ == y.params_;
  }
 private:
  param_type params_;

  template <class CharT, class Traits>
  friend basic_ostream<CharT, Traits>& operator<<(
      basic_ostream<CharT, Traits>& output,
      const discrete_distribution& distribution) {
    vector<double> values = distribution.probabilities();
    output << values.size();
    for (double value : values) output << CharT(' ') << value;
    return output;
  }
  template <class CharT, class Traits>
  friend basic_istream<CharT, Traits>& operator>>(
      basic_istream<CharT, Traits>& input,
      discrete_distribution& distribution) {
    size_t count = 0;
    input >> count;
    vector<double> values(count);
    for (size_t i = 0; i < count; ++i) input >> values[i];
    if (input) {
      distribution.params_ = param_type(values.begin(), values.end());
    }
    return input;
  }
};

template <class RealType = double>
class piecewise_constant_distribution {
 public:
  using result_type = RealType;
  class param_type {
   public:
    using distribution_type = piecewise_constant_distribution;
    param_type() : intervals_{0.0, 1.0}, weights_{1.0} {}
    template <class BoundaryIt, class WeightIt>
    param_type(BoundaryIt first_b, BoundaryIt last_b, WeightIt first_w) {
      for (; first_b != last_b; ++first_b) intervals_.push_back(*first_b);
      if (intervals_.size() < 2) intervals_ = vector<double>{0.0, 1.0};
      for (size_t i = 1; i < intervals_.size(); ++i)
        weights_.push_back(*first_w++);
    }
    template <class UnaryOperation>
    param_type(initializer_list<double> boundaries, UnaryOperation fw) {
      for (double value : boundaries) intervals_.push_back(value);
      if (intervals_.size() < 2) intervals_ = vector<double>{0.0, 1.0};
      for (size_t i = 0; i + 1 < intervals_.size(); ++i)
        weights_.push_back(
            fw((intervals_[i] + intervals_[i + 1]) * 0.5));
    }
    template <class UnaryOperation>
    param_type(size_t count, double xmin, double xmax, UnaryOperation fw) {
      if (count == 0) {
        intervals_ = vector<double>{0.0, 1.0};
        weights_ = vector<double>{1.0};
      } else {
        const double width = (xmax - xmin) / count;
        for (size_t i = 0; i <= count; ++i)
          intervals_.push_back(xmin + i * width);
        for (size_t i = 0; i < count; ++i)
          weights_.push_back(fw(xmin + (i + 0.5) * width));
      }
    }
    vector<double> intervals() const { return intervals_; }
    vector<double> densities() const {
      vector<double> result(weights_);
      double area = 0;
      for (size_t i = 0; i < result.size(); ++i)
        area += result[i] * (intervals_[i + 1] - intervals_[i]);
      for (double& value : result) value /= area;
      return result;
    }
    friend bool operator==(const param_type& x, const param_type& y) {
      return x.intervals_ == y.intervals_ && x.weights_ == y.weights_;
    }
   private:
    vector<double> intervals_;
    vector<double> weights_;
    friend class piecewise_constant_distribution;
  };
  piecewise_constant_distribution() = default;
  template <class BoundaryIt, class WeightIt>
  piecewise_constant_distribution(BoundaryIt first_b, BoundaryIt last_b,
                                  WeightIt first_w)
      : params_(first_b, last_b, first_w) {}
  template <class UnaryOperation>
  piecewise_constant_distribution(initializer_list<double> boundaries,
                                  UnaryOperation fw)
      : params_(boundaries, fw) {}
  template <class UnaryOperation>
  piecewise_constant_distribution(size_t count, double xmin, double xmax,
                                  UnaryOperation fw)
      : params_(count, xmin, xmax, fw) {}
  explicit piecewise_constant_distribution(const param_type& p) : params_(p) {}
  void reset() {}
  vector<double> intervals() const { return params_.intervals(); }
  vector<double> densities() const { return params_.densities(); }
  param_type param() const { return params_; }
  void param(const param_type& p) { params_ = p; }
  result_type min() const { return params_.intervals_.front(); }
  result_type max() const { return params_.intervals_.back(); }
  template <class URBG>
  result_type operator()(URBG& gen) { return (*this)(gen, params_); }
  template <class URBG>
  result_type operator()(URBG& gen, const param_type& p) {
    vector<double> masses;
    for (size_t i = 0; i < p.weights_.size(); ++i)
      masses.push_back(p.weights_[i] *
                       (p.intervals_[i + 1] - p.intervals_[i]));
    discrete_distribution<size_t> choose(masses.begin(), masses.end());
    const size_t i = choose(gen);
    uniform_real_distribution<result_type> within(
        static_cast<result_type>(p.intervals_[i]),
        static_cast<result_type>(p.intervals_[i + 1]));
    return within(gen);
  }
  friend bool operator==(const piecewise_constant_distribution& x,
                         const piecewise_constant_distribution& y) {
    return x.params_ == y.params_;
  }
 private:
  param_type params_;

  template <class CharT, class Traits>
  friend basic_ostream<CharT, Traits>& operator<<(
      basic_ostream<CharT, Traits>& output,
      const piecewise_constant_distribution& distribution) {
    vector<double> intervals = distribution.intervals();
    vector<double> densities = distribution.densities();
    output << intervals.size();
    for (double value : intervals) output << CharT(' ') << value;
    for (double value : densities) output << CharT(' ') << value;
    return output;
  }
  template <class CharT, class Traits>
  friend basic_istream<CharT, Traits>& operator>>(
      basic_istream<CharT, Traits>& input,
      piecewise_constant_distribution& distribution) {
    size_t count = 0;
    input >> count;
    vector<double> intervals(count);
    vector<double> densities(count > 0 ? count - 1 : 0);
    for (size_t i = 0; i < intervals.size(); ++i) input >> intervals[i];
    for (size_t i = 0; i < densities.size(); ++i) input >> densities[i];
    if (input && intervals.size() >= 2) {
      distribution.params_ =
          param_type(intervals.begin(), intervals.end(), densities.begin());
    }
    return input;
  }
};

template <class RealType = double>
class piecewise_linear_distribution {
 public:
  using result_type = RealType;
  class param_type {
   public:
    using distribution_type = piecewise_linear_distribution;
    param_type() : intervals_{0.0, 1.0}, weights_{1.0, 1.0} {}
    template <class BoundaryIt, class WeightIt>
    param_type(BoundaryIt first_b, BoundaryIt last_b, WeightIt first_w) {
      for (; first_b != last_b; ++first_b) intervals_.push_back(*first_b);
      if (intervals_.size() < 2) intervals_ = vector<double>{0.0, 1.0};
      for (size_t i = 0; i < intervals_.size(); ++i)
        weights_.push_back(*first_w++);
    }
    template <class UnaryOperation>
    param_type(initializer_list<double> boundaries, UnaryOperation fw) {
      for (double value : boundaries) intervals_.push_back(value);
      if (intervals_.size() < 2) intervals_ = vector<double>{0.0, 1.0};
      for (size_t i = 0; i < intervals_.size(); ++i)
        weights_.push_back(fw(intervals_[i]));
    }
    template <class UnaryOperation>
    param_type(size_t count, double xmin, double xmax, UnaryOperation fw) {
      if (count == 0) {
        intervals_ = vector<double>{0.0, 1.0};
        weights_ = vector<double>{1.0, 1.0};
      } else {
        const double width = (xmax - xmin) / count;
        for (size_t i = 0; i <= count; ++i) {
          const double value = xmin + i * width;
          intervals_.push_back(value);
          weights_.push_back(fw(value));
        }
      }
    }
    vector<double> intervals() const { return intervals_; }
    vector<double> densities() const {
      vector<double> result(weights_);
      double area = 0;
      for (size_t i = 0; i + 1 < result.size(); ++i)
        area += 0.5 * (result[i] + result[i + 1]) *
                (intervals_[i + 1] - intervals_[i]);
      for (double& value : result) value /= area;
      return result;
    }
    friend bool operator==(const param_type& x, const param_type& y) {
      return x.intervals_ == y.intervals_ && x.weights_ == y.weights_;
    }
   private:
    vector<double> intervals_;
    vector<double> weights_;
    friend class piecewise_linear_distribution;
  };
  piecewise_linear_distribution() = default;
  template <class BoundaryIt, class WeightIt>
  piecewise_linear_distribution(BoundaryIt first_b, BoundaryIt last_b,
                                WeightIt first_w)
      : params_(first_b, last_b, first_w) {}
  template <class UnaryOperation>
  piecewise_linear_distribution(initializer_list<double> boundaries,
                                UnaryOperation fw)
      : params_(boundaries, fw) {}
  template <class UnaryOperation>
  piecewise_linear_distribution(size_t count, double xmin, double xmax,
                                UnaryOperation fw)
      : params_(count, xmin, xmax, fw) {}
  explicit piecewise_linear_distribution(const param_type& p) : params_(p) {}
  void reset() {}
  vector<double> intervals() const { return params_.intervals(); }
  vector<double> densities() const { return params_.densities(); }
  param_type param() const { return params_; }
  void param(const param_type& p) { params_ = p; }
  result_type min() const { return params_.intervals_.front(); }
  result_type max() const { return params_.intervals_.back(); }
  template <class URBG>
  result_type operator()(URBG& gen) { return (*this)(gen, params_); }
  template <class URBG>
  result_type operator()(URBG& gen, const param_type& p) {
    vector<double> masses;
    for (size_t i = 0; i + 1 < p.weights_.size(); ++i)
      masses.push_back(0.5 * (p.weights_[i] + p.weights_[i + 1]) *
                       (p.intervals_[i + 1] - p.intervals_[i]));
    discrete_distribution<size_t> choose(masses.begin(), masses.end());
    const size_t i = choose(gen);
    const double width = p.intervals_[i + 1] - p.intervals_[i];
    const double left = p.weights_[i];
    const double slope = p.weights_[i + 1] - left;
    const double mass = masses[i];
    const double target =
        generate_canonical<double, numeric_limits<double>::digits>(gen) * mass;
    double offset;
    if (slope == 0.0) {
      offset = target / left;
    } else {
      offset = width * (sqrt(left * left + 2.0 * slope * target / width) -
                        left) /
               slope;
    }
    return static_cast<result_type>(p.intervals_[i] + offset);
  }
  friend bool operator==(const piecewise_linear_distribution& x,
                         const piecewise_linear_distribution& y) {
    return x.params_ == y.params_;
  }
 private:
  param_type params_;

  template <class CharT, class Traits>
  friend basic_ostream<CharT, Traits>& operator<<(
      basic_ostream<CharT, Traits>& output,
      const piecewise_linear_distribution& distribution) {
    vector<double> intervals = distribution.intervals();
    vector<double> densities = distribution.densities();
    output << intervals.size();
    for (double value : intervals) output << CharT(' ') << value;
    for (double value : densities) output << CharT(' ') << value;
    return output;
  }
  template <class CharT, class Traits>
  friend basic_istream<CharT, Traits>& operator>>(
      basic_istream<CharT, Traits>& input,
      piecewise_linear_distribution& distribution) {
    size_t count = 0;
    input >> count;
    vector<double> intervals(count);
    vector<double> densities(count);
    for (size_t i = 0; i < intervals.size(); ++i) input >> intervals[i];
    for (size_t i = 0; i < densities.size(); ++i) input >> densities[i];
    if (input && intervals.size() >= 2) {
      distribution.params_ =
          param_type(intervals.begin(), intervals.end(), densities.begin());
    }
    return input;
  }
};

