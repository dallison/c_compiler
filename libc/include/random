template <class RealType = double>
class gamma_distribution {
 public:
  using result_type = RealType;
  class param_type {
   public:
    using distribution_type = gamma_distribution;
    explicit param_type(result_type alpha = 1, result_type beta = 1)
        : alpha_(alpha), beta_(beta) {}
    result_type alpha() const { return alpha_; }
    result_type beta() const { return beta_; }
    friend bool operator==(const param_type& x, const param_type& y) {
      return x.alpha_ == y.alpha_ && x.beta_ == y.beta_;
    }
   private:
    result_type alpha_;
    result_type beta_;
  };
  gamma_distribution() = default;
  explicit gamma_distribution(result_type alpha, result_type beta = 1)
      : params_(alpha, beta) {}
  explicit gamma_distribution(const param_type& p) : params_(p) {}
  void reset() {}
  result_type alpha() const { return params_.alpha(); }
  result_type beta() const { return params_.beta(); }
  param_type param() const { return params_; }
  void param(const param_type& p) { params_ = p; }
  result_type min() const { return 0; }
  result_type max() const { return numeric_limits<result_type>::infinity(); }
  template <class URBG>
  result_type operator()(URBG& gen) { return (*this)(gen, params_); }
  template <class URBG>
  result_type operator()(URBG& gen, const param_type& p) {
    result_type alpha = p.alpha();
    if (alpha < result_type(1)) {
      result_type u =
          generate_canonical<result_type,
                             numeric_limits<result_type>::digits>(gen);
      param_type shifted(alpha + result_type(1), p.beta());
      return (*this)(gen, shifted) * pow(u, result_type(1) / alpha);
    }
    const result_type d = alpha - result_type(1) / result_type(3);
    const result_type c = result_type(1) / sqrt(result_type(9) * d);
    normal_distribution<result_type> normal;
    for (;;) {
      const result_type x = normal(gen);
      result_type v = result_type(1) + c * x;
      if (v <= 0) continue;
      v = v * v * v;
      const result_type u =
          generate_canonical<result_type,
                             numeric_limits<result_type>::digits>(gen);
      if (u < result_type(1) - result_type(0.0331) * x * x * x * x ||
          log(u) < result_type(0.5) * x * x +
                       d * (result_type(1) - v + log(v))) {
        return p.beta() * d * v;
      }
    }
  }
  friend bool operator==(const gamma_distribution& x,
                         const gamma_distribution& y) {
    return x.params_ == y.params_;
  }
 private:
  param_type params_;

  template <class CharT, class Traits>
  friend basic_ostream<CharT, Traits>& operator<<(
      basic_ostream<CharT, Traits>& output,
      const gamma_distribution& distribution) {
    return output << distribution.alpha() << CharT(' ')
                  << distribution.beta();
  }
  template <class CharT, class Traits>
  friend basic_istream<CharT, Traits>& operator>>(
      basic_istream<CharT, Traits>& input,
      gamma_distribution& distribution) {
    result_type alpha = 1;
    result_type beta = 1;
    input >> alpha >> beta;
    if (input) distribution.params_ = param_type(alpha, beta);
    return input;
  }
};

