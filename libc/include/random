template <class RealType = double>
class normal_distribution {
 public:
  using result_type = RealType;
  class param_type {
   public:
    using distribution_type = normal_distribution;
    explicit param_type(result_type mean = 0, result_type stddev = 1)
        : mean_(mean), stddev_(stddev) {}
    result_type mean() const { return mean_; }
    result_type stddev() const { return stddev_; }
    friend bool operator==(const param_type& x, const param_type& y) {
      return x.mean_ == y.mean_ && x.stddev_ == y.stddev_;
    }
   private:
    result_type mean_;
    result_type stddev_;
  };
  normal_distribution() = default;
  explicit normal_distribution(result_type mean, result_type stddev = 1)
      : params_(mean, stddev) {}
  explicit normal_distribution(const param_type& p) : params_(p) {}
  void reset() { saved_ = false; }
  result_type mean() const { return params_.mean(); }
  result_type stddev() const { return params_.stddev(); }
  param_type param() const { return params_; }
  void param(const param_type& p) { params_ = p; }
  result_type min() const { return -numeric_limits<result_type>::infinity(); }
  result_type max() const { return numeric_limits<result_type>::infinity(); }
  template <class URBG>
  result_type operator()(URBG& gen) { return (*this)(gen, params_); }
  template <class URBG>
  result_type operator()(URBG& gen, const param_type& p) {
    if (saved_) {
      saved_ = false;
      return p.mean() + p.stddev() * saved_value_;
    }
    double x;
    double y;
    double radius;
    do {
      x = 2.0 * generate_canonical<double,
                                   numeric_limits<double>::digits>(gen) -
          1.0;
      y = 2.0 * generate_canonical<double,
                                   numeric_limits<double>::digits>(gen) -
          1.0;
      radius = x * x + y * y;
    } while (radius <= 0.0 || radius >= 1.0);
    const double scale = sqrt(-2.0 * log(radius) / radius);
    saved_value_ = static_cast<result_type>(y * scale);
    saved_ = true;
    return static_cast<result_type>(p.mean() + p.stddev() * x * scale);
  }
  friend bool operator==(const normal_distribution& x,
                         const normal_distribution& y) {
    return x.params_ == y.params_ && x.saved_ == y.saved_ &&
           (!x.saved_ || x.saved_value_ == y.saved_value_);
  }
 private:
  param_type params_;
  bool saved_ = false;
  result_type saved_value_ = 0;

  template <class CharT, class Traits>
  friend basic_ostream<CharT, Traits>& operator<<(
      basic_ostream<CharT, Traits>& output,
      const normal_distribution& distribution) {
    __random_detail::__stream_precision_guard<basic_ostream<CharT, Traits>>
        precision(output, numeric_limits<result_type>::max_digits10);
    return output << distribution.mean() << CharT(' ')
                  << distribution.stddev() << CharT(' ')
                  << distribution.saved_ << CharT(' ')
                  << distribution.saved_value_;
  }
  template <class CharT, class Traits>
  friend basic_istream<CharT, Traits>& operator>>(
      basic_istream<CharT, Traits>& input,
      normal_distribution& distribution) {
    result_type mean = 0;
    result_type stddev = 1;
    bool saved = false;
    result_type saved_value = 0;
    input >> mean >> stddev >> saved >> saved_value;
    if (input) {
      distribution.params_ = param_type(mean, stddev);
      distribution.saved_ = saved;
      distribution.saved_value_ = saved_value;
    }
    return input;
  }
};

