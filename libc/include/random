template <class G>
concept uniform_random_bit_generator =
    requires(G& g) {
      { g() } -> unsigned_integral;
    } &&
    requires {
      G::min();
      G::max();
    } &&
    (G::min() < G::max());

namespace __random_detail {

template <class Stream>
class __stream_precision_guard {
 public:
  __stream_precision_guard(Stream& stream, streamsize precision)
      : stream_(stream), precision_(stream.precision(precision)) {}
  ~__stream_precision_guard() { stream_.precision(precision_); }

 private:
  Stream& stream_;
  streamsize precision_;
};

template <class UInt>
constexpr UInt __mask_bits(size_t bits) {
  constexpr size_t width = sizeof(UInt) * 8;
  if (bits >= width) return static_cast<UInt>(~UInt(0));
  return static_cast<UInt>((UInt(1) << bits) - UInt(1));
}

template <class UInt>
constexpr UInt __add_mod(UInt a, UInt b, UInt modulus) {
  if (modulus == 0) return static_cast<UInt>(a + b);
  a %= modulus;
  b %= modulus;
  return a >= modulus - b ? static_cast<UInt>(a - (modulus - b))
                          : static_cast<UInt>(a + b);
}

template <class UInt>
constexpr UInt __multiply_mod(UInt a, UInt b, UInt modulus) {
  if (modulus == 0) return static_cast<UInt>(a * b);
  if constexpr (sizeof(UInt) <= 4) {
    return static_cast<UInt>(
        (static_cast<unsigned long long>(a) *
         static_cast<unsigned long long>(b)) %
        modulus);
  } else {
    UInt result = 0;
    a %= modulus;
    while (b != 0) {
      if ((b & 1) != 0) result = __add_mod(result, a, modulus);
      b >>= 1;
      if (b != 0) a = __add_mod(a, a, modulus);
    }
    return result;
  }
}

template <class UInt>
constexpr UInt __linear_step(UInt value, UInt multiplier, UInt increment,
                             UInt modulus) {
  return __add_mod(__multiply_mod(value, multiplier, modulus), increment,
                   modulus);
}

constexpr size_t __ceil_div(size_t a, size_t b) {
  return a / b + (a % b != 0 ? 1 : 0);
}

}  // namespace __random_detail

class seed_seq {
 private:
  vector<uint_least32_t> seeds_;

 public:
  using result_type = uint_least32_t;

  seed_seq() noexcept = default;

  template <class InputIt>
  seed_seq(InputIt first, InputIt last) {
    for (; first != last; ++first) {
      seeds_.push_back(static_cast<result_type>(*first));
    }
  }

  seed_seq(initializer_list<result_type> values)
      : seed_seq(values.begin(), values.end()) {}

  seed_seq(const seed_seq&) = delete;
  seed_seq& operator=(const seed_seq&) = delete;

  template <class RandomIt>
  void generate(RandomIt first, RandomIt last) {
    using output_type = typename iterator_traits<RandomIt>::value_type;
    const size_t n = static_cast<size_t>(last - first);
    if (n == 0) return;
    for (size_t i = 0; i < n; ++i) {
      first[i] = static_cast<output_type>(0x8b8b8b8bU);
    }

    const size_t s = seeds_.size();
    const size_t t = n >= 623 ? 11
                     : n >= 68 ? 7
                     : n >= 39 ? 5
                     : n >= 7  ? 3
                               : (n - 1) / 2;
    const size_t p = (n - t) / 2;
    const size_t q = p + t;
    const size_t m = s + 1 > n ? s + 1 : n;

    result_type r1 =
        1664525U * static_cast<result_type>(
                       first[0] ^ first[p % n] ^ first[q % n]);
    result_type r2 = r1 + static_cast<result_type>(s);
    first[p % n] = static_cast<output_type>(first[p % n] + r1);
    first[q % n] = static_cast<output_type>(first[q % n] + r2);
    first[0] = static_cast<output_type>(r2);

    for (size_t k = 1; k < m; ++k) {
      const size_t kn = k % n;
      const size_t kpn = (k + p) % n;
      const size_t kqn = (k + q) % n;
      const size_t km1 = (k - 1) % n;
      r1 = 1664525U * static_cast<result_type>(
                              first[kn] ^ first[kpn] ^ first[km1]);
      const result_type seed =
          k <= s ? seeds_[k - 1] : static_cast<result_type>(0);
      r2 = r1 + static_cast<result_type>(k) + seed;
      first[kpn] = static_cast<output_type>(first[kpn] + r1);
      first[kqn] = static_cast<output_type>(first[kqn] + r2);
      first[kn] = static_cast<output_type>(r2);
    }

    for (size_t k = m; k < m + n; ++k) {
      const size_t kn = k % n;
      const size_t kpn = (k + p) % n;
      const size_t kqn = (k + q) % n;
      const size_t km1 = (k - 1) % n;
      const result_type value_n = static_cast<result_type>(first[kn]);
      const result_type value_p = static_cast<result_type>(first[kpn]);
      const result_type value_previous =
          static_cast<result_type>(first[km1]);
      const result_type r3 =
          1566083941U *
          static_cast<result_type>(value_n + value_p + value_previous);
      const result_type r4 = r3 - static_cast<result_type>(kn);
      first[kpn] = static_cast<output_type>(first[kpn] ^ r3);
      first[kqn] = static_cast<output_type>(first[kqn] ^ r4);
      first[kn] = static_cast<output_type>(r4);
    }
  }

  size_t size() const noexcept { return seeds_.size(); }

  template <class OutputIt>
  void param(OutputIt dest) const {
    for (result_type value : seeds_) {
      *dest++ = value;
    }
  }

};

template <class UIntType, UIntType a, UIntType c, UIntType m>
class linear_congruential_engine {
  static_assert(is_unsigned_v<UIntType>);
  static_assert(m == 0 || (a < m && c < m));

 public:
  using result_type = UIntType;

  static constexpr result_type multiplier = a;
  static constexpr result_type increment = c;
  static constexpr result_type modulus = m;
  static constexpr result_type default_seed = 1U;

  linear_congruential_engine() : linear_congruential_engine(default_seed) {}
  explicit linear_congruential_engine(result_type value) { seed(value); }

  template <class SeedSeq>
  explicit linear_congruential_engine(SeedSeq& seq) {
    seed(seq);
  }

  void seed(result_type value = default_seed) {
    if constexpr (m != 0) value %= m;
    state_ = c == 0 && value == 0 ? result_type(1) : value;
  }

  template <class SeedSeq>
  void seed(SeedSeq& seq) {
    uint_least32_t words[4] = {};
    seq.generate(words, words + __random_detail::__ceil_div(
                                      sizeof(result_type) * 8, size_t(32)));
    result_type value = 0;
    const size_t count =
        __random_detail::__ceil_div(sizeof(result_type) * 8, size_t(32));
    for (size_t i = 0; i < count; ++i) {
      value = static_cast<result_type>(
          value | (static_cast<result_type>(words[i])
                   << static_cast<int>(i * 32)));
    }
    seed(value);
  }

  static constexpr result_type min() {
    return c == 0 ? result_type(1) : result_type(0);
  }
  static constexpr result_type max() {
    return m == 0 ? numeric_limits<result_type>::max()
                  : static_cast<result_type>(m - 1);
  }

  result_type operator()() {
    state_ =
        __random_detail::__linear_step<result_type>(state_, a, c, m);
    return state_;
  }

  void discard(unsigned long long count) {
    while (count-- != 0) {
      static_cast<void>((*this)());
    }
  }

  friend bool operator==(const linear_congruential_engine& lhs,
                         const linear_congruential_engine& rhs) {
    return lhs.state_ == rhs.state_;
  }

  friend bool operator!=(const linear_congruential_engine& lhs,
                         const linear_congruential_engine& rhs) {
    return !(lhs == rhs);
  }

 private:
  result_type state_ = default_seed;

  template <class CharT, class Traits>
  friend basic_ostream<CharT, Traits>& operator<<(
      basic_ostream<CharT, Traits>& output,
      const linear_congruential_engine& engine) {
    return output << engine.state_;
  }
  template <class CharT, class Traits>
  friend basic_istream<CharT, Traits>& operator>>(
      basic_istream<CharT, Traits>& input,
      linear_congruential_engine& engine) {
    result_type state = 0;
    if (input >> state) engine.state_ = state;
    return input;
  }
};

template <class UIntType, size_t w, size_t n, size_t m, size_t r, UIntType a,
          size_t u, UIntType d, size_t s, UIntType b, size_t t, UIntType c,
          size_t l, UIntType f>
class mersenne_twister_engine {
  static_assert(is_unsigned_v<UIntType>);
  static_assert(0 < m && m <= n && 0 < r && r <= w);
  static_assert(w <= sizeof(UIntType) * 8);

 public:
  using result_type = UIntType;

  static constexpr size_t word_size = w;
  static constexpr size_t state_size = n;
  static constexpr size_t shift_size = m;
  static constexpr size_t mask_bits = r;
  static constexpr result_type xor_mask = a;
  static constexpr size_t tempering_u = u;
  static constexpr result_type tempering_d = d;
  static constexpr size_t tempering_s = s;
  static constexpr result_type tempering_b = b;
  static constexpr size_t tempering_t = t;
  static constexpr result_type tempering_c = c;
  static constexpr size_t tempering_l = l;
  static constexpr result_type initialization_multiplier = f;
  static constexpr result_type default_seed = 5489U;

  mersenne_twister_engine() : mersenne_twister_engine(default_seed) {}
  explicit mersenne_twister_engine(result_type value) { seed(value); }

  template <class SeedSeq>
  explicit mersenne_twister_engine(SeedSeq& seq) {
    seed(seq);
  }

  void seed(result_type value = default_seed) {
    state_[0] = value & __word_mask();
    for (size_t i = 1; i < n; ++i) {
      state_[i] = static_cast<result_type>(
          f * (state_[i - 1] ^ (state_[i - 1] >> (w - 2))) +
          static_cast<result_type>(i));
      state_[i] &= __word_mask();
    }
    index_ = n;
  }

  template <class SeedSeq>
  void seed(SeedSeq& seq) {
    const size_t chunks = (w + 31) / 32;
    uint_least32_t values[n * 2];
    seq.generate(values, values + n * chunks);
    bool all_zero = true;
    for (size_t i = 0; i < n; ++i) {
      result_type value = 0;
      for (size_t j = 0; j < chunks; ++j) {
        value = static_cast<result_type>(
            value | (static_cast<result_type>(values[i * chunks + j])
                     << static_cast<int>(j * 32)));
      }
      state_[i] = value & __word_mask();
      if ((state_[i] & __upper_mask()) != 0 || i != 0 && state_[i] != 0) {
        all_zero = false;
      }
    }
    if (all_zero) state_[0] = result_type(1) << (w - 1);
    index_ = n;
  }

  static constexpr result_type min() { return 0; }
  static constexpr result_type max() { return __word_mask(); }

  result_type operator()() {
    if (index_ >= n) __twist();
    result_type value = state_[index_++];
    value ^= (value >> u) & d;
    value ^= (value << s) & b;
    value ^= (value << t) & c;
    value ^= value >> l;
    return value & __word_mask();
  }

  void discard(unsigned long long count) {
    while (count-- != 0) {
      static_cast<void>((*this)());
    }
  }

  friend bool operator==(const mersenne_twister_engine& lhs,
                         const mersenne_twister_engine& rhs) {
    if (lhs.index_ != rhs.index_) return false;
    for (size_t i = 0; i < n; ++i) {
      if (lhs.state_[i] != rhs.state_[i]) return false;
    }
    return true;
  }

  friend bool operator!=(const mersenne_twister_engine& lhs,
                         const mersenne_twister_engine& rhs) {
    return !(lhs == rhs);
  }

 private:
  static constexpr result_type __word_mask() {
    return __random_detail::__mask_bits<result_type>(w);
  }
  static constexpr result_type __lower_mask() {
    return __random_detail::__mask_bits<result_type>(r);
  }
  static constexpr result_type __upper_mask() {
    return static_cast<result_type>(__word_mask() & ~__lower_mask());
  }

  void __twist() {
    for (size_t i = 0; i < n; ++i) {
      const result_type joined = static_cast<result_type>(
          (state_[i] & __upper_mask()) |
          (state_[(i + 1) % n] & __lower_mask()));
      result_type value =
          static_cast<result_type>(state_[(i + m) % n] ^ (joined >> 1));
      if ((joined & 1) != 0) value ^= a;
      state_[i] = value & __word_mask();
    }
    index_ = 0;
  }

  result_type state_[n];
  size_t index_ = n;

  template <class CharT, class Traits>
  friend basic_ostream<CharT, Traits>& operator<<(
      basic_ostream<CharT, Traits>& output,
      const mersenne_twister_engine& engine) {
    for (size_t i = 0; i < n; ++i) {
      if (i != 0) output << CharT(' ');
      output << engine.state_[i];
    }
    return output << CharT(' ') << engine.index_;
  }
  template <class CharT, class Traits>
  friend basic_istream<CharT, Traits>& operator>>(
      basic_istream<CharT, Traits>& input,
      mersenne_twister_engine& engine) {
    for (size_t i = 0; i < n; ++i) input >> engine.state_[i];
    input >> engine.index_;
    if (engine.index_ > n) input.setstate(ios_base::failbit);
    return input;
  }
};

template <class UIntType, size_t w, size_t s, size_t r>
class subtract_with_carry_engine {
  static_assert(is_unsigned_v<UIntType>);
  static_assert(0 < s && s < r && w <= sizeof(UIntType) * 8);

 public:
  using result_type = UIntType;

  static constexpr size_t word_size = w;
  static constexpr size_t short_lag = s;
  static constexpr size_t long_lag = r;
  static constexpr result_type default_seed = 19780503U;

  subtract_with_carry_engine()
      : subtract_with_carry_engine(default_seed) {}
  explicit subtract_with_carry_engine(result_type value) { seed(value); }

  template <class SeedSeq>
  explicit subtract_with_carry_engine(SeedSeq& seq) {
    seed(seq);
  }

  void seed(result_type value = default_seed) {
    linear_congruential_engine<uint_least32_t, 40014U, 0U, 2147483563U>
        generator(value == 0 ? default_seed : value);
    for (size_t i = 0; i < r; ++i) {
      state_[i] = 0;
      size_t produced = 0;
      while (produced < w) {
        state_[i] = static_cast<result_type>(
            state_[i] |
            (static_cast<result_type>(generator())
             << static_cast<int>(produced)));
        produced += 32;
      }
      state_[i] &= __word_mask();
    }
    carry_ = state_[r - 1] == 0 ? 1 : 0;
    index_ = 0;
  }

  template <class SeedSeq>
  void seed(SeedSeq& seq) {
    const size_t chunks = (w + 31) / 32;
    uint_least32_t values[r * 2];
    seq.generate(values, values + r * chunks);
    for (size_t i = 0; i < r; ++i) {
      state_[i] = 0;
      for (size_t j = 0; j < chunks; ++j) {
        state_[i] = static_cast<result_type>(
            state_[i] |
            (static_cast<result_type>(values[i * chunks + j])
             << static_cast<int>(j * 32)));
      }
      state_[i] &= __word_mask();
    }
    carry_ = state_[r - 1] == 0 ? 1 : 0;
    index_ = 0;
  }

  static constexpr result_type min() { return 0; }
  static constexpr result_type max() { return __word_mask(); }

  result_type operator()() {
    const size_t short_index = (index_ + r - s) % r;
    const result_type left = state_[short_index];
    const result_type right = state_[index_];
    const result_type result =
        static_cast<result_type>((left - right - carry_) & __word_mask());
    carry_ = left < right || (carry_ != 0 && left == right) ? 1 : 0;
    state_[index_] = result;
    index_ = (index_ + 1) % r;
    return result;
  }

  void discard(unsigned long long count) {
    while (count-- != 0) {
      static_cast<void>((*this)());
    }
  }

  friend bool operator==(const subtract_with_carry_engine& lhs,
                         const subtract_with_carry_engine& rhs) {
    if (lhs.index_ != rhs.index_ || lhs.carry_ != rhs.carry_) return false;
    for (size_t i = 0; i < r; ++i) {
      if (lhs.state_[i] != rhs.state_[i]) return false;
    }
    return true;
  }

  friend bool operator!=(const subtract_with_carry_engine& lhs,
                         const subtract_with_carry_engine& rhs) {
    return !(lhs == rhs);
  }

 private:
  static constexpr result_type __word_mask() {
    return __random_detail::__mask_bits<result_type>(w);
  }

  result_type state_[r];
  result_type carry_ = 0;
  size_t index_ = 0;

  template <class CharT, class Traits>
  friend basic_ostream<CharT, Traits>& operator<<(
      basic_ostream<CharT, Traits>& output,
      const subtract_with_carry_engine& engine) {
    for (size_t i = 0; i < r; ++i) {
      if (i != 0) output << CharT(' ');
      output << engine.state_[i];
    }
    return output << CharT(' ') << engine.carry_ << CharT(' ')
                  << engine.index_;
  }
  template <class CharT, class Traits>
  friend basic_istream<CharT, Traits>& operator>>(
      basic_istream<CharT, Traits>& input,
      subtract_with_carry_engine& engine) {
    result_type state[r];
    result_type carry = 0;
    size_t index = 0;
    for (size_t i = 0; i < r; ++i) input >> state[i];
    input >> carry >> index;
    if (input && carry <= 1 && index < r) {
      for (size_t i = 0; i < r; ++i) engine.state_[i] = state[i];
      engine.carry_ = carry;
      engine.index_ = index;
    }
    return input;
  }
};

template <class Engine, size_t p, size_t r>
class discard_block_engine {
  static_assert(0 < r && r <= p);

 public:
  using result_type = typename Engine::result_type;
  static constexpr size_t block_size = p;
  static constexpr size_t used_block = r;

  discard_block_engine() = default;
  explicit discard_block_engine(const Engine& engine) : engine_(engine) {}
  explicit discard_block_engine(Engine&& engine)
      : engine_(static_cast<Engine&&>(engine)) {}
  explicit discard_block_engine(result_type value) : engine_(value) {}

  template <class SeedSeq>
  explicit discard_block_engine(SeedSeq& seq) : engine_(seq) {}

  void seed() {
    engine_.seed();
    used_ = 0;
  }
  void seed(result_type value) {
    engine_.seed(value);
    used_ = 0;
  }
  template <class SeedSeq>
  void seed(SeedSeq& seq) {
    engine_.seed(seq);
    used_ = 0;
  }

  const Engine& base() const noexcept { return engine_; }
  static constexpr result_type min() { return Engine::min(); }
  static constexpr result_type max() { return Engine::max(); }

  result_type operator()() {
    if (used_ == r) {
      engine_.discard(p - r);
      used_ = 0;
    }
    ++used_;
    return engine_();
  }

  void discard(unsigned long long count) {
    while (count-- != 0) {
      static_cast<void>((*this)());
    }
  }

  friend bool operator==(const discard_block_engine& lhs,
                         const discard_block_engine& rhs) {
    return lhs.engine_ == rhs.engine_ && lhs.used_ == rhs.used_;
  }

  friend bool operator!=(const discard_block_engine& lhs,
                         const discard_block_engine& rhs) {
    return !(lhs == rhs);
  }

 private:
  Engine engine_;
  size_t used_ = 0;

  template <class CharT, class Traits>
  friend basic_ostream<CharT, Traits>& operator<<(
      basic_ostream<CharT, Traits>& output,
      const discard_block_engine& engine) {
    return output << engine.engine_ << CharT(' ') << engine.used_;
  }
  template <class CharT, class Traits>
  friend basic_istream<CharT, Traits>& operator>>(
      basic_istream<CharT, Traits>& input, discard_block_engine& engine) {
    Engine base;
    size_t used = 0;
    input >> base >> used;
    if (input && used <= r) {
      engine.engine_ = base;
      engine.used_ = used;
    }
    return input;
  }
};

template <class Engine, size_t w, class UIntType>
class independent_bits_engine {
  static_assert(is_unsigned_v<UIntType>);
  static_assert(0 < w && w <= sizeof(UIntType) * 8);

 public:
  using result_type = UIntType;

  independent_bits_engine() = default;
  explicit independent_bits_engine(const Engine& engine) : engine_(engine) {}
  explicit independent_bits_engine(Engine&& engine)
      : engine_(static_cast<Engine&&>(engine)) {}
  explicit independent_bits_engine(typename Engine::result_type value)
      : engine_(value) {}

  template <class SeedSeq>
  explicit independent_bits_engine(SeedSeq& seq) : engine_(seq) {}

  void seed() { engine_.seed(); }
  void seed(typename Engine::result_type value) { engine_.seed(value); }
  template <class SeedSeq>
  void seed(SeedSeq& seq) {
    engine_.seed(seq);
  }

  const Engine& base() const noexcept { return engine_; }
  static constexpr result_type min() { return 0; }
  static constexpr result_type max() {
    return __random_detail::__mask_bits<result_type>(w);
  }

  result_type operator()() {
    result_type result = 0;
    size_t produced = 0;
    while (produced < w) {
      const size_t take = w - produced > 16 ? 16 : w - produced;
      const unsigned long long bound = 1ULL << take;
      const result_type part = static_cast<result_type>(
          __random_detail::__uniform_below(engine_, bound));
      result = static_cast<result_type>(result | (part << produced));
      produced += take;
    }
    return result;
  }

  void discard(unsigned long long count) {
    while (count-- != 0) {
      static_cast<void>((*this)());
    }
  }

  friend bool operator==(const independent_bits_engine& lhs,
                         const independent_bits_engine& rhs) {
    return lhs.engine_ == rhs.engine_;
  }

  friend bool operator!=(const independent_bits_engine& lhs,
                         const independent_bits_engine& rhs) {
    return !(lhs == rhs);
  }

 private:
  Engine engine_;

  template <class CharT, class Traits>
  friend basic_ostream<CharT, Traits>& operator<<(
      basic_ostream<CharT, Traits>& output,
      const independent_bits_engine& engine) {
    return output << engine.engine_;
  }
  template <class CharT, class Traits>
  friend basic_istream<CharT, Traits>& operator>>(
      basic_istream<CharT, Traits>& input, independent_bits_engine& engine) {
    return input >> engine.engine_;
  }
};

template <class Engine, size_t k>
class shuffle_order_engine {
  static_assert(k > 0);

 public:
  using result_type = typename Engine::result_type;
  static constexpr size_t table_size = k;

  shuffle_order_engine() { __initialize(); }
  explicit shuffle_order_engine(const Engine& engine) : engine_(engine) {
    __initialize();
  }
  explicit shuffle_order_engine(Engine&& engine)
      : engine_(static_cast<Engine&&>(engine)) {
    __initialize();
  }
  explicit shuffle_order_engine(result_type value) : engine_(value) {
    __initialize();
  }

  template <class SeedSeq>
  explicit shuffle_order_engine(SeedSeq& seq) : engine_(seq) {
    __initialize();
  }

  void seed() {
    engine_.seed();
    __initialize();
  }
  void seed(result_type value) {
    engine_.seed(value);
    __initialize();
  }
  template <class SeedSeq>
  void seed(SeedSeq& seq) {
    engine_.seed(seq);
    __initialize();
  }

  const Engine& base() const noexcept { return engine_; }
  static constexpr result_type min() { return Engine::min(); }
  static constexpr result_type max() { return Engine::max(); }

  result_type operator()() {
    const unsigned long long range =
        static_cast<unsigned long long>(Engine::max()) -
        static_cast<unsigned long long>(Engine::min()) + 1ULL;
    size_t index;
    if (range == 0) {
      index = static_cast<size_t>(
          (static_cast<unsigned long long>(y_ - Engine::min()) * k) >>
          (sizeof(result_type) * 8));
    } else {
      index = static_cast<size_t>(
          (static_cast<unsigned long long>(y_ - Engine::min()) * k) / range);
    }
    if (index >= k) index = k - 1;
    y_ = table_[index];
    table_[index] = engine_();
    return y_;
  }

  void discard(unsigned long long count) {
    while (count-- != 0) {
      static_cast<void>((*this)());
    }
  }

  friend bool operator==(const shuffle_order_engine& lhs,
                         const shuffle_order_engine& rhs) {
    if (!(lhs.engine_ == rhs.engine_) || lhs.y_ != rhs.y_) return false;
    for (size_t i = 0; i < k; ++i) {
      if (lhs.table_[i] != rhs.table_[i]) return false;
    }
    return true;
  }

  friend bool operator!=(const shuffle_order_engine& lhs,
                         const shuffle_order_engine& rhs) {
    return !(lhs == rhs);
  }

 private:
  void __initialize() {
    for (size_t i = 0; i < k; ++i) table_[i] = engine_();
    y_ = engine_();
  }

  Engine engine_;
  result_type table_[k];
  result_type y_ = 0;

  template <class CharT, class Traits>
  friend basic_ostream<CharT, Traits>& operator<<(
      basic_ostream<CharT, Traits>& output,
      const shuffle_order_engine& engine) {
    output << engine.engine_;
    for (size_t i = 0; i < k; ++i)
      output << CharT(' ') << engine.table_[i];
    return output << CharT(' ') << engine.y_;
  }
  template <class CharT, class Traits>
  friend basic_istream<CharT, Traits>& operator>>(
      basic_istream<CharT, Traits>& input, shuffle_order_engine& engine) {
    Engine base;
    result_type table[k];
    result_type value = 0;
    input >> base;
    for (size_t i = 0; i < k; ++i) input >> table[i];
    input >> value;
    if (input) {
      engine.engine_ = base;
      for (size_t i = 0; i < k; ++i) engine.table_[i] = table[i];
      engine.y_ = value;
    }
    return input;
  }
};

