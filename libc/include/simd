        typename __ops::__vector_type __left;                              \
        typename __ops::__vector_type __right;                             \
        memcpy((void*)&__left, (const void*)a.__data, sizeof(__left));     \
        memcpy((void*)&__right, (const void*)b.__data, sizeof(__right));   \
        auto __native_result = __left OP __right;                          \
        memcpy((void*)result.__data, (const void*)&__native_result,         \
