template <size_t Bytes, class Abi>
class basic_mask {
 public:
  using value_type = bool;
  using abi_type = Abi;
  using __integer_type = typename __integer_from<Bytes>::type;
  static constexpr __simd_size_type size() noexcept { return Abi::__size; }

  bool __data[Abi::__size];

  class const_iterator {
    const basic_mask* __owner;
    size_t __index;
   public:
    constexpr const_iterator(const basic_mask* owner, size_t index)
        : __owner(owner), __index(index) {}
    constexpr bool operator*() const { return (*__owner)[__index]; }
    constexpr const_iterator& operator++() {
      ++__index;
      return *this;
    }
    friend constexpr bool operator==(const const_iterator& a,
                                     const const_iterator& b) {
      return a.__owner == b.__owner && a.__index == b.__index;
    }
    friend constexpr bool operator!=(const const_iterator& a,
                                     const const_iterator& b) {
      return !(a == b);
    }
  };
  using iterator = const_iterator;
  constexpr iterator begin() noexcept { return iterator(this, 0); }
  constexpr const_iterator begin() const noexcept {
    return const_iterator(this, 0);
  }
  constexpr const_iterator cbegin() const noexcept {
    return const_iterator(this, 0);
  }
  constexpr iterator end() noexcept { return iterator(this, size()); }
  constexpr const_iterator end() const noexcept {
    return const_iterator(this, size());
  }
  constexpr const_iterator cend() const noexcept {
    return const_iterator(this, size());
  }

  constexpr basic_mask() noexcept = default;
  constexpr basic_mask(const basic_mask&) noexcept = default;
  constexpr basic_mask(basic_mask&) noexcept = default;
  constexpr basic_mask(basic_mask&&) noexcept = default;
  constexpr basic_mask& operator=(const basic_mask&) noexcept = default;

  constexpr explicit basic_mask(bool value) noexcept {
    for (size_t i = 0; i < size(); ++i)
      __data[i] = value;
  }

  template <size_t UBytes, class UAbi>
  constexpr explicit basic_mask(
      const basic_mask<UBytes, UAbi>& other) noexcept {
    for (size_t i = 0; i < size(); ++i)
      __data[i] = other[i];
  }

  template <class G>
  constexpr explicit basic_mask(G&& gen) {
    for (size_t i = 0; i < size(); ++i)
      __data[i] = static_cast<bool>(gen(i));
  }

  constexpr basic_mask(const bitset<Abi::__size>& bits) noexcept {
    for (size_t i = 0; i < size(); ++i)
      __data[i] = bits[i];
  }

  constexpr explicit basic_mask(unsigned int bits) noexcept {
    for (size_t i = 0; i < size(); ++i)
      __data[i] = i < numeric_limits<unsigned int>::digits &&
                  ((bits >> i) & 1u) != 0;
  }

  constexpr bool operator[](size_t i) const { return __data[i]; }
  constexpr void __set(size_t i, bool value) { __data[i] = value; }

  constexpr basic_mask operator!() const noexcept {
    basic_mask result;
    for (size_t i = 0; i < size(); ++i)
      result.__data[i] = !__data[i];
    return result;
  }

  constexpr auto operator+() const noexcept;
  constexpr auto operator-() const noexcept;
  constexpr auto operator~() const noexcept;

  constexpr bitset<Abi::__size> to_bitset() const noexcept {
    bitset<Abi::__size> result;
    for (size_t i = 0; i < size(); ++i)
      result.set(i, __data[i]);
    return result;
  }

  constexpr unsigned long long to_ullong() const {
    unsigned long long result = 0;
    for (size_t i = 0;
         i < size() && i < numeric_limits<unsigned long long>::digits; ++i) {
      if (__data[i])
        result |= 1ULL << i;
    }
    return result;
  }

  friend constexpr basic_mask operator&&(const basic_mask& a,
                                          const basic_mask& b) noexcept {
    basic_mask result;
    for (size_t i = 0; i < size(); ++i)
      result.__data[i] = a[i] && b[i];
    return result;
  }

  friend constexpr basic_mask operator||(const basic_mask& a,
                                          const basic_mask& b) noexcept {
    basic_mask result;
    for (size_t i = 0; i < size(); ++i)
      result.__data[i] = a[i] || b[i];
    return result;
  }

#define __DAVE_MASK_BINARY(OP)                                             \
  friend constexpr basic_mask operator OP(const basic_mask& a,             \
                                            const basic_mask& b) noexcept { \
    basic_mask result;                                                      \
    for (size_t i = 0; i < size(); ++i)                                     \
      result.__data[i] = a[i] OP b[i];                                      \
    return result;                                                          \
  }
  __DAVE_MASK_BINARY(&)
  __DAVE_MASK_BINARY(|)
  __DAVE_MASK_BINARY(^)
  __DAVE_MASK_BINARY(==)
  __DAVE_MASK_BINARY(!=)
  __DAVE_MASK_BINARY(>=)
  __DAVE_MASK_BINARY(<=)
  __DAVE_MASK_BINARY(>)
  __DAVE_MASK_BINARY(<)
#undef __DAVE_MASK_BINARY

#define __DAVE_MASK_ASSIGN(OP)                                      \
  friend constexpr basic_mask& operator OP##=(basic_mask& a,         \
                                               const basic_mask& b) { \
    for (size_t i = 0; i < size(); ++i)                              \
      a.__data[i] = a[i] OP b[i];                                    \
    return a;                                                        \
  }
  __DAVE_MASK_ASSIGN(&)
  __DAVE_MASK_ASSIGN(|)
  __DAVE_MASK_ASSIGN(^)
#undef __DAVE_MASK_ASSIGN
};

template <class T, class Abi>
class basic_vec {
 public:
  using value_type = T;
  using mask_type = basic_mask<sizeof(T), Abi>;
  using abi_type = Abi;
  static constexpr __simd_size_type size() noexcept { return Abi::__size; }

  T __data[Abi::__size];

  class const_iterator {
    const basic_vec* __owner;
    size_t __index;
   public:
    constexpr const_iterator(const basic_vec* owner, size_t index)
        : __owner(owner), __index(index) {}
    constexpr T operator*() const { return (*__owner)[__index]; }
    constexpr const_iterator& operator++() {
      ++__index;
      return *this;
    }
    friend constexpr bool operator==(const const_iterator& a,
                                     const const_iterator& b) {
      return a.__owner == b.__owner && a.__index == b.__index;
    }
    friend constexpr bool operator!=(const const_iterator& a,
                                     const const_iterator& b) {
      return !(a == b);
    }
  };
  using iterator = const_iterator;
  constexpr iterator begin() noexcept { return iterator(this, 0); }
  constexpr const_iterator begin() const noexcept {
    return const_iterator(this, 0);
  }
  constexpr const_iterator cbegin() const noexcept {
    return const_iterator(this, 0);
  }
  constexpr iterator end() noexcept { return iterator(this, size()); }
  constexpr const_iterator end() const noexcept {
    return const_iterator(this, size());
  }
  constexpr const_iterator cend() const noexcept {
    return const_iterator(this, size());
  }

  constexpr basic_vec() noexcept = default;
  constexpr basic_vec(const basic_vec&) noexcept = default;
  constexpr basic_vec(basic_vec&) noexcept = default;
  constexpr basic_vec(basic_vec&&) noexcept = default;
  constexpr basic_vec& operator=(const basic_vec&) noexcept = default;

  constexpr basic_vec(T value) noexcept {
    for (size_t i = 0; i < size(); ++i)
      __data[i] = value;
  }

  template <class U, class UAbi>
  requires(UAbi::__size == Abi::__size)
  constexpr explicit basic_vec(const basic_vec<U, UAbi>& other) noexcept {
    for (size_t i = 0; i < size(); ++i)
      __data[i] = static_cast<T>(other[i]);
  }

  template <class G>
  requires(is_invocable<G&, size_t>::value)
  constexpr explicit basic_vec(G&& gen) {
    for (size_t i = 0; i < size(); ++i)
      __data[i] = static_cast<T>(gen(i));
  }

  constexpr T operator[](size_t i) const { return __data[i]; }
  constexpr void __set(size_t i, const T& value) { __data[i] = value; }

  constexpr basic_vec& operator++() noexcept {
    for (size_t i = 0; i < size(); ++i)
      ++__data[i];
    return *this;
  }
  constexpr basic_vec operator++(int) noexcept {
    basic_vec old = *this;
    ++*this;
    return old;
  }
  constexpr basic_vec& operator--() noexcept {
    for (size_t i = 0; i < size(); ++i)
      --__data[i];
    return *this;
  }
  constexpr basic_vec operator--(int) noexcept {
    basic_vec old = *this;
    --*this;
    return old;
  }
  constexpr mask_type operator!() const noexcept {
    mask_type result;
    for (size_t i = 0; i < size(); ++i)
      result.__set(i, !__data[i]);
    return result;
  }
  constexpr basic_vec operator~() const noexcept {
    basic_vec result;
    if constexpr (is_integral<T>::value) {
      using __ops = __native_ops<T, Abi::__size>;
      if consteval {
      } else {
        if constexpr (__ops::__enabled) {
          typename __ops::__vector_type __value;
          memcpy((void*)&__value, (const void*)__data, sizeof(__value));
          auto __native_result = ~__value;
          memcpy((void*)result.__data, (const void*)&__native_result,
                 sizeof(__native_result));
          return result;
        }
      }
      for (size_t i = 0; i < size(); ++i)
        result.__data[i] = ~__data[i];
    }
    return result;
  }
  constexpr basic_vec operator+() const noexcept { return *this; }
  constexpr basic_vec operator-() const noexcept {
    basic_vec result;
    using __ops = __native_ops<T, Abi::__size>;
    if consteval {
    } else {
      if constexpr (__ops::__enabled) {
        typename __ops::__vector_type __value;
        memcpy((void*)&__value, (const void*)__data, sizeof(__value));
        auto __native_result = -__value;
        memcpy((void*)result.__data, (const void*)&__native_result,
               sizeof(__native_result));
        return result;
      }
    }
    for (size_t i = 0; i < size(); ++i)
      result.__data[i] = -__data[i];
    return result;
  }

