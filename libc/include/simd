template <class T, class Abi>
constexpr basic_vec<T, Abi> fma(const basic_vec<T, Abi>& a,
                                 const basic_vec<T, Abi>& b,
                                 const basic_vec<T, Abi>& c) {
  basic_vec<T, Abi> result;
  for (size_t i = 0; i < a.size(); ++i)
    result.__set(i, std::fma(a[i], b[i], c[i]));
  return result;
}

template <class T, class Abi>
constexpr basic_vec<T, Abi> lerp(const basic_vec<T, Abi>& a,
                                  const basic_vec<T, Abi>& b,
                                  const basic_vec<T, Abi>& t) {
  basic_vec<T, Abi> result;
  for (size_t i = 0; i < a.size(); ++i)
    result.__set(i, a[i] + t[i] * (b[i] - a[i]));
  return result;
}

