template <class T, std::size_t N>
struct __native_ops {
  static constexpr bool __enabled = false;
  using __vector_type = void;
};

#define __DAVE_NATIVE_OPS(TYPE, LANES, BYTES)                       \
  template <>                                                       \
  struct __native_ops<TYPE, LANES> {                                \
    static constexpr bool __enabled = true;                         \
    using __vector_type = TYPE __attribute__((vector_size(BYTES))); \
  }

