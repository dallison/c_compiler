template <size_t Bytes, class Abi>
constexpr auto basic_mask<Bytes, Abi>::operator+() const noexcept {
  using V = basic_vec<__integer_type, Abi>;
  V result;
  for (size_t i = 0; i < size(); ++i)
    result.__set(i, __data[i] ? 1 : 0);
  return result;
}

template <size_t Bytes, class Abi>
constexpr auto basic_mask<Bytes, Abi>::operator-() const noexcept {
  using V = basic_vec<__integer_type, Abi>;
  V result;
  for (size_t i = 0; i < size(); ++i)
    result.__set(i, __data[i] ? -1 : 0);
  return result;
}

template <size_t Bytes, class Abi>
constexpr auto basic_mask<Bytes, Abi>::operator~() const noexcept {
  using V = basic_vec<__integer_type, Abi>;
  V result;
  for (size_t i = 0; i < size(); ++i)
    result.__set(i, ~static_cast<__integer_type>(__data[i]));
  return result;
}

template <size_t Bytes, class Abi>
constexpr bool all_of(const basic_mask<Bytes, Abi>& value) noexcept {
  for (size_t i = 0; i < value.size(); ++i)
    if (!value[i]) return false;
  return true;
}

template <size_t Bytes, class Abi>
constexpr bool any_of(const basic_mask<Bytes, Abi>& value) noexcept {
  for (size_t i = 0; i < value.size(); ++i)
    if (value[i]) return true;
  return false;
}

template <size_t Bytes, class Abi>
constexpr bool none_of(const basic_mask<Bytes, Abi>& value) noexcept {
  return !any_of(value);
}

template <size_t Bytes, class Abi>
constexpr size_t reduce_count(const basic_mask<Bytes, Abi>& value) noexcept {
  size_t result = 0;
  for (size_t i = 0; i < value.size(); ++i)
    if (value[i]) ++result;
  return result;
}

template <size_t Bytes, class Abi>
constexpr size_t reduce_min_index(const basic_mask<Bytes, Abi>& value) {
  for (size_t i = 0; i < value.size(); ++i)
    if (value[i]) return i;
  return value.size();
}

template <size_t Bytes, class Abi>
constexpr size_t reduce_max_index(const basic_mask<Bytes, Abi>& value) {
  for (size_t i = value.size(); i > 0; --i)
    if (value[i - 1]) return i - 1;
  return value.size();
}

constexpr bool all_of(bool value) noexcept { return value; }
constexpr bool any_of(bool value) noexcept { return value; }
constexpr bool none_of(bool value) noexcept { return !value; }
constexpr size_t reduce_count(bool value) noexcept { return value ? 1 : 0; }
constexpr size_t reduce_min_index(bool) { return 0; }
constexpr size_t reduce_max_index(bool) { return 0; }

template <class T>
struct __plus_op {
  constexpr T operator()(const T& a, const T& b) const { return a + b; }
};

template <class T, class Abi, class BinaryOperation = __plus_op<T>>
constexpr T reduce(const basic_vec<T, Abi>& value,
                   BinaryOperation op = {}) {
  T result = value[0];
  for (size_t i = 1; i < value.size(); ++i)
    result = op(result, value[i]);
  return result;
}

template <class T, class Abi, class BinaryOperation = __plus_op<T>>
constexpr T reduce(const basic_vec<T, Abi>& value,
                   const typename basic_vec<T, Abi>::mask_type& selected,
                   BinaryOperation op = {}, T identity = T()) {
  T result = identity;
  for (size_t i = 0; i < value.size(); ++i)
    if (selected[i]) result = op(result, value[i]);
  return result;
}

template <class T, class BinaryOperation = __plus_op<T>>
constexpr T reduce(const T& value, BinaryOperation = {}) { return value; }

template <class T, class BinaryOperation = __plus_op<T>>
constexpr T reduce(const T& value, bool selected, BinaryOperation = {},
                   T identity = T()) {
  return selected ? value : identity;
}

template <class T, class Abi>
constexpr T reduce_min(const basic_vec<T, Abi>& value) noexcept {
  T result = value[0];
  for (size_t i = 1; i < value.size(); ++i)
    if (value[i] < result) result = value[i];
  return result;
}

template <class T, class Abi>
constexpr T reduce_max(const basic_vec<T, Abi>& value) noexcept {
  T result = value[0];
  for (size_t i = 1; i < value.size(); ++i)
    if (value[i] > result) result = value[i];
  return result;
}

template <class T, class Abi>
constexpr T reduce_min(
    const basic_vec<T, Abi>& value,
    const typename basic_vec<T, Abi>::mask_type& selected) noexcept {
  T result = numeric_limits<T>::max();
  for (size_t i = 0; i < value.size(); ++i)
    if (selected[i] && value[i] < result) result = value[i];
  return result;
}

template <class T, class Abi>
constexpr T reduce_max(
    const basic_vec<T, Abi>& value,
    const typename basic_vec<T, Abi>::mask_type& selected) noexcept {
  T result = numeric_limits<T>::lowest();
  for (size_t i = 0; i < value.size(); ++i)
    if (selected[i] && value[i] > result) result = value[i];
  return result;
}

template <class T>
constexpr T reduce_min(const T& value) noexcept { return value; }
template <class T>
constexpr T reduce_max(const T& value) noexcept { return value; }
template <class T>
constexpr T reduce_min(const T& value, bool) noexcept { return value; }
template <class T>
constexpr T reduce_max(const T& value, bool) noexcept { return value; }

template <class T, class Abi>
constexpr basic_vec<T, Abi> min(const basic_vec<T, Abi>& a,
                                 const basic_vec<T, Abi>& b) noexcept {
  basic_vec<T, Abi> result;
  for (size_t i = 0; i < a.size(); ++i)
    result.__set(i, a[i] < b[i] ? a[i] : b[i]);
  return result;
}

template <class T, class Abi>
constexpr basic_vec<T, Abi> max(const basic_vec<T, Abi>& a,
                                 const basic_vec<T, Abi>& b) noexcept {
  basic_vec<T, Abi> result;
  for (size_t i = 0; i < a.size(); ++i)
    result.__set(i, a[i] > b[i] ? a[i] : b[i]);
  return result;
}

template <class T, class Abi>
constexpr pair<basic_vec<T, Abi>, basic_vec<T, Abi>> minmax(
    const basic_vec<T, Abi>& a, const basic_vec<T, Abi>& b) noexcept {
  return {min(a, b), max(a, b)};
}

template <class T, class Abi>
constexpr basic_vec<T, Abi> clamp(const basic_vec<T, Abi>& value,
                                   const basic_vec<T, Abi>& lo,
                                   const basic_vec<T, Abi>& hi) {
  return min(max(value, lo), hi);
}

template <class T, class U>
constexpr auto select(bool condition, const T& a, const U& b)
    -> typename remove_cvref<decltype(condition ? a : b)>::type {
  return condition ? a : b;
}

template <size_t Bytes, class Abi>
constexpr basic_mask<Bytes, Abi> select(
    const basic_mask<Bytes, Abi>& condition,
    const basic_mask<Bytes, Abi>& a,
    const basic_mask<Bytes, Abi>& b) noexcept {
  basic_mask<Bytes, Abi> result;
  for (size_t i = 0; i < condition.size(); ++i)
    result.__set(i, condition[i] ? a[i] : b[i]);
  return result;
}

template <class T, class Abi>
constexpr basic_vec<T, Abi> select(
    const typename basic_vec<T, Abi>::mask_type& condition,
    const basic_vec<T, Abi>& a, const basic_vec<T, Abi>& b) noexcept {
  basic_vec<T, Abi> result;
  for (size_t i = 0; i < condition.size(); ++i)
    result.__set(i, condition[i] ? a[i] : b[i]);
  return result;
}

template <class V, class R, class... Flags>
constexpr V partial_load(R&& range, flags<Flags...> = {}) {
  V result(static_cast<typename V::value_type>(0));
  size_t n = range.size();
  for (size_t i = 0; i < V::size() && i < n; ++i)
    result.__set(i, static_cast<typename V::value_type>(range[i]));
  return result;
}

template <class V, class R, class... Flags>
constexpr V partial_load(R&& range, const typename V::mask_type& selected,
                         flags<Flags...> = {}) {
  V result(static_cast<typename V::value_type>(0));
  size_t n = range.size();
  for (size_t i = 0; i < V::size() && i < n; ++i)
    if (selected[i])
      result.__set(i, static_cast<typename V::value_type>(range[i]));
  return result;
}

template <class V, class R, class... Flags>
constexpr V unchecked_load(R&& range, flags<Flags...> f = {}) {
  return partial_load<V>(forward<R>(range), f);
}

template <class V, class R, class... Flags>
constexpr V unchecked_load(R&& range, const typename V::mask_type& selected,
                           flags<Flags...> f = {}) {
  return partial_load<V>(forward<R>(range), selected, f);
}

template <class T, class Abi, class R, class... Flags>
constexpr void partial_store(const basic_vec<T, Abi>& value, R&& range,
                             flags<Flags...> = {}) {
  size_t n = range.size();
  for (size_t i = 0; i < value.size() && i < n; ++i)
    range[i] = value[i];
}

template <class T, class Abi, class R, class... Flags>
constexpr void partial_store(
    const basic_vec<T, Abi>& value, R&& range,
    const typename basic_vec<T, Abi>::mask_type& selected,
    flags<Flags...> = {}) {
  size_t n = range.size();
  for (size_t i = 0; i < value.size() && i < n; ++i)
    if (selected[i]) range[i] = value[i];
}

template <class T, class Abi, class R, class... Flags>
constexpr void unchecked_store(const basic_vec<T, Abi>& value, R&& range,
                               flags<Flags...> f = {}) {
  partial_store(value, forward<R>(range), f);
}

template <class T, class Abi, class R, class... Flags>
constexpr void unchecked_store(
    const basic_vec<T, Abi>& value, R&& range,
    const typename basic_vec<T, Abi>::mask_type& selected,
    flags<Flags...> f = {}) {
  partial_store(value, forward<R>(range), selected, f);
}

inline constexpr size_t zero_element = static_cast<size_t>(-1);
inline constexpr size_t uninit_element = static_cast<size_t>(-2);

template <size_t N, class V, class IdxMap>
constexpr resize_t<N, V> permute(const V& value, IdxMap&& map) {
  resize_t<N, V> result;
  for (size_t i = 0; i < N; ++i) {
    size_t source = static_cast<size_t>(map(i));
    if (source == zero_element)
      result.__set(i, static_cast<typename V::value_type>(0));
    else if (source != uninit_element)
      result.__set(i, value[source]);
  }
  return result;
}

template <class V, class I>
constexpr resize_t<I::size(), V> permute(const V& value, const I& indices) {
  resize_t<I::size(), V> result;
  for (size_t i = 0; i < I::size(); ++i)
    result.__set(i, value[static_cast<size_t>(indices[i])]);
  return result;
}

template <class V>
constexpr V compress(const V& value, const typename V::mask_type& selected) {
  V result{};
  size_t out = 0;
  for (size_t i = 0; i < V::size(); ++i)
    if (selected[i]) result.__set(out++, value[i]);
  return result;
}

template <class V>
constexpr V compress(const V& value, const typename V::mask_type& selected,
                     const typename V::value_type& fill) {
  V result(fill);
  size_t out = 0;
  for (size_t i = 0; i < V::size(); ++i)
    if (selected[i]) result.__set(out++, value[i]);
  return result;
}

template <class V>
constexpr V expand(const V& value, const typename V::mask_type& selected,
                   const V& original = {}) {
  V result = original;
  size_t in = 0;
  for (size_t i = 0; i < V::size(); ++i)
    if (selected[i]) result.__set(i, value[in++]);
  return result;
}

template <class T, class Abi>
constexpr basic_vec<T, Abi> abs(const basic_vec<T, Abi>& value) {
  basic_vec<T, Abi> result;
  for (size_t i = 0; i < value.size(); ++i)
    result.__set(i, value[i] < T() ? -value[i] : value[i]);
  return result;
}

