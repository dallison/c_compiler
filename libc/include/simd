using __simd_size_type = size_t;

template <size_t N>
struct __abi {
  static constexpr size_t __size = N;
};

// x86-64 SSE and AArch64 NEON both have 16-byte vector registers.  32-bit
// ARM keeps the same default width but uses the scalar-lane fallback.
inline constexpr size_t __native_vector_bytes = 16;

template <class T>
struct native_abi {
  static constexpr size_t __size =
      sizeof(T) == 0 ? 1
                     : (__native_vector_bytes / sizeof(T) > 0
                            ? __native_vector_bytes / sizeof(T)
                            : 1);
};

template <class T>
using __native_abi = native_abi<T>;

