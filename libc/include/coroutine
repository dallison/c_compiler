#ifndef coroutine_h
#define coroutine_h

namespace std {

template <class R, class... Args>
struct coroutine_traits {
  using promise_type = typename R::promise_type;
};

struct __coroutine_frame {
  int __state;
  int __done;
  void (*__resume)(void*);
  void (*__destroy)(void*);
};

template <class Promise = void>
struct coroutine_handle {
  void* __handle;

  static coroutine_handle from_address(void* address) {
    coroutine_handle result = {address};
    return result;
  }

  static coroutine_handle from_promise(Promise& promise) {
    char* promise_address = (char*)&promise;
    coroutine_handle result = {
        (void*)(promise_address - sizeof(__coroutine_frame))};
    return result;
  }

  void* address(void) const {
    return __handle;
  }

  Promise& promise(void) const {
    char* frame_address = (char*)__handle;
    return *(Promise*)(frame_address + sizeof(__coroutine_frame));
  }

  explicit operator bool() const {
    return __handle != 0;
  }

  bool done(void) const {
    return __handle == 0 ||
           ((__coroutine_frame*)__handle)->__done != 0;
  }

  void resume(void) const {
    if (__handle == 0) {
      return;
    }
    __coroutine_frame* frame = (__coroutine_frame*)__handle;
    if (!frame->__done && frame->__resume != 0) {
      frame->__resume(__handle);
    }
  }

  void operator()(void) const {
    resume();
  }

  void destroy(void) const {
    if (__handle == 0) {
      return;
    }
    __coroutine_frame* frame = (__coroutine_frame*)__handle;
    if (frame->__destroy != 0) {
      frame->__destroy(__handle);
    }
  }
};

template <>
struct coroutine_handle<void> {
  void* __handle;

  static coroutine_handle from_address(void* address) {
    coroutine_handle result = {address};
    return result;
  }

  void* address(void) const {
    return __handle;
  }

  explicit operator bool() const {
    return __handle != 0;
  }

  bool done(void) const {
    return __handle == 0 ||
           ((__coroutine_frame*)__handle)->__done != 0;
  }

  void resume(void) const {
    if (__handle == 0) {
      return;
    }
    __coroutine_frame* frame = (__coroutine_frame*)__handle;
    if (!frame->__done && frame->__resume != 0) {
      frame->__resume(__handle);
    }
  }

  void operator()(void) const {
    resume();
  }

  void destroy(void) const {
    if (__handle == 0) {
      return;
    }
    __coroutine_frame* frame = (__coroutine_frame*)__handle;
    if (frame->__destroy != 0) {
      frame->__destroy(__handle);
    }
  }
};

struct suspend_never {
  bool await_ready(void) const {
    return true;
  }

  void await_suspend(void* handle) const {
    (void)handle;
  }

  void await_resume(void) const {
  }
};

struct suspend_always {
  bool await_ready(void) const {
    return false;
  }

  void await_suspend(void* handle) const {
    (void)handle;
  }

  void await_resume(void) const {
  }
};

}  // namespace std

#endif /* coroutine_h */
