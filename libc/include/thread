namespace std {

namespace __thread_detail {

template <class Value>
decay_t<Value> __decay_copy(Value&& value) {
  return std::forward<Value>(value);
}

template <class... Values>
struct __argument_pack;

template <>
struct __argument_pack<> {};

template <class Head, class... Tail>
struct __argument_pack<Head, Tail...> {
  Head __head;
  __argument_pack<Tail...> __tail;

  explicit __argument_pack(Head&& head, Tail&&... tail)
      : __head(std::move(head)), __tail(std::move(tail)...) {}
};

template <class Function, class Arguments>
struct __apply;

template <class Function>
struct __apply<Function, __argument_pack<>> {
  template <class... Collected>
  static void __call(Function& function, __argument_pack<>&,
                     Collected&&... collected) {
    std::invoke(std::move(function),
                std::forward<Collected>(collected)...);
  }
};

template <class Function, class Head, class... Tail>
struct __apply<Function, __argument_pack<Head, Tail...>> {
  template <class... Collected>
  static void __call(Function& function,
                     __argument_pack<Head, Tail...>& arguments,
                     Collected&&... collected) {
    __apply<Function, __argument_pack<Tail...>>::__call(
        function, arguments.__tail,
        std::forward<Collected>(collected)...,
        std::move(arguments.__head));
  }
};

template <class Function, class... Args>
struct __state {
  Function __function;
  __argument_pack<Args...> __arguments;

  explicit __state(Function&& function, Args&&... arguments)
      : __function(std::move(function)),
        __arguments(std::move(arguments)...) {}

  void __call() {
    __apply<Function, __argument_pack<Args...>>::__call(
        __function, __arguments);
  }
};

template <class Function, class... Args>
struct __plain_invocation {
  Function __function;
  __argument_pack<Args...> __arguments;

  explicit __plain_invocation(Function&& function, Args&&... arguments)
      : __function(std::move(function)),
        __arguments(std::move(arguments)...) {}

  void operator()() {
    __apply<Function, __argument_pack<Args...>>::__call(
        __function, __arguments);
  }
};

#if __cplusplus >= 202002L
template <class Function, class... Args>
struct __stoppable_invocation {
  stop_token __token;
  Function __function;
  __argument_pack<Args...> __arguments;

  explicit __stoppable_invocation(stop_token&& token, Function&& function,
                                  Args&&... arguments)
      : __token(std::move(token)),
        __function(std::move(function)),
        __arguments(std::move(arguments)...) {}

  void operator()() {
    __apply<Function, __argument_pack<Args...>>::__call(
        __function, __arguments, std::move(__token));
  }
};
#endif

[[noreturn]] inline void __throw_thread_error(errc error,
                                              const char* operation) {
  throw system_error(make_error_code(error), operation);
}

template <class Rep, class Period>
void __sleep_for(const chrono::duration<Rep, Period>& relative_time) {
  long double seconds =
      static_cast<long double>(relative_time.count()) *
      static_cast<long double>(Period::num) /
      static_cast<long double>(Period::den);
  if (!(seconds > 0.0L)) {
    return;
  }

  const long double maximum_seconds =
      sizeof(time_t) <= 4 ? 2147483647.0L : 9223372036854775807.0L;
  while (seconds > 0.0L) {
    long double chunk =
        seconds < maximum_seconds ? seconds : maximum_seconds;
    time_t whole_seconds = static_cast<time_t>(chunk);
    long double fractional_seconds =
        chunk - static_cast<long double>(whole_seconds);
    long nanoseconds =
        static_cast<long>(fractional_seconds * 1000000000.0L);
    if (nanoseconds < 0) {
      nanoseconds = 0;
    } else if (nanoseconds >= 1000000000L) {
      nanoseconds = 999999999L;
    }
    if (whole_seconds == 0 && nanoseconds == 0) {
      nanoseconds = 1;
    }

    timespec requested{whole_seconds, nanoseconds};
    timespec remaining{};
    int result;
    do {
      result = thrd_sleep(&requested, &remaining);
      if (result == -2) {
        requested = remaining;
      }
    } while (result == -2);

    if (result != 0) {
      return;
    }
    seconds -= chunk;
  }
}

}  // namespace __thread_detail

class thread {
  template <class State>
  static int __run(void* opaque) {
    State* state = static_cast<State*>(opaque);
    try {
      state->__call();
    } catch (...) {
      try {
        delete state;
      } catch (...) {
      }
      terminate();
    }
    try {
      delete state;
    } catch (...) {
      terminate();
    }
    return 0;
  }

 public:
  class id {
   public:
    constexpr id() noexcept : __value_(0) {}

    friend constexpr bool operator==(id left, id right) noexcept {
      return left.__value_ == right.__value_;
    }
#if __cplusplus >= 202002L
    friend constexpr strong_ordering operator<=>(id left, id right) noexcept {
      return left.__value_ <=> right.__value_;
    }
#else
    friend constexpr bool operator!=(id left, id right) noexcept {
      return !(left == right);
    }
    friend constexpr bool operator<(id left, id right) noexcept {
      return left.__value_ < right.__value_;
    }
    friend constexpr bool operator<=(id left, id right) noexcept {
      return !(right < left);
    }
    friend constexpr bool operator>(id left, id right) noexcept {
      return right < left;
    }
    friend constexpr bool operator>=(id left, id right) noexcept {
      return !(left < right);
    }
#endif

   private:
    explicit constexpr id(thrd_t value) noexcept : __value_(value) {}
    thrd_t __value_;

    friend class thread;
    friend struct hash<id>;
  };

  using native_handle_type = thrd_t;

  thread() noexcept : __handle_(0) {}

  template <class Function, class... Args,
            typename enable_if<
                !is_same<decay_t<Function>, thread>::value,
                int>::type = 0>
  explicit thread(Function&& function, Args&&... arguments) : __handle_(0) {
    using state_type =
        __thread_detail::__state<decay_t<Function>, decay_t<Args>...>;
    state_type* state =
        new state_type(
            __thread_detail::__decay_copy(std::forward<Function>(function)),
            __thread_detail::__decay_copy(
                std::forward<Args>(arguments))...);

    thrd_t handle = 0;
    int result = thrd_create(&handle, &__run<state_type>, state);
    if (result != thrd_success) {
      delete state;
      errc error = result == thrd_nomem
                       ? errc::resource_unavailable_try_again
                       : errc::operation_not_permitted;
      __thread_detail::__throw_thread_error(error, "thread");
    }
    __handle_ = handle;
  }

  ~thread() {
    if (joinable()) {
      terminate();
    }
  }

  thread(const thread&) = delete;
  thread& operator=(const thread&) = delete;

  thread(thread&& other) noexcept
      : __handle_(std::exchange(other.__handle_, 0)) {}

  thread& operator=(thread&& other) noexcept {
    if (joinable()) {
      terminate();
    }
    __handle_ = std::exchange(other.__handle_, 0);
    return *this;
  }

  void swap(thread& other) noexcept {
    std::swap(__handle_, other.__handle_);
  }

  bool joinable() const noexcept { return __handle_ != 0; }

  void join() {
    if (!joinable()) {
      __thread_detail::__throw_thread_error(errc::invalid_argument,
                                            "thread::join");
    }
    if (__handle_ == thrd_current()) {
      __thread_detail::__throw_thread_error(
          errc::resource_deadlock_would_occur, "thread::join");
    }
    if (thrd_join(__handle_, nullptr) != thrd_success) {
      __thread_detail::__throw_thread_error(errc::no_such_process,
                                            "thread::join");
    }
    __handle_ = 0;
  }

  void detach() {
    if (!joinable()) {
      __thread_detail::__throw_thread_error(errc::invalid_argument,
                                            "thread::detach");
    }
    if (thrd_detach(__handle_) != thrd_success) {
      __thread_detail::__throw_thread_error(errc::no_such_process,
                                            "thread::detach");
    }
    __handle_ = 0;
  }

  id get_id() const noexcept { return id(__handle_); }
  native_handle_type native_handle() { return __handle_; }

  static unsigned int hardware_concurrency() noexcept {
    return __davecc_hardware_concurrency();
  }

  static id __id_from_native_handle(thrd_t handle) noexcept {
    return id(handle);
  }

 private:
  thrd_t __handle_;
};

inline void swap(thread& left, thread& right) noexcept {
  left.swap(right);
}

template <>
struct hash<thread::id> {
  size_t operator()(thread::id value) const noexcept {
    return hash<thrd_t>{}(value.__value_);
  }
};

#if __cplusplus >= 202002L
template <>
struct formatter<thread::id, char> {
  const char* __specification_data = nullptr;
  size_t __specification_size = 0;

  constexpr format_parse_context::iterator parse(
      format_parse_context& context) {
    auto begin = context.begin();
    auto end = context.end();
    __specification_data = begin;
    __specification_size = static_cast<size_t>(end - begin);
    return context.end();
  }

  format_context::iterator format(thread::id value,
                                  format_context& context) const {
    __format_detail::__spec specification =
        __format_detail::__parse_spec(
            string_view(__specification_data, __specification_size),
            &context.__arguments());
    __format_detail::__format_builtin(
        hash<thread::id>{}(value), specification,
        context.__buffer(), &context.__arguments());
    return context.out();
  }
};

class jthread {
  template <class Function, class... Args>
  void __start_pointer(true_type, Function function, Args... arguments) {
    __thread_ = thread(function, __source_.get_token(),
                       std::move(arguments)...);
  }

  template <class Function, class... Args>
  void __start_pointer(false_type, Function function, Args... arguments) {
    __thread_ = thread(function, std::move(arguments)...);
  }

  template <class Function, class... Args>
  static thread __make_thread_impl(true_type, stop_token token,
                                   Function function, Args... arguments) {
    using invocation =
        __thread_detail::__stoppable_invocation<
            Function, Args...>;
    return thread(invocation(
        std::move(token), std::move(function),
        std::move(arguments)...));
  }

  template <class Function, class... Args>
  static thread __make_thread_impl(false_type, stop_token,
                                   Function function, Args... arguments) {
    using invocation =
        __thread_detail::__plain_invocation<
            Function, Args...>;
    return thread(invocation(
        std::move(function), std::move(arguments)...));
  }

  template <class Function, class... Args>
  static thread __make_thread(stop_token token, Function function,
                              Args... arguments) {
    using accepts_stop_token =
        typename is_invocable<Function, stop_token, Args...>::type;
    return __make_thread_impl(
        accepts_stop_token(), std::move(token),
        std::move(function), std::move(arguments)...);
  }

 public:
  using id = thread::id;
  using native_handle_type = thread::native_handle_type;

  jthread() noexcept : __source_(nostopstate), __thread_() {}

  template <class Function, class... Args>
    requires (
        is_pointer<Function>::value &&
        (is_invocable<Function, stop_token, decay_t<Args>...>::value ||
         is_invocable<Function, decay_t<Args>...>::value))
  explicit jthread(Function function, Args&&... arguments)
      : __source_(), __thread_() {
    using accepts_stop_token =
        typename is_invocable<Function, stop_token,
                              decay_t<Args>...>::type;
    __start_pointer(
        accepts_stop_token(), function,
        __thread_detail::__decay_copy(
            static_cast<Args&&>(arguments))...);
  }

  template <class Function, class... Args>
    requires (
        !is_same_v<remove_cvref_t<Function>, jthread> &&
        !is_pointer<decay_t<Function>>::value &&
        (is_invocable<decay_t<Function>, stop_token,
                      decay_t<Args>...>::value ||
         is_invocable<decay_t<Function>, decay_t<Args>...>::value))
  explicit jthread(Function&& function, Args&&... arguments)
      : __source_(),
        __thread_(__make_thread(
            __source_.get_token(),
            __thread_detail::__decay_copy(
                static_cast<Function&&>(function)),
            __thread_detail::__decay_copy(
                static_cast<Args&&>(arguments))...)) {}

  ~jthread() {
    if (joinable()) {
      request_stop();
      join();
    }
  }

  jthread(const jthread&) = delete;
  jthread& operator=(const jthread&) = delete;

  jthread(jthread&& other) noexcept
      : __source_(std::move(other.__source_)),
        __thread_(std::move(other.__thread_)) {}

  jthread& operator=(jthread&& other) noexcept {
    if (this != &other) {
      if (joinable()) {
        request_stop();
        join();
      }
      __source_ = std::move(other.__source_);
      __thread_ = std::move(other.__thread_);
    }
    return *this;
  }

  void swap(jthread& other) noexcept {
    __source_.swap(other.__source_);
    __thread_.swap(other.__thread_);
  }

  bool joinable() const noexcept { return __thread_.joinable(); }
  void join() { __thread_.join(); }
  void detach() { __thread_.detach(); }
  id get_id() const noexcept { return __thread_.get_id(); }
  native_handle_type native_handle() { return __thread_.native_handle(); }

  stop_source get_stop_source() noexcept { return __source_; }
  stop_token get_stop_token() const noexcept {
    return __source_.get_token();
  }
  bool request_stop() noexcept { return __source_.request_stop(); }

  static unsigned int hardware_concurrency() noexcept {
    return thread::hardware_concurrency();
  }

 private:
  stop_source __source_;
  thread __thread_;
};

inline void swap(jthread& left, jthread& right) noexcept {
  left.swap(right);
}
#endif

namespace this_thread {

inline thread::id get_id() noexcept {
  return thread::__id_from_native_handle(thrd_current());
}

inline void yield() noexcept {
  thrd_yield();
}

template <class Rep, class Period>
void sleep_for(const chrono::duration<Rep, Period>& relative_time) {
  __thread_detail::__sleep_for(relative_time);
}

template <class Clock, class Duration>
void sleep_until(const chrono::time_point<Clock, Duration>& absolute_time) {
  while (Clock::now() < absolute_time) {
    sleep_for(absolute_time - Clock::now());
  }
}

}  // namespace this_thread

}  // namespace std

#endif /* __davecc_thread__ */
