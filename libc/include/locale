class locale {
 public:
  class facet {
   public:
    explicit facet(size_t refs = 0) : __refs_(refs) {}
    facet(const facet&) = delete;
    facet& operator=(const facet&) = delete;

    void __add_ref() const { ++__refs_; }
    void __release() const {
      if (__refs_ != 0 && --__refs_ == 0) {
        delete const_cast<facet*>(this);
      }
    }

   protected:
    virtual ~facet() {}

   private:
    mutable size_t __refs_;
    friend class locale;
  };

  class id {
   public:
    enum __classic_tag { __classic };
    constexpr id() noexcept : __index_(static_cast<size_t>(-1)), __classic_(false) {}
    constexpr id(__classic_tag) noexcept
        : __index_(static_cast<size_t>(-1)), __classic_(true) {}
    size_t __index() const {
      if (__index_ == static_cast<size_t>(-1)) {
        __index_ = __locale_detail::__next_facet_index();
      }
      return __index_;
    }
    bool __provided_by_classic() const { return __classic_; }

   private:
    mutable size_t __index_;
    bool __classic_;
  };

  typedef int category;
  static const category none;
  static const category collate;
  static const category ctype;
  static const category monetary;
  static const category numeric;
  static const category time;
  static const category messages;
  static const category all;

  locale() noexcept;
  locale(const locale& other) noexcept;
  locale(const char* std_name);
  locale(const locale& other, const char* std_name, category cat);
  locale(const locale& other, const locale& add, category cat);
  template <class Facet>
  locale(const locale& other, Facet* facet)
      : __impl_(__replace_facet_impl(other.__impl_, facet, Facet::id)) {}
  ~locale();

  const locale& operator=(const locale& other) noexcept;

  template <class Facet>
  locale combine(const locale& other) const;

  string name() const;
#if __cplusplus >= 202600L
  text_encoding encoding() const;
#endif
  bool operator==(const locale& other) const;
  bool operator!=(const locale& other) const { return !(*this == other); }

  static locale global(const locale& loc);
  static const locale& classic();

  facet* __get_facet(id& facet_id) const;
  const facet* __get_facet(const id& facet_id) const;
  bool __has_facet(const id& facet_id) const;
  bool __is_classic() const;
  void __install_classic_facet(facet* extra, id& facet_id) const;

 private:
  struct __from_impl {};
  __locale_impl* __impl_;

  explicit locale(__locale_impl* impl, __from_impl) noexcept : __impl_(impl) {}
  static __locale_impl* __make_classic();
  static __locale_impl* __make_named(const char* name);
  static __locale_impl* __combine_impl(const __locale_impl* base,
                                       const __locale_impl* add,
                                       category cat);
  static __locale_impl* __replace_facet_impl(const __locale_impl* base,
                                             facet* replacement,
                                             id& facet_id);
  static __locale_impl* __combine_facet_impl(const __locale_impl* base,
                                             const __locale_impl* add,
                                             id& facet_id);
  friend class ios_base;
};

template <class Facet>
locale locale::combine(const locale& other) const {
  return locale(__combine_facet_impl(__impl_, other.__impl_, Facet::id),
                __from_impl());
}

template <class Facet>
void __ensure_classic_facet(const locale& loc) {
  if (loc.__has_facet(Facet::id) || !loc.__is_classic()) {
    return;
  }
  loc.__install_classic_facet(new Facet, Facet::id);
}

template <class Facet>
const Facet& use_facet(const locale& loc) {
  const locale::facet* facet = loc.__get_facet(Facet::id);
  if (facet == nullptr) {
    __ensure_classic_facet<Facet>(loc);
    facet = loc.__get_facet(Facet::id);
  }
  if (facet == nullptr) {
    __locale_detail::__throw_bad_cast();
  }
  return static_cast<const Facet&>(*facet);
}

template <class Facet>
bool has_facet(const locale& loc) {
  if (loc.__has_facet(Facet::id)) {
    return true;
  }
  __ensure_classic_facet<Facet>(loc);
  return loc.__has_facet(Facet::id);
}

template <class InternT, class ExternT, class StateT>
class codecvt : public locale::facet, public codecvt_base {
 public:
  typedef InternT intern_type;
  typedef ExternT extern_type;
  typedef StateT state_type;
  static locale::id id;

  explicit codecvt(size_t refs = 0) : locale::facet(refs) {}

  result out(state_type& state, const intern_type* from,
             const intern_type* from_end, const intern_type*& from_next,
             extern_type* to, extern_type* to_end,
             extern_type*& to_next) const {
    return do_out(state, from, from_end, from_next, to, to_end, to_next);
  }
  result unshift(state_type& state, extern_type* to, extern_type* to_end,
                 extern_type*& to_next) const {
    return do_unshift(state, to, to_end, to_next);
  }
  result in(state_type& state, const extern_type* from,
            const extern_type* from_end, const extern_type*& from_next,
            intern_type* to, intern_type* to_end,
            intern_type*& to_next) const {
    return do_in(state, from, from_end, from_next, to, to_end, to_next);
  }
  int encoding() const noexcept { return do_encoding(); }
  bool always_noconv() const noexcept { return do_always_noconv(); }
  int length(state_type& state, const extern_type* from,
             const extern_type* from_end, size_t max) const {
    return do_length(state, from, from_end, max);
  }
  int max_length() const noexcept { return do_max_length(); }

 protected:
  ~codecvt() override {}

  virtual result do_out(state_type&, const intern_type* from,
                        const intern_type*, const intern_type*& from_next,
                        extern_type* to, extern_type*,
                        extern_type*& to_next) const {
    from_next = from;
    to_next = to;
    return sizeof(intern_type) == sizeof(extern_type) ? noconv : error;
  }
  virtual result do_unshift(state_type&, extern_type* to,
                            extern_type*, extern_type*& to_next) const {
    to_next = to;
    return noconv;
  }
  virtual result do_in(state_type&, const extern_type* from,
                       const extern_type*, const extern_type*& from_next,
                       intern_type* to, intern_type*,
                       intern_type*& to_next) const {
    from_next = from;
    to_next = to;
    return sizeof(intern_type) == sizeof(extern_type) ? noconv : error;
  }
  virtual int do_encoding() const noexcept {
    return sizeof(intern_type) == sizeof(extern_type) ? 1 : 0;
  }
  virtual bool do_always_noconv() const noexcept {
    return sizeof(intern_type) == sizeof(extern_type);
  }
  virtual int do_length(state_type&, const extern_type* from,
                        const extern_type* from_end, size_t max) const {
    size_t available = static_cast<size_t>(from_end - from);
    return static_cast<int>(available < max ? available : max);
  }
  virtual int do_max_length() const noexcept {
    return sizeof(intern_type) == sizeof(extern_type) ? 1 : 4;
  }
};

