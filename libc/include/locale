class __davecc_num_put_char : public locale::facet {
 public:
  typedef char char_type;
  typedef ostreambuf_iterator iter_type;
  static locale::id id;
  explicit __davecc_num_put_char(size_t refs = 0) : locale::facet(refs) {}
  iter_type put(iter_type s, ios_base& f, char_type fill, bool v) const {
