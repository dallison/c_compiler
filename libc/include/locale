template <>
class ctype<char> : public locale::facet, public ctype_base {
 public:
  static locale::id id;

  explicit ctype(size_t refs = 0) : locale::facet(refs) {}

  bool is(mask m, char c) const {
    return (__classic_mask(static_cast<unsigned char>(c)) & m) != 0;
  }
  const char* is(const char* low, const char* high, mask* vec) const {
    while (low != high) {
      *vec++ = __classic_mask(static_cast<unsigned char>(*low++));
    }
    return high;
  }
  const char* scan_is(mask m, const char* low, const char* high) const {
    while (low != high && !is(m, *low)) {
      ++low;
    }
    return low;
  }
  const char* scan_not(mask m, const char* low, const char* high) const {
    while (low != high && is(m, *low)) {
      ++low;
    }
    return low;
  }

  char toupper(char c) const {
    return static_cast<char>(::toupper(static_cast<unsigned char>(c)));
  }
  const char* toupper(char* low, const char* high) const {
    while (low != high) {
      *low = toupper(*low);
      ++low;
    }
    return high;
  }
  char tolower(char c) const {
    return static_cast<char>(::tolower(static_cast<unsigned char>(c)));
  }
  const char* tolower(char* low, const char* high) const {
    while (low != high) {
      *low = tolower(*low);
      ++low;
    }
    return high;
  }

  char widen(char c) const { return c; }
  const char* widen(const char* low, const char* high, char* to) const {
    while (low != high) {
      *to++ = *low++;
    }
    return to;
  }
  char narrow(char c, char dfault) const {
    (void)dfault;
    return c;
  }
  const char* narrow(const char* low, const char* high, char dfault,
                     char* to) const {
    while (low != high) {
      *to++ = narrow(*low++, dfault);
    }
    return to;
  }

 protected:
  ~ctype() override {}

 private:
  static mask __classic_mask(unsigned char c);
};

template <>
class ctype<wchar_t> : public locale::facet, public ctype_base {
 public:
  static locale::id id;

  explicit ctype(size_t refs = 0) : locale::facet(refs) {}

  bool is(mask m, wchar_t c) const {
    return (__classic_wmask(c) & m) != 0;
  }
  const wchar_t* is(const wchar_t* low, const wchar_t* high, mask* vec) const {
    while (low != high) {
      *vec++ = __classic_wmask(*low++);
    }
    return high;
  }
  const wchar_t* scan_is(mask m, const wchar_t* low,
                         const wchar_t* high) const {
    while (low != high && !is(m, *low)) {
      ++low;
    }
    return low;
  }
  const wchar_t* scan_not(mask m, const wchar_t* low,
                          const wchar_t* high) const {
    while (low != high && is(m, *low)) {
      ++low;
    }
    return low;
  }

  wchar_t toupper(wchar_t c) const {
    if (c >= L'a' && c <= L'z') {
      return static_cast<wchar_t>(c - (L'a' - L'A'));
    }
    return c;
  }
  const wchar_t* toupper(wchar_t* low, const wchar_t* high) const {
    while (low != high) {
      *low = toupper(*low);
      ++low;
    }
    return high;
  }
  wchar_t tolower(wchar_t c) const {
    if (c >= L'A' && c <= L'Z') {
      return static_cast<wchar_t>(c + (L'a' - L'A'));
    }
    return c;
  }
  const wchar_t* tolower(wchar_t* low, const wchar_t* high) const {
    while (low != high) {
      *low = tolower(*low);
      ++low;
    }
    return high;
  }

  wchar_t widen(char c) const { return static_cast<wchar_t>(c); }
  const char* widen(const char* low, const char* high, wchar_t* to) const {
    while (low != high) {
      *to++ = widen(*low++);
    }
    return to;
  }
  char narrow(wchar_t c, char dfault) const {
    if (c >= 0 && c <= 0x7f) {
      return static_cast<char>(c);
    }
    return dfault;
  }
  const wchar_t* narrow(const wchar_t* low, const wchar_t* high, char dfault,
                        char* to) const {
    while (low != high) {
      *to++ = narrow(*low++, dfault);
    }
    return to;
  }

 protected:
  ~ctype() override {}

 private:
  static mask __classic_wmask(wchar_t c);
};

