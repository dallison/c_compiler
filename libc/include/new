//
//  new
//  c_compiler
//
//  Minimal C++ dynamic memory header for DaveCC.  Declares the global
//  allocation and deallocation functions so they can be called directly
//  (e.g. `::operator new(n)` / `::operator delete(p)`), and provides the
//  placement / nothrow forms plus the standard support types.
//

#ifndef new_h
#define new_h

#include <stddef.h>  // size_t

namespace std {

// Tag type selecting the non-throwing overloads of operator new.
struct nothrow_t {
};

extern const nothrow_t nothrow;

typedef void (*new_handler)();
new_handler set_new_handler(new_handler handler) noexcept;
new_handler get_new_handler() noexcept;

struct bad_alloc {
  bad_alloc() noexcept;
  const char* what() const noexcept;
};

}  // namespace std

// Single-object and array allocation / deallocation.  The throwing forms are
// provided by the C++ runtime (libc/cxx_new.c) and mangle to the Itanium ABI
// names _Znwm/_Znam/_ZdlPv/_ZdaPv on LP64 targets.
void* operator new(size_t size);
void* operator new[](size_t size);
void operator delete(void* ptr) noexcept;
void operator delete[](void* ptr) noexcept;

// Sized deallocation: forwards to the plain deallocator.
void operator delete(void* ptr, size_t) noexcept;
void operator delete[](void* ptr, size_t) noexcept;

// Non-throwing allocation / deallocation.  The DaveCC runtime allocator never
// throws, so these simply forward to the ordinary forms.
void* operator new(size_t size, const std::nothrow_t&) noexcept;
void* operator new[](size_t size, const std::nothrow_t&) noexcept;
void operator delete(void* ptr, const std::nothrow_t&) noexcept;
void operator delete[](void* ptr, const std::nothrow_t&) noexcept;

// Placement new / delete. The matching placement deletes are no-ops, invoked
// only when a placement-new constructor throws.
void* operator new(size_t, void* ptr) noexcept;
void* operator new[](size_t, void* ptr) noexcept;
void operator delete(void*, void*) noexcept;
void operator delete[](void*, void*) noexcept;

#endif /* new_h */
