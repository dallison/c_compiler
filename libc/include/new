//
//  new
//  c_compiler
//
//  Minimal C++ dynamic memory header for DaveCC.  Declares the global
//  allocation and deallocation functions so they can be called directly
//  (e.g. `::operator new(n)` / `::operator delete(p)`), and provides the
//  placement / nothrow forms plus the standard support types.
//

#ifndef new_h
#define new_h

#include <exception>
#include <stddef.h>  // size_t

#if __cplusplus >= 201103L
#define __DAVECC_NEW_NOEXCEPT noexcept
#define __DAVECC_NEW_CONSTEXPR constexpr
#define __DAVECC_NEW_OVERRIDE override
#else
#define __DAVECC_NEW_NOEXCEPT
#define __DAVECC_NEW_CONSTEXPR
#define __DAVECC_NEW_OVERRIDE
#endif

#if __cplusplus > 202302L
#ifndef __cpp_lib_constexpr_new
#define __cpp_lib_constexpr_new 202406L
#endif
#define __DAVECC_CONSTEXPR_PLACEMENT_NEW constexpr
#else
#define __DAVECC_CONSTEXPR_PLACEMENT_NEW
#endif

namespace std {

// Tag type selecting the non-throwing overloads of operator new.
struct nothrow_t {
};

extern const nothrow_t nothrow;

typedef void (*new_handler)();
new_handler set_new_handler(new_handler handler) __DAVECC_NEW_NOEXCEPT;
new_handler get_new_handler() __DAVECC_NEW_NOEXCEPT;

class bad_alloc : public exception {
 public:
  __DAVECC_NEW_CONSTEXPR bad_alloc() __DAVECC_NEW_NOEXCEPT {}
  __DAVECC_NEW_CONSTEXPR const char* what() const __DAVECC_NEW_NOEXCEPT
      __DAVECC_NEW_OVERRIDE {
    return "std::bad_alloc";
  }
};

#if __cplusplus >= 201103L
class bad_array_new_length : public bad_alloc {
 public:
  constexpr bad_array_new_length() noexcept {}
  constexpr const char* what() const noexcept override {
    return "std::bad_array_new_length";
  }
};
#endif

}  // namespace std

// Single-object and array allocation / deallocation.  The throwing forms are
// provided by the C++ runtime (libc/cxx_new.c) and mangle to the Itanium ABI
// names _Znwm/_Znam/_ZdlPv/_ZdaPv on LP64 targets.
void* operator new(size_t size);
void* operator new[](size_t size);
void operator delete(void* ptr) __DAVECC_NEW_NOEXCEPT;
void operator delete[](void* ptr) __DAVECC_NEW_NOEXCEPT;

#if __cplusplus >= 201402L
// Sized deallocation: forwards to the plain deallocator.
void operator delete(void* ptr, size_t) __DAVECC_NEW_NOEXCEPT;
void operator delete[](void* ptr, size_t) __DAVECC_NEW_NOEXCEPT;
#endif

// Non-throwing allocation / deallocation.  The DaveCC runtime allocator never
// throws, so these simply forward to the ordinary forms.
void* operator new(size_t size, const std::nothrow_t&)
    __DAVECC_NEW_NOEXCEPT;
void* operator new[](size_t size, const std::nothrow_t&)
    __DAVECC_NEW_NOEXCEPT;
void operator delete(void* ptr, const std::nothrow_t&)
    __DAVECC_NEW_NOEXCEPT;
void operator delete[](void* ptr, const std::nothrow_t&)
    __DAVECC_NEW_NOEXCEPT;

// Placement new / delete. The matching placement deletes are no-ops, invoked
// only when a placement-new constructor throws.
__DAVECC_CONSTEXPR_PLACEMENT_NEW void* operator new(size_t, void* ptr)
    __DAVECC_NEW_NOEXCEPT;
__DAVECC_CONSTEXPR_PLACEMENT_NEW void* operator new[](size_t,
                                                      void* ptr)
    __DAVECC_NEW_NOEXCEPT;
__DAVECC_CONSTEXPR_PLACEMENT_NEW void operator delete(void*, void*)
    __DAVECC_NEW_NOEXCEPT;
__DAVECC_CONSTEXPR_PLACEMENT_NEW void operator delete[](void*, void*)
    __DAVECC_NEW_NOEXCEPT;

#undef __DAVECC_CONSTEXPR_PLACEMENT_NEW
#undef __DAVECC_NEW_NOEXCEPT
#undef __DAVECC_NEW_CONSTEXPR
#undef __DAVECC_NEW_OVERRIDE

#endif /* new_h */
