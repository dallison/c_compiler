//
//  compare
//  c_compiler
//
//  Minimal C++20 three-way comparison (<=>) support for DaveCC.
//
//  The comparison-category types wrap a single `int _v`
//  (less = -1, equivalent/equal = 0, greater = 1, unordered = 2).  The
//  representation is private and the named values are constructed through a
//  private constructor, as in the standard.  The compiler's built-in `<=>`
//  produces values of these types by storing that value into `_v` directly at
//  the IR level, which does not depend on the member being accessible.  (An
//  `int` is used rather than the conventional `signed char` so the
//  representation does not depend on a backend correctly sign-extending
//  sub-word loads.)
//
//  Comparison against the literal 0 is modelled with an unspecified pointer
//  parameter: the null pointer constant `0` converts to it, but an arbitrary
//  `int` does not, matching the standard requirement that only the literal 0 be
//  accepted.
//
//  Implicit conversions between the categories follow the standard
//  (strong_ordering -> weak_ordering -> partial_ordering).
//

#ifndef compare_h
#define compare_h

namespace std {

namespace __detail {
// Incomplete type used only to form an "unspecified" pointer parameter for the
// comparison-against-literal-0 operators.  Only a null pointer constant (the
// literal 0 or nullptr) is convertible to it, so `cat < 0` is well-formed while
// `cat < n` for an arbitrary `int n` is rejected.
struct __unspec;
}  // namespace __detail

class weak_ordering;
class strong_ordering;

class partial_ordering {
  int _v;
  constexpr explicit partial_ordering(int v) : _v(v) {}
  friend class weak_ordering;
  friend class strong_ordering;

 public:
  constexpr bool operator==(partial_ordering o) const { return _v == o._v; }
  constexpr bool operator!=(partial_ordering o) const { return _v != o._v; }

  constexpr bool operator==(__detail::__unspec*) const { return _v == 0; }
  constexpr bool operator!=(__detail::__unspec*) const { return _v != 0; }
  constexpr bool operator<(__detail::__unspec*) const { return _v < 0; }
  constexpr bool operator>(__detail::__unspec*) const { return _v == 1; }
  constexpr bool operator<=(__detail::__unspec*) const { return _v <= 0; }
  constexpr bool operator>=(__detail::__unspec*) const { return _v == 0 || _v == 1; }

  static constexpr partial_ordering less{-1};
  static constexpr partial_ordering equivalent{0};
  static constexpr partial_ordering greater{1};
  static constexpr partial_ordering unordered{2};
};

class weak_ordering {
  int _v;
  constexpr explicit weak_ordering(int v) : _v(v) {}
  friend class strong_ordering;

 public:
  // Implicit conversion to the weaker category (weak -> partial).
  constexpr operator partial_ordering() const { return partial_ordering{_v}; }

  constexpr bool operator==(weak_ordering o) const { return _v == o._v; }
  constexpr bool operator!=(weak_ordering o) const { return _v != o._v; }

  constexpr bool operator==(__detail::__unspec*) const { return _v == 0; }
  constexpr bool operator!=(__detail::__unspec*) const { return _v != 0; }
  constexpr bool operator<(__detail::__unspec*) const { return _v < 0; }
  constexpr bool operator>(__detail::__unspec*) const { return _v == 1; }
  constexpr bool operator<=(__detail::__unspec*) const { return _v <= 0; }
  constexpr bool operator>=(__detail::__unspec*) const { return _v == 0 || _v == 1; }

  static constexpr weak_ordering less{-1};
  static constexpr weak_ordering equivalent{0};
  static constexpr weak_ordering greater{1};
};

class strong_ordering {
  int _v;
  constexpr explicit strong_ordering(int v) : _v(v) {}

 public:
  // Implicit conversions to the weaker categories (strong -> weak -> partial).
  constexpr operator weak_ordering() const { return weak_ordering{_v}; }
  constexpr operator partial_ordering() const { return partial_ordering{_v}; }

  constexpr bool operator==(strong_ordering o) const { return _v == o._v; }
  constexpr bool operator!=(strong_ordering o) const { return _v != o._v; }

  constexpr bool operator==(__detail::__unspec*) const { return _v == 0; }
  constexpr bool operator!=(__detail::__unspec*) const { return _v != 0; }
  constexpr bool operator<(__detail::__unspec*) const { return _v < 0; }
  constexpr bool operator>(__detail::__unspec*) const { return _v == 1; }
  constexpr bool operator<=(__detail::__unspec*) const { return _v <= 0; }
  constexpr bool operator>=(__detail::__unspec*) const { return _v == 0 || _v == 1; }

  static constexpr strong_ordering less{-1};
  static constexpr strong_ordering equal{0};
  static constexpr strong_ordering equivalent{0};
  static constexpr strong_ordering greater{1};
};

}  // namespace std

#endif /* compare_h */
