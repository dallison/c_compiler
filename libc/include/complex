template <class T>
inline complex<T> pow(const complex<T>& base, int exponent) {
  bool negative = exponent < 0;
  unsigned int remaining =
      negative ? 0u - static_cast<unsigned int>(exponent)
               : static_cast<unsigned int>(exponent);
  complex<T> result(T(1));
  complex<T> factor(base);
  while (remaining != 0) {
    if ((remaining & 1u) != 0) {
      result *= factor;
    }
    remaining >>= 1;
    if (remaining != 0) {
      factor *= factor;
    }
  }
  return negative ? complex<T>(T(1)) / result : result;
}
