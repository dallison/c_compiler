template <class T>
inline __DAVECC_COMPLEX_TRANSCENDENTAL_CONSTEXPR complex<T> asin(
    const complex<T>& value) {
  const complex<T> i(T(), T(1));
  return -i * log(i * value + sqrt(complex<T>(T(1)) - value * value));
}
template <class T>
inline __DAVECC_COMPLEX_TRANSCENDENTAL_CONSTEXPR complex<T> acos(
    const complex<T>& value) {
  const T half_pi =
      static_cast<T>(std::atan2(1.0, 0.0));
  return complex<T>(half_pi) - asin(value);
}
template <class T>
inline __DAVECC_COMPLEX_TRANSCENDENTAL_CONSTEXPR complex<T> atan(
    const complex<T>& value) {
  const complex<T> i(T(), T(1));
  return (i / T(2)) *
         (log(complex<T>(T(1)) - i * value) -
          log(complex<T>(T(1)) + i * value));
}

template <class T>
inline __DAVECC_COMPLEX_TRANSCENDENTAL_CONSTEXPR complex<T> asinh(
    const complex<T>& value) {
  return log(value + sqrt(value * value + complex<T>(T(1))));
}

template <class T>
inline __DAVECC_COMPLEX_TRANSCENDENTAL_CONSTEXPR complex<T> acosh(
    const complex<T>& value) {
  return log(value + sqrt(value + complex<T>(T(1))) *
                         sqrt(value - complex<T>(T(1))));
}

template <class T>
inline __DAVECC_COMPLEX_TRANSCENDENTAL_CONSTEXPR complex<T> atanh(
    const complex<T>& value) {
  return (log(complex<T>(T(1)) + value) -
          log(complex<T>(T(1)) - value)) /
         T(2);
}

template <class CharT, class Traits, class T>
basic_ostream<CharT, Traits>& operator<<(basic_ostream<CharT, Traits>& output,
                                        const complex<T>& value) {
  basic_ostringstream<CharT, Traits> buffer;
  buffer.flags(output.flags());
  buffer.imbue(output.getloc());
  buffer.precision(output.precision());
  buffer << CharT('(') << value.real() << CharT(',') << value.imag()
         << CharT(')');
  return output << buffer.str();
}

template <class CharT, class Traits, class T>
basic_istream<CharT, Traits>& operator>>(basic_istream<CharT, Traits>& input,
                                        complex<T>& value) {
  T real_value = T();
  T imag_value = T();
  CharT ch = CharT();
  input >> ch;
  if (ch == CharT('(')) {
    input >> real_value >> ch;
    if (ch == CharT(',')) {
      input >> imag_value >> ch;
      if (ch != CharT(')')) {
        input.setstate(ios_base::failbit);
      }
    } else if (ch == CharT(')')) {
      imag_value = T();
    } else {
      input.setstate(ios_base::failbit);
    }
  } else {
    input.putback(ch);
    input >> real_value;
  }
  if (input) {
    value = complex<T>(real_value, imag_value);
  }
  return input;
}

