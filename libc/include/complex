template <class T>
class complex {
 public:
  typedef T value_type;

  __DAVECC_COMPLEX_CXX14_CONSTEXPR
  complex(const T& real_value = T(), const T& imag_value = T())
      : __real_(real_value), __imag_(imag_value) {}

  template <class U>
#if __cplusplus >= 202302L
  explicit(!requires(U value) { T{value}; })
  __DAVECC_COMPLEX_CXX14_CONSTEXPR complex(const complex<U>& other)
      : __real_(static_cast<T>(other.real())),
        __imag_(static_cast<T>(other.imag())) {}
#elif __cplusplus >= 201103L
  __DAVECC_COMPLEX_CXX14_CONSTEXPR complex(
      const complex<U>& other,
      typename enable_if<
          __complex_conversion_is_implicit<T, U>::value, int>::type* = 0)
      : __real_(static_cast<T>(other.real())),
        __imag_(static_cast<T>(other.imag())) {}

  template <class U>
  explicit __DAVECC_COMPLEX_CXX14_CONSTEXPR complex(
      const complex<U>& other,
      typename enable_if<
          !__complex_conversion_is_implicit<T, U>::value, long>::type* = 0)
      : __real_(static_cast<T>(other.real())),
        __imag_(static_cast<T>(other.imag())) {}
#else
  complex(const complex<U>& other)
      : __real_(static_cast<T>(other.real())),
        __imag_(static_cast<T>(other.imag())) {}
#endif

  __DAVECC_COMPLEX_CXX14_CONSTEXPR T real() const { return __real_; }
  __DAVECC_COMPLEX_CXX14_CONSTEXPR T imag() const { return __imag_; }
  __DAVECC_COMPLEX_CXX20_CONSTEXPR void real(T value) { __real_ = value; }
  __DAVECC_COMPLEX_CXX20_CONSTEXPR void imag(T value) { __imag_ = value; }

  __DAVECC_COMPLEX_CXX20_CONSTEXPR complex& operator=(const T& value) {
    __real_ = value;
    __imag_ = T();
    return *this;
  }

  __DAVECC_COMPLEX_CXX20_CONSTEXPR complex& operator+=(const T& value) {
    __real_ += value;
    return *this;
  }
  __DAVECC_COMPLEX_CXX20_CONSTEXPR complex& operator-=(const T& value) {
    __real_ -= value;
    return *this;
  }
  __DAVECC_COMPLEX_CXX20_CONSTEXPR complex& operator*=(const T& value) {
    __real_ *= value;
    __imag_ *= value;
    return *this;
  }
  __DAVECC_COMPLEX_CXX20_CONSTEXPR complex& operator/=(const T& value) {
    __real_ /= value;
    __imag_ /= value;
    return *this;
  }

  template <class U>
  __DAVECC_COMPLEX_CXX20_CONSTEXPR complex& operator+=(
      const complex<U>& value) {
    __real_ += static_cast<T>(value.real());
    __imag_ += static_cast<T>(value.imag());
    return *this;
  }
  template <class U>
  __DAVECC_COMPLEX_CXX20_CONSTEXPR complex& operator-=(
      const complex<U>& value) {
    __real_ -= static_cast<T>(value.real());
    __imag_ -= static_cast<T>(value.imag());
    return *this;
  }
  template <class U>
  __DAVECC_COMPLEX_CXX20_CONSTEXPR complex& operator*=(
      const complex<U>& value) {
    T a = __real_;
    T b = __imag_;
    T c = static_cast<T>(value.real());
    T d = static_cast<T>(value.imag());
    __real_ = a * c - b * d;
    __imag_ = a * d + b * c;
    return *this;
  }
  template <class U>
  __DAVECC_COMPLEX_CXX20_CONSTEXPR complex& operator/=(
      const complex<U>& value) {
    T a = __real_;
    T b = __imag_;
    T c = static_cast<T>(value.real());
    T d = static_cast<T>(value.imag());
    T absolute_c = c < T() ? -c : c;
    T absolute_d = d < T() ? -d : d;
    if (absolute_c >= absolute_d) {
      T ratio = d / c;
      T denominator = T(1) + ratio * ratio;
      __real_ = (a / c + (b / c) * ratio) / denominator;
      __imag_ = (b / c - (a / c) * ratio) / denominator;
    } else {
      T ratio = c / d;
      T denominator = T(1) + ratio * ratio;
      __real_ = ((a / d) * ratio + b / d) / denominator;
      __imag_ = ((b / d) * ratio - a / d) / denominator;
    }
    return *this;
  }

#if __cplusplus >= 202600L
  constexpr T& __real_ref() { return __real_; }
  constexpr const T& __real_ref() const { return __real_; }
  constexpr T& __imag_ref() { return __imag_; }
  constexpr const T& __imag_ref() const { return __imag_; }
#endif

 private:
  T __real_;
  T __imag_;
};

