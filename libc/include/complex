template <class T>
inline __DAVECC_COMPLEX_TRANSCENDENTAL_CONSTEXPR complex<T> exp(
    const complex<T>& value) {
  T scale = static_cast<T>(std::exp(static_cast<double>(value.real())));
  return polar(scale, value.imag());
}
template <class T>
inline __DAVECC_COMPLEX_TRANSCENDENTAL_CONSTEXPR complex<T> log(
    const complex<T>& value) {
  return complex<T>(
      static_cast<T>(std::log(static_cast<double>(abs(value)))),
      arg(value));
}
template <class T>
inline __DAVECC_COMPLEX_TRANSCENDENTAL_CONSTEXPR complex<T> log10(
    const complex<T>& value) {
  return log(value) / static_cast<T>(std::log(10.0));
}
template <class T>
inline __DAVECC_COMPLEX_TRANSCENDENTAL_CONSTEXPR complex<T> sqrt(
    const complex<T>& value) {
  T magnitude = abs(value);
  T real_part = static_cast<T>(
      std::sqrt(static_cast<double>((magnitude + value.real()) / T(2))));
  T imag_part = static_cast<T>(
      std::sqrt(static_cast<double>((magnitude - value.real()) / T(2))));
  imag_part = static_cast<T>(
      std::copysign(static_cast<double>(imag_part),
                    static_cast<double>(value.imag())));
  return complex<T>(real_part, imag_part);
}

template <class T>
inline __DAVECC_COMPLEX_TRANSCENDENTAL_CONSTEXPR complex<T> sin(
    const complex<T>& value) {
  double y = static_cast<double>(value.imag());
  double ey = std::exp(y);
  double emy = std::exp(-y);
  T cosh_y = static_cast<T>((ey + emy) / 2.0);
  T sinh_y = static_cast<T>((ey - emy) / 2.0);
  return complex<T>(
      static_cast<T>(std::sin(static_cast<double>(value.real()))) * cosh_y,
      static_cast<T>(std::cos(static_cast<double>(value.real()))) * sinh_y);
}
template <class T>
inline __DAVECC_COMPLEX_TRANSCENDENTAL_CONSTEXPR complex<T> cos(
    const complex<T>& value) {
  double y = static_cast<double>(value.imag());
  double ey = std::exp(y);
  double emy = std::exp(-y);
  T cosh_y = static_cast<T>((ey + emy) / 2.0);
  T sinh_y = static_cast<T>((ey - emy) / 2.0);
  return complex<T>(
      static_cast<T>(std::cos(static_cast<double>(value.real()))) * cosh_y,
      -static_cast<T>(std::sin(static_cast<double>(value.real()))) * sinh_y);
}
template <class T>
inline __DAVECC_COMPLEX_TRANSCENDENTAL_CONSTEXPR complex<T> tan(
    const complex<T>& value) {
  return sin(value) / cos(value);
}
template <class T>
inline __DAVECC_COMPLEX_TRANSCENDENTAL_CONSTEXPR complex<T> sinh(
    const complex<T>& value) {
  return (exp(value) - exp(-value)) / T(2);
}
template <class T>
inline __DAVECC_COMPLEX_TRANSCENDENTAL_CONSTEXPR complex<T> cosh(
    const complex<T>& value) {
  return (exp(value) + exp(-value)) / T(2);
}
template <class T>
inline __DAVECC_COMPLEX_TRANSCENDENTAL_CONSTEXPR complex<T> tanh(
    const complex<T>& value) {
  return sinh(value) / cosh(value);
}

