//
//  string
//  c_compiler
//
//  C++20 std::string (basic_string) support for DaveCC.
//
//  The storage model mirrors DaveCC's own `String` class: a small inline
//  buffer avoids a heap allocation for short strings, and longer strings spill
//  into malloc'd memory that grows geometrically.  `__data` always points at
//  either the inline buffer or the heap block, the content is always NUL
//  terminated at `__data[__size]`, and `__cap` counts the total number of
//  elements available including the slot for that terminator.
//

#ifndef __davecc_string__
#define __davecc_string__

#include <__char_traits>
#include <__exception_support>
#if __cplusplus >= 202002L
#include <compare>
#endif
// libstdc++'s <string> provides errno (through its numeric conversions), and
// code that calls strerror(errno) after including only <string> relies on it.
#include <cerrno>
#include <cstddef>
#include <initializer_list>
#include <iterator>
#include <memory>
#if __cplusplus >= 201703L
#include <memory_resource>
#endif
#include <stdlib.h>
#include <string.h>
#include <type_traits>

#if __cplusplus >= 202002L
#define __DAVECC_STRING_CONSTEXPR constexpr
#else
#define __DAVECC_STRING_CONSTEXPR
#endif

namespace std {

template <class T>
struct hash;

// Forward declaration for the string_view conversion operator below; the full
// definition lives in <string_view>.  A translation unit that actually uses the
// conversion (or the string_view-taking members) must include <string_view>.
template <class CharT, class Traits>
class basic_string_view;

namespace __string_detail {
[[noreturn]] constexpr void __throw_out_of_range(const char* what);
}  // namespace __string_detail

template <class CharT, class Traits = char_traits<CharT>,
          class Allocator = allocator<CharT>>
class basic_string {
 public:
  using traits_type = Traits;
  using value_type = CharT;
  using allocator_type = Allocator;
  using size_type = size_t;
  using difference_type = ptrdiff_t;
  using reference = CharT&;
  using const_reference = const CharT&;
  using pointer = CharT*;
  using const_pointer = const CharT*;
  using iterator = CharT*;
  using const_iterator = const CharT*;
  using reverse_iterator = std::reverse_iterator<iterator>;
  using const_reverse_iterator = std::reverse_iterator<const_iterator>;

#if __cplusplus >= 201703L
  static constexpr size_type npos = static_cast<size_type>(-1);
#else
  static const size_type npos = static_cast<size_type>(-1);
#endif

 private:
  static const size_type __sso_capacity = 16;

  CharT __buf[__sso_capacity];
  CharT* __data;
  size_type __size;
  size_type __cap;  // Total element slots, including the NUL terminator slot.
  allocator_type __alloc;  // Stateless for std::allocator; stored for the API.

  constexpr bool __is_small() const noexcept { return __data == __buf; }

  constexpr void __set_empty() noexcept {
    __data = __buf;
    __size = 0;
    __cap = __sso_capacity;
    __buf[0] = CharT();
  }

  // Take ownership of other's buffer.  `*this` must not currently own a heap
  // block: the caller is a constructor, or it has already deallocated.
  constexpr void __adopt(basic_string& other) noexcept {
    if (other.__is_small()) {
      __data = __buf;
      __cap = __sso_capacity;
      __size = other.__size;
      traits_type::copy(__buf, other.__buf, other.__size + 1);
    } else {
      __data = other.__data;
      __cap = other.__cap;
      __size = other.__size;
    }
    other.__set_empty();
  }

  // Ensure room for at least `need` characters plus a terminator, preserving
  // the current contents.  Grows geometrically to keep append amortized O(1).
  constexpr void __reserve_for(size_type need) {
    if (need + 1 <= __cap) {
      return;
    }
    size_type newcap = __cap + __cap / 2;
    if (newcap < need + 1) {
      newcap = need + 1;
    }
    CharT* fresh = __alloc.allocate(newcap);
    if (__size != 0) {
      traits_type::copy(fresh, __data, __size);
    }
    fresh[__size] = CharT();
    if (!__is_small()) {
      __alloc.deallocate(__data, __cap);
    }
    __data = fresh;
    __cap = newcap;
  }

  // Replace the whole contents with `n` characters copied from `src` (which may
  // alias nothing inside this object).
  constexpr void __assign_raw(const CharT* src, size_type n) {
    __reserve_for(n);
    if (n != 0) {
      traits_type::copy(__data, src, n);
    }
    __size = n;
    __data[n] = CharT();
  }

 public:
  constexpr basic_string() noexcept : __alloc(Allocator()) { __set_empty(); }

  constexpr basic_string(const CharT* s) : __alloc(Allocator()) {
    __set_empty();
    __assign_raw(s, traits_type::length(s));
  }

  __DAVECC_STRING_CONSTEXPR basic_string(const CharT* s, size_type n) : __alloc(Allocator()) {
    __set_empty();
    __assign_raw(s, n);
  }

#if __cplusplus >= 201103L
  template <class InputIt,
            enable_if_t<!is_integral_v<InputIt>, int> = 0>
#else
  template <class InputIt>
#endif
  __DAVECC_STRING_CONSTEXPR basic_string(InputIt first, InputIt last) : __alloc(Allocator()) {
    __set_empty();
    for (; first != last; ++first) {
      push_back(static_cast<CharT>(*first));
    }
  }

  __DAVECC_STRING_CONSTEXPR basic_string(initializer_list<CharT> il)
      : __alloc(Allocator()) {
    __set_empty();
    __assign_raw(il.begin(), static_cast<size_type>(il.size()));
  }

  // Construct from anything that views characters (notably basic_string_view).
  // Requires the complete view type at the point of instantiation.
  __DAVECC_STRING_CONSTEXPR explicit basic_string(basic_string_view<CharT, traits_type> sv)
      : __alloc(Allocator()) {
    __set_empty();
    __assign_raw(sv.data(), sv.size());
  }

  __DAVECC_STRING_CONSTEXPR basic_string(size_type n, CharT c) : __alloc(Allocator()) {
    __set_empty();
    __reserve_for(n);
    if (n != 0) {
      traits_type::assign(__data, n, c);
    }
    __size = n;
    __data[n] = CharT();
  }

  __DAVECC_STRING_CONSTEXPR basic_string(const basic_string& other) : __alloc(other.__alloc) {
    __set_empty();
    __assign_raw(other.__data, other.__size);
  }

  __DAVECC_STRING_CONSTEXPR basic_string(const basic_string& other, size_type pos, size_type n = npos)
      : __alloc(Allocator()) {
    __set_empty();
    if (pos > other.__size) {
      __string_detail::__throw_out_of_range("basic_string::basic_string");
    }
    size_type avail = other.__size - pos;
    if (n > avail) {
      n = avail;
    }
    __assign_raw(other.__data + pos, n);
  }

  __DAVECC_STRING_CONSTEXPR basic_string(basic_string&& other) noexcept : __alloc(other.__alloc) {
    __adopt(other);
  }

  // Allocator-extended constructors.  std::allocator is stateless, so the
  // stored allocator never alters behavior, but exposing these keeps the type
  // allocator-aware and matches the standard's overload set.
  __DAVECC_STRING_CONSTEXPR explicit basic_string(const Allocator& a) noexcept : __alloc(a) {
    __set_empty();
  }

  __DAVECC_STRING_CONSTEXPR basic_string(size_type n, CharT c, const Allocator& a) : __alloc(a) {
    __set_empty();
    __reserve_for(n);
    if (n != 0) {
      traits_type::assign(__data, n, c);
    }
    __size = n;
    __data[n] = CharT();
  }

  __DAVECC_STRING_CONSTEXPR basic_string(const CharT* s, const Allocator& a) : __alloc(a) {
    __set_empty();
    __assign_raw(s, traits_type::length(s));
  }

  __DAVECC_STRING_CONSTEXPR basic_string(const basic_string& other, const Allocator& a) : __alloc(a) {
    __set_empty();
    __assign_raw(other.__data, other.__size);
  }

  __DAVECC_STRING_CONSTEXPR basic_string(basic_string&& other, const Allocator& a)
      noexcept(allocator_traits<Allocator>::is_always_equal::value)
      : __alloc(a) {
    if (__alloc == other.__alloc) {
      __adopt(other);
    } else {
      __set_empty();
      __assign_raw(other.__data, other.__size);
    }
  }

  constexpr ~basic_string() {
    if (!__is_small()) {
      __alloc.deallocate(__data, __cap);
    }
  }

  __DAVECC_STRING_CONSTEXPR basic_string& operator=(const basic_string& other) {
    if (this != &other) {
      constexpr bool propagate = allocator_traits<
          Allocator>::propagate_on_container_copy_assignment::value;
      if constexpr (propagate) {
        if (!(__alloc == other.__alloc) && !__is_small()) {
          __alloc.deallocate(__data, __cap);
          __set_empty();
        }
        __alloc = other.__alloc;
      }
      __assign_raw(other.__data, other.__size);
    }
    return *this;
  }

  __DAVECC_STRING_CONSTEXPR basic_string& operator=(basic_string&& other) noexcept(
      allocator_traits<Allocator>::propagate_on_container_move_assignment::value ||
      allocator_traits<Allocator>::is_always_equal::value) {
    if (this != &other) {
      constexpr bool propagate = allocator_traits<
          Allocator>::propagate_on_container_move_assignment::value;
      if (propagate || __alloc == other.__alloc) {
        if (!__is_small()) {
          __alloc.deallocate(__data, __cap);
        }
        __adopt(other);
        if constexpr (propagate) {
          __alloc = static_cast<Allocator&&>(other.__alloc);
        }
      } else {
        __assign_raw(other.__data, other.__size);
      }
    }
    return *this;
  }

  __DAVECC_STRING_CONSTEXPR basic_string& operator=(const CharT* s) {
    __assign_raw(s, traits_type::length(s));
    return *this;
  }

  __DAVECC_STRING_CONSTEXPR basic_string& operator=(
      basic_string_view<CharT, Traits> sv) {
    return assign(sv.data(), sv.size());
  }

  __DAVECC_STRING_CONSTEXPR basic_string& operator=(initializer_list<CharT> il) {
    return assign(il.begin(), static_cast<size_type>(il.size()));
  }

  __DAVECC_STRING_CONSTEXPR basic_string& operator=(CharT c) {
    __reserve_for(1);
    __data[0] = c;
    __data[1] = CharT();
    __size = 1;
    return *this;
  }

  __DAVECC_STRING_CONSTEXPR allocator_type get_allocator() const noexcept { return __alloc; }

  // Element access.
  __DAVECC_STRING_CONSTEXPR reference operator[](size_type pos) { return __data[pos]; }
  __DAVECC_STRING_CONSTEXPR const_reference operator[](size_type pos) const { return __data[pos]; }
  __DAVECC_STRING_CONSTEXPR reference at(size_type pos) {
    if (pos >= __size) {
      __string_detail::__throw_out_of_range("basic_string::at");
    }
    return __data[pos];
  }
  __DAVECC_STRING_CONSTEXPR const_reference at(size_type pos) const {
    if (pos >= __size) {
      __string_detail::__throw_out_of_range("basic_string::at");
    }
    return __data[pos];
  }
  __DAVECC_STRING_CONSTEXPR reference front() { return __data[0]; }
  __DAVECC_STRING_CONSTEXPR const_reference front() const { return __data[0]; }
  __DAVECC_STRING_CONSTEXPR reference back() { return __data[__size - 1]; }
  __DAVECC_STRING_CONSTEXPR const_reference back() const { return __data[__size - 1]; }
  __DAVECC_STRING_CONSTEXPR CharT* data() noexcept { return __data; }
  __DAVECC_STRING_CONSTEXPR const CharT* data() const noexcept { return __data; }
  constexpr const CharT* c_str() const noexcept { return __data; }

  // Implicit conversion to a view over the current contents.  Requires the
  // complete basic_string_view (i.e. <string_view> included at the point of
  // use); the forward declaration above is enough to name the operator.
  __DAVECC_STRING_CONSTEXPR operator basic_string_view<CharT, traits_type>() const noexcept {
    return basic_string_view<CharT, traits_type>(__data, __size);
  }

  // Iterators.
  __DAVECC_STRING_CONSTEXPR iterator begin() noexcept { return __data; }
  __DAVECC_STRING_CONSTEXPR const_iterator begin() const noexcept { return __data; }
  __DAVECC_STRING_CONSTEXPR const_iterator cbegin() const noexcept { return __data; }
  __DAVECC_STRING_CONSTEXPR iterator end() noexcept { return __data + __size; }
  __DAVECC_STRING_CONSTEXPR const_iterator end() const noexcept { return __data + __size; }
  __DAVECC_STRING_CONSTEXPR const_iterator cend() const noexcept { return __data + __size; }
  __DAVECC_STRING_CONSTEXPR reverse_iterator rbegin() noexcept { return reverse_iterator(end()); }
  __DAVECC_STRING_CONSTEXPR const_reverse_iterator rbegin() const noexcept {
    return const_reverse_iterator(end());
  }
  __DAVECC_STRING_CONSTEXPR const_reverse_iterator crbegin() const noexcept {
    return const_reverse_iterator(end());
  }
  __DAVECC_STRING_CONSTEXPR reverse_iterator rend() noexcept { return reverse_iterator(begin()); }
  __DAVECC_STRING_CONSTEXPR const_reverse_iterator rend() const noexcept {
    return const_reverse_iterator(begin());
  }
  __DAVECC_STRING_CONSTEXPR const_reverse_iterator crend() const noexcept {
    return const_reverse_iterator(begin());
  }

  // Capacity.
  __DAVECC_STRING_CONSTEXPR size_type size() const noexcept { return __size; }
  __DAVECC_STRING_CONSTEXPR size_type length() const noexcept { return __size; }
  __DAVECC_STRING_CONSTEXPR bool empty() const noexcept { return __size == 0; }
  __DAVECC_STRING_CONSTEXPR size_type capacity() const noexcept { return __cap - 1; }
  __DAVECC_STRING_CONSTEXPR size_type max_size() const noexcept { return npos - 1; }

  __DAVECC_STRING_CONSTEXPR void reserve(size_type new_cap) {
    if (new_cap > capacity()) {
      __reserve_for(new_cap);
    }
  }

  __DAVECC_STRING_CONSTEXPR void shrink_to_fit() {}

  __DAVECC_STRING_CONSTEXPR void clear() noexcept {
    __size = 0;
    __data[0] = CharT();
  }

  __DAVECC_STRING_CONSTEXPR void resize(size_type count, CharT c) {
    if (count > __size) {
      __reserve_for(count);
      traits_type::assign(__data + __size, count - __size, c);
    }
    __size = count;
    __data[__size] = CharT();
  }

  __DAVECC_STRING_CONSTEXPR void resize(size_type count) { resize(count, CharT()); }

  // Modifiers.
  __DAVECC_STRING_CONSTEXPR basic_string& append(const CharT* s, size_type n) {
    __reserve_for(__size + n);
    if (n != 0) {
      traits_type::copy(__data + __size, s, n);
    }
    __size += n;
    __data[__size] = CharT();
    return *this;
  }

  __DAVECC_STRING_CONSTEXPR basic_string& append(const CharT* s) {
    return append(s, traits_type::length(s));
  }

  __DAVECC_STRING_CONSTEXPR basic_string& append(const basic_string& s) {
    return append(s.__data, s.__size);
  }

  __DAVECC_STRING_CONSTEXPR basic_string& append(
      basic_string_view<CharT, Traits> sv) {
    return append(sv.data(), sv.size());
  }

  __DAVECC_STRING_CONSTEXPR basic_string& append(const basic_string& s, size_type pos,
                       size_type n = npos) {
    if (pos > s.__size) {
      __string_detail::__throw_out_of_range("basic_string::append");
    }
    if (n > s.__size - pos) {
      n = s.__size - pos;
    }
    return append(s.__data + pos, n);
  }

  __DAVECC_STRING_CONSTEXPR basic_string& insert(size_type pos, size_type n, CharT c) {
    if (pos > __size) {
      __string_detail::__throw_out_of_range("basic_string::insert");
    }
    __reserve_for(__size + n);
    size_type tail = __size - pos;
    if (tail != 0 && n != 0) {
      traits_type::move(__data + pos + n, __data + pos, tail);
    }
    if (n != 0) {
      traits_type::assign(__data + pos, n, c);
    }
    __size += n;
    __data[__size] = CharT();
    return *this;
  }

  __DAVECC_STRING_CONSTEXPR basic_string& insert(size_type pos,
                                                  const CharT* s,
                                                  size_type n) {
    if (pos > __size) {
      __string_detail::__throw_out_of_range("basic_string::insert");
    }
    // Preserve the source when it points into this string and reserve() moves
    // the allocation or shifting the suffix overlaps the source range.
    basic_string source(s, n);
    __reserve_for(__size + n);
    size_type tail = __size - pos;
    if (tail != 0 && n != 0) {
      traits_type::move(__data + pos + n, __data + pos, tail);
    }
    if (n != 0) {
      traits_type::copy(__data + pos, source.__data, n);
    }
    __size += n;
    __data[__size] = CharT();
    return *this;
  }

  __DAVECC_STRING_CONSTEXPR basic_string& insert(size_type pos,
                                                  const CharT* s) {
    return insert(pos, s, traits_type::length(s));
  }

  __DAVECC_STRING_CONSTEXPR basic_string& insert(
      size_type pos, const basic_string& s) {
    return insert(pos, s.__data, s.__size);
  }

  __DAVECC_STRING_CONSTEXPR basic_string& insert(
      size_type pos, basic_string_view<CharT, Traits> sv) {
    return insert(pos, sv.data(), sv.size());
  }

  __DAVECC_STRING_CONSTEXPR basic_string& insert(
      size_type pos, const basic_string& s, size_type subpos,
      size_type n = npos) {
    if (subpos > s.__size) {
      __string_detail::__throw_out_of_range("basic_string::insert");
    }
    size_type available = s.__size - subpos;
    if (n > available) {
      n = available;
    }
    return insert(pos, s.__data + subpos, n);
  }

  __DAVECC_STRING_CONSTEXPR basic_string& append(size_type n, CharT c) {
    __reserve_for(__size + n);
    if (n != 0) {
      traits_type::assign(__data + __size, n, c);
    }
    __size += n;
    __data[__size] = CharT();
    return *this;
  }

  __DAVECC_STRING_CONSTEXPR basic_string& assign(const CharT* s, size_type n) {
    __size = 0;
    __data[0] = CharT();
    return append(s, n);
  }

  __DAVECC_STRING_CONSTEXPR basic_string& assign(const CharT* s) {
    return assign(s, traits_type::length(s));
  }

  __DAVECC_STRING_CONSTEXPR basic_string& assign(const basic_string& s) {
    return assign(s.__data, s.__size);
  }

  __DAVECC_STRING_CONSTEXPR basic_string& assign(
      basic_string_view<CharT, Traits> sv) {
    return assign(sv.data(), sv.size());
  }

  __DAVECC_STRING_CONSTEXPR basic_string& assign(
      basic_string_view<CharT, Traits> sv, size_type pos,
      size_type n = npos) {
    if (pos > sv.size()) {
      __string_detail::__throw_out_of_range("basic_string::assign");
    }
    size_type available = sv.size() - pos;
    if (n > available) {
      n = available;
    }
    return assign(sv.data() + pos, n);
  }

  __DAVECC_STRING_CONSTEXPR basic_string& assign(initializer_list<CharT> il) {
    return assign(il.begin(), static_cast<size_type>(il.size()));
  }

  __DAVECC_STRING_CONSTEXPR basic_string& assign(size_type n, CharT c) {
    __size = 0;
    __data[0] = CharT();
    return append(n, c);
  }

  // Erases `count` characters starting at `index`.  A count of `npos` erases
  // through the end, which is what `erase(index)` means.
  __DAVECC_STRING_CONSTEXPR basic_string& erase(size_type index = 0, size_type count = npos) {
    if (index > __size) {
      __string_detail::__throw_out_of_range("basic_string::erase");
    }
    if (count > __size - index) {
      count = __size - index;
    }
    size_type tail = __size - index - count;
    if (tail != 0 && count != 0) {
      traits_type::move(__data + index, __data + index + count, tail);
    }
    __size = index + tail;
    __data[__size] = CharT();
    return *this;
  }

  __DAVECC_STRING_CONSTEXPR iterator erase(const_iterator first, const_iterator last) {
    size_type index = static_cast<size_type>(first - __data);
    size_type count = static_cast<size_type>(last - first);
    erase(index, count);
    return __data + index;
  }

  __DAVECC_STRING_CONSTEXPR iterator erase(const_iterator position) {
    return erase(position, position + 1);
  }

  __DAVECC_STRING_CONSTEXPR basic_string& replace(size_type pos, size_type count, size_type n, CharT c) {
    if (pos > __size) {
      __string_detail::__throw_out_of_range("basic_string::replace");
    }
    if (count > __size - pos) {
      count = __size - pos;
    }
    if (n > count) {
      __reserve_for(__size + (n - count));
    }
    size_type tail = __size - pos - count;
    if (n != count && tail != 0) {
      traits_type::move(__data + pos + n, __data + pos + count, tail);
    }
    if (n != 0) {
      traits_type::assign(__data + pos, n, c);
    }
    __size = __size - count + n;
    __data[__size] = CharT();
    return *this;
  }

  __DAVECC_STRING_CONSTEXPR basic_string& replace(
      size_type pos, size_type count, const CharT* s, size_type n) {
    if (pos > __size) {
      __string_detail::__throw_out_of_range("basic_string::replace");
    }
    if (count > __size - pos) {
      count = __size - pos;
    }
    // Preserve sources that point into this string before reserve or suffix
    // movement can invalidate or overwrite them.
    basic_string source(s, n);
    if (n > count) {
      __reserve_for(__size + (n - count));
    }
    size_type tail = __size - pos - count;
    if (n != count && tail != 0) {
      traits_type::move(__data + pos + n, __data + pos + count, tail);
    }
    if (n != 0) {
      traits_type::copy(__data + pos, source.__data, n);
    }
    __size = __size - count + n;
    __data[__size] = CharT();
    return *this;
  }

  __DAVECC_STRING_CONSTEXPR basic_string& replace(
      size_type pos, size_type count, const CharT* s) {
    return replace(pos, count, s, traits_type::length(s));
  }

  __DAVECC_STRING_CONSTEXPR basic_string& replace(
      size_type pos, size_type count, basic_string_view<CharT, Traits> sv) {
    return replace(pos, count, sv.data(), sv.size());
  }

  __DAVECC_STRING_CONSTEXPR basic_string& replace(
      size_type pos, size_type count, const basic_string& s) {
    return replace(pos, count, s.__data, s.__size);
  }

  __DAVECC_STRING_CONSTEXPR void push_back(CharT c) {
    __reserve_for(__size + 1);
    __data[__size] = c;
    __size++;
    __data[__size] = CharT();
  }

  __DAVECC_STRING_CONSTEXPR void pop_back() {
    __size--;
    __data[__size] = CharT();
  }

  __DAVECC_STRING_CONSTEXPR basic_string& operator+=(const basic_string& s) { return append(s); }
  __DAVECC_STRING_CONSTEXPR basic_string& operator+=(const CharT* s) { return append(s); }
  __DAVECC_STRING_CONSTEXPR basic_string& operator+=(
      basic_string_view<CharT, Traits> sv) {
    return append(sv);
  }
  __DAVECC_STRING_CONSTEXPR basic_string& operator+=(initializer_list<CharT> il) {
    return append(il.begin(), static_cast<size_type>(il.size()));
  }
  __DAVECC_STRING_CONSTEXPR basic_string& operator+=(CharT c) {
    push_back(c);
    return *this;
  }

  __DAVECC_STRING_CONSTEXPR void swap(basic_string& other) noexcept(
      allocator_traits<Allocator>::propagate_on_container_swap::value ||
      allocator_traits<Allocator>::is_always_equal::value) {
    basic_string tmp(static_cast<basic_string&&>(*this));
