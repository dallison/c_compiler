//
//  string
//  c_compiler
//
//  C++20 std::string (basic_string) support for DaveCC.
//
//  The storage model mirrors DaveCC's own `String` class: a small inline
//  buffer avoids a heap allocation for short strings, and longer strings spill
//  into malloc'd memory that grows geometrically.  `__data` always points at
//  either the inline buffer or the heap block, the content is always NUL
//  terminated at `__data[__size]`, and `__cap` counts the total number of
//  elements available including the slot for that terminator.
//

#ifndef __davecc_string__
#define __davecc_string__

#include <__char_traits>
#if __cplusplus >= 202002L
#include <compare>
#endif
#include <cstddef>
#include <memory>
#if __cplusplus >= 201703L
#include <memory_resource>
#endif
#include <stdlib.h>
#include <string.h>
#include <type_traits>

namespace std {

template <class T>
struct hash;

// Forward declaration for the string_view conversion operator below; the full
// definition lives in <string_view>.  A translation unit that actually uses the
// conversion (or the string_view-taking members) must include <string_view>.
template <class CharT, class Traits>
class basic_string_view;

template <class CharT, class Traits = char_traits<CharT>,
          class Allocator = allocator<CharT>>
class basic_string {
 public:
  using traits_type = Traits;
  using value_type = CharT;
  using allocator_type = Allocator;
  using size_type = size_t;
  using difference_type = long;
  using reference = CharT&;
  using const_reference = const CharT&;
  using pointer = CharT*;
  using const_pointer = const CharT*;
  using iterator = CharT*;
  using const_iterator = const CharT*;

  static const size_type npos = static_cast<size_type>(-1);

 private:
  static const size_type __sso_capacity = 16;

  CharT __buf[__sso_capacity];
  CharT* __data;
  size_type __size;
  size_type __cap;  // Total element slots, including the NUL terminator slot.
  allocator_type __alloc;  // Stateless for std::allocator; stored for the API.

  constexpr bool __is_small() const noexcept { return __data == __buf; }

  constexpr void __set_empty() noexcept {
    __data = __buf;
    __size = 0;
    __cap = __sso_capacity;
    __buf[0] = CharT();
  }

  // Ensure room for at least `need` characters plus a terminator, preserving
  // the current contents.  Grows geometrically to keep append amortized O(1).
  constexpr void __reserve_for(size_type need) {
    if (need + 1 <= __cap) {
      return;
    }
    size_type newcap = __cap + __cap / 2;
    if (newcap < need + 1) {
      newcap = need + 1;
    }
    CharT* fresh = __alloc.allocate(newcap);
    if (__size != 0) {
      traits_type::copy(fresh, __data, __size);
    }
    fresh[__size] = CharT();
    if (!__is_small()) {
      __alloc.deallocate(__data, __cap);
    }
    __data = fresh;
    __cap = newcap;
  }

  // Replace the whole contents with `n` characters copied from `src` (which may
  // alias nothing inside this object).
  constexpr void __assign_raw(const CharT* src, size_type n) {
    __reserve_for(n);
    if (n != 0) {
      traits_type::copy(__data, src, n);
    }
    __size = n;
    __data[n] = CharT();
  }

 public:
  constexpr basic_string() noexcept : __alloc(Allocator()) { __set_empty(); }

  constexpr basic_string(const CharT* s) : __alloc(Allocator()) {
    __set_empty();
    __assign_raw(s, traits_type::length(s));
  }

  basic_string(const CharT* s, size_type n) : __alloc(Allocator()) {
    __set_empty();
    __assign_raw(s, n);
  }

#if __cplusplus >= 201103L
  template <class InputIt,
            enable_if_t<!is_integral_v<InputIt>, int> = 0>
#else
  template <class InputIt>
#endif
  basic_string(InputIt first, InputIt last) : __alloc(Allocator()) {
    __set_empty();
    for (; first != last; ++first) {
      push_back(static_cast<CharT>(*first));
    }
  }

  // Construct from anything that views characters (notably basic_string_view).
  // Requires the complete view type at the point of instantiation.
  explicit basic_string(basic_string_view<CharT, traits_type> sv)
      : __alloc(Allocator()) {
    __set_empty();
    __assign_raw(sv.data(), sv.size());
  }

  basic_string(size_type n, CharT c) : __alloc(Allocator()) {
    __set_empty();
    __reserve_for(n);
    if (n != 0) {
      traits_type::assign(__data, n, c);
    }
    __size = n;
    __data[n] = CharT();
  }

  basic_string(const basic_string& other) : __alloc(other.__alloc) {
    __set_empty();
    __assign_raw(other.__data, other.__size);
  }

  basic_string(const basic_string& other, size_type pos, size_type n = npos)
      : __alloc(Allocator()) {
    __set_empty();
    if (pos > other.__size) {
      pos = other.__size;
    }
    size_type avail = other.__size - pos;
    if (n > avail) {
      n = avail;
    }
    __assign_raw(other.__data + pos, n);
  }

  basic_string(basic_string&& other) noexcept : __alloc(other.__alloc) {
    if (other.__is_small()) {
      __data = __buf;
      __cap = __sso_capacity;
      __size = other.__size;
      traits_type::copy(__buf, other.__buf, other.__size + 1);
    } else {
      __data = other.__data;
      __cap = other.__cap;
      __size = other.__size;
    }
    other.__set_empty();
  }

  // Allocator-extended constructors.  std::allocator is stateless, so the
  // stored allocator never alters behavior, but exposing these keeps the type
  // allocator-aware and matches the standard's overload set.
  explicit basic_string(const Allocator& a) noexcept : __alloc(a) {
    __set_empty();
  }

  basic_string(size_type n, CharT c, const Allocator& a) : __alloc(a) {
    __set_empty();
    __reserve_for(n);
    if (n != 0) {
      traits_type::assign(__data, n, c);
    }
    __size = n;
    __data[n] = CharT();
  }

  basic_string(const CharT* s, const Allocator& a) : __alloc(a) {
    __set_empty();
    __assign_raw(s, traits_type::length(s));
  }

  basic_string(const basic_string& other, const Allocator& a) : __alloc(a) {
    __set_empty();
    __assign_raw(other.__data, other.__size);
  }

  constexpr ~basic_string() {
    if (!__is_small()) {
      __alloc.deallocate(__data, __cap);
    }
  }

  basic_string& operator=(const basic_string& other) {
    if (this != &other) {
      __assign_raw(other.__data, other.__size);
    }
    return *this;
  }

  basic_string& operator=(basic_string&& other) noexcept {
    if (this != &other) {
      if (!__is_small()) {
        __alloc.deallocate(__data, __cap);
      }
      if (other.__is_small()) {
        __data = __buf;
        __cap = __sso_capacity;
        __size = other.__size;
        traits_type::copy(__buf, other.__buf, other.__size + 1);
      } else {
        __data = other.__data;
        __cap = other.__cap;
        __size = other.__size;
      }
      other.__set_empty();
    }
    return *this;
  }

  basic_string& operator=(const CharT* s) {
    __assign_raw(s, traits_type::length(s));
    return *this;
  }

  basic_string& operator=(CharT c) {
    __reserve_for(1);
    __data[0] = c;
    __data[1] = CharT();
    __size = 1;
    return *this;
  }

  allocator_type get_allocator() const noexcept { return __alloc; }

  // Element access.
  reference operator[](size_type pos) { return __data[pos]; }
  const_reference operator[](size_type pos) const { return __data[pos]; }
  reference at(size_type pos) { return __data[pos]; }
  const_reference at(size_type pos) const { return __data[pos]; }
  reference front() { return __data[0]; }
  const_reference front() const { return __data[0]; }
  reference back() { return __data[__size - 1]; }
  const_reference back() const { return __data[__size - 1]; }
  CharT* data() noexcept { return __data; }
  const CharT* data() const noexcept { return __data; }
  constexpr const CharT* c_str() const noexcept { return __data; }

  // Implicit conversion to a view over the current contents.  Requires the
  // complete basic_string_view (i.e. <string_view> included at the point of
  // use); the forward declaration above is enough to name the operator.
  operator basic_string_view<CharT, traits_type>() const noexcept {
    return basic_string_view<CharT, traits_type>(__data, __size);
  }

  // Iterators.
  iterator begin() noexcept { return __data; }
  const_iterator begin() const noexcept { return __data; }
  const_iterator cbegin() const noexcept { return __data; }
  iterator end() noexcept { return __data + __size; }
  const_iterator end() const noexcept { return __data + __size; }
  const_iterator cend() const noexcept { return __data + __size; }

  // Capacity.
  size_type size() const noexcept { return __size; }
  size_type length() const noexcept { return __size; }
  bool empty() const noexcept { return __size == 0; }
  size_type capacity() const noexcept { return __cap - 1; }
  size_type max_size() const noexcept { return npos - 1; }

  void reserve(size_type new_cap) {
    if (new_cap > capacity()) {
      __reserve_for(new_cap);
    }
  }

  void shrink_to_fit() {}

  void clear() noexcept {
    __size = 0;
    __data[0] = CharT();
  }

  void resize(size_type count, CharT c) {
    if (count > __size) {
      __reserve_for(count);
      traits_type::assign(__data + __size, count - __size, c);
    }
    __size = count;
    __data[__size] = CharT();
  }

  void resize(size_type count) { resize(count, CharT()); }

  // Modifiers.
  basic_string& append(const CharT* s, size_type n) {
    __reserve_for(__size + n);
    if (n != 0) {
      traits_type::copy(__data + __size, s, n);
    }
    __size += n;
    __data[__size] = CharT();
    return *this;
  }

  basic_string& append(const CharT* s) {
    return append(s, traits_type::length(s));
  }

  basic_string& append(const basic_string& s) {
    return append(s.__data, s.__size);
  }

  basic_string& append(size_type n, CharT c) {
    __reserve_for(__size + n);
    if (n != 0) {
      traits_type::assign(__data + __size, n, c);
    }
    __size += n;
    __data[__size] = CharT();
    return *this;
  }

  void push_back(CharT c) {
    __reserve_for(__size + 1);
    __data[__size] = c;
    __size++;
    __data[__size] = CharT();
  }

  void pop_back() {
    __size--;
    __data[__size] = CharT();
  }

  basic_string& operator+=(const basic_string& s) { return append(s); }
  basic_string& operator+=(const CharT* s) { return append(s); }
  basic_string& operator+=(CharT c) {
    push_back(c);
    return *this;
  }

  void swap(basic_string& other) noexcept {
    basic_string tmp(static_cast<basic_string&&>(*this));
    *this = static_cast<basic_string&&>(other);
    other = static_cast<basic_string&&>(tmp);
  }

  // Substrings and search.
  basic_string substr(size_type pos = 0, size_type n = npos) const {
    return basic_string(*this, pos, n);
  }

  int compare(const basic_string& other) const {
    size_type lhs = __size;
    size_type rhs = other.__size;
    size_type n = lhs < rhs ? lhs : rhs;
    int r = traits_type::compare(__data, other.__data, n);
    if (r != 0) {
      return r;
    }
    if (lhs < rhs) {
      return -1;
    }
    if (lhs > rhs) {
      return 1;
    }
    return 0;
  }

  int compare(const CharT* s) const {
    size_type rhs = traits_type::length(s);
    size_type n = __size < rhs ? __size : rhs;
    int r = traits_type::compare(__data, s, n);
    if (r != 0) {
      return r;
    }
    if (__size < rhs) {
      return -1;
    }
    if (__size > rhs) {
      return 1;
    }
    return 0;
  }

  size_type find(const CharT* s, size_type pos, size_type n) const {
    if (n == 0) {
      return pos <= __size ? pos : npos;
    }
    if (pos > __size || __size - pos < n) {
      return npos;
    }
    size_type last = __size - n;
    for (size_type i = pos; i <= last; i++) {
      if (traits_type::compare(__data + i, s, n) == 0) {
        return i;
      }
    }
    return npos;
  }

  size_type find(const basic_string& s, size_type pos = 0) const {
    return find(s.__data, pos, s.__size);
  }

  size_type find(const CharT* s, size_type pos = 0) const {
    return find(s, pos, traits_type::length(s));
  }

  size_type find(CharT c, size_type pos = 0) const {
    for (size_type i = pos; i < __size; i++) {
      if (traits_type::eq(__data[i], c)) {
        return i;
      }
    }
    return npos;
  }

  size_type rfind(CharT c, size_type pos = npos) const {
    if (__size == 0) {
      return npos;
    }
    size_type i = pos < __size ? pos : __size - 1;
    while (true) {
      if (traits_type::eq(__data[i], c)) {
        return i;
      }
      if (i == 0) {
        return npos;
      }
      i--;
    }
  }
};

using string = basic_string<char>;
using wstring = basic_string<wchar_t>;
#if __cplusplus >= 201103L
#if __cplusplus >= 202002L
using u8string = basic_string<char8_t>;
#endif
using u16string = basic_string<char16_t>;
using u32string = basic_string<char32_t>;
#endif

#if __cplusplus >= 201703L
namespace pmr {

using string =
    basic_string<char, char_traits<char>, polymorphic_allocator<char>>;

}  // namespace pmr
#endif

string to_string(int value);
string to_string(unsigned int value);
string to_string(long value);
string to_string(unsigned long value);
string to_string(long long value);
string to_string(unsigned long long value);
string to_string(float value);
string to_string(double value);
string to_string(long double value);

int stoi(const string& input, size_t* pos = nullptr, int base = 10);
long stol(const string& input, size_t* pos = nullptr, int base = 10);
long long stoll(const string& input, size_t* pos = nullptr, int base = 10);
unsigned long stoul(const string& input, size_t* pos = nullptr, int base = 10);
unsigned long long stoull(const string& input, size_t* pos = nullptr,
                          int base = 10);
float stof(const string& input, size_t* pos = nullptr);
double stod(const string& input, size_t* pos = nullptr);
long double stold(const string& input, size_t* pos = nullptr);

// Non-member concatenation.
template <class CharT, class Traits, class Allocator>
basic_string<CharT, Traits, Allocator> operator+(
    const basic_string<CharT, Traits, Allocator>& a,
    const basic_string<CharT, Traits, Allocator>& b) {
  basic_string<CharT, Traits, Allocator> result(a);
  result.append(b);
  return result;
}

template <class CharT, class Traits, class Allocator>
basic_string<CharT, Traits, Allocator> operator+(
    const basic_string<CharT, Traits, Allocator>& a, const CharT* b) {
  basic_string<CharT, Traits, Allocator> result(a);
  result.append(b);
  return result;
}

template <class CharT, class Traits, class Allocator>
basic_string<CharT, Traits, Allocator> operator+(
    const CharT* a, const basic_string<CharT, Traits, Allocator>& b) {
  basic_string<CharT, Traits, Allocator> result(a);
  result.append(b);
  return result;
}

template <class CharT, class Traits, class Allocator>
basic_string<CharT, Traits, Allocator> operator+(
    const basic_string<CharT, Traits, Allocator>& a, CharT b) {
  basic_string<CharT, Traits, Allocator> result(a);
  result.push_back(b);
  return result;
}

// Comparisons.
template <class CharT, class Traits, class Allocator>
bool operator!=(const basic_string<CharT, Traits, Allocator>& a,
                const basic_string<CharT, Traits, Allocator>& b) {
  return !(a == b);
}

template <class CharT, class Traits, class Allocator>
bool operator!=(const basic_string<CharT, Traits, Allocator>& a,
                const CharT* b) {
  return !(a == b);
}

template <class CharT, class Traits, class Allocator>
bool operator!=(const CharT* a,
                const basic_string<CharT, Traits, Allocator>& b) {
  return !(b == a);
}

template <class CharT, class Traits, class Allocator>
bool operator==(const basic_string<CharT, Traits, Allocator>& a,
                const basic_string<CharT, Traits, Allocator>& b) {
  return a.compare(b) == 0;
}

template <class CharT, class Traits, class Allocator>
bool operator==(const basic_string<CharT, Traits, Allocator>& a,
                const CharT* b) {
  return a.compare(b) == 0;
}

#if __cplusplus >= 202002L
template <class CharT, class Traits, class Allocator>
std::strong_ordering operator<=>(
    const basic_string<CharT, Traits, Allocator>& a,
    const basic_string<CharT, Traits, Allocator>& b) {
  int r = a.compare(b);
  return r < 0 ? std::strong_ordering::less
               : r > 0 ? std::strong_ordering::greater
                       : std::strong_ordering::equal;
}

template <class CharT, class Traits, class Allocator>
std::strong_ordering operator<=>(
    const basic_string<CharT, Traits, Allocator>& a, const CharT* b) {
  int r = a.compare(b);
  return r < 0 ? std::strong_ordering::less
               : r > 0 ? std::strong_ordering::greater
                       : std::strong_ordering::equal;
}
#endif

template <class CharT, class Traits, class Allocator>
void swap(basic_string<CharT, Traits, Allocator>& a,
          basic_string<CharT, Traits, Allocator>& b) {
  a.swap(b);
}

// FNV-1a over the character bytes.  Shared with hash<string_view> so that a
// string and a view of the same characters hash identically.
namespace __string_hash_detail {

size_t __fnv1a(const char* data, size_t n) noexcept;

}  // namespace __string_hash_detail

template <>
struct hash<basic_string<char>> {
  size_t operator()(const basic_string<char>& s) const noexcept {
    return __string_hash_detail::__fnv1a(s.data(), s.size());
  }
};

}  // namespace std

#endif /* __davecc_string__ */
