  iterator lower_bound(const key_type& key) {
    return iterator(__lower_bound_node(key), __root_);
  }

  const_iterator lower_bound(const key_type& key) const {
    return const_iterator(__lower_bound_node(key), __root_);
  }

  template <class K>
    requires (__map_detail::__is_transparent_compare<Compare>::value)
  iterator lower_bound(const K& key) {
