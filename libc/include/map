  iterator erase(iterator pos) {
    iterator next = pos;
    ++next;
    __erase_node(pos.__node_);
    return next;
  }

  iterator erase(const_iterator pos) {
    iterator next((__node*)pos.__node_, __root_);
    ++next;
    __erase_node((__node*)pos.__node_);
    return next;
  }

  iterator erase(const_iterator first, const_iterator last) {
    iterator next((__node*)first.__node_, __root_);
    iterator finish((__node*)last.__node_, __root_);
    while (next != finish) {
      next = erase(next);
    }
    return finish;
  }

  size_type erase(const key_type& key) {
    __node* node = __find_node(key);
    if (node == nullptr) {
      return 0;
    }
    __erase_node(node);
    return 1;
  }

  template <class K>
  size_type erase(const K& key) {
    __node* node = __find_node_as(key);
    if (node == nullptr) {
      return 0;
    }
    __erase_node(node);
    return 1;
  }

  node_type extract(const_iterator pos) {
    return __extract_node((__node*)pos.__node_);
  }

  node_type extract(iterator pos) {
    return __extract_node(pos.__node_);
  }

  node_type extract(const key_type& key) {
    return __extract_node(__find_node(key));
  }

  template <class K>
  node_type extract(const K& key) {
    return __extract_node(__find_node_as(key));
  }

  template <class C2>
  void merge(map<Key, T, C2, Allocator>& source) {
    for (typename map<Key, T, C2, Allocator>::iterator it = source.begin();
         it != source.end();) {
      typename map<Key, T, C2, Allocator>::iterator next = it;
      ++next;
      if (__find_node(it->first) == nullptr) {
        __node* node = source.__detach_node(it.__node_);
        __insert_detached_node(node);
      }
      it = next;
    }
  }

  template <class C2>
  void merge(map<Key, T, C2, Allocator>&& source) {
    merge(source);
  }
};

template <class Key, class T, class Compare, class Allocator>
bool operator==(const map<Key, T, Compare, Allocator>& left,
                const map<Key, T, Compare, Allocator>& right) {
  if (left.size() != right.size()) {
    return false;
  }
  typename map<Key, T, Compare, Allocator>::const_iterator left_it = left.begin();
  typename map<Key, T, Compare, Allocator>::const_iterator right_it = right.begin();
  for (; left_it != left.end(); ++left_it, ++right_it) {
    if (!(*left_it == *right_it)) {
      return false;
    }
  }
  return true;
}

template <class Key, class T, class Compare, class Allocator>
auto operator<=>(const map<Key, T, Compare, Allocator>& left,
                 const map<Key, T, Compare, Allocator>& right) {
  typename map<Key, T, Compare, Allocator>::const_iterator left_it = left.begin();
  typename map<Key, T, Compare, Allocator>::const_iterator right_it = right.begin();
  for (; left_it != left.end() && right_it != right.end(); ++left_it, ++right_it) {
    auto cmp = *left_it <=> *right_it;
    if (cmp != 0) {
      return cmp;
    }
  }
  if (left_it == left.end() && right_it == right.end()) {
    return 0 <=> 0;
  }
  return left_it == left.end() ? (0 <=> 1) : (1 <=> 0);
}

template <class Key, class T, class Compare, class Allocator>
void swap(map<Key, T, Compare, Allocator>& left,
          map<Key, T, Compare, Allocator>& right) noexcept {
  left.swap(right);
}

template <class Key, class T, class Compare, class Allocator, class Predicate>
typename map<Key, T, Compare, Allocator>::size_type erase_if(
    map<Key, T, Compare, Allocator>& c, Predicate pred) {
  typename map<Key, T, Compare, Allocator>::size_type old_size = c.size();
  typename map<Key, T, Compare, Allocator>::iterator it = c.begin();
  while (it != c.end()) {
    if (pred(*it)) {
      it = c.erase(it);
    } else {
      ++it;
    }
  }
  return old_size - c.size();
}

