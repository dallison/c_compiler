namespace __regex_detail {

struct __cap {
  size_t first;
  size_t last;
  bool matched;
  __cap() : first(0), last(0), matched(false) {}
};

template <class CharT>
struct __engine {
static CharT __fold(CharT value, bool insensitive) {
  return insensitive && value >= CharT('A') && value <= CharT('Z')
             ? static_cast<CharT>(value - CharT('A') + CharT('a'))
             : value;
}

static bool __class_match(const basic_string<CharT>& pattern,
                   size_t first, size_t last, CharT value,
                   bool insensitive) {
  bool negate = first < last && pattern[first] == CharT('^');
  if (negate) ++first;
  bool matched = false;
  while (first < last) {
    CharT low = pattern[first++];
    if (low == CharT('\\') && first < last) low = pattern[first++];
    if (first + 1 < last && pattern[first] == CharT('-')) {
      ++first;
      CharT high = pattern[first++];
      CharT folded = __fold(value, insensitive);
      matched = matched ||
          (folded >= __fold(low, insensitive) &&
           folded <= __fold(high, insensitive));
    } else {
      matched = matched ||
          __fold(low, insensitive) == __fold(value, insensitive);
    }
  }
  return negate ? !matched : matched;
}

static size_t __atom_end(const basic_string<CharT>& pattern, size_t position,
                  size_t end) {
  if (position >= end) return position;
  if (pattern[position] == CharT('\\')) {
    return position + (position + 1 < end ? 2 : 1);
  }
  if (pattern[position] == CharT('[')) {
    size_t current = position + 1;
    while (current < end && pattern[current] != CharT(']')) ++current;
    return current < end ? current + 1 : end;
  }
  return position + 1;
}

static bool __atom_match(const basic_string<CharT>& pattern,
                  size_t first, size_t last, CharT value,
                  bool insensitive) {
  if (pattern[first] == CharT('.')) return true;
  if (pattern[first] == CharT('[')) {
    return __class_match(
        pattern, first + 1, last - 1, value, insensitive);
  }
  if (pattern[first] == CharT('\\') && first + 1 < last) {
    CharT escaped = pattern[first + 1];
    bool digit = value >= CharT('0') && value <= CharT('9');
    bool alpha = (value >= CharT('a') && value <= CharT('z')) ||
                 (value >= CharT('A') && value <= CharT('Z'));
    bool space = value == CharT(' ') || value == CharT('\t') ||
                 value == CharT('\n') || value == CharT('\r');
    if (escaped == CharT('d')) return digit;
    if (escaped == CharT('D')) return !digit;
    if (escaped == CharT('w')) return alpha || digit || value == CharT('_');
    if (escaped == CharT('W')) return !(alpha || digit || value == CharT('_'));
    if (escaped == CharT('s')) return space;
    if (escaped == CharT('S')) return !space;
    return __fold(escaped, insensitive) ==
           __fold(value, insensitive);
  }
  return __fold(pattern[first], insensitive) ==
         __fold(value, insensitive);
}

struct __state {
  vector<__cap> groups;
  unsigned next;
  __state() : next(1) {}
  void reset(unsigned n) {
    groups.assign(n, __cap());
    next = 1;
  }
};

static void __restore(__state& state, const __state& saved) {
  state.groups = saved.groups;
  state.next = saved.next;
}

static bool __match_segment(const basic_string<CharT>& pattern,
                     size_t pattern_first, size_t pattern_last,
                     const basic_string<CharT>& input, size_t input_pos,
                     bool insensitive, bool not_eol, size_t& result,
                     __state& state) {
  if (pattern_first == pattern_last) {
    result = input_pos;
    return true;
  }
  CharT token = pattern[pattern_first];
  if (token == CharT('$') && pattern_first + 1 == pattern_last) {
    if (!not_eol && input_pos == input.size()) {
      result = input_pos;
      return true;
    }
    return false;
  }
  if (token == CharT('(')) {
    size_t depth = 1;
    size_t close = pattern_first + 1;
    while (close < pattern_last && depth != 0) {
      if (pattern[close] == CharT('\\')) {
        close += 2;
        continue;
      }
      if (pattern[close] == CharT('(')) ++depth;
      if (pattern[close] == CharT(')')) --depth;
      if (depth != 0) ++close;
    }
    if (depth != 0) return false;
    unsigned mark = state.next++;
    size_t group_end;
    if (!__match_segment(
            pattern, pattern_first + 1, close, input,
            input_pos, insensitive, not_eol, group_end, state)) {
      return false;
    }
    if (mark >= 1 && mark <= state.groups.size()) {
      state.groups[mark - 1].first = input_pos;
      state.groups[mark - 1].last = group_end;
      state.groups[mark - 1].matched = true;
    }
    return __match_segment(
        pattern, close + 1, pattern_last, input,
        group_end, insensitive, not_eol, result, state);
  }
  size_t atom_last =
      __atom_end(pattern, pattern_first, pattern_last);
  CharT quantifier = atom_last < pattern_last
                         ? pattern[atom_last]
                         : CharT();
  size_t rest = atom_last;
  size_t minimum = 1;
  size_t maximum = 1;
  if (quantifier == CharT('*') || quantifier == CharT('+') ||
      quantifier == CharT('?')) {
    rest = atom_last + 1;
    minimum = quantifier == CharT('+') ? 1 : 0;
    maximum = quantifier == CharT('?') ? 1 : input.size() - input_pos;
  }
  size_t count = 0;
  while (count < maximum && input_pos + count < input.size() &&
         __atom_match(
             pattern, pattern_first, atom_last,
             input[input_pos + count], insensitive)) {
    ++count;
  }
  while (count >= minimum) {
    __state saved = state;
    if (__match_segment(
            pattern, rest, pattern_last, input,
            input_pos + count, insensitive, not_eol, result, state)) {
      return true;
    }
    __restore(state, saved);
    if (count == 0) break;
    --count;
  }
  return false;
}

static bool __find_from(const basic_string<CharT>& input,
            const basic_regex<CharT>& expression,
            size_t& first, size_t& last, bool require_full,
            regex_constants::match_flag_type flags, size_t start_min,
            vector<__cap>* captures = 0) {
  const basic_string<CharT>& pattern = expression.__pattern();
  bool anchored = !pattern.empty() && pattern[0] == CharT('^');
  bool insensitive =
      (expression.flags() & regex_constants::icase) != 0;
  size_t pattern_first = anchored ? 1 : 0;
  if (start_min > input.size()) return false;
  size_t start = start_min;
  size_t stop = anchored ||
                        (flags & regex_constants::match_continuous) != 0
                    ? start_min
                    : input.size();
  unsigned marks = expression.mark_count();
  for (; start <= stop; ++start) {
    size_t end;
    __state state;
    state.reset(marks);
    if (__match_segment(
            pattern, pattern_first, pattern.size(), input,
            start, insensitive,
            (flags & regex_constants::match_not_eol) != 0, end, state) &&
        (!require_full || (start == 0 && end == input.size()))) {
      if ((flags & regex_constants::match_not_null) != 0 && end == start) {
        continue;
      }
      first = start;
      last = end;
      if (captures != 0) *captures = state.groups;
      return true;
    }
  }
  return false;
}

static bool __find(const basic_string<CharT>& input,
            const basic_regex<CharT>& expression,
            size_t& first, size_t& last, bool require_full,
            regex_constants::match_flag_type flags,
            vector<__cap>* captures = 0) {
  return __find_from(input, expression, first, last, require_full, flags, 0,
                     captures);
}

static void __append_span(basic_string<CharT>& output,
                          const basic_string<CharT>& input, size_t from,
                          size_t to) {
  for (size_t i = from; i < to; ++i) output.push_back(input[i]);
}

static void __format(basic_string<CharT>& output,
                     const basic_string<CharT>& input, size_t first,
                     size_t last, const vector<__cap>& captures,
                     const basic_string<CharT>& format) {
  for (size_t i = 0; i < format.size(); ++i) {
    if (format[i] != CharT('$') || i + 1 >= format.size()) {
      output.push_back(format[i]);
      continue;
    }
    CharT next = format[i + 1];
    if (next == CharT('$')) {
      output.push_back(CharT('$'));
      ++i;
      continue;
    }
    if (next == CharT('&')) {
      __append_span(output, input, first, last);
      ++i;
      continue;
    }
    if (next == CharT('`')) {
      __append_span(output, input, 0, first);
      ++i;
      continue;
    }
    if (next == CharT('\'')) {
      __append_span(output, input, last, input.size());
      ++i;
      continue;
    }
    if (next >= CharT('0') && next <= CharT('9')) {
      size_t index = static_cast<size_t>(next - CharT('0'));
      size_t consumed = 1;
      if (i + 2 < format.size() && format[i + 2] >= CharT('0') &&
          format[i + 2] <= CharT('9')) {
        size_t two = index * 10 +
                     static_cast<size_t>(format[i + 2] - CharT('0'));
        if (two <= captures.size()) {
          index = two;
          consumed = 2;
        }
      }
      i += consumed;
      if (index == 0) {
        __append_span(output, input, first, last);
      } else if (index <= captures.size() && captures[index - 1].matched) {
        __append_span(output, input, captures[index - 1].first,
                      captures[index - 1].last);
      }
      continue;
    }
    output.push_back(format[i]);
  }
}

static basic_string<CharT> __replace(
    const basic_string<CharT>& input,
    const basic_regex<CharT>& expression,
    const basic_string<CharT>& format,
    regex_constants::match_flag_type flags) {
  basic_string<CharT> result;
  size_t pos = 0;
  bool any = false;
  bool first_only =
      (flags & regex_constants::format_first_only) != 0;
  bool no_copy = (flags & regex_constants::format_no_copy) != 0;
  while (pos <= input.size()) {
    size_t first = 0;
    size_t last = 0;
    vector<__cap> captures;
    bool found = __find_from(input, expression, first, last, false, flags,
                             pos, &captures);
    if (!found) break;
    any = true;
    if (!no_copy) __append_span(result, input, pos, first);
    __format(result, input, first, last, captures, format);
    if (last == first) {
      if (last >= input.size()) {
        pos = last;
        break;
      }
      if (!no_copy) result.push_back(input[last]);
      pos = last + 1;
    } else {
      pos = last;
    }
    if (first_only) break;
  }
  if (!any) return input;
  if (!no_copy) __append_span(result, input, pos, input.size());
  return result;
}

};

template <class BidirectionalIterator, class CharT>
basic_string<CharT> __copy_range(BidirectionalIterator first,
                                 BidirectionalIterator last) {
  basic_string<CharT> result;
  while (first != last) result.push_back(*first++);
  return result;
}

template <class BidirectionalIterator>
BidirectionalIterator __advance_copy(BidirectionalIterator first, size_t count) {
  while (count != 0) {
    ++first;
    --count;
  }
  return first;
}

template <class BidirectionalIterator, class Allocator>
void __fill_results(match_results<BidirectionalIterator, Allocator>& results,
                    BidirectionalIterator origin, BidirectionalIterator finish,
                    size_t found_first, size_t found_last, unsigned marks,
                    const vector<__cap>& captures) {
  results.__set(origin, finish, __advance_copy(origin, found_first),
                __advance_copy(origin, found_last), marks);
  for (size_t i = 0; i < captures.size(); ++i) {
    if (!captures[i].matched) continue;
    results.__set_capture(
        i + 1, __advance_copy(origin, captures[i].first),
        __advance_copy(origin, captures[i].last), true);
  }
}

template <class BidirectionalIterator, class Allocator, class CharT,
          class Traits>
bool __search_range(BidirectionalIterator first, BidirectionalIterator last,
                    BidirectionalIterator from,
                    match_results<BidirectionalIterator, Allocator>& results,
                    const basic_regex<CharT, Traits>& expression,
                    regex_constants::match_flag_type flags) {
  basic_string<CharT> input =
      __copy_range<BidirectionalIterator, CharT>(first, last);
  size_t origin = 0;
  for (BidirectionalIterator current = first; current != from; ++current) {
    ++origin;
  }
  size_t found_first = 0;
  size_t found_last = 0;
  vector<__cap> captures;
  const bool found = __engine<CharT>::__find_from(
      input, expression, found_first, found_last, false, flags, origin,
      &captures);
  if (!found) {
    results.__clear();
    return false;
  }
  __fill_results(results, first, last, found_first, found_last,
                 expression.mark_count(), captures);
  return true;
}

