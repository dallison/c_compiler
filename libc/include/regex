}

template <class CharT, class Traits>
basic_string<CharT> regex_replace(
    const basic_string<CharT>& input,
    const basic_regex<CharT, Traits>& expression,
    const basic_string<CharT>& format,
    regex_constants::match_flag_type flags = regex_constants::match_default) {
  size_t first;
  size_t last;
  if (!__regex_detail::__engine<CharT>::__find(
          input, expression, first, last, false, flags)) {
    return input;
  }
  basic_string<CharT> result;
  if ((flags & regex_constants::format_no_copy) == 0) {
    result.append(input.begin(), input.begin() + first);
  }
  for (size_t i = 0; i < format.size(); ++i) {
    if (format[i] == CharT('$') && i + 1 < format.size() &&
        format[i + 1] == CharT('&')) {
      result.append(input.begin() + first, input.begin() + last);
      ++i;
    } else {
      result.push_back(format[i]);
    }
  }
  if ((flags & regex_constants::format_no_copy) == 0) {
    result.append(input.begin() + last, input.end());
  }
  return result;
}

template <class CharT, class Traits>
basic_string<CharT> regex_replace(
    const basic_string<CharT>& input,
    const basic_regex<CharT, Traits>& expression, const CharT* format,
    regex_constants::match_flag_type flags = regex_constants::match_default) {
  return regex_replace(input, expression, basic_string<CharT>(format), flags);
}

inline string regex_replace(
    const string& input, const regex& expression, const string& format,
    regex_constants::match_flag_type flags = regex_constants::match_default) {
  size_t first;
  size_t last;
  if (!__regex_detail::__engine<char>::__find(
          input, expression, first, last, false, flags)) {
    return input;
  }
  string result;
  if ((flags & regex_constants::format_no_copy) == 0) {
    for (size_t i = 0; i < first; ++i) result.push_back(input[i]);
  }
  for (size_t i = 0; i < format.size(); ++i) {
    if (format[i] == '$' && i + 1 < format.size() &&
        format[i + 1] == '&') {
      for (size_t position = first; position < last; ++position) {
        result.push_back(input[position]);
      }
      ++i;
    } else {
      result.push_back(format[i]);
    }
  }
  if ((flags & regex_constants::format_no_copy) == 0) {
    for (size_t i = last; i < input.size(); ++i) {
      result.push_back(input[i]);
    }
  }
  return result;
}

