//
//  iterator
//  c_compiler
//
//  Minimal C++20 <iterator> support for DaveCC: the iterator category tags,
//  iterator_traits (with the raw-pointer specialization), reverse_iterator,
//  and the distance/advance/next/prev helpers.  This is enough to give the
//  contiguous containers (std::string, std::vector) their reverse iterators
//  and to drive range-based construction and insertion.
//
//  Category dispatch is done by selecting an overload on a *null pointer* to
//  the category tag rather than on a value-initialized tag object. Both are
//  standard-conforming implementation details, but the pointer form avoids
//  needing to value-construct an empty class in dependent context.
//

#ifndef __davecc_iterator__
#define __davecc_iterator__

#include <concepts>
#include <optional>
#include <stddef.h>  // size_t, ptrdiff_t
#include <type_traits>

namespace std {

// Iterator category tags.  The inheritance chain lets tag dispatch pick the
// most refined overload (a random-access iterator also satisfies the
// bidirectional / forward / input requirements).
struct output_iterator_tag {};
struct input_iterator_tag {};
struct forward_iterator_tag : input_iterator_tag {};
struct bidirectional_iterator_tag : forward_iterator_tag {};
struct random_access_iterator_tag : bidirectional_iterator_tag {};
struct contiguous_iterator_tag : random_access_iterator_tag {};

template <class Iter, class = void>
struct __iterator_concept_member {};

template <class Iter>
struct __iterator_concept_member<
    Iter, void_t<typename Iter::iterator_concept>> {
  using iterator_concept = typename Iter::iterator_concept;
};

// Primary iterator_traits: read the member typedefs of a class iterator.
template <class Iter>
struct iterator_traits : __iterator_concept_member<Iter> {
  using difference_type = typename Iter::difference_type;
  using value_type = typename Iter::value_type;
  using pointer = typename Iter::pointer;
  using reference = typename Iter::reference;
  using iterator_category = typename Iter::iterator_category;
};

// Raw pointers are contiguous (hence random-access) iterators.  A single
// specialization on `T*` covers `const U*` too (with T = const U); value_type
// strips cv-qualification, matching the standard.
template <class T>
struct iterator_traits<T*> {
  using difference_type = ptrdiff_t;
  using value_type = remove_cv_t<T>;
  using pointer = T*;
  using reference = T&;
  using iterator_category = random_access_iterator_tag;
  using iterator_concept = contiguous_iterator_tag;
};

// distance: O(1) for random-access iterators, O(n) otherwise.
template <class It>
constexpr typename iterator_traits<It>::difference_type __distance(
    It first, It last, input_iterator_tag*) {
  typename iterator_traits<It>::difference_type n = 0;
  for (; first != last; ++first) {
    ++n;
  }
  return n;
}

template <class It>
constexpr typename iterator_traits<It>::difference_type __distance(
    It first, It last, random_access_iterator_tag*) {
  return last - first;
}

template <class It>
constexpr typename iterator_traits<It>::difference_type distance(It first,
                                                                 It last) {
  return __distance(
      first, last,
      static_cast<typename iterator_traits<It>::iterator_category*>(nullptr));
}

// advance: O(1) for random-access iterators, O(n) otherwise.
template <class It, class Distance>
constexpr void __advance(It& it, Distance n, input_iterator_tag*) {
  for (; n > 0; --n) {
    ++it;
  }
}

template <class It, class Distance>
constexpr void __advance(It& it, Distance n, bidirectional_iterator_tag*) {
  if (n >= 0) {
    for (; n > 0; --n) {
      ++it;
    }
  } else {
    for (; n < 0; ++n) {
      --it;
    }
  }
}

template <class It, class Distance>
constexpr void __advance(It& it, Distance n, random_access_iterator_tag*) {
  it += static_cast<typename iterator_traits<It>::difference_type>(n);
}

template <class It, class Distance>
constexpr void advance(It& it, Distance n) {
  __advance(
      it, n,
      static_cast<typename iterator_traits<It>::iterator_category*>(nullptr));
}

template <class It>
constexpr It next(It it,
                  typename iterator_traits<It>::difference_type n = 1) {
  std::advance(it, n);
  return it;
}

template <class It>
constexpr It prev(It it,
                  typename iterator_traits<It>::difference_type n = 1) {
  std::advance(it, -n);
  return it;
}

// reverse_iterator adapts an iterator so that traversal runs backwards.  It
// stores the "one past" base iterator: dereferencing yields the element before
// it, matching the standard's rbegin()/rend() semantics.
template <class Iter>
class reverse_iterator {
 protected:
  Iter current;

 public:
  using iterator_type = Iter;
  using difference_type = typename iterator_traits<Iter>::difference_type;
  using reference = typename iterator_traits<Iter>::reference;
  using pointer = typename iterator_traits<Iter>::pointer;
  using value_type = typename iterator_traits<Iter>::value_type;
  using iterator_category = typename iterator_traits<Iter>::iterator_category;

  constexpr reverse_iterator() : current(Iter()) {}
  constexpr explicit reverse_iterator(Iter x) : current(x) {}

  template <class U>
  constexpr reverse_iterator(const reverse_iterator<U>& other)
      : current(other.base()) {}

  template <class U>
  constexpr reverse_iterator& operator=(const reverse_iterator<U>& other) {
    current = other.base();
    return *this;
  }

  constexpr Iter base() const { return current; }

  constexpr reference operator*() const {
    Iter tmp = current;
    return *--tmp;
  }

  // The pointed-to element is a real lvalue for the pointer / contiguous
  // iterators this adapter is used with, so its address is the pointer.
  constexpr pointer operator->() const { return &(operator*()); }

  constexpr reverse_iterator& operator++() {
    --current;
    return *this;
  }

  constexpr reverse_iterator operator++(int) {
    reverse_iterator tmp = *this;
    --current;
    return tmp;
  }

  constexpr reverse_iterator& operator--() {
    ++current;
    return *this;
  }

  constexpr reverse_iterator operator--(int) {
    reverse_iterator tmp = *this;
    ++current;
    return tmp;
  }

  constexpr reverse_iterator operator+(difference_type n) const {
    return reverse_iterator(current - n);
  }

  constexpr reverse_iterator& operator+=(difference_type n) {
    current -= n;
    return *this;
  }

  constexpr reverse_iterator operator-(difference_type n) const {
    return reverse_iterator(current + n);
  }

  constexpr reverse_iterator& operator-=(difference_type n) {
    current += n;
    return *this;
  }

  constexpr reference operator[](difference_type n) const {
    return *(*this + n);
  }
};

template <class I1, class I2>
constexpr bool operator==(const reverse_iterator<I1>& a,
                          const reverse_iterator<I2>& b) {
  return a.base() == b.base();
}

template <class I1, class I2>
constexpr bool operator!=(const reverse_iterator<I1>& a,
                          const reverse_iterator<I2>& b) {
  return a.base() != b.base();
}

template <class I1, class I2>
constexpr bool operator<(const reverse_iterator<I1>& a,
                         const reverse_iterator<I2>& b) {
  return a.base() > b.base();
}

template <class I1, class I2>
constexpr bool operator<=(const reverse_iterator<I1>& a,
                          const reverse_iterator<I2>& b) {
  return a.base() >= b.base();
}

template <class I1, class I2>
constexpr bool operator>(const reverse_iterator<I1>& a,
                         const reverse_iterator<I2>& b) {
  return a.base() < b.base();
}

template <class I1, class I2>
constexpr bool operator>=(const reverse_iterator<I1>& a,
                          const reverse_iterator<I2>& b) {
  return a.base() <= b.base();
}

template <class I1, class I2>
constexpr typename reverse_iterator<I1>::difference_type operator-(
    const reverse_iterator<I1>& a, const reverse_iterator<I2>& b) {
  return b.base() - a.base();
}

template <class Iter>
constexpr reverse_iterator<Iter> operator+(
    typename reverse_iterator<Iter>::difference_type n,
    const reverse_iterator<Iter>& it) {
  return reverse_iterator<Iter>(it.base() - n);
}

template <class Iter>
constexpr reverse_iterator<Iter> make_reverse_iterator(Iter it) {
  return reverse_iterator<Iter>(it);
}

#if __cplusplus >= 202002L

// ------------------------------------------------------------------
// C++20 iterator concepts ([iterator.concepts]).
//
// Every iterator DaveCC currently uses is either a raw pointer (covered by the
// iterator_traits<T*> specialization) or a class iterator that supplies the
// member typedefs read by the primary iterator_traits.  The associated-type
// aliases are therefore defined directly through iterator_traits rather than
// through the standard's incrementable_traits / indirectly_readable_traits
// fallbacks, which are only needed for iterators that expose a partial set of
// members.
// ------------------------------------------------------------------

template <class T>
using iter_value_t = typename iterator_traits<remove_cvref_t<T>>::value_type;

template <class T>
using iter_reference_t = decltype(*declval<T&>());

template <class T>
using iter_common_reference_t =
    common_reference_t<iter_reference_t<T>, iter_value_t<T>&>;

// [incrementable.traits]  The associated "difference" type of an incrementable
// type.  Class iterators expose a `difference_type` member, raw pointers use
// ptrdiff_t, and integer-like types (e.g. the `W` of an iota_view<int>) derive
// a signed difference from their subtraction result.  iter_difference_t routes
// through this rather than iterator_traits so that non-iterator incrementable
// types (plain integers) are supported.
namespace __detail {
template <class T>
concept __has_member_difference_type = requires { typename T::difference_type; };

template <class T>
concept __subtractable_difference =
    !__has_member_difference_type<T> && requires(const T& a, const T& b) {
      { a - b } -> integral;
    };
}  // namespace __detail

template <class>
struct incrementable_traits {};

template <class T>
  requires is_object_v<T>
struct incrementable_traits<T*> {
  using difference_type = ptrdiff_t;
};

template <class I>
struct incrementable_traits<const I> : incrementable_traits<I> {};

template <__detail::__has_member_difference_type T>
struct incrementable_traits<T> {
  using difference_type = typename T::difference_type;
};

template <__detail::__subtractable_difference T>
struct incrementable_traits<T> {
  using difference_type = make_signed_t<decltype(declval<T>() - declval<T>())>;
};

template <class T>
using iter_difference_t =
    typename incrementable_traits<remove_cvref_t<T>>::difference_type;

// ITER_CONCEPT(I): prefer iterator_traits<I>::iterator_concept when present,
// otherwise fall back to iterator_category.
template <class I, class = void>
struct __iter_concept_of {
  using type = typename iterator_traits<I>::iterator_category;
};

template <class I>
struct __iter_concept_of<
    I, void_t<typename iterator_traits<I>::iterator_concept>> {
  using type = typename iterator_traits<I>::iterator_concept;
};

template <class I>
using __iter_concept = typename __iter_concept_of<remove_cvref_t<I>>::type;

template <class T>
using __with_reference = T&;

template <class T>
concept __can_reference = requires { typename __with_reference<T>; };

template <class T>
concept __dereferenceable = requires(T& t) {
  { *t } -> __can_reference;
};

namespace ranges {
namespace __iter_move {

struct __fn {
  template <class I>
    requires __dereferenceable<I> &&
             is_lvalue_reference_v<decltype(*declval<I&>())>
  constexpr remove_reference_t<decltype(*declval<I&>())>&& operator()(
      I&& it) const {
    return static_cast<remove_reference_t<decltype(*it)>&&>(*it);
  }

  template <class I>
    requires __dereferenceable<I> &&
             (!is_lvalue_reference_v<decltype(*declval<I&>())>)
  constexpr decltype(*declval<I&>()) operator()(I&& it) const {
    return *it;
  }
};

}  // namespace __iter_move

inline namespace __cpo {
inline constexpr __iter_move::__fn iter_move{};
}  // namespace __cpo
}  // namespace ranges

template <class T>
  requires __dereferenceable<T>
using iter_rvalue_reference_t = decltype(ranges::iter_move(declval<T&>()));

// [iterator.concept.readable]
template <class In>
concept indirectly_readable = requires {
  typename iter_value_t<In>;
  typename iter_reference_t<In>;
};

// [iterator.concept.writable]
template <class Out, class T>
concept indirectly_writable = requires(Out&& o, T&& t) {
  *o = static_cast<T&&>(t);
  *static_cast<Out&&>(o) = static_cast<T&&>(t);
};

// [iterator.concept.winc]
template <class I>
concept weakly_incrementable = movable<I> && requires(I i) {
  typename iter_difference_t<I>;
  { ++i } -> same_as<I&>;
  i++;
};

// [iterator.concept.inc]
template <class I>
concept incrementable = regular<I> && weakly_incrementable<I> && requires(I i) {
  { i++ } -> same_as<I>;
};

// [iterator.concept.iterator]
template <class I>
concept input_or_output_iterator =
    requires(I i) {
      { *i } -> __can_reference;
    } &&
    weakly_incrementable<I>;

// [iterator.concept.sentinel]
template <class S, class I>
concept sentinel_for =
    semiregular<S> && input_or_output_iterator<I> &&
    __weakly_equality_comparable_with<S, I>;

template <class S, class I>
inline constexpr bool disable_sized_sentinel_for = false;

template <class S, class I>
concept sized_sentinel_for =
    sentinel_for<S, I> &&
    !disable_sized_sentinel_for<remove_cv_t<S>, remove_cv_t<I>> &&
    requires(const I& i, const S& s) {
      { s - i } -> same_as<iter_difference_t<I>>;
      { i - s } -> same_as<iter_difference_t<I>>;
    };

// [iterator.concept.input]
template <class I>
concept input_iterator =
    input_or_output_iterator<I> && indirectly_readable<I> &&
    requires { typename iterator_traits<remove_cvref_t<I>>::iterator_category; } &&
    derived_from<
        typename iterator_traits<remove_cvref_t<I>>::iterator_category,
        input_iterator_tag>;

// [iterator.concept.output]
template <class I, class T>
concept output_iterator =
    input_or_output_iterator<I> && indirectly_writable<I, T> &&
    requires(I i, T&& t) {
      *i++ = static_cast<T&&>(t);
    };

// [iterator.concept.forward]
template <class I>
concept forward_iterator =
    input_iterator<I> &&
    derived_from<
        typename iterator_traits<remove_cvref_t<I>>::iterator_category,
        forward_iterator_tag> &&
    incrementable<I> && sentinel_for<I, I>;

// [iterator.concept.bidir]
template <class I>
concept bidirectional_iterator =
    forward_iterator<I> &&
    derived_from<
        typename iterator_traits<remove_cvref_t<I>>::iterator_category,
        bidirectional_iterator_tag> &&
    requires(I i) {
      { --i } -> same_as<I&>;
      { i-- } -> same_as<I>;
    };

// [iterator.concept.random.access]
template <class I>
concept random_access_iterator =
    bidirectional_iterator<I> &&
    derived_from<
        typename iterator_traits<remove_cvref_t<I>>::iterator_category,
        random_access_iterator_tag> &&
    totally_ordered<I> && sized_sentinel_for<I, I> &&
    requires(I i, const I j, const iter_difference_t<I> n) {
      { i += n } -> same_as<I&>;
      { j + n } -> same_as<I>;
      { n + j } -> same_as<I>;
      { i -= n } -> same_as<I&>;
      { j - n } -> same_as<I>;
      { j[n] } -> same_as<iter_reference_t<I>>;
    };

// [iterator.concept.contiguous]
template <class I>
concept contiguous_iterator =
    random_access_iterator<I> &&
    derived_from<__iter_concept<I>, contiguous_iterator_tag> &&
    is_lvalue_reference_v<iter_reference_t<I>> &&
    same_as<iter_value_t<I>, remove_cvref_t<iter_reference_t<I>>>;

// [std.iterator.tags] sentinels
struct default_sentinel_t {};
inline constexpr default_sentinel_t default_sentinel{};

struct unreachable_sentinel_t {
  template <class I>
  friend constexpr bool operator==(unreachable_sentinel_t,
                                   const I&) noexcept {
    return false;
  }
};
inline constexpr unreachable_sentinel_t unreachable_sentinel{};

// [iterators.counted] An iterator adaptor that limits traversal to a fixed
// number of increments.  Its position is represented by both the underlying
// iterator and the remaining count; default_sentinel denotes count zero.
template <class I>
struct __counted_iterator_types {
  using value_type = iter_value_t<I>;
  using pointer = typename iterator_traits<I>::pointer;
  using reference = iter_reference_t<I>;
  using iterator_category = typename iterator_traits<I>::iterator_category;
  using iterator_concept = __iter_concept<I>;
};

template <class T>
constexpr T* __counted_to_address(T* pointer) noexcept {
  return pointer;
}

template <class It>
  requires(!is_pointer_v<It>)
constexpr auto __counted_to_address(const It& iterator) noexcept {
  return __counted_to_address(iterator.operator->());
}

template <input_or_output_iterator I>
class counted_iterator : public __counted_iterator_types<I> {
 private:
  I current;
  iter_difference_t<I> length = 0;

 public:
  using iterator_type = I;
  using difference_type = iter_difference_t<I>;

  constexpr counted_iterator()
    requires default_initializable<I>
      : current(), length(0) {}

  constexpr counted_iterator(I x, difference_type n)
      : current(static_cast<I&&>(x)), length(n) {}

  template <input_or_output_iterator I2>
    requires convertible_to<const I2&, I>
  constexpr counted_iterator(const counted_iterator<I2>& other)
      : current(other.base()), length(other.count()) {}

  template <input_or_output_iterator I2>
    requires is_assignable_v<I&, const I2&>
  constexpr counted_iterator& operator=(const counted_iterator<I2>& other) {
    current = other.base();
    length = other.count();
    return *this;
  }

  constexpr I base() const&
    requires copy_constructible<I>
  {
    return current;
  }

  constexpr I base() && { return static_cast<I&&>(current); }

  constexpr difference_type count() const noexcept { return length; }

  constexpr decltype(auto) operator*() const { return *current; }

  constexpr auto operator->() const
    requires contiguous_iterator<I>
  {
    return __counted_to_address(current);
  }

  constexpr counted_iterator& operator++() {
    ++current;
    --length;
    return *this;
  }

  constexpr counted_iterator operator++(int)
    requires forward_iterator<I>
  {
    counted_iterator tmp = *this;
    ++*this;
    return tmp;
  }

  constexpr decltype(auto) operator++(int)
    requires(!forward_iterator<I>)
  {
    --length;
    return current++;
  }

  constexpr counted_iterator& operator--()
    requires bidirectional_iterator<I>
  {
    --current;
    ++length;
    return *this;
  }

  constexpr counted_iterator operator--(int)
    requires bidirectional_iterator<I>
  {
    counted_iterator tmp = *this;
    --*this;
    return tmp;
  }

  constexpr counted_iterator& operator+=(difference_type n)
    requires random_access_iterator<I>
  {
    current += n;
    length -= n;
    return *this;
  }

  constexpr counted_iterator& operator-=(difference_type n)
    requires random_access_iterator<I>
  {
    current -= n;
    length += n;
    return *this;
  }

  constexpr decltype(auto) operator[](difference_type n) const
    requires random_access_iterator<I>
  {
    return current[n];
  }
};

template <class I>
constexpr bool operator==(const counted_iterator<I>& x,
                          const counted_iterator<I>& y) {
  return x.count() == y.count();
}

template <class I>
constexpr bool operator!=(const counted_iterator<I>& x,
                          const counted_iterator<I>& y) {
  return !(x == y);
}

template <class I1, class I2>
  requires(!same_as<I1, I2>) && common_with<I1, I2>
constexpr bool operator==(const counted_iterator<I1>& x,
                          const counted_iterator<I2>& y) {
  return x.count() == y.count();
}

template <class I1, class I2>
  requires(!same_as<I1, I2>) && common_with<I1, I2>
constexpr bool operator!=(const counted_iterator<I1>& x,
                          const counted_iterator<I2>& y) {
  return !(x == y);
}

template <class I>
constexpr bool operator<(const counted_iterator<I>& x,
                         const counted_iterator<I>& y) {
  return y.count() < x.count();
}

template <class I>
constexpr bool operator<=(const counted_iterator<I>& x,
                          const counted_iterator<I>& y) {
  return !(y < x);
}

template <class I>
constexpr bool operator>(const counted_iterator<I>& x,
                         const counted_iterator<I>& y) {
  return y < x;
}

template <class I>
constexpr bool operator>=(const counted_iterator<I>& x,
                          const counted_iterator<I>& y) {
  return !(x < y);
}

template <class I>
constexpr iter_difference_t<I> operator-(const counted_iterator<I>& x,
                                         const counted_iterator<I>& y) {
  return y.count() - x.count();
}

template <class I1, class I2>
  requires(!same_as<I1, I2>) && common_with<I1, I2>
constexpr bool operator<(const counted_iterator<I1>& x,
                         const counted_iterator<I2>& y) {
  return y.count() < x.count();
}

template <class I1, class I2>
  requires(!same_as<I1, I2>) && common_with<I1, I2>
constexpr bool operator<=(const counted_iterator<I1>& x,
                          const counted_iterator<I2>& y) {
  return !(y < x);
}

template <class I1, class I2>
  requires(!same_as<I1, I2>) && common_with<I1, I2>
constexpr bool operator>(const counted_iterator<I1>& x,
                         const counted_iterator<I2>& y) {
  return y < x;
}

template <class I1, class I2>
  requires(!same_as<I1, I2>) && common_with<I1, I2>
constexpr bool operator>=(const counted_iterator<I1>& x,
                          const counted_iterator<I2>& y) {
  return !(x < y);
}

template <class I1, class I2>
  requires(!same_as<I1, I2>) && common_with<I1, I2>
constexpr iter_difference_t<I2> operator-(const counted_iterator<I1>& x,
                                          const counted_iterator<I2>& y) {
  return y.count() - x.count();
}

template <class I>
constexpr counted_iterator<I> operator+(
    const counted_iterator<I>& i, iter_difference_t<I> n)
  requires random_access_iterator<I>
{
  counted_iterator<I> result = i;
  result += n;
  return result;
}

template <class I>
constexpr counted_iterator<I> operator+(
    iter_difference_t<I> n, const counted_iterator<I>& i)
  requires random_access_iterator<I>
{
  return i + n;
}

template <class I>
constexpr counted_iterator<I> operator-(
    const counted_iterator<I>& i, iter_difference_t<I> n)
  requires random_access_iterator<I>
{
  counted_iterator<I> result = i;
  result -= n;
  return result;
}

template <class I>
constexpr bool operator==(const counted_iterator<I>& i,
                          default_sentinel_t) {
  return i.count() == 0;
}

template <class I>
constexpr bool operator==(default_sentinel_t s,
                          const counted_iterator<I>& i) {
  return i == s;
}

template <class I>
constexpr bool operator!=(const counted_iterator<I>& i,
                          default_sentinel_t s) {
  return !(i == s);
}

template <class I>
constexpr bool operator!=(default_sentinel_t s,
                          const counted_iterator<I>& i) {
  return !(s == i);
}

template <class I>
constexpr iter_difference_t<I> operator-(default_sentinel_t,
                                         const counted_iterator<I>& i) {
  return i.count();
}

template <class I>
constexpr iter_difference_t<I> operator-(const counted_iterator<I>& i,
                                         default_sentinel_t) {
  return -i.count();
}

template <input_or_output_iterator I>
counted_iterator(I, iter_difference_t<I>) -> counted_iterator<I>;

template <input_or_output_iterator I>
constexpr counted_iterator<I> make_counted_iterator(
    I i, iter_difference_t<I> n) {
  return counted_iterator<I>(static_cast<I&&>(i), n);
}

template <input_iterator I>
struct iterator_traits<counted_iterator<I>> {
  using difference_type = iter_difference_t<I>;
  using value_type = iter_value_t<I>;
  using pointer = typename iterator_traits<I>::pointer;
  using reference = iter_reference_t<I>;
  using iterator_category = typename iterator_traits<I>::iterator_category;
  using iterator_concept = __iter_concept<I>;
};

// [iterators.common] An iterator/sentinel union that presents one common type
// to legacy algorithms.  Two optionals provide tagged lifetime management
// without requiring either alternative to be default-constructible.
template <input_or_output_iterator I, sentinel_for<I> S>
  requires(!same_as<I, S>) && copyable<I>
class common_iterator {
 private:
  optional<I> __iterator_;
  optional<S> __sentinel_;

  struct __arrow_proxy {
    iter_value_t<I> __value;
    constexpr const iter_value_t<I>* operator->() const noexcept {
      return &__value;
    }
  };

 public:
  using difference_type = iter_difference_t<I>;
  using value_type = iter_value_t<I>;
  using reference = iter_reference_t<I>;
  using pointer = typename iterator_traits<I>::pointer;
  using iterator_category =
      conditional_t<forward_iterator<I>, forward_iterator_tag,
                    input_iterator_tag>;
  using iterator_concept = iterator_category;

  constexpr common_iterator()
    requires default_initializable<I>
      : __iterator_(in_place), __sentinel_() {}

  constexpr common_iterator(I iterator)
      : __iterator_(in_place, static_cast<I&&>(iterator)), __sentinel_() {}

  constexpr common_iterator(S sentinel)
      : __iterator_(), __sentinel_(in_place, static_cast<S&&>(sentinel)) {}

  template <input_or_output_iterator I2, sentinel_for<I2> S2>
    requires(!same_as<I2, S2>) && copyable<I2> &&
            convertible_to<const I2&, I> &&
            convertible_to<const S2&, S>
  constexpr common_iterator(const common_iterator<I2, S2>& other)
      : __iterator_(), __sentinel_() {
    if (other.__holds_iterator()) {
      __iterator_.emplace(other.__iterator_value());
    } else {
      __sentinel_.emplace(other.__sentinel_value());
    }
  }

  template <input_or_output_iterator I2, sentinel_for<I2> S2>
    requires(!same_as<I2, S2>) && copyable<I2> &&
            convertible_to<const I2&, I> &&
            convertible_to<const S2&, S> &&
            is_assignable_v<I&, const I2&> &&
            is_assignable_v<S&, const S2&>
  constexpr common_iterator& operator=(
      const common_iterator<I2, S2>& other) {
    if (other.__holds_iterator()) {
      __sentinel_.reset();
      if (__iterator_) {
        *__iterator_ = other.__iterator_value();
      } else {
        __iterator_.emplace(other.__iterator_value());
      }
    } else {
      __iterator_.reset();
      if (__sentinel_) {
        *__sentinel_ = other.__sentinel_value();
      } else {
        __sentinel_.emplace(other.__sentinel_value());
      }
    }
    return *this;
  }

  constexpr bool __holds_iterator() const noexcept {
    return __iterator_.has_value();
  }
  constexpr I& __iterator_value() { return *__iterator_; }
  constexpr const I& __iterator_value() const { return *__iterator_; }
  constexpr S& __sentinel_value() { return *__sentinel_; }
  constexpr const S& __sentinel_value() const { return *__sentinel_; }

  constexpr decltype(auto) operator*() { return **__iterator_; }

  constexpr decltype(auto) operator*() const
    requires indirectly_readable<const I>
  {
    return **__iterator_;
  }

  constexpr auto operator->() const
    requires indirectly_readable<const I>
  {
    if constexpr (is_pointer_v<I>) {
      return *__iterator_;
    } else if constexpr (requires(const I& iterator) {
                           iterator.operator->();
                         }) {
      return __iterator_->operator->();
    } else if constexpr (is_reference_v<iter_reference_t<I>>) {
      return &**__iterator_;
    } else {
      return __arrow_proxy{**__iterator_};
    }
  }

  constexpr common_iterator& operator++() {
    ++*__iterator_;
    return *this;
  }

  constexpr common_iterator operator++(int)
    requires forward_iterator<I>
  {
    common_iterator copy = *this;
    ++*this;
    return copy;
  }

  constexpr decltype(auto) operator++(int)
    requires(!forward_iterator<I>)
  {
    return (*__iterator_)++;
  }
};

template <class I1, class S1, class I2, class S2>
  requires sentinel_for<S1, I2> && sentinel_for<S2, I1>
constexpr bool operator==(const common_iterator<I1, S1>& left,
                          const common_iterator<I2, S2>& right) {
  if (left.__holds_iterator() && right.__holds_iterator()) {
    if constexpr (equality_comparable_with<I1, I2>) {
      return left.__iterator_value() == right.__iterator_value();
    } else {
      return true;
    }
  }
  if (!left.__holds_iterator() && !right.__holds_iterator()) {
    return true;
  }
  if (left.__holds_iterator()) {
    return left.__iterator_value() == right.__sentinel_value();
  }
  return left.__sentinel_value() == right.__iterator_value();
}

template <class I1, class S1, class I2, class S2>
  requires sentinel_for<S1, I2> && sentinel_for<S2, I1>
constexpr bool operator!=(const common_iterator<I1, S1>& left,
                          const common_iterator<I2, S2>& right) {
  return !(left == right);
}

template <class I1, class S1, class I2, class S2>
  requires sized_sentinel_for<I2, I1> &&
           sized_sentinel_for<S1, I2> &&
           sized_sentinel_for<S2, I1>
constexpr iter_difference_t<I2> operator-(
    const common_iterator<I1, S1>& left,
    const common_iterator<I2, S2>& right) {
  if (left.__holds_iterator() && right.__holds_iterator()) {
    return left.__iterator_value() - right.__iterator_value();
  }
  if (!left.__holds_iterator() && !right.__holds_iterator()) {
    return 0;
  }
  if (left.__holds_iterator()) {
    return left.__iterator_value() - right.__sentinel_value();
  }
  return left.__sentinel_value() - right.__iterator_value();
}

template <class I, class S>
  requires input_iterator<I>
constexpr decltype(auto) iter_move(
    const common_iterator<I, S>& iterator) {
  return ranges::iter_move(iterator.__iterator_value());
}

// [alg.req] indirect callable concepts.
template <class F, class I>
concept indirectly_unary_invocable =
    indirectly_readable<I> && invocable<F&, iter_value_t<I>&> &&
    invocable<F&, iter_reference_t<I>>;

template <class F, class I>
concept indirectly_regular_unary_invocable =
    indirectly_readable<I> && regular_invocable<F&, iter_value_t<I>&> &&
    regular_invocable<F&, iter_reference_t<I>>;

template <class F, class I>
concept indirect_unary_predicate =
    indirectly_readable<I> && predicate<F&, iter_value_t<I>&> &&
    predicate<F&, iter_reference_t<I>>;

template <class F, class I1, class I2>
concept indirect_binary_predicate =
    indirectly_readable<I1> && indirectly_readable<I2> &&
    predicate<F&, iter_reference_t<I1>, iter_reference_t<I2>>;

// [projected]
template <class I, class Proj>
struct __projected {
  struct __type {
    using __result =
        __davecc_invoke_result_t(Proj&, iter_reference_t<I>);
    using value_type = remove_cvref_t<__result>;
    using difference_type = iter_difference_t<I>;
    __result operator*() const;
  };
};

template <class I, class Proj>
using projected = typename __projected<I, Proj>::__type;

template <class In, class Out>
concept indirectly_movable =
    indirectly_readable<In> &&
    indirectly_writable<Out, iter_rvalue_reference_t<In>>;

template <class In, class Out>
concept indirectly_movable_storable =
    indirectly_movable<In, Out> &&
    indirectly_writable<Out, iter_value_t<In>> &&
    movable<iter_value_t<In>>;

template <class In, class Out>
concept indirectly_copyable =
    indirectly_readable<In> &&
    indirectly_writable<Out, iter_reference_t<In>>;

template <class In, class Out>
concept indirectly_copyable_storable =
    indirectly_copyable<In, Out> &&
    indirectly_writable<Out, iter_value_t<In>&> &&
    copyable<iter_value_t<In>>;

template <class I1, class I2 = I1>
concept indirectly_swappable =
    indirectly_readable<I1> && indirectly_readable<I2> &&
    requires(const I1 i1, const I2 i2) {
      ranges::swap(*i1, *i1);
      ranges::swap(*i2, *i2);
      ranges::swap(*i1, *i2);
      ranges::swap(*i2, *i1);
    };

template <class I>
concept permutable =
    forward_iterator<I> && indirectly_movable_storable<I, I> &&
    indirectly_swappable<I, I>;

template <class F, class I1, class I2 = I1>
concept indirect_strict_weak_order =
    indirectly_readable<I1> && indirectly_readable<I2> &&
    strict_weak_order<F&, iter_reference_t<I1>, iter_reference_t<I2>>;

struct __iter_identity {
  template <class T>
  constexpr T&& operator()(T&& value) const {
    return static_cast<T&&>(value);
  }
};

struct __iter_less {
  template <class T, class U>
  constexpr bool operator()(const T& left, const U& right) const {
    return left < right;
  }
};

template <class I, class R = __iter_less, class P = __iter_identity>
concept sortable =
    permutable<I> && indirect_strict_weak_order<R, projected<I, P>>;

template <class I1, class I2, class Out, class R = __iter_less,
          class P1 = __iter_identity, class P2 = __iter_identity>
concept mergeable =
    input_iterator<I1> && input_iterator<I2> && weakly_incrementable<Out> &&
    indirectly_copyable<I1, Out> && indirectly_copyable<I2, Out> &&
    indirect_strict_weak_order<R, projected<I1, P1>, projected<I2, P2>>;

template <class I1, class S1, class I2, class S2>
  requires indirectly_swappable<I1, I2>
constexpr void iter_swap(const common_iterator<I1, S1>& left,
                         const common_iterator<I2, S2>& right) {
  ranges::swap(*left, *right);
}

namespace ranges {
namespace __iter_swap {

struct __fn {
  template <class X, class Y>
  constexpr void operator()(X&& a, Y&& b) const {
    ranges::swap(*a, *b);
  }
};

}  // namespace __iter_swap

