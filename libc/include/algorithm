template <class I, class S>
constexpr subrange<I, I> rotate(I first, I middle, S last) {
  I end = first;
  while (end != last) ++end;
  if (first == middle) return {end, end};
  if (middle == end) return {first, end};
  I write = first;
  I read = middle;
  while (read != end) {
    ranges::iter_swap(write, read);
    ++write;
    ++read;
    if (write == middle) middle = read;
    else if (read == end) read = middle;
  }
  return {write, end};
}
