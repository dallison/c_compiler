template <class I, class S, class Gen>
constexpr I shuffle(I first, S last, Gen&& gen) {
  I end = ranges::next(first, last);
  iter_difference_t<I> count = ranges::distance(first, end);
  for (iter_difference_t<I> i = count; i > 1; --i) {
    iter_difference_t<I> pick = static_cast<iter_difference_t<I>>(
        static_cast<unsigned long long>(gen()) %
        static_cast<unsigned long long>(i));
    ranges::iter_swap(ranges::next(first, i - 1), ranges::next(first, pick));
  }
  return end;
}
