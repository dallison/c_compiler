template <class I1, class S1, class I2, class S2,
          class Comp = less, class P1 = identity, class P2 = identity>
constexpr bool lexicographical_compare(I1 first1, S1 last1,
                                       I2 first2, S2 last2,
                                       Comp comp = {}, P1 p1 = {},
                                       P2 p2 = {}) {
  while (first1 != last1 && first2 != last2) {
    if (comp(__project(p1, *first1), __project(p2, *first2))) return true;
    if (comp(__project(p2, *first2), __project(p1, *first1))) return false;
    ++first1;
    ++first2;
  }
  return first1 == last1 && first2 != last2;
}
