template <class I, class S, class Pred = equal_to, class Proj = identity>
constexpr subrange<I, I> unique(I first, S last, Pred pred = {},
                                Proj proj = {}) {
  I end = first;
  while (end != last) ++end;
  first = ranges::adjacent_find(first, end, pred, proj);
  if (first == end) return {end, end};
  I result = first;
  while (++first != end) {
    if (!pred(__project(proj, *result), __project(proj, *first))) {
      ++result;
      *result = ranges::iter_move(first);
    }
  }
  ++result;
  return {result, end};
}
