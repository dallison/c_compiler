  iter_difference_t<I> index = 1;
  for (; child != last; ++child, ++index) {
    I parent = first;
    ranges::advance(parent, (index - 1) / 2);
    if (__compare(comp, __project(proj, *parent), __project(proj, *child))) {
      return false;
