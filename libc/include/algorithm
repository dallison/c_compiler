template <class I, class S, class Pred, class Proj = identity>
constexpr subrange<I, I> partition(I first, S last, Pred pred,
                                   Proj proj = {}) {
  I end = first;
  while (end != last) ++end;
  first = ranges::find_if_not(first, end, pred, proj);
  if (first == end) return {end, end};
  for (I i = first; ++i != end;) {
    if (pred(__project(proj, *i))) {
      ranges::iter_swap(i, first);
      ++first;
    }
  }
  return {first, end};
