constexpr borrowed_iterator_t<R> shuffle(R&& r, Gen&& gen) {
  return ranges::shuffle(ranges::begin(r), ranges::end(r),
                         static_cast<Gen&&>(gen));
}
// Selection sampling: walk the population once, keeping each element with
// probability (wanted / remaining), which needs the population size up front
// and therefore a forward range.
template <class I, class S, class O, class Gen>
O sample(I first, S last, O out, iter_difference_t<I> n, Gen&& gen) {
  iter_difference_t<I> remaining = ranges::distance(first, last);
  for (; first != last && n > 0; ++first) {
    if (remaining <= n) {
      *out = *first;
      ++out;
      --n;
    } else if (static_cast<iter_difference_t<I>>(
                   static_cast<unsigned long long>(gen()) %
                   static_cast<unsigned long long>(remaining)) < n) {
      *out = *first;
      ++out;
      --n;
    }
    --remaining;
  }
  return out;
}
template <range R, class O, class Gen>
O sample(R&& r, O out, range_difference_t<R> n, Gen&& gen) {
  return ranges::sample(ranges::begin(r), ranges::end(r), out, n,
                        static_cast<Gen&&>(gen));
}

