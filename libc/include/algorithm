template <class I, class S, class T, class Proj = identity>
constexpr I remove(I first, S last, const T& value, Proj proj = {}) {
  first = ranges::find(first, last, value, proj);
  if (first == last) return first;
  I out = first;
  for (++first; first != last; ++first) {
    if (!(__project(proj, *first) == value)) {
      *out = ranges::iter_move(first);
      ++out;
    }
  }
  return out;
}
