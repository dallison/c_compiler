//
//  algorithm
//  c_compiler
//
//  Classic (non-ranges, non-parallel) C++20 <algorithm> for DaveCC.
//
//  This provides the header-only sequence algorithms operating on iterator
//  pairs.  The ranges:: overloads and the ExecutionPolicy overloads are not
//  included (they require <ranges> integration and a parallelism runtime).
//  Randomized algorithms (shuffle, sample) are omitted because they need
//  <random>, which is not yet available.
//
//  min/max/minmax and swap-family helpers that the standard also lists in
//  other headers are kept where the standard primarily places them: swap,
//  move and forward come from <utility>; iter_swap and the sequence
//  algorithms live here.
//

#ifndef __davecc_algorithm__
#define __davecc_algorithm__

#include <initializer_list>
#include <iterator>
#include <stddef.h>
#include <type_traits>
#include <utility>

namespace std {

namespace __algorithm_detail {

// Default comparison / equality functors, so the plain (no-predicate)
// overloads can forward to the predicate ones without depending on the exact
// shape of <functional>'s transparent operators.
struct __less {
  template <class A, class B>
  constexpr bool operator()(const A& a, const B& b) const {
    return a < b;
  }
};

struct __equal_to {
  template <class A, class B>
  constexpr bool operator()(const A& a, const B& b) const {
    return a == b;
  }
};

}  // namespace __algorithm_detail

// ------------------------------------------------------------------
// min / max / minmax / clamp
// ------------------------------------------------------------------
template <class T>
constexpr const T& min(const T& a, const T& b) {
  return b < a ? b : a;
}

template <class T, class Compare>
constexpr const T& min(const T& a, const T& b, Compare comp) {
  return comp(b, a) ? b : a;
}

template <class T>
constexpr const T& max(const T& a, const T& b) {
  return a < b ? b : a;
}

template <class T, class Compare>
constexpr const T& max(const T& a, const T& b, Compare comp) {
  return comp(a, b) ? b : a;
}

template <class T, class Compare>
constexpr T min(initializer_list<T> values, Compare comp) {
  const T* it = values.begin();
  const T* best = it;
  for (++it; it != values.end(); ++it) {
    if (comp(*it, *best)) {
      best = it;
    }
  }
  return *best;
}

template <class T>
constexpr T min(initializer_list<T> values) {
  const T* it = values.begin();
  const T* best = it;
  for (++it; it != values.end(); ++it) {
    if (*it < *best) {
      best = it;
    }
  }
  return *best;
}

template <class T, class Compare>
constexpr T max(initializer_list<T> values, Compare comp) {
  const T* it = values.begin();
  const T* best = it;
  for (++it; it != values.end(); ++it) {
    if (comp(*best, *it)) {
      best = it;
    }
  }
  return *best;
}

template <class T>
constexpr T max(initializer_list<T> values) {
  const T* it = values.begin();
  const T* best = it;
  for (++it; it != values.end(); ++it) {
    if (*best < *it) {
      best = it;
    }
  }
  return *best;
}

template <class T, class Compare>
constexpr pair<const T&, const T&> minmax(const T& a, const T& b, Compare comp) {
  return comp(b, a) ? pair<const T&, const T&>(b, a)
                    : pair<const T&, const T&>(a, b);
}

template <class T>
constexpr pair<const T&, const T&> minmax(const T& a, const T& b) {
  return b < a ? pair<const T&, const T&>(b, a)
               : pair<const T&, const T&>(a, b);
}

template <class T, class Compare>
constexpr pair<T, T> minmax(initializer_list<T> values, Compare comp) {
  const T* it = values.begin();
  const T* lo = it;
  const T* hi = it;
  for (++it; it != values.end(); ++it) {
    if (comp(*it, *lo)) {
      lo = it;
    }
    if (!comp(*it, *hi)) {
      hi = it;
    }
  }
  return pair<T, T>(*lo, *hi);
}

template <class T>
constexpr pair<T, T> minmax(initializer_list<T> values) {
  const T* it = values.begin();
  const T* lo = it;
  const T* hi = it;
  for (++it; it != values.end(); ++it) {
    if (*it < *lo) {
      lo = it;
    }
    if (!(*it < *hi)) {
      hi = it;
    }
  }
  return pair<T, T>(*lo, *hi);
}

template <class T, class Compare>
constexpr const T& clamp(const T& v, const T& lo, const T& hi, Compare comp) {
  return comp(v, lo) ? lo : (comp(hi, v) ? hi : v);
}

template <class T>
constexpr const T& clamp(const T& v, const T& lo, const T& hi) {
  return std::clamp(v, lo, hi, __algorithm_detail::__less());
}

// ------------------------------------------------------------------
// swap helpers
// ------------------------------------------------------------------
template <class It1, class It2>
constexpr void iter_swap(It1 a, It2 b) {
  swap(*a, *b);
}

template <class It1, class It2>
constexpr It2 swap_ranges(It1 first1, It1 last1, It2 first2) {
  for (; first1 != last1; ++first1, ++first2) {
    std::iter_swap(first1, first2);
  }
  return first2;
}

// ------------------------------------------------------------------
// Non-modifying sequence operations
// ------------------------------------------------------------------
template <class It, class Pred>
constexpr bool all_of(It first, It last, Pred pred) {
  for (; first != last; ++first) {
    if (!pred(*first)) {
      return false;
    }
  }
  return true;
}

template <class It, class Pred>
constexpr bool any_of(It first, It last, Pred pred) {
  for (; first != last; ++first) {
    if (pred(*first)) {
      return true;
    }
  }
  return false;
}

template <class It, class Pred>
constexpr bool none_of(It first, It last, Pred pred) {
  for (; first != last; ++first) {
    if (pred(*first)) {
      return false;
    }
  }
  return true;
}

template <class It, class Fn>
constexpr Fn for_each(It first, It last, Fn fn) {
  for (; first != last; ++first) {
    fn(*first);
  }
  return fn;
}

template <class It, class Size, class Fn>
constexpr It for_each_n(It first, Size n, Fn fn) {
  for (Size i = 0; i < n; ++i, ++first) {
    fn(*first);
  }
  return first;
}

template <class It, class T>
constexpr typename iterator_traits<It>::difference_type count(It first,
                                                              It last,
                                                              const T& value) {
  typename iterator_traits<It>::difference_type n = 0;
  for (; first != last; ++first) {
    if (*first == value) {
      ++n;
    }
  }
  return n;
}

template <class It, class Pred>
constexpr typename iterator_traits<It>::difference_type count_if(It first,
                                                                 It last,
                                                                 Pred pred) {
  typename iterator_traits<It>::difference_type n = 0;
  for (; first != last; ++first) {
    if (pred(*first)) {
      ++n;
    }
  }
  return n;
}

template <class It, class T>
constexpr It find(It first, It last, const T& value) {
  for (; first != last; ++first) {
    if (*first == value) {
      return first;
    }
  }
  return last;
}

template <class It, class Pred>
constexpr It find_if(It first, It last, Pred pred) {
  for (; first != last; ++first) {
    if (pred(*first)) {
      return first;
    }
  }
  return last;
}

template <class It, class Pred>
constexpr It find_if_not(It first, It last, Pred pred) {
  for (; first != last; ++first) {
    if (!pred(*first)) {
      return first;
    }
  }
  return last;
}

template <class It, class Pred>
constexpr It adjacent_find(It first, It last, Pred pred) {
  if (first == last) {
    return last;
  }
  It next = first;
  for (++next; next != last; ++first, ++next) {
    if (pred(*first, *next)) {
      return first;
    }
  }
  return last;
}

template <class It>
constexpr It adjacent_find(It first, It last) {
  return std::adjacent_find(first, last, __algorithm_detail::__equal_to());
}

template <class It1, class It2, class Pred>
constexpr pair<It1, It2> mismatch(It1 first1, It1 last1, It2 first2,
                                  Pred pred) {
  for (; first1 != last1; ++first1, ++first2) {
    if (!pred(*first1, *first2)) {
      break;
    }
  }
  return pair<It1, It2>(first1, first2);
}

template <class It1, class It2>
constexpr pair<It1, It2> mismatch(It1 first1, It1 last1, It2 first2) {
  return std::mismatch(first1, last1, first2,
                       __algorithm_detail::__equal_to());
}

template <class It1, class It2, class Pred>
constexpr pair<It1, It2> mismatch(It1 first1, It1 last1, It2 first2,
                                  It2 last2, Pred pred) {
  for (; first1 != last1 && first2 != last2; ++first1, ++first2) {
    if (!pred(*first1, *first2)) {
      break;
    }
  }
  return pair<It1, It2>(first1, first2);
}

template <class It1, class It2>
constexpr pair<It1, It2> mismatch(It1 first1, It1 last1, It2 first2,
                                  It2 last2) {
  return std::mismatch(first1, last1, first2, last2,
                       __algorithm_detail::__equal_to());
}

template <class It1, class It2, class Pred>
constexpr bool equal(It1 first1, It1 last1, It2 first2, Pred pred) {
  for (; first1 != last1; ++first1, ++first2) {
    if (!pred(*first1, *first2)) {
      return false;
    }
  }
  return true;
}

template <class It1, class It2>
constexpr bool equal(It1 first1, It1 last1, It2 first2) {
  return std::equal(first1, last1, first2, __algorithm_detail::__equal_to());
}

template <class It1, class It2, class Pred>
constexpr bool equal(It1 first1, It1 last1, It2 first2, It2 last2, Pred pred) {
  for (; first1 != last1 && first2 != last2; ++first1, ++first2) {
    if (!pred(*first1, *first2)) {
      return false;
    }
  }
  return first1 == last1 && first2 == last2;
}

template <class It1, class It2>
constexpr bool equal(It1 first1, It1 last1, It2 first2, It2 last2) {
  return std::equal(first1, last1, first2, last2,
                    __algorithm_detail::__equal_to());
}

template <class It1, class It2, class Pred>
constexpr It1 search(It1 first, It1 last, It2 s_first, It2 s_last, Pred pred) {
  for (;; ++first) {
    It1 it = first;
    for (It2 s_it = s_first;; ++it, ++s_it) {
      if (s_it == s_last) {
        return first;
      }
      if (it == last) {
        return last;
      }
      if (!pred(*it, *s_it)) {
        break;
      }
    }
  }
}

template <class It1, class It2>
constexpr It1 search(It1 first, It1 last, It2 s_first, It2 s_last) {
  return std::search(first, last, s_first, s_last,
                     __algorithm_detail::__equal_to());
}

template <class It, class Size, class T, class Pred>
constexpr It search_n(It first, It last, Size count, const T& value,
                      Pred pred) {
  if (count <= 0) {
    return first;
  }
  for (; first != last; ++first) {
    if (!pred(*first, value)) {
      continue;
    }
    It candidate = first;
    Size cur = 0;
    while (true) {
      ++cur;
      if (cur >= count) {
        return candidate;
      }
      ++first;
      if (first == last) {
        return last;
      }
      if (!pred(*first, value)) {
        break;
      }
    }
  }
  return last;
}

template <class It, class Size, class T>
constexpr It search_n(It first, It last, Size count, const T& value) {
  return std::search_n(first, last, count, value,
                       __algorithm_detail::__equal_to());
}

template <class It1, class It2, class Pred>
constexpr It1 find_end(It1 first, It1 last, It2 s_first, It2 s_last,
                       Pred pred) {
  if (s_first == s_last) {
    return last;
  }
  It1 result = last;
  for (;;) {
    It1 next = std::search(first, last, s_first, s_last, pred);
    if (next == last) {
      return result;
    }
    result = next;
    first = next;
    ++first;
  }
}

template <class It1, class It2>
constexpr It1 find_end(It1 first, It1 last, It2 s_first, It2 s_last) {
  return std::find_end(first, last, s_first, s_last,
                       __algorithm_detail::__equal_to());
}

template <class It1, class It2, class Pred>
constexpr It1 find_first_of(It1 first, It1 last, It2 s_first, It2 s_last,
                            Pred pred) {
  for (; first != last; ++first) {
    for (It2 s_it = s_first; s_it != s_last; ++s_it) {
      if (pred(*first, *s_it)) {
        return first;
      }
    }
  }
  return last;
}

template <class It1, class It2>
constexpr It1 find_first_of(It1 first, It1 last, It2 s_first, It2 s_last) {
  return std::find_first_of(first, last, s_first, s_last,
                            __algorithm_detail::__equal_to());
}

// ------------------------------------------------------------------
// Modifying sequence operations
// ------------------------------------------------------------------
template <class In, class Out>
constexpr Out copy(In first, In last, Out result) {
  for (; first != last; ++first, ++result) {
    *result = *first;
  }
  return result;
}

template <class In, class Out, class Pred>
constexpr Out copy_if(In first, In last, Out result, Pred pred) {
  for (; first != last; ++first) {
    if (pred(*first)) {
      *result = *first;
      ++result;
    }
  }
  return result;
}

template <class In, class Size, class Out>
constexpr Out copy_n(In first, Size n, Out result) {
  for (Size i = 0; i < n; ++i, ++first, ++result) {
    *result = *first;
  }
  return result;
}

template <class In, class Out>
constexpr Out copy_backward(In first, In last, Out result) {
  while (first != last) {
    *--result = *--last;
  }
  return result;
}

template <class In, class Out>
constexpr Out move(In first, In last, Out result) {
  for (; first != last; ++first, ++result) {
    *result = std::move(*first);
  }
  return result;
}

template <class In, class Out>
constexpr Out move_backward(In first, In last, Out result) {
  while (first != last) {
    *--result = std::move(*--last);
  }
  return result;
}

template <class It, class T>
constexpr void fill(It first, It last, const T& value) {
  for (; first != last; ++first) {
    *first = value;
  }
}

template <class It, class Size, class T>
constexpr It fill_n(It first, Size n, const T& value) {
  for (Size i = 0; i < n; ++i, ++first) {
    *first = value;
  }
  return first;
}

template <class In, class Out, class Op>
constexpr Out transform(In first, In last, Out result, Op op) {
  for (; first != last; ++first, ++result) {
    *result = op(*first);
  }
  return result;
}

template <class In1, class In2, class Out, class BinOp>
constexpr Out transform(In1 first1, In1 last1, In2 first2, Out result,
                        BinOp op) {
  for (; first1 != last1; ++first1, ++first2, ++result) {
    *result = op(*first1, *first2);
  }
  return result;
}

template <class It, class Gen>
constexpr void generate(It first, It last, Gen gen) {
  for (; first != last; ++first) {
    *first = gen();
  }
}

template <class It, class Size, class Gen>
constexpr It generate_n(It first, Size n, Gen gen) {
  for (Size i = 0; i < n; ++i, ++first) {
    *first = gen();
  }
  return first;
}

template <class It, class T>
constexpr void replace(It first, It last, const T& old_value,
                       const T& new_value) {
  for (; first != last; ++first) {
    if (*first == old_value) {
      *first = new_value;
    }
  }
}

template <class It, class Pred, class T>
constexpr void replace_if(It first, It last, Pred pred, const T& new_value) {
  for (; first != last; ++first) {
    if (pred(*first)) {
      *first = new_value;
    }
  }
}

template <class In, class Out, class T>
constexpr Out replace_copy(In first, In last, Out result, const T& old_value,
                           const T& new_value) {
  for (; first != last; ++first, ++result) {
    *result = (*first == old_value) ? new_value : *first;
  }
  return result;
}

template <class In, class Out, class Pred, class T>
constexpr Out replace_copy_if(In first, In last, Out result, Pred pred,
                              const T& new_value) {
  for (; first != last; ++first, ++result) {
    *result = pred(*first) ? new_value : *first;
  }
  return result;
}

template <class In, class Out, class T>
constexpr Out remove_copy(In first, In last, Out result, const T& value) {
  for (; first != last; ++first) {
    if (!(*first == value)) {
      *result = *first;
      ++result;
    }
  }
  return result;
}

template <class In, class Out, class Pred>
constexpr Out remove_copy_if(In first, In last, Out result, Pred pred) {
  for (; first != last; ++first) {
    if (!pred(*first)) {
      *result = *first;
      ++result;
    }
  }
  return result;
}

template <class It, class T>
constexpr It remove(It first, It last, const T& value) {
  first = std::find(first, last, value);
  if (first == last) {
    return first;
  }
  It result = first;
  ++first;
  for (; first != last; ++first) {
    if (!(*first == value)) {
      *result = std::move(*first);
      ++result;
    }
  }
  return result;
}

template <class It, class Pred>
constexpr It remove_if(It first, It last, Pred pred) {
  first = std::find_if(first, last, pred);
  if (first == last) {
    return first;
  }
  It result = first;
  ++first;
  for (; first != last; ++first) {
    if (!pred(*first)) {
      *result = std::move(*first);
      ++result;
    }
  }
  return result;
}

template <class It>
constexpr void reverse(It first, It last) {
  while (first != last) {
    --last;
    if (first == last) {
      break;
    }
    std::iter_swap(first, last);
    ++first;
  }
}

template <class In, class Out>
constexpr Out reverse_copy(In first, In last, Out result) {
  while (first != last) {
    --last;
    *result = *last;
    ++result;
  }
  return result;
}

template <class It>
constexpr It rotate(It first, It middle, It last) {
  if (first == middle) {
    return last;
  }
  if (middle == last) {
    return first;
  }
  std::reverse(first, middle);
  std::reverse(middle, last);
  std::reverse(first, last);
  It result = first;
  std::advance(result, std::distance(middle, last));
  return result;
}

template <class In, class Out>
constexpr Out rotate_copy(In first, In middle, In last, Out result) {
  result = std::copy(middle, last, result);
  return std::copy(first, middle, result);
}

template <class In, class Out, class Pred>
constexpr Out unique_copy(In first, In last, Out result, Pred pred) {
  if (first == last) {
    return result;
  }
  typename iterator_traits<In>::value_type value = *first;
  *result = value;
  ++result;
  for (++first; first != last; ++first) {
    if (!pred(value, *first)) {
      value = *first;
      *result = value;
      ++result;
    }
  }
  return result;
}

template <class In, class Out>
constexpr Out unique_copy(In first, In last, Out result) {
  return std::unique_copy(first, last, result,
                          __algorithm_detail::__equal_to());
}

template <class It, class Pred>
constexpr It unique(It first, It last, Pred pred) {
  if (first == last) {
    return last;
  }
  It result = first;
  while (++first != last) {
    if (!pred(*result, *first) && ++result != first) {
      *result = std::move(*first);
    }
  }
  return ++result;
}

template <class It>
constexpr It unique(It first, It last) {
  return std::unique(first, last, __algorithm_detail::__equal_to());
}

// ------------------------------------------------------------------
// Partitioning
// ------------------------------------------------------------------
template <class It, class Pred>
constexpr bool is_partitioned(It first, It last, Pred pred) {
  for (; first != last; ++first) {
    if (!pred(*first)) {
      break;
    }
  }
  for (; first != last; ++first) {
    if (pred(*first)) {
      return false;
    }
  }
  return true;
}

template <class It, class Pred>
constexpr It partition(It first, It last, Pred pred) {
  first = std::find_if_not(first, last, pred);
  if (first == last) {
    return first;
  }
  It it = first;
  for (++it; it != last; ++it) {
    if (pred(*it)) {
      std::iter_swap(first, it);
      ++first;
    }
  }
  return first;
}

template <class It, class Pred>
constexpr It partition_point(It first, It last, Pred pred) {
  typename iterator_traits<It>::difference_type len =
      std::distance(first, last);
  while (len > 0) {
    typename iterator_traits<It>::difference_type half = len / 2;
    It mid = first;
    std::advance(mid, half);
    if (pred(*mid)) {
      first = mid;
      ++first;
      len -= half + 1;
    } else {
      len = half;
    }
  }
  return first;
}

template <class In, class Out1, class Out2, class Pred>
constexpr pair<Out1, Out2> partition_copy(In first, In last, Out1 out_true,
                                          Out2 out_false, Pred pred) {
  for (; first != last; ++first) {
    if (pred(*first)) {
      *out_true = *first;
      ++out_true;
    } else {
      *out_false = *first;
      ++out_false;
    }
  }
  return pair<Out1, Out2>(out_true, out_false);
}

// stable_partition via a stable in-place approach: partition each half and
// rotate the false-prefix of the right half in front of the true-suffix of the
// left half.  O(n log n) comparisons, no auxiliary allocation.
template <class It, class Pred>
constexpr It stable_partition(It first, It last, Pred pred) {
  typename iterator_traits<It>::difference_type n = std::distance(first, last);
  if (n == 0) {
    return first;
  }
  if (n == 1) {
    return pred(*first) ? last : first;
  }
  It mid = first;
  std::advance(mid, n / 2);
  It left = std::stable_partition(first, mid, pred);
  It right = std::stable_partition(mid, last, pred);
  return std::rotate(left, mid, right);
}

// ------------------------------------------------------------------
// Binary search on sorted ranges
// ------------------------------------------------------------------
template <class It, class T, class Compare>
constexpr It lower_bound(It first, It last, const T& value, Compare comp) {
  typename iterator_traits<It>::difference_type len =
      std::distance(first, last);
  while (len > 0) {
    typename iterator_traits<It>::difference_type half = len / 2;
    It mid = first;
    std::advance(mid, half);
    if (comp(*mid, value)) {
      first = mid;
      ++first;
      len -= half + 1;
    } else {
      len = half;
    }
  }
  return first;
}

template <class It, class T>
constexpr It lower_bound(It first, It last, const T& value) {
  return std::lower_bound(first, last, value, __algorithm_detail::__less());
}

template <class It, class T, class Compare>
constexpr It upper_bound(It first, It last, const T& value, Compare comp) {
  typename iterator_traits<It>::difference_type len =
      std::distance(first, last);
  while (len > 0) {
    typename iterator_traits<It>::difference_type half = len / 2;
    It mid = first;
    std::advance(mid, half);
    if (!comp(value, *mid)) {
      first = mid;
      ++first;
      len -= half + 1;
    } else {
      len = half;
    }
  }
  return first;
}

template <class It, class T>
constexpr It upper_bound(It first, It last, const T& value) {
  return std::upper_bound(first, last, value, __algorithm_detail::__less());
}

template <class It, class T, class Compare>
constexpr pair<It, It> equal_range(It first, It last, const T& value,
                                   Compare comp) {
  return pair<It, It>(std::lower_bound(first, last, value, comp),
                      std::upper_bound(first, last, value, comp));
}

template <class It, class T>
constexpr pair<It, It> equal_range(It first, It last, const T& value) {
  return std::equal_range(first, last, value, __algorithm_detail::__less());
}

template <class It, class T, class Compare>
constexpr bool binary_search(It first, It last, const T& value, Compare comp) {
  first = std::lower_bound(first, last, value, comp);
  return first != last && !comp(value, *first);
}

template <class It, class T>
constexpr bool binary_search(It first, It last, const T& value) {
  return std::binary_search(first, last, value, __algorithm_detail::__less());
}

// ------------------------------------------------------------------
// Heap operations (random-access iterators)
// ------------------------------------------------------------------
namespace __algorithm_detail {

template <class It, class Diff, class Compare>
constexpr void __sift_down(It first, Diff start, Diff n, Compare comp) {
  Diff root = start;
  for (;;) {
    Diff child = 2 * root + 1;
    if (child >= n) {
      break;
    }
    if (child + 1 < n && comp(first[child], first[child + 1])) {
      ++child;
    }
    if (comp(first[root], first[child])) {
      std::iter_swap(first + root, first + child);
      root = child;
    } else {
      break;
    }
  }
}

template <class It, class Diff, class Compare>
constexpr void __sift_up(It first, Diff child, Compare comp) {
  while (child > 0) {
    Diff parent = (child - 1) / 2;
    if (comp(first[parent], first[child])) {
      std::iter_swap(first + parent, first + child);
      child = parent;
    } else {
      break;
    }
  }
}

}  // namespace __algorithm_detail

template <class It, class Compare>
constexpr void push_heap(It first, It last, Compare comp) {
  typename iterator_traits<It>::difference_type n = last - first;
  if (n > 1) {
    __algorithm_detail::__sift_up(first, n - 1, comp);
  }
}

template <class It>
constexpr void push_heap(It first, It last) {
  std::push_heap(first, last, __algorithm_detail::__less());
}

template <class It, class Compare>
constexpr void pop_heap(It first, It last, Compare comp) {
  typename iterator_traits<It>::difference_type n = last - first;
  if (n > 1) {
    std::iter_swap(first, last - 1);
    __algorithm_detail::__sift_down(
        first, (typename iterator_traits<It>::difference_type)0, n - 1, comp);
  }
}

template <class It>
constexpr void pop_heap(It first, It last) {
  std::pop_heap(first, last, __algorithm_detail::__less());
}

template <class It, class Compare>
constexpr void make_heap(It first, It last, Compare comp) {
  typename iterator_traits<It>::difference_type n = last - first;
  for (typename iterator_traits<It>::difference_type i = n / 2 - 1; i >= 0;
       --i) {
    __algorithm_detail::__sift_down(first, i, n, comp);
  }
}

template <class It>
constexpr void make_heap(It first, It last) {
  std::make_heap(first, last, __algorithm_detail::__less());
}

template <class It, class Compare>
constexpr void sort_heap(It first, It last, Compare comp) {
  while (last - first > 1) {
    std::pop_heap(first, last, comp);
    --last;
  }
}

template <class It>
constexpr void sort_heap(It first, It last) {
  std::sort_heap(first, last, __algorithm_detail::__less());
}

template <class It, class Compare>
constexpr It is_heap_until(It first, It last, Compare comp) {
  typename iterator_traits<It>::difference_type n = last - first;
  typename iterator_traits<It>::difference_type child = 1;
  for (typename iterator_traits<It>::difference_type parent = 0; child < n;
       ++child) {
    if (comp(first[parent], first[child])) {
      return first + child;
    }
    if ((child & 1) == 0) {
      ++parent;
    }
  }
  return last;
}

template <class It>
constexpr It is_heap_until(It first, It last) {
  return std::is_heap_until(first, last, __algorithm_detail::__less());
}

template <class It, class Compare>
constexpr bool is_heap(It first, It last, Compare comp) {
  return std::is_heap_until(first, last, comp) == last;
}

template <class It>
constexpr bool is_heap(It first, It last) {
  return std::is_heap(first, last, __algorithm_detail::__less());
}

// ------------------------------------------------------------------
// Sorting
// ------------------------------------------------------------------
namespace __algorithm_detail {

template <class It, class Compare>
constexpr void __insertion_sort(It first, It last, Compare comp) {
  if (first == last) {
    return;
  }
  for (It i = first + 1; i != last; ++i) {
    typename iterator_traits<It>::value_type key = std::move(*i);
    It j = i;
    while (j != first && comp(key, *(j - 1))) {
      *j = std::move(*(j - 1));
      --j;
    }
    *j = std::move(key);
  }
}

// Partition [first, last) around a median-of-three pivot.  Returns the split
// point; both sides are non-empty for ranges of length >= 2.
template <class It, class Compare>
constexpr It __partition_pivot(It first, It last, Compare comp) {
  It mid = first + (last - first) / 2;
  It penult = last - 1;
  if (comp(*mid, *first)) {
    std::iter_swap(mid, first);
  }
  if (comp(*penult, *first)) {
    std::iter_swap(penult, first);
  }
  if (comp(*penult, *mid)) {
    std::iter_swap(penult, mid);
  }
  // Median now at *mid; move it to first as the pivot.
  std::iter_swap(first, mid);
  typename iterator_traits<It>::value_type pivot = *first;
  It i = first;
  It j = last;
  for (;;) {
    do {
      ++i;
    } while (i != last && comp(*i, pivot));
    do {
      --j;
    } while (comp(pivot, *j));
    if (!(i < j)) {
      break;
    }
    std::iter_swap(i, j);
  }
  std::iter_swap(first, j);
  return j;
}

template <class It, class Compare>
constexpr void __introsort(It first, It last, int depth_limit, Compare comp) {
  while (last - first > 16) {
    if (depth_limit == 0) {
      std::make_heap(first, last, comp);
      std::sort_heap(first, last, comp);
      return;
    }
    --depth_limit;
    It split = __partition_pivot(first, last, comp);
    // Recurse into the smaller side, iterate on the larger to bound stack use.
    if (split - first < last - split) {
      __introsort(first, split, depth_limit, comp);
      first = split + 1;
    } else {
      __introsort(split + 1, last, depth_limit, comp);
      last = split;
    }
  }
}

constexpr int __log2_floor(ptrdiff_t n) {
  int k = 0;
  while (n > 1) {
    n >>= 1;
    ++k;
  }
  return k;
}

}  // namespace __algorithm_detail

template <class It, class Compare>
constexpr void sort(It first, It last, Compare comp) {
  if (last - first > 1) {
    __algorithm_detail::__introsort(
        first, last, 2 * __algorithm_detail::__log2_floor(last - first), comp);
    __algorithm_detail::__insertion_sort(first, last, comp);
  }
}

template <class It>
constexpr void sort(It first, It last) {
  std::sort(first, last, __algorithm_detail::__less());
}

template <class It, class Compare>
constexpr It __is_sorted_until_impl(It first, It last, Compare comp) {
  if (first == last) {
    return last;
  }
  It next = first;
  for (++next; next != last; ++first, ++next) {
    if (comp(*next, *first)) {
      return next;
    }
  }
  return last;
}

template <class It, class Compare>
constexpr bool is_sorted(It first, It last, Compare comp) {
  return __is_sorted_until_impl(first, last, comp) == last;
}

template <class It>
constexpr bool is_sorted(It first, It last) {
  return std::is_sorted(first, last, __algorithm_detail::__less());
}

template <class It, class Compare>
constexpr It is_sorted_until(It first, It last, Compare comp) {
  return __is_sorted_until_impl(first, last, comp);
}

template <class It>
constexpr It is_sorted_until(It first, It last) {
  return __is_sorted_until_impl(first, last, __algorithm_detail::__less());
}

// stable_sort: top-down merge sort using rotate-based in-place merge (no
// auxiliary allocation), with an insertion-sort base case that preserves
// stability.
namespace __algorithm_detail {

template <class It, class Compare>
constexpr void __inplace_merge(It first, It mid, It last, Compare comp) {
  if (first == mid || mid == last) {
    return;
  }
  if (last - first == 2) {
    if (comp(*mid, *first)) {
      std::iter_swap(first, mid);
    }
    return;
  }
  It first_cut;
  It second_cut;
  if (mid - first > last - mid) {
    first_cut = first + (mid - first) / 2;
    second_cut = std::lower_bound(mid, last, *first_cut, comp);
  } else {
    second_cut = mid + (last - mid) / 2;
    first_cut = std::upper_bound(first, mid, *second_cut, comp);
  }
  std::rotate(first_cut, mid, second_cut);
  It new_mid = first_cut + (second_cut - mid);
  __inplace_merge(first, first_cut, new_mid, comp);
  __inplace_merge(new_mid, second_cut, last, comp);
}

template <class It, class Compare>
constexpr void __stable_sort(It first, It last, Compare comp) {
  typename iterator_traits<It>::difference_type n = last - first;
  if (n <= 16) {
    __insertion_sort(first, last, comp);
    return;
  }
  It mid = first + n / 2;
  __stable_sort(first, mid, comp);
  __stable_sort(mid, last, comp);
  __inplace_merge(first, mid, last, comp);
}

}  // namespace __algorithm_detail

template <class It, class Compare>
constexpr void stable_sort(It first, It last, Compare comp) {
  __algorithm_detail::__stable_sort(first, last, comp);
}

template <class It>
constexpr void stable_sort(It first, It last) {
  std::stable_sort(first, last, __algorithm_detail::__less());
}

template <class It, class Compare>
constexpr void inplace_merge(It first, It mid, It last, Compare comp) {
  __algorithm_detail::__inplace_merge(first, mid, last, comp);
}

template <class It>
constexpr void inplace_merge(It first, It mid, It last) {
  __algorithm_detail::__inplace_merge(first, mid, last,
                                      __algorithm_detail::__less());
}

template <class It, class Compare>
constexpr void partial_sort(It first, It middle, It last, Compare comp) {
  if (first == middle) {
    return;
  }
  std::make_heap(first, middle, comp);
  for (It i = middle; i != last; ++i) {
    if (comp(*i, *first)) {
      std::iter_swap(first, i);
      __algorithm_detail::__sift_down(
          first, (typename iterator_traits<It>::difference_type)0,
          middle - first, comp);
    }
  }
  std::sort_heap(first, middle, comp);
}

template <class It>
constexpr void partial_sort(It first, It middle, It last) {
  std::partial_sort(first, middle, last, __algorithm_detail::__less());
}

template <class It, class Compare>
constexpr void nth_element(It first, It nth, It last, Compare comp) {
  if (nth == last) {
    return;
  }
  while (last - first > 3) {
    It split = __algorithm_detail::__partition_pivot(first, last, comp);
    if (split <= nth) {
      first = split + 1;
    } else {
      last = split;
    }
  }
  __algorithm_detail::__insertion_sort(first, last, comp);
}

template <class It>
constexpr void nth_element(It first, It nth, It last) {
  std::nth_element(first, nth, last, __algorithm_detail::__less());
}

// ------------------------------------------------------------------
// Merge and set operations on sorted ranges
// ------------------------------------------------------------------
template <class In1, class In2, class Out, class Compare>
constexpr Out merge(In1 first1, In1 last1, In2 first2, In2 last2, Out result,
                    Compare comp) {
  while (first1 != last1 && first2 != last2) {
    if (comp(*first2, *first1)) {
      *result = *first2;
      ++first2;
    } else {
      *result = *first1;
      ++first1;
    }
    ++result;
  }
  result = std::copy(first1, last1, result);
  return std::copy(first2, last2, result);
}

template <class In1, class In2, class Out>
constexpr Out merge(In1 first1, In1 last1, In2 first2, In2 last2, Out result) {
  return std::merge(first1, last1, first2, last2, result,
                    __algorithm_detail::__less());
}

template <class In1, class In2, class Compare>
constexpr bool includes(In1 first1, In1 last1, In2 first2, In2 last2,
                        Compare comp) {
  for (; first2 != last2; ++first1) {
    if (first1 == last1 || comp(*first2, *first1)) {
      return false;
    }
    if (!comp(*first1, *first2)) {
      ++first2;
    }
  }
  return true;
}

template <class In1, class In2>
constexpr bool includes(In1 first1, In1 last1, In2 first2, In2 last2) {
  return std::includes(first1, last1, first2, last2,
                       __algorithm_detail::__less());
}

template <class In1, class In2, class Out, class Compare>
constexpr Out set_union(In1 first1, In1 last1, In2 first2, In2 last2,
                        Out result, Compare comp) {
  while (first1 != last1 && first2 != last2) {
    if (comp(*first1, *first2)) {
      *result = *first1;
      ++first1;
    } else if (comp(*first2, *first1)) {
      *result = *first2;
      ++first2;
    } else {
      *result = *first1;
      ++first1;
      ++first2;
    }
    ++result;
  }
  result = std::copy(first1, last1, result);
  return std::copy(first2, last2, result);
}

template <class In1, class In2, class Out>
constexpr Out set_union(In1 first1, In1 last1, In2 first2, In2 last2,
                        Out result) {
  return std::set_union(first1, last1, first2, last2, result,
                        __algorithm_detail::__less());
}

template <class In1, class In2, class Out, class Compare>
constexpr Out set_intersection(In1 first1, In1 last1, In2 first2, In2 last2,
                               Out result, Compare comp) {
  while (first1 != last1 && first2 != last2) {
    if (comp(*first1, *first2)) {
      ++first1;
    } else if (comp(*first2, *first1)) {
      ++first2;
    } else {
      *result = *first1;
      ++result;
      ++first1;
      ++first2;
    }
  }
  return result;
}

template <class In1, class In2, class Out>
constexpr Out set_intersection(In1 first1, In1 last1, In2 first2, In2 last2,
                               Out result) {
  return std::set_intersection(first1, last1, first2, last2, result,
                               __algorithm_detail::__less());
}

template <class In1, class In2, class Out, class Compare>
constexpr Out set_difference(In1 first1, In1 last1, In2 first2, In2 last2,
                             Out result, Compare comp) {
  while (first1 != last1 && first2 != last2) {
    if (comp(*first1, *first2)) {
      *result = *first1;
      ++result;
      ++first1;
    } else if (comp(*first2, *first1)) {
      ++first2;
    } else {
      ++first1;
      ++first2;
    }
  }
  return std::copy(first1, last1, result);
}

