// Stable partition by rotating each satisfying element down to the partition
// point, which preserves the relative order of both groups.
template <class I, class S, class Pred, class Proj = identity>
constexpr subrange<I, I> stable_partition(I first, S last, Pred pred,
                                          Proj proj = {}) {
  I end = ranges::next(first, last);
  I result = first;
  for (I i = first; i != end; ++i) {
    if (!pred(__project(proj, *i))) continue;
    for (I j = i; j != result;) {
      I previous = j;
      --previous;
      ranges::iter_swap(j, previous);
      j = previous;
    }
    ++result;
  }
  return {result, end};
}
