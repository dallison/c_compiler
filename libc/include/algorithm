          class Pred = equal_to, class P1 = identity,
          class P2 = identity>
constexpr bool ends_with(I1 first1, S1 last1, I2 first2, S2 last2,
                         Pred pred = {}, P1 p1 = {}, P2 p2 = {}) {
  if (first2 == last2) {
    return true;
  }
  I1 end = first1;
  while (end != last1) {
    ++end;
  }
  auto found =
      ranges::find_end(first1, last1, first2, last2, pred, p1, p2);
  return !found.empty() && found.end() == end;
}

