template <class I1, class S1, class I2, class S2, class O,
          class Comp = less, class P1 = identity, class P2 = identity>
constexpr merge_result<I1, I2, O> merge(I1 first1, S1 last1,
                                        I2 first2, S2 last2, O out,
                                        Comp comp = {}, P1 p1 = {},
                                        P2 p2 = {}) {
  while (first1 != last1 && first2 != last2) {
    if (comp(__project(p2, *first2), __project(p1, *first1))) {
      *out = *first2;
      ++first2;
    } else {
      *out = *first1;
      ++first1;
    }
    ++out;
  }
  auto left = ranges::copy(first1, last1, out);
  auto right = ranges::copy(first2, last2, left.out);
  return {left.in, right.in, right.out};
}
