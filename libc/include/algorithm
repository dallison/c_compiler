constexpr copy_result<I, O> rotate_copy(I first, I middle, S last, O out) {
  I current = middle;
  while (current != last) {
    *out = *current;
    ++out;
    ++current;
  }
  current = first;
  while (current != middle) {
    *out = *current;
    ++out;
    ++current;
  }
  I end = middle;
  while (end != last) ++end;
  return {end, out};
}
