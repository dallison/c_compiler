  return ranges::copy(ranges::begin(r), ranges::end(r), out);
}
template <class I, class O>
constexpr copy_result<I, O> copy_n(I first, iter_difference_t<I> n, O out) {
  while (n-- > 0) {
    *out = *first;
    ++first;
    ++out;
  }
  return {first, out};
}
template <class I, class S, class O, class Pred, class Proj = identity>
constexpr copy_result<I, O> copy_if(I first, S last, O out, Pred pred,
                                    Proj proj = {}) {
  for (; first != last; ++first) {
    if (pred(__project(proj, *first))) {
      *out = *first;
      ++out;
    }
  }
  copy_result<I, O> result;
  result.in = first;
  result.out = out;
  return result;
}
template <range CopyRange, class CopyOutput, class CopyPredicate,
          class CopyProjection = identity>
constexpr copy_result<borrowed_iterator_t<CopyRange>, CopyOutput> copy_if(
    CopyRange&& r, CopyOutput out, CopyPredicate pred,
    CopyProjection proj = {}) {
  auto first = ranges::begin(r);
  auto last = ranges::end(r);
  CopyOutput current_out = out;
  for (; first != last; ++first) {
    if (pred(__project(proj, *first))) {
      *current_out = *first;
      ++current_out;
    }
  }
  copy_result<borrowed_iterator_t<CopyRange>, CopyOutput> result;
  result.in = first;
  result.out = current_out;
  return result;
}
