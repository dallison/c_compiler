template <class I, class S, class Pred = equal_to, class Proj = identity>
constexpr I adjacent_find(I first, S last, Pred pred = {}, Proj proj = {}) {
  if (first == last) return first;
  I next = first;
  ++next;
  while (next != last) {
    if (pred(__project(proj, *first), __project(proj, *next))) return first;
    first = next;
    ++next;
  }
  return next;
}
template <range R, class Pred = equal_to, class Proj = identity>
constexpr borrowed_iterator_t<R> adjacent_find(R&& r, Pred pred = {},
                                                Proj proj = {}) {
  return ranges::adjacent_find(ranges::begin(r), ranges::end(r), pred, proj);
}
template <class I1, class S1, class I2, class S2,
          class Pred = equal_to, class P1 = identity, class P2 = identity>
constexpr subrange<I1, I1> search(I1 first1, S1 last1, I2 first2, S2 last2,
                                  Pred pred = {}, P1 p1 = {}, P2 p2 = {}) {
  if (first2 == last2) return {first1, first1};
  for (; first1 != last1; ++first1) {
    I1 a = first1;
    I2 b = first2;
    while (a != last1 && b != last2 &&
           pred(__project(p1, *a), __project(p2, *b))) {
      ++a;
      ++b;
    }
    if (b == last2) return {first1, a};
    if (a == last1) return {a, a};
  }
  return {first1, first1};
}
template <range R1, range R2, class Pred = equal_to,
          class P1 = identity, class P2 = identity>
constexpr borrowed_subrange_t<R1> search(R1&& r1, R2&& r2, Pred pred = {},
                                         P1 p1 = {}, P2 p2 = {}) {
  return ranges::search(ranges::begin(r1), ranges::end(r1),
                        ranges::begin(r2), ranges::end(r2), pred, p1, p2);
}
template <class I, class S, class T, class Pred = equal_to,
          class Proj = identity>
constexpr subrange<I, I> search_n(I first, S last, iter_difference_t<I> count,
                                  const T& value, Pred pred = {},
                                  Proj proj = {}) {
  if (count <= 0) return {first, first};
  while (first != last) {
    I start = first;
    iter_difference_t<I> n = 0;
    while (first != last && n < count &&
           pred(__project(proj, *first), value)) {
      ++first;
      ++n;
    }
    if (n == count) return {start, first};
    if (first == last) return {first, first};
    ++first;
  }
  return {first, first};
}
