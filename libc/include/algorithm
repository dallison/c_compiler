}

// Folds a comparator and a projection into one comparator, so the constrained
// algorithms can hand the work to the unconstrained implementations above,
// which know nothing about projections.
template <class Comp, class Proj>
struct __projected_comparator {
  Comp comp;
  Proj proj;

  template <class T, class U>
  constexpr bool operator()(T&& left, U&& right) {
    return __compare(comp, __project(proj, static_cast<T&&>(left)),
                     __project(proj, static_cast<U&&>(right)));
  }
};

template <class Comp, class Proj>
constexpr __projected_comparator<Comp, Proj> __project_comparator(Comp comp,
                                                                 Proj proj) {
  return {comp, proj};
}

