// [alg.fold]
template <class F, class T, class I>
using __fold_left_value_t =
    decay_t<invoke_result_t<F&, T, iter_reference_t<I>>>;

template <class F, class I>
using __fold_first_value_t =
    decay_t<invoke_result_t<F&, iter_value_t<I>,
                            iter_reference_t<I>>>;

template <class I, class S, class T, class F>
constexpr in_value_result<I, __fold_left_value_t<F, T, I>>
fold_left_with_iter(I first, S last, T init, F f) {
  using U = __fold_left_value_t<F, T, I>;
  if (first == last) {
    return {static_cast<I&&>(first), U(static_cast<T&&>(init))};
  }
  U accum = std::invoke(f, static_cast<T&&>(init), *first);
  ++first;
  while (first != last) {
    accum = std::invoke(f, static_cast<U&&>(accum), *first);
    ++first;
  }
  return {static_cast<I&&>(first), static_cast<U&&>(accum)};
}

template <range R, class T, class F>
constexpr in_value_result<
    borrowed_iterator_t<R>,
    __fold_left_value_t<F, T, iterator_t<R>>>
fold_left_with_iter(R&& range, T init, F f) {
  using U = __fold_left_value_t<F, T, iterator_t<R>>;
  using BI = borrowed_iterator_t<R>;
  auto result = ranges::fold_left_with_iter(
      ranges::begin(range), ranges::end(range),
      static_cast<T&&>(init), static_cast<F&&>(f));
  if constexpr (borrowed_range<R>) {
    return {static_cast<BI&&>(result.in),
            static_cast<U&&>(result.value)};
  } else {
    return {dangling(), static_cast<U&&>(result.value)};
  }
}

template <class I, class S, class T, class F>
constexpr auto fold_left(I first, S last, T init, F f) {
  return ranges::fold_left_with_iter(
             static_cast<I&&>(first), static_cast<S&&>(last),
             static_cast<T&&>(init), static_cast<F&&>(f))
      .value;
}

template <range R, class T, class F>
constexpr auto fold_left(R&& range, T init, F f) {
  return ranges::fold_left(
      ranges::begin(range), ranges::end(range),
      static_cast<T&&>(init), static_cast<F&&>(f));
}

template <class I, class S, class F>
constexpr in_value_result<I, optional<__fold_first_value_t<F, I>>>
fold_left_first_with_iter(I first, S last, F f) {
  using V = iter_value_t<I>;
  using U = __fold_first_value_t<F, I>;
  if (first == last) {
    return {static_cast<I&&>(first), optional<U>()};
  }
  optional<U> accum(in_place, V(*first));
  ++first;
  while (first != last) {
    *accum = std::invoke(f, static_cast<U&&>(*accum), *first);
    ++first;
  }
  return {static_cast<I&&>(first),
          static_cast<optional<U>&&>(accum)};
}

template <range R, class F>
constexpr in_value_result<
    borrowed_iterator_t<R>,
    optional<__fold_first_value_t<F, iterator_t<R>>>>
fold_left_first_with_iter(R&& range, F f) {
  using U = __fold_first_value_t<F, iterator_t<R>>;
  using O = optional<U>;
  using BI = borrowed_iterator_t<R>;
  auto result = ranges::fold_left_first_with_iter(
      ranges::begin(range), ranges::end(range), static_cast<F&&>(f));
  if constexpr (borrowed_range<R>) {
    return {static_cast<BI&&>(result.in),
            static_cast<O&&>(result.value)};
  } else {
    return {dangling(), static_cast<O&&>(result.value)};
  }
}

template <class I, class S, class F>
constexpr auto fold_left_first(I first, S last, F f) {
  return ranges::fold_left_first_with_iter(
             static_cast<I&&>(first), static_cast<S&&>(last),
             static_cast<F&&>(f))
      .value;
}

template <range R, class F>
constexpr auto fold_left_first(R&& range, F f) {
  return ranges::fold_left_first(
      ranges::begin(range), ranges::end(range), static_cast<F&&>(f));
}

template <class I, class S, class T, class F>
constexpr auto fold_right(I first, S last, T init, F f) {
  using U =
      decay_t<invoke_result_t<F&, iter_reference_t<I>, T>>;
  I tail = first;
  while (tail != last) {
    ++tail;
  }
  if (first == tail) {
    return U(static_cast<T&&>(init));
  }
  --tail;
  U accum = std::invoke(f, *tail, static_cast<T&&>(init));
  while (first != tail) {
    --tail;
    accum = std::invoke(f, *tail, static_cast<U&&>(accum));
  }
  return accum;
}

template <range R, class T, class F>
constexpr auto fold_right(R&& range, T init, F f) {
  return ranges::fold_right(
      ranges::begin(range), ranges::end(range),
      static_cast<T&&>(init), static_cast<F&&>(f));
}

template <class I, class S, class F>
constexpr auto fold_right_last(I first, S last, F f) {
  using V = iter_value_t<I>;
  using U =
      decay_t<invoke_result_t<F&, iter_reference_t<I>, V>>;
  I tail = first;
  while (tail != last) {
    ++tail;
  }
  if (first == tail) {
    return optional<U>();
  }
  --tail;
  V initial = *tail;
  return optional<U>(
      in_place,
      ranges::fold_right(first, tail, static_cast<V&&>(initial),
                         static_cast<F&&>(f)));
}

template <range R, class F>
constexpr auto fold_right_last(R&& range, F f) {
  return ranges::fold_right_last(
      ranges::begin(range), ranges::end(range), static_cast<F&&>(f));
}

