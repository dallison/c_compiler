template <class I1, class S1, class I2, class S2, class Pred = equal_to,
          class P1 = identity, class P2 = identity>
constexpr bool is_permutation(I1 first1, S1 last1, I2 first2, S2 last2,
                              Pred pred = {}, P1 p1 = {}, P2 p2 = {}) {
  I1 end1 = ranges::next(first1, last1);
  I2 end2 = ranges::next(first2, last2);
  if (ranges::distance(first1, end1) != ranges::distance(first2, end2)) {
    return false;
  }
  for (I1 i = first1; i != end1; ++i) {
    bool counted = false;
    for (I1 seen = first1; seen != i; ++seen) {
      if (pred(__project(p1, *seen), __project(p1, *i))) {
        counted = true;
        break;
      }
    }
    if (counted) continue;
    iter_difference_t<I1> in_first = 0;
    for (I1 j = i; j != end1; ++j) {
      if (pred(__project(p1, *i), __project(p1, *j))) ++in_first;
    }
    iter_difference_t<I1> in_second = 0;
    for (I2 j = first2; j != end2; ++j) {
      if (pred(__project(p1, *i), __project(p2, *j))) ++in_second;
    }
    if (in_first != in_second) return false;
  }
  return true;
}
template <range R1, range R2, class Pred = equal_to, class P1 = identity,
          class P2 = identity>
constexpr bool is_permutation(R1&& r1, R2&& r2, Pred pred = {}, P1 p1 = {},
                              P2 p2 = {}) {
  return ranges::is_permutation(ranges::begin(r1), ranges::end(r1),
                                ranges::begin(r2), ranges::end(r2), pred, p1,
                                p2);
}
template <class I, class S, class Comp = less, class Proj = identity>
constexpr next_permutation_result<I> next_permutation(
    I first, S last, Comp comp = {}, Proj proj = {}) {
  I end = first;
  while (end != last) ++end;
  if (first == end) return {end, false};
  I i = end;
  --i;
  if (i == first) return {end, false};
  for (;;) {
    I previous = i;
    --previous;
    if (comp(__project(proj, *previous), __project(proj, *i))) {
      I j = end;
      do { --j; } while (!comp(__project(proj, *previous), __project(proj, *j)));
      ranges::iter_swap(previous, j);
      ranges::reverse(i, end);
      return {end, true};
    }
    if (previous == first) {
      ranges::reverse(first, end);
      return {end, false};
    }
    i = previous;
  }
}
template <range R, class Comp = less, class Proj = identity>
constexpr next_permutation_result<borrowed_iterator_t<R>> next_permutation(
    R&& r, Comp comp = {}, Proj proj = {}) {
  return ranges::next_permutation(ranges::begin(r), ranges::end(r),
                                  comp, proj);
}
template <class I, class S, class Comp = less, class Proj = identity>
constexpr prev_permutation_result<I> prev_permutation(
    I first, S last, Comp comp = {}, Proj proj = {}) {
  struct __reverse_comp {
    Comp comp;
    constexpr bool operator()(const auto& a, const auto& b) {
      return comp(b, a);
    }
  };
  auto result =
      ranges::next_permutation(first, last, __reverse_comp{comp}, proj);
  return {result.in, result.found};
}
