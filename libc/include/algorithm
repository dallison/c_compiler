template <range R, class T, class Comp = less, class Proj = identity>
constexpr bool binary_search(R&& r, const T& value,
                             Comp comp = {}, Proj proj = {}) {
  auto first = ranges::begin(r);
  auto last = ranges::end(r);
  for (; first != last; ++first) {
    if (__compare(comp, __project(proj, *first), value)) {
      continue;
    }
    return !__compare(comp, value, __project(proj, *first));
  }
  return false;
}

