constexpr unary_transform_result<I, O> transform(I first, S last, O out,
                                                 F fun, Proj proj = {}) {
  for (; first != last; ++first, ++out) *out = fun(__project(proj, *first));
  return {first, out};
}
template <range TransformRange, class TransformOutput,
          class TransformFunction, class TransformProjection = identity>
constexpr unary_transform_result<borrowed_iterator_t<TransformRange>,
                                 TransformOutput>
transform(TransformRange&& r, TransformOutput out, TransformFunction fun,
          TransformProjection proj = {}) {
  auto first = ranges::begin(r);
  auto last = ranges::end(r);
  TransformOutput current_out = out;
  for (; first != last; ++first, ++current_out) {
    *current_out = fun(__project(proj, *first));
  }
  unary_transform_result<borrowed_iterator_t<TransformRange>,
                         TransformOutput> result;
  result.in = first;
  result.out = current_out;
  return result;
}
template <class I1, class S1, class I2, class S2, class O, class F,
          class P1 = identity, class P2 = identity>
constexpr binary_transform_result<I1, I2, O> transform(
    I1 first1, S1 last1, I2 first2, S2 last2, O out, F fun,
    P1 p1 = {}, P2 p2 = {}) {
  while (first1 != last1 && first2 != last2) {
    *out = fun(__project(p1, *first1), __project(p2, *first2));
    ++first1;
    ++first2;
    ++out;
  }
  return {first1, first2, out};
}
