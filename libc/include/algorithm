}
template <class T, class Proj = identity, class Comp = less>
constexpr min_max_result<const T&> minmax(const T& a, const T& b,
                                          Comp comp = {}, Proj proj = {}) {
  return comp(__project(proj, b), __project(proj, a)) ? min_max_result<const T&>{b, a}
                                : min_max_result<const T&>{a, b};
}
template <range R, class Comp = less, class Proj = identity>
constexpr min_max_result<range_value_t<R>> minmax(
    R&& r, Comp comp = {}, Proj proj = {}) {
  auto first = ranges::begin(r);
  auto last = ranges::end(r);
  range_value_t<R> minimum = *first;
  range_value_t<R> maximum = *first;
  ++first;
  for (; first != last; ++first) {
    if (__compare(comp, __project(proj, *first),
                  __project(proj, minimum))) {
      minimum = *first;
    }
    if (__compare(comp, __project(proj, maximum),
                  __project(proj, *first))) {
      maximum = *first;
    }
  }
  min_max_result<range_value_t<R>> result;
  result.min = minimum;
  result.max = maximum;
  return result;
}
