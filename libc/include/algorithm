template <class I, class S, class O>
constexpr copy_backward_result<I, O> copy_backward(I first, S last, O out) {
  I end = ranges::next(first, last);
  I current = end;
  while (current != first) {
    --current;
    --out;
    *out = *current;
  }
  return {end, out};
}
