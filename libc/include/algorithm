// ------------------------------------------------------------------
// min/max element
// ------------------------------------------------------------------
template <class It, class Compare>
constexpr It min_element(It first, It last, Compare comp) {
  if (first == last) {
    return last;
  }
  It smallest = first;
  for (++first; first != last; ++first) {
    if (comp(*first, *smallest)) {
      smallest = first;
    }
  }
  return smallest;
}

template <class It>
constexpr It min_element(It first, It last) {
  return std::min_element(first, last, __algorithm_detail::__less());
}

template <class It, class Compare>
constexpr It max_element(It first, It last, Compare comp) {
  if (first == last) {
    return last;
  }
  It largest = first;
  for (++first; first != last; ++first) {
    if (comp(*largest, *first)) {
      largest = first;
    }
  }
  return largest;
}

template <class It>
constexpr It max_element(It first, It last) {
  return std::max_element(first, last, __algorithm_detail::__less());
}

template <class It, class Compare>
constexpr pair<It, It> minmax_element(It first, It last, Compare comp) {
  It smallest = first;
  It largest = first;
  if (first == last) {
    return pair<It, It>(smallest, largest);
  }
  for (++first; first != last; ++first) {
    if (comp(*first, *smallest)) {
      smallest = first;
    }
    if (!comp(*first, *largest)) {
      largest = first;
    }
  }
  return pair<It, It>(smallest, largest);
}

template <class It>
constexpr pair<It, It> minmax_element(It first, It last) {
  return std::minmax_element(first, last, __algorithm_detail::__less());
}

// ------------------------------------------------------------------
// Lexicographical comparison
// ------------------------------------------------------------------
template <class It1, class It2, class Compare>
constexpr bool lexicographical_compare(It1 first1, It1 last1, It2 first2,
                                       It2 last2, Compare comp) {
  for (; first1 != last1 && first2 != last2; ++first1, ++first2) {
    if (comp(*first1, *first2)) {
      return true;
    }
    if (comp(*first2, *first1)) {
      return false;
    }
  }
  return first1 == last1 && first2 != last2;
}

template <class It1, class It2>
constexpr bool lexicographical_compare(It1 first1, It1 last1, It2 first2,
                                       It2 last2) {
  return std::lexicographical_compare(first1, last1, first2, last2,
                                      __algorithm_detail::__less());
}

// ------------------------------------------------------------------
// Permutations
// ------------------------------------------------------------------
template <class It, class Compare>
constexpr bool next_permutation(It first, It last, Compare comp) {
  if (first == last) {
    return false;
  }
  It i = last;
  if (first == --i) {
    return false;
  }
  for (;;) {
    It i1 = i;
    if (comp(*--i, *i1)) {
      It i2 = last;
      while (!comp(*i, *--i2)) {
      }
      std::iter_swap(i, i2);
      std::reverse(i1, last);
      return true;
    }
    if (i == first) {
      std::reverse(first, last);
      return false;
    }
  }
}

template <class It>
constexpr bool next_permutation(It first, It last) {
  return std::next_permutation(first, last, __algorithm_detail::__less());
}

template <class It, class Compare>
constexpr bool prev_permutation(It first, It last, Compare comp) {
  if (first == last) {
    return false;
  }
  It i = last;
  if (first == --i) {
    return false;
  }
  for (;;) {
    It i1 = i;
    if (comp(*i1, *--i)) {
      It i2 = last;
      while (!comp(*--i2, *i)) {
      }
      std::iter_swap(i, i2);
      std::reverse(i1, last);
      return true;
    }
    if (i == first) {
      std::reverse(first, last);
      return false;
    }
  }
}

template <class It>
constexpr bool prev_permutation(It first, It last) {
  return std::prev_permutation(first, last, __algorithm_detail::__less());
}

template <class It1, class It2, class Pred>
constexpr bool is_permutation(It1 first1, It1 last1, It2 first2, Pred pred) {
  // Skip the common prefix.
  for (; first1 != last1; ++first1, ++first2) {
    if (!pred(*first1, *first2)) {
      break;
    }
  }
  if (first1 == last1) {
    return true;
  }
  It2 last2 = first2;
  std::advance(last2, std::distance(first1, last1));
  for (It1 i = first1; i != last1; ++i) {
    bool seen = false;
    for (It1 j = first1; j != i; ++j) {
      if (pred(*j, *i)) {
        seen = true;
        break;
      }
    }
    if (seen) {
      continue;
    }
    typename iterator_traits<It1>::difference_type matches = 0;
    for (It2 j = first2; j != last2; ++j) {
      if (pred(*i, *j)) {
        ++matches;
      }
    }
    if (matches == 0) {
      return false;
    }
    typename iterator_traits<It1>::difference_type in_first = 0;
    for (It1 j = i; j != last1; ++j) {
      if (pred(*i, *j)) {
        ++in_first;
      }
    }
    if (in_first != matches) {
      return false;
    }
  }
  return true;
}

template <class It1, class It2>
constexpr bool is_permutation(It1 first1, It1 last1, It2 first2) {
  return std::is_permutation(first1, last1, first2,
                             __algorithm_detail::__equal_to());
}

