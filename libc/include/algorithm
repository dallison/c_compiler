template <class I1, class S1, class I2, class S2,
          class Pred = equal_to, class P1 = identity, class P2 = identity>
constexpr mismatch_result<I1, I2> mismatch(I1 first1, S1 last1,
                                           I2 first2, S2 last2,
                                           Pred pred = {}, P1 p1 = {},
                                           P2 p2 = {}) {
  while (first1 != last1 && first2 != last2 &&
         pred(__project(p1, *first1), __project(p2, *first2))) {
    ++first1;
    ++first2;
  }
  return {first1, first2};
}
