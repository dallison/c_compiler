                                   borrowed_iterator_t<R2>>
partial_sort_copy(R1&& r, R2&& result, Comp comp = {}, P1 p1 = {},
                  P2 p2 = {}) {
  return ranges::partial_sort_copy(ranges::begin(r), ranges::end(r),
                                   ranges::begin(result), ranges::end(result),
                                   comp, p1, p2);
}

