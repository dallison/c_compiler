template <class I1, class S1, class I2, class S2,
          class Pred = equal_to, class P1 = identity, class P2 = identity>
constexpr subrange<I1, I1> find_end(I1 first1, S1 last1, I2 first2, S2 last2,
                                    Pred pred = {}, P1 p1 = {}, P2 p2 = {}) {
  I1 end1 = ranges::next(first1, last1);
  if (first2 == last2) return {end1, end1};
  subrange<I1, I1> result{end1, end1};
  for (;;) {
    subrange<I1, I1> next =
        ranges::search(first1, end1, first2, last2, pred, p1, p2);
    if (next.begin() == end1) return result;
    result = next;
    first1 = next.begin();
    ++first1;
  }
}
