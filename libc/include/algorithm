template <class I, class S, class O, class Pred = equal_to,
          class Proj = identity>
constexpr copy_result<I, O> unique_copy(I first, S last, O out,
                                        Pred pred = {}, Proj proj = {}) {
  if (first == last) return {first, out};
  auto value = *first;
  *out = value;
  ++out;
  ++first;
  for (; first != last; ++first) {
    if (!pred(__project(proj, value), __project(proj, *first))) {
      value = *first;
      *out = value;
      ++out;
    }
  }
  return {first, out};
}
