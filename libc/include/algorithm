// Copies the smallest elements of the input into the output range, in order,
// keeping the output sorted by insertion as it fills and then only accepting
// elements that beat its current largest.
template <class I1, class S1, class I2, class S2, class Comp = less,
          class P1 = identity, class P2 = identity>
constexpr partial_sort_copy_result<I1, I2> partial_sort_copy(
    I1 first, S1 last, I2 result_first, S2 result_last, Comp comp = {},
    P1 p1 = {}, P2 p2 = {}) {
  I2 out = result_first;
  if (out == result_last) {
    return {ranges::next(first, last), out};
  }
  while (first != last && out != result_last) {
    *out = *first;
    ++out;
    ++first;
  }
  std::sort(result_first, out, __project_comparator(comp, p2));
  for (; first != last; ++first) {
    I2 largest = out;
    --largest;
    if (!__compare(comp, __project(p1, *first), __project(p2, *largest))) {
      continue;
    }
    *largest = *first;
    for (I2 j = largest; j != result_first;) {
      I2 previous = j;
      --previous;
      if (!__compare(comp, __project(p2, *j), __project(p2, *previous))) break;
      ranges::iter_swap(j, previous);
      j = previous;
    }
  }
  return {first, out};
}
template <range R1, range R2, class Comp = less, class P1 = identity,
          class P2 = identity>
