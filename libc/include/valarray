    for (size_t i = 0; i < left.size(); ++i) result[i] = left[i] op right;  \
    return result;                                                          \
  }                                                                         \
  template <class T>                                                        \
  valarray<bool> operator op(const T& left, const valarray<T>& right) {      \
    valarray<bool> result(right.size());                                    \
    for (size_t i = 0; i < right.size(); ++i) result[i] = left op right[i]; \
