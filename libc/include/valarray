#define __DAVECC_VALARRAY_COMPARE(op)                                       \
  template <class T>                                                        \
  valarray<bool> operator op(const valarray<T>& left,                       \
                             const valarray<T>& right) {                     \
    valarray<bool> result(left.size());                                     \
