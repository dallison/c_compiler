#undef __DAVECC_VALARRAY_COMPARE

template <class T>
void swap(valarray<T>& left, valarray<T>& right) {
  left.swap(right);
}

#if __cplusplus >= 201103L
template <class T> T* begin(valarray<T>& value) { return value.__begin(); }
template <class T> const T* begin(const valarray<T>& value) { return value.__begin(); }
template <class T> T* end(valarray<T>& value) { return begin(value) + value.size(); }
template <class T> const T* end(const valarray<T>& value) { return begin(value) + value.size(); }
#endif

