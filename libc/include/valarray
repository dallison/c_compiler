                          const valarray<T>& right) {                        \
    valarray<T> result(left.size());                                        \
    for (size_t i = 0; i < left.size(); ++i) result[i] = left[i] op right[i]; \
    return result;                                                          \
  }                                                                         \
  template <class T>                                                        \
  valarray<T> operator op(const valarray<T>& left, const T& right) {         \
    valarray<T> result(left.size());                                        \
    for (size_t i = 0; i < left.size(); ++i) result[i] = left[i] op right;  \
    return result;                                                          \
  }                                                                         \
  template <class T>                                                        \
  valarray<T> operator op(const T& left, const valarray<T>& right) {         \
    valarray<T> result(right.size());                                       \
    for (size_t i = 0; i < right.size(); ++i) result[i] = left op right[i]; \
    return result;                                                          \
  }
