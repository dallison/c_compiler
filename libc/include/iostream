//
//  iostream
//  c_compiler
//
//  C++20 <iostream> support for DaveCC: the standard stream objects cin, cout,
//  cerr and clog (narrow-character only). Small dedicated buffers wrap the C
//  standard streams without pulling the complete <fstream> implementation.
//
#ifndef __davecc_iostream__
#define __davecc_iostream__

#include <istream>
#include <ostream>

namespace std {

extern ostream cout;
extern istream cin;
extern ostream cerr;
extern ostream clog;

}  // namespace std

#endif  // __davecc_iostream__
