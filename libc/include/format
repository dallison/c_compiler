template <class CharT, class... Args>
class basic_format_string;

template <class CharT, class... Args>
class basic_format_string {
  const CharT* __data;
  size_t __size;

 public:
  template <size_t N>
  consteval basic_format_string(const CharT (&text)[N])
      : __data(text), __size(N - 1) {
    size_t next_automatic = 0;
    bool automatic = false;
    bool manual = false;
    for (size_t i = 0; i < __size; ++i) {
      if (text[i] == '}') {
        if (i + 1 < __size && text[i + 1] == '}') {
          ++i;
          continue;
        }
        __DAVECC_THROW(format_error("unmatched '}' in format string"));
      }
      if (text[i] != '{') {
        continue;
      }
      if (i + 1 < __size && text[i + 1] == '{') {
        ++i;
        continue;
      }

      size_t position = i + 1;
      size_t argument = 0;
      bool explicit_argument = false;
      while (position < __size && text[position] >= '0' &&
             text[position] <= '9') {
        explicit_argument = true;
        argument =
            argument * 10 + static_cast<size_t>(text[position] - '0');
        ++position;
      }
      if (explicit_argument) {
        manual = true;
        if (automatic) {
          __DAVECC_THROW(format_error(
              "cannot mix automatic and manual argument indices"));
        }
      } else {
        automatic = true;
        if (manual) {
          __DAVECC_THROW(format_error(
              "cannot mix automatic and manual argument indices"));
        }
        argument = next_automatic++;
      }
      if (argument >= sizeof...(Args)) {
        __DAVECC_THROW(format_error("format argument index out of range"));
      }

      size_t specification_start = position;
      size_t specification_size = 0;
      if (position < __size && text[position] == ':') {
        specification_start = ++position;
        while (position < __size && text[position] != '}') {
          CharT specification_character = text[position];
          if (specification_character == '{') {
            ++position;
            size_t dynamic_argument = 0;
            bool explicit_dynamic = false;
            while (position < __size && text[position] >= '0' &&
                   text[position] <= '9') {
              explicit_dynamic = true;
              dynamic_argument =
                  dynamic_argument * 10 +
                  static_cast<size_t>(text[position] - '0');
              ++position;
            }
            if (position >= __size || text[position] != '}') {
              __DAVECC_THROW(
                  format_error("invalid dynamic format specification"));
            }
            if (explicit_dynamic) {
              manual = true;
              if (automatic) {
                __DAVECC_THROW(format_error(
                    "cannot mix automatic and manual argument indices"));
              }
            } else {
              automatic = true;
              if (manual) {
                __DAVECC_THROW(format_error(
                    "cannot mix automatic and manual argument indices"));
              }
              dynamic_argument = next_automatic++;
            }
            if (dynamic_argument >= sizeof...(Args) ||
                !__format_detail::__format_type_checker<
                    0, CharT, Args...>::dynamic_integer(dynamic_argument)) {
              __DAVECC_THROW(
                  format_error("invalid dynamic format argument"));
            }
            ++position;
          } else {
            ++position;
          }
        }
        specification_size = position - specification_start;
      }
      if (position >= __size || text[position] != '}') {
        __DAVECC_THROW(format_error("unmatched '{' in format string"));
      }
      bool builtin_syntax_valid = true;
      char presentation = 0;
      size_t spec_position = specification_start;
      size_t spec_end = specification_start + specification_size;
      if (spec_position + 1 < spec_end &&
          (text[spec_position + 1] == '<' ||
           text[spec_position + 1] == '>' ||
           text[spec_position + 1] == '^')) {
        spec_position += 2;
      } else if (spec_position < spec_end &&
                 (text[spec_position] == '<' ||
                  text[spec_position] == '>' ||
                  text[spec_position] == '^')) {
        ++spec_position;
      }
      if (spec_position < spec_end &&
          (text[spec_position] == '+' || text[spec_position] == '-' ||
           text[spec_position] == ' ')) {
        ++spec_position;
      }
      if (spec_position < spec_end && text[spec_position] == '#') {
        ++spec_position;
      }
      if (spec_position < spec_end && text[spec_position] == '0') {
        ++spec_position;
      }
      if (spec_position < spec_end && text[spec_position] == '{') {
        while (spec_position < spec_end && text[spec_position] != '}') {
          ++spec_position;
        }
        if (spec_position < spec_end) {
          ++spec_position;
        } else {
          builtin_syntax_valid = false;
        }
      } else {
        while (spec_position < spec_end &&
               text[spec_position] >= '0' && text[spec_position] <= '9') {
          ++spec_position;
        }
      }
      if (spec_position < spec_end && text[spec_position] == '.') {
        ++spec_position;
        if (spec_position < spec_end && text[spec_position] == '{') {
          while (spec_position < spec_end && text[spec_position] != '}') {
            ++spec_position;
          }
          if (spec_position < spec_end) {
            ++spec_position;
          } else {
            builtin_syntax_valid = false;
          }
        } else {
          size_t precision_start = spec_position;
          while (spec_position < spec_end &&
                 text[spec_position] >= '0' && text[spec_position] <= '9') {
            ++spec_position;
          }
          if (spec_position == precision_start) {
            builtin_syntax_valid = false;
          }
        }
      }
      if (spec_position < spec_end && text[spec_position] == 'L') {
        ++spec_position;
      }
      if (spec_position < spec_end) {
        presentation = static_cast<char>(text[spec_position++]);
      }
      if (spec_position != spec_end) {
        builtin_syntax_valid = false;
      }
      if (!__format_detail::__format_type_checker<
              0, CharT, Args...>::specification(
              argument, builtin_syntax_valid, presentation)) {
        __DAVECC_THROW(format_error(
            "format presentation is incompatible with argument type"));
      }
      i = position;
    }
  }

  constexpr const CharT* data() const noexcept { return __data; }

  constexpr size_t size() const noexcept { return __size; }

  constexpr basic_string_view<CharT> get() const noexcept {
    return basic_string_view<CharT>(__data, __size);
  }
};

