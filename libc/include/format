template <class T>
inline bool __integer_argument(const void* pointer, long long* output) {
  if constexpr (is_integral<T>::value) {
    *output = static_cast<long long>(*static_cast<const T*>(pointer));
    return true;
  } else {
    (void)pointer;
    (void)output;
    return false;
  }
}

template <class T>
inline void __format_builtin(const T& value, const __spec& spec,
                             string& output, const __format_args* args) {
  using U = remove_cv_t<T>;
  (void)args;
  string converted;
  bool numeric = false;
  if constexpr (is_same<U, bool>::value) {
    if (spec.type == 0 || spec.type == 's') {
      converted = value ? "true" : "false";
    } else {
      __unsigned_integer_with_sign_to(value ? 1 : 0, spec, &converted);
      numeric = true;
    }
  } else if constexpr (is_same<U, char>::value ||
                       is_same<U, signed char>::value ||
                       is_same<U, unsigned char>::value) {
    if (spec.type == 0 || spec.type == 'c') {
      converted = string(1, static_cast<char>(value));
    } else if constexpr (is_signed<U>::value) {
      __signed_integer_to(static_cast<long long>(value), spec, &converted);
      numeric = true;
    } else {
      __unsigned_integer_with_sign_to(static_cast<unsigned long long>(value),
                                      spec, &converted);
      numeric = true;
    }
  } else if constexpr (is_integral<U>::value && is_signed<U>::value) {
    __signed_integer_to(static_cast<long long>(value), spec, &converted);
    numeric = true;
  } else if constexpr (is_integral<U>::value) {
    __unsigned_integer_with_sign_to(static_cast<unsigned long long>(value),
                                    spec, &converted);
    numeric = true;
  } else if constexpr (is_floating_point<U>::value) {
    __floating_to(static_cast<double>(value), spec, &converted);
    numeric = true;
  } else if constexpr (is_same<U, string>::value) {
    if (spec.type != 0 && spec.type != 's') {
      __fail("invalid string presentation type");
    }
    size_t length = value.size();
    if (spec.precision >= 0 &&
        static_cast<size_t>(spec.precision) < length) {
      length = static_cast<size_t>(spec.precision);
    }
    converted = string(value.data(), length);
  } else if constexpr (is_same<U, string_view>::value) {
    if (spec.type != 0 && spec.type != 's') {
      __fail("invalid string presentation type");
    }
    size_t length = value.size();
    if (spec.precision >= 0 &&
        static_cast<size_t>(spec.precision) < length) {
      length = static_cast<size_t>(spec.precision);
    }
    converted = string(value.data(), length);
  } else if constexpr (is_array<U>::value) {
    const char* text = value;
    size_t length = char_traits<char>::length(text);
    if (spec.precision >= 0 &&
        static_cast<size_t>(spec.precision) < length) {
      length = static_cast<size_t>(spec.precision);
    }
    converted = string(text, length);
  } else if constexpr (is_pointer<U>::value &&
                       is_same<remove_cv_t<remove_pointer_t<U>>, char>::value) {
    const char* text = value;
    if (text == nullptr) {
      __fail("null string pointer");
    }
    size_t length = char_traits<char>::length(text);
    if (spec.precision >= 0 &&
        static_cast<size_t>(spec.precision) < length) {
      length = static_cast<size_t>(spec.precision);
    }
    converted = string(text, length);
  } else if constexpr (is_same<U, nullptr_t>::value) {
    if (spec.type != 0 && spec.type != 'p') {
      __fail("invalid pointer presentation type");
    }
    converted = "0x0";
    numeric = true;
  } else if constexpr (is_pointer<U>::value) {
    if (spec.type != 0 && spec.type != 'p') {
      __fail("invalid pointer presentation type");
    }
    unsigned long long address =
        reinterpret_cast<unsigned long long>(value);
    __unsigned_integer_to(address, 'x', true, &converted);
    numeric = true;
  } else {
    __fail("type is not formattable");
  }
  __append_padded(&output, &converted, &spec, numeric);
}

