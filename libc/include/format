enum class range_format {
  disabled,
  map,
  set,
  sequence,
  string,
  debug_string
};

namespace __format_detail {

template <class T, class = void>
struct __range_kind {
  static constexpr range_format value = range_format::sequence;
};

template <class T>
struct __range_kind<T, void_t<typename T::mapped_type>> {
  static constexpr range_format value = range_format::map;
};

template <class T>
concept __member_range =
    requires(T& value) {
      value.begin();
      value.end();
    } &&
    !is_same<remove_cv_t<T>, string>::value &&
    !is_same<remove_cv_t<T>, string_view>::value;

inline void __append_range_piece(string* result, string_view piece) {
  result->append(piece.data(), piece.size());
}

}  // namespace __format_detail

template <class R>
inline constexpr range_format format_kind =
    __format_detail::__member_range<R>
        ? __format_detail::__range_kind<remove_cv_t<R>>::value
        : range_format::disabled;

template <class First, class Second>
struct formatter<pair<First, Second>, char> {
  bool __brackets = true;

  constexpr format_parse_context::iterator parse(
      format_parse_context& context) {
    if (context.begin() != context.end() && *context.begin() == 'n') {
      __brackets = false;
      return context.begin() + 1;
    }
    return context.begin();
  }

  format_context::iterator format(const pair<First, Second>& value,
                                  format_context& context) const {
    string result;
    if (__brackets) {
      result.push_back('(');
    }
    result.append(__format_detail::__format_invoke("{}", 2, value.first));
    result.append(", ");
    result.append(__format_detail::__format_invoke("{}", 2, value.second));
    if (__brackets) {
      result.push_back(')');
    }
    auto out = context.out();
    for (size_t i = 0; i < result.size(); ++i) {
      *out++ = result[i];
    }
    return out;
  }
};

template <class R>
  requires __format_detail::__member_range<R>
struct formatter<R, char> {
  bool __brackets = true;
  bool __map = format_kind<R> == range_format::map;

  constexpr format_parse_context::iterator parse(
      format_parse_context& context) {
    auto current = context.begin();
    if (current != context.end() && *current == 'n') {
      __brackets = false;
      ++current;
    } else if (current != context.end() && *current == 'm') {
      __map = true;
      ++current;
    }
    return current;
  }

  format_context::iterator format(const R& value,
                                  format_context& context) const {
    string result;
    if (__brackets) {
      result.push_back(__map ? '{' : '[');
    }
    bool first = true;
    for (auto iterator = value.begin(); iterator != value.end(); ++iterator) {
      if (!first) {
        result.append(", ");
      }
      first = false;
      result.append(__format_detail::__format_invoke("{}", 2, *iterator));
    }
    if (__brackets) {
      result.push_back(__map ? '}' : ']');
    }
    auto out = context.out();
    for (size_t i = 0; i < result.size(); ++i) {
      *out++ = result[i];
    }
    return out;
  }
};

namespace __format_detail {

inline void __append_fixed_unsigned(unsigned value, unsigned width,
                                    string* output) {
  char buffer[12];
  unsigned position = width;
  for (unsigned i = 0; i < width; ++i) {
    buffer[--position] = static_cast<char>('0' + value % 10);
    value /= 10;
  }
  output->append(buffer, width);
}

inline void __append_calendar_year(int value, string* output) {
  if (value < 0) {
    output->push_back('-');
    value = -value;
  }
  __append_fixed_unsigned(static_cast<unsigned>(value), 4, output);
}

inline const char* __month_short_name(unsigned value) {
  static const char* names[] = {"???", "Jan", "Feb", "Mar", "Apr", "May",
                                "Jun", "Jul", "Aug", "Sep", "Oct", "Nov",
                                "Dec"};
  return value <= 12 ? names[value] : names[0];
}

inline const char* __month_long_name(unsigned value) {
  static const char* names[] = {
      "???",      "January", "February", "March",    "April",
      "May",      "June",    "July",     "August",   "September",
      "October",  "November", "December"};
  return value <= 12 ? names[value] : names[0];
}

inline const char* __weekday_short_name(unsigned value) {
  static const char* names[] = {"Sun", "Mon", "Tue", "Wed",
                                "Thu", "Fri", "Sat"};
  return names[value % 7];
}

inline const char* __weekday_long_name(unsigned value) {
  static const char* names[] = {"Sunday",   "Monday", "Tuesday", "Wednesday",
                                "Thursday", "Friday", "Saturday"};
  return names[value % 7];
}

inline void __format_year_month_day(const chrono::year_month_day& value,
                                    const char* specification,
                                    size_t specification_size,
                                    string* output) {
  int year_value = static_cast<int>(value.year());
  unsigned month_value = static_cast<unsigned>(value.month());
  unsigned day_value = static_cast<unsigned>(value.day());
  if (specification_size == 0) {
    __append_calendar_year(year_value, output);
    output->push_back('-');
    __append_fixed_unsigned(month_value, 2, output);
    output->push_back('-');
    __append_fixed_unsigned(day_value, 2, output);
    return;
  }
  chrono::sys_days day_point = chrono::operator/(value);
  long long weekday_count = day_point.time_since_epoch().count() + 4;
  int weekday_index = static_cast<int>(weekday_count % 7);
  if (weekday_index < 0) {
    weekday_index += 7;
  }
  chrono::weekday weekday_value(static_cast<unsigned>(weekday_index));
  for (size_t i = 0; i < specification_size; ++i) {
    char current = specification[i];
    if (current != '%' || i + 1 >= specification_size) {
      output->push_back(current);
      continue;
    }
    char conversion = specification[++i];
    switch (conversion) {
      case '%':
        output->push_back('%');
        break;
      case 'Y':
        __append_calendar_year(year_value, output);
        break;
      case 'y':
        __append_fixed_unsigned(static_cast<unsigned>(year_value % 100), 2,
                                output);
        break;
      case 'm':
        __append_fixed_unsigned(month_value, 2, output);
        break;
      case 'd':
        __append_fixed_unsigned(day_value, 2, output);
        break;
      case 'e':
        if (day_value < 10) {
          output->push_back(' ');
        }
        __append_fixed_unsigned(day_value, day_value < 10 ? 1 : 2, output);
        break;
      case 'F':
        __append_calendar_year(year_value, output);
        output->push_back('-');
        __append_fixed_unsigned(month_value, 2, output);
        output->push_back('-');
        __append_fixed_unsigned(day_value, 2, output);
        break;
      case 'b':
      case 'h':
        output->append(__month_short_name(month_value));
        break;
      case 'B':
        output->append(__month_long_name(month_value));
        break;
      case 'a':
        output->append(
            __weekday_short_name(static_cast<unsigned>(weekday_value)));
        break;
      case 'A':
        output->append(
            __weekday_long_name(static_cast<unsigned>(weekday_value)));
        break;
      case 'n':
        output->push_back('\n');
        break;
      case 't':
        output->push_back('\t');
        break;
      default:
        __fail("unsupported chrono calendar conversion");
    }
  }
}

