template <class T, class CharT>
struct formatter {
  basic_string_view<CharT> __specification;

  constexpr typename basic_format_parse_context<CharT>::iterator parse(
      basic_format_parse_context<CharT>& context) {
    __specification = basic_string_view<CharT>(
        context.begin(), static_cast<size_t>(context.end() - context.begin()));
    return context.end();
  }

  typename basic_format_context<back_insert_iterator<string>, CharT>::iterator
  format(const T& value,
         basic_format_context<back_insert_iterator<string>, CharT>& context)
      const {
    __format_detail::__spec specification =
        __format_detail::__parse_spec(
            string_view(__specification.data(), __specification.size()),
            &context.__arguments());
    __format_detail::__format_builtin(
        value, specification, context.__buffer(), &context.__arguments());
    return context.out();
  }
};

namespace __format_detail {

template <class T>
struct __is_builtin_format_type {
  using U = remove_cv_t<T>;
  static constexpr bool value =
      is_integral<U>::value || is_floating_point<U>::value ||
      is_pointer<U>::value || is_array<U>::value ||
      is_same<U, nullptr_t>::value || is_same<U, string>::value ||
      is_same<U, string_view>::value;
};

template <class T>
constexpr bool __builtin_presentation_valid(char presentation) {
  using U = remove_cv_t<remove_reference_t<T>>;
  if constexpr (is_same<U, bool>::value) {
    return presentation == 0 || presentation == 's' || presentation == 'd' ||
           presentation == 'x' || presentation == 'X' ||
           presentation == 'o' || presentation == 'b' ||
           presentation == 'B';
  } else if constexpr (is_same<U, char>::value ||
                       is_same<U, signed char>::value ||
                       is_same<U, unsigned char>::value) {
    return presentation == 0 || presentation == 'c' || presentation == 'd' ||
           presentation == 'x' || presentation == 'X' ||
           presentation == 'o' || presentation == 'b' ||
           presentation == 'B';
  } else if constexpr (is_integral<U>::value) {
    return presentation == 0 || presentation == 'd' || presentation == 'c' ||
           presentation == 'x' || presentation == 'X' ||
           presentation == 'o' || presentation == 'b' ||
           presentation == 'B';
  } else if constexpr (is_floating_point<U>::value) {
    return presentation == 0 || presentation == 'f' || presentation == 'F' ||
           presentation == 'e' || presentation == 'E' ||
           presentation == 'g' || presentation == 'G';
  } else if constexpr (is_same<U, string>::value ||
                       is_same<U, string_view>::value ||
                       is_array<U>::value ||
                       (is_pointer<U>::value &&
                        is_same<remove_cv_t<remove_pointer_t<U>>, char>::value)) {
    return presentation == 0 || presentation == 's';
  } else if constexpr (is_pointer<U>::value ||
                       is_same<U, nullptr_t>::value) {
    return presentation == 0 || presentation == 'p';
  } else {
    return false;
  }
}

template <class T>
constexpr bool __format_specification_valid(bool syntax_valid,
                                            char presentation) {
  using U = remove_cv_t<remove_reference_t<T>>;
  if constexpr (__is_builtin_format_type<U>::value) {
    return syntax_valid && __builtin_presentation_valid<U>(presentation);
  } else {
    return true;
  }
}

template <unsigned Position, class CharT, class... Args>
struct __format_type_checker;

template <unsigned Position, class CharT>
struct __format_type_checker<Position, CharT> {
  static constexpr bool specification(unsigned, bool, char) {
    return false;
  }

  static constexpr bool dynamic_integer(unsigned) {
    return false;
  }
};

template <unsigned Position, class CharT, class Head, class... Tail>
struct __format_type_checker<Position, CharT, Head, Tail...> {
  static constexpr bool specification(unsigned index, bool syntax_valid,
                                      char presentation) {
    if (index == Position) {
      return __format_specification_valid<Head>(syntax_valid, presentation);
    }
    return __format_type_checker<Position + 1, CharT, Tail...>::specification(
        index, syntax_valid, presentation);
  }

  static constexpr bool dynamic_integer(unsigned index) {
    if (index == Position) {
      return is_integral<remove_cv_t<remove_reference_t<Head>>>::value;
    }
    return __format_type_checker<Position + 1, CharT, Tail...>::
        dynamic_integer(index);
  }
};

template <class T>
void __format_builtin_callback(const void* pointer,
                               const __format_specification* specification,
                               string& output,
                               const __format_args* arguments) {
  __format_builtin(*static_cast<const T*>(pointer), *specification->parsed,
                   output,
                   arguments);
}

template <class T>
void __format_with_formatter(const void* pointer,
                             const __format_specification* specification,
                             string& output, const __format_args* arguments) {
  string_view text(specification->data, specification->size);
  formatter<T, char> value_formatter;
  format_parse_context parse_context(text);
  auto parsed = value_formatter.parse(parse_context);
  if (parsed != parse_context.end()) {
    __fail("format specifier was not fully consumed");
  }
  format_args public_arguments(*arguments);
  basic_format_context<back_insert_iterator<string>, char> context(
      back_inserter(output), public_arguments, &output);
  auto end = value_formatter.format(*static_cast<const T*>(pointer), context);
  context.advance_to(end);
}

template <class T>
struct __custom_format_callback {
  static void call(const void* pointer,
                   const __format_specification* specification,
                   string& output, const __format_args* arguments) {
    __format_with_formatter<T>(pointer, specification, output, arguments);
  }
};

template <size_t Capacity>
class __format_arg_store {
  __format_arg __values[Capacity == 0 ? 1 : Capacity];
  size_t __count;

 public:
  __format_arg_store() : __count(0) {}

  template <class T>
  void __push(T&& value) {
    if (__count >= Capacity) {
      __fail("too many format arguments");
    }
    __format_arg* slot = __values + __count;
    using U = remove_cv_t<remove_reference_t<T>>;
    if constexpr (is_array<U>::value) {
      slot->value = static_cast<const void*>(value);
    } else {
      slot->value = &value;
    }
    if constexpr (__is_builtin_format_type<U>::value) {
      slot->format_value = __format_builtin_callback<U>;
      slot->is_builtin = true;
    } else {
      slot->format_value = __custom_format_callback<U>::call;
      slot->is_builtin = false;
    }
    slot->integer_value = __integer_argument<U>;
    ++__count;
  }
  template <class... Args>
  void __push_all(Args&&... args) {
    (__push(static_cast<Args&&>(args)), ...);
  }
  const __format_arg* __data() const { return __values; }
  size_t __size() const { return __count; }
};

void __vformat_to(const char* text_data, size_t text_size,
                  const __format_args* arguments, string* output);

string __format_invoke(const char* text_data, size_t text_size);

template <class... Args>
inline string __format_invoke(const char* text_data, size_t text_size,
                              Args&&... args) {
  __format_arg_store<sizeof...(Args)> store;
  store.__push_all(static_cast<Args&&>(args)...);
  string output;
  __format_args runtime_args(store.__data(), store.__size());
  __vformat_to(text_data, text_size, &runtime_args, &output);
  return output;
}

}  // namespace __format_detail

template <class... Args>
auto make_format_args(Args&... args) {
  __format_detail::__format_arg_store<sizeof...(Args)> store;
  store.__push_all(args...);
  return store;
}

