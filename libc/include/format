    return __args.get(id);
  }
  iterator out() { return __out; }
  void advance_to(iterator it) { __out = it; }
  string& __buffer() { return *__buffer_pointer; }
  const __format_detail::__format_args& __arguments() const {
    return __args.__implementation();
  }
};

