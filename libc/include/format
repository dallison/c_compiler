inline void __append_utf8_code_point(unsigned long value, string* output) {
  if (value <= 0x7F) {
    output->push_back(static_cast<char>(value));
  } else if (value <= 0x7FF) {
    output->push_back(static_cast<char>(0xC0 | (value >> 6)));
    output->push_back(static_cast<char>(0x80 | (value & 0x3F)));
  } else if (value <= 0xFFFF) {
    output->push_back(static_cast<char>(0xE0 | (value >> 12)));
    output->push_back(static_cast<char>(0x80 | ((value >> 6) & 0x3F)));
    output->push_back(static_cast<char>(0x80 | (value & 0x3F)));
  } else {
    output->push_back(static_cast<char>(0xF0 | (value >> 18)));
    output->push_back(static_cast<char>(0x80 | ((value >> 12) & 0x3F)));
    output->push_back(static_cast<char>(0x80 | ((value >> 6) & 0x3F)));
    output->push_back(static_cast<char>(0x80 | (value & 0x3F)));
  }
}

inline string __wide_to_utf8(wstring_view value) {
  string result;
  for (size_t i = 0; i < value.size(); ++i) {
    unsigned long code_point = static_cast<unsigned long>(value[i]);
    if (code_point >= 0xD800 && code_point <= 0xDBFF &&
        i + 1 < value.size()) {
      unsigned long low = static_cast<unsigned long>(value[i + 1]);
      if (low >= 0xDC00 && low <= 0xDFFF) {
        code_point =
            0x10000 + ((code_point - 0xD800) << 10) + (low - 0xDC00);
        ++i;
      }
    }
    if (code_point > 0x10FFFF ||
        (code_point >= 0xD800 && code_point <= 0xDFFF)) {
      code_point = 0xFFFD;
    }
    __append_utf8_code_point(code_point, &result);
  }
  return result;
}

inline wstring __utf8_to_wide(string_view value) {
  wstring result;
  for (size_t position = 0; position < value.size();) {
    unsigned char first = static_cast<unsigned char>(value[position]);
    unsigned long code_point = first;
    size_t length = 1;
    if (first >= 0xC2 && first < 0xE0 && position + 1 < value.size()) {
      code_point = ((first & 0x1F) << 6) |
                   (static_cast<unsigned char>(value[position + 1]) & 0x3F);
      length = 2;
    } else if (first >= 0xE0 && first < 0xF0 &&
               position + 2 < value.size()) {
      code_point = ((first & 0x0F) << 12) |
                   ((static_cast<unsigned char>(value[position + 1]) & 0x3F)
                    << 6) |
                   (static_cast<unsigned char>(value[position + 2]) & 0x3F);
      length = 3;
    } else if (first >= 0xF0 && first < 0xF5 &&
               position + 3 < value.size()) {
      code_point = ((first & 0x07) << 18) |
                   ((static_cast<unsigned char>(value[position + 1]) & 0x3F)
                    << 12) |
                   ((static_cast<unsigned char>(value[position + 2]) & 0x3F)
                    << 6) |
                   (static_cast<unsigned char>(value[position + 3]) & 0x3F);
      length = 4;
    }
    result.push_back(static_cast<wchar_t>(code_point));
    position += length;
  }
  return result;
}

template <class T>
inline T&& __narrow_wide_argument(T&& value) {
