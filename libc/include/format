template <class... Args>
inline wstring __wformat_invoke(const wchar_t* text_data, size_t text_size,
                                Args&&... args) {
  string narrow_text =
      __wide_to_utf8(wstring_view(text_data, text_size));
  string narrow_result = __format_invoke(
      narrow_text.data(), narrow_text.size(),
      __narrow_wide_argument(static_cast<Args&&>(args))...);
  return __utf8_to_wide(
      string_view(narrow_result.data(), narrow_result.size()));
}

