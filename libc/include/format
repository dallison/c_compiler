template <class Context>
class basic_format_args {
  __format_detail::__format_args __values;

 public:
  basic_format_args() noexcept {}
  explicit basic_format_args(
      const __format_detail::__format_args& implementation) noexcept
      : __values(implementation) {}

  template <size_t Capacity>
  basic_format_args(
      const __format_detail::__format_arg_store<Capacity>& store) noexcept
      : __values(store.__data(), store.__size()) {}

  basic_format_arg<Context> get(size_t index) const noexcept {
    basic_format_arg<Context> result;
    const __format_detail::__format_arg* value = __values.get(index);
    if (value != nullptr) {
      result.__value = *value;
    }
    return result;
  }

  const __format_detail::__format_args& __implementation() const {
    return __values;
  }
};

template <class OutputIt, class CharT>
class basic_format_context {
 public:
