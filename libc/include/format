 public:
  basic_format_args() noexcept {}
  explicit basic_format_args(
      const __format_detail::__format_args& implementation) noexcept
      : __values(implementation) {}

  template <class Store>
  basic_format_args(const Store& store) noexcept
      : __values(store.__data(), store.__size()) {}

  basic_format_arg<Context> get(size_t index) const noexcept {
    basic_format_arg<Context> result;
