template <class Duration>
struct formatter<chrono::time_point<chrono::system_clock, Duration>, char> {
  const char* __specification_data = nullptr;
  size_t __specification_size = 0;

  constexpr format_parse_context::iterator parse(
      format_parse_context& context) {
    auto begin = context.begin();
    auto end = context.end();
    __specification_data = begin;
    __specification_size = static_cast<size_t>(end - begin);
    return context.end();
  }

  format_context::iterator format(
      const chrono::time_point<chrono::system_clock, Duration>& value,
      format_context& context) const {
    Duration since_epoch = value.time_since_epoch();
    using period = typename Duration::period;
    long long scaled_ticks =
        static_cast<long long>(since_epoch.count()) * period::num;
    long long seconds_since_epoch = scaled_ticks / period::den;
    if (scaled_ticks < 0 && scaled_ticks % period::den != 0) {
      --seconds_since_epoch;
    }
    string result;
    __format_detail::__format_chrono_time_point(
        seconds_since_epoch, __specification_data, __specification_size,
        &result);
    auto out = context.out();
    for (size_t i = 0; i < result.size(); ++i) {
      *out++ = result[i];
    }
    return out;
  }
};

template <class Visitor, class Context>
decltype(auto) visit_format_arg(Visitor&& visitor,
                                basic_format_arg<Context> argument) {
  const __format_detail::__format_arg& value = argument.__implementation();
  switch (value.kind) {
    case __format_detail::__format_arg_kind::boolean:
      return static_cast<Visitor&&>(visitor)(value.bool_value);
    case __format_detail::__format_arg_kind::character:
      return static_cast<Visitor&&>(visitor)(value.char_value);
    case __format_detail::__format_arg_kind::signed_integer:
      return static_cast<Visitor&&>(visitor)(value.signed_value);
    case __format_detail::__format_arg_kind::unsigned_integer:
      return static_cast<Visitor&&>(visitor)(value.unsigned_value);
    case __format_detail::__format_arg_kind::floating:
      return static_cast<Visitor&&>(visitor)(value.floating_value);
    case __format_detail::__format_arg_kind::string:
      return static_cast<Visitor&&>(visitor)(
          string_view(value.string_data, value.string_size));
    case __format_detail::__format_arg_kind::pointer:
      return static_cast<Visitor&&>(visitor)(value.value);
    case __format_detail::__format_arg_kind::custom:
      return static_cast<Visitor&&>(visitor)(argument);
    default:
      return static_cast<Visitor&&>(visitor)(monostate());
  }
}

