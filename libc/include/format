template <class CharT, class... Args>
class basic_format_string;

template <class CharT, class... Args>
class basic_format_string {
  const CharT* __data;
  size_t __size;

 public:
  template <size_t N>
  consteval basic_format_string(const CharT (&text)[N])
      : __data(text), __size(N - 1) {
    size_t next_automatic = 0;
    bool automatic = false;
    bool manual = false;
    for (size_t i = 0; i < __size; ++i) {
      if (text[i] == '}') {
        if (i + 1 < __size && text[i + 1] == '}') {
          ++i;
          continue;
        }
        throw format_error("unmatched '}' in format string");
      }
      if (text[i] != '{') {
        continue;
      }
      if (i + 1 < __size && text[i + 1] == '{') {
        ++i;
        continue;
      }

      size_t position = i + 1;
      size_t argument = 0;
      bool explicit_argument = false;
      while (position < __size && text[position] >= '0' &&
             text[position] <= '9') {
        explicit_argument = true;
        argument =
            argument * 10 + static_cast<size_t>(text[position] - '0');
        ++position;
      }
      if (explicit_argument) {
        manual = true;
        if (automatic) {
          throw format_error(
              "cannot mix automatic and manual argument indices");
        }
      } else {
        automatic = true;
        if (manual) {
          throw format_error(
              "cannot mix automatic and manual argument indices");
        }
        argument = next_automatic++;
      }
      if (argument >= sizeof...(Args)) {
        throw format_error("format argument index out of range");
      }

      size_t specification_start = position;
      size_t specification_size = 0;
      if (position < __size && text[position] == ':') {
        specification_start = ++position;
        while (position < __size && text[position] != '}') {
          CharT specification_character = text[position];
          if (specification_character == '{') {
            ++position;
            size_t dynamic_argument = 0;
            bool explicit_dynamic = false;
            while (position < __size && text[position] >= '0' &&
                   text[position] <= '9') {
              explicit_dynamic = true;
              dynamic_argument =
                  dynamic_argument * 10 +
                  static_cast<size_t>(text[position] - '0');
              ++position;
            }
            if (position >= __size || text[position] != '}') {
              throw format_error("invalid dynamic format specification");
            }
            if (explicit_dynamic) {
              manual = true;
              if (automatic) {
                throw format_error(
                    "cannot mix automatic and manual argument indices");
              }
            } else {
              automatic = true;
              if (manual) {
                throw format_error(
                    "cannot mix automatic and manual argument indices");
              }
              dynamic_argument = next_automatic++;
            }
            if (dynamic_argument >= sizeof...(Args) ||
                !__format_detail::__format_type_checker<
                    0, CharT, Args...>::dynamic_integer(dynamic_argument)) {
              throw format_error("invalid dynamic format argument");
            }
            ++position;
          } else {
            ++position;
          }
        }
        specification_size = position - specification_start;
      }
      if (position >= __size || text[position] != '}') {
        throw format_error("unmatched '{' in format string");
      }
      bool builtin_syntax_valid = true;
      char presentation = 0;
      size_t spec_position = specification_start;
      size_t spec_end = specification_start + specification_size;
      if (spec_position + 1 < spec_end &&
          (text[spec_position + 1] == '<' ||
           text[spec_position + 1] == '>' ||
           text[spec_position + 1] == '^')) {
        spec_position += 2;
      } else if (spec_position < spec_end &&
                 (text[spec_position] == '<' ||
                  text[spec_position] == '>' ||
                  text[spec_position] == '^')) {
        ++spec_position;
      }
      if (spec_position < spec_end &&
          (text[spec_position] == '+' || text[spec_position] == '-' ||
           text[spec_position] == ' ')) {
        ++spec_position;
      }
      if (spec_position < spec_end && text[spec_position] == '#') {
        ++spec_position;
      }
      if (spec_position < spec_end && text[spec_position] == '0') {
        ++spec_position;
      }
      if (spec_position < spec_end && text[spec_position] == '{') {
        while (spec_position < spec_end && text[spec_position] != '}') {
          ++spec_position;
        }
        if (spec_position < spec_end) {
          ++spec_position;
        } else {
          builtin_syntax_valid = false;
        }
      } else {
        while (spec_position < spec_end &&
               text[spec_position] >= '0' && text[spec_position] <= '9') {
          ++spec_position;
        }
      }
      if (spec_position < spec_end && text[spec_position] == '.') {
        ++spec_position;
        if (spec_position < spec_end && text[spec_position] == '{') {
          while (spec_position < spec_end && text[spec_position] != '}') {
            ++spec_position;
          }
          if (spec_position < spec_end) {
            ++spec_position;
          } else {
            builtin_syntax_valid = false;
          }
        } else {
          size_t precision_start = spec_position;
          while (spec_position < spec_end &&
                 text[spec_position] >= '0' && text[spec_position] <= '9') {
            ++spec_position;
          }
          if (spec_position == precision_start) {
            builtin_syntax_valid = false;
          }
        }
      }
      if (spec_position < spec_end) {
        presentation = static_cast<char>(text[spec_position++]);
      }
      if (spec_position != spec_end) {
        builtin_syntax_valid = false;
      }
      if (!__format_detail::__format_type_checker<
              0, CharT, Args...>::specification(
              argument, builtin_syntax_valid, presentation)) {
        throw format_error(
            "format presentation is incompatible with argument type");
      }
      i = position;
    }
  }

  constexpr const CharT* data() const noexcept { return __data; }

  constexpr size_t size() const noexcept { return __size; }

  constexpr basic_string_view<CharT> get() const noexcept {
    return basic_string_view<CharT>(__data, __size);
  }
};

template <class... Args>
using format_string = basic_format_string<char, Args...>;

string vformat(string_view text, format_args args);

template <class OutputIt>
OutputIt vformat_to(OutputIt out, string_view text, format_args args) {
  string result = vformat(text, args);
  for (size_t i = 0; i < result.size(); ++i) {
    *out++ = result[i];
  }
  return out;
}

string format(
    const typename __format_detail::__non_deduced<format_string<>>::type& text);

template <class... Args>
inline string format(
    const typename __format_detail::__non_deduced<
        format_string<Args...>>::type& text,
    Args&&... args) {
  return __format_detail::__format_invoke(
      text.data(), text.size(), static_cast<Args&&>(args)...);
}

template <class OutputIt, class... Args>
OutputIt format_to(OutputIt out,
                   const typename __format_detail::__non_deduced<
                       format_string<Args...>>::type& text,
                   Args&&... args) {
  string result = __format_detail::__format_invoke(
      text.data(), text.size(), static_cast<Args&&>(args)...);
  for (size_t i = 0; i < result.size(); ++i) {
    *out++ = result[i];
  }
  return out;
}

template <class OutputIt>
struct format_to_n_result {
  OutputIt out;
  size_t size;
};

template <class OutputIt, class... Args>
format_to_n_result<OutputIt> format_to_n(
    OutputIt out, size_t n,
    const typename __format_detail::__non_deduced<
        format_string<Args...>>::type& text,
    Args&&... args) {
  string result = __format_detail::__format_invoke(
      text.data(), text.size(), static_cast<Args&&>(args)...);
  size_t count = result.size() < n ? result.size() : n;
  for (size_t i = 0; i < count; ++i) {
    *out++ = result[i];
  }
  return {out, result.size()};
}

template <class... Args>
size_t formatted_size(
    const typename __format_detail::__non_deduced<
        format_string<Args...>>::type& text,
    Args&&... args) {
  return __format_detail::__format_invoke(
      text.data(), text.size(), static_cast<Args&&>(args)...)
      .size();
}

template <class Rep, class Period>
struct formatter<chrono::duration<Rep, Period>, char> {
  const char* __specification_data = nullptr;
  size_t __specification_size = 0;

  constexpr format_parse_context::iterator parse(
      format_parse_context& context) {
    auto begin = context.begin();
    auto end = context.end();
    __specification_data = begin;
    __specification_size = static_cast<size_t>(end - begin);
    return context.end();
  }

  format_context::iterator format(
      const chrono::duration<Rep, Period>& value,
      format_context& context) const {
    string count;
    __format_detail::__spec count_specification;
    __format_detail::__format_builtin(
        value.count(), count_specification, count, &context.__arguments());
    string result;
    long double total_seconds =
        static_cast<long double>(value.count()) *
        static_cast<long double>(Period::num) /
        static_cast<long double>(Period::den);
    __format_detail::__format_chrono_duration(
        count, total_seconds, Period::num, Period::den,
        __specification_data, __specification_size, &result);
    auto out = context.out();
    for (size_t i = 0; i < result.size(); ++i) {
      *out++ = result[i];
    }
    return out;
  }
};

template <class Clock, class Duration>
struct formatter<chrono::time_point<Clock, Duration>, char>
    : formatter<Duration, char> {
  format_context::iterator format(
      const chrono::time_point<Clock, Duration>& value,
      format_context& context) const {
    return formatter<Duration, char>::format(
        value.time_since_epoch(), context);
  }
};

template <class Duration>
struct formatter<chrono::time_point<chrono::system_clock, Duration>, char> {
  const char* __specification_data = nullptr;
  size_t __specification_size = 0;

  constexpr format_parse_context::iterator parse(
      format_parse_context& context) {
    auto begin = context.begin();
    auto end = context.end();
    __specification_data = begin;
    __specification_size = static_cast<size_t>(end - begin);
    return context.end();
  }

  format_context::iterator format(
      const chrono::time_point<chrono::system_clock, Duration>& value,
      format_context& context) const {
    Duration since_epoch = value.time_since_epoch();
    using period = typename Duration::period;
    long long scaled_ticks =
        static_cast<long long>(since_epoch.count()) * period::num;
    long long seconds_since_epoch = scaled_ticks / period::den;
    if (scaled_ticks < 0 && scaled_ticks % period::den != 0) {
      --seconds_since_epoch;
    }
    string result;
    __format_detail::__format_chrono_time_point(
        seconds_since_epoch, __specification_data, __specification_size,
        &result);
    auto out = context.out();
    for (size_t i = 0; i < result.size(); ++i) {
      *out++ = result[i];
    }
    return out;
  }
};

template <class Visitor, class Context>
decltype(auto) visit_format_arg(Visitor&& visitor,
                                basic_format_arg<Context> argument) {
  return static_cast<Visitor&&>(visitor)(argument);
}

