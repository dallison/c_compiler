template <class CharT>
class basic_format_parse_context {
 public:
  using char_type = CharT;
  using const_iterator = const CharT*;
  using iterator = const_iterator;

 private:
  const_iterator __begin;
  const_iterator __end;
  size_t __next;
  size_t __argument_count;
  unsigned char __indexing;

 public:
  constexpr explicit basic_format_parse_context(
      basic_string_view<CharT> text, size_t argument_count = 0) noexcept
      : __begin(text.data()),
        __end(text.data() + text.size()),
        __next(0),
        __argument_count(argument_count),
        __indexing(0) {}

  constexpr const_iterator begin() const noexcept { return __begin; }
  constexpr const_iterator end() const noexcept { return __end; }
  constexpr void advance_to(const_iterator it) { __begin = it; }
  constexpr size_t next_arg_id() {
    if (__indexing == 2) {
      __DAVECC_THROW(
          format_error("cannot mix automatic and manual argument indices"));
    }
    __indexing = 1;
    if (__next >= __argument_count) {
      __DAVECC_THROW(format_error("format argument index out of range"));
    }
    return __next++;
  }
  constexpr void check_arg_id(size_t id) {
    if (__indexing == 1) {
      __DAVECC_THROW(
          format_error("cannot mix automatic and manual argument indices"));
    }
    __indexing = 2;
    if (id >= __argument_count) {
      __DAVECC_THROW(format_error("format argument index out of range"));
    }
  }
};

