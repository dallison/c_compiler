template <>
struct formatter<chrono::weekday, char> {
  bool __long_name = false;
  constexpr format_parse_context::iterator parse(
      format_parse_context& context) {
    if (context.end() - context.begin() == 2 && context.begin()[0] == '%' &&
        context.begin()[1] == 'A') {
      __long_name = true;
    }
    return context.end();
  }
  format_context::iterator format(chrono::weekday value,
                                  format_context& context) const {
    const char* name =
        __long_name
            ? __format_detail::__weekday_long_name(
                  static_cast<unsigned>(value))
            : __format_detail::__weekday_short_name(
                  static_cast<unsigned>(value));
    auto out = context.out();
    while (*name != '\0') {
      *out++ = *name++;
    }
    return out;
  }
};

template <class Duration, class TimeZonePtr>
struct formatter<chrono::zoned_time<Duration, TimeZonePtr>, char> {
  const char* __specification_data = nullptr;
  size_t __specification_size = 0;

  constexpr format_parse_context::iterator parse(
      format_parse_context& context) {
    __specification_data = context.begin();
    __specification_size =
        static_cast<size_t>(context.end() - context.begin());
    return context.end();
  }

  format_context::iterator format(
      const chrono::zoned_time<Duration, TimeZonePtr>& value,
      format_context& context) const {
    long long total_seconds =
        value.get_local_time().time_since_epoch().count();
    long long day_count = total_seconds / 86400;
    long long second_of_day = total_seconds % 86400;
    if (second_of_day < 0) {
      second_of_day += 86400;
      --day_count;
    }
    chrono::year_month_day date = chrono::operator/(
        chrono::sys_days(chrono::days(day_count)));
    chrono::sys_info information =
        value.get_time_zone()->get_info(value.get_sys_time());
    const char* specification =
        __specification_size == 0 ? "%F %T %Z" : __specification_data;
    size_t specification_size =
        __specification_size == 0 ? 8 : __specification_size;
    string result;
    for (size_t i = 0; i < specification_size; ++i) {
      char current = specification[i];
      if (current != '%' || i + 1 >= specification_size) {
        result.push_back(current);
        continue;
      }
      char conversion = specification[++i];
      if (conversion == 'T' || conversion == 'R' ||
          conversion == 'H' || conversion == 'M' || conversion == 'S') {
        unsigned hour = static_cast<unsigned>(second_of_day / 3600);
        unsigned minute =
            static_cast<unsigned>((second_of_day / 60) % 60);
        unsigned second = static_cast<unsigned>(second_of_day % 60);
        if (conversion == 'T' || conversion == 'R' || conversion == 'H') {
          __format_detail::__append_fixed_unsigned(hour, 2, &result);
        }
        if (conversion == 'T' || conversion == 'R') {
          result.push_back(':');
        }
        if (conversion == 'T' || conversion == 'R' || conversion == 'M') {
          __format_detail::__append_fixed_unsigned(minute, 2, &result);
        }
        if (conversion == 'T') {
          result.push_back(':');
        }
        if (conversion == 'T' || conversion == 'S') {
          __format_detail::__append_fixed_unsigned(second, 2, &result);
        }
      } else if (conversion == 'Z') {
        result.append(information.abbrev);
      } else if (conversion == 'z') {
        long long offset = information.offset.count();
        result.push_back(offset < 0 ? '-' : '+');
        if (offset < 0) {
          offset = -offset;
        }
        __format_detail::__append_fixed_unsigned(
            static_cast<unsigned>(offset / 3600), 2, &result);
        __format_detail::__append_fixed_unsigned(
            static_cast<unsigned>((offset / 60) % 60), 2, &result);
      } else {
        char date_specification[2] = {'%', conversion};
        __format_detail::__format_year_month_day(
            date, date_specification, 2, &result);
      }
    }
    auto out = context.out();
    for (size_t i = 0; i < result.size(); ++i) {
      *out++ = result[i];
    }
    return out;
  }
};

template <class Rep, class Period>
struct formatter<chrono::duration<Rep, Period>, char> {
  const char* __specification_data = nullptr;
  size_t __specification_size = 0;

  constexpr format_parse_context::iterator parse(
      format_parse_context& context) {
    auto begin = context.begin();
    auto end = context.end();
    __specification_data = begin;
    __specification_size = static_cast<size_t>(end - begin);
    return context.end();
  }

  format_context::iterator format(
      const chrono::duration<Rep, Period>& value,
      format_context& context) const {
    string count;
    __format_detail::__spec count_specification;
    __format_detail::__format_builtin(
        value.count(), count_specification, count, &context.__arguments());
    string result;
    long double total_seconds =
        static_cast<long double>(value.count()) *
        static_cast<long double>(Period::num) /
        static_cast<long double>(Period::den);
    __format_detail::__format_chrono_duration(
        count, total_seconds, Period::num, Period::den,
        __specification_data, __specification_size, &result);
    auto out = context.out();
    for (size_t i = 0; i < result.size(); ++i) {
      *out++ = result[i];
    }
    return out;
  }
};

