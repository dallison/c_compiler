# C++ testsuite scaffolding for DaveCC.
#
# The initial suite is compile-only so it can validate lexical and
# preprocessor behavior before later C++ parser/semantic phases are complete.

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//:davecc/modules.bzl", "davecc_binary", "davecc_module")

package(default_visibility = ["//visibility:public"])

exports_files(["tests/exec/0282_standard_mutex.cpp"])

davecc_module(
    name = "bazel_hello_module",
    src = "tests/modules/hello.cppm",
    module_name = "hello",
)

davecc_binary(
    name = "bazel_hello_binary",
    src = "tests/modules/use_hello.cpp",
    link_inputs = ["//:libc_x86_64"],
    linkopts = [
        "-Wl,-e",
        "-Wl,main",
    ],
    modules = [":bazel_hello_module"],
)

CXX_TEST_DATA = glob([
    "include/**",
    "tests/**/*.cpp",
    "tests/**/*.cppm",
    "tests/**/*.hpp",
    "tests/**/*.ixx",
]) + glob([
    "tests/**/*.h",
    "tests/**/*.hxx",
], allow_empty = True) + glob([
    "tests/**/*.expected",
], allow_empty = True) + [
    "README.md",
    "run_compile_tests.sh",
    "run_exec_tests.sh",
    "run_mangling_tests.sh",
    "run_module_tests.sh",
    "run_weak_binding_tests.sh",
    "//:chrono_tzif_fixtures",
]

sh_test(
    name = "lexical",
    srcs = ["run_compile_tests.sh"],
    args = [
        "--davecc",
        "$(rootpath //:davecc)",
        "--tests-dir",
        "tests/lexical",
    ],
    data = CXX_TEST_DATA + [
        "//:davecc",
    ],
)

