    srcs = ["run_weak_binding_tests.sh"],
    args = [
        "--davecc",
        "$(rootpath //:davecc)",
        "--elfdump",
        "$(rootpath //:elfdump)",
        "--target",
        "x86_64",
        "--libc",
        "$(rootpath //:libc_x86_64)",
        "--interpreter",
        "$(rootpath //:x86_64)",
        "--interp-arg",
        "-i",
    ],
    data = CXX_TEST_DATA + [
        "//:davecc",
        "//:elfdump",
        "//:libc_x86_64",
        "//:libc_headers",
        "//:x86_64",
    ],
)

