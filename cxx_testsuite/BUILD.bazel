        "x86_64",
        "--libc",
        "$(rootpath //:libc_x86_64)",
        "--interpreter",
        "$(rootpath //:x86_64)",
        "--compile-arg",
        "-Wl,-e",
        "--compile-arg",
        "-Wl,main",
        "--interp-arg",
        "-i",
    ],
    data = CXX_TEST_DATA + [
        "//:davecc",
        "//:libc_x86_64",
        "//:libc_headers",
        "//:x86_64",
