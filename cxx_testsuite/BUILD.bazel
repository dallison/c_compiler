# C++ testsuite scaffolding for DaveCC.
#
# The initial suite is compile-only so it can validate lexical and
# preprocessor behavior before later C++ parser/semantic phases are complete.

load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

CXX_TEST_DATA = glob([
    "include/**",
    "tests/**/*.cpp",
]) + glob([
    "tests/**/*.expected",
], allow_empty = True) + [
    "README.md",
    "run_compile_tests.sh",
    "run_exec_tests.sh",
    "run_mangling_tests.sh",
]

sh_test(
    name = "lexical",
    srcs = ["run_compile_tests.sh"],
    args = [
        "--davecc",
        "$(rootpath //:davecc)",
        "--tests-dir",
        "tests/lexical",
    ],
    data = CXX_TEST_DATA + [
        "//:davecc",
    ],
)

sh_test(
    name = "syntax",
    srcs = ["run_compile_tests.sh"],
    args = [
        "--davecc",
        "$(rootpath //:davecc)",
        "--tests-dir",
        "tests/syntax",
    ],
    data = CXX_TEST_DATA + [
        "//:davecc",
    ],
)

sh_test(
    name = "mangling",
    srcs = ["run_mangling_tests.sh"],
    args = [
        "--davecc",
        "$(rootpath //:davecc)",
        "--tests-dir",
        "tests/mangling",
    ],
    data = CXX_TEST_DATA + [
        "//:davecc",
    ],
)

sh_test(
    name = "exec_x86_64",
    srcs = ["run_exec_tests.sh"],
    args = [
        "--davecc",
        "$(rootpath //:davecc)",
        "--target",
        "x86_64",
        "--libc",
        "$(rootpath //:libc_x86_64)",
        "--interpreter",
        "$(rootpath //:x86_64)",
        "--compile-arg",
        "-Wl,-e",
        "--compile-arg",
        "-Wl,main",
        "--interp-arg",
        "-i",
    ],
    data = CXX_TEST_DATA + [
        "//:davecc",
        "//:libc_x86_64",
        "//:libc_headers",
        "//:x86_64",
    ],
)

test_suite(
    name = "all",
    tests = [
        ":exec_x86_64",
        ":lexical",
        ":mangling",
        ":syntax",
    ],
)
