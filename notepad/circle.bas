10 MODE 4
20 GCOL 0,1
30 T%=TIME
40 PROCcircle(640,512,400)
50 T%=TIME-T%
60 PRINT TAB(0,30);T%;" centiseconds"
70 PRINT TAB(0,31);TOP-PAGE;" bytes"
80 END
110 DEF PROCplot8(C%,K%,X%,Y%)
120 PLOT 69,C%+X%,K%+Y%
130 PLOT 69,C%-X%,K%+Y%
140 PLOT 69,C%+X%,K%-Y%
150 PLOT 69,C%-X%,K%-Y%
160 PLOT 69,C%+Y%,K%+X%
170 PLOT 69,C%-Y%,K%+X%
180 PLOT 69,C%+Y%,K%-X%
190 PLOT 69,C%-Y%,K%-X%
200 ENDPROC
210 DEF PROCcircle(C%,K%,R%)
220 X%=0
230 Y%=R%
240 D%=3-R%*2
250 REPEAT
260 PROCplot8(C%,K%,X%,Y%)
270 IF D%<0 THEN D%=D%+X%*4+6 ELSE D%=D%+(X%-Y%)*4+10:Y%=Y%-1
280 X%=X%+1
290 UNTIL X%>Y%
300 ENDPROC
